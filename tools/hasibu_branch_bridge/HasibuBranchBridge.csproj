<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HasibuBranchBridge</AssemblyName>
    <RootNamespace>HasibuBranchBridge</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>
    <HasibuOAuthClientId Condition="'$(HasibuOAuthClientId)' == ''"></HasibuOAuthClientId>
    <HasibuOAuthClientSecret Condition="'$(HasibuOAuthClientSecret)' == ''"></HasibuOAuthClientSecret>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="HasibuOAuthClientId" Value="$(HasibuOAuthClientId)" />
    <AssemblyMetadata Include="HasibuOAuthClientSecret" Value="$(HasibuOAuthClientSecret)" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>HasibuBranchBridge.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
