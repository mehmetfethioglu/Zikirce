<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="220dp"
    android:height="220dp"
    android:viewportWidth="220"
    android:viewportHeight="220">

    <!-- Red Second Hand Counterbalance Tail -->
    <path
        android:fillColor="@color/widget_clock_second_hand"
        android:pathData="M 108.6,126.0 L 109.2,110.0 L 110.8,110.0 L 111.4,126.0 Z" />

    <!-- Red Second Hand Needle (Saniye - Kırmızı, Scaled 1.105x) -->
    <path
        android:strokeWidth="1.65"
        android:strokeLineCap="round"
        android:strokeColor="@color/widget_clock_second_hand"
        android:pathData="M 110.0,126.0 L 110.0,50.3" />

    <!-- Center Red Cap Jewel -->
    <path
        android:fillColor="@color/widget_clock_second_hand"
        android:pathData="M 110,110 m -3.0,0 a 3.0,3.0 0 1,0 6.0,0 a 3.0,3.0 0 1,0 -6.0,0" />

    <!-- Center Gold Pin -->
    <path
        android:fillColor="#FFF8E7"
        android:pathData="M 110,110 m -1.1,0 a 1.1,1.1 0 1,0 2.2,0 a 1.1,1.1 0 1,0 -2.2,0" />
</vector>
