<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_seljuk_clock_bg"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="1dp"
    android:paddingTop="1dp"
    android:paddingBottom="2dp"
    android:clickable="true"
    android:focusable="true">

    <!-- 1. Üst Ana Bölüm: Zikirce 8 Köşeli Yuvarlatılmış Selçuklu Yıldızı & Tesbih Analog Saat (En Az Kenar Boşluğu) -->
    <FrameLayout
        android:id="@+id/widget_clock_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Kadran Çerçevesi (8 Köşeli Selçuklu Yıldızı + Kahverengi Tesbih + 12-3-6-9 + Saat Noktaları & Dakika Çizgileri) -->
        <ImageView
            android:id="@+id/widget_clock_marks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:src="@drawable/widget_analog_dial_marks"
            android:scaleType="fitCenter" />

        <!-- Kadran İçi Üst Bölüm: Sıradaki Vakit Adı ve Saati (12 Rakamının Altında, Sade & Zarif) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="100">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="26" />

            <LinearLayout
                android:id="@+id/widget_prayer_info_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="18"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_next_prayer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İmsak"
                    android:textColor="@color/widget_seljuk_text_secondary"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/widget_next_prayer_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="05:07"
                    android:textColor="@color/widget_seljuk_text_primary"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:gravity="center" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="56" />
        </LinearLayout>

        <!-- Canlı Analog Saat İbreleri (Sıfır Pil Tüketimi) -->
        <AnalogClock
            android:id="@+id/widget_analog_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:dial="@drawable/widget_analog_clock_dial_transparent"
            android:hand_hour="@drawable/widget_hour_hand"
            android:hand_minute="@drawable/widget_minute_hand"
            android:hand_second="@drawable/widget_second_hand" />

    </FrameLayout>

    <!-- 2. Alt Bölüm (Saatin Dışında, Widget'ın En Altında Zarif Canlı Geri Sayım Sayacı) -->
    <LinearLayout
        android:id="@+id/widget_countdown_pill"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="0dp"
        android:background="@drawable/widget_seljuk_pill_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <Chronometer
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_seljuk_pill_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:countDown="true"
            android:singleLine="true"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
