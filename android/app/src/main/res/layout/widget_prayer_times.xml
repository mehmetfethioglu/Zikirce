<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Üst Bar: Şehir ve Hicri Tarih -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        
        <TextView
            android:id="@+id/widget_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="İstanbul"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/widget_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text=""
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </RelativeLayout>

    <!-- Öne Çıkarılmış Sonraki Namaz Kartı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_time_bg_active"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SONRAKİ NAMAZ VAKTİ"
            android:textColor="#F59E0B"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>
            
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="2dp">
            
            <TextView
                android:id="@+id/widget_next_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Akşam"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
                
            <TextView
                android:id="@+id/widget_next_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="17:44"
                android:textColor="#FBBF24"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        
        <Chronometer
            android:id="@+id/widget_next_prayer_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#34D399"
            android:textSize="13sp"
            android:textStyle="bold"
            android:countDown="true"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Namaz Vakitleri Grid (3 satır, 2 kolon) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Satır 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <!-- İmsak -->
            <LinearLayout
                android:id="@+id/widget_imsak_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="@drawable/widget_time_bg_normal"
                android:layout_marginEnd="2dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="İmsak"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/widget_imsak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="04:12"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Güneş -->
            <LinearLayout
                android:id="@+id/widget_gunes_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="@drawable/widget_time_bg_normal"
                android:layout_marginStart="2dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Güneş"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/widget_gunes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="05:48"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Satır 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <!-- Öğle -->
            <LinearLayout
                android:id="@+id/widget_ogle_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="@drawable/widget_time_bg_normal"
                android:layout_marginEnd="2dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Öğle"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/widget_ogle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="13:08"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- İkindi -->
            <LinearLayout
                android:id="@+id/widget_ikindi_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="@drawable/widget_time_bg_normal"
                android:layout_marginStart="2dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="İkindi"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/widget_ikindi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16:54"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Satır 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Akşam -->
            <LinearLayout
                android:id="@+id/widget_aksam_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="@drawable/widget_time_bg_normal"
                android:layout_marginEnd="2dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Akşam"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/widget_aksam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20:18"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Yatsı -->
            <LinearLayout
                android:id="@+id/widget_yatsi_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="@drawable/widget_time_bg_normal"
                android:layout_marginStart="2dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Yatsı"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/widget_yatsi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="21:46"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
