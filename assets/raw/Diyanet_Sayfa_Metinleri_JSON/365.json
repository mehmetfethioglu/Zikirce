    "CuzNo": 19,
    "PageNo": 365,
    "ArCuzNo": "۱۹",
    "ArPageNo": "۳٦٥",
    "QuranAyats": [
        {
            "Id": 20377,
            "SureId": 25,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "وَمَٓا اَرْسَلْنَاكَ اِلَّا مُبَشِّرًا وَنَذٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 25,
                "MealInfo": "Mekke döneminde inmiştir. 68-70. âyetlerin Medine döneminde indiği konusunda bir rivayet de vardır. 77 âyettir. Sûre, adını ilk âyette geçen <b>“elFurkân</b>” kelimesinden almaktadır. <b>Furkân, “hak ile batılı birbirinden ayıran”demek olup Kur’an’ın isimlerinden biridir.</b> Sûre de temel konular olarak Hz.Peygamber’in tüm insanlığa gönderildiği, onun tebliğ sırasında karşılaştığı zorluklar ve şirkin kökünün kazınacağı, geçmiş ümmetlerin hayatlarından bazı örnekler de verilerek ele alınmaktadır.",
                "SureNameTurkish": "Furkân",
                "SureNameArabic": "الْفُرْقَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 42,
                "AyetCount": 77,
                "Cuz": 18,
                "FirstPage": 359,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20384,
            "SureId": 25,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "قُلْ مَٓا اَسْـَٔلُكُمْ عَلَیْهِ مِنْ اَجْرٍ اِلَّا مَنْ شَٓاءَ اَنْ یَتَّخِذَ اِلٰى رَبِّهٖ سَبٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20391,
            "SureId": 25,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "وَتَوَكَّلْ عَلَى الْحَیِّ الَّذٖی لَا یَمُوتُ وَسَبِّـحْ بِحَمْدِهٖؕ وَكَفٰى بِهٖ بِذُنُوبِ عِبَادِهٖ خَبٖیرًاۚۛ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20398,
            "SureId": 25,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "اَلَّذٖی خَلَقَ السَّمٰوَاتِ وَالْاَرْضَ وَمَا بَیْنَهُمَا فٖی سِتَّةِ اَیَّامٍ ثُمَّ اسْتَوٰى عَلَى الْعَرْشِۚۛ اَلرَّحْمٰنُ فَسْـَٔلْ بِهٖ خَبٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20405,
            "SureId": 25,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "وَاِذَا قٖیلَ لَهُمُ اسْجُدُوا لِلرَّحْمٰنِ قَالُوا وَمَا الرَّحْمٰنُࣗ اَنَسْجُدُ لِمَا تَاْمُرُنَا وَزَادَهُمْ نُفُورًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20412,
            "SureId": 25,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "تَبَارَكَ الَّذٖی جَعَلَ فِی السَّمَٓاءِ بُرُوجًا وَجَعَلَ فٖیهَا سِرَاجًا وَقَمَرًا مُنٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20419,
            "SureId": 25,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "وَهُوَ الَّذٖی جَعَلَ الَّیْلَ وَالنَّهَارَ خِلْفَةً لِمَنْ اَرَادَ اَنْ یَذَّكَّرَ اَوْ اَرَادَ شُكُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20426,
            "SureId": 25,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "وَعِبَادُ الرَّحْمٰنِ الَّذٖینَ یَمْشُونَ عَلَى الْاَرْضِ هَوْنًا وَاِذَا خَاطَبَهُمُ الْجَاهِلُونَ قَالُوا سَلَامًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20433,
            "SureId": 25,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "وَالَّذٖینَ یَبٖیتُونَ لِرَبِّهِمْ سُجَّدًا وَقِیَامًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20440,
            "SureId": 25,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "وَالَّذٖینَ یَقُولُونَ رَبَّنَا اصْرِفْ عَنَّا عَذَابَ جَهَنَّمَࣗ اِنَّ عَذَابَهَا كَانَ غَرَامًاࣗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20447,
            "SureId": 25,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "اِنَّهَا سَٓاءَتْ مُسْتَقَرًّا وَمُقَامًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20454,
            "SureId": 25,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "وَالَّذٖینَ اِذَٓا اَنْفَقُوا لَمْ یُسْرِفُوا وَلَمْ یَقْتُرُوا وَكَانَ بَیْنَ ذٰلِكَ قَوَامًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 20375,
            "SureId": 25,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "Biz seni sadece bir müjdeci ve uyarıcı olarak gönderdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 25,
                "MealInfo": "Mekke döneminde inmiştir. 68-70. âyetlerin Medine döneminde indiği konusunda bir rivayet de vardır. 77 âyettir. Sûre, adını ilk âyette geçen <b>“elFurkân</b>” kelimesinden almaktadır. <b>Furkân, “hak ile batılı birbirinden ayıran”demek olup Kur’an’ın isimlerinden biridir.</b> Sûre de temel konular olarak Hz.Peygamber’in tüm insanlığa gönderildiği, onun tebliğ sırasında karşılaştığı zorluklar ve şirkin kökünün kazınacağı, geçmiş ümmetlerin hayatlarından bazı örnekler de verilerek ele alınmaktadır.",
                "SureNameTurkish": "Furkân",
                "SureNameArabic": "الْفُرْقَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 42,
                "AyetCount": 77,
                "Cuz": 18,
                "FirstPage": 359,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20382,
            "SureId": 25,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "De ki: “Bu görevimden dolayı, dileyenin rabbine giden bir yol izlemesi dışında, sizden bir karşılık istemiyorum.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20389,
            "SureId": 25,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "Asla ölmeyecek olan O diri varlığa (Allah’a) dayanıp güven ve O’na hamdederek yüceliğini dile getir. Kullarının günahlarından haberdar olma konusunda O kendi kendine yeterlidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20396,
            "SureId": 25,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "Gökleri, yeri ve bu ikisi arasında bulunanları altı günde yaratan, sonra arşa istivâ eden O’dur. O Rahmân’dır. O’nu bilen birine (yine kendisine) sor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20403,
            "SureId": 25,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "Onlara, “Rahmân’a secde edin” denildiğinde, “Rahmân da neymiş! Biz, senin istediğin şeye secde eder miyiz?” derler ve bu istek onları haktan daha da uzaklaştırır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20410,
            "SureId": 25,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "Gökte yıldız kümeleri oluşturan, yine orada bir ışık kaynağı ve aydınlatan bir ay yaratan (Allah) mübarektir, cömerttir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20417,
            "SureId": 25,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "Düşünüp ibret almak ve şükretmek isteyenler için gece ile gündüzü birbiri ardına getiren de O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20424,
            "SureId": 25,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "Rahmân’ın has kulları yeryüzünde vakarla yürüyen, cahiller onlara laf attığı zaman, “selâm” deyip geçen kullardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20431,
            "SureId": 25,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "Gecelerini rablerine secde ederek, huzurunda durarak geçirirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20438,
            "SureId": 25,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "“Ey rabbimiz, derler; bizi cehennem azabından uzak tut; çünkü onun azabı bitip tükenme bilmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20445,
            "SureId": 25,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "O cehennem ne kötü bir yerleşme ve kalma yeridir!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20452,
            "SureId": 25,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 365,
            "AyetText": "Yine o iyi kullar, harcama yaptıkları zaman ne saçıp savururlar ne de cimrilik ederler; harcamaları bu ikisi arasında mâkul bir dengeye göre olur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Furkân",
