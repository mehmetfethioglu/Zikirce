    "QuranAyats": [
        {
            "Id": 25403,
            "SureId": 34,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "وَلَا تَنْفَعُ الشَّفَاعَةُ عِنْدَهُٓ اِلَّا لِمَنْ اَذِنَ لَهُؕ حَتّٰٓى اِذَا فُزِّعَ عَنْ قُلُوبِهِمْ قَالُوا مَاذَاۙ قَالَ رَبُّكُمْؕ قَالُوا الْحَقَّۚ وَهُوَ الْعَلِیُّ الْكَبٖیرُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 34,
                "MealInfo": "Mekke döneminde inmiştir. 54 âyettir. Sûre, adını 15. âyette geçen <b>“Sebe’ ”&nbsp;</b>kelimesinden almıştır. <b>&nbsp;</b>Sûre de başlıca <b>müşriklerin ahireti inkâr etmeleri, Davûd ve Süleyman Peygamberlerin kıssaları ve müşriklerin Hz. Muhammed’in peygamberliğihakkındaki bazı şüpheleri </b>konu edilmektedir.",
                "SureNameTurkish": "Sebe'",
                "SureNameArabic": "سَبَأٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 58,
                "AyetCount": 54,
                "Cuz": 22,
                "FirstPage": 428,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 25410,
            "SureId": 34,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "قُلْ مَنْ یَرْزُقُكُمْ مِنَ السَّمٰوَاتِ وَالْاَرْضِؕ قُلِ اللّٰهُۙ وَاِنَّٓا اَوْ اِیَّاكُمْ لَعَلٰى هُدًى اَوْ فٖی ضَلَالٍ مُبٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25417,
            "SureId": 34,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "قُلْ لَا تُسْـَٔلُونَ عَمَّٓا اَجْرَمْنَا وَلَا نُسْـَٔلُ عَمَّا تَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25424,
            "SureId": 34,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "قُلْ یَجْمَعُ بَیْنَنَا رَبُّنَا ثُمَّ یَفْتَحُ بَیْنَنَا بِالْحَقِّؕ وَهُوَ الْفَتَّاحُ الْعَلٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25431,
            "SureId": 34,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "قُلْ اَرُونِیَ الَّذٖینَ اَلْحَقْتُمْ بِهٖ شُرَكَٓاءَ كَلَّاؕ بَلْ هُوَ اللّٰهُ الْعَزٖیزُ الْحَكٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25438,
            "SureId": 34,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "وَمَٓا اَرْسَلْنَاكَ اِلَّا كَٓافَّةً لِلنَّاسِ بَشٖیرًا وَنَذٖیرًا وَلٰكِنَّ اَكْثَرَ النَّاسِ لَا یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25445,
            "SureId": 34,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "وَیَقُولُونَ مَتٰى هٰذَا الْوَعْدُ اِنْ كُنْتُمْ صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25452,
            "SureId": 34,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "قُلْ لَكُمْ مٖیعَادُ یَوْمٍ لَا تَسْتَاْخِرُونَ عَنْهُ سَاعَةً وَلَا تَسْتَقْدِمُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25459,
            "SureId": 34,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "وَقَالَ الَّذٖینَ كَفَرُوا لَنْ نُؤْمِنَ بِهٰذَا الْقُرْاٰنِ وَلَا بِالَّذٖی بَیْنَ یَدَیْهِؕ وَلَوْ تَرٰٓى اِذِ الظَّالِمُونَ مَوْقُوفُونَ عِنْدَ رَبِّهِمْۚ یَرْجِعُ بَعْضُهُمْ اِلٰى بَعْضٍࣙ الْقَوْلَۚ یَقُولُ الَّذٖینَ اسْتُضْعِفُوا لِلَّذٖینَ اسْتَكْبَرُوا لَوْلَٓا اَنْتُمْ لَكُنَّا مُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 25401,
            "SureId": 34,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "Allah katında, O’nun izin verdiği kimselerden başkasının şefaati yarar sağlamaz. Sonunda kalplerinden korku giderilince, “Rabbiniz ne buyurdu?” derler. Onlar da şu cevabı verirler: “Hak olanı buyurdu. O yücedir, uludur.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 34,
                "MealInfo": "Mekke döneminde inmiştir. 54 âyettir. Sûre, adını 15. âyette geçen <b>“Sebe’ ”&nbsp;</b>kelimesinden almıştır. <b>&nbsp;</b>Sûre de başlıca <b>müşriklerin ahireti inkâr etmeleri, Davûd ve Süleyman Peygamberlerin kıssaları ve müşriklerin Hz. Muhammed’in peygamberliğihakkındaki bazı şüpheleri </b>konu edilmektedir.",
                "SureNameTurkish": "Sebe'",
                "SureNameArabic": "سَبَأٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 58,
                "AyetCount": 54,
                "Cuz": 22,
                "FirstPage": 428,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 25408,
            "SureId": 34,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "De ki: “Göklerden ve yerden size rızık veren kimdir?” De ki: “Allah’tır. O halde biz veya siz, iki taraftan biri ya doğru yoldadır yahut açık bir sapkınlık içindedir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25415,
            "SureId": 34,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "De ki: “Bizim işlediğimiz suçlardan dolayı siz sorumlu olmayacağınız gibi sizin yapıp ettiklerinizden ötürü de biz hesaba çekilmeyiz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25422,
            "SureId": 34,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "De ki: “Rabbimiz hepimizi bir araya getirecek, sonra aramızda adaletle hükmünü verecektir. Haklıyı haksızdan en iyi ayıran ve her şeyi bilen O’dur.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25429,
            "SureId": 34,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "De ki: “Ortak diye O’nun yanına kattıklarınızı bana gösterin bakalım! Hayır asla (gösteremezsiniz)! Bilâkis yegâne galip ve her şeyi hikmetle yöneten yalnız o ­Allah’tır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25436,
            "SureId": 34,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "Biz seni sadece müjdeleyici ve uyarıcı olarak bütün insanlara gönderdik; fakat insanların çoğu bunu anlamıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25443,
            "SureId": 34,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "“Eğer doğru söylüyorsanız, bu vaad ne zaman gerçekleşecek, söyleyin bakalım!” diyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25450,
            "SureId": 34,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "De ki: “Sizin için öyle bir vakit belirlenmiştir ki, ondan ne bir an geri kalabilirsiniz ne de ileri geçebilirsiniz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25457,
            "SureId": 34,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 431,
            "AyetText": "İnkâr edenler şöyle dediler: “Biz ne bu Kur’an’a inanırız ne de bundan öncekilere!” Sen o zalimleri rablerinin huzurunda, tutuklanmış halde birbirlerine söz atarlarken bir görsen! Horlananlar büyüklük taslayanlara şöyle derler: “Siz olmasaydınız, hiç kuşkusuz biz iman ederdik.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
