    ],
    "CuzNo": 29,
    "PageNo": 562,
    "ArCuzNo": "۲۹",
    "ArPageNo": "٥٦۲",
    "QuranAyats": [
        {
            "Id": 36694,
            "SureId": 67,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "تَبَارَكَ الَّذٖی بِیَدِهِ الْمُلْكُؗ وَهُوَ عَلٰى كُلِّ شَیْءٍ قَدٖیرٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 67,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. Sûre, adını birinci âyette geçen “elMülk”kelimesinden almıştır. Sûrede başlıca, Allah’ın azameti, Allah’ın birliğinindelilleri ve öldükten sonra dirilmeyi inkâr edenlerin akıbetleri konuedilmektedir",
                "SureNameTurkish": "Mülk",
                "SureNameArabic": "الْمُلْكِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 77,
                "AyetCount": 30,
                "Cuz": 29,
                "FirstPage": 562,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 36701,
            "SureId": 67,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "اَلَّذٖی خَلَقَ الْمَوْتَ وَالْحَیٰوةَ لِیَبْلُوَكُمْ اَیُّكُمْ اَحْسَنُ عَمَلًاؕ وَهُوَ الْعَزٖیزُ الْغَفُورُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36708,
            "SureId": 67,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "اَلَّذٖی خَلَقَ سَبْعَ سَمٰوَاتٍ طِبَاقًاؕ مَا تَرٰى فٖی خَلْقِ الرَّحْمٰنِ مِنْ تَفَاوُتٍؕ فَارْجِعِ الْبَصَرَۙ هَلْ تَرٰى مِنْ فُطُورٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36715,
            "SureId": 67,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "ثُمَّ ارْجِعِ الْبَصَرَ كَرَّتَیْنِ یَنْقَلِبْ اِلَیْكَ الْبَصَرُ خَاسِئًا وَهُوَ حَسٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36722,
            "SureId": 67,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "وَلَقَدْ زَیَّنَّا السَّمَٓاءَ الدُّنْیَا بِمَصَابٖیحَ وَجَعَلْنَاهَا رُجُومًا لِلشَّیَاطٖینِ وَاَعْتَدْنَا لَهُمْ عَذَابَ السَّعٖیرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36729,
            "SureId": 67,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "وَلِلَّذٖینَ كَفَرُوا بِرَبِّهِمْ عَذَابُ جَهَنَّمَؕ وَبِئْسَ الْمَصٖیرُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36736,
            "SureId": 67,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "اِذَٓا اُلْقُوا فٖیهَا سَمِعُوا لَهَا شَهٖیقًا وَهِیَ تَفُورُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36743,
            "SureId": 67,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "تَكَادُ تَمَیَّزُ مِنَ الْغَیْظِؕ كُلَّمَٓا اُلْقِیَ فٖیهَا فَوْجٌ سَاَلَهُمْ خَزَنَتُهَٓا اَلَمْ یَاْتِكُمْ نَذٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36750,
            "SureId": 67,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "قَالُوا بَلٰى قَدْ جَٓاءَنَا نَذٖیرٌ فَكَذَّبْنَا وَقُلْنَا مَا نَزَّلَ اللّٰهُ مِنْ شَیْءٍۚ اِنْ اَنْتُمْ اِلَّا فٖی ضَلَالٍ كَبٖیرٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36757,
            "SureId": 67,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "وَقَالُوا لَوْ كُنَّا نَسْمَعُ اَوْ نَعْقِلُ مَا كُنَّا فٖٓی اَصْحَابِ السَّعٖیرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36764,
            "SureId": 67,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "فَاعْتَرَفُوا بِذَنْبِهِمْۚ فَسُحْقًا لِاَصْحَابِ السَّعٖیرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36771,
            "SureId": 67,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "اِنَّ الَّذٖینَ یَخْشَوْنَ رَبَّهُمْ بِالْغَیْبِ لَهُمْ مَغْفِرَةٌ وَاَجْرٌ كَبٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 36692,
            "SureId": 67,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "Mutlak hükümranlık elinde olan Allah aşkındır, cömerttir ve O’nun her şeye gücü yeter.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 67,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. Sûre, adını birinci âyette geçen “elMülk”kelimesinden almıştır. Sûrede başlıca, Allah’ın azameti, Allah’ın birliğinindelilleri ve öldükten sonra dirilmeyi inkâr edenlerin akıbetleri konuedilmektedir",
                "SureNameTurkish": "Mülk",
                "SureNameArabic": "الْمُلْكِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 77,
                "AyetCount": 30,
                "Cuz": 29,
                "FirstPage": 562,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 36699,
            "SureId": 67,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "Hanginizin davranışça daha iyi olduğunu denemek için ölümü ve hayatı yaratan O’dur. O, güçlüdür, çok bağışlayıcıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36706,
            "SureId": 67,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "Yedi göğü birbiriyle tam bir uygunluk içinde yaratan O’dur. Rahmânın yaratışında hiçbir uyumsuzluk göremezsin. Gözünü çevir de bir bak, bir bozukluk görebiliyor musun?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36713,
            "SureId": 67,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "Sonra gözünü tekrar tekrar çevir de bak; (kusur arayan) göz aradığını bulamadan bitkin olarak sana dönecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36720,
            "SureId": 67,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "Gerçek şu ki biz yakın göğü kandillerle süsledik. Ayrıca bunlarla şeytanların taşlanmasını sağladık ve onlara alevli ateş azabını hazırladık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36727,
            "SureId": 67,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "Rablerini inkâr edenlere cehennem azabı vardır. Orası ne kötü bir varış yeri!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36734,
            "SureId": 67,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "Oraya atıldıklarında, onun kaynarken çıkardığı uğultuyu işitirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36741,
            "SureId": 67,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "Cehennem neredeyse öfkesinden çatlayacak! Oraya her bir grup atıldıkça, muhafızları onlara, “Size bir uyarıcı gelmemiş miydi?” diye sorarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36748,
            "SureId": 67,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "Şöyle cevap verirler: “Evet, doğrusu bize bir uyarıcı (peygamber) gelmişti; fakat biz onu yalancılıkla itham etmiş ve ‘Allah hiçbir şey göndermemiştir; siz gerçekten büyük bir sapkınlık içindesiniz!’ demiştik.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36755,
            "SureId": 67,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "“Şayet kulak vermiş veya aklımızı kullanmış olsaydık, şimdi şu alevli cehennemin mahkûmları arasında olmazdık!” diye de ilâve ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36762,
            "SureId": 67,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "Böylece günahlarını itiraf etmiş olurlar. O alevli ateşin mahkûmları artık rahmetten mahrumdurlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36769,
            "SureId": 67,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 562,
            "AyetText": "Görmedikleri halde rablerinden korkup saygı duyanlara gelince, onları da hem bir bağışlanma hem de büyük bir ödül beklemektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Mülk",
    "QuranSureLabel": "الْمُلْكِ",
    "EndPageSure": null
}