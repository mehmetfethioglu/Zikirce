    "CuzNo": 18,
    "PageNo": 347,
    "ArCuzNo": "۱۸",
    "ArPageNo": "۳٤۷",
    "QuranAyats": [
        {
            "Id": 19236,
            "SureId": 23,
            "AyetId": 75,
            "LanguageId": 7,
            "AyetNumber": "٧٥",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "وَلَوْ رَحِمْنَاهُمْ وَكَشَفْنَا مَا بِهِمْ مِنْ ضُرٍّ لَلَجُّوا فٖی طُغْیَانِهِمْ یَعْمَهُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19243,
            "SureId": 23,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "وَلَقَدْ اَخَذْنَاهُمْ بِالْعَذَابِ فَمَا اسْتَكَانُوا لِرَبِّهِمْ وَمَا یَتَضَرَّعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19250,
            "SureId": 23,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "حَتّٰٓى اِذَا فَتَحْنَا عَلَیْهِمْ بَابًا ذَا عَذَابٍ شَدٖیدٍ اِذَا هُمْ فٖیهِ مُبْلِسُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19257,
            "SureId": 23,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "وَهُوَ الَّذٖٓی اَنْشَاَ لَكُمُ السَّمْعَ وَالْاَبْصَارَ وَالْاَفْــِٔدَةَؕ قَلٖیلًا مَا تَشْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19264,
            "SureId": 23,
            "AyetId": 79,
            "LanguageId": 7,
            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "وَهُوَ الَّذٖی ذَرَاَكُمْ فِی الْاَرْضِ وَاِلَیْهِ تُحْشَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19271,
            "SureId": 23,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "وَهُوَ الَّذٖی یُحْيٖ وَیُمٖیتُ وَلَهُ اخْتِلَافُ الَّیْلِ وَالنَّهَارِؕ اَفَلَا تَعْقِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19278,
            "SureId": 23,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "بَلْ قَالُوا مِثْلَ مَا قَالَ الْاَوَّلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19285,
            "SureId": 23,
            "AyetId": 82,
            "LanguageId": 7,
            "AyetNumber": "٨٢",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "قَالُٓوا ءَاِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا ءَاِنَّا لَمَبْعُوثُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19292,
            "SureId": 23,
            "AyetId": 83,
            "LanguageId": 7,
            "AyetNumber": "٨٣",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "لَقَدْ وُعِدْنَا نَحْنُ وَاٰبَٓاؤُ𐻾نَا هٰذَا مِنْ قَبْلُ اِنْ هٰذَٓا اِلَّٓا اَسَاطٖیرُ الْاَوَّلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19299,
            "SureId": 23,
            "AyetId": 84,
            "LanguageId": 7,
            "AyetNumber": "٨٤",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "قُلْ لِمَنِ الْاَرْضُ وَمَنْ فٖیهَٓا اِنْ كُنْتُمْ تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19306,
            "SureId": 23,
            "AyetId": 85,
            "LanguageId": 7,
            "AyetNumber": "٨٥",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "سَیَقُولُونَ لِلّٰهِؕ قُلْ اَفَلَا تَذَكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19313,
            "SureId": 23,
            "AyetId": 86,
            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "قُلْ مَنْ رَبُّ السَّمٰوَاتِ السَّبْعِ وَرَبُّ الْعَرْشِ الْعَظٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19320,
            "SureId": 23,
            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "سَیَقُولُونَ لِلّٰهِؕ قُلْ اَفَلَا تَتَّقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19327,
            "SureId": 23,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "قُلْ مَنْ بِیَدِهٖ مَلَكُوتُ كُلِّ شَیْءٍ وَهُوَ یُجٖیرُ وَلَا یُجَارُ عَلَیْهِ اِنْ كُنْتُمْ تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19334,
            "SureId": 23,
            "AyetId": 89,
            "LanguageId": 7,
            "AyetNumber": "٨٩",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "سَیَقُولُونَ لِلّٰهِؕ قُلْ فَاَنّٰى تُسْحَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 19234,
            "SureId": 23,
            "AyetId": 75,
            "LanguageId": 5,
            "AyetNumber": "75",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "Onlara merhamet edip de içine düştükleri sıkıntıyı gidersek yine de büyüklük taslayarak körü körüne taşkınlıklarını sürdürürler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19241,
            "SureId": 23,
            "AyetId": 76,
            "LanguageId": 5,
            "AyetNumber": "76",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "Andolsun biz onları ağır sıkıntılara soktuk da yine rablerine boyun eğmediler, hâlâ da O’na yakarmıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19248,
            "SureId": 23,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "En sonunda üzerlerine çok şiddetli bir azap kapısı açtığımızda bir de görürsün ki onlar bu durumda tam bir şaşkınlık ve ümitsizlik içine düşmüşlerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19255,
            "SureId": 23,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "Sizi kulaklar, gözler ve akıllarla donatan O’dur. Ne de az şükrediyorsunuz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19262,
            "SureId": 23,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "Sizi yeryüzünde yaratıp yayan da O’dur. Nihayet O’nun huzurunda ­toplanacaksınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19269,
            "SureId": 23,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "Yaşatan da öldüren de O’dur. Gece ile gündüzün yer değiştirmesi de O’nun eseridir. Artık aklınızı kullanmayacak mısınız?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19276,
            "SureId": 23,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "Buna rağmen onlar hâlâ eskilerin dediklerine benzer şeyler söylüyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19283,
            "SureId": 23,
            "AyetId": 82,
            "LanguageId": 5,
            "AyetNumber": "82",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "Diyorlar ki: “Sahi biz, ölüp de toprak ve kemik yığını haline gelmişken mi, yeniden mi diriltilecekmişiz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19290,
            "SureId": 23,
            "AyetId": 83,
            "LanguageId": 5,
            "AyetNumber": "83",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "Doğrusu daha önce de hem bize hem atalarımıza böyle bir vaadde bulunulmuştu. Ama bu, geçmiştekilerin masallarından başka bir şey değildir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19297,
            "SureId": 23,
            "AyetId": 84,
            "LanguageId": 5,
            "AyetNumber": "84",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "De ki: “Biliyorsanız söyleyin, bu dünya ve onda bulunanlar kime aittir?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19304,
            "SureId": 23,
            "AyetId": 85,
            "LanguageId": 5,
            "AyetNumber": "85",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "“Allah’a” diyecekler. “O halde düşünmez misiniz?” de.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19311,
            "SureId": 23,
            "AyetId": 86,
            "LanguageId": 5,
            "AyetNumber": "86",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "“Peki yedi göğün rabbi, yüce arşın rabbi kimdir?” diye sor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19318,
            "SureId": 23,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "“Bunların rabbi Allah’tır” diyecekler. “O halde Allah’a saygınız yok mu?” de.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19325,
            "SureId": 23,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "“Biliyorsanız söyleyin, bütünüyle varlığın yönetimi elinde olan, kendisi her şeyi koruyup kollayan, fakat kendisi korunmaya muhtaç olmayan kimdir?” de.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19332,
            "SureId": 23,
            "AyetId": 89,
            "LanguageId": 5,
            "AyetNumber": "89",
            "AyetVisible": true,
            "Page": 347,
            "AyetText": "“Hepsi Allah’a aittir” diyecekler. “O zaman nasıl olup da böyle büyülenmiş gibi davranıyorsunuz?” de.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Mü'minûn",
    "QuranSureLabel": "الْمُؤْمِنُونَ",
    "EndPageSure": null
}