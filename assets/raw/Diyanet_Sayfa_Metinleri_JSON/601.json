                "FirstPage": 601,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 43190,
            "SureId": 102,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "حَتّٰى زُرْتُمُ الْمَقَابِرَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43197,
            "SureId": 102,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "كَلَّا سَوْفَ تَعْلَمُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43204,
            "SureId": 102,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43211,
            "SureId": 102,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْیَقٖینِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43218,
            "SureId": 102,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "لَتَرَوُنَّ الْجَحٖیمَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43225,
            "SureId": 102,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "ثُمَّ لَتَرَوُنَّهَا عَیْنَ الْیَقٖینِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43232,
            "SureId": 102,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "ثُمَّ لَتُسْـَٔلُنَّ یَوْمَئِذٍ عَنِ النَّعٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
