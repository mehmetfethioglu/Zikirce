            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "O dehşetli ses!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 101,
                "MealInfo": "Mekke döneminde inmiştir. 11 âyettir. “Kâri’a”, vuran, çarpan, kapıyı çalan,yürekleri hoplatan şey demektir. Burada, kıyamet gününü ifade etmektedir.",
                "SureNameTurkish": "Kâria",
                "SureNameArabic": "الْقَارِعَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 30,
                "AyetCount": 11,
                "Cuz": 30,
                "FirstPage": 601,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 43111,
            "SureId": 101,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "O ne dehşetli ses!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43118,
            "SureId": 101,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "Nedir o dehşetli ses, bilir misin?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43125,
            "SureId": 101,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "O gün insanlar sağa sola dağılmış kelebekler gibi olur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43132,
            "SureId": 101,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "Dağlar da atılmış renkli yüne dönüşür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43139,
            "SureId": 101,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "Kimin tartılan amelleri ağır gelirse,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43146,
            "SureId": 101,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "İşte o mutlu bir hayat içinde olur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43153,
            "SureId": 101,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "Amelleri hafif olana gelince,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43160,
            "SureId": 101,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "Onu kucaklayacak olan hâviyedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43167,
            "SureId": 101,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "O nedir, bilir misin?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43174,
            "SureId": 101,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "Yakıp kavuran bir ateş!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43181,
            "SureId": 102,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1-2",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "Çoklukla övünme yarışı sizi kabirlere varıncaya kadar oyaladı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 102,
                "MealInfo": "Mekke döneminde inmiştir. 8 âyettir. Tekâsür, mal, mülk ve çoluk çocuğunçokluğuyla övünmek demektir",
                "SureNameTurkish": "Tekâsür",
                "SureNameArabic": "التَّكَاثُرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 16,
                "AyetCount": 8,
                "Cuz": 30,
                "FirstPage": 601,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 43188,
            "SureId": 102,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": false,
            "Page": 601,
            "AyetText": "Çoklukla övünme yarışı sizi kabirlere varıncaya kadar oyaladı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43195,
            "SureId": 102,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "Hayır! Yakında anlayacaksınız!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43202,
            "SureId": 102,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "Hayır hayır! Elbette yakında anlayacaksınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43209,
            "SureId": 102,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "Hayır! Keşke kesin bir bilgiyle bilmiş olsaydınız!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43216,
            "SureId": 102,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "Yemin olsun, cehennemi mutlaka göreceksiniz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43223,
            "SureId": 102,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "Sonra kuşkusuz onu gözünüzle ayan beyan göreceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43230,
            "SureId": 102,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "Nihayet o gün nimetlerden elbette sorguya çekileceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
