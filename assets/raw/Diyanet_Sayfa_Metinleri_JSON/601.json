            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "مَا الْقَارِعَةُۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43120,
            "SureId": 101,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "وَمَٓا اَدْرٰیكَ مَا الْقَارِعَةُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43127,
            "SureId": 101,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "یَوْمَ یَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43134,
            "SureId": 101,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوشِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43141,
            "SureId": 101,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "فَاَمَّا مَنْ ثَقُلَتْ مَوَازٖینُهُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43148,
            "SureId": 101,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "فَهُوَ فٖی عٖیشَةٍ رَاضِیَةٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43155,
            "SureId": 101,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "وَاَمَّا مَنْ خَفَّتْ مَوَازٖینُهُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43162,
            "SureId": 101,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "فَاُمُّهُ هَاوِیَةٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43169,
            "SureId": 101,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "وَمَٓا اَدْرٰیكَ مَا هِیَهْؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43176,
            "SureId": 101,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "نَارٌ حَامِیَةٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43183,
            "SureId": 102,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 601,
            "AyetText": "اَلْهٰیكُمُ التَّكَاثُرُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 102,
                "MealInfo": "Mekke döneminde inmiştir. 8 âyettir. Tekâsür, mal, mülk ve çoluk çocuğunçokluğuyla övünmek demektir",
                "SureNameTurkish": "Tekâsür",
                "SureNameArabic": "التَّكَاثُرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 16,
                "AyetCount": 8,
