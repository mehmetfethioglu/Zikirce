            "SureId": 2,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 2,
            "AyetText": "الَّذٖينَ يُؤْمِنُونَ بِالْغَیْبِ وَيُقٖيمُونَ الصَّلٰوةَ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": [],
            "Sure": null
        },
        {
            "Id": 11,
            "SureId": 2,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 2,
            "AyetText": "وَالَّذٖينَ يُؤْمِنُونَ بِمَٓا اُنْزِلَ اِلَیْكَ وَمَٓا اُنْزِلَ مِنْ قَبْلِكَۚ وَبِالْاٰخِرَةِ هُمْ يُوقِنُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": [],
            "Sure": null
        },
        {
            "Id": 12,
            "SureId": 2,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 2,
            "AyetText": "اُو𐻾لٰٓئِكَ عَلٰى هُدًى مِنْ رَبِّهِمْۙ وَاُو𐻾لٰٓئِكَ هُمُ الْمُفْلِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": [],
            "Sure": null
        }
