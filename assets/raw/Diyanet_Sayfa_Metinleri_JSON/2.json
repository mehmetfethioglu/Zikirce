        },
        {
            "Id": 9,
            "SureId": 2,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 2,
            "AyetText": "Bu, kapaklarında hiç şüphe olmayan kitaptır; muttakiler için bir hidayettir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": [],
            "Sure": null
        },
        {
            "Id": 10,
            "SureId": 2,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 2,
            "AyetText": "Onlar gayba inanırlar, namazı kılarlar, kendilerine verdiklerimizden infak ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": [],
            "Sure": null
        },
        {
            "Id": 11,
            "SureId": 2,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 2,
            "AyetText": "Sana indirilene ve senden önce indirilene de inanırlar; ahirete de kesin olarak iman ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": [],
            "Sure": null
        },
        {
            "Id": 12,
            "SureId": 2,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 2,
            "AyetText": "İşte onlar rablerinden bir hidayet üzeredirler ve kurtuluşa erenler de ancak onlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": [],
            "Sure": null
        }
