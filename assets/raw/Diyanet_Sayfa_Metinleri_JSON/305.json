            "AyetVisible": true,
            "Page": 305,
            "AyetText": "كٓـهٰیٰعٓصٓؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 15764,
            "SureId": 19,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "ذِكْرُ رَحْمَتِ رَبِّكَ عَبْدَهُ زَكَرِیَّاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15771,
            "SureId": 19,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "اِذْ نَادٰى رَبَّهُ نِدَٓاءً خَفِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15778,
            "SureId": 19,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "قَالَ رَبِّ اِنّٖی وَهَنَ الْعَظْمُ مِنّٖی وَاشْتَعَلَ الرَّاْسُ شَیْبًا وَلَمْ اَكُنْ بِدُعَٓائِكَ رَبِّ شَقِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15785,
            "SureId": 19,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "وَاِنّٖی خِفْتُ الْمَوَالِیَ مِنْ وَرَٓاءٖی وَكَانَتِ امْرَاَتٖی عَاقِرًا فَهَبْ لٖی مِنْ لَدُنْكَ وَلِیًّاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15792,
            "SureId": 19,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "یَرِثُنٖی وَیَرِثُ مِنْ اٰلِ یَعْقُوبَࣗ وَاجْعَلْهُ رَبِّ رَضِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15799,
            "SureId": 19,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "یَا زَكَرِیَّٓا اِنَّا نُبَشِّرُكَ بِغُلَامٍࣙ اسْمُهُ یَحْیٰىۙ لَمْ نَجْعَلْ لَهُ مِنْ قَبْلُ سَمِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15806,
            "SureId": 19,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "قَالَ رَبِّ اَنّٰى یَكُونُ لٖی غُلَامٌ وَكَانَتِ امْرَاَتٖی عَاقِرًا وَقَدْ بَلَغْتُ مِنَ الْكِبَرِ عِتِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15813,
            "SureId": 19,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "قَالَ كَذٰلِكَۚ قَالَ رَبُّكَ هُوَ عَلَیَّ هَیِّنٌ وَقَدْ خَلَقْتُكَ مِنْ قَبْلُ وَلَمْ تَكُ شَیْـًٔا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15820,
            "SureId": 19,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "قَالَ رَبِّ اجْعَلْ لٖٓی اٰیَةًؕ قَالَ اٰیَتُكَ اَلَّا تُكَلِّمَ النَّاسَ ثَلٰثَ لَیَالٍ سَوِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15827,
            "SureId": 19,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "فَخَرَجَ عَلٰى قَوْمِهٖ مِنَ الْمِحْرَابِ فَاَوْحٰٓى اِلَیْهِمْ اَنْ سَبِّحُوا بُكْرَةً وَعَشِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 15755,
            "SureId": 19,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "Kâf-hâ-yâ-ayn-sâd.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 15762,
            "SureId": 19,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "Bu, rabbinin Zekeriyyâ kuluna lutfettiği rahmetin anlatımıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15769,
            "SureId": 19,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "Hani o, alçak sesle rabbine yalvarmıştı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15776,
            "SureId": 19,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "“Rabbim!” demişti, “Benim kemiklerim zayıfladı, saçlarım ağardı. Rabbim! Ben sana ettiğim dualarda hiç eli boş dönmedim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15783,
            "SureId": 19,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5-6",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "Doğrusu ben, arkamdan iş başına geçecek olan yakınlarımdan endişe ediyorum; karım da kısırdır. Tarafından bana yerimi alacak bir halef ver; o, Ya‘kūb hânedanına da vâris olsun; rabbim, onu rızana erdir!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15790,
            "SureId": 19,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": false,
            "Page": 305,
            "AyetText": "Doğrusu ben, arkamdan iş başına geçecek olan yakınlarımdan endişe ediyorum; karım da kısırdır. Tarafından bana yerimi alacak bir halef ver; o, Ya‘kūb hânedanına da vâris olsun; rabbim, onu rızana erdir!\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15797,
            "SureId": 19,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "Allah buyurdu ki: “Ey Zekeriyyâ! Biz sana Yahyâ adında bir oğul müjdeliyoruz. Bu adı daha önce kimseye vermedik.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15804,
            "SureId": 19,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "Zekeriyyâ, “Rabbim!” dedi. “Karım kısır olduğu, ben de ihtiyarlığın son sınırına vardığım halde, benim nasıl oğlum olabilir?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15811,
            "SureId": 19,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "“Orası öyle” dedi ve buyurdu ki rabbin: “O bana kolaydır; daha önce, sen hiçbir şey değilken seni de yaratmıştım.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15818,
            "SureId": 19,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "Zekeriyyâ, “Rabbim! Öyle ise bana bir işaret ver” dedi. Allah, “Sana işaret, tam üç gün insanlarla konuşamamandır” buyurdu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15825,
            "SureId": 19,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 305,
            "AyetText": "Bunun üzerine Zekeriyyâ, mâbedden kavminin karşısına çıkarak onlara, özel bir işaret diliyle, “Sabah akşam Allah’ı tesbih edin” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
