{
    "PointerList": null,
    "CuzNo": 16,
    "PageNo": 313,
    "ArCuzNo": "۱٦",
    "ArPageNo": "۳۱۳",
    "QuranAyats": [
        {
            "Id": 16527,
            "SureId": 20,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "وَاَنَا اخْتَرْتُكَ فَاسْتَمِـعْ لِمَا یُوحٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16534,
            "SureId": 20,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "اِنَّنٖٓی اَنَا اللّٰهُ لَٓا اِلٰهَ اِلَّٓا اَنَا𐻾 فَاعْبُدْنٖیۙ وَاَقِمِ الصَّلٰوةَ لِذِكْرٖی",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16541,
            "SureId": 20,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "اِنَّ السَّاعَةَ اٰتِیَةٌ اَكَادُ اُخْفٖیهَا لِتُجْزٰى كُلُّ نَفْسٍ بِمَا تَسْعٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16548,
            "SureId": 20,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "فَلَا یَصُدَّنَّكَ عَنْهَا مَنْ لَا یُؤْمِنُ بِهَا وَاتَّبَعَ هَوٰیهُ فَتَرْدٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16555,
            "SureId": 20,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "وَمَا تِلْكَ بِیَمٖینِكَ یَا مُوسٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16562,
            "SureId": 20,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "قَالَ هِیَ عَصَایَۚ اَتَوَكَّـؤُ𐻾ا عَلَیْهَا وَاَهُشُّ بِهَا عَلٰى غَنَمٖی وَلِیَ فٖیهَا مَاٰرِبُ اُخْرٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16569,
            "SureId": 20,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "قَالَ اَلْقِهَا یَا مُوسٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16576,
            "SureId": 20,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "فَاَلْقٰیهَا فَاِذَا هِیَ حَیَّةٌ تَسْعٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16583,
            "SureId": 20,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "قَالَ خُذْهَا وَلَا تَخَفْࣞ سَنُعٖیدُهَا سٖیرَتَهَا الْاُو𐻿لٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16590,
            "SureId": 20,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "وَاضْمُمْ یَدَكَ اِلٰى جَنَاحِكَ تَخْرُجْ بَیْضَٓاءَ مِنْ غَیْرِ سُٓوءٍ اٰیَةً اُخْرٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16597,
            "SureId": 20,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "لِنُرِیَكَ مِنْ اٰیَاتِنَا الْكُبْرٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16604,
            "SureId": 20,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "اِذْهَبْ اِلٰى فِرْعَوْنَ اِنَّهُ طَغٰىࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16611,
            "SureId": 20,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "قَالَ رَبِّ اشْرَحْ لٖی صَدْرٖیۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16618,
            "SureId": 20,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "وَیَسِّرْ لٖٓی اَمْرٖیۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16625,
            "SureId": 20,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "وَاحْلُلْ عُقْدَةً مِنْ لِسَانٖیۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16632,
            "SureId": 20,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "یَفْقَهُوا قَوْلٖیࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16639,
            "SureId": 20,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "وَاجْعَلْ لٖی وَزٖیرًا مِنْ اَهْلٖیۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16646,
            "SureId": 20,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "هٰرُونَ اَخٖیۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16653,
            "SureId": 20,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "اُشْدُدْ بِهٖٓ اَزْرٖیۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16660,
            "SureId": 20,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "وَاَشْرِكْهُ فٖٓی اَمْرٖیۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16667,
            "SureId": 20,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "كَیْ نُسَبِّحَكَ كَثٖیرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16674,
            "SureId": 20,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "وَنَذْكُرَكَ كَثٖیرًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16681,
            "SureId": 20,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "اِنَّكَ كُنْتَ بِنَا بَصٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16688,
            "SureId": 20,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "قَالَ قَدْ اُو𐻿تٖیتَ سُؤْلَكَ یَا مُوسٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16695,
            "SureId": 20,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "وَلَقَدْ مَنَنَّا عَلَیْكَ مَرَّةً اُخْرٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 16525,
            "SureId": 20,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Ben seni seçtim, şimdi vahyedilecek olana kulak ver.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16532,
            "SureId": 20,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Kuşkusuz ben, yalnız ben Allahım. Benden başka tanrı yoktur. O halde bana kulluk et, beni hatırında tutmak için namazı kıl.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16539,
            "SureId": 20,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "“Onun vaktini herkesten gizlemiş olsam da, her bir kişinin yapıp ettiğinin karşılığını görmesi için kıyamet mutlaka gelecektir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16546,
            "SureId": 20,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "“Ona inanmayan ve kendi tutkularının peşinden gidenler sakın seni ona inanmaktan alıkoymasın, sonra sen de helâk olursun!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16553,
            "SureId": 20,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Nedir o sağ elindeki, ey Mûsâ?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16560,
            "SureId": 20,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Dedi ki: “O benim asâmdır. Ona dayanırım, onunla koyunlarıma yaprak silkelerim, ona başkaca ihtiyaçlarım da var.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16567,
            "SureId": 20,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Allah buyurdu: “Onu yere at ey Mûsâ!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16574,
            "SureId": 20,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Hemen attı. Bir de ne görsün, o akıp giden bir yılan oluvermiş!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16581,
            "SureId": 20,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Allah, “Tut onu ve korkma, biz onu hemen eski haline döndüreceğiz” buyurdu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16588,
            "SureId": 20,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "“Şimdi de elini koynuna sok, bir hastalık yüzünden olmaksızın, bir başka mûcize olarak elin bembeyaz çıkacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16595,
            "SureId": 20,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Böylece sana büyük mûcizelerimiz­den bir kısmını göstermiş olalım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16602,
            "SureId": 20,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Firavun’a git, çünkü o sınırı çok aştı.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16609,
            "SureId": 20,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Mûsâ “Rabbim!” dedi, “Gönlüme ferahlık ver.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16616,
            "SureId": 20,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "İşimi bana kolaylaştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16623,
            "SureId": 20,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Dilimden düğümü çöz,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16630,
            "SureId": 20,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Ki sözümü iyi anlasınlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16637,
            "SureId": 20,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Yakınlarımdan birini bana yardımcı ver.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16644,
            "SureId": 20,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Kardeşim Hârûn’u.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16651,
            "SureId": 20,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Onunla gücümü pekiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16658,
            "SureId": 20,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Onu da görevime ortak et.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16665,
            "SureId": 20,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Ta ki seni bol bol tesbih edelim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16672,
            "SureId": 20,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 313,
            "AyetText": "Ve seni çok analım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16679,
            "SureId": 20,
            "AyetId": 35,
