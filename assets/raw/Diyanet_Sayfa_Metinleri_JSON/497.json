    "QuranAyats": [
        {
            "Id": 31031,
            "SureId": 44,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "وَاَنْ لَا تَعْلُوا عَلَى اللّٰهِۚ اِنّٖٓی اٰتٖیكُمْ بِسُلْطَانٍ مُبٖینٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 44,
                "MealInfo": "Mekke döneminde inmiştir. 59 âyettir. Sûre, adını onuncu âyette geçen <b>“duhân” </b>kelimesinden almıştır. <b>Duhan, duman demektir</b>. Sûrede başlıca, <b>Kur’an’ın indirilişi, müşriklerin ona karşı tutumu, Firavun ve halkının başlarına gelen azaplar, Kureyş’in Hz. Peygamberi yalanlaması, iyilerin ve kötülerin karşılaşacakları akıbet</b> konu edilmektedir.",
                "SureNameTurkish": "Duhân",
                "SureNameArabic": "الدُّخَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 64,
                "AyetCount": 59,
                "Cuz": 25,
                "FirstPage": 496,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 31038,
            "SureId": 44,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "وَاِنّٖی عُذْتُ بِرَبّٖی وَرَبِّكُمْ اَنْ تَرْجُمُونِؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31045,
            "SureId": 44,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "وَاِنْ لَمْ تُؤْمِنُوا لٖی فَاعْتَزِلُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31052,
            "SureId": 44,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "فَدَعَا رَبَّهُٓ اَنَّ هٰٓؤُ𐻾لَٓاءِ قَوْمٌ مُجْرِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31059,
            "SureId": 44,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "فَاَسْرِ بِعِبَادٖی لَیْلًا اِنَّكُمْ مُتَّبَعُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31066,
            "SureId": 44,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "وَاتْرُكِ الْبَحْرَ رَهْوًاؕ اِنَّهُمْ جُنْدٌ مُغْرَقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31073,
            "SureId": 44,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "كَمْ تَرَكُوا مِنْ جَنَّاتٍ وَعُیُونٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31080,
            "SureId": 44,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "وَزُرُوعٍ وَمَقَامٍ كَرٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31087,
            "SureId": 44,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "وَنَعْمَةٍ كَانُوا فٖیهَا فَاكِهٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31094,
            "SureId": 44,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "كَذٰلِكَࣞ وَاَوْرَثْنَاهَا قَوْمًا اٰخَرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31101,
            "SureId": 44,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "فَمَا بَكَتْ عَلَیْهِمُ السَّمَٓاءُ وَالْاَرْضُ وَمَا كَانُوا مُنْظَرٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31108,
            "SureId": 44,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "وَلَقَدْ نَجَّیْنَا بَنٖٓی اِسْرَٓایٖٔلَ مِنَ الْعَذَابِ الْمُهٖینِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31115,
            "SureId": 44,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "مِنْ فِرْعَوْنَؕ اِنَّهُ كَانَ عَالِیًا مِنَ الْمُسْرِفٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31122,
            "SureId": 44,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "وَلَقَدِ اخْتَرْنَاهُمْ عَلٰى عِلْمٍ عَلَى الْعَالَمٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31129,
            "SureId": 44,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "وَاٰتَیْنَاهُمْ مِنَ الْاٰیَاتِ مَا فٖیهِ بَلٰٓؤٌا مُبٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31136,
            "SureId": 44,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "اِنَّ هٰٓؤُ𐻾لَٓاءِ لَیَقُولُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31143,
            "SureId": 44,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "اِنْ هِیَ اِلَّا مَوْتَتُنَا الْاُو𐻿لٰى وَمَا نَحْنُ بِمُنْشَرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31150,
            "SureId": 44,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "فَاْتُوا بِاٰبَٓائِنَٓا اِنْ كُنْتُمْ صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31157,
            "SureId": 44,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "اَهُمْ خَیْرٌ اَمْ قَوْمُ تُبَّعٍۙ وَالَّذٖینَ مِنْ قَبْلِهِمْؕ اَهْلَكْنَاهُمْؗ اِنَّهُمْ كَانُوا مُجْرِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31164,
            "SureId": 44,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "وَمَا خَلَقْنَا السَّمٰوَاتِ وَالْاَرْضَ وَمَا بَیْنَهُمَا لَاعِبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31171,
            "SureId": 44,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 497,
            "AyetText": "مَا خَلَقْنَاهُمَٓا اِلَّا بِالْحَقِّ وَلٰكِنَّ اَكْثَرَهُمْ لَا یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
