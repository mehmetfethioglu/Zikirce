        },
        {
            "Id": 7532,
            "SureId": 7,
            "AyetId": 122,
            "LanguageId": 7,
            "AyetNumber": "١٢٢",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "رَبِّ مُوسٰى وَهٰرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7539,
            "SureId": 7,
            "AyetId": 123,
            "LanguageId": 7,
            "AyetNumber": "١٢٣",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "قَالَ فِرْعَوْنُ اٰمَنْتُمْ بِهٖ قَبْلَ اَنْ اٰذَنَ لَكُمْۚ اِنَّ هٰذَا لَمَكْرٌ مَكَرْتُمُوهُ فِی الْمَدٖینَةِ لِتُخْرِجُوا مِنْهَٓا اَهْلَهَاۚ فَسَوْفَ تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7546,
            "SureId": 7,
            "AyetId": 124,
            "LanguageId": 7,
            "AyetNumber": "١٢٤",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "لَاُقَطِّعَنَّ اَیْدِیَكُمْ وَاَرْجُلَكُمْ مِنْ خِلَافٍ ثُمَّ لَاُصَلِّبَنَّكُمْ اَجْمَعٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7553,
            "SureId": 7,
            "AyetId": 125,
            "LanguageId": 7,
            "AyetNumber": "١٢٥",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "قَالُٓوا اِنَّٓا اِلٰى رَبِّنَا مُنْقَلِبُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7560,
            "SureId": 7,
            "AyetId": 126,
            "LanguageId": 7,
            "AyetNumber": "١٢٦",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "وَمَا تَنْقِمُ مِنَّٓا اِلَّٓا اَنْ اٰمَنَّا بِاٰیَاتِ رَبِّنَا لَمَّا جَٓاءَتْنَاؕ رَبَّنَٓا اَفْرِغْ عَلَیْنَا صَبْرًا وَتَوَفَّنَا مُسْلِمٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7567,
            "SureId": 7,
            "AyetId": 127,
            "LanguageId": 7,
            "AyetNumber": "١٢٧",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "وَقَالَ الْمَلَاُ مِنْ قَوْمِ فِرْعَوْنَ اَتَذَرُ مُوسٰى وَقَوْمَهُ لِیُفْسِدُوا فِی الْاَرْضِ وَیَذَرَكَ وَاٰلِهَتَكَؕ قَالَ سَنُقَتِّلُ اَبْنَٓاءَهُمْ وَنَسْتَحْيٖ نِسَٓاءَهُمْۚ وَاِنَّا فَوْقَهُمْ قَاهِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7574,
            "SureId": 7,
            "AyetId": 128,
            "LanguageId": 7,
            "AyetNumber": "١٢٨",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "قَالَ مُوسٰى لِقَوْمِهِ اسْتَعٖینُوا بِاللّٰهِ وَاصْبِرُواۚ اِنَّ الْاَرْضَ لِلّٰهِۚ یُورِثُهَا مَنْ یَشَٓاءُ مِنْ عِبَادِهٖؕ وَالْعَاقِبَةُ لِلْمُتَّقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7581,
            "SureId": 7,
            "AyetId": 129,
            "LanguageId": 7,
            "AyetNumber": "١٢٩",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "قَالُٓوا اُو𐻿ذٖینَا مِنْ قَبْلِ اَنْ تَاْتِیَنَا وَمِنْ بَعْدِ مَا جِئْتَنَاؕ قَالَ عَسٰى رَبُّكُمْ اَنْ یُهْلِكَ عَدُوَّكُمْ وَیَسْتَخْلِفَكُمْ فِی الْاَرْضِ فَیَنْظُرَ كَیْفَ تَعْمَلُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7588,
            "SureId": 7,
            "AyetId": 130,
            "LanguageId": 7,
            "AyetNumber": "١٣٠",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "وَلَقَدْ اَخَذْنَٓا اٰلَ فِرْعَوْنَ بِالسِّنٖینَ وَنَقْصٍ مِنَ الثَّمَرَاتِ لَعَلَّهُمْ یَذَّكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 7523,
            "SureId": 7,
            "AyetId": 121,
            "LanguageId": 5,
            "AyetNumber": "121-122",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "“Âlemlerin rabbine, Mûsâ ve Hârûn’un rabbine iman ettik” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 7,
                "MealInfo": "Mekke döneminde inmiştir. 163-170. âyetlerin Medine döneminde indiğini söyleyen âlimler de vardır. 206 âyettir. Sûre, adını 46. ve 48. âyetlerde geçen<b>“el-A’râf ” </b>kelimesinden almıştır. <b>“el-A’râf ”, <i>yüksek yerler, yüksek mevkiler</i> demektir</b>. Sûrede temel konu olarak, ilâhî vahyin doğruluğu ve vahye duyulan ihtiyaç işlenmektedir.",
                "SureNameTurkish": "A'râf",
                "SureNameArabic": "الْاَعْرَافِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 39,
                "AyetCount": 206,
                "Cuz": 8,
                "FirstPage": 151,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 7530,
            "SureId": 7,
            "AyetId": 122,
            "LanguageId": 5,
            "AyetNumber": "122",
            "AyetVisible": false,
            "Page": 165,
            "AyetText": "\"Âlemlerin rabbine, Mûsâ ve Hârûn’un rabbine iman ettik\" dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7537,
            "SureId": 7,
            "AyetId": 123,
            "LanguageId": 5,
            "AyetNumber": "123",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "Firavun dedi ki: “Ben size izin vermeden ona iman ettiniz öyle mi? Şüphe yok ki bu, halkını şehirden çıkarmak için orada kurduğunuz bir tuzaktır. Ama yakında göreceksiniz!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7544,
            "SureId": 7,
            "AyetId": 124,
            "LanguageId": 5,
            "AyetNumber": "124",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "“Mutlaka ellerinizi ve ayaklarınızı çaprazlama keseceğim, sonra da hepinizi asacağım!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7551,
            "SureId": 7,
            "AyetId": 125,
            "LanguageId": 5,
            "AyetNumber": "125",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "Onlar, “Biz de rabbimize dönmüş oluruz” dediler;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7558,
            "SureId": 7,
            "AyetId": 126,
            "LanguageId": 5,
            "AyetNumber": "126",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "“Sen, rabbimizin âyetleri bize geldiğinde onlara inandık diye, sırf bu yüzden bizden intikam alıyorsun. Ey rabbimiz! Bize sabırlar ver ve müslüman olarak canımızı al!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7565,
            "SureId": 7,
            "AyetId": 127,
            "LanguageId": 5,
            "AyetNumber": "127",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "Firavun’un kavminden ileri gelenler dediler ki: “Seni ve tanrılarını bırakıp yeryüzünde bozgunculuk çıkarsınlar diye mi Mûsâ’yı ve kavmini serbest bırakacaksın?” Firavun, “Biz onların oğullarını sürekli öldürüp kızlarını sağ bırakacağız. Elbette biz onları ezecek üstünlükteyiz” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7572,
            "SureId": 7,
            "AyetId": 128,
            "LanguageId": 5,
            "AyetNumber": "128",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "Mûsâ kavmine dedi ki: “Allah’tan yardım isteyin ve sabredin. Şüphesiz ki yeryüzü Allah’ındır. O, kullarından dilediğini oraya hâkim kılar; (güzel) sonuç, takvâ sahiplerinindir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7579,
            "SureId": 7,
            "AyetId": 129,
            "LanguageId": 5,
            "AyetNumber": "129",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "Onlar da, “Sen bize gelmeden önce de geldikten sonra da bize işkence edildi” dediler. Mûsâ, “Umulur ki rabbiniz düşmanınızı helâk eder ve nasıl hareket edeceğinizi görmesi için onların yerine sizi yeryüzüne hâkim kılar” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7586,
            "SureId": 7,
            "AyetId": 130,
            "LanguageId": 5,
            "AyetNumber": "130",
            "AyetVisible": true,
            "Page": 165,
            "AyetText": "Andolsun ki biz de Firavun’a uyanları, ders alsınlar diye kuraklık yılları ve ürün kıtlığı ile cezalandırdık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
