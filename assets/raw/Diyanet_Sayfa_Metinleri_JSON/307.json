    "QuranAyats": [
        {
            "Id": 15932,
            "SureId": 19,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "فَكُلٖی وَاشْرَبٖی وَقَرّٖی عَیْنًاۚ فَاِمَّا تَرَیِنَّ مِنَ الْبَشَرِ اَحَدًاۙ فَقُولٖٓی اِنّٖی نَذَرْتُ لِلرَّحْمٰنِ صَوْمًا فَلَنْ اُكَلِّمَ الْیَوْمَ اِنْسِیًّاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 15939,
            "SureId": 19,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "فَاَتَتْ بِهٖ قَوْمَهَا تَحْمِلُهُؕ قَالُوا یَا مَرْیَمُ لَقَدْ جِئْتِ شَیْـًٔا فَرِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15946,
            "SureId": 19,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "یَٓا اُخْتَ هٰرُونَ مَا كَانَ اَبُوكِ امْرَاَ سَوْءٍ وَمَا كَانَتْ اُمُّكِ بَغِیًّاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15953,
            "SureId": 19,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "فَاَشَارَتْ اِلَیْهِࣞ قَالُوا كَیْفَ نُكَلِّمُ مَنْ كَانَ فِی الْمَهْدِ صَبِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15960,
            "SureId": 19,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "قَالَ اِنّٖی عَبْدُ اللّٰهِࣞ اٰتَانِیَ الْكِتَابَ وَجَعَلَنٖی نَبِیًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15967,
            "SureId": 19,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "وَجَعَلَنٖی مُبَارَكًا اَیْنَ مَا كُنْتُࣕ وَاَوْصَانٖی بِالصَّلٰوةِ وَالزَّكٰوةِ مَا دُمْتُ حَیًّاࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15974,
            "SureId": 19,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "وَبَرًّا بِوَالِدَتٖیؗ وَلَمْ یَجْعَلْنٖی جَبَّارًا شَقِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15981,
            "SureId": 19,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "وَالسَّلَامُ عَلَیَّ یَوْمَ وُلِدْتُ وَیَوْمَ اَمُوتُ وَیَوْمَ اُبْعَثُ حَیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15988,
            "SureId": 19,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "ذٰلِكَ عٖیسَى ابْنُ مَرْیَمَۚ قَوْلَ الْحَقِّ الَّذٖی فٖیهِ یَمْتَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15995,
            "SureId": 19,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "مَا كَانَ لِلّٰهِ اَنْ یَتَّخِذَ مِنْ وَلَدٍۙ سُبْحَانَهُؕ اِذَا قَضٰٓى اَمْرًا فَاِنَّمَا یَقُولُ لَهُ كُنْ فَیَكُونُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16002,
            "SureId": 19,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "وَاِنَّ اللّٰهَ رَبّٖی وَرَبُّكُمْ فَاعْبُدُوهُؕ هٰذَا صِرَاطٌ مُسْتَقٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16009,
            "SureId": 19,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "فَاخْتَلَفَ الْاَحْزَابُ مِنْ بَیْنِهِمْۚ فَوَیْلٌ لِلَّذٖینَ كَفَرُوا مِنْ مَشْهَدِ یَوْمٍ عَظٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16016,
            "SureId": 19,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "اَسْمِعْ بِهِمْ وَاَبْصِرْۙ یَوْمَ یَاْتُونَنَاۚ لٰكِنِ الظَّالِمُونَ الْیَوْمَ فٖی ضَلَالٍ مُبٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 15930,
            "SureId": 19,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "Ye iç, gözün aydın olsun! İnsanlardan birini görürsen de ki: Ben, çok esirgeyici olan Allah’a adakta bulundum; artık bugün hiçbir insanla konuşmayacağım.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 15937,
            "SureId": 19,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "Sonra çocuğu kucağına alarak topluluğuna getirdi. Dediler ki: “Ey Meryem! Gerçekten sen çirkin bir şey yaptın!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15944,
            "SureId": 19,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "Ey Hârûn’un kız kardeşi! Baban kötü bir adam, annen de iffetsiz değildi.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15951,
            "SureId": 19,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "Bunun üzerine Meryem çocuğu işaret etti. “Beşikteki bir çocukla nasıl konuşuruz?” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15958,
            "SureId": 19,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "Cevabı çocuk verdi: “Ben Allah’ın kuluyum; O bana kitap verdi ve beni peygamber yaptı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15965,
            "SureId": 19,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31-32",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "Nerede olursam olayım, o beni kutlu ve bereketli kıldı; yaşadığım sürece bana namazı, zekâtı ve anneme saygılı olmayı emretti; beni zorba ve isyankâr yapmadı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15972,
            "SureId": 19,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": false,
            "Page": 307,
            "AyetText": "Nerede olursam olayım, o beni kutlu ve bereketli kıldı; yaşadığım sürece bana namazı, zekâtı ve anneme saygılı olmayı emretti; beni zorba ve isyankâr yapmadı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15979,
            "SureId": 19,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "Doğduğum gün, öleceğim gün ve yeniden hayata döndürüleceğim gün esenlik benimle olacaktır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15986,
            "SureId": 19,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "İşte Meryem oğlu Îsâ bu; şüpheye düşüp tartıştıkları konuda gerçek söz de bu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15993,
            "SureId": 19,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "Allah’ın bir evlât edinmesi olacak şey değildir. O, bundan münezzehtir. Bir işe karar verdiği zaman ona sadece “ol!” der, hemen olur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16000,
            "SureId": 19,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "Îsâ şunu da söyledi: “Muhakkak ki Allah, benim de rabbim, sizin de rabbinizdir. O halde O’na kulluk edin, doğru yol budur.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16007,
            "SureId": 19,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "Sonra gruplar kendi aralarında ayrılığa düştüler. Büyük güne ulaşıldığında, vay o inkârcıların haline!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16014,
            "SureId": 19,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 307,
            "AyetText": "Onlar, bizim huzurumuza çıkacakları gün öyle bir işitirler ve öyle bir görürler ki! Ne var ki o zalimler bugün tam bir sapkınlık için­dedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
