            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "فَلَمَّا رَاَوْهُ زُلْفَةً سٖٓیـَٔتْ وُجُوهُ الَّذٖینَ كَفَرُوا وَقٖیلَ هٰذَا الَّذٖی كُنْتُمْ بِهٖ تَدَّعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 67,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. Sûre, adını birinci âyette geçen “elMülk”kelimesinden almıştır. Sûrede başlıca, Allah’ın azameti, Allah’ın birliğinindelilleri ve öldükten sonra dirilmeyi inkâr edenlerin akıbetleri konuedilmektedir",
                "SureNameTurkish": "Mülk",
                "SureNameArabic": "الْمُلْكِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 77,
                "AyetCount": 30,
                "Cuz": 29,
                "FirstPage": 562,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 36883,
            "SureId": 67,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "قُلْ اَرَاَیْتُمْ اِنْ اَهْلَكَنِیَ اللّٰهُ وَمَنْ مَعِیَ اَوْ رَحِمَنَاۙ فَمَنْ یُجٖیرُ الْكَافِرٖینَ مِنْ عَذَابٍ اَلٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36890,
            "SureId": 67,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "قُلْ هُوَ الرَّحْمٰنُ اٰمَنَّا بِهٖ وَعَلَیْهِ تَوَكَّلْنَاۚ فَسَتَعْلَمُونَ مَنْ هُوَ فٖی ضَلَالٍ مُبٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36897,
            "SureId": 67,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "قُلْ اَرَاَیْتُمْ اِنْ اَصْبَحَ مَٓاؤُ𐻾كُمْ غَوْرًا فَمَنْ یَاْتٖیكُمْ بِمَٓاءٍ مَعٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36904,
            "SureId": 68,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "نٓ وَالْقَلَمِ وَمَا یَسْطُرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 68,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. Sûre, adını birinci âyette geçen “elKalem”kelimesinden almıştır. “Nûn” sûresi diye de anılır. Sûrede başlıca, Hz.Muhammed’in peygamberliğinin ispatı ve mü’minler ile kâfirlerin akıbetlerikonu edilmiştir.",
                "SureNameTurkish": "Kalem",
                "SureNameArabic": "الْقَلَمِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 2,
                "AyetCount": 52,
                "Cuz": 29,
                "FirstPage": 564,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 36911,
            "SureId": 68,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "مَٓا اَنْتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36918,
            "SureId": 68,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "وَاِنَّ لَكَ لَاَجْرًا غَیْرَ مَمْنُونٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36925,
            "SureId": 68,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "وَاِنَّكَ لَعَلٰى خُلُقٍ عَظٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36932,
            "SureId": 68,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "فَسَتُبْصِرُ وَیُبْصِرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36939,
            "SureId": 68,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "بِاَیِّكُمُ الْمَفْتُونُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36946,
            "SureId": 68,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "اِنَّ رَبَّكَ هُوَ اَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبٖیلِهٖࣕ وَهُوَ اَعْلَمُ بِالْمُهْتَدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36953,
            "SureId": 68,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "فَلَا تُطِعِ الْمُكَذِّبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36960,
            "SureId": 68,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "وَدُّوا لَوْ تُدْهِنُ فَیُدْهِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36967,
            "SureId": 68,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "وَلَا تُطِعْ كُلَّ حَلَّافٍ مَهٖینٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36974,
            "SureId": 68,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "هَمَّازٍ مَشَّٓاءٍ بِنَمٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36981,
            "SureId": 68,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "مَنَّاعٍ لِلْخَیْرِ مُعْتَدٍ اَثٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36988,
            "SureId": 68,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "عُتُلٍّ بَعْدَ ذٰلِكَ زَنٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36995,
            "SureId": 68,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "اَنْ كَانَ ذَا مَالٍ وَبَنٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37002,
            "SureId": 68,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "اِذَا تُتْلٰى عَلَیْهِ اٰیَاتُنَا قَالَ اَسَاطٖیرُ الْاَوَّلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 36874,
            "SureId": 67,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "Ama onu yakından gördükleri zaman, inkâr edenlerin yüzleri kara çıkacak ve (kendilerine), “İşte sizin isteyip durduğunuz budur!” denilecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 67,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. Sûre, adını birinci âyette geçen “elMülk”kelimesinden almıştır. Sûrede başlıca, Allah’ın azameti, Allah’ın birliğinindelilleri ve öldükten sonra dirilmeyi inkâr edenlerin akıbetleri konuedilmektedir",
                "SureNameTurkish": "Mülk",
                "SureNameArabic": "الْمُلْكِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 77,
                "AyetCount": 30,
                "Cuz": 29,
                "FirstPage": 562,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 36881,
            "SureId": 67,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "De ki: “Beni ve beraberimdekileri Allah yok eder veya bizi esirgerse (söyler misiniz), inkârcıları yakıcı azaptan kurtaracak olan kimdir?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36888,
            "SureId": 67,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "De ki: “O, Rahmân’dır; biz O’na iman etmiş ve O’na güvenip dayanmışızdır. Kimin düpedüz bir sapkınlık içinde olduğunu yakında anlayacaksınız!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36895,
            "SureId": 67,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "Bir de şunu sor: “Suyunuz çekiliverse size yerden kaynayan suyu kim getirebilir?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36902,
            "SureId": 68,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1-2",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "Nûn. Kaleme ve (yazanların) onunla yazdıklarına andolsun ki sen -rabbinin lutfu sayesinde- asla deli değilsin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 68,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. Sûre, adını birinci âyette geçen “elKalem”kelimesinden almıştır. “Nûn” sûresi diye de anılır. Sûrede başlıca, Hz.Muhammed’in peygamberliğinin ispatı ve mü’minler ile kâfirlerin akıbetlerikonu edilmiştir.",
                "SureNameTurkish": "Kalem",
                "SureNameArabic": "الْقَلَمِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 2,
                "AyetCount": 52,
                "Cuz": 29,
                "FirstPage": 564,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 36909,
            "SureId": 68,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": false,
            "Page": 564,
            "AyetText": "Nûn. Kaleme ve (yazanların) onunla yazdıklarına andolsun ki sen -rabbinin lutfu sayesinde- asla deli değilsin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36916,
            "SureId": 68,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "Hiç şüphesiz senin için bitip tükenmeyen bir ödül vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36923,
            "SureId": 68,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "Sen elbette üstün bir ahlâka sahipsin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36930,
            "SureId": 68,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5-6",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "Aranızdan hanginizin aklı bozuk olduğunu yakında sen de göreceksin, onlar da görecekler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36937,
            "SureId": 68,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": false,
            "Page": 564,
            "AyetText": "Aranızdan hanginizin aklı bozuk olduğunu yakında sen de göreceksin, onlar da görecekler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36944,
            "SureId": 68,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "Doğrusu, yolundan sapan kimseyi en iyi bilen rabbindir; hidayete erenleri de en iyi bilen O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36951,
            "SureId": 68,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "Şu halde seni yalancılıkla itham edenlere boyun eğme!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36958,
            "SureId": 68,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "İstedikleri şudur: Sen tâviz veresin ki, onlar da tâviz versinler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36965,
            "SureId": 68,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10-14",
            "AyetVisible": true,
            "Page": 564,
            "AyetText": "Olur olmaz yemin eden, aşağılık, daima kusur arayıp iğneleyen, durmadan laf götürüp getiren, iyiliği hep engelleyen, saldırgan, günahkâr, huysuz ve kaba, üstelik karakteri bozuk kimselere, serveti ve çocukları var diye sakın boyun eğme.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
