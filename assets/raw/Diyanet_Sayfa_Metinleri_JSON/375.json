    "QuranAyats": [
        {
            "Id": 21812,
            "SureId": 26,
            "AyetId": 184,
            "LanguageId": 7,
            "AyetNumber": "١٨٤",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "وَاتَّقُوا الَّذٖی خَلَقَكُمْ وَالْجِبِلَّةَ الْاَوَّلٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 21819,
            "SureId": 26,
            "AyetId": 185,
            "LanguageId": 7,
            "AyetNumber": "١٨٥",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "قَالُٓوا اِنَّمَٓا اَنْتَ مِنَ الْمُسَحَّرٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21826,
            "SureId": 26,
            "AyetId": 186,
            "LanguageId": 7,
            "AyetNumber": "١٨٦",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "وَمَٓا اَنْتَ اِلَّا بَشَرٌ مِثْلُنَا وَاِنْ نَظُنُّكَ لَمِنَ الْكَاذِبٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21833,
            "SureId": 26,
            "AyetId": 187,
            "LanguageId": 7,
            "AyetNumber": "١٨٧",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "فَاَسْقِطْ عَلَیْنَا كِسَفًا مِنَ السَّمَٓاءِ اِنْ كُنْتَ مِنَ الصَّادِقٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21840,
            "SureId": 26,
            "AyetId": 188,
            "LanguageId": 7,
            "AyetNumber": "١٨٨",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "قَالَ رَبّٖٓی اَعْلَمُ بِمَا تَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21847,
            "SureId": 26,
            "AyetId": 189,
            "LanguageId": 7,
            "AyetNumber": "١٨٩",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "فَكَذَّبُوهُ فَاَخَذَهُمْ عَذَابُ یَوْمِ الظُّلَّةِؕ اِنَّهُ كَانَ عَذَابَ یَوْمٍ عَظٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21854,
            "SureId": 26,
            "AyetId": 190,
            "LanguageId": 7,
            "AyetNumber": "١٩٠",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "اِنَّ فٖی ذٰلِكَ لَاٰیَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21861,
            "SureId": 26,
            "AyetId": 191,
            "LanguageId": 7,
            "AyetNumber": "١٩١",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "وَاِنَّ رَبَّكَ لَهُوَ الْعَزٖیزُ الرَّحٖیمُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21868,
            "SureId": 26,
            "AyetId": 192,
            "LanguageId": 7,
            "AyetNumber": "١٩٢",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "وَاِنَّهُ لَتَنْزٖیلُ رَبِّ الْعَالَمٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21875,
            "SureId": 26,
            "AyetId": 193,
            "LanguageId": 7,
            "AyetNumber": "١٩٣",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "نَزَلَ بِهِ الرُّوحُ الْاَمٖینُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21882,
            "SureId": 26,
            "AyetId": 194,
            "LanguageId": 7,
            "AyetNumber": "١٩٤",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "عَلٰى قَلْبِكَ لِتَكُونَ مِنَ الْمُنْذِرٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21889,
            "SureId": 26,
            "AyetId": 195,
            "LanguageId": 7,
            "AyetNumber": "١٩٥",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "بِلِسَانٍ عَرَبِیٍّ مُبٖینٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21896,
            "SureId": 26,
            "AyetId": 196,
            "LanguageId": 7,
            "AyetNumber": "١٩٦",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "وَاِنَّهُ لَفٖی زُبُرِ الْاَوَّلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21903,
            "SureId": 26,
            "AyetId": 197,
            "LanguageId": 7,
            "AyetNumber": "١٩٧",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "اَوَلَمْ یَكُنْ لَهُمْ اٰیَةً اَنْ یَعْلَمَهُ عُلَمٰٓؤُ𐻾ا بَنٖٓی اِسْرَٓایٖٔلَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21910,
            "SureId": 26,
            "AyetId": 198,
            "LanguageId": 7,
            "AyetNumber": "١٩٨",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "وَلَوْ نَزَّلْنَاهُ عَلٰى بَعْضِ الْاَعْجَمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21917,
            "SureId": 26,
            "AyetId": 199,
            "LanguageId": 7,
            "AyetNumber": "١٩٩",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "فَقَرَاَهُ عَلَیْهِمْ مَا كَانُوا بِهٖ مُؤْمِنٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21924,
            "SureId": 26,
            "AyetId": 200,
            "LanguageId": 7,
            "AyetNumber": "٢٠٠",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "كَذٰلِكَ سَلَكْنَاهُ فٖی قُلُوبِ الْمُجْرِمٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21931,
            "SureId": 26,
            "AyetId": 201,
            "LanguageId": 7,
            "AyetNumber": "٢٠١",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "لَا یُؤْمِنُونَ بِهٖ حَتّٰى یَرَوُا الْعَذَابَ الْاَلٖیمَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21938,
            "SureId": 26,
            "AyetId": 202,
            "LanguageId": 7,
            "AyetNumber": "٢٠٢",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "فَیَاْتِیَهُمْ بَغْتَةً وَهُمْ لَا یَشْعُرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21945,
            "SureId": 26,
            "AyetId": 203,
            "LanguageId": 7,
            "AyetNumber": "٢٠٣",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "فَیَقُولُوا هَلْ نَحْنُ مُنْظَرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21952,
            "SureId": 26,
            "AyetId": 204,
            "LanguageId": 7,
            "AyetNumber": "٢٠٤",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "اَفَبِعَذَابِنَا یَسْتَعْجِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21959,
            "SureId": 26,
            "AyetId": 205,
            "LanguageId": 7,
            "AyetNumber": "٢٠٥",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "اَفَرَاَیْتَ اِنْ مَتَّعْنَاهُمْ سِنٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21966,
            "SureId": 26,
            "AyetId": 206,
            "LanguageId": 7,
            "AyetNumber": "٢٠٦",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "ثُمَّ جَٓاءَهُمْ مَا كَانُوا یُوعَدُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 21810,
            "SureId": 26,
            "AyetId": 184,
            "LanguageId": 5,
            "AyetNumber": "184",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Sizi ve önceki nesilleri yaratana saygılı olun.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 21817,
            "SureId": 26,
            "AyetId": 185,
            "LanguageId": 5,
            "AyetNumber": "185",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Şöyle cevap verdiler: “Sen, gerçekten büyü yapılmış birisin!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21824,
            "SureId": 26,
            "AyetId": 186,
            "LanguageId": 5,
            "AyetNumber": "186",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Sen de sadece bizim gibi bir beşersin. Biz senin kuşkusuz yalancılardan biri olduğuna inanıyoruz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21831,
            "SureId": 26,
            "AyetId": 187,
            "LanguageId": 5,
            "AyetNumber": "187",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Eğer doğru sözlü isen, haydi üstümüze gökten azap yağdır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21838,
            "SureId": 26,
            "AyetId": 188,
            "LanguageId": 5,
            "AyetNumber": "188",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Şuayb, “Yaptıklarınızı en iyi bilen rabbimdir” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21845,
            "SureId": 26,
            "AyetId": 189,
            "LanguageId": 5,
            "AyetNumber": "189",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Onu yalancılıkla suçladılar, derken gölge gününün azabı üzerlerine çöküverdi. O gerçekten büyük bir günün azabıydı!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21852,
            "SureId": 26,
            "AyetId": 190,
            "LanguageId": 5,
            "AyetNumber": "190",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Doğrusu almak isteyenler için bunda büyük bir ders vardır; ama çokları iman etmezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21859,
            "SureId": 26,
            "AyetId": 191,
            "LanguageId": 5,
            "AyetNumber": "191",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Şüphesiz rabbin, işte O, mutlak güç ve engin merhamet sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21866,
            "SureId": 26,
            "AyetId": 192,
            "LanguageId": 5,
            "AyetNumber": "192",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Şüphesiz bu Kur’an âlemlerin rabbi tarafından indirilmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21873,
            "SureId": 26,
            "AyetId": 193,
            "LanguageId": 5,
            "AyetNumber": "193-195",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Onu, senin kalbine uyarıcılardan olasın diye açık bir Arapça ile Rûhulemîn indirmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21880,
            "SureId": 26,
            "AyetId": 194,
            "LanguageId": 5,
            "AyetNumber": "194",
            "AyetVisible": false,
            "Page": 375,
            "AyetText": "Onu, senin kalbine uyarıcılardan olasın diye açık bir Arapça ile Rûhulemîn indirmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21887,
            "SureId": 26,
            "AyetId": 195,
            "LanguageId": 5,
            "AyetNumber": "195",
            "AyetVisible": false,
            "Page": 375,
            "AyetText": "Onu, senin kalbine uyarıcılardan olasın diye açık bir Arapça ile Rûhulemîn indirmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21894,
            "SureId": 26,
            "AyetId": 196,
            "LanguageId": 5,
            "AyetNumber": "196",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "O Kur’an, şüphesiz öncekilerin kitaplarında da vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21901,
            "SureId": 26,
            "AyetId": 197,
            "LanguageId": 5,
            "AyetNumber": "197",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "İsrâiloğulları bilginlerinin bunu bilmesi onlar için bir delil değil midir?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21908,
            "SureId": 26,
            "AyetId": 198,
            "LanguageId": 5,
            "AyetNumber": "198-199",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Kur’an’ı Arap olmayanlardan birine indirseydik de onu onlara okusaydı, yine iman etmezlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21915,
            "SureId": 26,
            "AyetId": 199,
            "LanguageId": 5,
            "AyetNumber": "199",
            "AyetVisible": false,
            "Page": 375,
            "AyetText": "Kur’an’ı Arap olmayanlardan birine indirseydik de onu onlara okusaydı, yine iman etmezlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21922,
            "SureId": 26,
            "AyetId": 200,
            "LanguageId": 5,
            "AyetNumber": "200",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Onu (inkârı) günahkârların zihinlerine böyle soktuk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21929,
            "SureId": 26,
            "AyetId": 201,
            "LanguageId": 5,
            "AyetNumber": "201",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Onlar, sonunda can yakıcı azabı görünceye kadar ona iman etmezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21936,
            "SureId": 26,
            "AyetId": 202,
            "LanguageId": 5,
            "AyetNumber": "202",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "O azap farkında olmadan kendilerine ansızın geliverir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21943,
            "SureId": 26,
            "AyetId": 203,
            "LanguageId": 5,
            "AyetNumber": "203",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "Sonra, “Bize yeni bir süre verilir mi acaba?” diyecekler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21950,
            "SureId": 26,
            "AyetId": 204,
            "LanguageId": 5,
            "AyetNumber": "204",
            "AyetVisible": true,
            "Page": 375,
            "AyetText": "O halde (şimdi gelsin diyerek) azabımızın çabuklaşmasını mı istiyorlar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
