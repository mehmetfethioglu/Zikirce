{
    "PointerList": null,
    "CuzNo": 15,
    "PageNo": 285,
    "ArCuzNo": "۱٥",
    "ArPageNo": "۲۸٥",
    "QuranAyats": [
        {
            "Id": 14399,
            "SureId": 17,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "وَاِمَّا تُعْرِضَنَّ عَنْهُمُ ابْتِغَٓاءَ رَحْمَةٍ مِنْ رَبِّكَ تَرْجُوهَا فَقُلْ لَهُمْ قَوْلًا مَیْسُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14406,
            "SureId": 17,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "وَلَا تَجْعَلْ یَدَكَ مَغْلُولَةً اِلٰى عُنُقِكَ وَلَا تَبْسُطْهَا كُلَّ الْبَسْطِ فَتَقْعُدَ مَلُومًا مَحْسُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14413,
            "SureId": 17,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "اِنَّ رَبَّكَ یَبْسُطُ الرِّزْقَ لِمَنْ یَشَٓاءُ وَیَقْدِرُؕ اِنَّهُ كَانَ بِعِبَادِهٖ خَبٖیرًا بَصٖیرًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14420,
            "SureId": 17,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "وَلَا تَقْتُلُٓوا اَوْلَادَكُمْ خَشْیَةَ اِمْلَاقٍؕ نَحْنُ نَرْزُقُهُمْ وَاِیَّاكُمْؕ اِنَّ قَتْلَهُمْ كَانَ خِطْــًٔا كَبٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14427,
            "SureId": 17,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "وَلَا تَقْرَبُوا الزِّنٰٓى اِنَّهُ كَانَ فَاحِشَةًؕ وَسَٓاءَ سَبٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14434,
            "SureId": 17,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "وَلَا تَقْتُلُوا النَّفْسَ الَّتٖی حَرَّمَ اللّٰهُ اِلَّا بِالْحَقِّؕ وَمَنْ قُتِلَ مَظْلُومًا فَقَدْ جَعَلْنَا لِوَلِیِّهٖ سُلْطَانًا فَلَا یُسْرِفْ فِی الْقَتْلِؕ اِنَّهُ كَانَ مَنْصُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14441,
            "SureId": 17,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "وَلَا تَقْرَبُوا مَالَ الْیَتٖیمِ اِلَّا بِالَّتٖی هِیَ اَحْسَنُ حَتّٰى یَبْلُغَ اَشُدَّهُࣕ وَاَوْفُوا بِالْعَهْدِۚ اِنَّ الْعَهْدَ كَانَ مَسْؤُ𐻿لًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14448,
            "SureId": 17,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "وَاَوْفُوا الْكَیْلَ اِذَا كِلْتُمْ وَزِنُوا بِالْقِسْطَاسِ الْمُسْتَقٖیمِؕ ذٰلِكَ خَیْرٌ وَاَحْسَنُ تَاْوٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14455,
            "SureId": 17,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "وَلَا تَقْفُ مَا لَیْسَ لَكَ بِهٖ عِلْمٌؕ اِنَّ السَّمْعَ وَالْبَصَرَ وَالْفُؤَادَ كُلُّ اُو𐻾لٰٓئِكَ كَانَ عَنْهُ مَسْؤُ𐻿لًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14462,
            "SureId": 17,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "وَلَا تَمْشِ فِی الْاَرْضِ مَرَحًاۚ اِنَّكَ لَنْ تَخْرِقَ الْاَرْضَ وَلَنْ تَبْلُغَ الْجِبَالَ طُولًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14469,
            "SureId": 17,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "كُلُّ ذٰلِكَ كَانَ سَیِّئُهُ عِنْدَ رَبِّكَ مَكْرُوهًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 14397,
            "SureId": 17,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "Eğer sen kendin dahi rabbinden umduğun bir lutfu beklemek durumunda (ihtiyaç içinde) olduğun için onlara ilgi gösteremiyorsan, hiç değilse kendilerine rahatlatıcı bir söz söyle!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14404,
            "SureId": 17,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "Eli sıkı olma, ölçüsüzce eli açık da olma; sonra kınanacak, kendi kendine hayıflanacak duruma düşersin!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14411,
            "SureId": 17,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "Rabbin rızkı dilediğine bol bol verir de kısar da. Şüphesiz ki O, kullarından haberdardır, onları görmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14418,
            "SureId": 17,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "Fakirlik korkusuyla çocuklarınızın canına kıymayın! Biz onların da sizin de rızkınızı veririz. Onları öldürmek gerçekten büyük bir günahtır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14425,
            "SureId": 17,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "Zinaya yaklaşmayın! Çünkü o hayâsızlıktır, çok kötü bir yoldur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14432,
            "SureId": 17,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "Haklı bir sebep olmadıkça Allah’ın dokunulmaz kıldığı cana kıymayın. Bir kimse haksızlıkla öldürülürse velisine yetki verdik; ancak o da öldürme hususunda sınırı aşmasın; çünkü o, yeterince yardıma mazhar olmuştur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14439,
            "SureId": 17,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "Rüşdüne erinceye kadar yetimin malına, onun yararına olmadıkça el sürmeyin. Ahde vefa gösterin; çünkü ahid sorumluluk doğurur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14446,
            "SureId": 17,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "Ölçtüğünüz zaman tastamam ölçün ve doğru terazi ile tartın. Bu hem daha iyidir hem de sonucu daha güzeldir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14453,
            "SureId": 17,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "Hakkında bilgin olmayan şeyin ardına düşme! Çünkü kulak, göz ve gönül, bunların hepsi ondan sorumludur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14460,
            "SureId": 17,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "Yeryüzünde böbürlenerek dolaşma! Ne yeri yarabilir ne de dağlarla boy ölçüşebilirsin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14467,
            "SureId": 17,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 285,
            "AyetText": "Bütün bunların kötülüğü, rabbinin katında istenmeyen şeyler olmasıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
