            "AyetText": "الٓمٓࣞ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 31,
                "MealInfo": "Mekke döneminde inmiştir. 34 âyettir. Sûre, adını 12. ve 13. âyetlerde anılan <b>Hz. Lokmân</b>’dan almıştır. Sûrede başlıca, <b>Hz. Lokmân’ın oğluna öğütleri çerçevesinde, tevhid, peygamberlik, öldükten sonra dirilme ve haşr konularına dikkat çekilmekte, kıyamet günü için hazırlıklı olunması </b>öğütlenmektedir.",
                "SureNameTurkish": "Lokmân",
                "SureNameArabic": "لُقْمٰانَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 57,
                "AyetCount": 34,
                "Cuz": 21,
                "FirstPage": 411,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 24297,
            "SureId": 31,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "تِلْكَ اٰیَاتُ الْكِتَابِ الْحَكٖیمِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24304,
            "SureId": 31,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "هُدًى وَرَحْمَةً لِلْمُحْسِنٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24311,
            "SureId": 31,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "اَلَّذٖینَ یُقٖیمُونَ الصَّلٰوةَ وَیُؤْتُونَ الزَّكٰوةَ وَهُمْ بِالْاٰخِرَةِ هُمْ یُوقِنُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24318,
            "SureId": 31,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "اُو𐻾لٰٓئِكَ عَلٰى هُدًى مِنْ رَبِّهِمْ وَاُو𐻾لٰٓئِكَ هُمُ الْمُفْلِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24325,
            "SureId": 31,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "وَمِنَ النَّاسِ مَنْ یَشْتَرٖی لَهْوَ الْحَدٖیثِ لِیُضِلَّ عَنْ سَبٖیلِ اللّٰهِ بِغَیْرِ عِلْمٍۙ وَیَتَّخِذَهَا هُزُوًاؕ اُو𐻾لٰٓئِكَ لَهُمْ عَذَابٌ مُهٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24332,
            "SureId": 31,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "وَاِذَا تُتْلٰى عَلَیْهِ اٰیَاتُنَا وَلّٰى مُسْتَكْبِرًا كَاَنْ لَمْ یَسْمَعْهَا كَاَنَّ فٖٓی اُذُنَیْهِ وَقْرًاۚ فَبَشِّرْهُ بِعَذَابٍ اَلٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24339,
            "SureId": 31,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "اِنَّ الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ جَنَّاتُ النَّعٖیمِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24346,
            "SureId": 31,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "خَالِدٖینَ فٖیهَاؕ وَعْدَ اللّٰهِ حَقًّاؕ وَهُوَ الْعَزٖیزُ الْحَكٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24353,
            "SureId": 31,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "خَلَقَ السَّمٰوَاتِ بِغَیْرِ عَمَدٍ تَرَوْنَهَا وَاَلْقٰى فِی الْاَرْضِ رَوَاسِیَ اَنْ تَمٖیدَ بِكُمْ وَبَثَّ فٖیهَا مِنْ كُلِّ دَٓابَّةٍؕ وَاَنْزَلْنَا مِنَ السَّمَٓاءِ مَٓاءً فَاَنْبَتْنَا فٖیهَا مِنْ كُلِّ زَوْجٍ كَرٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24360,
            "SureId": 31,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "هٰذَا خَلْقُ اللّٰهِ فَاَرُونٖی مَاذَا خَلَقَ الَّذٖینَ مِنْ دُونِهٖؕ بَلِ الظَّالِمُونَ فٖی ضَلَالٍ مُبٖینٍࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 24288,
            "SureId": 31,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "Elif-lâm-mîm.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 31,
                "MealInfo": "Mekke döneminde inmiştir. 34 âyettir. Sûre, adını 12. ve 13. âyetlerde anılan <b>Hz. Lokmân</b>’dan almıştır. Sûrede başlıca, <b>Hz. Lokmân’ın oğluna öğütleri çerçevesinde, tevhid, peygamberlik, öldükten sonra dirilme ve haşr konularına dikkat çekilmekte, kıyamet günü için hazırlıklı olunması </b>öğütlenmektedir.",
                "SureNameTurkish": "Lokmân",
                "SureNameArabic": "لُقْمٰانَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 57,
                "AyetCount": 34,
                "Cuz": 21,
                "FirstPage": 411,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 24295,
            "SureId": 31,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2-3",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "Bunlar, güzel işlerin peşinde olanlara hidayet ve rahmet kaynağı olan hikmetli kitabın âyetleridir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24302,
            "SureId": 31,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": false,
            "Page": 411,
            "AyetText": "Bunlar, güzel işlerin peşinde olanlara hidayet ve rahmet kaynağı olan hikmetli kitabın âyetleridir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24309,
            "SureId": 31,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "Namazlarını özenle kılan, zekâtı veren ve âhirete kesin olarak inananlar;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24316,
            "SureId": 31,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "İşte onlar rableri tarafından gösterilen doğru yol üzerindedirler; kurtuluşa erenler de yalnız onlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24323,
            "SureId": 31,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "İnsanlar arasında öyleleri vardır ki bilgisizlik yüzünden başkalarını Allah yolundan saptırmak ve o âyetleri alay konusu etmek için eğlendirici sözler kullanırlar; işte bunları alçaltıcı bir azap bekliyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24330,
            "SureId": 31,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "Böyle birine âyetlerimiz okunduğunda sanki kulaklarında ağırlık varmış da onu işitemiyormuş gibi büyüklük taslayarak sırt çevirir. Ona acıklı bir azabı müjdele!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24337,
            "SureId": 31,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8-9",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "İman edip dünya ve âhiret için yararlı işler yapanlara gelince, onları da nimetlerle dolu, içinde ebedî kalacakları cennetler bekliyor. Bunu Allah gerçek olarak vaad etmiştir. O azîzdir, hakîmdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24344,
            "SureId": 31,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": false,
            "Page": 411,
            "AyetText": "İman edip dünya ve âhiret için yararlı işler yapanlara gelince, onları da nimetlerle dolu, içinde ebedî kalacakları cennetler bekliyor. Bunu Allah gerçek olarak vaad etmiştir. O azîzdir, hakîmdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24351,
            "SureId": 31,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "O, gökleri görebileceğiniz herhangi bir destek olmadan (duracak şekilde) yarattı, sizi dengede tutması için yere sağlam dağlar yerleştirdi, orada her türlü canlının çoğalmasını sağladı. Biz, gökten su indirip (bununla) yeryüzünde her türden faydalı bitkiler bitirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24358,
            "SureId": 31,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 411,
            "AyetText": "İşte bunlar Allah’ın yarattıklarıdır. Şimdi gösterin bana, O’ndan başkası ne yaratmış? Hayır, zalimler açık bir sapkınlık içindedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Lokmân",
