            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "حٰمٓؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 41,
                "MealInfo": "Mekke döneminde inmiştir. 54 âyettir. Sûre, adını üçüncü âyette geçen ve Kur’an âyetlerini niteleyen <b>“fussilet”</b> ifadesinden almıştır. <b>“Fussilet”, “genişçe açıkland</b>ı” demektir. Sûre, ayrıca<b> “Hâ Mîm es-Secde”</b> diye de anılır. Sûrede başlıca <b>hakka davet, batılda ısrar edenlerin uyarılması, vahyin insanlar üzerindeki ahlâkî ve manevî etkileri </b>konu edilmektedir.",
                "SureNameTurkish": "Fussilet",
                "SureNameArabic": "فُصِّلَتْ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 61,
                "AyetCount": 54,
                "Cuz": 24,
                "FirstPage": 477,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 29540,
            "SureId": 41,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "تَنْزٖیلٌ مِنَ الرَّحْمٰنِ الرَّحٖیمِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29547,
            "SureId": 41,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "كِتَابٌ فُصِّلَتْ اٰیَاتُهُ قُرْاٰنًا عَرَبِیًّا لِقَوْمٍ یَعْلَمُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29554,
            "SureId": 41,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "بَشٖیرًا وَنَذٖیرًاۚ فَاَعْرَضَ اَكْثَرُهُمْ فَهُمْ لَا یَسْمَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29561,
            "SureId": 41,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "وَقَالُوا قُلُوبُنَا فٖٓی اَكِنَّةٍ مِمَّا تَدْعُونَٓا اِلَیْهِ وَفٖٓی اٰذَانِنَا وَقْرٌ وَمِنْ بَیْنِنَا وَبَیْنِكَ حِجَابٌ فَاعْمَلْ اِنَّنَا عَامِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29568,
            "SureId": 41,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "قُلْ اِنَّمَٓا اَنَا𐻾 بَشَرٌ مِثْلُكُمْ یُوحٰٓى اِلَیَّ اَنَّمَٓا اِلٰهُكُمْ اِلٰهٌ وَاحِدٌ فَاسْتَقٖیمُٓوا اِلَیْهِ وَاسْتَغْفِرُوهُؕ وَوَیْلٌ لِلْمُشْرِكٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29575,
            "SureId": 41,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "اَلَّذٖینَ لَا یُؤْتُونَ الزَّكٰوةَ وَهُمْ بِالْاٰخِرَةِ هُمْ كَافِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29582,
            "SureId": 41,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "اِنَّ الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ اَجْرٌ غَیْرُ مَمْنُونٍࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29589,
            "SureId": 41,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "قُلْ اَئِنَّكُمْ لَتَكْفُرُونَ بِالَّذٖی خَلَقَ الْاَرْضَ فٖی یَوْمَیْنِ وَتَجْعَلُونَ لَهُٓ اَنْدَادًاؕ ذٰلِكَ رَبُّ الْعَالَمٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29596,
            "SureId": 41,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "وَجَعَلَ فٖیهَا رَوَاسِیَ مِنْ فَوْقِهَا وَبَارَكَ فٖیهَا وَقَدَّرَ فٖیهَٓا اَقْوَاتَهَا فٖٓی اَرْبَعَةِ اَیَّامٍؕ سَوَٓاءً لِلسَّٓائِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29603,
            "SureId": 41,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "ثُمَّ اسْتَوٰٓى اِلَى السَّمَٓاءِ وَهِیَ دُخَانٌ فَقَالَ لَهَا وَلِلْاَرْضِ ائْتِیَا طَوْعًا اَوْ كَرْهًاؕ قَالَتَٓا اَتَیْنَا طَٓائِعٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 29531,
            "SureId": 41,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "Hâ-mîm.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 41,
                "MealInfo": "Mekke döneminde inmiştir. 54 âyettir. Sûre, adını üçüncü âyette geçen ve Kur’an âyetlerini niteleyen <b>“fussilet”</b> ifadesinden almıştır. <b>“Fussilet”, “genişçe açıkland</b>ı” demektir. Sûre, ayrıca<b> “Hâ Mîm es-Secde”</b> diye de anılır. Sûrede başlıca <b>hakka davet, batılda ısrar edenlerin uyarılması, vahyin insanlar üzerindeki ahlâkî ve manevî etkileri </b>konu edilmektedir.",
                "SureNameTurkish": "Fussilet",
                "SureNameArabic": "فُصِّلَتْ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 61,
                "AyetCount": 54,
                "Cuz": 24,
                "FirstPage": 477,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 29538,
            "SureId": 41,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "Bu Kur’an, rahman ve rahîm olan Allah’ın katından indirilmiştir;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29545,
            "SureId": 41,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "Bilmek isteyenler için âyetleri apaçık hale getirilmiş Arapça okunan bir kitaptır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29552,
            "SureId": 41,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "Müjdeleyici ve uyarıcı olarak indirilmiştir ama çokları yüz çevirdi, artık onu ­işitmezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29559,
            "SureId": 41,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "Dediler ki: “Bizi çağırdığın şeylere karşı kalplerimiz kapalıdır, kulaklarımızda da sağırlık var; bir de seninle bizim aramızda perde bulunmaktadır. Sen yapacağını yap, biz de yapmaktayız!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29566,
            "SureId": 41,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "De ki: “Ben sadece sizin gibi bir beşerim; bana tanrınızın tek tanrı olduğu vahyedilmiştir, doğruca O’na yönelin, O’ndan bağışlanma dileyin. Allah’a ortak koşanların vay haline!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29573,
            "SureId": 41,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "Ki onlar mallarından muhtaçları yararlandırmazlar; onlar âhireti de inkâr ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29580,
            "SureId": 41,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "İman edip dünya ve âhiret için yararlı işler yapanlara gelince, onlar için eksilmeyen bir mükâfat vardır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29587,
            "SureId": 41,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "De ki: “Arzı iki günde yaratanı inkâr edip O’na başkalarını ortak mı koşuyorsunuz? O yaratıcı ve âlemlerin rabbi olan Allah’tır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29594,
            "SureId": 41,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "Arz üzerinde sarsılmaz dağlar oturttu, orayı bereketli hale getirdi; gerekli besinlerini orada -bunlara ihtiyacı olan varlıklar için eşit derecede olmak üzere- uygun ölçülerle yarattı. (Bütün bunlar) dört günde oldu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29601,
            "SureId": 41,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 477,
            "AyetText": "Dahası O, duman halinde olan semaya iradesini yöneltti; ardından ona ve arza, “İsteyerek veya istemeyerek (varlık sahnesine) gelin!” buyurdu. “İsteyerek geldik” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Fussilet",
    "QuranSureLabel": "فُصِّلَتْ",
