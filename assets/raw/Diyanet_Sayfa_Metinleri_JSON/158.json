            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "وَالْبَلَدُ الطَّیِّبُ یَخْرُجُ نَبَاتُهُ بِاِذْنِ رَبِّهٖۚ وَالَّذٖی خَبُثَ لَا یَخْرُجُ اِلَّا نَكِدًاؕ كَذٰلِكَ نُصَرِّفُ الْاٰیَاتِ لِقَوْمٍ یَشْكُرُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 7,
                "MealInfo": "Mekke döneminde inmiştir. 163-170. âyetlerin Medine döneminde indiğini söyleyen âlimler de vardır. 206 âyettir. Sûre, adını 46. ve 48. âyetlerde geçen<b>“el-A’râf ” </b>kelimesinden almıştır. <b>“el-A’râf ”, <i>yüksek yerler, yüksek mevkiler</i> demektir</b>. Sûrede temel konu olarak, ilâhî vahyin doğruluğu ve vahye duyulan ihtiyaç işlenmektedir.",
                "SureNameTurkish": "A'râf",
                "SureNameArabic": "الْاَعْرَافِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
