                "ExcludeMenu": false
            }
        },
        {
            "Id": 7091,
            "SureId": 7,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "لَقَدْ اَرْسَلْنَا نُوحًا اِلٰى قَوْمِهٖ فَقَالَ یَا قَوْمِ اعْبُدُوا اللّٰهَ مَا لَكُمْ مِنْ اِلٰهٍ غَیْرُهُؕ اِنّٖٓی اَخَافُ عَلَیْكُمْ عَذَابَ یَوْمٍ عَظٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7098,
            "SureId": 7,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "قَالَ الْمَلَاُ مِنْ قَوْمِهٖٓ اِنَّا لَنَرٰیكَ فٖی ضَلَالٍ مُبٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7105,
            "SureId": 7,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "قَالَ یَا قَوْمِ لَیْسَ بٖی ضَلَالَةٌ وَلٰكِنّٖی رَسُولٌ مِنْ رَبِّ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7112,
            "SureId": 7,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "اُبَلِّغُكُمْ رِسَالَاتِ رَبّٖی وَاَنْصَحُ لَكُمْ وَاَعْلَمُ مِنَ اللّٰهِ مَا لَا تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7119,
            "SureId": 7,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "اَوَعَجِبْتُمْ اَنْ جَٓاءَكُمْ ذِكْرٌ مِنْ رَبِّكُمْ عَلٰى رَجُلٍ مِنْكُمْ لِیُنْذِرَكُمْ وَلِتَتَّقُوا وَلَعَلَّكُمْ تُرْحَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7126,
            "SureId": 7,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "فَكَذَّبُوهُ فَاَنْجَیْنَاهُ وَالَّذٖینَ مَعَهُ فِی الْفُلْكِ وَاَغْرَقْنَا الَّذٖینَ كَذَّبُوا بِاٰیَاتِنَاؕ اِنَّهُمْ كَانُوا قَوْمًا عَمٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7133,
            "SureId": 7,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "وَاِلٰى عَادٍ اَخَاهُمْ هُودًاؕ قَالَ یَا قَوْمِ اعْبُدُوا اللّٰهَ مَا لَكُمْ مِنْ اِلٰهٍ غَیْرُهُؕ اَفَلَا تَتَّقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7140,
            "SureId": 7,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "قَالَ الْمَلَاُ الَّذٖینَ كَفَرُوا مِنْ قَوْمِهٖٓ اِنَّا لَنَرٰیكَ فٖی سَفَاهَةٍ وَاِنَّا لَنَظُنُّكَ مِنَ الْكَاذِبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7147,
            "SureId": 7,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "قَالَ یَا قَوْمِ لَیْسَ بٖی سَفَاهَةٌ وَلٰكِنّٖی رَسُولٌ مِنْ رَبِّ الْعَالَمٖینَ",
            "Recitation": "",
