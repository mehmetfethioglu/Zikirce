    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 7082,
            "SureId": 7,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "Güzel memleketin bitkisi rabbinin izniyle (güzel) çıkar; kötü olandan ise faydasız üründen başka bir şey çıkmaz. İşte biz şükreden bir kavim için âyetleri böyle açıklıyoruz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 7,
                "MealInfo": "Mekke döneminde inmiştir. 163-170. âyetlerin Medine döneminde indiğini söyleyen âlimler de vardır. 206 âyettir. Sûre, adını 46. ve 48. âyetlerde geçen<b>“el-A’râf ” </b>kelimesinden almıştır. <b>“el-A’râf ”, <i>yüksek yerler, yüksek mevkiler</i> demektir</b>. Sûrede temel konu olarak, ilâhî vahyin doğruluğu ve vahye duyulan ihtiyaç işlenmektedir.",
                "SureNameTurkish": "A'râf",
                "SureNameArabic": "الْاَعْرَافِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 39,
                "AyetCount": 206,
                "Cuz": 8,
                "FirstPage": 151,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 7089,
            "SureId": 7,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "Andolsun ki Nûh’u elçi olarak kavmine gönderdik. Dedi ki: “Ey kavmim! Allah’a kulluk edin; sizin O’ndan başka tanrınız yoktur. Doğrusu ben, üzerinize gelecek büyük bir günün azabından korkuyorum.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7096,
            "SureId": 7,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "Kavminden ileri gelenler, “Biz seni gerçekten apaçık bir sapkınlık içinde görüyoruz!” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7103,
            "SureId": 7,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "Nûh şöyle cevap verdi: “Ey kavmim! Bende hiçbir sapkınlık yoktur; şu var ki ben âlemlerin rabbi tarafından gönderilmiş bir elçiyim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7110,
            "SureId": 7,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "Size rabbimin vahyettiklerini duyuruyorum, size öğüt veriyorum ve ben sizin bilmediklerinizi Allah’tan (gelen vahiy ile) biliyorum.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7117,
            "SureId": 7,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "Günahtan sakınıp da rahmete nâil olasınız diye, içinizden sizleri uyaracak bir adam vasıtasıyla rabbinizden size bir zikir (vahiy) gelmesine şaşırdınız mı?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7124,
            "SureId": 7,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "Onu yalanladılar. Biz de onu ve onunla beraber gemide bulunanları kurtardık; âyetlerimizi asılsız sayanları da suda boğduk! Çünkü onlar gerçeği göremeyen bir kavim idiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7131,
            "SureId": 7,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "Âd kavmine de kardeşleri Hûd’u (gönderdik). O dedi ki: “Ey kavmim! Allah’a kulluk edin; sizin O’ndan başka tanrınız yoktur. Hâlâ sakınmayacak mısınız?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7138,
            "SureId": 7,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "Kavminin inkârcı ileri gelenleri, “Biz seni kesinlikle bir akılsızlık içinde görüyoruz ve gerçekten senin yalancılardan olduğunu düşünüyoruz” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7145,
            "SureId": 7,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 158,
            "AyetText": "“Ey kavmim!” dedi, “Ben akılsız değilim, fakat âlemlerin rabbi tarafından gönderilmiş bir elçiyim.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
