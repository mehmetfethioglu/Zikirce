            "SureId": 84,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "Ey insan! Sen rabbine doğru büyük bir çaba içindesin; sonunda kuşkusuz O’na kavuşacaksın da.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
