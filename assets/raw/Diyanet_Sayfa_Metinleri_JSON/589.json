            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3-4",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "Yer dümdüz edildiğinde ve içindekileri atıp boşaldığında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41214,
            "SureId": 84,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": false,
            "Page": 589,
            "AyetText": "Yer dümdüz edildiğinde ve içindekileri atıp boşaldığında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
