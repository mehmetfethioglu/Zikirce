            "SureId": 84,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "Ve o da rabbine boyun eğip gerekeni yaptığında (herkes yaptığının karşılığını görecektir).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
