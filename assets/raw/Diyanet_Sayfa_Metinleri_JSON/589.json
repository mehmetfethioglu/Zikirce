            "SureId": 83,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "عَیْنًا یَشْرَبُ بِهَا الْمُقَرَّبُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41139,
            "SureId": 83,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "اِنَّ الَّذٖینَ اَجْرَمُوا كَانُوا مِنَ الَّذٖینَ اٰمَنُوا یَضْحَكُونَؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41146,
            "SureId": 83,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "وَاِذَا مَرُّوا بِهِمْ یَتَغَامَزُونَؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41153,
            "SureId": 83,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "وَاِذَا انْقَلَبُٓوا اِلٰٓى اَهْلِهِمُ انْقَلَبُوا فَكِهٖینَؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41160,
            "SureId": 83,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "وَاِذَا رَاَوْهُمْ قَالُٓوا اِنَّ هٰٓؤُ𐻾لَٓاءِ لَضَٓالُّونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41167,
            "SureId": 83,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "وَمَٓا اُرْسِلُوا عَلَیْهِمْ حَافِظٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41174,
            "SureId": 83,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "فَالْیَوْمَ الَّذٖینَ اٰمَنُوا مِنَ الْكُفَّارِ یَضْحَكُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41181,
            "SureId": 83,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "عَلَى الْاَرَٓائِكِۙ یَنْظُرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41188,
            "SureId": 83,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "هَلْ ثُوِّبَ الْكُفَّارُ مَا كَانُوا یَفْعَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41195,
            "SureId": 84,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "اِذَا السَّمَٓاءُ انْشَقَّتْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 84,
                "MealInfo": "Mekke döneminde inmiştir. 25 âyettir. Sûre, adını birinci âyette geçen “inşakka” fiilinin mastarı olan “İnşikâk” kelimesinden almıştır. İnşikâk, yarılmakdemektir",
                "SureNameTurkish": "İnşikâk",
                "SureNameArabic": "الْاِنْشِقَاقِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 83,
                "AyetCount": 25,
                "Cuz": 30,
                "FirstPage": 589,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 41202,
            "SureId": 84,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41209,
            "SureId": 84,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "وَاِذَا الْاَرْضُ مُدَّتْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41216,
            "SureId": 84,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "وَاَلْقَتْ مَا فٖیهَا وَتَخَلَّتْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41223,
            "SureId": 84,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41230,
            "SureId": 84,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "یَٓا اَیُّهَا الْاِنْسَانُ اِنَّكَ كَادِحٌ اِلٰى رَبِّكَ كَدْحًا فَمُلَاقٖیهِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41237,
            "SureId": 84,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "فَاَمَّا مَنْ اُو𐻿تِیَ كِتَابَهُ بِیَمٖینِهٖۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41244,
            "SureId": 84,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "فَسَوْفَ یُحَاسَبُ حِسَابًا یَسٖیرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41251,
            "SureId": 84,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "وَیَنْقَلِبُ اِلٰٓى اَهْلِهٖ مَسْرُورًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41258,
            "SureId": 84,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "وَاَمَّا مَنْ اُو𐻿تِیَ كِتَابَهُ وَرَٓاءَ ظَهْرِهٖۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41265,
            "SureId": 84,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "فَسَوْفَ یَدْعُوا ثُبُورًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41272,
            "SureId": 84,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "وَیَصْلٰى سَعٖیرًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41279,
            "SureId": 84,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "اِنَّهُ كَانَ فٖٓی اَهْلِهٖ مَسْرُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
