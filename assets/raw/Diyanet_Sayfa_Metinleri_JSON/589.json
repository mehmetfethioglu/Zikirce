            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": false,
            "Page": 589,
            "AyetText": "O içkinin karışımı tesnîmden, yani Allah’a yakın olanların içecekleri bir kaynaktandır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41137,
            "SureId": 83,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "Günahkârlar (dünyada) iman edenlere gülüp dururlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41144,
            "SureId": 83,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "Yanlarından geçtiklerinde birbirlerine kaş göz ederlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41151,
            "SureId": 83,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "Sonra kendi çevrelerine dönerken neşe içinde dönerlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41158,
            "SureId": 83,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "Müminleri gördüklerinde, “Bunlar gerçekten yollarını şaşırmış kimseler!” derlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41165,
            "SureId": 83,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "Oysa onlar, müminleri koruyup gözetmekle görevlendirilmiş değillerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41172,
            "SureId": 83,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "Ama o gün de müminler kâfirlere gülecekler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41179,
            "SureId": 83,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35-36",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "Koltuklarına kurulup, “Kâfirler yaptıklarının cezasını buldular mı?” diye etrafa bakacaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41186,
            "SureId": 83,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": false,
            "Page": 589,
            "AyetText": "Koltuklarına kurulup, \"Kâfirler yaptıklarının cezasını buldular mı?\" diye etrafa bakacaklar.",
            "Recitation": "",
