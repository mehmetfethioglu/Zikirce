            "SureId": 84,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7-8",
            "AyetVisible": true,
            "Page": 589,
            "AyetText": "Kime kitabı sağından verilirse hesabı kolay bir şekilde görülecektir;",
