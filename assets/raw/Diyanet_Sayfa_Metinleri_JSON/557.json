    "QuranAyats": [
        {
            "Id": 36463,
            "SureId": 64,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "وَالَّذٖینَ كَفَرُوا وَكَذَّبُوا بِاٰیَاتِنَٓا اُو𐻾لٰٓئِكَ اَصْحَابُ النَّارِ خَالِدٖینَ فٖیهَاؕ وَبِئْسَ الْمَصٖیرُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 64,
                "MealInfo": "Medine döneminde inmiştir. 18 âyettir. Sûre, adını 9. âyette geçen “etTeğâbun”kelimesinden almıştır. Teğâbun, aldanma demektir. İnanmayanların aldanışları, Kıyamet gününde açıkça ortaya çıkacağı için bugüne“Yevmü’t-Teğâbun (aldanma günü)” denmiştir. Sûrede, başlıca mü’min olsun,kâfir olsun herkesin eksiklik ve kusurlarının kıyamet günü açığa çıkacağı konu edilmektedir.",
                "SureNameTurkish": "Tegâbün",
                "SureNameArabic": "التَّغَابُنِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 108,
                "AyetCount": 18,
                "Cuz": 28,
                "FirstPage": 556,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 36470,
            "SureId": 64,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "مَٓا اَصَابَ مِنْ مُصٖیبَةٍ اِلَّا بِاِذْنِ اللّٰهِؕ وَمَنْ یُؤْمِنْ بِاللّٰهِ یَهْدِ قَلْبَهُؕ وَاللّٰهُ بِكُلِّ شَیْءٍ عَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36477,
            "SureId": 64,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "وَاَطٖیعُوا اللّٰهَ وَاَطٖیعُوا الرَّسُولَۚ فَاِنْ تَوَلَّیْتُمْ فَاِنَّمَا عَلٰى رَسُولِنَا الْبَلَاغُ الْمُبٖینُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36484,
            "SureId": 64,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "اَللّٰهُ لَٓا اِلٰهَ اِلَّا هُوَؕ وَعَلَى اللّٰهِ فَلْیَتَوَكَّلِ الْمُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36491,
            "SureId": 64,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "یَٓا اَیُّهَا الَّذٖینَ اٰمَنُٓوا اِنَّ مِنْ اَزْوَاجِكُمْ وَاَوْلَادِكُمْ عَدُوًّا لَكُمْ فَاحْذَرُوهُمْۚ وَاِنْ تَعْفُوا وَتَصْفَحُوا وَتَغْفِرُوا فَاِنَّ اللّٰهَ غَفُورٌ رَحٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36498,
            "SureId": 64,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "اِنَّمَٓا اَمْوَالُكُمْ وَاَوْلَادُكُمْ فِتْنَةٌؕ وَاللّٰهُ عِنْدَهُٓ اَجْرٌ عَظٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36505,
            "SureId": 64,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "فَاتَّقُوا اللّٰهَ مَا اسْتَطَعْتُمْ وَاسْمَعُوا وَاَطٖیعُوا وَاَنْفِقُوا خَیْرًا لِاَنْفُسِكُمْؕ وَمَنْ یُوقَ شُحَّ نَفْسِهٖ فَاُو𐻾لٰٓئِكَ هُمُ الْمُفْلِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36512,
            "SureId": 64,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "اِنْ تُقْرِضُوا اللّٰهَ قَرْضًا حَسَنًا یُضَاعِفْهُ لَكُمْ وَیَغْفِرْ لَكُمْؕ وَاللّٰهُ شَكُورٌ حَلٖیمٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36519,
            "SureId": 64,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "عَالِمُ الْغَیْبِ وَالشَّهَادَةِ الْعَزٖیزُ الْحَكٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 36461,
            "SureId": 64,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "İnkâr edip âyetlerimizi yalan sayanlara gelince, onlar cehennemliktir ve orada ebedî olarak kalacaklardır. Ne kötü son!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 64,
                "MealInfo": "Medine döneminde inmiştir. 18 âyettir. Sûre, adını 9. âyette geçen “etTeğâbun”kelimesinden almıştır. Teğâbun, aldanma demektir. İnanmayanların aldanışları, Kıyamet gününde açıkça ortaya çıkacağı için bugüne“Yevmü’t-Teğâbun (aldanma günü)” denmiştir. Sûrede, başlıca mü’min olsun,kâfir olsun herkesin eksiklik ve kusurlarının kıyamet günü açığa çıkacağı konu edilmektedir.",
                "SureNameTurkish": "Tegâbün",
                "SureNameArabic": "التَّغَابُنِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 108,
                "AyetCount": 18,
                "Cuz": 28,
                "FirstPage": 556,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 36468,
            "SureId": 64,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "Allah’ın izni olmadan hiçbir musibet başa gelmez. Kim Allah’a iman ederse Allah onun gönlünü doğruya yöneltir. Allah her şeyi bilmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36475,
            "SureId": 64,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "Allah’a itaat edin, peygambere itaat edin. Sırt çevirirseniz bilin ki elçimizin görevi açık bir tebliğden ibarettir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36482,
            "SureId": 64,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "Allah; O’ndan başka tanrı yoktur; müminler de yalnız O’na dayanıp güvensinler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36489,
            "SureId": 64,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "Ey iman edenler! Eşlerinizden ve çocuklarınızdan da size düşman olanlar vardır, onlardan sakının. Ama affeder, hoşgörülü ve bağışlayıcı davranırsanız, şüphesiz Allah da çok bağışlayıcı ve engin merhamet sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36496,
            "SureId": 64,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "Mallarınız ve çocuklarınız sizin için ancak bir imtihandır; büyük mükâfat ise Allah’ın katındadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36503,
            "SureId": 64,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "O halde gücünüz yettiğince Allah’a saygısızlıktan sakının; dinleyin, itaat edin ve kendi iyiliğinize olmak üzere başkaları için harcayın. Kim nefsinin bencilliğinden korunursa işte kurtuluşa erecekler onlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36510,
            "SureId": 64,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "Allah’a güzel bir borç verirseniz O da bunu size fazlasıyla öder ve sizi bağışlar. Allah şükrün karşılığını bol bol verir, cezada ise acele etmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36517,
            "SureId": 64,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 557,
            "AyetText": "Allah, akıl ve duyularla idrak edilemeyeni de edileni de bilir; O üstündür, hikmet sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
