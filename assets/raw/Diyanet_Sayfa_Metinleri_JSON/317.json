    "QuranAyats": [
        {
            "Id": 16975,
            "SureId": 20,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "وَلَقَدْ اَوْحَیْنَٓا اِلٰى مُوسٰٓى اَنْ اَسْرِ بِعِبَادٖی فَاضْرِبْ لَهُمْ طَرٖیقًا فِی الْبَحْرِ یَبَسًاۚ لَا تَخَافُ دَرَكًا وَلَا تَخْشٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16982,
            "SureId": 20,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "فَاَتْبَعَهُمْ فِرْعَوْنُ بِجُنُودِهٖ فَغَشِیَهُمْ مِنَ الْیَمِّ مَا غَشِیَهُمْؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16989,
            "SureId": 20,
            "AyetId": 79,
            "LanguageId": 7,
            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "وَاَضَلَّ فِرْعَوْنُ قَوْمَهُ وَمَا هَدٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16996,
            "SureId": 20,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "یَا بَنٖٓی اِسْرَٓایٖٔلَ قَدْ اَنْجَیْنَاكُمْ مِنْ عَدُوِّكُمْ وَوٰعَدْنَاكُمْ جَانِبَ الطُّورِ الْاَیْمَنَ وَنَزَّلْنَا عَلَیْكُمُ الْمَنَّ وَالسَّلْوٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17003,
            "SureId": 20,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "كُلُوا مِنْ طَیِّبَاتِ مَا رَزَقْنَاكُمْ وَلَا تَطْغَوْا فٖیهِ فَیَحِلَّ عَلَیْكُمْ غَضَبٖیۚ وَمَنْ یَحْلِلْ عَلَیْهِ غَضَبٖی فَقَدْ هَوٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17010,
            "SureId": 20,
            "AyetId": 82,
            "LanguageId": 7,
            "AyetNumber": "٨٢",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "وَاِنّٖی لَغَفَّارٌ لِمَنْ تَابَ وَاٰمَنَ وَعَمِلَ صَالِحًا ثُمَّ اهْتَدٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17017,
            "SureId": 20,
            "AyetId": 83,
            "LanguageId": 7,
            "AyetNumber": "٨٣",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "وَمَٓا اَعْجَلَكَ عَنْ قَوْمِكَ یَا مُوسٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17024,
            "SureId": 20,
            "AyetId": 84,
            "LanguageId": 7,
            "AyetNumber": "٨٤",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "قَالَ هُمْ اُو𐻾لَٓاءِ عَلٰٓى اَثَرٖی وَعَجِلْتُ اِلَیْكَ رَبِّ لِتَرْضٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17031,
            "SureId": 20,
            "AyetId": 85,
            "LanguageId": 7,
            "AyetNumber": "٨٥",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "قَالَ فَاِنَّا قَدْ فَتَنَّا قَوْمَكَ مِنْ بَعْدِكَ وَاَضَلَّهُمُ السَّامِرِیُّ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17038,
            "SureId": 20,
            "AyetId": 86,
            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "فَرَجَعَ مُوسٰٓى اِلٰى قَوْمِهٖ غَضْبَانَ اَسِفًاۚ قَالَ یَا قَوْمِ اَلَمْ یَعِدْكُمْ رَبُّكُمْ وَعْدًا حَسَنًاؕ اَفَطَالَ عَلَیْكُمُ الْعَهْدُ اَمْ اَرَدْتُمْ اَنْ یَحِلَّ عَلَیْكُمْ غَضَبٌ مِنْ رَبِّكُمْ فَاَخْلَفْتُمْ مَوْعِدٖی",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17045,
            "SureId": 20,
            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "قَالُوا مَٓا اَخْلَفْنَا مَوْعِدَكَ بِمَلْكِنَا وَلٰكِنَّا حُمِّلْنَٓا اَوْزَارًا مِنْ زٖینَةِ الْقَوْمِ فَقَذَفْنَاهَا فَكَذٰلِكَ اَلْقَى السَّامِرِیُّۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 16973,
            "SureId": 20,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "Mûsâ’ya şöyle vahyetmiştik: “Kullarımı geceleyin yola çıkar, yetişecekler diye korku ve endişe duymaksızın onlara denizde kupkuru bir yol aç.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16980,
            "SureId": 20,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "Derken Firavun askerleriyle onların peşine düştü, ama deniz onları amansızca sarıverdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16987,
            "SureId": 20,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "Firavun kavmini saptırmış, doğru yolu göstermemişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16994,
            "SureId": 20,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "Ey İsrâiloğulları! Böylece sizi düşmanınızdan kurtardık ve Tûr’un sağ tarafında sizinle sözleştik; size kudret helvası ve bıldırcın gönderdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17001,
            "SureId": 20,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "Size rızık olarak verdiğimiz iyi ve temiz şeylerden yiyin ama bunda ölçüyü aşmayın, yoksa gazabıma uğrarsınız; kim gazabıma uğrarsa artık uçuruma yuvarlanmış demektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17008,
            "SureId": 20,
            "AyetId": 82,
            "LanguageId": 5,
            "AyetNumber": "82",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "Şu da bilinmeli ki, ben tövbe edip yürekten inanan ve iyi işler yapan, sonra da doğru yolda sebat eden kimselere karşı çok bağışlayıcıyım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17015,
            "SureId": 20,
            "AyetId": 83,
            "LanguageId": 5,
            "AyetNumber": "83",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "(Allah buyurdu ki:) “Seni halkından aceleyle ayrılmaya sevkeden neydi ey Mûsâ!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17022,
            "SureId": 20,
            "AyetId": 84,
            "LanguageId": 5,
            "AyetNumber": "84",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "Şöyle cevap verdi: “Onlar da benim izimdeler; benden hoşnut olasın diye sana gelmekte acele ettim ey rabbim.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17029,
            "SureId": 20,
            "AyetId": 85,
            "LanguageId": 5,
            "AyetNumber": "85",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "Allah, “Fakat” dedi, “Biz senden sonra kavmini sınadık ve Sâmirî onları yoldan çıkardı.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17036,
            "SureId": 20,
            "AyetId": 86,
            "LanguageId": 5,
            "AyetNumber": "86",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "Bunun üzerine Mûsâ öfkeli halde ve hayıflanarak kavmine döndü. Şöyle dedi: “Ey kavmim! Rabbiniz size güzel bir vaadde bulunmamış mıydı? Peki size bu süre çok mu uzun geldi, yoksa rabbinizin gazabına uğramak istediniz de onun için mi bana verdiğiniz sözden döndünüz!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17043,
            "SureId": 20,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87",
            "AyetVisible": true,
            "Page": 317,
            "AyetText": "Şöyle cevap verdiler: “Sana verdiğimiz söze bilerek ve isteyerek aykırı davranmış değiliz; fakat şu kavmin (Mısır halkının) ziynet eşyalarından bir kısmını yüklenmiştik, onları (haram diye ateşe) attık; çünkü Sâmirî de aynı şekilde atmıştı.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Tâhâ",
    "QuranSureLabel": "طٰهٰ",
    "EndPageSure": null
}