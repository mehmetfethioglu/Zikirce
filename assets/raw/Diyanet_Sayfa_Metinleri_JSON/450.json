            "AyetId": 103,
            "LanguageId": 7,
            "AyetNumber": "١٠٣",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "فَلَمَّٓا اَسْلَمَا وَتَلَّهُ لِلْجَبٖینِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 37,
                "MealInfo": "Mekke döneminde inmiştir. 182 âyettir. Sûre, adını ilk âyette geçen <b>“es-Sâffât” </b>kelimesinden almıştır.<b> Sâffât, sıra sıra dizilenler, saf saf duranlar demektir</b>. Sûrede başlıca, <b>meleklerden, cinlerden, kıyamet ve ahiret olaylarından söz edilmekte; Nûh, İbrahim, İsmail, İshak, Mûsâ, Hârun, İlyas, Lût ve Yûnus Peygamberlerin kıssaları</b>na yer verilmektedir.",
                "SureNameTurkish": "Sâffât",
                "SureNameArabic": "الصَّاۤفَّاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 56,
                "AyetCount": 182,
                "Cuz": 23,
                "FirstPage": 446,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 27244,
            "SureId": 37,
            "AyetId": 104,
            "LanguageId": 7,
            "AyetNumber": "١٠٤",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "وَنَادَیْنَاهُ اَنْ یَٓا اِبْرٰهٖیمُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27251,
            "SureId": 37,
            "AyetId": 105,
            "LanguageId": 7,
            "AyetNumber": "١٠٥",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "قَدْ صَدَّقْتَ الرُّءْیَاۚ اِنَّا كَذٰلِكَ نَجْزِی الْمُحْسِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27258,
            "SureId": 37,
            "AyetId": 106,
            "LanguageId": 7,
            "AyetNumber": "١٠٦",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "اِنَّ هٰذَا لَهُوَ الْبَلٰٓؤُا الْمُبٖینُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27265,
            "SureId": 37,
            "AyetId": 107,
            "LanguageId": 7,
            "AyetNumber": "١٠٧",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "وَفَدَیْنَاهُ بِذِبْحٍ عَظٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27272,
            "SureId": 37,
            "AyetId": 108,
            "LanguageId": 7,
            "AyetNumber": "١٠٨",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "وَتَرَكْنَا عَلَیْهِ فِی الْاٰخِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27279,
            "SureId": 37,
            "AyetId": 109,
            "LanguageId": 7,
            "AyetNumber": "١٠٩",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "سَلَامٌ عَلٰٓى اِبْرٰهٖیمَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27286,
            "SureId": 37,
            "AyetId": 110,
            "LanguageId": 7,
            "AyetNumber": "١١٠",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "كَذٰلِكَ نَجْزِی الْمُحْسِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27293,
            "SureId": 37,
            "AyetId": 111,
            "LanguageId": 7,
            "AyetNumber": "١١١",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "اِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27300,
            "SureId": 37,
            "AyetId": 112,
            "LanguageId": 7,
            "AyetNumber": "١١٢",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "وَبَشَّرْنَاهُ بِاِسْحٰقَ نَبِیًّا مِنَ الصَّالِحٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27307,
            "SureId": 37,
            "AyetId": 113,
            "LanguageId": 7,
            "AyetNumber": "١١٣",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "وَبَارَكْنَا عَلَیْهِ وَعَلٰٓى اِسْحٰقَؕ وَمِنْ ذُرِّیَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِنَفْسِهٖ مُبٖینٌࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27314,
            "SureId": 37,
            "AyetId": 114,
            "LanguageId": 7,
            "AyetNumber": "١١٤",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "وَلَقَدْ مَنَنَّا عَلٰى مُوسٰى وَهٰرُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27321,
            "SureId": 37,
            "AyetId": 115,
            "LanguageId": 7,
            "AyetNumber": "١١٥",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "وَنَجَّیْنَاهُمَا وَقَوْمَهُمَا مِنَ الْكَرْبِ الْعَظٖیمِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27328,
            "SureId": 37,
            "AyetId": 116,
            "LanguageId": 7,
            "AyetNumber": "١١٦",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "وَنَصَرْنَاهُمْ فَكَانُوا هُمُ الْغَالِبٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27335,
            "SureId": 37,
            "AyetId": 117,
            "LanguageId": 7,
            "AyetNumber": "١١٧",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "وَاٰتَیْنَاهُمَا الْكِتَابَ الْمُسْتَبٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27342,
            "SureId": 37,
            "AyetId": 118,
            "LanguageId": 7,
            "AyetNumber": "١١٨",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "وَهَدَیْنَاهُمَا الصِّرَاطَ الْمُسْتَقٖیمَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27349,
            "SureId": 37,
            "AyetId": 119,
            "LanguageId": 7,
            "AyetNumber": "١١٩",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "وَتَرَكْنَا عَلَیْهِمَا فِی الْاٰخِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27356,
            "SureId": 37,
            "AyetId": 120,
            "LanguageId": 7,
            "AyetNumber": "١٢٠",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "سَلَامٌ عَلٰى مُوسٰى وَهٰرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27363,
            "SureId": 37,
            "AyetId": 121,
            "LanguageId": 7,
            "AyetNumber": "١٢١",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "اِنَّا كَذٰلِكَ نَجْزِی الْمُحْسِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27370,
            "SureId": 37,
            "AyetId": 122,
            "LanguageId": 7,
            "AyetNumber": "١٢٢",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "اِنَّهُمَا مِنْ عِبَادِنَا الْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27377,
            "SureId": 37,
            "AyetId": 123,
            "LanguageId": 7,
            "AyetNumber": "١٢٣",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "وَاِنَّ اِلْیَاسَ لَمِنَ الْمُرْسَلٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27384,
            "SureId": 37,
            "AyetId": 124,
            "LanguageId": 7,
            "AyetNumber": "١٢٤",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "اِذْ قَالَ لِقَوْمِهٖٓ اَلَا تَتَّقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27391,
            "SureId": 37,
            "AyetId": 125,
            "LanguageId": 7,
            "AyetNumber": "١٢٥",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "اَتَدْعُونَ بَعْلًا وَتَذَرُونَ اَحْسَنَ الْخَالِقٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27398,
            "SureId": 37,
            "AyetId": 126,
            "LanguageId": 7,
            "AyetNumber": "١٢٦",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "اَللّٰهَ رَبَّكُمْ وَرَبَّ اٰبَٓائِكُمُ الْاَوَّلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 27235,
            "SureId": 37,
            "AyetId": 103,
            "LanguageId": 5,
            "AyetNumber": "103",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Her ikisi de (ilâhî buyruğa) teslim olunca ve babası onu yüzüstü yatırınca,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 37,
                "MealInfo": "Mekke döneminde inmiştir. 182 âyettir. Sûre, adını ilk âyette geçen <b>“es-Sâffât” </b>kelimesinden almıştır.<b> Sâffât, sıra sıra dizilenler, saf saf duranlar demektir</b>. Sûrede başlıca, <b>meleklerden, cinlerden, kıyamet ve ahiret olaylarından söz edilmekte; Nûh, İbrahim, İsmail, İshak, Mûsâ, Hârun, İlyas, Lût ve Yûnus Peygamberlerin kıssaları</b>na yer verilmektedir.",
                "SureNameTurkish": "Sâffât",
                "SureNameArabic": "الصَّاۤفَّاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 56,
                "AyetCount": 182,
                "Cuz": 23,
                "FirstPage": 446,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 27242,
            "SureId": 37,
            "AyetId": 104,
            "LanguageId": 5,
            "AyetNumber": "104",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "“Ey İbrâhim!” diye ona seslendik;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27249,
            "SureId": 37,
            "AyetId": 105,
            "LanguageId": 5,
            "AyetNumber": "105",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "“Tamam, rüyanı gerçekleştirmiş oldun.” İşte iyileri biz böyle ödüllendiririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27256,
            "SureId": 37,
            "AyetId": 106,
            "LanguageId": 5,
            "AyetNumber": "106",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Bu, kesinlikle apaçık bir imtihandı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27263,
            "SureId": 37,
            "AyetId": 107,
            "LanguageId": 5,
            "AyetNumber": "107",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Biz, (oğlunun canına) bedel olarak ona iri bir kurbanlık verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27270,
            "SureId": 37,
            "AyetId": 108,
            "LanguageId": 5,
            "AyetNumber": "108-109",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Onun hakkında, “İbrâhim’e selâm olsun!” ifadesini sonradan gelen nesiller arasında devam ettirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27277,
            "SureId": 37,
            "AyetId": 109,
            "LanguageId": 5,
            "AyetNumber": "109",
            "AyetVisible": false,
            "Page": 450,
            "AyetText": "Onun hakkında, \"İbrâhim’e selâm olsun!\" ifadesini sonradan gelen nesiller arasında devam ettirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27284,
            "SureId": 37,
            "AyetId": 110,
            "LanguageId": 5,
            "AyetNumber": "110",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Evet, iyileri işte böyle ödüllendiririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27291,
            "SureId": 37,
            "AyetId": 111,
            "LanguageId": 5,
            "AyetNumber": "111",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Çünkü o, bizim mümin kullarımızdandı,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27298,
            "SureId": 37,
            "AyetId": 112,
            "LanguageId": 5,
            "AyetNumber": "112",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "İyi insanlardan (seçilmiş) bir peygamber olarak ona İshak’ı da müjdeledik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27305,
            "SureId": 37,
            "AyetId": 113,
            "LanguageId": 5,
            "AyetNumber": "113",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Ona ve İshak’a bereketler indirdik. Onların soyu içinde iyisi bulunduğu gibi açıkça kendine kötülük edeni de olacaktı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27312,
            "SureId": 37,
            "AyetId": 114,
            "LanguageId": 5,
            "AyetNumber": "114",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Mûsâ ve Hârûn’a da lütuflarda bulunmuştuk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27319,
            "SureId": 37,
            "AyetId": 115,
            "LanguageId": 5,
            "AyetNumber": "115",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Onları ve kavimlerini büyük bir sıkıntıdan kurtardık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27326,
            "SureId": 37,
            "AyetId": 116,
            "LanguageId": 5,
            "AyetNumber": "116",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Onlara yardım ettik ve bu sayede galip çıkanlar onlar oldu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27333,
            "SureId": 37,
            "AyetId": 117,
            "LanguageId": 5,
            "AyetNumber": "117",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "O ikisine açık seçik anlaşılabilen kitabı verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27340,
            "SureId": 37,
            "AyetId": 118,
            "LanguageId": 5,
            "AyetNumber": "118",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Onları doğru yola ilettik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27347,
            "SureId": 37,
            "AyetId": 119,
            "LanguageId": 5,
            "AyetNumber": "119-120",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Ve onların hakkında, “Mûsâ ve Hârûn’a selâm olsun!” ifadesini sonradan gelen nesiller arasında devam ettirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27354,
            "SureId": 37,
            "AyetId": 120,
            "LanguageId": 5,
            "AyetNumber": "120",
            "AyetVisible": false,
            "Page": 450,
            "AyetText": "Ve onların hakkında, \"Mûsâ ve Hârûn’a selâm olsun!\" ifadesini sonradan gelen nesiller arasında devam ettirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27361,
            "SureId": 37,
            "AyetId": 121,
            "LanguageId": 5,
            "AyetNumber": "121",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "İşte iyileri biz böyle ödüllendiririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27368,
            "SureId": 37,
            "AyetId": 122,
            "LanguageId": 5,
            "AyetNumber": "122",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Çünkü ikisi de bizim mümin kullarımızdandı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27375,
            "SureId": 37,
            "AyetId": 123,
            "LanguageId": 5,
            "AyetNumber": "123",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Kuşkusuz İlyâs da elçilerimizden biriydi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27382,
            "SureId": 37,
            "AyetId": 124,
            "LanguageId": 5,
            "AyetNumber": "124",
            "AyetVisible": true,
            "Page": 450,
            "AyetText": "Kavmine, “(Şirk ve günahtan) sakınmayacak mısınız?” dedi;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
