    "QuranAyats": [
        {
            "Id": 33089,
            "SureId": 51,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "كَذٰلِكَ مَٓا اَتَى الَّذٖینَ مِنْ قَبْلِهِمْ مِنْ رَسُولٍ اِلَّا قَالُوا سَاحِرٌ اَوْ مَجْنُونٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 51,
                "MealInfo": "Mekke döneminde inmiştir. 60 âyettir. Sûre, adını ilk âyette geçen <b>“ez-zâriyât” </b>kelimesinden almıştır.<b> Zâriyât, esip savuran rüzgârlar demektir.</b> Sûrede başlıca, <b>öldükten sonra hesap için toplanma, inkârcıların ahirette karşılaşacakları azap, mü’minlere verilecek mükâfatlar, Allah’ın varlığını ve birliğini gösteren kevni deliller</b> konu edilmektedir.",
                "SureNameTurkish": "Zâriyât",
                "SureNameArabic": "الذَّارِيَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 67,
                "AyetCount": 60,
                "Cuz": 26,
                "FirstPage": 520,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33096,
            "SureId": 51,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "اَتَوَاصَوْا بِهٖۚ بَلْ هُمْ قَوْمٌ طَاغُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33103,
            "SureId": 51,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "فَتَوَلَّ عَنْهُمْ فَمَٓا اَنْتَ بِمَلُومٍؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33110,
            "SureId": 51,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "وَذَكِّرْ فَاِنَّ الذِّكْرٰى تَنْفَعُ الْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33117,
            "SureId": 51,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "وَمَا خَلَقْتُ الْجِنَّ وَالْاِنْسَ اِلَّا لِیَعْبُدُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33124,
            "SureId": 51,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "مَٓا اُرٖیدُ مِنْهُمْ مِنْ رِزْقٍ وَمَٓا اُرٖیدُ اَنْ یُطْعِمُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33131,
            "SureId": 51,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "اِنَّ اللّٰهَ هُوَ الرَّزَّاقُ ذُوالْقُوَّةِ الْمَتٖینُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33138,
            "SureId": 51,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "فَاِنَّ لِلَّذٖینَ ظَلَمُوا ذَنُوبًا مِثْلَ ذَنُوبِ اَصْحَابِهِمْ فَلَا یَسْتَعْجِلُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33145,
            "SureId": 51,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "فَوَیْلٌ لِلَّذٖینَ كَفَرُوا مِنْ یَوْمِهِمُ الَّذٖی یُوعَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33152,
            "SureId": 52,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "وَالطُّورِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 52,
                "MealInfo": "Mekke döneminde inmiştir. 49 âyettir. Sûre, adını birinci âyette geçen <b>“etTûr”</b> kelimesinden almıştır. <b>Tûr, dağ demektir.</b> Burada <b>Hz. Mûsâ’</b>ya ilk vahyin geldiği, Sina Yarımadası’nın güneyindeki <b>Sina dağı</b> kastedilmektedir. Sûrede başlıca, <b>ahiret hâlleri, kâfirlerin karşılaşacakları ceza, mü’minlerin mükâfatları konu edilmekte ve müşriklerin Hz. Peygamber hakkındaki batıl iddiaları</b> reddedilmektedir.",
                "SureNameTurkish": "Tûr",
                "SureNameArabic": "الطُّورِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 76,
                "AyetCount": 49,
                "Cuz": 27,
                "FirstPage": 523,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33159,
            "SureId": 52,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "وَكِتَابٍ مَسْطُورٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33166,
            "SureId": 52,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "فٖی رَقٍّ مَنْشُورٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33173,
            "SureId": 52,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "وَالْبَیْتِ الْمَعْمُورِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33180,
            "SureId": 52,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "وَالسَّقْفِ الْمَرْفُوعِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33187,
            "SureId": 52,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "وَالْبَحْرِ الْمَسْجُورِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33194,
            "SureId": 52,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "اِنَّ عَذَابَ رَبِّكَ لَوَاقِـعٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33201,
            "SureId": 52,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "مَا لَهُ مِنْ دَافِـعٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33208,
            "SureId": 52,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "یَوْمَ تَمُورُ السَّمَٓاءُ مَوْرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33215,
            "SureId": 52,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "وَتَسٖیرُ الْجِبَالُ سَیْرًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33222,
            "SureId": 52,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "فَوَیْلٌ یَوْمَئِذٍ لِلْمُكَذِّبٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33229,
            "SureId": 52,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "اَلَّذٖینَ هُمْ فٖی خَوْضٍ یَلْعَبُونَۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33236,
            "SureId": 52,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "یَوْمَ یُدَعُّونَ اِلٰى نَارِ جَهَنَّمَ دَعًّاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33243,
            "SureId": 52,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "هٰذِهِ النَّارُ الَّتٖی كُنْتُمْ بِهَا تُكَذِّبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 33087,
            "SureId": 51,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "İşte böyle; kendilerinden öncekilere de hiçbir peygamber gelmemiştir ki, “O bir sihirbaz veya bir mecnun” demiş olmasınlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 51,
                "MealInfo": "Mekke döneminde inmiştir. 60 âyettir. Sûre, adını ilk âyette geçen <b>“ez-zâriyât” </b>kelimesinden almıştır.<b> Zâriyât, esip savuran rüzgârlar demektir.</b> Sûrede başlıca, <b>öldükten sonra hesap için toplanma, inkârcıların ahirette karşılaşacakları azap, mü’minlere verilecek mükâfatlar, Allah’ın varlığını ve birliğini gösteren kevni deliller</b> konu edilmektedir.",
                "SureNameTurkish": "Zâriyât",
                "SureNameArabic": "الذَّارِيَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 67,
                "AyetCount": 60,
                "Cuz": 26,
                "FirstPage": 520,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33094,
            "SureId": 51,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "Sanki nesiller boyu birbirlerine hep bunu tavsiye etmişler! Daha doğrusu onlar sınır tanımayan bir topluluk!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33101,
            "SureId": 51,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "Artık onlarla ilgilenme. Bundan dolayı (çağrına uymadılar diye) sen kınanacak değilsin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33108,
            "SureId": 51,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "Ama (alanlar için) öğüt vermeye devam et, zira öğüt inananlara fayda verir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33115,
            "SureId": 51,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "Ben cinleri ve insanları, başka değil, sırf bana kulluk etsinler diye yarattım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33122,
            "SureId": 51,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "Onlardan bir rızık istemiyorum, beni doyurmalarını da istiyor değilim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33129,
            "SureId": 51,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "Şüphesiz rızkı veren, sarsılmaz gücün sahibi olan yalnızca Allah’tır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33136,
            "SureId": 51,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "Şu iyi bilinmeli ki haksızlığa sapanlar için geçmişteki benzerlerinin payı gibi bir ceza payı var! Şimdi onu benden acele istemesinler!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33143,
            "SureId": 51,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "Başlarına geleceği bildirilen günden dolayı vay o inkârcıların haline!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33150,
            "SureId": 52,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1-8",
            "AyetVisible": true,
            "Page": 523,
            "AyetText": "Tûr’a, açık sahifeler üzerine yazılı kitaba, beyt-i ma‘mûra, yükseltilmiş tavana, kaynayan denize andolsun ki, rabbinin azabı mutlaka gerçekleşecektir; ona engel olabilecek yoktur!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 52,
                "MealInfo": "Mekke döneminde inmiştir. 49 âyettir. Sûre, adını birinci âyette geçen <b>“etTûr”</b> kelimesinden almıştır. <b>Tûr, dağ demektir.</b> Burada <b>Hz. Mûsâ’</b>ya ilk vahyin geldiği, Sina Yarımadası’nın güneyindeki <b>Sina dağı</b> kastedilmektedir. Sûrede başlıca, <b>ahiret hâlleri, kâfirlerin karşılaşacakları ceza, mü’minlerin mükâfatları konu edilmekte ve müşriklerin Hz. Peygamber hakkındaki batıl iddiaları</b> reddedilmektedir.",
                "SureNameTurkish": "Tûr",
                "SureNameArabic": "الطُّورِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 76,
                "AyetCount": 49,
                "Cuz": 27,
                "FirstPage": 523,
                "ExcludeMenu": false
            }
        },
