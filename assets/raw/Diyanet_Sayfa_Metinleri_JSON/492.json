    "QuranAyats": [
        {
            "Id": 30513,
            "SureId": 43,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "وَلِبُیُوتِهِمْ اَبْوَابًا وَسُرُرًا عَلَیْهَا یَتَّكِؤُ𐻿نَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 43,
                "MealInfo": "Mekke döneminde inmiştir. 89 âyettir. Sûre, adını 35. âyette geçen <b>“Zuhruf ” </b>kelimesinden almaktadır. <b>Zuhruf; yaldız, mücevher, dünya hayatının geçici menfaati anlamlarına gelir. </b>Sûrede başlıca tevhit, iman ve vahyin getirdiği hakikatler ile insanların bu hakikatlere ters düşecek şekilde sırf geçici dünya menfaatlerine bağlanarak sergiledikleri çelişki vurgulanmakta, batıla karşı çıkan ve hakkı tutan şahsiyetler olarak İbrahim, Mûsâ ve İsa Peygamberlerden söz edilmektedir.",
                "SureNameTurkish": "Zuhruf",
                "SureNameArabic": "الزُّخْرُفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 63,
                "AyetCount": 89,
                "Cuz": 25,
                "FirstPage": 489,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30520,
            "SureId": 43,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "وَزُخْرُفًاؕ وَاِنْ كُلُّ ذٰلِكَ لَمَّا مَتَاعُ الْحَیٰوةِ الدُّنْیَاؕ وَالْاٰخِرَةُ عِنْدَ رَبِّكَ لِلْمُتَّقٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30527,
            "SureId": 43,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "وَمَنْ یَعْشُ عَنْ ذِكْرِ الرَّحْمٰنِ نُقَیِّضْ لَهُ شَیْطَانًا فَهُوَ لَهُ قَرٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30534,
            "SureId": 43,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "وَاِنَّهُمْ لَیَصُدُّونَهُمْ عَنِ السَّبٖیلِ وَیَحْسَبُونَ اَنَّهُمْ مُهْتَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30541,
            "SureId": 43,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "حَتّٰٓى اِذَا جَٓاءَنَا قَالَ یَا لَیْتَ بَیْنٖی وَبَیْنَكَ بُعْدَ الْمَشْرِقَیْنِ فَبِئْسَ الْقَرٖینُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30548,
            "SureId": 43,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "وَلَنْ یَنْفَعَكُمُ الْیَوْمَ اِذْ ظَلَمْتُمْ اَنَّكُمْ فِی الْعَذَابِ مُشْتَرِكُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30555,
            "SureId": 43,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "اَفَاَنْتَ تُسْمِـعُ الصُّمَّ اَوْ تَهْدِی الْعُمْیَ وَمَنْ كَانَ فٖی ضَلَالٍ مُبٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30562,
            "SureId": 43,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "فَاِمَّا نَذْهَبَنَّ بِكَ فَاِنَّا مِنْهُمْ مُنْتَقِمُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30569,
            "SureId": 43,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "اَوْ نُرِیَنَّكَ الَّذٖی وَعَدْنَاهُمْ فَاِنَّا عَلَیْهِمْ مُقْتَدِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30576,
            "SureId": 43,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "فَاسْتَمْسِكْ بِالَّذٖٓی اُو𐻿حِیَ اِلَیْكَۚ اِنَّكَ عَلٰى صِرَاطٍ مُسْتَقٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30583,
            "SureId": 43,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "وَاِنَّهُ لَذِكْرٌ لَكَ وَلِقَوْمِكَۚ وَسَوْفَ تُسْـَٔلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30590,
            "SureId": 43,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "وَسْـَٔلْ مَنْ اَرْسَلْنَا مِنْ قَبْلِكَ مِنْ رُسُلِنَاࣗ اَجَعَلْنَا مِنْ دُونِ الرَّحْمٰنِ اٰلِهَةً یُعْبَدُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30597,
            "SureId": 43,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "وَلَقَدْ اَرْسَلْنَا مُوسٰى بِاٰیَاتِنَٓا اِلٰى فِرْعَوْنَ وَمَلَا𐻾ئِهٖ فَقَالَ اِنّٖی رَسُولُ رَبِّ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30604,
            "SureId": 43,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "فَلَمَّا جَٓاءَهُمْ بِاٰیَاتِنَٓا اِذَا هُمْ مِنْهَا یَضْحَكُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 30511,
            "SureId": 43,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34-35",
            "AyetVisible": true,
            "Page": 492,
            "AyetText": "(Ayrıca) evleri için kapılar, üzerlerinde yaslanıp istirahat edecekleri koltuklar yapar, altınla da süslerdik. Ama bunların hepsi dünya hayatına ait geçici faydalardan ibarettir, rabbinin katında âhiret (mutluluğu) ise takvâ sahiplerine mahsustur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 43,
                "MealInfo": "Mekke döneminde inmiştir. 89 âyettir. Sûre, adını 35. âyette geçen <b>“Zuhruf ” </b>kelimesinden almaktadır. <b>Zuhruf; yaldız, mücevher, dünya hayatının geçici menfaati anlamlarına gelir. </b>Sûrede başlıca tevhit, iman ve vahyin getirdiği hakikatler ile insanların bu hakikatlere ters düşecek şekilde sırf geçici dünya menfaatlerine bağlanarak sergiledikleri çelişki vurgulanmakta, batıla karşı çıkan ve hakkı tutan şahsiyetler olarak İbrahim, Mûsâ ve İsa Peygamberlerden söz edilmektedir.",
                "SureNameTurkish": "Zuhruf",
                "SureNameArabic": "الزُّخْرُفِ",
