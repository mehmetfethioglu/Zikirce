    "QuranAyats": [
        {
            "Id": 2905,
            "SureId": 3,
            "AyetId": 122,
            "LanguageId": 7,
            "AyetNumber": "١٢٢",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "اِذْ هَمَّتْ طَٓائِفَتَانِ مِنْكُمْ اَنْ تَفْشَلَاۙ وَاللّٰهُ وَلِیُّهُمَاؕ وَعَلَى اللّٰهِ فَلْیَتَوَكَّلِ الْمُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 2912,
            "SureId": 3,
            "AyetId": 123,
            "LanguageId": 7,
            "AyetNumber": "١٢٣",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "وَلَقَدْ نَصَرَكُمُ اللّٰهُ بِبَدْرٍ وَاَنْتُمْ اَذِلَّةٌۚ فَاتَّقُوا اللّٰهَ لَعَلَّكُمْ تَشْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2919,
            "SureId": 3,
            "AyetId": 124,
            "LanguageId": 7,
            "AyetNumber": "١٢٤",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "اِذْ تَقُولُ لِلْمُؤْمِنٖینَ اَلَنْ یَكْفِیَكُمْ اَنْ یُمِدَّكُمْ رَبُّكُمْ بِثَلٰثَةِ اٰلَافٍ مِنَ الْمَلٰٓئِكَةِ مُنْزَلٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2926,
            "SureId": 3,
            "AyetId": 125,
            "LanguageId": 7,
            "AyetNumber": "١٢٥",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "بَلٰٓىۙ اِنْ تَصْبِرُوا وَتَتَّقُوا وَیَاْتُوكُمْ مِنْ فَوْرِهِمْ هٰذَا یُمْدِدْكُمْ رَبُّكُمْ بِخَمْسَةِ اٰلَافٍ مِنَ الْمَلٰٓئِكَةِ مُسَوِّمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2933,
            "SureId": 3,
            "AyetId": 126,
            "LanguageId": 7,
            "AyetNumber": "١٢٦",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "وَمَا جَعَلَهُ اللّٰهُ اِلَّا بُشْرٰى لَكُمْ وَلِتَطْمَئِنَّ قُلُوبُكُمْ بِهٖؕ وَمَا النَّصْرُ اِلَّا مِنْ عِنْدِ اللّٰهِ الْعَزٖیزِ الْحَكٖیمِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2940,
            "SureId": 3,
            "AyetId": 127,
            "LanguageId": 7,
            "AyetNumber": "١٢٧",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "لِیَقْطَعَ طَرَفًا مِنَ الَّذٖینَ كَفَرُٓوا اَوْ یَكْبِتَهُمْ فَیَنْقَلِبُوا خَٓائِبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2947,
            "SureId": 3,
            "AyetId": 128,
            "LanguageId": 7,
            "AyetNumber": "١٢٨",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "لَیْسَ لَكَ مِنَ الْاَمْرِ شَیْءٌ اَوْ یَتُوبَ عَلَیْهِمْ اَوْ یُعَذِّبَهُمْ فَاِنَّهُمْ ظَالِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2954,
            "SureId": 3,
            "AyetId": 129,
            "LanguageId": 7,
            "AyetNumber": "١٢٩",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "وَلِلّٰهِ مَا فِی السَّمٰوَاتِ وَمَا فِی الْاَرْضِؕ یَغْفِرُ لِمَنْ یَشَٓاءُ وَیُعَذِّبُ مَنْ یَشَٓاءُؕ وَاللّٰهُ غَفُورٌ رَحٖیمٌࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2961,
            "SureId": 3,
            "AyetId": 130,
            "LanguageId": 7,
            "AyetNumber": "١٣٠",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "یَٓا اَیُّهَا الَّذٖینَ اٰمَنُوا لَا تَاْكُلُوا الرِّبٰٓوا اَضْعَافًا مُضَاعَفَةًࣕ وَاتَّقُوا اللّٰهَ لَعَلَّكُمْ تُفْلِحُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2968,
            "SureId": 3,
            "AyetId": 131,
            "LanguageId": 7,
            "AyetNumber": "١٣١",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "وَاتَّقُوا النَّارَ الَّتٖٓی اُعِدَّتْ لِلْكَافِرٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2975,
            "SureId": 3,
            "AyetId": 132,
            "LanguageId": 7,
            "AyetNumber": "١٣٢",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "وَاَطٖیعُوا اللّٰهَ وَالرَّسُولَ لَعَلَّكُمْ تُرْحَمُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 2903,
            "SureId": 3,
            "AyetId": 122,
            "LanguageId": 5,
            "AyetNumber": "122",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "O zaman sizden iki bölük, Allah onların velîsi olduğu halde bozulup çekilmeye yüz tutmuştu; müminler yalnız Allah’a güvensinler.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 2910,
            "SureId": 3,
            "AyetId": 123,
            "LanguageId": 5,
            "AyetNumber": "123",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "Andolsun ki Allah size, zayıf ve çaresiz iken Bedir’de de yardım etmişti. Allah’a isyandan sakının ki şükretmiş olasınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2917,
            "SureId": 3,
            "AyetId": 124,
            "LanguageId": 5,
            "AyetNumber": "124",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "O zaman inananlara şöyle diyordun: “Rabbinizin, indirilen üç bin melekle size yardım etmesi sizin için yeterli değil mi?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2924,
            "SureId": 3,
            "AyetId": 125,
            "LanguageId": 5,
            "AyetNumber": "125",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "Evet, eğer siz sabır gösterip itaatsizlikten sakınırsanız, onlar şu anda süratle üzerinize gelseler bile rabbiniz size nişanlı beş bin melekle yardım edecektir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2931,
            "SureId": 3,
            "AyetId": 126,
            "LanguageId": 5,
            "AyetNumber": "126",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "Allah bunu, sırf size bir müjde olsun ve bununla kalpleriniz yatışsın diye yapmıştır. Zafer, yalnız güçlü ve hikmet sahibi Allah katından gelir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2938,
            "SureId": 3,
            "AyetId": 127,
            "LanguageId": 5,
            "AyetNumber": "127",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "(Allah bu yardımı) inkâr edenlerin bir kısmını helâk etmek veya onları ümitsiz olarak geri dönecek şekilde bozguna uğratmak için (yapmıştır).",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2945,
            "SureId": 3,
            "AyetId": 128,
            "LanguageId": 5,
            "AyetNumber": "128",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "(Resulüm!) Bu işte senin yapacağın bir şey yok. Allah ya onların tövbelerini kabul eder veya onları cezalandırır. Çünkü onlar zalimlerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2952,
            "SureId": 3,
            "AyetId": 129,
            "LanguageId": 5,
            "AyetNumber": "129",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "Göklerde ve yerde ne varsa hepsi Allah’ındır. Dilediğini bağışlar dilediğine azap eder. Allah bağışlayandır, merhamet edendir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2959,
            "SureId": 3,
            "AyetId": 130,
            "LanguageId": 5,
            "AyetNumber": "130",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "Ey iman edenler! Kat kat faiz yemeyin. Allah’a itaatsizlikten sakının ki kurtuluşa eresiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2966,
            "SureId": 3,
            "AyetId": 131,
            "LanguageId": 5,
            "AyetNumber": "131",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "Kâfirler için hazırlanmış ateşten sakının.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2973,
            "SureId": 3,
            "AyetId": 132,
            "LanguageId": 5,
            "AyetNumber": "132",
            "AyetVisible": true,
            "Page": 66,
            "AyetText": "Allah’a ve peygambere itaat edin ki rahmete erdirilesiniz.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Âl-i İmrân",
    "QuranSureLabel": "اٰلِ عِمْرٰنَ",
    "EndPageSure": null
