            "AyetNumber": "٨٤",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "اِنَّا مَكَّنَّا لَهُ فِی الْاَرْضِ وَاٰتَیْنَاهُ مِنْ كُلِّ شَیْءٍ سَبَبًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 18,
                "MealInfo": "Mekke döneminde inmiştir. 28. âyetin Medine döneminde indiği de rivayet edilmiştir. 110 âyettir. Sûre, adını; ilk defa dokuzuncu âyette olmak üzere,birkaç yerde geçen <b>“kehf ”</b> kelimesinden almıştır.<b> Kehf, mağara demektir</b>. Sûre de temel konu olarak, inançları sebebiyle öldürülmekten kurtulmak için bir mağaraya sığınan gençlerin mucizevî hâlleri, ayrıca <b>Hz. Mûsâ</b> ile <b>Zülkarneyn&nbsp;</b>konu edilmektedir.",
                "SureNameTurkish": "Kehf",
                "SureNameArabic": "الْكَهْفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 69,
                "AyetCount": 110,
                "Cuz": 15,
                "FirstPage": 293,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 15575,
            "SureId": 18,
            "AyetId": 85,
            "LanguageId": 7,
            "AyetNumber": "٨٥",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "فَاَتْبَعَ سَبَبًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15582,
            "SureId": 18,
            "AyetId": 86,
            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "حَتّٰٓى اِذَا بَلَغَ مَغْرِبَ الشَّمْسِ وَجَدَهَا تَغْرُبُ فٖی عَیْنٍ حَمِئَةٍ وَوَجَدَ عِنْدَهَا قَوْمًاؕ قُلْنَا یَا ذَا الْقَرْنَیْنِ اِمَّٓا اَنْ تُعَذِّبَ وَاِمَّٓا اَنْ تَتَّخِذَ فٖیهِمْ حُسْنًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15589,
            "SureId": 18,
            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "قَالَ اَمَّا مَنْ ظَلَمَ فَسَوْفَ نُعَذِّبُهُ ثُمَّ یُرَدُّ اِلٰى رَبِّهٖ فَیُعَذِّبُهُ عَذَابًا نُكْرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15596,
            "SureId": 18,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "وَاَمَّا مَنْ اٰمَنَ وَعَمِلَ صَالِحًا فَلَهُ جَزَٓاءًࣙ الْحُسْنٰىۚ وَسَنَقُولُ لَهُ مِنْ اَمْرِنَا یُسْرًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15603,
            "SureId": 18,
            "AyetId": 89,
            "LanguageId": 7,
            "AyetNumber": "٨٩",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "ثُمَّ اَتْبَعَ سَبَبًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15610,
            "SureId": 18,
            "AyetId": 90,
            "LanguageId": 7,
            "AyetNumber": "٩٠",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "حَتّٰٓى اِذَا بَلَغَ مَطْلِعَ الشَّمْسِ وَجَدَهَا تَطْلُعُ عَلٰى قَوْمٍ لَمْ نَجْعَلْ لَهُمْ مِنْ دُونِهَا سِتْرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15617,
            "SureId": 18,
            "AyetId": 91,
            "LanguageId": 7,
            "AyetNumber": "٩١",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "كَذٰلِكَؕ وَقَدْ اَحَطْنَا بِمَا لَدَیْهِ خُبْرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15624,
            "SureId": 18,
            "AyetId": 92,
            "LanguageId": 7,
            "AyetNumber": "٩٢",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "ثُمَّ اَتْبَعَ سَبَبًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15631,
            "SureId": 18,
            "AyetId": 93,
            "LanguageId": 7,
            "AyetNumber": "٩٣",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "حَتّٰٓى اِذَا بَلَغَ بَیْنَ السَّدَّیْنِ وَجَدَ مِنْ دُونِهِمَا قَوْمًاۙ لَا یَكَادُونَ یَفْقَهُونَ قَوْلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15638,
            "SureId": 18,
            "AyetId": 94,
            "LanguageId": 7,
            "AyetNumber": "٩٤",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "قَالُوا یَا ذَا الْقَرْنَیْنِ اِنَّ یَاْجُوجَ وَمَاْجُوجَ مُفْسِدُونَ فِی الْاَرْضِ فَهَلْ نَجْعَلُ لَكَ خَرْجًا عَلٰٓى اَنْ تَجْعَلَ بَیْنَنَا وَبَیْنَهُمْ سَدًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15645,
            "SureId": 18,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "قَالَ مَا مَكَّنّٖی فٖیهِ رَبّٖی خَیْرٌ فَاَعٖینُونٖی بِقُوَّةٍ اَجْعَلْ بَیْنَكُمْ وَبَیْنَهُمْ رَدْمًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15652,
            "SureId": 18,
            "AyetId": 96,
            "LanguageId": 7,
            "AyetNumber": "٩٦",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "اٰتُونٖی زُبَرَ الْحَدٖیدِؕ حَتّٰٓى اِذَا سَاوٰى بَیْنَ الصَّدَفَیْنِ قَالَ انْفُخُواؕ حَتّٰٓى اِذَا جَعَلَهُ نَارًاۙ قَالَ اٰتُونٖٓی اُفْرِغْ عَلَیْهِ قِطْرًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15659,
            "SureId": 18,
            "AyetId": 97,
            "LanguageId": 7,
            "AyetNumber": "٩٧",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "فَمَا اسْطَاعُٓوا اَنْ یَظْهَرُوهُ وَمَا اسْتَطَاعُوا لَهُ نَقْبًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 15566,
            "SureId": 18,
            "AyetId": 84,
            "LanguageId": 5,
            "AyetNumber": "84",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "Gerçekten biz onu yeryüzünde iktidar sahibi kıldık, ona (muhtaç olduğu) her şey için bir yol öğrettik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 18,
                "MealInfo": "Mekke döneminde inmiştir. 28. âyetin Medine döneminde indiği de rivayet edilmiştir. 110 âyettir. Sûre, adını; ilk defa dokuzuncu âyette olmak üzere,birkaç yerde geçen <b>“kehf ”</b> kelimesinden almıştır.<b> Kehf, mağara demektir</b>. Sûre de temel konu olarak, inançları sebebiyle öldürülmekten kurtulmak için bir mağaraya sığınan gençlerin mucizevî hâlleri, ayrıca <b>Hz. Mûsâ</b> ile <b>Zülkarneyn&nbsp;</b>konu edilmektedir.",
                "SureNameTurkish": "Kehf",
                "SureNameArabic": "الْكَهْفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 69,
                "AyetCount": 110,
                "Cuz": 15,
                "FirstPage": 293,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 15573,
            "SureId": 18,
            "AyetId": 85,
            "LanguageId": 5,
            "AyetNumber": "85",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "O da bir yol tutup gitti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15580,
            "SureId": 18,
            "AyetId": 86,
            "LanguageId": 5,
            "AyetNumber": "86",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "Nihayet güneşin battığı yere varınca, onu kara bir balçıkta batar (gibi) buldu. Orada bir kavme rastladı. Bunun üzerine biz, “Ey Zülkarneyn! Onları ya cezalandıracak veya haklarında iyi davranma yolunu seçeceksin” dedik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15587,
            "SureId": 18,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "O, şöyle dedi: “Haksızlık edeni cezalandıracağız; sonra o, rabbine gönderilecek; Allah da ona korkunç bir azap uygulayacak.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15594,
            "SureId": 18,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "İman edip iyi şeyler yapan kimseye gelince, onun için de en güzel karşılık vardır. Ve ona işimizden kolay olanını buyuracağız.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15601,
            "SureId": 18,
            "AyetId": 89,
            "LanguageId": 5,
            "AyetNumber": "89",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "Sonra yine bir yol tutup gitti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15608,
            "SureId": 18,
            "AyetId": 90,
            "LanguageId": 5,
            "AyetNumber": "90",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "Nihayet güneşin doğduğu yere ulaşınca, onu öyle bir kavim üzerine doğar buldu ki, onlar için güneşe karşı bir örtü yapmamıştık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15615,
            "SureId": 18,
            "AyetId": 91,
            "LanguageId": 5,
            "AyetNumber": "91",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "İşte böyle oldu! Biz onunla ilgili her şeyi ayrıntısıyla biliyorduk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15622,
            "SureId": 18,
            "AyetId": 92,
            "LanguageId": 5,
            "AyetNumber": "92",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "Sonra yine bir yol tuttu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15629,
            "SureId": 18,
            "AyetId": 93,
            "LanguageId": 5,
            "AyetNumber": "93",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "Nihayet iki dağ arasına ulaştığında bunların ötesinde nerede ise hiçbir sözü anlamayan bir kavim buldu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15636,
            "SureId": 18,
            "AyetId": 94,
            "LanguageId": 5,
            "AyetNumber": "94",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "Dediler ki: “Ey Zülkarneyn! Bu memlekette Ye’cûc ve Me’cûc bozgunculuk yapmaktadırlar. Bizimle onlar arasında bir sed yapman için sana bir bedel ödesek kabul eder misin?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15643,
            "SureId": 18,
            "AyetId": 95,
            "LanguageId": 5,
            "AyetNumber": "95",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "Zülkarneyn şöyle cevap verdi: “Rabbimin beni içinde bulundurduğu nimet ve kudret sizinkinden üstündür. Siz bana kuvvetinizle destek olun da, sizinle onlar arasına aşılmaz bir engel yapayım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15650,
            "SureId": 18,
            "AyetId": 96,
            "LanguageId": 5,
            "AyetNumber": "96",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "Bana, demir kütleleri getirin.” Nihayet (vadiyi demirle doldurup) iki dağın arasını aynı seviyeye getirince, “Ateşi körükleyin!” dedi. Artık onu kor haline getirdiği vakit, “Getirin bana, üzerine bir miktar erimiş bakır dökeyim” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15657,
            "SureId": 18,
            "AyetId": 97,
            "LanguageId": 5,
            "AyetNumber": "97",
            "AyetVisible": true,
            "Page": 303,
            "AyetText": "Artık onu ne aşabildiler ne de delebildiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
