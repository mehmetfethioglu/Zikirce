            "AyetVisible": true,
            "Page": 593,
            "AyetText": "On geceye;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41970,
            "SureId": 89,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 593,
            "AyetText": "Çift olana ve tek olana;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41977,
            "SureId": 89,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 593,
            "AyetText": "Geçip gitmekte olan geceye.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41984,
            "SureId": 89,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 593,
            "AyetText": "Aklı olan kimse için bunlar yemine konu olacak kadar önemli değil midir?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41991,
            "SureId": 89,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 593,
            "AyetText": "Görmedin mi, rabbin ne yaptı Âd kavmine;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41998,
            "SureId": 89,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7-8",
            "AyetVisible": true,
            "Page": 593,
            "AyetText": "Ülkeler içinde benzeri yaratılmamış olan, sütunlarla dolu İrem’e;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42005,
            "SureId": 89,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": false,
            "Page": 593,
            "AyetText": "Ülkeler içinde benzeri yaratılmamış olan, sütunlarla dolu İrem’e;",
