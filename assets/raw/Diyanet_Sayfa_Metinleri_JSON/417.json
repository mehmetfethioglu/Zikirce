{
    "PointerList": null,
    "CuzNo": 21,
    "PageNo": 417,
    "ArCuzNo": "۲۱",
    "ArPageNo": "٤۱۷",
    "QuranAyats": [
        {
            "Id": 24668,
            "SureId": 32,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "وَلَنُذٖیقَنَّهُمْ مِنَ الْعَذَابِ الْاَدْنٰى دُونَ الْعَذَابِ الْاَكْبَرِ لَعَلَّهُمْ یَرْجِعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 32,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. <b>Sûre, adını mü’minlerin Allah’a secde etmelerinden bahseden 15. âyetten almıştır</b>. Sûrede ayrıca Allah’ın kudretinden,ahiret gününden, kitaplardan, peygamberlerden ve insanın yaratılışından söz edilmektedir.",
                "SureNameTurkish": "Secde",
                "SureNameArabic": "السَّجْدَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 75,
                "AyetCount": 30,
                "Cuz": 21,
                "FirstPage": 415,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 24675,
            "SureId": 32,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "وَمَنْ اَظْلَمُ مِمَّنْ ذُكِّرَ بِاٰیَاتِ رَبِّهٖ ثُمَّ اَعْرَضَ عَنْهَاؕ اِنَّا مِنَ الْمُجْرِمٖینَ مُنْتَقِمُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24682,
            "SureId": 32,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "وَلَقَدْ اٰتَیْنَا مُوسَى الْكِتَابَ فَلَا تَكُنْ فٖی مِرْیَةٍ مِنْ لِقَٓائِهٖ وَجَعَلْنَاهُ هُدًى لِبَنٖٓی اِسْرَٓایٖٔلَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24689,
            "SureId": 32,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "وَجَعَلْنَا مِنْهُمْ اَئِمَّةً یَهْدُونَ بِاَمْرِنَا لَمَّا صَبَرُواؕ وَكَانُوا بِاٰیَاتِنَا یُوقِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24696,
            "SureId": 32,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "اِنَّ رَبَّكَ هُوَ یَفْصِلُ بَیْنَهُمْ یَوْمَ الْقِیٰمَةِ فٖیمَا كَانُوا فٖیهِ یَخْتَلِفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24703,
            "SureId": 32,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "اَوَلَمْ یَهْدِ لَهُمْ كَمْ اَهْلَكْنَا مِنْ قَبْلِهِمْ مِنَ الْقُرُونِ یَمْشُونَ فٖی مَسَاكِنِهِمْؕ اِنَّ فٖی ذٰلِكَ لَاٰیَاتٍؕ اَفَلَا یَسْمَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24710,
            "SureId": 32,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "اَوَلَمْ یَرَوْا اَنَّا نَسُوقُ الْمَٓاءَ اِلَى الْاَرْضِ الْجُرُزِ فَنُخْرِجُ بِهٖ زَرْعًا تَاْكُلُ مِنْهُ اَنْعَامُهُمْ وَاَنْفُسُهُمْؕ اَفَلَا یُبْصِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24717,
            "SureId": 32,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "وَیَقُولُونَ مَتٰى هٰذَا الْفَتْحُ اِنْ كُنْتُمْ صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24724,
            "SureId": 32,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "قُلْ یَوْمَ الْفَتْحِ لَا یَنْفَعُ الَّذٖینَ كَفَرُٓوا اٖیمَانُهُمْ وَلَا هُمْ یُنْظَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24731,
            "SureId": 32,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "فَاَعْرِضْ عَنْهُمْ وَانْتَظِرْ اِنَّهُمْ مُنْتَظِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 24666,
            "SureId": 32,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "Belki dönüş yaparlar diye, onlara o büyük azaptan önce daha yakın azaptan muhakkak tattıracağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 32,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. <b>Sûre, adını mü’minlerin Allah’a secde etmelerinden bahseden 15. âyetten almıştır</b>. Sûrede ayrıca Allah’ın kudretinden,ahiret gününden, kitaplardan, peygamberlerden ve insanın yaratılışından söz edilmektedir.",
                "SureNameTurkish": "Secde",
                "SureNameArabic": "السَّجْدَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 75,
                "AyetCount": 30,
                "Cuz": 21,
                "FirstPage": 415,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 24673,
            "SureId": 32,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "Kendisine rabbinin âyetleri hatırlatıldıktan sonra onlardan yüz çevirenden daha zalim kim olabilir? Biz, günahkârlara lâyık oldukları cezayı mutlaka veririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24680,
            "SureId": 32,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "Andolsun biz Mûsâ’ya kitabı vermiştik; ona kavuşma hakkında şüphen olmasın ve biz onu İsrâiloğulları için kılavuz yapmıştık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24687,
            "SureId": 32,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "Sabredip âyetlerimize kesin olarak iman ettikleri zaman, onların içinden, buyruğumuzla doğru yolu gösteren rehberler çıkardık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24694,
            "SureId": 32,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "Muhakkak ki rabbin, ihtilâf edip durdukları hususlarda kıyamet günü onların arasında hükmünü verecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24701,
            "SureId": 32,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "Halen yurtlarında gezip dolaştıkları, kendilerinden önceki nice nesilleri yok etmiş olmamız, onların doğru yolu görmelerini sağlamadı mı? Bunlarda elbette ibretler var. Hâlâ kulak vermeyecekler mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24708,
            "SureId": 32,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "Görmediler mi ki biz, kupkuru yerlere suyu ulaştırıyoruz da onunla gerek hayvanlarının gerekse kendilerinin yediği ekini çıkarıyoruz. Hâlâ ibret gözüyle bakmayacaklar mı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24715,
            "SureId": 32,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "“Eğer söylediğiniz doğru ise bu hüküm ne zaman?” diye soruyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24722,
            "SureId": 32,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "De ki: “İnkâr edenlere o hüküm günü inanmaları fayda vermeyecek ve kendilerine mühlet de tanınmayacak!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24729,
            "SureId": 32,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 417,
            "AyetText": "Artık sen onlara aldırma ve bekle. Zaten onlar da bekliyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
