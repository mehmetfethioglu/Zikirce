    "QuranAyats": [
        {
            "Id": 37905,
            "SureId": 70,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "فَلَٓا اُقْسِمُ بِرَبِّ الْمَشَارِقِ وَالْمَغَارِبِ اِنَّا لَقَادِرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 70,
                "MealInfo": "Mekke döneminde inmiştir. 44 âyettir. Sûre, adını üçüncü âyetteki “elMe’âric”kelimesinden almıştır. Me’âric, yükselme yolları demektir. Sûredebaşlıca, Mekke müşriklerinin inkâr, inat ve azgınlıkları, insan tabiatının bazıyönleri, ölüm ötesi hayatın gerçekliği konu edilmektedir",
                "SureNameTurkish": "Meâric",
                "SureNameArabic": "الْمَعَارِجِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 79,
                "AyetCount": 44,
                "Cuz": 29,
                "FirstPage": 568,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37912,
            "SureId": 70,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "عَلٰٓى اَنْ نُبَدِّلَ خَیْرًا مِنْهُمْۙ وَمَا نَحْنُ بِمَسْبُوقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37919,
            "SureId": 70,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "فَذَرْهُمْ یَخُوضُوا وَیَلْعَبُوا حَتّٰى یُلَاقُوا یَوْمَهُمُ الَّذٖی یُوعَدُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37926,
            "SureId": 70,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "یَوْمَ یَخْرُجُونَ مِنَ الْاَجْدَاثِ سِرَاعًا كَاَنَّهُمْ اِلٰى نُصُبٍ یُوفِضُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37933,
            "SureId": 70,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "خَاشِعَةً اَبْصَارُهُمْ تَرْهَقُهُمْ ذِلَّةٌؕ ذٰلِكَ الْیَوْمُ الَّذٖی كَانُوا یُوعَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37940,
            "SureId": 71,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "اِنَّٓا اَرْسَلْنَا نُوحًا اِلٰى قَوْمِهٖٓ اَنْ اَنْذِرْ قَوْمَكَ مِنْ قَبْلِ اَنْ یَاْتِیَهُمْ عَذَابٌ اَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 71,
                "MealInfo": "Mekke döneminde inmiştir. 28 âyettir. Sûrede başlıca, Nûh peygamberin mücadeleleri ve Nûh Tufanı konu edilmektedir. Sûre, adını konusundan almıştır.",
                "SureNameTurkish": "Nûh",
                "SureNameArabic": "نُوحٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 71,
                "AyetCount": 28,
                "Cuz": 29,
                "FirstPage": 570,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37947,
            "SureId": 71,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "قَالَ یَا قَوْمِ اِنّٖی لَكُمْ نَذٖیرٌ مُبٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37954,
            "SureId": 71,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "اَنِ اعْبُدُوا اللّٰهَ وَاتَّقُوهُ وَاَطٖیعُونِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37961,
            "SureId": 71,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "یَغْفِرْ لَكُمْ مِنْ ذُنُوبِكُمْ وَیُؤَخِّرْكُمْ اِلٰٓى اَجَلٍ مُسَمًّىؕ اِنَّ اَجَلَ اللّٰهِ اِذَا جَٓاءَ لَا یُؤَخَّرُۘ لَوْ كُنْتُمْ تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37968,
            "SureId": 71,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "قَالَ رَبِّ اِنّٖی دَعَوْتُ قَوْمٖی لَیْلًا وَنَهَارًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37975,
            "SureId": 71,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "فَلَمْ یَزِدْهُمْ دُعَٓاءٖٓی اِلَّا فِرَارًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37982,
            "SureId": 71,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "وَاِنّٖی كُلَّمَا دَعَوْتُهُمْ لِتَغْفِرَ لَهُمْ جَعَلُٓوا اَصَابِعَهُمْ فٖٓی اٰذَانِهِمْ وَاسْتَغْشَوْا ثِیَابَهُمْ وَاَصَرُّوا وَاسْتَكْبَرُوا اسْتِكْبَارًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37989,
            "SureId": 71,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "ثُمَّ اِنّٖی دَعَوْتُهُمْ جِهَارًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37996,
            "SureId": 71,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "ثُمَّ اِنّٖٓی اَعْلَنْتُ لَهُمْ وَاَسْرَرْتُ لَهُمْ اِسْرَارًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38003,
            "SureId": 71,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "فَقُلْتُ اسْتَغْفِرُوا رَبَّكُمْ اِنَّهُ كَانَ غَفَّارًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 37903,
            "SureId": 70,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40-41",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "Doğuların ve batıların rabbine yemin ederim ki, onların yerine daha iyilerini getirmeye bizim gücümüz yeter, kimse bizim önümüze geçemez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 70,
                "MealInfo": "Mekke döneminde inmiştir. 44 âyettir. Sûre, adını üçüncü âyetteki “elMe’âric”kelimesinden almıştır. Me’âric, yükselme yolları demektir. Sûredebaşlıca, Mekke müşriklerinin inkâr, inat ve azgınlıkları, insan tabiatının bazıyönleri, ölüm ötesi hayatın gerçekliği konu edilmektedir",
                "SureNameTurkish": "Meâric",
                "SureNameArabic": "الْمَعَارِجِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 79,
                "AyetCount": 44,
                "Cuz": 29,
                "FirstPage": 568,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37910,
            "SureId": 70,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": false,
            "Page": 570,
            "AyetText": "Doğuların ve batıların rabbine yemin ederim ki, onların yerine daha iyilerini getirmeye bizim gücümüz yeter, kimse bizim önümüze geçemez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37917,
            "SureId": 70,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "Bırak onları, kendilerine geleceği hususunda uyarıldıkları güne ulaşıncaya kadar boş şeylere dalıp oyalanadursunlar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37924,
            "SureId": 70,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "O gün onlar, bir hedefe çabucak varmak istercesine süratle kabirlerinden çıkarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37931,
            "SureId": 70,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "O sırada gözlerine korku çökmüş, perişan olmuşlardır. İşte başlarına geleceği konusunda uyarıldıkları gün o gündür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37938,
            "SureId": 71,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "Biz Nûh’u, “Kendilerine can yakıcı bir azap gelmeden önce halkını uyar” diyerek kavmine gönderdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 71,
                "MealInfo": "Mekke döneminde inmiştir. 28 âyettir. Sûrede başlıca, Nûh peygamberin mücadeleleri ve Nûh Tufanı konu edilmektedir. Sûre, adını konusundan almıştır.",
                "SureNameTurkish": "Nûh",
                "SureNameArabic": "نُوحٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 71,
                "AyetCount": 28,
                "Cuz": 29,
                "FirstPage": 570,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37945,
            "SureId": 71,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "Şöyle dedi: “Ey kavmim! Şüphesiz ben size gönderilmiş apaçık bir uyarıcıyım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37952,
            "SureId": 71,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "Allah’a kulluk edin; O’na karşı gelmekten sakının ve bana itaat edin;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37959,
            "SureId": 71,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "Ki Allah bir kısım günahlarınızı bağışlasın ve size belirli bir vadeye kadar süre tanısın. Şüphesiz Allah’ın belirlediği vade geldiğinde artık ertelenmez. Keşke ­bilseydiniz!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37966,
            "SureId": 71,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "Nûh, “Rabbim” dedi, “Doğrusu ben kavmimi gece gündüz hakka çağırdım;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37973,
            "SureId": 71,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "Fakat benim çağrım sadece kaçışlarını arttırdı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37980,
            "SureId": 71,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "Kendilerini bağışlaman için ben onları ne zaman çağırdıysam, parmaklarını kulaklarına tıkadılar; elbiselerini başlarına bürüdüler, ayak dirediler, kibirlendikçe kibirlendiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37987,
            "SureId": 71,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "Yine de ben onları açıkça çağırmaya devam ettim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37994,
            "SureId": 71,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "Onlara açık da söyledim, yerine göre gizli de söyledim.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38001,
            "SureId": 71,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 570,
            "AyetText": "Dedim ki: “Rabbinizden bağışlanmanızı dileyin; O, çok bağışlayıcıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
