    "QuranAyats": [
        {
            "Id": 20531,
            "SureId": 26,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "طٰسٓمٓؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20538,
            "SureId": 26,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "تِلْكَ اٰیَاتُ الْكِتَابِ الْمُبٖینِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20545,
            "SureId": 26,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "لَعَلَّكَ بَاخِعٌ نَفْسَكَ اَلَّا یَكُونُوا مُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20552,
            "SureId": 26,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "اِنْ نَشَاْ نُنَزِّلْ عَلَیْهِمْ مِنَ السَّمَٓاءِ اٰیَةً فَظَلَّتْ اَعْنَاقُهُمْ لَهَا خَاضِعٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20559,
            "SureId": 26,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "وَمَا یَاْتٖیهِمْ مِنْ ذِكْرٍ مِنَ الرَّحْمٰنِ مُحْدَثٍ اِلَّا كَانُوا عَنْهُ مُعْرِضٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20566,
            "SureId": 26,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "فَقَدْ كَذَّبُوا فَسَیَاْتٖیهِمْ اَنْبٰٓؤُ𐻾ا مَا كَانُوا بِهٖ یَسْتَهْزِؤُ𐻿نَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20573,
            "SureId": 26,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "اَوَلَمْ یَرَوْا اِلَى الْاَرْضِ كَمْ اَنْبَتْنَا فٖیهَا مِنْ كُلِّ زَوْجٍ كَرٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20580,
            "SureId": 26,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "اِنَّ فٖی ذٰلِكَ لَاٰیَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20587,
            "SureId": 26,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "وَاِنَّ رَبَّكَ لَهُوَ الْعَزٖیزُ الرَّحٖیمُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20594,
            "SureId": 26,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "وَاِذْ نَادٰى رَبُّكَ مُوسٰٓى اَنِ ائْتِ الْقَوْمَ الظَّالِمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20601,
            "SureId": 26,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "قَوْمَ فِرْعَوْنَؕ اَلَا یَتَّقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20608,
            "SureId": 26,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "قَالَ رَبِّ اِنّٖٓی اَخَافُ اَنْ یُكَذِّبُونِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20615,
            "SureId": 26,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "وَیَضٖیقُ صَدْرٖی وَلَا یَنْطَلِقُ لِسَانٖی فَاَرْسِلْ اِلٰى هٰرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20622,
            "SureId": 26,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "وَلَهُمْ عَلَیَّ ذَنْبٌ فَاَخَافُ اَنْ یَقْتُلُونِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20629,
            "SureId": 26,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "قَالَ كَلَّاۚ فَاذْهَبَا بِاٰیَاتِنَٓا اِنَّا مَعَكُمْ مُسْتَمِعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20636,
            "SureId": 26,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "فَاْتِیَا فِرْعَوْنَ فَقُولَٓا اِنَّا رَسُولُ رَبِّ الْعَالَمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20643,
            "SureId": 26,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "اَنْ اَرْسِلْ مَعَنَا بَنٖٓی اِسْرَٓایٖٔلَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20650,
            "SureId": 26,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "قَالَ اَلَمْ نُرَبِّكَ فٖینَا وَلٖیدًا وَلَبِثْتَ فٖینَا مِنْ عُمُرِكَ سِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20657,
            "SureId": 26,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "وَفَعَلْتَ فَعْلَتَكَ الَّتٖی فَعَلْتَ وَاَنْتَ مِنَ الْكَافِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 20529,
            "SureId": 26,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Tâ-sîn-mîm.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20536,
            "SureId": 26,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Bunlar, apaçık kitabın âyetleridir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20543,
            "SureId": 26,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "İman etmiyorlar diye neredeyse kendini helâk edeceksin!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20550,
            "SureId": 26,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Biz istesek onlara gökten bir mûcize indiririz de derhal ona boyun eğerler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20557,
            "SureId": 26,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Ne zaman Rahmân’dan kendilerine yeni bir uyarı gelse mutlaka bundan yüz ­çevirmektedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20564,
            "SureId": 26,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Hep yalanladılar, fakat alay edip durdukları şeylere ait bilgiler yakında onlara gelecektir!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20571,
            "SureId": 26,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Peki o inkârcılar yeryüzüne hiç bakmazlar mı? Orada her türden nice değerli bitkiler çıkarmışızdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20578,
            "SureId": 26,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Şüphesiz bunlarda alınacak büyük bir ders vardır; ama çoğu iman etmezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20585,
            "SureId": 26,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Şüphesiz rabbin, işte O, mutlak güçlüdür, engin merhamet sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20592,
            "SureId": 26,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10-11",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Hani rabbin Mûsâ’ya, şöyle seslenmişti: “O zalimler topluluğuna, Firavun’un kavmine git. Onlar (zulümden) hâlâ sakınmayacaklar mı?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20599,
            "SureId": 26,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": false,
            "Page": 367,
            "AyetText": "Hani rabbin Mûsâ’ya, şöyle seslenmişti: \"O zalimler topluluğuna, Firavun’un kavmine git. Onlar (zulümden) hâlâ sakınmayacaklar mı?\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20606,
            "SureId": 26,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Mûsâ, “Rabbim! Doğrusu beni yalancılıkla suçlamalarından korkuyorum;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20613,
            "SureId": 26,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Göğsüm daralıyor, dilim dolaşıyor; onun için bu elçilik görevini Hârûn’a yükle.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20620,
            "SureId": 26,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Ayrıca ben onlar nezdinde suçluyum; bu yüzden beni öldürmelerinden korkuyorum” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20627,
            "SureId": 26,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Allah, “Hayır, asla böyle olmayacak!” buyurdu. “Haydi ikiniz de mûcizelerimizle gidin. Şüphesiz biz sizinle beraberiz, (her şeyi) işitmekteyiz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20634,
            "SureId": 26,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16-17",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Firavun’a gidin ve deyin ki: “Gerçekten biz, İsrâiloğulları’nı bizimle beraber göndermen için âlemlerin rabbinin elçisiyiz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20641,
            "SureId": 26,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": false,
            "Page": 367,
            "AyetText": "Firavun’a gidin ve deyin ki: \"Gerçekten biz, İsrâiloğulları’nı bizimle beraber göndermen için âlemlerin rabbinin elçisiyiz.\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20648,
            "SureId": 26,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "(Makamına vardıklarında Mûsâ’ya) Firavun şöyle dedi: “Biz seni çocukken himayemize alıp büyütmedik mi? Hayatının nice yıllarını aramızda geçirmedin mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20655,
            "SureId": 26,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 367,
            "AyetText": "Sonunda yapacağını yaptın. Sen nankörün birisin!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Şuarâ",
