{
    "PointerList": null,
    "CuzNo": 21,
    "PageNo": 406,
    "ArCuzNo": "۲۱",
    "ArPageNo": "٤۰٦",
    "QuranAyats": [
        {
            "Id": 23975,
            "SureId": 30,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "وَاَمَّا الَّذٖینَ كَفَرُوا وَكَذَّبُوا بِاٰیَاتِنَا وَلِقَٓائِ الْاٰخِرَةِ فَاُو𐻾لٰٓئِكَ فِی الْعَذَابِ مُحْضَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 30,
                "MealInfo": "Mekke döneminde inmiştir. 60 âyettir. Sûre, adını ikinci âyette geçen <b>“erRûm”</b> kelimesinden almıştır. Sûre de başlıca <b>kıyametin hâllerinden, Allah’ın kudretine ve birliğine delalet eden kevnî meseleler ile Kureyş kabilesinin İslâm’a karşı olumsuz tutumu</b> konu edilmiştir.",
                "SureNameTurkish": "Rûm",
                "SureNameArabic": "الرُّومِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 84,
                "AyetCount": 60,
                "Cuz": 21,
                "FirstPage": 404,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 23982,
            "SureId": 30,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "فَسُبْحَانَ اللّٰهِ حٖینَ تُمْسُونَ وَحٖینَ تُصْبِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23989,
            "SureId": 30,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "وَلَهُ الْحَمْدُ فِی السَّمٰوَاتِ وَالْاَرْضِ وَعَشِیًّا وَحٖینَ تُظْهِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23996,
            "SureId": 30,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "یُخْرِجُ الْحَیَّ مِنَ الْمَیِّتِ وَیُخْرِجُ الْمَیِّتَ مِنَ الْحَیِّ وَیُحْيِ الْاَرْضَ بَعْدَ مَوْتِهَاؕ وَكَذٰلِكَ تُخْرَجُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24003,
            "SureId": 30,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "وَمِنْ اٰیَاتِهٖٓ اَنْ خَلَقَكُمْ مِنْ تُرَابٍ ثُمَّ اِذَٓا اَنْتُمْ بَشَرٌ تَنْتَشِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24010,
            "SureId": 30,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "وَمِنْ اٰیَاتِهٖٓ اَنْ خَلَقَ لَكُمْ مِنْ اَنْفُسِكُمْ اَزْوَاجًا لِتَسْكُنُٓوا اِلَیْهَا وَجَعَلَ بَیْنَكُمْ مَوَدَّةً وَرَحْمَةًؕ اِنَّ فٖی ذٰلِكَ لَاٰیَاتٍ لِقَوْمٍ یَتَفَكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24017,
            "SureId": 30,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "وَمِنْ اٰیَاتِهٖ خَلْقُ السَّمٰوَاتِ وَالْاَرْضِ وَاخْتِلَافُ اَلْسِنَتِكُمْ وَاَلْوَانِكُمْؕ اِنَّ فٖی ذٰلِكَ لَاٰیَاتٍ لِلْعَالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24024,
            "SureId": 30,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "وَمِنْ اٰیَاتِهٖ مَنَامُكُمْ بِالَّیْلِ وَالنَّهَارِ وَابْتِغَٓاؤُ𐻾كُمْ مِنْ فَضْلِهٖؕ اِنَّ فٖی ذٰلِكَ لَاٰیَاتٍ لِقَوْمٍ یَسْمَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24031,
            "SureId": 30,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "وَمِنْ اٰیَاتِهٖ یُرٖیكُمُ الْبَرْقَ خَوْفًا وَطَمَعًا وَیُنَزِّلُ مِنَ السَّمَٓاءِ مَٓاءً فَیُحْيٖ بِهِ الْاَرْضَ بَعْدَ مَوْتِهَاؕ اِنَّ فٖی ذٰلِكَ لَاٰیَاتٍ لِقَوْمٍ یَعْقِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 23973,
            "SureId": 30,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "İnkâr edenlere, âyetlerimizi ve âhiret buluşmasını yalan sayanlara gelince, onlar da azabın içine bırakılırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 30,
                "MealInfo": "Mekke döneminde inmiştir. 60 âyettir. Sûre, adını ikinci âyette geçen <b>“erRûm”</b> kelimesinden almıştır. Sûre de başlıca <b>kıyametin hâllerinden, Allah’ın kudretine ve birliğine delalet eden kevnî meseleler ile Kureyş kabilesinin İslâm’a karşı olumsuz tutumu</b> konu edilmiştir.",
                "SureNameTurkish": "Rûm",
                "SureNameArabic": "الرُّومِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 84,
                "AyetCount": 60,
                "Cuz": 21,
                "FirstPage": 404,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 23980,
            "SureId": 30,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "Bu sebeple akşam vaktine eriştiğinizde ve sabah kalktığınızda Allah’ı tesbih edin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23987,
            "SureId": 30,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "Göklerde ve yerde her türlü övgü O’na mahsustur. Gündüzün sonunda ve öğle vaktine eriştiğinizde de O’nu tesbih edin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23994,
            "SureId": 30,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "O ölüden diriyi, diriden de ölüyü çıkarıyor ve yeryüzünü ölümünün ardından canlandırıyor. İşte siz de böyle (diriltilip) çıkarılacaksınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24001,
            "SureId": 30,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "O’nun kanıtlarından biri, sizi topraktan yaratmış olmasıdır. Sonra bir de baktınız ki, çoğalarak yeryüzüne dağılmış beşer topluluğusunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24008,
            "SureId": 30,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "Onlara ısınıp kaynaşasınız diye size kendi türünüzden eşler yaratıp aranıza sevgi ve şefkat duyguları yerleştirmesi de O’nun kanıtlarındandır. Doğrusu bunda iyi düşünen kimseler için dersler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24015,
            "SureId": 30,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "O’nun kanıtlarından biri de, gökleri ve yeri yaratması, dillerinizin ve renklerinizin farklı olmasıdır. Kuşkusuz bunda bilenler için ibretler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24022,
            "SureId": 30,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "Gece ve gündüz uyuyabilmeniz ve Allah’ın lutfundan nasibinizi aramaya çalışmanız da O’nun kanıtlarındandır. Bunda, dinleyen kimseler için elbette dersler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24029,
            "SureId": 30,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 406,
            "AyetText": "Yine O’nun kanıtlarındandır ki, korku ve ümit vermek üzere size şimşeği gösteriyor, gökten su indirip ölümünün ardından yeryüzünü onunla canlandırıyor. Gerçekten bunda, aklını kullanan kimseler için ibretler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Rûm",
    "QuranSureLabel": "الرُّومِ",
    "EndPageSure": null
}