    "QuranAyats": [
        {
            "Id": 33677,
            "SureId": 53,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "اِنَّ الَّذٖینَ لَا یُؤْمِنُونَ بِالْاٰخِرَةِ لَیُسَمُّونَ الْمَلٰٓئِكَةَ تَسْمِیَةَ الْاُنْثٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 53,
                "MealInfo": "Mekke döneminde inmiştir. 62 âyettir. Sûre, adını ilk âyetin başındaki <b>“en-Necm” </b>kelimesinden almıştır.<b> Necm, yıldız demektir.</b> Sûrede başlıca, <b>Kur’an’ın vahiy eseri olduğu vurgulanmakta, herkesin yaptığının karşılığını göreceği, Allah’ın kudretinin delilleri</b> konu edilmektedir.",
                "SureNameTurkish": "Necm",
                "SureNameArabic": "النَّجْمِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 23,
                "AyetCount": 62,
                "Cuz": 27,
                "FirstPage": 526,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33684,
            "SureId": 53,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "وَمَا لَهُمْ بِهٖ مِنْ عِلْمٍؕ اِنْ یَتَّبِعُونَ اِلَّا الظَّنَّۚ وَاِنَّ الظَّنَّ لَا یُغْنٖی مِنَ الْحَقِّ شَیْـًٔاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33691,
            "SureId": 53,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "فَاَعْرِضْ عَنْ مَنْ تَوَلّٰى عَنْ ذِكْرِنَا وَلَمْ یُرِدْ اِلَّا الْحَیٰوةَ الدُّنْیَاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33698,
            "SureId": 53,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "ذٰلِكَ مَبْلَغُهُمْ مِنَ الْعِلْمِؕ اِنَّ رَبَّكَ هُوَ اَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبٖیلِهٖ وَهُوَ اَعْلَمُ بِمَنِ اهْتَدٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33705,
            "SureId": 53,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "وَلِلّٰهِ مَا فِی السَّمٰوَاتِ وَمَا فِی الْاَرْضِۙ لِیَجْزِیَ الَّذٖینَ اَسَٓاؤُ𐻿ا بِمَا عَمِلُوا وَیَجْزِیَ الَّذٖینَ اَحْسَنُوا بِالْحُسْنٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33712,
            "SureId": 53,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "اَلَّذٖینَ یَجْتَنِبُونَ كَبَٓائِرَ الْاِثْمِ وَالْفَوَاحِشَ اِلَّا اللَّمَمَؕ اِنَّ رَبَّكَ وَاسِعُ الْمَغْفِرَةِؕ هُوَ اَعْلَمُ بِكُمْ اِذْ اَنْشَاَكُمْ مِنَ الْاَرْضِ وَاِذْ اَنْتُمْ اَجِنَّةٌ فٖی بُطُونِ اُمَّهَاتِكُمْۚ فَلَا تُزَكُّٓوا اَنْفُسَكُمْؕ هُوَ اَعْلَمُ بِمَنِ اتَّقٰىࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33719,
            "SureId": 53,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "اَفَرَاَیْتَ الَّذٖی تَوَلّٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33726,
            "SureId": 53,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "وَاَعْطٰى قَلٖیلًا وَاَكْدٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33733,
            "SureId": 53,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "اَعِنْدَهُ عِلْمُ الْغَیْبِ فَهُوَ یَرٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33740,
            "SureId": 53,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "اَمْ لَمْ یُنَبَّاْ بِمَا فٖی صُحُفِ مُوسٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33747,
            "SureId": 53,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "وَاِبْرٰهٖیمَ الَّذٖی وَفّٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33754,
            "SureId": 53,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "اَلَّا تَزِرُ وَازِرَةٌ وِزْرَ اُخْرٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33761,
            "SureId": 53,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "وَاَنْ لَیْسَ لِلْاِنْسَانِ اِلَّا مَا سَعٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33768,
            "SureId": 53,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "وَاَنَّ سَعْیَهُ سَوْفَ یُرٰىࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33775,
            "SureId": 53,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "ثُمَّ یُجْزٰیهُ الْجَزَٓاءَ الْاَوْفٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33782,
            "SureId": 53,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "وَاَنَّ اِلٰى رَبِّكَ الْمُنْتَهٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33789,
            "SureId": 53,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "وَاَنَّهُ هُوَ اَضْحَكَ وَاَبْكٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33796,
            "SureId": 53,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "وَاَنَّهُ هُوَ اَمَاتَ وَاَحْیَاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 33675,
            "SureId": 53,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "Âhirete inanmayanlar meleklere dişi varlıkların isimlerini veriyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 53,
                "MealInfo": "Mekke döneminde inmiştir. 62 âyettir. Sûre, adını ilk âyetin başındaki <b>“en-Necm” </b>kelimesinden almıştır.<b> Necm, yıldız demektir.</b> Sûrede başlıca, <b>Kur’an’ın vahiy eseri olduğu vurgulanmakta, herkesin yaptığının karşılığını göreceği, Allah’ın kudretinin delilleri</b> konu edilmektedir.",
                "SureNameTurkish": "Necm",
                "SureNameArabic": "النَّجْمِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 23,
                "AyetCount": 62,
                "Cuz": 27,
                "FirstPage": 526,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33682,
            "SureId": 53,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "Oysa onların bu konuda bir bildikleri yok; sadece zanna uyuyorlar. Zan ise asla gerçek bilginin yerini tutamaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33689,
            "SureId": 53,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "O halde bizi anmaktan yüz çeviren ve dünya hayatından başka arzusu olmayan kişilerden sen de yüz çevir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33696,
            "SureId": 53,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "İşte bildikleri bu kadar. Şüphesiz kendi yolundan sapanı en iyi bilen rabbindir, doğru yolu bulanı da en iyi bilen O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33703,
            "SureId": 53,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31-32",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "Göklerde ve yerde ne varsa Allah’ındır. Sonunda O, kötülük yapanlara işlediklerinin cezasını verecek; iyilik yapanları, ufak tefek kusurlar hariç, büyük günahlardan ve çirkin işlerden kaçınanları ise daha güzeliyle ödüllendirecektir. Şüphesiz rabbinin bağışlaması çok geniştir. Sizi topraktan yarattığı zamanki halinizi de, annelerinizin karınlarında cenin olarak bulunuşunuzu da en iyi bilen O’dur. Şu halde kendinizi temize çıkarmayın! Kimin günahtan sakındığını en iyi bilen O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33710,
            "SureId": 53,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": false,
            "Page": 527,
            "AyetText": "Göklerde ve yerde ne varsa Allah’ındır. Sonunda O, kötülük yapanlara işlediklerinin cezasını verecek; iyilik yapanları, ufak tefek kusurlar hariç, büyük günahlardan ve çirkin işlerden kaçınanları ise daha güzeliyle ödüllendirecektir. Şüphesiz rabbinin bağışlaması çok geniştir. Sizi topraktan yarattığı zamanki halinizi de, annelerinizin karınlarında cenin olarak bulunuşunuzu da en iyi bilen O’dur. Şu halde kendinizi temize çıkarmayın! Kimin günahtan sakındığını en iyi bilen O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33717,
            "SureId": 53,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "Gördün mü o yüz çevireni;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33724,
            "SureId": 53,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "Azıcık verip sonra keseni!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33731,
            "SureId": 53,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "Gaybın bilgisine sahip de onunla mı görüyor?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33738,
            "SureId": 53,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36-37",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "Yoksa Mûsâ’nın ve ahde vefa örneği İbrâhim’in sahifelerinde bulunan şu hususlardan haberi yok mu?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33745,
            "SureId": 53,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": false,
            "Page": 527,
            "AyetText": "Yoksa Mûsâ’nın ve ahde vefa örneği İbrâhim’in sahifelerinde bulunan şu hususlardan haberi yok mu?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33752,
            "SureId": 53,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "Hiçbir günahkâr başkasının günahını yüklenmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33759,
            "SureId": 53,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "İnsan ancak çabasının sonucunu elde eder.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33766,
            "SureId": 53,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "Ve çabasının karşılığı ileride mutlaka görülecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33773,
            "SureId": 53,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "Sonra kendisine karşılığı tastamam verilecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33780,
            "SureId": 53,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "En sonunda yalnız rabbine varılacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33787,
            "SureId": 53,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "Güldüren de O’dur, ağlatan da.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33794,
            "SureId": 53,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 527,
            "AyetText": "Öldüren de O’dur, yaşatan da.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
