            "AyetText": "حٰمٓؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 45,
                "MealInfo": "Mekke döneminde inmiştir. 37 âyettir. Sûre, adını 28. âyette geçen <b>“Câsiye</b>” kelimesinden almıştır. <b>Câsiye, diz üstü çöken demektir</b>. Sûrede başlıca, <b>Kur’an’ın indirilmesi, dış âlemde Allah’ın varlığını ve birliğini gösteren deliller, Allah’ın kullarına bahşettiği nimetler, İsrailoğullarının kendilerine verilen nimetlere inkâr ve isyanla karşılık vermeleri</b> konu edilmektedir.",
                "SureNameTurkish": "Câsiye",
                "SureNameArabic": "الْجَاثِيَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 65,
                "AyetCount": 37,
