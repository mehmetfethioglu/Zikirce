                "FirstPage": 499,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 31325,
            "SureId": 45,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "تَنْزٖیلُ الْكِتَابِ مِنَ اللّٰهِ الْعَزٖیزِ الْحَكٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31332,
            "SureId": 45,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "اِنَّ فِی السَّمٰوَاتِ وَالْاَرْضِ لَاٰیَاتٍ لِلْمُؤْمِنٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31339,
            "SureId": 45,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "وَفٖی خَلْقِكُمْ وَمَا یَبُثُّ مِنْ دَٓابَّةٍ اٰیَاتٌ لِقَوْمٍ یُوقِنُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31346,
            "SureId": 45,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "وَاخْتِلَافِ الَّیْلِ وَالنَّهَارِ وَمَٓا اَنْزَلَ اللّٰهُ مِنَ السَّمَٓاءِ مِنْ رِزْقٍ فَاَحْیَا بِهِ الْاَرْضَ بَعْدَ مَوْتِهَا وَتَصْرٖیفِ الرِّیَاحِ اٰیَاتٌ لِقَوْمٍ یَعْقِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31353,
            "SureId": 45,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "تِلْكَ اٰیَاتُ اللّٰهِ نَتْلُوهَا عَلَیْكَ بِالْحَقِّۚ فَبِاَیِّ حَدٖیثٍ بَعْدَ اللّٰهِ وَاٰیَاتِهٖ یُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31360,
            "SureId": 45,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "وَیْلٌ لِكُلِّ اَفَّاكٍ اَثٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31367,
            "SureId": 45,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "یَسْمَعُ اٰیَاتِ اللّٰهِ تُتْلٰى عَلَیْهِ ثُمَّ یُصِرُّ مُسْتَكْبِرًا كَاَنْ لَمْ یَسْمَعْهَاۚ فَبَشِّرْهُ بِعَذَابٍ اَلٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31374,
            "SureId": 45,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "وَاِذَا عَلِمَ مِنْ اٰیَاتِنَا شَیْـًٔاࣙ اتَّخَذَهَا هُزُوًاؕ اُو𐻾لٰٓئِكَ لَهُمْ عَذَابٌ مُهٖینٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31381,
            "SureId": 45,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "مِنْ وَرَٓائِهِمْ جَهَنَّمُۚ وَلَا یُغْنٖی عَنْهُمْ مَا كَسَبُوا شَیْـًٔا وَلَا مَا اتَّخَذُوا مِنْ دُونِ اللّٰهِ اَوْلِیَٓاءَۚ وَلَهُمْ عَذَابٌ عَظٖیمٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31388,
            "SureId": 45,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "هٰذَا هُدًىۚ وَالَّذٖینَ كَفَرُوا بِاٰیَاتِ رَبِّهِمْ لَهُمْ عَذَابٌ مِنْ رِجْزٍ اَلٖیمٌࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31395,
            "SureId": 45,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "اَللّٰهُ الَّذٖی سَخَّرَ لَكُمُ الْبَحْرَ لِتَجْرِیَ الْفُلْكُ فٖیهِ بِاَمْرِهٖ وَلِتَبْتَغُوا مِنْ فَضْلِهٖ وَلَعَلَّكُمْ تَشْكُرُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31402,
            "SureId": 45,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "وَسَخَّرَ لَكُمْ مَا فِی السَّمٰوَاتِ وَمَا فِی الْاَرْضِ جَمٖیعًا مِنْهُؕ اِنَّ فٖی ذٰلِكَ لَاٰیَاتٍ لِقَوْمٍ یَتَفَكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 31316,
            "SureId": 45,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "Hâ-mîm.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 45,
                "MealInfo": "Mekke döneminde inmiştir. 37 âyettir. Sûre, adını 28. âyette geçen <b>“Câsiye</b>” kelimesinden almıştır. <b>Câsiye, diz üstü çöken demektir</b>. Sûrede başlıca, <b>Kur’an’ın indirilmesi, dış âlemde Allah’ın varlığını ve birliğini gösteren deliller, Allah’ın kullarına bahşettiği nimetler, İsrailoğullarının kendilerine verilen nimetlere inkâr ve isyanla karşılık vermeleri</b> konu edilmektedir.",
                "SureNameTurkish": "Câsiye",
                "SureNameArabic": "الْجَاثِيَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 65,
                "AyetCount": 37,
                "Cuz": 25,
                "FirstPage": 499,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 31323,
            "SureId": 45,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "Kitabın indirilmesi izzet ve hikmet sahibi Allah’tandır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31330,
            "SureId": 45,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "Göklerde ve yerde inananlar için önemli işaretler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31337,
            "SureId": 45,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "Sizin yaratılışınızda ve yeryüzüne yaydığı diğer kımıldayan canlılarda bilenler için deliller mevcuttur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31344,
            "SureId": 45,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "Gece ile gündüzün yer değiştirmesinde, Allah’ın gökten indirdiği rızıkta (yağmurda) -ki, onunla öldükten sonra yere yeniden hayat vermektedir- rüzgârları çeşitli yönlerden estirmesinde düşünenler için alınacak dersler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31351,
            "SureId": 45,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "İşte şunlar, sana gerçekten okuduğumuz âyetlerdir. Allah’tan ve O’nun âyetlerinden sonra (buna değil de) hangi habere inanacaklar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31358,
            "SureId": 45,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7-8",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "Kendisine Allah’ın âyetleri okunurken işitip de sonra büyüklenerek işitmemişcesine inkârda ısrar eden her bir günahkâr iftiracıya yazıklar olsun! Bu sebeple göreceği ağır azabı ona bildir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31365,
            "SureId": 45,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": false,
            "Page": 499,
            "AyetText": "Kendisine Allah’ın âyetleri okunurken işitip de sonra büyüklenerek işitmemişcesine inkârda ısrar eden her bir günahkâr iftiracıya yazıklar olsun! Bu sebeple göreceği ağır azabı ona bildir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31372,
            "SureId": 45,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "Âyetlerimiz hakkında bir parça bilgi sahibi olunca hemen onu alay konusu yapmakta. İşte bu gibiler için alçaltıcı bir azap vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31379,
            "SureId": 45,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "Önlerinde cehennem! Ne dünyada elde ettiklerinden ne de Allah’ı bırakıp sırtlarını dayadıkları dostlardan kendilerine bir fayda erişir. Onların nasibi büyük bir azaptır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31386,
            "SureId": 45,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "Bu (Kur’an) bir doğru yol rehberidir. Rablerinin âyetlerini inkâr edenler için ise en şiddetlisinden elem verici bir azap vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31393,
            "SureId": 45,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "Buyruğu ile içinde gemiler yüzsün, lutfettiği nimetleri elde edesiniz ve şükredesiniz diye denizi istifadenize veren Allah’tır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31400,
            "SureId": 45,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 499,
            "AyetText": "Ayrıca O, göklerde ve yerde ne varsa hepsini kendinden bir lütuf olarak emrinize vermiştir. Bütün bunlarda düşünenler için işaretler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
