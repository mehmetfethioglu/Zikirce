{
    "PointerList": null,
    "CuzNo": 16,
    "PageNo": 311,
    "ArCuzNo": "۱٦",
    "ArPageNo": "۳۱۱",
    "QuranAyats": [
        {
            "Id": 16289,
            "SureId": 19,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "اَفَرَاَیْتَ الَّذٖی كَفَرَ بِاٰیَاتِنَا وَقَالَ لَاُو𐻿تَیَنَّ مَالًا وَوَلَدًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16296,
            "SureId": 19,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "اَطَّلَعَ الْغَیْبَ اَمِ اتَّخَذَ عِنْدَ الرَّحْمٰنِ عَهْدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16303,
            "SureId": 19,
            "AyetId": 79,
            "LanguageId": 7,
            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "كَلَّاؕ سَنَكْتُبُ مَا یَقُولُ وَنَمُدُّ لَهُ مِنَ الْعَذَابِ مَدًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16310,
            "SureId": 19,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "وَنَرِثُهُ مَا یَقُولُ وَیَاْتٖینَا فَرْدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16317,
            "SureId": 19,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "وَاتَّخَذُوا مِنْ دُونِ اللّٰهِ اٰلِهَةً لِیَكُونُوا لَهُمْ عِزًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16324,
            "SureId": 19,
            "AyetId": 82,
            "LanguageId": 7,
            "AyetNumber": "٨٢",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "كَلَّاؕ سَیَكْفُرُونَ بِعِبَادَتِهِمْ وَیَكُونُونَ عَلَیْهِمْ ضِدًّاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16331,
            "SureId": 19,
            "AyetId": 83,
            "LanguageId": 7,
            "AyetNumber": "٨٣",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "اَلَمْ تَرَ اَنَّٓا اَرْسَلْنَا الشَّیَاطٖینَ عَلَى الْكَافِرٖینَ تَؤُزُّهُمْ اَزًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16338,
            "SureId": 19,
            "AyetId": 84,
            "LanguageId": 7,
            "AyetNumber": "٨٤",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "فَلَا تَعْجَلْ عَلَیْهِمْؕ اِنَّمَا نَعُدُّ لَهُمْ عَدًّاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16345,
            "SureId": 19,
            "AyetId": 85,
            "LanguageId": 7,
            "AyetNumber": "٨٥",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "یَوْمَ نَحْشُرُ الْمُتَّقٖینَ اِلَى الرَّحْمٰنِ وَفْدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16352,
            "SureId": 19,
            "AyetId": 86,
            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "وَنَسُوقُ الْمُجْرِمٖینَ اِلٰى جَهَنَّمَ وِرْدًاۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16359,
            "SureId": 19,
            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "لَا یَمْلِكُونَ الشَّفَاعَةَ اِلَّا مَنِ اتَّخَذَ عِنْدَ الرَّحْمٰنِ عَهْدًاۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16366,
            "SureId": 19,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "وَقَالُوا اتَّخَذَ الرَّحْمٰنُ وَلَدًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16373,
            "SureId": 19,
            "AyetId": 89,
            "LanguageId": 7,
            "AyetNumber": "٨٩",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "لَقَدْ جِئْتُمْ شَیْـًٔا اِدًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16380,
            "SureId": 19,
            "AyetId": 90,
            "LanguageId": 7,
            "AyetNumber": "٩٠",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "تَكَادُ السَّمٰوَاتُ یَتَفَطَّرْنَ مِنْهُ وَتَنْشَقُّ الْاَرْضُ وَتَخِرُّ الْجِبَالُ هَدًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16387,
            "SureId": 19,
            "AyetId": 91,
            "LanguageId": 7,
            "AyetNumber": "٩١",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "اَنْ دَعَوْا لِلرَّحْمٰنِ وَلَدًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16394,
            "SureId": 19,
            "AyetId": 92,
            "LanguageId": 7,
            "AyetNumber": "٩٢",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "وَمَا یَنْبَغٖی لِلرَّحْمٰنِ اَنْ یَتَّخِذَ وَلَدًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16401,
            "SureId": 19,
            "AyetId": 93,
            "LanguageId": 7,
            "AyetNumber": "٩٣",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "اِنْ كُلُّ مَنْ فِی السَّمٰوَاتِ وَالْاَرْضِ اِلَّٓا اٰتِی الرَّحْمٰنِ عَبْدًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16408,
            "SureId": 19,
            "AyetId": 94,
            "LanguageId": 7,
            "AyetNumber": "٩٤",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "لَقَدْ اَحْصٰیهُمْ وَعَدَّهُمْ عَدًّاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16415,
            "SureId": 19,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "وَكُلُّهُمْ اٰتٖیهِ یَوْمَ الْقِیٰمَةِ فَرْدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 16287,
            "SureId": 19,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Âyetlerimizi inkâr eden ve “Mutlaka bana mal ve evlât verilecektir” diyen adamı gördün mü!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16294,
            "SureId": 19,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "O, gaybı mı biliyor, yoksa Allah’ın katından bir söz mü aldı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16301,
            "SureId": 19,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Kesinlikle hayır! Biz onun söylediklerini yazacağız ve cezasını uzattıkça uzatacağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16308,
            "SureId": 19,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Onun sözünü ettiği şeyler sonunda bize kalacak, kendisi de tek başına bize gelecek.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16315,
            "SureId": 19,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Onlar kendilerine bir itibar ve güç vesilesi olsun diye Allah’tan başka tanrılar edindiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16322,
            "SureId": 19,
            "AyetId": 82,
            "LanguageId": 5,
            "AyetNumber": "82",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Hayır, hayır! O putlar onların ibadetini tanımayacaklar ve kendilerine hasım olacaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16329,
            "SureId": 19,
            "AyetId": 83,
            "LanguageId": 5,
            "AyetNumber": "83",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Görmedin mi? Biz, inkârcıların üzerine kendilerini isyana itip duran şeytanları saldık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16336,
            "SureId": 19,
            "AyetId": 84,
            "LanguageId": 5,
            "AyetNumber": "84",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Öyle ise onlar hakkında acele etme; biz onların günlerini sayıyoruz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16343,
            "SureId": 19,
            "AyetId": 85,
            "LanguageId": 5,
            "AyetNumber": "85",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Gün gelecek, takvâ sahiplerini seçkin konuklar olarak rahmânın huzurunda toplayacağız;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16350,
            "SureId": 19,
            "AyetId": 86,
            "LanguageId": 5,
            "AyetNumber": "86",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Günahkârları da suya götürülen sürü gibi cehenneme süreceğiz;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16357,
            "SureId": 19,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "(O gün) Rahmân’ın katında söz ve izin alandan başkasının şefaat hakkı olmayacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16364,
            "SureId": 19,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "“Rahmân çocuk edindi” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16371,
            "SureId": 19,
            "AyetId": 89,
            "LanguageId": 5,
            "AyetNumber": "89",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Hakikaten çok çirkin bir iddia ortaya attınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16378,
            "SureId": 19,
            "AyetId": 90,
            "LanguageId": 5,
            "AyetNumber": "90",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Öyle ki bundan dolayı neredeyse gökler çatlayacak, yer ortasından yarılacak, dağlar yıkılıp çökecek!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16385,
            "SureId": 19,
            "AyetId": 91,
            "LanguageId": 5,
            "AyetNumber": "91",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Çünkü Rahmân’a çocuk yakıştırıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16392,
            "SureId": 19,
            "AyetId": 92,
            "LanguageId": 5,
            "AyetNumber": "92",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Halbuki çocuk edinmek Rahmân’ın şanına yakışmaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16399,
            "SureId": 19,
            "AyetId": 93,
            "LanguageId": 5,
            "AyetNumber": "93",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Göklerde ve yerde olan herkes istisnasız, Rahmân’a birer kul olarak gelecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16406,
            "SureId": 19,
            "AyetId": 94,
            "LanguageId": 5,
            "AyetNumber": "94",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "O, bunların hepsini kuşatmış ve sayılarını tesbit etmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16413,
            "SureId": 19,
            "AyetId": 95,
            "LanguageId": 5,
            "AyetNumber": "95",
            "AyetVisible": true,
            "Page": 311,
            "AyetText": "Bunların hepsi de kıyamet gününde Allah’ın huzuruna tek başına gelecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Meryem",
    "QuranSureLabel": "مَرْيَمَ",
    "EndPageSure": null
}