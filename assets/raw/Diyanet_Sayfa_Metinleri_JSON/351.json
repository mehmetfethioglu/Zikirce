    "QuranAyats": [
        {
            "Id": 19614,
            "SureId": 24,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "اِنَّ الَّذٖینَ جَٓاؤُ𐻿 بِالْاِفْكِ عُصْبَةٌ مِنْكُمْؕ لَا تَحْسَبُوهُ شَرًّا لَكُمْؕ بَلْ هُوَ خَیْرٌ لَكُمْؕ لِكُلِّ امْرِئٍ مِنْهُمْ مَا اكْتَسَبَ مِنَ الْاِثْمِۚ وَالَّذٖی تَوَلّٰى كِبْرَهُ مِنْهُمْ لَهُ عَذَابٌ عَظٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 24,
                "MealInfo": "Medine döneminde inmiştir. 64 âyettir. Adını, 35. âyette geçen <b>“nûr</b>” kelimesinden almıştır. Sûre de başlıca; bireysel ve toplumsal hayatla ilgili çeşitli hüküm ve prensipler, özellikle aile hayatına dair esaslar yer almaktadır.",
                "SureNameTurkish": "Nûr",
                "SureNameArabic": "النُّورِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 102,
                "AyetCount": 64,
                "Cuz": 18,
                "FirstPage": 350,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19621,
            "SureId": 24,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "لَوْلَٓا اِذْ سَمِعْتُمُوهُ ظَنَّ الْمُؤْمِنُونَ وَالْمُؤْمِنَاتُ بِاَنْفُسِهِمْ خَیْرًاۙ وَقَالُوا هٰذَٓا اِفْكٌ مُبٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19628,
            "SureId": 24,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "لَوْلَا جَٓاؤُ𐻿 عَلَیْهِ بِاَرْبَعَةِ شُهَدَٓاءَۚ فَاِذْ لَمْ یَاْتُوا بِالشُّهَدَٓاءِ فَاُو𐻾لٰٓئِكَ عِنْدَ اللّٰهِ هُمُ الْكَاذِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19635,
            "SureId": 24,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "وَلَوْلَا فَضْلُ اللّٰهِ عَلَیْكُمْ وَرَحْمَتُهُ فِی الدُّنْیَا وَالْاٰخِرَةِ لَمَسَّكُمْ فٖی مَٓا اَفَضْتُمْ فٖیهِ عَذَابٌ عَظٖیمٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19642,
            "SureId": 24,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "اِذْ تَلَقَّوْنَهُ بِاَلْسِنَتِكُمْ وَتَقُولُونَ بِاَفْوَاهِكُمْ مَا لَیْسَ لَكُمْ بِهٖ عِلْمٌ وَتَحْسَبُونَهُ هَیِّنًاࣗ وَهُوَ عِنْدَ اللّٰهِ عَظٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19649,
            "SureId": 24,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "وَلَوْلَٓا اِذْ سَمِعْتُمُوهُ قُلْتُمْ مَا یَكُونُ لَنَٓا اَنْ نَتَكَلَّمَ بِهٰذَاࣗ سُبْحَانَكَ هٰذَا بُهْتَانٌ عَظٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19656,
            "SureId": 24,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "یَعِظُكُمُ اللّٰهُ اَنْ تَعُودُوا لِمِثْلِهٖٓ اَبَدًا اِنْ كُنْتُمْ مُؤْمِنٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19663,
            "SureId": 24,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "وَیُبَیِّنُ اللّٰهُ لَكُمُ الْاٰیَاتِؕ وَاللّٰهُ عَلٖیمٌ حَكٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19670,
            "SureId": 24,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "اِنَّ الَّذٖینَ یُحِبُّونَ اَنْ تَشٖیعَ الْفَاحِشَةُ فِی الَّذٖینَ اٰمَنُوا لَهُمْ عَذَابٌ اَلٖیمٌۙ فِی الدُّنْیَا وَالْاٰخِرَةِؕ وَاللّٰهُ یَعْلَمُ وَاَنْتُمْ لَا تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19677,
            "SureId": 24,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "وَلَوْلَا فَضْلُ اللّٰهِ عَلَیْكُمْ وَرَحْمَتُهُ وَاَنَّ اللّٰهَ رَؤُ𐻿فٌ رَحٖیمٌࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 19612,
            "SureId": 24,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "O iftirayı atanlar içinizden bir gruptur. Bunun sizin için kötü olduğunu sanmayın, aksine bu hakkınızda hayırlıdır. Onların her biri işlediği günahı yüklenecektir. İçlerinden günahın büyüğünü üstlenen için ise büyük bir azap vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 24,
                "MealInfo": "Medine döneminde inmiştir. 64 âyettir. Adını, 35. âyette geçen <b>“nûr</b>” kelimesinden almıştır. Sûre de başlıca; bireysel ve toplumsal hayatla ilgili çeşitli hüküm ve prensipler, özellikle aile hayatına dair esaslar yer almaktadır.",
                "SureNameTurkish": "Nûr",
                "SureNameArabic": "النُّورِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 102,
                "AyetCount": 64,
                "Cuz": 18,
                "FirstPage": 350,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19619,
            "SureId": 24,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "Bunu işittiğiniz zaman mümin erkekler ve kadınların birbiri hakkında hüsn-i zan beslemeleri ve “Bu apaçık bir iftiradır” demeleri gerekmez miydi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19626,
            "SureId": 24,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "Bu iddialarına dört şahit getirseler ya! Bu sayıda şahit getiremiyorlarsa onlar, Allah nezdinde yalancıların ta kendileridir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19633,
            "SureId": 24,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "Eğer dünyada ve âhirette Allah’ın lütfu ve rahmeti hep sizinle olmasaydı içine daldığınız günah yüzünden size büyük bir azap gelecekti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19640,
            "SureId": 24,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "Çünkü siz, iftirayı dilden dile yayıyor, hakkında bilgi sahibi olmadığınız bir şeyi ağızlarınızla söylüyorsunuz; bunu da önemsiz sanıyorsunuz; halbuki Allah katında o büyük bir şeydir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19647,
            "SureId": 24,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "O kulağınıza geldiğinde “Bunu konuşmak bize yakışmaz, fesübhânal-lah, bu apaçık bir iftiradır” deseydiniz ya!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19654,
            "SureId": 24,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "Eğer gerçek müminlerseniz Allah size, bir daha asla böyle bir şey yapmamanızı öğütlüyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19661,
            "SureId": 24,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "Allah size âyetleri açıklıyor; Allah ilim ve hikmet sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19668,
            "SureId": 24,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "Müminler arasında ahlâksızlığın yaygınlaşmasını isteyenlere dünyada ve âhirette can yakıcı bir ceza vardır. Allah bilir, siz bilmezsiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19675,
            "SureId": 24,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 351,
            "AyetText": "Ya Allah’ın size lütfu ve rahmeti ulaşmasaydı, ya Allah çok şefkatli, çok merhametli olmasaydı!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Nûr",
    "QuranSureLabel": "النُّورِ",
    "EndPageSure": null
}