    "QuranAyats": [
        {
            "Id": 19341,
            "SureId": 23,
            "AyetId": 90,
            "LanguageId": 7,
            "AyetNumber": "٩٠",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "بَلْ اَتَیْنَاهُمْ بِالْحَقِّ وَاِنَّهُمْ لَكَاذِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19348,
            "SureId": 23,
            "AyetId": 91,
            "LanguageId": 7,
            "AyetNumber": "٩١",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "مَا اتَّخَذَ اللّٰهُ مِنْ وَلَدٍ وَمَا كَانَ مَعَهُ مِنْ اِلٰهٍ اِذًا لَذَهَبَ كُلُّ اِلٰهٍ بِمَا خَلَقَ وَلَعَلَا بَعْضُهُمْ عَلٰى بَعْضٍؕ سُبْحَانَ اللّٰهِ عَمَّا یَصِفُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19355,
            "SureId": 23,
            "AyetId": 92,
            "LanguageId": 7,
            "AyetNumber": "٩٢",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "عَالِمِ الْغَیْبِ وَالشَّهَادَةِ فَتَعَالٰى عَمَّا یُشْرِكُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19362,
            "SureId": 23,
            "AyetId": 93,
            "LanguageId": 7,
            "AyetNumber": "٩٣",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "قُلْ رَبِّ اِمَّا تُرِیَنّٖی مَا یُوعَدُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19369,
            "SureId": 23,
            "AyetId": 94,
            "LanguageId": 7,
            "AyetNumber": "٩٤",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "رَبِّ فَلَا تَجْعَلْنٖی فِی الْقَوْمِ الظَّالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19376,
            "SureId": 23,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "وَاِنَّا عَلٰٓى اَنْ نُرِیَكَ مَا نَعِدُهُمْ لَقَادِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19383,
            "SureId": 23,
            "AyetId": 96,
            "LanguageId": 7,
            "AyetNumber": "٩٦",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "اِدْفَعْ بِالَّتٖی هِیَ اَحْسَنُ السَّیِّئَةَؕ نَحْنُ اَعْلَمُ بِمَا یَصِفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19390,
            "SureId": 23,
            "AyetId": 97,
            "LanguageId": 7,
            "AyetNumber": "٩٧",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "وَقُلْ رَبِّ اَعُوذُ بِكَ مِنْ هَمَزَاتِ الشَّیَاطٖینِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19397,
            "SureId": 23,
            "AyetId": 98,
            "LanguageId": 7,
            "AyetNumber": "٩٨",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "وَاَعُوذُ بِكَ رَبِّ اَنْ یَحْضُرُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19404,
            "SureId": 23,
            "AyetId": 99,
            "LanguageId": 7,
            "AyetNumber": "٩٩",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "حَتّٰٓى اِذَا جَٓاءَ اَحَدَهُمُ الْمَوْتُ قَالَ رَبِّ ارْجِعُونِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19411,
            "SureId": 23,
            "AyetId": 100,
            "LanguageId": 7,
            "AyetNumber": "١٠٠",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "لَعَلّٖٓی اَعْمَلُ صَالِحًا فٖیمَا تَرَكْتُ كَلَّاؕ اِنَّهَا كَلِمَةٌ هُوَ قَٓائِلُهَاؕ وَمِنْ وَرَٓائِهِمْ بَرْزَخٌ اِلٰى یَوْمِ یُبْعَثُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19418,
            "SureId": 23,
            "AyetId": 101,
            "LanguageId": 7,
            "AyetNumber": "١٠١",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "فَاِذَا نُفِـخَ فِی الصُّورِ فَلَٓا اَنْسَابَ بَیْنَهُمْ یَوْمَئِذٍ وَلَا یَتَسَٓاءَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19425,
            "SureId": 23,
            "AyetId": 102,
            "LanguageId": 7,
            "AyetNumber": "١٠٢",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "فَمَنْ ثَقُلَتْ مَوَازٖینُهُ فَاُو𐻾لٰٓئِكَ هُمُ الْمُفْلِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19432,
            "SureId": 23,
            "AyetId": 103,
            "LanguageId": 7,
            "AyetNumber": "١٠٣",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "وَمَنْ خَفَّتْ مَوَازٖینُهُ فَاُو𐻾لٰٓئِكَ الَّذٖینَ خَسِرُٓوا اَنْفُسَهُمْ فٖی جَهَنَّمَ خَالِدُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19439,
            "SureId": 23,
            "AyetId": 104,
            "LanguageId": 7,
            "AyetNumber": "١٠٤",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "تَلْفَحُ وُجُوهَهُمُ النَّارُ وَهُمْ فٖیهَا كَالِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 19339,
            "SureId": 23,
            "AyetId": 90,
            "LanguageId": 5,
            "AyetNumber": "90",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "Doğrusu biz onlara hakkı bildirdik, onlar ise kesinlikle yalancıdırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19346,
            "SureId": 23,
            "AyetId": 91,
            "LanguageId": 5,
            "AyetNumber": "91",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "Allah asla çocuk edinmemiştir. O’nunla beraber başka bir tanrı da yoktur; aksi taktirde her tanrı kendi yarattıklarını alıp bir tarafa çekilir ve mutlaka o tanrılardan biri diğerine baskın gelmeye çalışırdı. Doğrusu Allah o müşriklerin yakıştırdıkları şeylerden münezzehtir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19353,
            "SureId": 23,
            "AyetId": 92,
            "LanguageId": 5,
            "AyetNumber": "92",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "Allah görünmez âlemi de duyularla algılanan âlemi de bilmektedir. O, putperestlerin kendisine ortak saydığı şeylerden çok uzaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19360,
            "SureId": 23,
            "AyetId": 93,
            "LanguageId": 5,
            "AyetNumber": "93",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "De ki: “Rabbim! Eğer onların tehdit edildiği hali bana göstereceksen;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19367,
            "SureId": 23,
            "AyetId": 94,
            "LanguageId": 5,
            "AyetNumber": "94",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "Bu durumda beni zalimler topluluğunun içinde bulundurma rabbim!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19374,
            "SureId": 23,
            "AyetId": 95,
            "LanguageId": 5,
            "AyetNumber": "95",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "(Resulüm!) Onları tehdit ettiğimiz durumu sana göstermeye elbette ki kādiriz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19381,
            "SureId": 23,
            "AyetId": 96,
            "LanguageId": 5,
            "AyetNumber": "96",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "Sen kötülüğü en güzel bir tutumla sav. Onların yakıştırdıkları şeyleri biz çok iyi biliyoruz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19388,
            "SureId": 23,
            "AyetId": 97,
            "LanguageId": 5,
            "AyetNumber": "97",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "Ve de ki: “Rabbim! Şeytanların gizli kışkırtmalarından sana sığınırım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19395,
            "SureId": 23,
            "AyetId": 98,
            "LanguageId": 5,
            "AyetNumber": "98",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "Onların yanımda bulunmalarından da sana sığınırım rabbim!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19402,
            "SureId": 23,
            "AyetId": 99,
            "LanguageId": 5,
            "AyetNumber": "99-100",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "Nihayet onlardan birine ölüm gelip çatınca, “Rabbim! Beni geri gönder de, geride bıraktığım dünyada iyi işler yapayım” der. Hayır! Onun söylediği bu söz boş laftan ibarettir. Önlerinde, yeniden diriltilecekleri güne kadar bir berzah vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19409,
            "SureId": 23,
            "AyetId": 100,
            "LanguageId": 5,
            "AyetNumber": "100",
            "AyetVisible": false,
            "Page": 348,
            "AyetText": "Nihayet onlardan birine ölüm gelip çatınca, \"Rabbim! Beni geri gönder de, geride bıraktığım dünyada iyi işler yapayım\" der. Hayır! Onun söylediği bu söz boş laftan ibarettir. Önlerinde, yeniden diriltilecekleri güne kadar bir berzah vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19416,
            "SureId": 23,
            "AyetId": 101,
            "LanguageId": 5,
            "AyetNumber": "101",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "Sûra üflendiğinde artık ne aralarında akrabalık bağları kalacak ne de birbirlerine soru sorabilecekler!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19423,
            "SureId": 23,
            "AyetId": 102,
            "LanguageId": 5,
            "AyetNumber": "102",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "O zaman kimlerin tartıları ağır gelirse işte bunlar kurtuluşa ermiş olacaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19430,
            "SureId": 23,
            "AyetId": 103,
            "LanguageId": 5,
            "AyetNumber": "103",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "Tartıları hafif gelenler ise kendilerini ziyan etmiş olanlardır. Onlar cehennemde ebedî kalacaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19437,
            "SureId": 23,
            "AyetId": 104,
            "LanguageId": 5,
            "AyetNumber": "104",
            "AyetVisible": true,
            "Page": 348,
            "AyetText": "Ateş yüzlerine vuracak, orada dudakları çekilmiş, dişleri görünür bir halde ­bulunacaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Mü'minûn",
    "QuranSureLabel": "الْمُؤْمِنُونَ",
