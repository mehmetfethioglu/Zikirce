            "SureId": 44,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "یَوْمَ لَا یُغْنٖی مَوْلًى عَنْ مَوْلًى شَیْـًٔا وَلَا هُمْ یُنْصَرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31192,
            "SureId": 44,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "اِلَّا مَنْ رَحِمَ اللّٰهُؕ اِنَّهُ هُوَ الْعَزٖیزُ الرَّحٖیمُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31199,
            "SureId": 44,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "اِنَّ شَجَرَتَ الزَّقُّومِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31206,
            "SureId": 44,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "طَعَامُ الْاَثٖیمِۚۛ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31213,
            "SureId": 44,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "كَالْمُهْلِۚۛ یَغْلٖی فِی الْبُطُونِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31220,
            "SureId": 44,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "كَغَلْیِ الْحَمٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31227,
            "SureId": 44,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "خُذُوهُ فَاعْتِلُوهُ اِلٰى سَوَٓاءِ الْجَحٖیمِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31234,
            "SureId": 44,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "ثُمَّ صُبُّوا فَوْقَ رَاْسِهٖ مِنْ عَذَابِ الْحَمٖیمِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31241,
            "SureId": 44,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "ذُقْۚۙ اِنَّكَ اَنْتَ الْعَزٖیزُ الْكَرٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31248,
            "SureId": 44,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "اِنَّ هٰذَا مَا كُنْتُمْ بِهٖ تَمْتَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31255,
            "SureId": 44,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "اِنَّ الْمُتَّقٖینَ فٖی مَقَامٍ اَمٖینٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31262,
            "SureId": 44,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "فٖی جَنَّاتٍ وَعُیُونٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31269,
            "SureId": 44,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "یَلْبَسُونَ مِنْ سُنْدُسٍ وَاِسْتَبْرَقٍ مُتَقَابِلٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31276,
            "SureId": 44,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "كَذٰلِكَࣞ وَزَوَّجْنَاهُمْ بِحُورٍ عٖینٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31283,
            "SureId": 44,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "یَدْعُونَ فٖیهَا بِكُلِّ فَاكِهَةٍ اٰمِنٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31290,
            "SureId": 44,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "لَا یَذُوقُونَ فٖیهَا الْمَوْتَ اِلَّا الْمَوْتَةَ الْاُو𐻿لٰىۚ وَوَقٰیهُمْ عَذَابَ الْجَحٖیمِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31297,
            "SureId": 44,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "فَضْلًا مِنْ رَبِّكَؕ ذٰلِكَ هُوَ الْفَوْزُ الْعَظٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31304,
            "SureId": 44,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "فَاِنَّمَا یَسَّرْنَاهُ بِلِسَانِكَ لَعَلَّهُمْ یَتَذَكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31311,
            "SureId": 44,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 498,
            "AyetText": "فَارْتَقِبْ اِنَّهُمْ مُرْتَقِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
