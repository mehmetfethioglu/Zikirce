{
    "PointerList": null,
    "CuzNo": 16,
    "PageNo": 306,
    "ArCuzNo": "۱٦",
    "ArPageNo": "۳۰٦",
    "QuranAyats": [
        {
            "Id": 15834,
            "SureId": 19,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "یَا یَحْیٰى خُذِ الْكِتَابَ بِقُوَّةٍؕ وَاٰتَیْنَاهُ الْحُكْمَ صَبِیًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 15841,
            "SureId": 19,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "وَحَنَانًا مِنْ لَدُنَّا وَزَكٰوةًؕ وَكَانَ تَقِیًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15848,
            "SureId": 19,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "وَبَرًّا بِوَالِدَیْهِ وَلَمْ یَكُنْ جَبَّارًا عَصِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15855,
            "SureId": 19,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "وَسَلَامٌ عَلَیْهِ یَوْمَ وُلِدَ وَیَوْمَ یَمُوتُ وَیَوْمَ یُبْعَثُ حَیًّاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15862,
            "SureId": 19,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "وَاذْكُرْ فِی الْكِتَابِ مَرْیَمَۘ اِذِ انْتَبَذَتْ مِنْ اَهْلِهَا مَكَانًا شَرْقِیًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15869,
            "SureId": 19,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "فَاتَّخَذَتْ مِنْ دُونِهِمْ حِجَابًا فَاَرْسَلْنَٓا اِلَیْهَا رُوحَنَا فَتَمَثَّلَ لَهَا بَشَرًا سَوِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15876,
            "SureId": 19,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "قَالَتْ اِنّٖٓی اَعُوذُ بِالرَّحْمٰنِ مِنْكَ اِنْ كُنْتَ تَقِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15883,
            "SureId": 19,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "قَالَ اِنَّمَٓا اَنَا𐻾 رَسُولُ رَبِّكِࣗ لِاَهَبَ لَكِ غُلَامًا زَكِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15890,
            "SureId": 19,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "قَالَتْ اَنّٰى یَكُونُ لٖی غُلَامٌ وَلَمْ یَمْسَسْنٖی بَشَرٌ وَلَمْ اَكُ بَغِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15897,
            "SureId": 19,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "قَالَ كَذٰلِكِۚ قَالَ رَبُّكِ هُوَ عَلَیَّ هَیِّنٌۚ وَلِنَجْعَلَهُٓ اٰیَةً لِلنَّاسِ وَرَحْمَةً مِنَّاۚ وَكَانَ اَمْرًا مَقْضِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15904,
            "SureId": 19,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "فَحَمَلَتْهُ فَانْتَبَذَتْ بِهٖ مَكَانًا قَصِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15911,
            "SureId": 19,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "فَاَجَٓاءَهَا الْمَخَاضُ اِلٰى جِذْعِ النَّخْلَةِۚ قَالَتْ یَا لَیْتَنٖی مِتُّ قَبْلَ هٰذَا وَكُنْتُ نَسْیًا مَنْسِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15918,
            "SureId": 19,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "فَنَادٰیهَا مِنْ تَحْتِهَٓا اَلَّا تَحْزَنٖی قَدْ جَعَلَ رَبُّكِ تَحْتَكِ سَرِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15925,
            "SureId": 19,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "وَهُزّٖٓی اِلَیْكِ بِجِذْعِ النَّخْلَةِ تُسَاقِطْ عَلَیْكِ رُطَبًا جَنِیًّاؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 15832,
            "SureId": 19,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "“Ey Yahyâ! Kitaba var gücünle sarıl!” dedik ve ona henüz çocukken hikmeti verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 15839,
            "SureId": 19,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "Ayrıca katımızdan ona şefkat ve ruh temizliği de (verdik). O, kötülükten çok sakınan biriydi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15846,
            "SureId": 19,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "Anne babasına çok iyi davranırdı; zorba ve âsi değildi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15853,
            "SureId": 19,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "Doğduğu gün, öleceği gün ve yeniden hayata döndürüleceği gün ona selâm olsun.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15860,
            "SureId": 19,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "Kitapta Meryem’i de okuyup an. Hani o, evinden ayrılarak doğu tarafında bir yere çekilmişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15867,
            "SureId": 19,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "Onlarla kendi arasına bir perde çekmişti. Derken, ona ruhumuzu gönderdik; ruh ona tam bir insan şeklinde göründü.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15874,
            "SureId": 19,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "Meryem, “Beni senden koruması için çok esirgeyici olan Allah’a sığınıyorum! Eğer Allah’tan sakınan bir kimse isen (bana dokunma)” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15881,
            "SureId": 19,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "Melek, “Ben ancak sana tertemiz bir erkek çocuk bağışlamak için rabbin tarafından gönderilmiş bir elçiyim” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15888,
            "SureId": 19,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "Meryem, “Ben iffetsiz olmadığım ve bana bir erkek eli bile değmediği halde nasıl çocuğum olur?” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15895,
            "SureId": 19,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "Melek cevap verdi: “Orası öyle; ancak rabbin buyurdu ki: O bana kolaydır. Biz, onu insanlara bir delil ve kendimizden bir rahmet kılacağız. Bu, kararlaştırılmış bir iştir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15902,
            "SureId": 19,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "Derken Meryem ona hamile kaldı, işte bu sebeple karnında bebeği ile uzak bir yere çekildi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15909,
            "SureId": 19,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "Sonra doğum sancısı onu bir hurma ağacının dibine getirdi. Meryem, “Keşke bundan önce ölseydim de unutulup gitseydim!” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15916,
            "SureId": 19,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "Aşağısından biri ona şöyle seslendi: “Tasalanma! Rabbin senin altında bir su kaynağı yaratmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15923,
            "SureId": 19,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 306,
            "AyetText": "(Şu) hurma ağacını da kendine doğru silkele ki, üzerine taze, olgun hurma ­dökülsün.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Meryem",
    "QuranSureLabel": "مَرْيَمَ",
    "EndPageSure": null
}