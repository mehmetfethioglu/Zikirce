    "QuranAyats": [
        {
            "Id": 18557,
            "SureId": 22,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "اَلْمُلْكُ یَوْمَئِذٍ لِلّٰهِؕ یَحْكُمُ بَیْنَهُمْؕ فَالَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ فٖی جَنَّاتِ النَّعٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 22,
                "MealInfo": "Âyetlerinin çoğu Mekke’de, bir kısmı ise Medine döneminde inmiştir. 78 âyettir. <b>Hac ibadetinden bahsettiği için bu adı almıştır.</b> Sûrede ayrıca kıyamet gününün dehşetinden, kıyamet günü yaşanacak sahnelerden, cihattan ve helâk edilmiş eski toplumlardan söz edilmektedir",
                "SureNameTurkish": "Hac",
                "SureNameArabic": "الْحَجِّ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 103,
                "AyetCount": 78,
                "Cuz": 17,
                "FirstPage": 332,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18564,
            "SureId": 22,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "وَالَّذٖینَ كَفَرُوا وَكَذَّبُوا بِاٰیَاتِنَا فَاُو𐻾لٰٓئِكَ لَهُمْ عَذَابٌ مُهٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18571,
            "SureId": 22,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "وَالَّذٖینَ هَاجَرُوا فٖی سَبٖیلِ اللّٰهِ ثُمَّ قُتِلُٓوا اَوْ مَاتُوا لَیَرْزُقَنَّهُمُ اللّٰهُ رِزْقًا حَسَنًاؕ وَاِنَّ اللّٰهَ لَهُوَ خَیْرُ الرَّازِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18578,
            "SureId": 22,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "لَیُدْخِلَنَّهُمْ مُدْخَلًا یَرْضَوْنَهُؕ وَاِنَّ اللّٰهَ لَعَلٖیمٌ حَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18585,
            "SureId": 22,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "ذٰلِكَۚ وَمَنْ عَاقَبَ بِمِثْلِ مَا عُوقِبَ بِهٖ ثُمَّ بُغِیَ عَلَیْهِ لَیَنْصُرَنَّهُ اللّٰهُؕ اِنَّ اللّٰهَ لَعَفُوٌّ غَفُورٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18592,
            "SureId": 22,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "ذٰلِكَ بِاَنَّ اللّٰهَ یُولِجُ الَّیْلَ فِی النَّهَارِ وَیُولِجُ النَّهَارَ فِی الَّیْلِ وَاَنَّ اللّٰهَ سَمٖیعٌ بَصٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18599,
            "SureId": 22,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "ذٰلِكَ بِاَنَّ اللّٰهَ هُوَ الْحَقُّ وَاَنَّ مَا یَدْعُونَ مِنْ دُونِهٖ هُوَ الْبَاطِلُ وَاَنَّ اللّٰهَ هُوَ الْعَلِیُّ الْكَبٖیرُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18606,
            "SureId": 22,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "اَلَمْ تَرَ اَنَّ اللّٰهَ اَنْزَلَ مِنَ السَّمَٓاءِ مَٓاءًؗ فَتُصْبِحُ الْاَرْضُ مُخْضَرَّةًؕ اِنَّ اللّٰهَ لَطٖیفٌ خَبٖیرٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18613,
            "SureId": 22,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "لَهُ مَا فِی السَّمٰوَاتِ وَمَا فِی الْاَرْضِؕ وَاِنَّ اللّٰهَ لَهُوَ الْغَنِیُّ الْحَمٖیدُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 18555,
            "SureId": 22,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "O gün hükümranlık yalnız Allah’ındır; onlar arasında hükmünü verir. İman edip dünya ve âhiret için yararlı işler yapmış olanlar, nimetlerle dolu cennetlerde olacaklardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 22,
                "MealInfo": "Âyetlerinin çoğu Mekke’de, bir kısmı ise Medine döneminde inmiştir. 78 âyettir. <b>Hac ibadetinden bahsettiği için bu adı almıştır.</b> Sûrede ayrıca kıyamet gününün dehşetinden, kıyamet günü yaşanacak sahnelerden, cihattan ve helâk edilmiş eski toplumlardan söz edilmektedir",
                "SureNameTurkish": "Hac",
                "SureNameArabic": "الْحَجِّ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 103,
                "AyetCount": 78,
                "Cuz": 17,
                "FirstPage": 332,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18562,
            "SureId": 22,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "İnkâr edip âyetlerimizi yalan sayanlara ise alçaltıcı bir azap vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18569,
            "SureId": 22,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "Allah yolunda hicret ettikten sonra öldürülen yahut ölenlere gelince, Allah onları pek güzel bir nimetle ödüllendirecektir. Allah rızık verenlerin elbette en hayırlısıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18576,
            "SureId": 22,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "Allah mutlaka onları hoşnut olacakları bir yere koyacaktır. Kuşkusuz Allah hakkıyla bilendir, halîmdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18583,
            "SureId": 22,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "Böyledir; her kim kendisine yapılana misliyle karşılık verir, sonra yine haksız bir saldırıya uğrarsa Allah ona mutlaka yardım eder. Allah çok bağışlayıcı, çok yarlığayıcıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18590,
            "SureId": 22,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "İşte böyle; Allah geceyi gündüze, gündüzü de geceye katar. Allah her şeyi işitir ve görür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18597,
            "SureId": 22,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "Böyledir; çünkü Allah hakkın ta kendisidir, O’nun dışında yalvarıp taptıkları ise bâtılın ta kendisidir. Ve şüphe yok ki yüce olan, ulu olan yalnız Allah’tır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18604,
            "SureId": 22,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "Görmüyor musun ki, Allah gökten su indiriyor da yeryüzü yemyeşil oluveriyor! Kuşkusuz Allah latîftir, her şeyden haberdardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18611,
            "SureId": 22,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 339,
            "AyetText": "Göklerde ve yerde ne varsa hep O’nundur. Şüphe yok ki kimseye muhtaç olmayan, her türlü övgüye lâyık olan yalnız Allah’tır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Hac",
    "QuranSureLabel": "الْحَجِّ",
    "EndPageSure": null
}