    "QuranAyats": [
        {
            "Id": 32417,
            "SureId": 50,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "قٓࣞ وَالْقُرْاٰنِ الْمَجٖیدِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 50,
                "MealInfo": "Mekke döneminde inmiştir. 45 âyettir. Sûre, adını başındaki <b>“Kâf ”</b> harfindenalmıştır. Sûrede başlıca <b>İslâm inancının temel esasları çerçevesinde, Allah’ın birliğinin delilleri, Peygamberlik, öldükten sonra dirilme ve geçmişteki inkârcı milletlerin başlarına gelen felaketler, uğradıkları azaplar konu</b> edilmektedir.",
                "SureNameTurkish": "Kâf",
                "SureNameArabic": "قۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 34,
                "AyetCount": 45,
                "Cuz": 26,
                "FirstPage": 518,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 32424,
            "SureId": 50,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "بَلْ عَجِبُٓوا اَنْ جَٓاءَهُمْ مُنْذِرٌ مِنْهُمْ فَقَالَ الْكَافِرُونَ هٰذَا شَیْءٌ عَجٖیبٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32431,
            "SureId": 50,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "ءَاِذَا مِتْنَا وَكُنَّا تُرَابًاۚ ذٰلِكَ رَجْعٌ بَعٖیدٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32438,
            "SureId": 50,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "قَدْ عَلِمْنَا مَا تَنْقُصُ الْاَرْضُ مِنْهُمْۚ وَعِنْدَنَا كِتَابٌ حَفٖیظٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32445,
            "SureId": 50,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "بَلْ كَذَّبُوا بِالْحَقِّ لَمَّا جَٓاءَهُمْ فَهُمْ فٖٓی اَمْرٍ مَرٖیجٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32452,
            "SureId": 50,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "اَفَلَمْ یَنْظُرُٓوا اِلَى السَّمَٓاءِ فَوْقَهُمْ كَیْفَ بَنَیْنَاهَا وَزَیَّنَّاهَا وَمَا لَهَا مِنْ فُرُوجٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32459,
            "SureId": 50,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "وَالْاَرْضَ مَدَدْنَاهَا وَاَلْقَیْنَا فٖیهَا رَوَاسِیَ وَاَنْبَتْنَا فٖیهَا مِنْ كُلِّ زَوْجٍ بَهٖیجٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32466,
            "SureId": 50,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "تَبْصِرَةً وَذِكْرٰى لِكُلِّ عَبْدٍ مُنٖیبٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32473,
            "SureId": 50,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "وَنَزَّلْنَا مِنَ السَّمَٓاءِ مَٓاءً مُبَارَكًا فَاَنْبَتْنَا بِهٖ جَنَّاتٍ وَحَبَّ الْحَصٖیدِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32480,
            "SureId": 50,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "وَالنَّخْلَ بَاسِقَاتٍ لَهَا طَلْعٌ نَضٖیدٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32487,
            "SureId": 50,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "رِزْقًا لِلْعِبَادِۙ وَاَحْیَیْنَا بِهٖ بَلْدَةً مَیْتًاؕ كَذٰلِكَ الْخُرُوجُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32494,
            "SureId": 50,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَاَصْحَابُ الرَّسِّ وَثَمُودُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32501,
            "SureId": 50,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "وَعَادٌ وَفِرْعَوْنُ وَاِخْوَانُ لُوطٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32508,
            "SureId": 50,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "وَاَصْحَابُ الْاَیْكَةِ وَقَوْمُ تُبَّعٍؕ كُلٌّ كَذَّبَ الرُّسُلَ فَحَقَّ وَعٖیدِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32515,
            "SureId": 50,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "اَفَعَیٖینَا بِالْخَلْقِ الْاَوَّلِؕ بَلْ هُمْ فٖی لَبْسٍ مِنْ خَلْقٍ جَدٖیدٍࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 32415,
            "SureId": 50,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Kāf. Şanı yüce Kur’an’a yemin olsun!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 50,
                "MealInfo": "Mekke döneminde inmiştir. 45 âyettir. Sûre, adını başındaki <b>“Kâf ”</b> harfindenalmıştır. Sûrede başlıca <b>İslâm inancının temel esasları çerçevesinde, Allah’ın birliğinin delilleri, Peygamberlik, öldükten sonra dirilme ve geçmişteki inkârcı milletlerin başlarına gelen felaketler, uğradıkları azaplar konu</b> edilmektedir.",
                "SureNameTurkish": "Kâf",
                "SureNameArabic": "قۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 34,
                "AyetCount": 45,
                "Cuz": 26,
                "FirstPage": 518,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 32422,
            "SureId": 50,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2-3",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Kâfirler, içlerinden bir uyarıcının gelmesine şaştılar da, “Bu tuhaf bir şey, öldükten ve toprak olduktan sonra mı (dirileceğiz)? Bu olmayacak bir dönüş!” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32429,
            "SureId": 50,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": false,
            "Page": 518,
            "AyetText": "",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32436,
            "SureId": 50,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Yerin onlardan neyi eksilttiğini (çürüttüğünü) bilmekteyiz; bizde her şeyi saklayan bir kayıt vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32443,
            "SureId": 50,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Ayrıca bunlar gerçeği kendilerine geldiğinde hemen yalanladılar; tam bir tutarsızlık içindeler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32450,
            "SureId": 50,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Üstlerindeki göğe bakmıyorlar mı? Hiçbir kusuru olmaksızın onu nasıl kurduk, nasıl süsledik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32457,
            "SureId": 50,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Yeryüzünü de düzledik, üzerine sarsılmaz dağlar yerleştirdik, orada her türden güzel bitkiler yetiştirdik;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32464,
            "SureId": 50,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Bize yönelen her kula aydınlatıcı ve hatırlatıcı olsun diye.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32471,
            "SureId": 50,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Gökten bereketli yağmurlar indirdik, onunla nice bahçeler ve hasat edilen tahıllar yetiştirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32478,
            "SureId": 50,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Bir de salkım salkım meyvesiyle göğe uzanan hurma ağaçları...",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32485,
            "SureId": 50,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Hepsi kullara rızık olsun diye. O yağmurla ölü toprağa can verdik. İşte insanların mezardan çıkışları da böyle olacak.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32492,
            "SureId": 50,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Bunlardan önce Nûh kavmi, Ress ve Semûd halkı,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32499,
            "SureId": 50,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Âd, Firavun ve Lût’un kardeşleri,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32506,
            "SureId": 50,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Eykeliler ve Tübba‘ kavmi de yalanlamışlar, hepsi peygamberleri yalancılıkla suçlamıştı; sonunda onları uyardığım şey başlarına geldi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32513,
            "SureId": 50,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 518,
            "AyetText": "Düşünseler ya, ilk yaratışta acze düştük mü? Buna rağmen onlar yeni bir yaratma konusunda şüphe içindeler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
