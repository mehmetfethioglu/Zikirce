    "QuranAyats": [
        {
            "Id": 22652,
            "SureId": 27,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "وَاِنَّهُ لَهُدًى وَرَحْمَةٌ لِلْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 27,
                "MealInfo": "Mekke döneminde inmiştir. 93 âyettir. Sûre, adını 18. âyette yer alan <b>“enNeml</b>” kelimesinden almaktadır. <b>Neml, karınca demektir. </b>Sûre de başlıca, <b>Süleyman peygamber ve Sebe’ melikesi, Belkıs kıssası ile Salih ve Lût peygamberler&nbsp;</b>konu edilmekte, ayrıca mü’minlerin kurtuluşa ereceği, İslâm karşıtlarının kötü akıbetleri, öldükten sonra dirilmek ve kıyamet dile getirilmektedir.",
                "SureNameTurkish": "Neml",
                "SureNameArabic": "النَّمْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 48,
                "AyetCount": 93,
                "Cuz": 19,
                "FirstPage": 377,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 22659,
            "SureId": 27,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "اِنَّ رَبَّكَ یَقْضٖی بَیْنَهُمْ بِحُكْمِهٖۚ وَهُوَ الْعَزٖیزُ الْعَلٖیمُۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22666,
            "SureId": 27,
            "AyetId": 79,
            "LanguageId": 7,
            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "فَتَوَكَّلْ عَلَى اللّٰهِؕ اِنَّكَ عَلَى الْحَقِّ الْمُبٖینِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22673,
            "SureId": 27,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "اِنَّكَ لَا تُسْمِـعُ الْمَوْتٰى وَلَا تُسْمِـعُ الصُّمَّ الدُّعَٓاءَ اِذَا وَلَّوْا مُدْبِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22680,
            "SureId": 27,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "وَمَٓا اَنْتَ بِهَادِی الْعُمْیِ عَنْ ضَلَالَتِهِمْؕ اِنْ تُسْمِـعُ اِلَّا مَنْ یُؤْمِنُ بِاٰیَاتِنَا فَهُمْ مُسْلِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22687,
            "SureId": 27,
            "AyetId": 82,
            "LanguageId": 7,
            "AyetNumber": "٨٢",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "وَاِذَا وَقَعَ الْقَوْلُ عَلَیْهِمْ اَخْرَجْنَا لَهُمْ دَٓابَّةً مِنَ الْاَرْضِ تُكَلِّمُهُمْۙ اَنَّ النَّاسَ كَانُوا بِاٰیَاتِنَا لَا یُوقِنُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22694,
            "SureId": 27,
            "AyetId": 83,
            "LanguageId": 7,
            "AyetNumber": "٨٣",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "وَیَوْمَ نَحْشُرُ مِنْ كُلِّ اُمَّةٍ فَوْجًا مِمَّنْ یُكَذِّبُ بِاٰیَاتِنَا فَهُمْ یُوزَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22701,
            "SureId": 27,
            "AyetId": 84,
            "LanguageId": 7,
            "AyetNumber": "٨٤",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "حَتّٰٓى اِذَا جَٓاؤُ𐻿 قَالَ اَكَذَّبْتُمْ بِاٰیَاتٖی وَلَمْ تُحٖیطُوا بِهَا عِلْمًا اَمَّاذَا كُنْتُمْ تَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22708,
            "SureId": 27,
            "AyetId": 85,
            "LanguageId": 7,
            "AyetNumber": "٨٥",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "وَوَقَعَ الْقَوْلُ عَلَیْهِمْ بِمَا ظَلَمُوا فَهُمْ لَا یَنْطِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22715,
            "SureId": 27,
            "AyetId": 86,
            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "اَلَمْ یَرَوْا اَنَّا جَعَلْنَا الَّیْلَ لِیَسْكُنُوا فٖیهِ وَالنَّهَارَ مُبْصِرًاؕ اِنَّ فٖی ذٰلِكَ لَاٰیَاتٍ لِقَوْمٍ یُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22722,
            "SureId": 27,
            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "وَیَوْمَ یُنْفَخُ فِی الصُّورِ فَفَزِعَ مَنْ فِی السَّمٰوَاتِ وَمَنْ فِی الْاَرْضِ اِلَّا مَنْ شَٓاءَ اللّٰهُؕ وَكُلٌّ اَتَوْهُ دَاخِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22729,
            "SureId": 27,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "وَتَرَى الْجِبَالَ تَحْسَبُهَا جَامِدَةً وَهِیَ تَمُرُّ مَرَّ السَّحَابِؕ صُنْعَ اللّٰهِ الَّذٖٓی اَتْقَنَ كُلَّ شَیْءٍؕ اِنَّهُ خَبٖیرٌ بِمَا تَفْعَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 22650,
            "SureId": 27,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "Şüphesiz o, müminler için bir hidayet rehberi ve bir rahmettir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 27,
                "MealInfo": "Mekke döneminde inmiştir. 93 âyettir. Sûre, adını 18. âyette yer alan <b>“enNeml</b>” kelimesinden almaktadır. <b>Neml, karınca demektir. </b>Sûre de başlıca, <b>Süleyman peygamber ve Sebe’ melikesi, Belkıs kıssası ile Salih ve Lût peygamberler&nbsp;</b>konu edilmekte, ayrıca mü’minlerin kurtuluşa ereceği, İslâm karşıtlarının kötü akıbetleri, öldükten sonra dirilmek ve kıyamet dile getirilmektedir.",
                "SureNameTurkish": "Neml",
                "SureNameArabic": "النَّمْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 48,
                "AyetCount": 93,
                "Cuz": 19,
                "FirstPage": 377,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 22657,
            "SureId": 27,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "Gerçek şu ki rabbin onların arasında hükmünü verecektir. O çok güçlüdür, her şeyi bilmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22664,
            "SureId": 27,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "O halde sen Allah’a güvenip dayan. Çünkü sen apaçık hakikat üzeresin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22671,
            "SureId": 27,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "Bil ki sen ölülere işittiremezsin, arkalarını dönüp giderlerken sağırlara da çağrıyı duyuramazsın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22678,
            "SureId": 27,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "Sen körleri yanlış yoldan doğruya yönlendiremezsin. Sen (çağrını) ancak âyetlerimize inanıp teslim olanlara duyurabilirsin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22685,
            "SureId": 27,
            "AyetId": 82,
            "LanguageId": 5,
            "AyetNumber": "82",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "Söylenen (kıyamet) başlarına geldiği zaman, onlara yerden bir yaratık çıkarırız da insanların âyetlerimize kesin bir şekilde iman etmedikleri konusunda onlarla konuşur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22692,
            "SureId": 27,
            "AyetId": 83,
            "LanguageId": 5,
            "AyetNumber": "83",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "O gün her ümmet içinden, âyetlerimizi yalan sayan grupları bir araya getiririz. Onlar düzenli bir şekilde (hesap yerine) sevkedilirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22699,
            "SureId": 27,
            "AyetId": 84,
            "LanguageId": 5,
            "AyetNumber": "84",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "Nihayet oraya geldikleri zaman Allah buyurur: “Siz benim âyetlerimi, ne olduğunu kavramadan yalan saydınız öyle mi? Değilse yaptığınız neydi?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22706,
            "SureId": 27,
            "AyetId": 85,
            "LanguageId": 5,
            "AyetNumber": "85",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "Zulme saptıkları için kendileri hakkındaki söz gerçekleşmiştir; artık konuşamazlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22713,
            "SureId": 27,
            "AyetId": 86,
            "LanguageId": 5,
            "AyetNumber": "86",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "Dinlensinler diye geceyi yarattığımızı, gündüzü de aydınlık kıldığımızı görmediler mi? İman eden bir kavim için elbette bunda ibretler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22720,
            "SureId": 27,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "Sûrun üflendiği gün, Allah’ın diledikleri dışında, göklerde ve yerde bulunanlar dehşete kapılır, hepsi boyunları bükük olarak O’na gelirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22727,
            "SureId": 27,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": true,
            "Page": 384,
            "AyetText": "Dağları görür, onların durduğunu sanırsın; oysa bulutlar gibi hareket ederler. Bu, her şeyi sapasağlam yapan Allah’ın sanatıdır. Şüphesiz ki O, yaptıklarınızdan tamamıyla haberdardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Neml",
    "QuranSureLabel": "النَّمْلِ",
    "EndPageSure": null
}