            "SureId": 96,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "اِنَّ اِلٰى رَبِّكَ الرُّجْعٰىؕ",
