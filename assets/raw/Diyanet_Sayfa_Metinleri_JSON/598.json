            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Ancak iman edip dünya ve âhiret için yararlı işler yapanlar başka; onlar için kesintisiz bir ödül vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 95,
                "MealInfo": "Mekke döneminde inmiştir. 8 âyettir. Tîn, incir demektir",
                "SureNameTurkish": "Tîn",
                "SureNameArabic": "التّ۪ينِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 28,
                "AyetCount": 8,
                "Cuz": 30,
                "FirstPage": 597,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42733,
            "SureId": 95,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Artık bu kanıtlardan sonra (ey insan!) sana dini inkâr ettiren şey nedir?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42740,
            "SureId": 95,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Allah hüküm verenlerin en âdili değil midir?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42747,
            "SureId": 96,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Yaratan rabbinin adıyla oku!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 96,
                "MealInfo": "Mekke döneminde inmiştir. 19 âyettir. Sûre, adını ikinci âyette geçen “alak”kelimesinden almıştır.",
                "SureNameTurkish": "Alak",
                "SureNameArabic": "الْعَلَقِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 1,
                "AyetCount": 19,
                "Cuz": 30,
                "FirstPage": 598,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42754,
            "SureId": 96,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "O, insanı alaktan (asılıp tutunan zigottan) yaratmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42761,
            "SureId": 96,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3-5",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Oku! Kalemle (yazmayı) öğreten, (böylece) insana bilmediğini bildiren rabbin sonsuz kerem sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42768,
            "SureId": 96,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": false,
            "Page": 598,
            "AyetText": "Oku! Kalemle (yazmayı) öğreten, (böylece) insana bilmediğini bildiren rabbin sonsuz kerem sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42775,
            "SureId": 96,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": false,
            "Page": 598,
            "AyetText": "Oku! Kalemle (yazmayı) öğreten, (böylece) insana bilmediğini bildiren rabbin sonsuz kerem sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42782,
            "SureId": 96,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6-7",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Hayır! Gerçek şu ki insan, kendini kendine yeterli gördüğü için çizgiyi aşar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42789,
            "SureId": 96,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": false,
            "Page": 598,
            "AyetText": "Hayır! Gerçek şu ki insan, kendini kendine yeterli görerek çizgiyi aşar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42796,
            "SureId": 96,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Oysa (kuldaki) her şey yalnız rabbine aittir (O’na dönecektir).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42803,
            "SureId": 96,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9-10",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Gördün mü, bir kulu namaz kılarken engelleyen o adamı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42810,
            "SureId": 96,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": false,
            "Page": 598,
            "AyetText": "Gördün mü, bir kulu namaz kılarken engelleyen o adamı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42817,
            "SureId": 96,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Peki, düşündün mü (ey inkârcı), ya o kul doğru yolda ise?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42824,
            "SureId": 96,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Yahut günahtan sakınmaya çağırıyorsa!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42831,
            "SureId": 96,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Düşündün mü (ey resulüm), ya o adam hakkı inkâr ediyor, sırt çeviriyorsa!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42838,
            "SureId": 96,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Allah’ın her şeyi gördüğünü bilmiyor mu o?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42845,
            "SureId": 96,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Hayır hayır! Eğer vazgeçmezse mutlaka onu perçeminden yakalayıp sürükleriz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42852,
            "SureId": 96,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "O yalancı, günahkâr perçeminden!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42859,
            "SureId": 96,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "O hemen kurultayını çağırsın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42866,
            "SureId": 96,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Biz de zebânileri çağıracağız!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42873,
            "SureId": 96,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "Sakın onun isteğine uyma! Secdeye kapan ve Allah’a yakınlaş.",
