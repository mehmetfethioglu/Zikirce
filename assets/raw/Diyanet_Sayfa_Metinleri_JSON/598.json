            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "كَلَّٓا اِنَّ الْاِنْسَانَ لَیَطْغٰىۙ",
