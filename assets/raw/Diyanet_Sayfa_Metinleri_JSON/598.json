            "SureId": 96,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "كَلَّا لَئِنْ لَمْ یَنْتَهِ𐻾 لَنَسْفَعًا بِالنَّاصِیَةِۙ",
