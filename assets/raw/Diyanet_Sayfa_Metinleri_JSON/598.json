            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "عَبْدًا اِذَا صَلّٰىؕ",
            "Recitation": "",
