            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "عَلَّمَ الْاِنْسَانَ مَا لَمْ یَعْلَمْؕ",
