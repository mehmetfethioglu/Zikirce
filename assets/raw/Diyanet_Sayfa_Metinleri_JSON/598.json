            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "اَرَاَیْتَ اِنْ كَانَ عَلَى الْهُدٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42826,
            "SureId": 96,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "اَوْ اَمَرَ بِالتَّقْوٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42833,
            "SureId": 96,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "اَرَاَیْتَ اِنْ كَذَّبَ وَتَوَلّٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42840,
            "SureId": 96,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 598,
            "AyetText": "اَلَمْ یَعْلَمْ بِاَنَّ اللّٰهَ یَرٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
