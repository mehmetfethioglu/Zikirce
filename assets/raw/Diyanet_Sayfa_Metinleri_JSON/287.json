    "QuranAyats": [
        {
            "Id": 14553,
            "SureId": 17,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "قُلْ كُونُوا حِجَارَةً اَوْ حَدٖیدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14560,
            "SureId": 17,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "اَوْ خَلْقًا مِمَّا یَكْبُرُ فٖی صُدُورِكُمْۚ فَسَیَقُولُونَ مَنْ یُعٖیدُنَاؕ قُلِ الَّذٖی فَطَرَكُمْ اَوَّلَ مَرَّةٍۚ فَسَیُنْغِضُونَ اِلَیْكَ رُؤُ𐻿سَهُمْ وَیَقُولُونَ مَتٰى هُوَؕ قُلْ عَسٰٓى اَنْ یَكُونَ قَرٖیبًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14567,
            "SureId": 17,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "یَوْمَ یَدْعُوكُمْ فَتَسْتَجٖیبُونَ بِحَمْدِهٖ وَتَظُنُّونَ اِنْ لَبِثْتُمْ اِلَّا قَلٖیلًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14574,
            "SureId": 17,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "وَقُلْ لِعِبَادٖی یَقُولُوا الَّتٖی هِیَ اَحْسَنُؕ اِنَّ الشَّیْطَانَ یَنْزَغُ بَیْنَهُمْؕ اِنَّ الشَّیْطَانَ كَانَ لِلْاِنْسَانِ عَدُوًّا مُبٖینًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14581,
            "SureId": 17,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "رَبُّكُمْ اَعْلَمُ بِكُمْؕ اِنْ یَشَاْ یَرْحَمْكُمْ اَوْ اِنْ یَشَاْ یُعَذِّبْكُمْؕ وَمَٓا اَرْسَلْنَاكَ عَلَیْهِمْ وَكٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14588,
            "SureId": 17,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "وَرَبُّكَ اَعْلَمُ بِمَنْ فِی السَّمٰوَاتِ وَالْاَرْضِؕ وَلَقَدْ فَضَّلْنَا بَعْضَ النَّبِیّٖنَ عَلٰى بَعْضٍ وَاٰتَیْنَا دَاوُ𐻿دَ زَبُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14595,
            "SureId": 17,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "قُلِ ادْعُوا الَّذٖینَ زَعَمْتُمْ مِنْ دُونِهٖ فَلَا یَمْلِكُونَ كَشْفَ الضُّرِّ عَنْكُمْ وَلَا تَحْوٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14602,
            "SureId": 17,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "اُو𐻾لٰٓئِكَ الَّذٖینَ یَدْعُونَ یَبْتَغُونَ اِلٰى رَبِّهِمُ الْوَسٖیلَةَ اَیُّهُمْ اَقْرَبُ وَیَرْجُونَ رَحْمَتَهُ وَیَخَافُونَ عَذَابَهُؕ اِنَّ عَذَابَ رَبِّكَ كَانَ مَحْذُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14609,
            "SureId": 17,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "وَاِنْ مِنْ قَرْیَةٍ اِلَّا نَحْنُ مُهْلِكُوهَا قَبْلَ یَوْمِ الْقِیٰمَةِ اَوْ مُعَذِّبُوهَا عَذَابًا شَدٖیدًاؕ كَانَ ذٰلِكَ فِی الْكِتَابِ مَسْطُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 14551,
            "SureId": 17,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "De ki: “İster taş olun ister demir;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14558,
            "SureId": 17,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "İsterse canlanmasını aklınızın almadığı herhangi bir yaratık!” Bu defa da “Bizi tekrar hayata kim döndürecek?” diyecekler. “Sizi birinci defa yaratan” de. Sonunda onlar, sana alaylı bir tarzda başlarını sallayacak ve “Ne zamanmış o?” diye soracaklar. De ki: “Yakın olduğunu sanıyorum.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14565,
            "SureId": 17,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "O gün Allah sizi çağıracak ve siz, (dünyada) çok az kaldığınız zannı içinde O’na hamdederek çağrısına uyacaksınız.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14572,
            "SureId": 17,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "Kullarıma söyle, sözün en güzelini söylesinler; yoksa şeytan aralarına girer. Kuşkusuz şeytan insanların apaçık düşmanıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14579,
            "SureId": 17,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "Sizi en iyi bilen rabbinizdir. Dilerse size merhamet eder, dilerse sizi cezalandırır. Biz seni onlardan sorumlu bir vekil olarak göndermedik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14586,
            "SureId": 17,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "Göklerde ve yerde olanları en iyi bilen senin rabbindir. Doğrusu biz peygamberlerin kimini kiminden üstün kıldık; Dâvûd’a da Zebûr’u verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14593,
            "SureId": 17,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "De ki: “Allah’ı bırakıp da tanrı olduğunu ileri sürdüklerinize yalvarın! Ama onlar sizin sıkıntınızı ne kaldırabilir ne de ferahlığa çevirebilirler.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14600,
            "SureId": 17,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "Bu insanların yalvardıkları o varlıkların Allah’a en yakın olanları bile rablerine daha yakın olabilmek için vesile ararlar; O’nun rahmetini umar, azabından korkarlar. Rabbinin azabı gerçekten sakınılması gereken bir azaptır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14607,
            "SureId": 17,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 287,
            "AyetText": "(Günaha batmış) ne kadar ülke varsa hepsini kıyamet gününden önce ya helâk etmiş veya onları çetin bir şekilde azaba uğratmış olacağız. Bu, kitapta yazılıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
