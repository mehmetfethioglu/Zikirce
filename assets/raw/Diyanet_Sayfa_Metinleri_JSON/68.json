        },
        {
            "Id": 3045,
            "SureId": 3,
            "AyetId": 142,
            "LanguageId": 7,
            "AyetNumber": "١٤٢",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "اَمْ حَسِبْتُمْ اَنْ تَدْخُلُوا الْجَنَّةَ وَلَمَّا یَعْلَمِ اللّٰهُ الَّذٖینَ جَاهَدُوا مِنْكُمْ وَیَعْلَمَ الصَّابِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3052,
            "SureId": 3,
            "AyetId": 143,
            "LanguageId": 7,
            "AyetNumber": "١٤٣",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "وَلَقَدْ كُنْتُمْ تَمَنَّوْنَ الْمَوْتَ مِنْ قَبْلِ اَنْ تَلْقَوْهُࣕ فَقَدْ رَاَیْتُمُوهُ وَاَنْتُمْ تَنْظُرُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3059,
            "SureId": 3,
            "AyetId": 144,
            "LanguageId": 7,
            "AyetNumber": "١٤٤",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "وَمَا مُحَمَّدٌ اِلَّا رَسُولٌۚ قَدْ خَلَتْ مِنْ قَبْلِهِ الرُّسُلُؕ اَفَا𐻾ئِنْ مَاتَ اَوْ قُتِلَ انْقَلَبْتُمْ عَلٰٓى اَعْقَابِكُمْؕ وَمَنْ یَنْقَلِبْ عَلٰى عَقِبَیْهِ فَلَنْ یَضُرَّ اللّٰهَ شَیْـًٔاؕ وَسَیَجْزِی اللّٰهُ الشَّاكِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3066,
            "SureId": 3,
            "AyetId": 145,
            "LanguageId": 7,
            "AyetNumber": "١٤٥",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "وَمَا كَانَ لِنَفْسٍ اَنْ تَمُوتَ اِلَّا بِاِذْنِ اللّٰهِ كِتَابًا مُؤَجَّلًاؕ وَمَنْ یُرِدْ ثَوَابَ الدُّنْیَا نُؤْتِهٖ مِنْهَاۚ وَمَنْ یُرِدْ ثَوَابَ الْاٰخِرَةِ نُؤْتِهٖ مِنْهَاؕ وَسَنَجْزِی الشَّاكِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3073,
            "SureId": 3,
            "AyetId": 146,
            "LanguageId": 7,
            "AyetNumber": "١٤٦",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "وَكَاَیِّنْ مِنْ نَبِیٍّ قَاتَلَۙ مَعَهُ رِبِّیُّونَ كَثٖیرٌۚ فَمَا وَهَنُوا لِمَٓا اَصَابَهُمْ فٖی سَبٖیلِ اللّٰهِ وَمَا ضَعُفُوا وَمَا اسْتَكَانُواؕ وَاللّٰهُ یُحِبُّ الصَّابِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3080,
            "SureId": 3,
            "AyetId": 147,
            "LanguageId": 7,
            "AyetNumber": "١٤٧",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "وَمَا كَانَ قَوْلَهُمْ اِلَّٓا اَنْ قَالُوا رَبَّنَا اغْفِرْ لَنَا ذُنُوبَنَا وَاِسْرَافَنَا فٖٓی اَمْرِنَا وَثَبِّتْ اَقْدَامَنَا وَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3087,
            "SureId": 3,
            "AyetId": 148,
            "LanguageId": 7,
            "AyetNumber": "١٤٨",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "فَاٰتٰیهُمُ اللّٰهُ ثَوَابَ الدُّنْیَا وَحُسْنَ ثَوَابِ الْاٰخِرَةِؕ وَاللّٰهُ یُحِبُّ الْمُحْسِنٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 3036,
            "SureId": 3,
            "AyetId": 141,
            "LanguageId": 5,
            "AyetNumber": "141",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "Bir de Allah, iman edenleri günahlardan arındırmak, kâfirleri de yok etmek için böyle yapıyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 3043,
            "SureId": 3,
            "AyetId": 142,
            "LanguageId": 5,
            "AyetNumber": "142",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "Yoksa, Allah içinizden cihad edenleri ortaya çıkarmadan ve sabredenleri belirlemeden cennete gireceğinizi mi sanıyordunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3050,
            "SureId": 3,
            "AyetId": 143,
            "LanguageId": 5,
            "AyetNumber": "143",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "Gerçek şu ki, ölümle karşılaşmadan önce onu istiyordunuz; işte şimdi onu apaçık görmektesiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3057,
            "SureId": 3,
            "AyetId": 144,
            "LanguageId": 5,
            "AyetNumber": "144",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "Muhammed yalnızca bir elçidir. Ondan önce de elçiler gelip geçti. Şimdi o ölür veya öldürülürse gerisin geri dönecek misiniz? Kim geri dönerse bilsin ki Allah’a asla bir zarar vermiş olmayacaktır. Allah şükredenleri ödüllendirecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3064,
            "SureId": 3,
            "AyetId": 145,
            "LanguageId": 5,
            "AyetNumber": "145",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "Hiçbir kimse Allah’ın yazılıp bir süreye bağlanmış izni olmadan ölmez. Kim dünya nimetini isterse ondan kendisine veririz; kim âhiret nimetini isterse ona da ondan veririz; ve şükredenleri ödüllendireceğiz.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3071,
            "SureId": 3,
            "AyetId": 146,
            "LanguageId": 5,
            "AyetNumber": "146",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "Nice peygamber vardır ki onunla birlikte birçok Allah erleri savaştılar. Allah yolunda başlarına gelenlerden ötürü gevşemediler, yılmadılar, boyun eğmediler. Allah, sabredenleri sever.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3078,
            "SureId": 3,
            "AyetId": 147,
            "LanguageId": 5,
            "AyetNumber": "147",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "Onların sözü şunu demekten ibaretti: “Rabbimiz! Günahlarımızdan ve işimizdeki aşırılıklardan ötürü bizi bağışla, sebatımızı arttır, kâfir topluluğa karşı bize yardım et!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3085,
            "SureId": 3,
            "AyetId": 148,
            "LanguageId": 5,
            "AyetNumber": "148",
            "AyetVisible": true,
            "Page": 68,
            "AyetText": "Bu yüzden Allah onlara dünya nimetini ve âhiret nimetinin de güzelini verdi. Allah işini güzel yapanları sever.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
