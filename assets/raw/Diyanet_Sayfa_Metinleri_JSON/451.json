            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27475,
            "SureId": 37,
            "AyetId": 137,
            "LanguageId": 7,
            "AyetNumber": "١٣٧",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "وَاِنَّكُمْ لَتَمُرُّونَ عَلَیْهِمْ مُصْبِحٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27482,
            "SureId": 37,
            "AyetId": 138,
            "LanguageId": 7,
            "AyetNumber": "١٣٨",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "وَبِالَّیْلِؕ اَفَلَا تَعْقِلُونَࣖ",
