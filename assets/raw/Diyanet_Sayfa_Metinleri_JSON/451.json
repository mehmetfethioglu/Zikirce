            "SureId": 37,
            "AyetId": 133,
            "LanguageId": 7,
            "AyetNumber": "١٣٣",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "وَاِنَّ لُوطًا لَمِنَ الْمُرْسَلٖینَؕ",
