            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27489,
            "SureId": 37,
            "AyetId": 139,
            "LanguageId": 7,
            "AyetNumber": "١٣٩",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "وَاِنَّ یُونُسَ لَمِنَ الْمُرْسَلٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27496,
            "SureId": 37,
            "AyetId": 140,
            "LanguageId": 7,
            "AyetNumber": "١٤٠",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "اِذْ اَبَقَ اِلَى الْفُلْكِ الْمَشْحُونِۙ",
