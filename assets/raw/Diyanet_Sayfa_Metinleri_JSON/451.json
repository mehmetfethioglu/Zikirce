            "AyetId": 129,
            "LanguageId": 7,
            "AyetNumber": "١٢٩",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "وَتَرَكْنَا عَلَیْهِ فِی الْاٰخِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
