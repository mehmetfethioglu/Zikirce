            "SureId": 37,
            "AyetId": 144,
            "LanguageId": 7,
            "AyetNumber": "١٤٤",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "لَلَبِثَ فٖی بَطْنِهٖٓ اِلٰى یَوْمِ یُبْعَثُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27531,
            "SureId": 37,
            "AyetId": 145,
            "LanguageId": 7,
            "AyetNumber": "١٤٥",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "فَنَبَذْنَاهُ بِالْعَرَٓاءِ وَهُوَ سَقٖیمٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27538,
            "SureId": 37,
            "AyetId": 146,
            "LanguageId": 7,
            "AyetNumber": "١٤٦",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "وَاَنْبَتْنَا عَلَیْهِ شَجَرَةً مِنْ یَقْطٖینٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27545,
            "SureId": 37,
            "AyetId": 147,
            "LanguageId": 7,
            "AyetNumber": "١٤٧",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "وَاَرْسَلْنَاهُ اِلٰى مِائَةِ اَلْفٍ اَوْ یَزٖیدُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27552,
            "SureId": 37,
            "AyetId": 148,
            "LanguageId": 7,
            "AyetNumber": "١٤٨",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "فَاٰمَنُوا فَمَتَّعْنَاهُمْ اِلٰى حٖینٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27559,
            "SureId": 37,
            "AyetId": 149,
            "LanguageId": 7,
            "AyetNumber": "١٤٩",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "فَاسْتَفْتِهِمْ اَلِرَبِّكَ الْبَنَاتُ وَلَهُمُ الْبَنُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27566,
            "SureId": 37,
            "AyetId": 150,
            "LanguageId": 7,
            "AyetNumber": "١٥٠",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "اَمْ خَلَقْنَا الْمَلٰٓئِكَةَ اِنَاثًا وَهُمْ شَاهِدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27573,
            "SureId": 37,
            "AyetId": 151,
            "LanguageId": 7,
            "AyetNumber": "١٥١",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "اَلَٓا اِنَّهُمْ مِنْ اِفْكِهِمْ لَیَقُولُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27580,
            "SureId": 37,
            "AyetId": 152,
            "LanguageId": 7,
            "AyetNumber": "١٥٢",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "وَلَدَ اللّٰهُۙ وَاِنَّهُمْ لَكَاذِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27587,
            "SureId": 37,
            "AyetId": 153,
            "LanguageId": 7,
            "AyetNumber": "١٥٣",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "اَصْطَفَى الْبَنَاتِ عَلَى الْبَنٖینَؕ",
            "Recitation": "",
