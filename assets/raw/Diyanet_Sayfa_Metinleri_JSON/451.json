            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27461,
            "SureId": 37,
            "AyetId": 135,
            "LanguageId": 7,
            "AyetNumber": "١٣٥",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "اِلَّا عَجُوزًا فِی الْغَابِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
