            "AyetId": 132,
            "LanguageId": 7,
            "AyetNumber": "١٣٢",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "اِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنٖینَ",
