            "AyetId": 131,
            "LanguageId": 5,
            "AyetNumber": "131",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "İşte iyileri biz böyle ödüllendiririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27438,
            "SureId": 37,
            "AyetId": 132,
            "LanguageId": 5,
            "AyetNumber": "132",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "Çünkü o bizim mümin kullarımızdandı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27445,
            "SureId": 37,
            "AyetId": 133,
            "LanguageId": 5,
            "AyetNumber": "133",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "Kuşkusuz Lût da elçilerimizdendi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27452,
            "SureId": 37,
            "AyetId": 134,
            "LanguageId": 5,
            "AyetNumber": "134-135",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "Geride kalanlar arasında bırakılan yaşlı bir kadın dışında onu ve bütün ailesini kurtarmıştık;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
