            "AyetId": 129,
            "LanguageId": 5,
            "AyetNumber": "129-130",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "Onun hakkında, “İlyâs’a selâm olsun!” ifadesini sonradan gelen nesiller arasında devam ettirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27424,
            "SureId": 37,
            "AyetId": 130,
            "LanguageId": 5,
            "AyetNumber": "130",
            "AyetVisible": false,
            "Page": 451,
            "AyetText": "Onun hakkında, \"İlyâs’a selâm olsun!\" ifadesini sonradan gelen nesiller arasında devam ettirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
