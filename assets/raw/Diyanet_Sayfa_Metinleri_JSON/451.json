            "SureId": 37,
            "AyetId": 136,
            "LanguageId": 7,
            "AyetNumber": "١٣٦",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "ثُمَّ دَمَّرْنَا الْاٰخَرٖینَ",
