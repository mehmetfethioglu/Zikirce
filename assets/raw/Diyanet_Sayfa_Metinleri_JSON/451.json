            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27433,
            "SureId": 37,
            "AyetId": 131,
            "LanguageId": 7,
            "AyetNumber": "١٣١",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "اِنَّا كَذٰلِكَ نَجْزِی الْمُحْسِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
