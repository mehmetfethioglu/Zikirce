        },
        {
            "Id": 27529,
            "SureId": 37,
            "AyetId": 145,
            "LanguageId": 5,
            "AyetNumber": "145",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "Sağlığı bozulmuş olarak onun ıssız bir kıyıya bırakılmasını sağladık;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27536,
            "SureId": 37,
            "AyetId": 146,
            "LanguageId": 5,
            "AyetNumber": "146",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "Üstüne (gölge yapması için) kabak türünden bir bitki bitirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27543,
            "SureId": 37,
            "AyetId": 147,
            "LanguageId": 5,
            "AyetNumber": "147",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "Bir defa daha onu yüz bin ya da daha fazla kişiye elçi olarak gönderdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27550,
            "SureId": 37,
            "AyetId": 148,
            "LanguageId": 5,
            "AyetNumber": "148",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "Bu defa onlar iman ettiler, biz de kendilerini belirli bir vakte kadar nimetlerimizle yaşattık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27557,
            "SureId": 37,
            "AyetId": 149,
            "LanguageId": 5,
            "AyetNumber": "149",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "Şimdi onlardan şunu cevaplamalarını iste: Kızlar rabbinin de erkek çocuklar onların mı!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27564,
            "SureId": 37,
            "AyetId": 150,
            "LanguageId": 5,
            "AyetNumber": "150",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "Yoksa biz, gözlerinin önünde melekleri dişi olarak mı yarattık?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27571,
            "SureId": 37,
            "AyetId": 151,
            "LanguageId": 5,
            "AyetNumber": "151-152",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "İyi bilin ki onlar, sırf kendi uydurmaları olarak, “Allah çocuk sahibi oldu!” diyorlar. Onlar katıksız yalancıdırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27578,
            "SureId": 37,
            "AyetId": 152,
            "LanguageId": 5,
            "AyetNumber": "152",
            "AyetVisible": false,
            "Page": 451,
            "AyetText": "İyi bilin ki onlar, sırf kendi uydurmaları olarak, \"Allah çocuk sahibi oldu!\" diyorlar. Onlar katıksız yalancıdırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27585,
            "SureId": 37,
            "AyetId": 153,
            "LanguageId": 5,
            "AyetNumber": "153",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "Allah, kızları oğlanlara tercih mi etmiş!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
