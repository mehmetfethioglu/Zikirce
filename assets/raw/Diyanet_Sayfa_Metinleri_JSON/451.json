            "Sure": null
        },
        {
            "Id": 27503,
            "SureId": 37,
            "AyetId": 141,
            "LanguageId": 7,
            "AyetNumber": "١٤١",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "فَسَاهَمَ فَكَانَ مِنَ الْمُدْحَضٖینَۚ",
