            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27454,
            "SureId": 37,
            "AyetId": 134,
            "LanguageId": 7,
            "AyetNumber": "١٣٤",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "اِذْ نَجَّیْنَاهُ وَاَهْلَهُٓ اَجْمَعٖینَۙ",
