            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27510,
            "SureId": 37,
            "AyetId": 142,
            "LanguageId": 7,
            "AyetNumber": "١٤٢",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "فَالْتَقَمَهُ الْحُوتُ وَهُوَ مُلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27517,
            "SureId": 37,
            "AyetId": 143,
            "LanguageId": 7,
            "AyetNumber": "١٤٣",
            "AyetVisible": true,
            "Page": 451,
            "AyetText": "فَلَوْلَٓا اَنَّهُ كَانَ مِنَ الْمُسَبِّحٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
