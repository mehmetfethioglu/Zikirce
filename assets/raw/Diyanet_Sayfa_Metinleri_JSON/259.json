            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "تُؤْتٖٓی اُكُلَهَا كُلَّ حٖینٍ بِاِذْنِ رَبِّهَاؕ وَیَضْرِبُ اللّٰهُ الْاَمْثَالَ لِلنَّاسِ لَعَلَّهُمْ یَتَذَكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 14,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. İçinde Hz. İbrahim’den ve ailesinden söz edildiği için bu adı almıştır. Sûre de başlıca imanın temel konuları olan Allah’a iman, peygamberlere iman, öldükten sonra dirilme ve hesap ele alınmaktadır.",
                "SureNameTurkish": "İbrâhîm",
                "SureNameArabic": "اِبْرٰه۪يمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 72,
                "AyetCount": 52,
                "Cuz": 13,
                "FirstPage": 255,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12432,
            "SureId": 14,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "وَمَثَلُ كَلِمَةٍ خَبٖیثَةٍ كَشَجَرَةٍ خَبٖیثَةٍࣙ اجْتُثَّتْ مِنْ فَوْقِ الْاَرْضِ مَا لَهَا مِنْ قَرَارٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12439,
            "SureId": 14,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "یُثَبِّتُ اللّٰهُ الَّذٖینَ اٰمَنُوا بِالْقَوْلِ الثَّابِتِ فِی الْحَیٰوةِ الدُّنْیَا وَفِی الْاٰخِرَةِۚ وَیُضِلُّ اللّٰهُ الظَّالِمٖینَ وَیَفْعَلُ اللّٰهُ مَا یَشَٓاءُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12446,
            "SureId": 14,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "اَلَمْ تَرَ اِلَى الَّذٖینَ بَدَّلُوا نِعْمَتَ اللّٰهِ كُفْرًا وَاَحَلُّوا قَوْمَهُمْ دَارَ الْبَوَارِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12453,
            "SureId": 14,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "جَهَنَّمَۚ یَصْلَوْنَهَاؕ وَبِئْسَ الْقَرَارُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12460,
            "SureId": 14,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "وَجَعَلُوا لِلّٰهِ اَنْدَادًا لِیُضِلُّوا عَنْ سَبٖیلِهٖؕ قُلْ تَمَتَّعُوا فَاِنَّ مَصٖیرَكُمْ اِلَى النَّارِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12467,
            "SureId": 14,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "قُلْ لِعِبَادِیَ الَّذٖینَ اٰمَنُوا یُقٖیمُوا الصَّلٰوةَ وَیُنْفِقُوا مِمَّا رَزَقْنَاهُمْ سِرًّا وَعَلَانِیَةً مِنْ قَبْلِ اَنْ یَاْتِیَ یَوْمٌ لَا بَیْعٌ فٖیهِ وَلَا خِلَالٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12474,
            "SureId": 14,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "اَللّٰهُ الَّذٖی خَلَقَ السَّمٰوَاتِ وَالْاَرْضَ وَاَنْزَلَ مِنَ السَّمَٓاءِ مَٓاءً فَاَخْرَجَ بِهٖ مِنَ الثَّمَرَاتِ رِزْقًا لَكُمْۚ وَسَخَّرَ لَكُمُ الْفُلْكَ لِتَجْرِیَ فِی الْبَحْرِ بِاَمْرِهٖۚ وَسَخَّرَ لَكُمُ الْاَنْهَارَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12481,
            "SureId": 14,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "وَسَخَّرَ لَكُمُ الشَّمْسَ وَالْقَمَرَ دَٓائِبَیْنِۚ وَسَخَّرَ لَكُمُ الَّیْلَ وَالنَّهَارَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 12423,
            "SureId": 14,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "O ağaç, rabbinin izniyle her zaman meyvesini verir. Öğüt alsınlar diye Allah insanlara böyle misaller getirmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 14,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. İçinde Hz. İbrahim’den ve ailesinden söz edildiği için bu adı almıştır. Sûre de başlıca imanın temel konuları olan Allah’a iman, peygamberlere iman, öldükten sonra dirilme ve hesap ele alınmaktadır.",
                "SureNameTurkish": "İbrâhîm",
                "SureNameArabic": "اِبْرٰه۪يمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 72,
                "AyetCount": 52,
                "Cuz": 13,
                "FirstPage": 255,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12430,
            "SureId": 14,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "Kötü sözün misali de kökü yerden sökülmüş, ayakta duramayan kötü bir ağaçtır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12437,
            "SureId": 14,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "Allah sağlam söze iman edenleri hem dünya hayatında hem de âhirette sağlam tutar; Allah zalimleri de şaşırtır ve Allah dilediğini yapar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12444,
            "SureId": 14,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28-29",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "Allah’ın lütfettiği nimete nankörlükle karşılık verip sonunda toplumlarını helâke uğrayacakları yere, cehenneme sürükleyenleri görmedin mi? Oraya girecekler; orası ne kötü karargâh!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12451,
            "SureId": 14,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": false,
            "Page": 259,
            "AyetText": "Allah’ın lutfettiği nimete nankörlükle karşılık verip sonunda toplumlarını helâke uğrayacakları yere, cehenneme sürükleyenleri görmedin mi? Oraya girecekler; orası ne kötü karargâh!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12458,
            "SureId": 14,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "Allah’a ortaklar koştular ki halkı O’nun yolundan saptırsınlar. De ki: “Biraz daha oyalanın; sonunda döneceğiniz yer ateştir!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12465,
            "SureId": 14,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "İman eden kullarıma söyle: Alım satımın bulunmadığı, dostluğun fayda vermediği o gün gelmeden önce namazlarını dosdoğru kılsınlar, onlara verdiğimiz rızıklardan Allah rızâsı için gizli ve açık harcasınlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12472,
            "SureId": 14,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "Gökleri ve yeri yaratan, gökten su indirip onunla size rızık olarak türlü türlü ürünler çıkaran Allah’tır; izni ile denizde yüzüp gitmeleri için gemileri emrinize veren, nehirleri sizin için faydalı olacak şekilde yaratan O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12479,
            "SureId": 14,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 259,
            "AyetText": "Düzenli seyreden güneşi ve ayı sizin için yararlı kılan, gece ile gündüzü faydalanacağınız biçimde yaratan O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
