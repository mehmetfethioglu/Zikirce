        {
            "Id": 1470,
            "SureId": 2,
            "AyetId": 203,
            "LanguageId": 7,
            "AyetNumber": "٢٠٣",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "وَاذْكُرُوا اللّٰهَ فٖٓی اَیَّامٍ مَعْدُودَاتٍؕ فَمَنْ تَعَجَّلَ فٖی یَوْمَیْنِ فَلَٓا اِثْمَ عَلَیْهِۚ وَمَنْ تَاَخَّرَ فَلَٓا اِثْمَ عَلَیْهِۙ لِمَنِ اتَّقٰىؕ وَاتَّقُوا اللّٰهَ وَاعْلَمُٓوا اَنَّكُمْ اِلَیْهِ تُحْشَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 2,
                "MealInfo": "Medine döneminde inmiştir. Kur’an-ı Kerim’in en uzun sûresi olup 286 âyettir. Adını, 67-73. âyetlerde yer alan <b>“bakara (<i>sığı</i>r)”</b> kelimesinden alır. Sûre, İslâm hukukunun ana konularıyla ilgili pek çok hüküm içermektedir.",
                "SureNameTurkish": "Bakara",
                "SureNameArabic": "الْبَقَرَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 87,
                "AyetCount": 286,
                "Cuz": 1,
                "FirstPage": 2,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 1477,
            "SureId": 2,
            "AyetId": 204,
            "LanguageId": 7,
            "AyetNumber": "٢٠٤",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "وَمِنَ النَّاسِ مَنْ یُعْجِبُكَ قَوْلُهُ فِی الْحَیٰوةِ الدُّنْیَا وَیُشْهِدُ اللّٰهَ عَلٰى مَا فٖی قَلْبِهٖۙ وَهُوَ اَلَدُّ الْخِصَامِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1484,
            "SureId": 2,
            "AyetId": 205,
            "LanguageId": 7,
            "AyetNumber": "٢٠٥",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "وَاِذَا تَوَلّٰى سَعٰى فِی الْاَرْضِ لِیُفْسِدَ فٖیهَا وَیُهْلِكَ الْحَرْثَ وَالنَّسْلَؕ وَاللّٰهُ لَا یُحِبُّ الْفَسَادَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1491,
            "SureId": 2,
            "AyetId": 206,
            "LanguageId": 7,
            "AyetNumber": "٢٠٦",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "وَاِذَا قٖیلَ لَهُ اتَّقِ اللّٰهَ اَخَذَتْهُ الْعِزَّةُ بِالْاِثْمِ فَحَسْبُهُ جَهَنَّمُؕ وَلَبِئْسَ الْمِهَادُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1498,
            "SureId": 2,
            "AyetId": 207,
            "LanguageId": 7,
            "AyetNumber": "٢٠٧",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "وَمِنَ النَّاسِ مَنْ یَشْرٖی نَفْسَهُ ابْتِغَٓاءَ مَرْضَاتِ اللّٰهِؕ وَاللّٰهُ رَؤُ𐻿فٌ بِالْعِبَادِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1505,
            "SureId": 2,
            "AyetId": 208,
            "LanguageId": 7,
            "AyetNumber": "٢٠٨",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "یَٓا اَیُّهَا الَّذٖینَ اٰمَنُوا ادْخُلُوا فِی السِّلْمِ كَٓافَّةًࣕ وَلَا تَتَّبِعُوا خُطُوَاتِ الشَّیْطَانِؕ اِنَّهُ لَكُمْ عَدُوٌّ مُبٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1512,
            "SureId": 2,
            "AyetId": 209,
            "LanguageId": 7,
            "AyetNumber": "٢٠٩",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "فَاِنْ زَلَلْتُمْ مِنْ بَعْدِ مَا جَٓاءَتْكُمُ الْبَیِّنَاتُ فَاعْلَمُٓوا اَنَّ اللّٰهَ عَزٖیزٌ حَكٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1519,
            "SureId": 2,
            "AyetId": 210,
            "LanguageId": 7,
            "AyetNumber": "٢١٠",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "هَلْ یَنْظُرُونَ اِلَّٓا اَنْ یَاْتِیَهُمُ اللّٰهُ فٖی ظُلَلٍ مِنَ الْغَمَامِ وَالْمَلٰٓئِكَةُ وَقُضِیَ الْاَمْرُؕ وَاِلَى اللّٰهِ تُرْجَعُ الْاُمُورُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 1468,
            "SureId": 2,
            "AyetId": 203,
            "LanguageId": 5,
            "AyetNumber": "203",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "Belirlenmiş günlerde Allah’ı zikredin. Allah’a saygılı olan için iki günde (dönmekte) acele edene günah yoktur; daha uzun kalana da günah yoktur. Allah’a saygılı olun. Bilin ki sizler O’nun huzurunda toplanacaksınız!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 2,
                "MealInfo": "Medine döneminde inmiştir. Kur’an-ı Kerim’in en uzun sûresi olup 286 âyettir. Adını, 67-73. âyetlerde yer alan <b>“bakara (<i>sığı</i>r)”</b> kelimesinden alır. Sûre, İslâm hukukunun ana konularıyla ilgili pek çok hüküm içermektedir.",
                "SureNameTurkish": "Bakara",
                "SureNameArabic": "الْبَقَرَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 87,
                "AyetCount": 286,
                "Cuz": 1,
                "FirstPage": 2,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 1475,
            "SureId": 2,
            "AyetId": 204,
            "LanguageId": 5,
            "AyetNumber": "204",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "İnsanlardan öylesi vardır ki dünya hayatı konusundaki sözleri senin hoşuna gider; o, hasımların en yamanı olduğu halde kalbinde olana Allah’ı şahit de tutar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1482,
            "SureId": 2,
            "AyetId": 205,
            "LanguageId": 5,
            "AyetNumber": "205",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "Hâkimiyeti ele aldığında ise ülkede bozgunculuk çıkarıp ürünleri ve nesilleri yok etmeye çalışır. Allah bozgunculuğu sevmez.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1489,
            "SureId": 2,
            "AyetId": 206,
            "LanguageId": 5,
            "AyetNumber": "206",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "Ona, “Allah’tan kork!” dense gururu kendisini günaha sürükler. Ona cehennem yeter! Orası ne kötü bir yataktır!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1496,
            "SureId": 2,
            "AyetId": 207,
            "LanguageId": 5,
            "AyetNumber": "207",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "İnsanlardan öylesi de vardır ki, kendisini Allah’ın hoşnutluğunu kazanmaya adamıştır. Allah, kullarına çok şefkatlidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1503,
            "SureId": 2,
            "AyetId": 208,
            "LanguageId": 5,
            "AyetNumber": "208",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "Ey iman edenler! Hep birden barışa girin. Sakın şeytanın peşinden gitmeyin; çünkü o, apaçık düşmanınızdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1510,
            "SureId": 2,
            "AyetId": 209,
            "LanguageId": 5,
            "AyetNumber": "209",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "Size açık seçik kanıtlar geldikten sonra yine de yalpalarsanız bilin ki Allah güç ve hikmet sahibidir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1517,
            "SureId": 2,
            "AyetId": 210,
            "LanguageId": 5,
            "AyetNumber": "210",
            "AyetVisible": true,
            "Page": 32,
            "AyetText": "Onlar, ille de Allah’ın ve meleklerin, bulutların gölgeleri arasından çıkıp gelmesini ve işin bitirilmesini mi bekliyorlar! Bütün işler Allah’a dönecektir!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
