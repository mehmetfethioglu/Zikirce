            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "وَمَا یَسْتَوِی الْاَعْمٰى وَالْبَصٖیرُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 35,
                "MealInfo": "Mekke döneminde inmiştir. 45 âyettir. Sûre, adını birinci âyette geçen <b>“Fâtır</b>” kelimesinden almıştır. <b>Fâtır, yaratan, yoktan var eden demektir. </b>Yine ilk âyette geçen <b>“el-Melâike”</b> kelimesinden dolayı <b>“Melâike sûresi</b>” diye de anılır. Sûrede başlıca, <b>Allah’ın varlığına ve birliğine işaret eden kâinat olayları, öldükten sonra dirilme, Allah’ın nimetleri ve mü’minle kâfir arasındaki fark konu</b> edilmektedir.",
                "SureNameTurkish": "Fâtır",
                "SureNameArabic": "فَاطِرٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 43,
                "AyetCount": 45,
                "Cuz": 22,
                "FirstPage": 434,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 25760,
            "SureId": 35,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "وَلَا الظُّلُمَاتُ وَلَا النُّورُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25767,
            "SureId": 35,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "وَلَا الظِّلُّ وَلَا الْحَرُورُۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25774,
            "SureId": 35,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "وَمَا یَسْتَوِی الْاَحْیَٓاءُ وَلَا الْاَمْوَاتُؕ اِنَّ اللّٰهَ یُسْمِـعُ مَنْ یَشَٓاءُۚ وَمَٓا اَنْتَ بِمُسْمِـعٍ مَنْ فِی الْقُبُورِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25781,
            "SureId": 35,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "اِنْ اَنْتَ اِلَّا نَذٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25788,
            "SureId": 35,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "اِنَّٓا اَرْسَلْنَاكَ بِالْحَقِّ بَشٖیرًا وَنَذٖیرًاؕ وَاِنْ مِنْ اُمَّةٍ اِلَّا خَلَا فٖیهَا نَذٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25795,
            "SureId": 35,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "وَاِنْ یُكَذِّبُوكَ فَقَدْ كَذَّبَ الَّذٖینَ مِنْ قَبْلِهِمْۚ جَٓاءَتْهُمْ رُسُلُهُمْ بِالْبَیِّنَاتِ وَبِالزُّبُرِ وَبِالْكِتَابِ الْمُنٖیرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25802,
            "SureId": 35,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "ثُمَّ اَخَذْتُ الَّذٖینَ كَفَرُوا فَكَیْفَ كَانَ نَكٖیرِࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25809,
            "SureId": 35,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "اَلَمْ تَرَ اَنَّ اللّٰهَ اَنْزَلَ مِنَ السَّمَٓاءِ مَٓاءًۚ فَاَخْرَجْنَا بِهٖ ثَمَرَاتٍ مُخْتَلِفًا اَلْوَانُهَاؕ وَمِنَ الْجِبَالِ جُدَدٌ بٖیضٌ وَحُمْرٌ مُخْتَلِفٌ اَلْوَانُهَا وَغَرَابٖیبُ سُودٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25816,
            "SureId": 35,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "وَمِنَ النَّاسِ وَالدَّوَٓابِّ وَالْاَنْعَامِ مُخْتَلِفٌ اَلْوَانُهُ كَذٰلِكَؕ اِنَّمَا یَخْشَى اللّٰهَ مِنْ عِبَادِهِ الْعُلَمٰٓؤُ𐻾اؕ اِنَّ اللّٰهَ عَزٖیزٌ غَفُورٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25823,
            "SureId": 35,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "اِنَّ الَّذٖینَ یَتْلُونَ كِتَابَ اللّٰهِ وَاَقَامُوا الصَّلٰوةَ وَاَنْفَقُوا مِمَّا رَزَقْنَاهُمْ سِرًّا وَعَلَانِیَةً یَرْجُونَ تِجَارَةً لَنْ تَبُورَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25830,
            "SureId": 35,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "لِیُوَفِّیَهُمْ اُجُورَهُمْ وَیَزٖیدَهُمْ مِنْ فَضْلِهٖؕ اِنَّهُ غَفُورٌ شَكُورٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 25751,
            "SureId": 35,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19-21",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "Görmeyenle gören, karanlıklarla aydınlık, gölge ile sıcak bir olmaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 35,
                "MealInfo": "Mekke döneminde inmiştir. 45 âyettir. Sûre, adını birinci âyette geçen <b>“Fâtır</b>” kelimesinden almıştır. <b>Fâtır, yaratan, yoktan var eden demektir. </b>Yine ilk âyette geçen <b>“el-Melâike”</b> kelimesinden dolayı <b>“Melâike sûresi</b>” diye de anılır. Sûrede başlıca, <b>Allah’ın varlığına ve birliğine işaret eden kâinat olayları, öldükten sonra dirilme, Allah’ın nimetleri ve mü’minle kâfir arasındaki fark konu</b> edilmektedir.",
                "SureNameTurkish": "Fâtır",
                "SureNameArabic": "فَاطِرٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 43,
                "AyetCount": 45,
                "Cuz": 22,
                "FirstPage": 434,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 25758,
            "SureId": 35,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": false,
            "Page": 437,
            "AyetText": "Görmeyenle gören, karanlıklarla aydınlık, gölge ile sıcak bir olmaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25765,
            "SureId": 35,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": false,
            "Page": 437,
            "AyetText": "Görmeyenle gören, karanlıklarla aydınlık, gölge ile sıcak bir olmaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25772,
            "SureId": 35,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "Dirilerle ölüler de bir değildir. Allah dilediğine elbette işittirir; ama sen kabirlerdekilere de işittirecek değilsin!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25779,
            "SureId": 35,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "Sen ancak bir uyarıcısın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25786,
            "SureId": 35,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "Doğrusu biz seni hak ile desteklenmiş bir müjdeleyici ve uyarıcı olarak gönderdik. Hiçbir ümmet yoktur ki içlerinden bir uyarıcı gelip geçmemiş olsun.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25793,
            "SureId": 35,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "Seni yalancılıkla itham ediyorlarsa, bil ki daha öncekiler de (peygamberlerini) yalancılıkla itham etmişlerdi. Peygamberleri onlara açık kanıtlar, sahifeler ve aydınlatıcı kitap getirmişlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25800,
            "SureId": 35,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "Sonra ben o inkârcıları yakalayıverdim; bilsen nasıl bir cezalandırıştı o!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25807,
            "SureId": 35,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "Allah’ın gökten su indirdiğini görmez misin? Sonra onunla renkleri ve çeşitleri farklı ürünler çıkardık. Dağların da farklı renklerde; beyaz, kırmızı, simsiyah yolları, kısımları vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25814,
            "SureId": 35,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "Aynı şekilde, insanlardan, binek hayvanlarından ve eti yenen hayvanlardan da farklı tür ve renklerde olanlar var. Kulları içinden ancak bilenler, Allah’ın büyüklüğü karşısında heyecan duyarlar. Şüphesiz Allah üstündür, çokça bağışlayıcıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25821,
            "SureId": 35,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "Allah’ın kitabını okuyanlar, namazı özenle kılanlar ve kendilerine verdiğimiz rızıktan başkaları için gizli açık harcayanlar, asla zararla sonuçlanmayacak bir ticaret umabilirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25828,
            "SureId": 35,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 437,
            "AyetText": "Zira Allah karşılıklarını tam olarak ödediği gibi lutfundan onlara fazlasını da verir. O çok bağışlayıcıdır, şükrün karşılığını bol bol verir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
