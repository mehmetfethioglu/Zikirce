            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "اِذْ اَوْحَیْنَٓا اِلٰٓى اُمِّكَ مَا یُوحٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16709,
            "SureId": 20,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "اَنِ اقْذِفٖیهِ فِی التَّابُوتِ فَاقْذِفٖیهِ فِی الْیَمِّ فَلْیُلْقِهِ الْیَمُّ بِالسَّاحِلِ یَاْخُذْهُ عَدُوٌّ لٖی وَعَدُوٌّ لَهُؕ وَاَلْقَیْتُ عَلَیْكَ مَحَبَّةً مِنّٖیۚ وَلِتُصْنَعَ عَلٰى عَیْنٖیۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16716,
            "SureId": 20,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "اِذْ تَمْشٖٓی اُخْتُكَ فَتَقُولُ هَلْ اَدُلُّكُمْ عَلٰى مَنْ یَكْفُلُهُؕ فَرَجَعْنَاكَ اِلٰٓى اُمِّكَ كَیْ تَقَرَّ عَیْنُهَا وَلَا تَحْزَنَؕ وَقَتَلْتَ نَفْسًا فَنَجَّیْنَاكَ مِنَ الْغَمِّ وَفَتَنَّاكَ فُتُونًاࣞ فَلَبِثْتَ سِنٖینَ فٖٓی اَهْلِ مَدْیَنَ ثُمَّ جِئْتَ عَلٰى قَدَرٍ یَا مُوسٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16723,
            "SureId": 20,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "وَاصْطَنَعْتُكَ لِنَفْسٖیۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16730,
            "SureId": 20,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "اِذْهَبْ اَنْتَ وَاَخُوكَ بِاٰیَاتٖی وَلَا تَنِیَا فٖی ذِكْرٖیۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16737,
            "SureId": 20,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "اِذْهَبَٓا اِلٰى فِرْعَوْنَ اِنَّهُ طَغٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16744,
            "SureId": 20,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "فَقُولَا لَهُ قَوْلًا لَیِّنًا لَعَلَّهُ یَتَذَكَّرُ اَوْ یَخْشٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16751,
            "SureId": 20,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "قَالَا رَبَّنَٓا اِنَّنَا نَخَافُ اَنْ یَفْرُطَ عَلَیْنَٓا اَوْ اَنْ یَطْغٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16758,
            "SureId": 20,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "قَالَ لَا تَخَافَٓا اِنَّنٖی مَعَكُمَٓا اَسْمَعُ وَاَرٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16765,
            "SureId": 20,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "فَاْتِیَاهُ فَقُولَٓا اِنَّا رَسُولَا رَبِّكَ فَاَرْسِلْ مَعَنَا بَنٖٓی اِسْرَٓایٖٔلَ وَلَا تُعَذِّبْهُمْؕ قَدْ جِئْنَاكَ بِاٰیَةٍ مِنْ رَبِّكَؕ وَالسَّلَامُ عَلٰى مَنِ اتَّبَعَ الْهُدٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16772,
            "SureId": 20,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "اِنَّا قَدْ اُو𐻿حِیَ اِلَیْنَٓا اَنَّ الْعَذَابَ عَلٰى مَنْ كَذَّبَ وَتَوَلّٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16779,
            "SureId": 20,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "قَالَ فَمَنْ رَبُّكُمَا یَا مُوسٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16786,
            "SureId": 20,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "قَالَ رَبُّنَا الَّذٖٓی اَعْطٰى كُلَّ شَیْءٍ خَلْقَهُ ثُمَّ هَدٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16793,
            "SureId": 20,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "قَالَ فَمَا بَالُ الْقُرُونِ الْاُو𐻿لٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 16700,
            "SureId": 20,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "Hani annene şunu vahyetmiştik:",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16707,
            "SureId": 20,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "Onu sandığa koy ve ırmağa bırak; böylece ırmak onu kıyıya çıkarsın ve benim de düşmanım, onun da düşmanı olan biri onu alsın. (Ey Mûsâ!) Senin üzerine kendimden bir sevgi bıraktım ki (sevilesin), nezâretim altında büyütülüp yetiştirilesin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16714,
            "SureId": 20,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "Hani kız kardeşin onlara gidip de, ‘Ona bakabilecek birini size göstereyim mi?’ diyordu. Nihayet gözü gönlü şen olsun ve kederlenmesin diye seni annene kavuşturduk. Ve birisini öldürmüştün de seni tasadan kurtarmış, ardından da seni ciddi sınavlardan geçirmiştik. Bu sebeple yıllarca Medyen halkının arasında kaldın, sonra mukadder olduğu üzere buraya geldin, ey Mûsâ!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16721,
            "SureId": 20,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "Ben seni kendim için seçip yetiştirdim.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16728,
            "SureId": 20,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "“Sen ve kardeşin mûcizelerimle gidin; beni anmakta gevşeklik göstermeyin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16735,
            "SureId": 20,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "İkiniz beraber Firavun’a gidin, çünkü o sınırı çok aştı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16742,
            "SureId": 20,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "Yine de ona söyleyeceklerinizi yumuşak bir üslûpla söyleyin, ola ki aklını başına toplar veya içine bir korku düşer.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16749,
            "SureId": 20,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "“Ey rabbimiz!” dediler, “Doğrusu onun bize karşı ileri gitmesinden veya daha da azmasından endişe ediyoruz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16756,
            "SureId": 20,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "Allah buyurdu: “Korkmayın, bilin ki ben sizinle beraberim; işitirim, görürüm.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16763,
            "SureId": 20,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "Ona gidip deyin ki: Biz senin rabbinin elçileriyiz. Artık İsrâiloğulları’nı bırak bizimle gelsinler. Onlara eziyet etme. Sana rabbinden bir mûcize getirdik. Esenlik doğru yolu izleyenlerin olacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16770,
            "SureId": 20,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "Bize vahyolunmuştur ki azap, asıl, (peygamberleri) yalanlayıp yüz çevirenlerin başına gelecektir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16777,
            "SureId": 20,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "Firavun, “Sizin rabbiniz de kimmiş ey Mûsâ?” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16784,
            "SureId": 20,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "Mûsâ, “Bizim rabbimiz her şeye özüyle ve biçimiyle varlık veren, sonra da işin yolunu yordamını gösterendir” diye cevap verdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16791,
            "SureId": 20,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 314,
            "AyetText": "Firavun “peki” dedi, “Gelip geçen nesillerin durumu ne olacak?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
