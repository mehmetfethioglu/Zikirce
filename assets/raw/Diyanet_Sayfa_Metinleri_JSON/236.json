    "QuranAyats": [
        {
            "Id": 11207,
            "SureId": 12,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "قَالَ یَا بُنَیَّ لَا تَقْصُصْ رُءْیَاكَ عَلٰٓى اِخْوَتِكَ فَیَكٖیدُوا لَكَ كَیْدًاؕ اِنَّ الشَّیْطَانَ لِلْاِنْسَانِ عَدُوٌّ مُبٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 12,
                "MealInfo": "Mekke döneminde inmiştir. 111 âyettir. Bu sûrede Yûsuf Peygamberin hayatta karşılaştığı sıkıntılar ve bunlara sabrederek nasıl başarıya ulaştığı anlatılmakta ve inananlar için faydalı öğütler, önemli mesajlar verilmektedir. Kur’an’da baştan sona kadar bir tek konuyu anlatan tek sûre budur.",
                "SureNameTurkish": "Yûsuf",
                "SureNameArabic": "يُوسُفَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 53,
                "AyetCount": 111,
                "Cuz": 12,
                "FirstPage": 235,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11214,
            "SureId": 12,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "وَكَذٰلِكَ یَجْتَبٖیكَ رَبُّكَ وَیُعَلِّمُكَ مِنْ تَاْوٖیلِ الْاَحَادٖیثِ وَیُتِمُّ نِعْمَتَهُ عَلَیْكَ وَعَلٰٓى اٰلِ یَعْقُوبَ كَمَٓا اَتَمَّهَا عَلٰٓى اَبَوَیْكَ مِنْ قَبْلُ اِبْرٰهٖیمَ وَاِسْحٰقَؕ اِنَّ رَبَّكَ عَلٖیمٌ حَكٖیمٌࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11221,
            "SureId": 12,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "لَقَدْ كَانَ فٖی یُوسُفَ وَاِخْوَتِهٖٓ اٰیَاتٌ لِلسَّٓائِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11228,
            "SureId": 12,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "اِذْ قَالُوا لَیُوسُفُ وَاَخُوهُ اَحَبُّ اِلٰٓى اَبٖینَا مِنَّا وَنَحْنُ عُصْبَةٌؕ اِنَّ اَبَانَا لَفٖی ضَلَالٍ مُبٖینٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11235,
            "SureId": 12,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "اُقْتُلُوا یُوسُفَ اَوِ اطْرَحُوهُ اَرْضًا یَخْلُ لَكُمْ وَجْهُ اَبٖیكُمْ وَتَكُونُوا مِنْ بَعْدِهٖ قَوْمًا صَالِحٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11242,
            "SureId": 12,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "قَالَ قَٓائِلٌ مِنْهُمْ لَا تَقْتُلُوا یُوسُفَ وَاَلْقُوهُ فٖی غَیَابَتِ الْجُبِّ یَلْتَقِطْهُ بَعْضُ السَّیَّارَةِ اِنْ كُنْتُمْ فَاعِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11249,
            "SureId": 12,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "قَالُوا یَٓا اَبَانَا مَا لَكَ لَا تَاْمَنَّ۫ا عَلٰى یُوسُفَ وَاِنَّا لَهُ لَنَاصِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11256,
            "SureId": 12,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "اَرْسِلْهُ مَعَنَا غَدًا یَرْتَعْ وَیَلْعَبْ وَاِنَّا لَهُ لَحَافِظُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11263,
            "SureId": 12,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "قَالَ اِنّٖی لَیَحْزُنُنٖٓی اَنْ تَذْهَبُوا بِهٖ وَاَخَافُ اَنْ یَاْكُلَهُ الذِّئْبُ وَاَنْتُمْ عَنْهُ غَافِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11270,
            "SureId": 12,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "قَالُوا لَئِنْ اَكَلَهُ الذِّئْبُ وَنَحْنُ عُصْبَةٌ اِنَّٓا اِذًا لَخَاسِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 11205,
            "SureId": 12,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "Babası, “Yavrucuğum” dedi, “Rüyanı sakın kardeşlerine anlatma, sonra sana tuzak kurarlar! Çünkü şeytan insana apaçık bir düşmandır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 12,
                "MealInfo": "Mekke döneminde inmiştir. 111 âyettir. Bu sûrede Yûsuf Peygamberin hayatta karşılaştığı sıkıntılar ve bunlara sabrederek nasıl başarıya ulaştığı anlatılmakta ve inananlar için faydalı öğütler, önemli mesajlar verilmektedir. Kur’an’da baştan sona kadar bir tek konuyu anlatan tek sûre budur.",
                "SureNameTurkish": "Yûsuf",
                "SureNameArabic": "يُوسُفَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 53,
                "AyetCount": 111,
                "Cuz": 12,
                "FirstPage": 235,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11212,
            "SureId": 12,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "Anlaşılan böylece rabbin seni seçecek, sana rüyada görülenlerin yorumunu öğretecek ve daha önce ataların İbrâhim ve İshak’a nimetini tamamladığı gibi sana ve Ya‘kūb soyuna da nimetini tamamlayacaktır. Kuşkusuz rabbin çok iyi bilendir, hikmet sahibidir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11219,
            "SureId": 12,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "Andolsun ki Yûsuf ve kardeşlerinde, almak isteyenler için ibretler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11226,
            "SureId": 12,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "Hani kardeşleri demişlerdi ki: “Yûsuf ile öz kardeşi babamızın gözünde bizden daha değerli. Halbuki bizim sayımız daha çok. Şüphesiz ki babamız apaçık bir yanılgı içinde!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11233,
            "SureId": 12,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "Yûsuf’u öldürün veya onu (uzak) bir yere atın ki babanızın teveccühü yalnız size kalsın! Ondan sonra da (tövbe ederek) iyi kimseler olursunuz!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11240,
            "SureId": 12,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "Onlardan biri, “Yûsuf’u öldürmeyin, eğer mutlaka yapacaksanız, onu (kör) kuyunun dibine bırakın. Nasıl olsa gelip geçen kervanlardan biri onu bulup alır” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11247,
            "SureId": 12,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "Dediler ki: “Ey babamız! Niçin Yûsuf hakkında bize güvenmiyorsun? Oysa biz onun iyiliğini isteyen kimseleriz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11254,
            "SureId": 12,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "Yarın onu bizimle beraber (kıra) gönder de bol bol yesin içsin, oynasın; onu mutlaka koruruz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11261,
            "SureId": 12,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "Babaları, “Doğrusu onu götürmeniz beni endişelendiriyor; farkında olmadığınız bir sırada onu kurt yer diye korkuyorum” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11268,
            "SureId": 12,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 236,
            "AyetText": "Dediler ki: “Biz böylesine kalabalık iken onu kurt yerse o zaman gerçekten bize yazıklar olsun!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
