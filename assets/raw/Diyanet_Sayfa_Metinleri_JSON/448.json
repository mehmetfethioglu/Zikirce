{
    "PointerList": null,
    "CuzNo": 23,
    "PageNo": 448,
    "ArCuzNo": "۲۳",
    "ArPageNo": "٤٤۸",
    "QuranAyats": [
        {
            "Id": 26880,
            "SureId": 37,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "یَقُولُ اَئِنَّكَ لَمِنَ الْمُصَدِّقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 37,
                "MealInfo": "Mekke döneminde inmiştir. 182 âyettir. Sûre, adını ilk âyette geçen <b>“es-Sâffât” </b>kelimesinden almıştır.<b> Sâffât, sıra sıra dizilenler, saf saf duranlar demektir</b>. Sûrede başlıca, <b>meleklerden, cinlerden, kıyamet ve ahiret olaylarından söz edilmekte; Nûh, İbrahim, İsmail, İshak, Mûsâ, Hârun, İlyas, Lût ve Yûnus Peygamberlerin kıssaları</b>na yer verilmektedir.",
                "SureNameTurkish": "Sâffât",
                "SureNameArabic": "الصَّاۤفَّاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 56,
                "AyetCount": 182,
                "Cuz": 23,
                "FirstPage": 446,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26887,
            "SureId": 37,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "ءَاِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا ءَاِنَّا لَمَدٖینُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26894,
            "SureId": 37,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "قَالَ هَلْ اَنْتُمْ مُطَّلِعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26901,
            "SureId": 37,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "فَاطَّلَعَ فَرَاٰهُ فٖی سَوَٓاءِ الْجَحٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26908,
            "SureId": 37,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "قَالَ تَاللّٰهِ اِنْ كِدْتَ لَتُرْدٖینِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26915,
            "SureId": 37,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "وَلَوْلَا نِعْمَةُ رَبّٖی لَكُنْتُ مِنَ الْمُحْضَرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26922,
            "SureId": 37,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "اَفَمَا نَحْنُ بِمَیِّتٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26929,
            "SureId": 37,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "اِلَّا مَوْتَتَنَا الْاُو𐻿لٰى وَمَا نَحْنُ بِمُعَذَّبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26936,
            "SureId": 37,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "اِنَّ هٰذَا لَهُوَ الْفَوْزُ الْعَظٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26943,
            "SureId": 37,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "لِمِثْلِ هٰذَا فَلْیَعْمَلِ الْعَامِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26950,
            "SureId": 37,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "اَذٰلِكَ خَیْرٌ نُزُلًا اَمْ شَجَرَةُ الزَّقُّومِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26957,
            "SureId": 37,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "اِنَّا جَعَلْنَاهَا فِتْنَةً لِلظَّالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26964,
            "SureId": 37,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "اِنَّهَا شَجَرَةٌ تَخْرُجُ فٖٓی اَصْلِ الْجَحٖیمِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26971,
            "SureId": 37,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "طَلْعُهَا كَاَنَّهُ رُؤُ𐻿سُ الشَّیَاطٖینِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26978,
            "SureId": 37,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "فَاِنَّهُمْ لَاٰكِلُونَ مِنْهَا فَمَالِؤُ𐻿نَ مِنْهَا الْبُطُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26985,
            "SureId": 37,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "ثُمَّ اِنَّ لَهُمْ عَلَیْهَا لَشَوْبًا مِنْ حَمٖیمٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26992,
            "SureId": 37,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "ثُمَّ اِنَّ مَرْجِعَهُمْ لَاِلَى الْجَحٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26999,
            "SureId": 37,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "اِنَّهُمْ اَلْفَوْا اٰبَٓاءَهُمْ ضَٓالّٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27006,
            "SureId": 37,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "فَهُمْ عَلٰٓى اٰثَارِهِمْ یُهْرَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27013,
            "SureId": 37,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "وَلَقَدْ ضَلَّ قَبْلَهُمْ اَكْثَرُ الْاَوَّلٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27020,
            "SureId": 37,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "وَلَقَدْ اَرْسَلْنَا فٖیهِمْ مُنْذِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27027,
            "SureId": 37,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "فَانْظُرْ كَیْفَ كَانَ عَاقِبَةُ الْمُنْذَرٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27034,
            "SureId": 37,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "اِلَّا عِبَادَ اللّٰهِ الْمُخْلَصٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27041,
            "SureId": 37,
            "AyetId": 75,
            "LanguageId": 7,
            "AyetNumber": "٧٥",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "وَلَقَدْ نَادٰینَا نُوحٌ فَلَنِعْمَ الْمُجٖیبُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27048,
            "SureId": 37,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "وَنَجَّیْنَاهُ وَاَهْلَهُ مِنَ الْكَرْبِ الْعَظٖیمِؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 26878,
            "SureId": 37,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Derdi ki: Sen de onaylıyor musun gerçekten?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 37,
                "MealInfo": "Mekke döneminde inmiştir. 182 âyettir. Sûre, adını ilk âyette geçen <b>“es-Sâffât” </b>kelimesinden almıştır.<b> Sâffât, sıra sıra dizilenler, saf saf duranlar demektir</b>. Sûrede başlıca, <b>meleklerden, cinlerden, kıyamet ve ahiret olaylarından söz edilmekte; Nûh, İbrahim, İsmail, İshak, Mûsâ, Hârun, İlyas, Lût ve Yûnus Peygamberlerin kıssaları</b>na yer verilmektedir.",
                "SureNameTurkish": "Sâffât",
                "SureNameArabic": "الصَّاۤفَّاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 56,
                "AyetCount": 182,
                "Cuz": 23,
                "FirstPage": 446,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26885,
            "SureId": 37,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Biz, ölüp de toprak ve kemik yığını haline gelmişken mutlaka hesaba çekilecekmişiz öyle mi?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26892,
            "SureId": 37,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Ve ekler: “Şimdi dönüp bakar mısınız (ona)?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26899,
            "SureId": 37,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Sonra kendisi dönüp bakar ve arkadaşını cehennemin ortasında görür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26906,
            "SureId": 37,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "“Allah’a yemin ederim ki” der, “Neredeyse beni de mahvedecektin!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26913,
            "SureId": 37,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Rabbimin lutfu olmasaydı ben de şimdi cehenneme getirilenler arasında olacaktım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26920,
            "SureId": 37,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "(Ne mutlu bize ki), artık bir daha ölmeyeceğiz, değil mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26927,
            "SureId": 37,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Önceki ölümümüzden başka ölüm yok; azap da görmeyeceğiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26934,
            "SureId": 37,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Bu, gerçekten çok büyük bir kazançtır!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26941,
            "SureId": 37,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Amel sahipleri böylesi bir kazanç için çalışmalıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26948,
            "SureId": 37,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Bu mu daha iyi bir ikramdır yoksa zakkum ağacı mı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26955,
            "SureId": 37,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Biz o zakkumu zalimler için bir sınama aracı yaptık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26962,
            "SureId": 37,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "O, cehennemin ta dibinde yetişen bir ağaçtır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26969,
            "SureId": 37,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Tomurcukları sanki şeytanların başları gibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26976,
            "SureId": 37,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Zalimler mutlaka onu yiyecekler, karınlarını onunla dolduracaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26983,
            "SureId": 37,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Sonra onların, yedikleri bu nesnenin üzerine, kaynar su karıştırılmış bir içecekleri de olacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26990,
            "SureId": 37,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Sonunda onların varacakları yer mutlaka cehennem olacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26997,
            "SureId": 37,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Çünkü onlar atalarını doğru yoldan sapmış olarak buldular;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27004,
            "SureId": 37,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Ama kendileri de çılgınca onların izinden koşuyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27011,
            "SureId": 37,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Onlardan önce de geçmiştekilerin çoğu yollarını sapıtmıştı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27018,
            "SureId": 37,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 448,
            "AyetText": "Oysa içlerinden uyarıcı elçiler de göndermiştik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27025,
            "SureId": 37,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73-74",
            "AyetVisible": true,
            "Page": 448,
