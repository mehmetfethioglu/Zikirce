{
    "PointerList": null,
    "CuzNo": 14,
    "PageNo": 266,
    "ArCuzNo": "۱٤",
    "ArPageNo": "۲٦٦",
    "QuranAyats": [
        {
            "Id": 13111,
            "SureId": 15,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "قَالَ هٰٓؤُ𐻾لَٓاءِ بَنَاتٖٓی اِنْ كُنْتُمْ فَاعِلٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 15,
                "MealInfo": "Mekke döneminde inmiştir. 99 âyettir. Sûre, adını 80. âyette geçen <b>“Hicr” </b>kelimesinden almıştır. Hicr, Medine’nin kuzeyinde vaktiyle Semûd kavminin yaşadığı bir yerin adıdır. Sûre de başlıca Allah’ın birliği, peygamberlik, öldükten sonra dirilme ve hesap konuları; peygamberlerin, çeşitli zamanlarda azgınlara ve inkârcılara karşı verdikleri mücadeleler çerçevesinde ele alınmaktadır. Bu sûre de ayrıca ilâhî kitapların kendisiyle kemale erdiği Kur’an’ın, her türlü tahriften korunacağı hükmü de yer almaktadır.",
                "SureNameTurkish": "Hicr",
                "SureNameArabic": "الْحِجْرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 54,
                "AyetCount": 99,
                "Cuz": 14,
                "FirstPage": 262,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 13118,
            "SureId": 15,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "لَعَمْرُكَ اِنَّهُمْ لَفٖی سَكْرَتِهِمْ یَعْمَهُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13125,
            "SureId": 15,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "فَاَخَذَتْهُمُ الصَّیْحَةُ مُشْرِقٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13132,
            "SureId": 15,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "فَجَعَلْنَا عَالِیَهَا سَافِلَهَا وَاَمْطَرْنَا عَلَیْهِمْ حِجَارَةً مِنْ سِجّٖیلٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13139,
            "SureId": 15,
            "AyetId": 75,
            "LanguageId": 7,
            "AyetNumber": "٧٥",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "اِنَّ فٖی ذٰلِكَ لَاٰیَاتٍ لِلْمُتَوَسِّمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13146,
            "SureId": 15,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "وَاِنَّهَا لَبِسَبٖیلٍ مُقٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13153,
            "SureId": 15,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "اِنَّ فٖی ذٰلِكَ لَاٰیَةً لِلْمُؤْمِنٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13160,
            "SureId": 15,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "وَاِنْ كَانَ اَصْحَابُ الْاَیْكَةِ لَظَالِمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13167,
            "SureId": 15,
            "AyetId": 79,
            "LanguageId": 7,
            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "فَانْتَقَمْنَا مِنْهُمْۘ وَاِنَّهُمَا لَبِاِمَامٍ مُبٖینٍؕ‌ࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13174,
            "SureId": 15,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "وَلَقَدْ كَذَّبَ اَصْحَابُ الْحِجْرِ الْمُرْسَلٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13181,
            "SureId": 15,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "وَاٰتَیْنَاهُمْ اٰیَاتِنَا فَكَانُوا عَنْهَا مُعْرِضٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13188,
            "SureId": 15,
            "AyetId": 82,
            "LanguageId": 7,
            "AyetNumber": "٨٢",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "وَكَانُوا یَنْحِتُونَ مِنَ الْجِبَالِ بُیُوتًا اٰمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13195,
            "SureId": 15,
            "AyetId": 83,
            "LanguageId": 7,
            "AyetNumber": "٨٣",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "فَاَخَذَتْهُمُ الصَّیْحَةُ مُصْبِحٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13202,
            "SureId": 15,
            "AyetId": 84,
            "LanguageId": 7,
            "AyetNumber": "٨٤",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "فَمَٓا اَغْنٰى عَنْهُمْ مَا كَانُوا یَكْسِبُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13209,
            "SureId": 15,
            "AyetId": 85,
            "LanguageId": 7,
            "AyetNumber": "٨٥",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "وَمَا خَلَقْنَا السَّمٰوَاتِ وَالْاَرْضَ وَمَا بَیْنَهُمَٓا اِلَّا بِالْحَقِّؕ وَاِنَّ السَّاعَةَ لَاٰتِیَةٌ فَاصْفَحِ الصَّفْحَ الْجَمٖیلَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13216,
            "SureId": 15,
            "AyetId": 86,
            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "اِنَّ رَبَّكَ هُوَ الْخَلَّاقُ الْعَلٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13223,
            "SureId": 15,
            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "وَلَقَدْ اٰتَیْنَاكَ سَبْعًا مِنَ الْمَثَانٖی وَالْقُرْاٰنَ الْعَظٖیمَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13230,
            "SureId": 15,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "لَا تَمُدَّنَّ عَیْنَیْكَ اِلٰى مَا مَتَّعْنَا بِهٖٓ اَزْوَاجًا مِنْهُمْ وَلَا تَحْزَنْ عَلَیْهِمْ وَاخْفِضْ جَنَاحَكَ لِلْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13237,
            "SureId": 15,
            "AyetId": 89,
            "LanguageId": 7,
            "AyetNumber": "٨٩",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "وَقُلْ اِنّٖٓی اَنَا النَّذٖیرُ الْمُبٖینُۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13244,
            "SureId": 15,
            "AyetId": 90,
            "LanguageId": 7,
            "AyetNumber": "٩٠",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "كَمَٓا اَنْزَلْنَا عَلَى الْمُقْتَسِمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 13109,
            "SureId": 15,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Lût, “İşte kadınlar, benim kızlarım, (nikâh) yaparsanız” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 15,
                "MealInfo": "Mekke döneminde inmiştir. 99 âyettir. Sûre, adını 80. âyette geçen <b>“Hicr” </b>kelimesinden almıştır. Hicr, Medine’nin kuzeyinde vaktiyle Semûd kavminin yaşadığı bir yerin adıdır. Sûre de başlıca Allah’ın birliği, peygamberlik, öldükten sonra dirilme ve hesap konuları; peygamberlerin, çeşitli zamanlarda azgınlara ve inkârcılara karşı verdikleri mücadeleler çerçevesinde ele alınmaktadır. Bu sûre de ayrıca ilâhî kitapların kendisiyle kemale erdiği Kur’an’ın, her türlü tahriften korunacağı hükmü de yer almaktadır.",
                "SureNameTurkish": "Hicr",
                "SureNameArabic": "الْحِجْرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 54,
                "AyetCount": 99,
                "Cuz": 14,
                "FirstPage": 262,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 13116,
            "SureId": 15,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "(Ey resulüm!) Hayatına yemin olsun ki onlar, sarhoş (sersem) halleriyle saçmalayıp duruyorlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13123,
            "SureId": 15,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Nihayet ortalık aydınlanırken korkunç ses onları yakalayıverdi!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13130,
            "SureId": 15,
            "AyetId": 74,
            "LanguageId": 5,
            "AyetNumber": "74",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Ardından yurtlarının altını üstüne getirdik, üzerlerine taşlaşmış çamur yağdırdık!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13137,
            "SureId": 15,
            "AyetId": 75,
            "LanguageId": 5,
            "AyetNumber": "75",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "İşte bunda ibret alacak olanlar için dersler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13144,
            "SureId": 15,
            "AyetId": 76,
            "LanguageId": 5,
            "AyetNumber": "76",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Bakın, o harabeler bir yol üzerinde hâlâ duruyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13151,
            "SureId": 15,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Onda da inananlar için bir ders vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13158,
            "SureId": 15,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Eyke halkı da gerçekten bir zalimler topluluğu idi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13165,
            "SureId": 15,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Biz onların da cezasını verdik. Bu iki şehir açıkça bilinen bir yol üzerindedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13172,
            "SureId": 15,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Kuşkusuz Hicr halkı da peygamberleri yalancılıkla suçladılar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13179,
            "SureId": 15,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Oysa onlara âyetlerimizi de gönderdik, fakat bunlara sırt çevirdiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13186,
            "SureId": 15,
            "AyetId": 82,
            "LanguageId": 5,
            "AyetNumber": "82",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Onlar, güvende olmak üzere dağları oyarak barınaklar yaparlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13193,
            "SureId": 15,
            "AyetId": 83,
            "LanguageId": 5,
            "AyetNumber": "83",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Ama sonunda sabaha girerlerken korkunç ses onları da yakaladı!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13200,
            "SureId": 15,
            "AyetId": 84,
            "LanguageId": 5,
            "AyetNumber": "84",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Aldıkları tedbirin kendilerine hiçbir faydası olmadı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13207,
            "SureId": 15,
            "AyetId": 85,
            "LanguageId": 5,
            "AyetNumber": "85",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Biz, gökleri, yeri ve bunlar arasında bulunanları ancak ve ancak hak ve adalet temelinde yarattık. Kıyamet de mutlaka gelecektir. Sen şimdi güzel olan hoşgörü yolunu tut.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13214,
            "SureId": 15,
            "AyetId": 86,
            "LanguageId": 5,
            "AyetNumber": "86",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "İyi bilesin ki rabbin, evet O, muhakkak sûrette eşsiz yaratıcıdır, her şeyi bilmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13221,
            "SureId": 15,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Kuşkusuz sana tekrar tekrar okunandan (âyetlerden) yedisini ve yüce Kur’an’ı verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13228,
            "SureId": 15,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Sakın ola ki, onlardan bazı gruplara verdiğimiz geçici dünya nimetine göz dikmeyesin! Onlardan yana üzülme, müminlere karşı da alçakgönüllü ol!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13235,
            "SureId": 15,
            "AyetId": 89,
            "LanguageId": 5,
            "AyetNumber": "89",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "“Kuşkusuz ben apaçık bir uyarıcıyım” de.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13242,
            "SureId": 15,
            "AyetId": 90,
            "LanguageId": 5,
            "AyetNumber": "90",
            "AyetVisible": true,
            "Page": 266,
            "AyetText": "Nitekim biz, bölüp parçalayanları cezalandırdık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Hicr",
    "QuranSureLabel": "الْحِجْرِ",
    "EndPageSure": null
}