            "AyetVisible": true,
            "Page": 67,
            "AyetText": "وَسَارِعُٓوا اِلٰى مَغْفِرَةٍ مِنْ رَبِّكُمْ وَجَنَّةٍ عَرْضُهَا السَّمٰوَاتُ وَالْاَرْضُۙ اُعِدَّتْ لِلْمُتَّقٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 2989,
            "SureId": 3,
            "AyetId": 134,
            "LanguageId": 7,
            "AyetNumber": "١٣٤",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "اَلَّذٖینَ یُنْفِقُونَ فِی السَّرَّٓاءِ وَالضَّرَّٓاءِ وَالْكَاظِمٖینَ الْغَیْظَ وَالْعَافٖینَ عَنِ النَّاسِؕ وَاللّٰهُ یُحِبُّ الْمُحْسِنٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2996,
            "SureId": 3,
            "AyetId": 135,
            "LanguageId": 7,
            "AyetNumber": "١٣٥",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "وَالَّذٖینَ اِذَا فَعَلُوا فَاحِشَةً اَوْ ظَلَمُٓوا اَنْفُسَهُمْ ذَكَرُوا اللّٰهَ فَاسْتَغْفَرُوا لِذُنُوبِهِمْࣕ وَمَنْ یَغْفِرُ الذُّنُوبَ اِلَّا اللّٰهُࣕ وَلَمْ یُصِرُّوا عَلٰى مَا فَعَلُوا وَهُمْ یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3003,
            "SureId": 3,
            "AyetId": 136,
            "LanguageId": 7,
            "AyetNumber": "١٣٦",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "اُو𐻾لٰٓئِكَ جَزَٓاؤُ𐻾هُمْ مَغْفِرَةٌ مِنْ رَبِّهِمْ وَجَنَّاتٌ تَجْرٖی مِنْ تَحْتِهَا الْاَنْهَارُ خَالِدٖینَ فٖیهَاؕ وَنِعْمَ اَجْرُ الْعَامِلٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3010,
            "SureId": 3,
            "AyetId": 137,
            "LanguageId": 7,
            "AyetNumber": "١٣٧",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "قَدْ خَلَتْ مِنْ قَبْلِكُمْ سُنَنٌۙ فَسٖیرُوا فِی الْاَرْضِ فَانْظُرُوا كَیْفَ كَانَ عَاقِبَةُ الْمُكَذِّبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3017,
            "SureId": 3,
            "AyetId": 138,
            "LanguageId": 7,
            "AyetNumber": "١٣٨",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "هٰذَا بَیَانٌ لِلنَّاسِ وَهُدًى وَمَوْعِظَةٌ لِلْمُتَّقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3024,
            "SureId": 3,
            "AyetId": 139,
            "LanguageId": 7,
            "AyetNumber": "١٣٩",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "وَلَا تَهِنُوا وَلَا تَحْزَنُوا وَاَنْتُمُ الْاَعْلَوْنَ اِنْ كُنْتُمْ مُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3031,
            "SureId": 3,
            "AyetId": 140,
            "LanguageId": 7,
            "AyetNumber": "١٤٠",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "اِنْ یَمْسَسْكُمْ قَرْحٌ فَقَدْ مَسَّ الْقَوْمَ قَرْحٌ مِثْلُهُؕ وَتِلْكَ الْاَیَّامُ نُدَاوِلُهَا بَیْنَ النَّاسِۚ وَلِیَعْلَمَ اللّٰهُ الَّذٖینَ اٰمَنُوا وَیَتَّخِذَ مِنْكُمْ شُهَدَٓاءَؕ وَاللّٰهُ لَا یُحِبُّ الظَّالِمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 2980,
            "SureId": 3,
            "AyetId": 133,
            "LanguageId": 5,
            "AyetNumber": "133",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "Rabbinizin mağfiretine mazhar olmak ve takvâ sahipleri için hazırlanmış olup gökler ve yer kadar geniş olan cennete girmek için yarışın!",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 2987,
            "SureId": 3,
            "AyetId": 134,
            "LanguageId": 5,
            "AyetNumber": "134",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "Onlar (takvâ sahipleri) bollukta da darlıkta da Allah yolunda harcarlar, öfkelerini yenerler, insanları affederler. Allah işini güzel yapanları sever.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2994,
            "SureId": 3,
            "AyetId": 135,
            "LanguageId": 5,
            "AyetNumber": "135",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "Onlar çirkin bir şey yaptıkları veya kendilerine kötülük ettikleri zaman Allah’ı hatırlarlar da hemen günahlarının bağışlanmasını dilerler. Zaten günahları Allah’tan başka kim bağışlayabilir ki? Onlar, yaptıklarında bile bile ısrar etmezler.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3001,
            "SureId": 3,
            "AyetId": 136,
            "LanguageId": 5,
            "AyetNumber": "136",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "İşte onların yaptıklarının karşılığı rableri tarafından bir bağışlanma ve altlarından ırmaklar akan cennetlerdir. Onlar orada temelli kalacaklardır. Böyle amel edenlerin mükâfatı ne güzeldir!",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3008,
            "SureId": 3,
            "AyetId": 137,
            "LanguageId": 5,
            "AyetNumber": "137",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "Sizden önce nice uygulamalar geçmiştir. Yeryüzünde gezin de yalanlayanların sonunun ne olduğuna bir bakın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3015,
            "SureId": 3,
            "AyetId": 138,
            "LanguageId": 5,
            "AyetNumber": "138",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "Bu Kur’an insanlara bir açıklama, takvâ sahipleri için de bir hidayet ve bir öğüttür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3022,
            "SureId": 3,
            "AyetId": 139,
            "LanguageId": 5,
            "AyetNumber": "139",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "Gevşeklik göstermeyin, üzülmeyin; eğer inanmışsanız şüphesiz en üstün olan sizsiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3029,
            "SureId": 3,
            "AyetId": 140,
            "LanguageId": 5,
            "AyetNumber": "140",
            "AyetVisible": true,
            "Page": 67,
            "AyetText": "Eğer siz (Uhud’da) bir yara aldıysanız bilin ki o topluluk da benzeri bir yara almıştı. O günleri biz insanlar arasında döndürüp duruyoruz ki Allah gerçek müminleri ortaya çıkarsın ve uğrunda şehitleri olsun diye. Allah, zalimleri sevmez.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
