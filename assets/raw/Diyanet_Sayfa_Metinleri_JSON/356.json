    "QuranAyats": [
        {
            "Id": 19845,
            "SureId": 24,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "یُقَلِّبُ اللّٰهُ الَّیْلَ وَالنَّهَارَؕ اِنَّ فٖی ذٰلِكَ لَعِبْرَةً لِاُو𐻾لِی الْاَبْصَارِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 24,
                "MealInfo": "Medine döneminde inmiştir. 64 âyettir. Adını, 35. âyette geçen <b>“nûr</b>” kelimesinden almıştır. Sûre de başlıca; bireysel ve toplumsal hayatla ilgili çeşitli hüküm ve prensipler, özellikle aile hayatına dair esaslar yer almaktadır.",
                "SureNameTurkish": "Nûr",
                "SureNameArabic": "النُّورِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 102,
                "AyetCount": 64,
                "Cuz": 18,
                "FirstPage": 350,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19852,
            "SureId": 24,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "وَاللّٰهُ خَلَقَ كُلَّ دَٓابَّةٍ مِنْ مَٓاءٍۚ فَمِنْهُمْ مَنْ یَمْشٖی عَلٰى بَطْنِهٖۚ وَمِنْهُمْ مَنْ یَمْشٖی عَلٰى رِجْلَیْنِۚ وَمِنْهُمْ مَنْ یَمْشٖی عَلٰٓى اَرْبَعٍؕ یَخْلُقُ اللّٰهُ مَا یَشَٓاءُؕ اِنَّ اللّٰهَ عَلٰى كُلِّ شَیْءٍ قَدٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19859,
            "SureId": 24,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "لَقَدْ اَنْزَلْنَٓا اٰیَاتٍ مُبَیِّنَاتٍؕ وَاللّٰهُ یَهْدٖی مَنْ یَشَٓاءُ اِلٰى صِرَاطٍ مُسْتَقٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19866,
            "SureId": 24,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "وَیَقُولُونَ اٰمَنَّا بِاللّٰهِ وَبِالرَّسُولِ وَاَطَعْنَا ثُمَّ یَتَوَلّٰى فَرٖیقٌ مِنْهُمْ مِنْ بَعْدِ ذٰلِكَؕ وَمَٓا اُو𐻾لٰٓئِكَ بِالْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19873,
            "SureId": 24,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "وَاِذَا دُعُٓوا اِلَى اللّٰهِ وَرَسُولِهٖ لِیَحْكُمَ بَیْنَهُمْ اِذَا فَرٖیقٌ مِنْهُمْ مُعْرِضُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19880,
            "SureId": 24,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "وَاِنْ یَكُنْ لَهُمُ الْحَقُّ یَاْتُٓوا اِلَیْهِ مُذْعِنٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19887,
            "SureId": 24,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "اَفٖی قُلُوبِهِمْ مَرَضٌ اَمِ ارْتَابُٓوا اَمْ یَخَافُونَ اَنْ یَحٖیفَ اللّٰهُ عَلَیْهِمْ وَرَسُولُهُؕ بَلْ اُو𐻾لٰٓئِكَ هُمُ الظَّالِمُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19894,
            "SureId": 24,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "اِنَّمَا كَانَ قَوْلَ الْمُؤْمِنٖینَ اِذَا دُعُٓوا اِلَى اللّٰهِ وَرَسُولِهٖ لِیَحْكُمَ بَیْنَهُمْ اَنْ یَقُولُوا سَمِعْنَا وَاَطَعْنَاؕ وَاُو𐻾لٰٓئِكَ هُمُ الْمُفْلِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19901,
            "SureId": 24,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "وَمَنْ یُطِـعِ اللّٰهَ وَرَسُولَهُ وَیَخْشَ اللّٰهَ وَیَتَّقْهِ فَاُو𐻾لٰٓئِكَ هُمُ الْفَٓائِزُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19908,
            "SureId": 24,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "وَاَقْسَمُوا بِاللّٰهِ جَهْدَ اَیْمَانِهِمْ لَئِنْ اَمَرْتَهُمْ لَیَخْرُجُنَّؕ قُلْ لَا تُقْسِمُواۚ طَاعَةٌ مَعْرُوفَةٌؕ اِنَّ اللّٰهَ خَبٖیرٌ بِمَا تَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 19843,
            "SureId": 24,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "Allah geceyi gündüze, gündüzü geceye çevirir; gören ve düşünenler için bunlardan alınacak ibretler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 24,
                "MealInfo": "Medine döneminde inmiştir. 64 âyettir. Adını, 35. âyette geçen <b>“nûr</b>” kelimesinden almıştır. Sûre de başlıca; bireysel ve toplumsal hayatla ilgili çeşitli hüküm ve prensipler, özellikle aile hayatına dair esaslar yer almaktadır.",
                "SureNameTurkish": "Nûr",
                "SureNameArabic": "النُّورِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 102,
                "AyetCount": 64,
                "Cuz": 18,
                "FirstPage": 350,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19850,
            "SureId": 24,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "Allah hareket eden her canlıyı bir sudan yarattı. Bunlardan kimi karnı üzerinde sürünür, kimi iki ayak üzerinde yürür, kimi de dört ayak üzerinde yol alır. Allah dilediğini yaratıyor, Allah her şeye kādirdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19857,
            "SureId": 24,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "Kuşkusuz (açıkladıklarını) tam anlamıyla açıklayan âyetler indirdik; Allah dilediğini doğru yola iletir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19864,
            "SureId": 24,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "“Allah’a da, resule de inandık ve boyun eğdik” diyorlar, bunu söyledikten sonra da içlerinden bir grup yan çiziyor. Bunlar asla inanmış kimseler değildir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19871,
            "SureId": 24,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "Aralarındaki anlaşmazlıklar hakkında karar versin diye Allah’a ve resulüne çağırıldıklarında bir de bakıyorsun içlerinden bir grup buna karşı çıkmış!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19878,
            "SureId": 24,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "Haklı çıkacaklarını bilirlerse koşarak ona geliyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19885,
            "SureId": 24,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "Bunların kalplerinde çürüklük mü var, yoksa şüpheye mi düştüler ya da Allah’ın ve resulünün kendilerine haksızlık etmesinden mi korkuyorlar? Hayır, asıl haksızlık edenler kendileridir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19892,
            "SureId": 24,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "Aralarındaki anlaşmazlıkları çözüme bağlasın diye Allah’a ve resulüne çağrıldıklarında müminlerin sözü, “Dinledik ve boyun eğdik” demekten ibarettir. İşte kurtuluşa erenler de bunlardır!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19899,
            "SureId": 24,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "Allah’a ve resulüne itaat eden, Allah’a itaatsizlikten korkan, O’na saygısızlıktan korunanlar var ya, işte asıl kazananlar bunlardır!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19906,
            "SureId": 24,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 356,
            "AyetText": "Emir verirsen mutlaka çıkacaklarına dair büyük yeminler ettiler. De ki: “Boşuna yemin etmeyin, itaat belli bir şeydir; Allah bütün yaptıklarınızdan haberdardır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Nûr",
    "QuranSureLabel": "النُّورِ",
    "EndPageSure": null
}