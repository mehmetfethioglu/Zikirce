    "CuzNo": 23,
    "PageNo": 442,
    "ArCuzNo": "۲۳",
    "ArPageNo": "٤٤۲",
    "QuranAyats": [
        {
            "Id": 26131,
            "SureId": 36,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "وَمَٓا اَنْزَلْنَا عَلٰى قَوْمِهٖ مِنْ بَعْدِهٖ مِنْ جُنْدٍ مِنَ السَّمَٓاءِ وَمَا كُنَّا مُنْزِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 36,
                "MealInfo": "Mekke döneminde inmiştir. 83 âyettir. Sûre, adını ilk âyeti oluşturan <b>“Yâ-S</b>în” harflerinden almıştır. Sûrede başlıca i<b>nsanın ahlâkî sorumlulukları, vahiy, Hz. Peygamber’i yalanlayan Kureyş kabilesi, Antakya halkına gönderilen peygamberler, Allah’ın birliğini ve kudretini gösteren deliller, öldükten sonra dirilme,hesap ve ceza konu </b>edilmektedir.",
                "SureNameTurkish": "Yâsîn",
                "SureNameArabic": "يٰسۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 41,
                "AyetCount": 83,
                "Cuz": 22,
                "FirstPage": 440,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26138,
            "SureId": 36,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "اِنْ كَانَتْ اِلَّا صَیْحَةً وَاحِدَةً فَاِذَا هُمْ خَامِدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26145,
            "SureId": 36,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "یَا حَسْرَةً عَلَى الْعِبَادِۚ مَا یَاْتٖیهِمْ مِنْ رَسُولٍ اِلَّا كَانُوا بِهٖ یَسْتَهْزِؤُ𐻿نَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26152,
            "SureId": 36,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "اَلَمْ یَرَوْا كَمْ اَهْلَكْنَا قَبْلَهُمْ مِنَ الْقُرُونِ اَنَّهُمْ اِلَیْهِمْ لَا یَرْجِعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26159,
            "SureId": 36,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "وَاِنْ كُلٌّ لَمَّا جَمٖیعٌ لَدَیْنَا مُحْضَرُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26166,
            "SureId": 36,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "وَاٰیَةٌ لَهُمُ الْاَرْضُ الْمَیْتَةُۚ اَحْیَیْنَاهَا وَاَخْرَجْنَا مِنْهَا حَبًّا فَمِنْهُ یَاْكُلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26173,
            "SureId": 36,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "وَجَعَلْنَا فٖیهَا جَنَّاتٍ مِنْ نَخٖیلٍ وَاَعْنَابٍ وَفَجَّرْنَا فٖیهَا مِنَ الْعُیُونِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26180,
            "SureId": 36,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "لِیَاْكُلُوا مِنْ ثَمَرِهٖۙ وَمَا عَمِلَتْهُ اَیْدٖیهِمْؕ اَفَلَا یَشْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26187,
            "SureId": 36,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "سُبْحَانَ الَّذٖی خَلَقَ الْاَزْوَاجَ كُلَّهَا مِمَّا تُنْبِتُ الْاَرْضُ وَمِنْ اَنْفُسِهِمْ وَمِمَّا لَا یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26194,
            "SureId": 36,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "وَاٰیَةٌ لَهُمُ الَّیْلُۚ نَسْلَخُ مِنْهُ النَّهَارَ فَاِذَا هُمْ مُظْلِمُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26201,
            "SureId": 36,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "وَالشَّمْسُ تَجْرٖی لِمُسْتَقَرٍّ لَهَاؕ ذٰلِكَ تَقْدٖیرُ الْعَزٖیزِ الْعَلٖیمِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26208,
            "SureId": 36,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "وَالْقَمَرَ قَدَّرْنَاهُ مَنَازِلَ حَتّٰى عَادَ كَالْعُرْجُونِ الْقَدٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26215,
            "SureId": 36,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "لَا الشَّمْسُ یَنْبَغٖی لَهَٓا اَنْ تُدْرِكَ الْقَمَرَ وَلَا الَّیْلُ سَابِقُ النَّهَارِؕ وَكُلٌّ فٖی فَلَكٍ یَسْبَحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 26129,
            "SureId": 36,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "Ondan sonra kavmi üzerine gökten bir ordu indirmedik, indirmeyiz de.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 36,
                "MealInfo": "Mekke döneminde inmiştir. 83 âyettir. Sûre, adını ilk âyeti oluşturan <b>“Yâ-S</b>în” harflerinden almıştır. Sûrede başlıca i<b>nsanın ahlâkî sorumlulukları, vahiy, Hz. Peygamber’i yalanlayan Kureyş kabilesi, Antakya halkına gönderilen peygamberler, Allah’ın birliğini ve kudretini gösteren deliller, öldükten sonra dirilme,hesap ve ceza konu </b>edilmektedir.",
                "SureNameTurkish": "Yâsîn",
                "SureNameArabic": "يٰسۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 41,
                "AyetCount": 83,
                "Cuz": 22,
                "FirstPage": 440,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26136,
            "SureId": 36,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "(Cezaları) korkunç bir sesten ibaretti; sönüverdiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26143,
            "SureId": 36,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "O kullara yazıklar olsun! Kendilerine bir peygamber gelmeye görsün, onu mutlaka alaya alırlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26150,
            "SureId": 36,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "Onlardan önce nice nesilleri helâk ettiğimizi ve onların artık kendilerine dönüp gelmediğini görmezler mi!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26157,
            "SureId": 36,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "Elbette onların hepsi toplanıp huzurumuza getirilecek.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26164,
            "SureId": 36,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "Onlar için ölü toprak açık bir kanıttır. Ona can verdik ve ondan taneler çıkardık; işte bundan (yaptıkları yiyecekleri) yiyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26171,
            "SureId": 36,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "Orada nice hurma bahçeleri ve üzüm bağları meydana getirdik, içinde gözelerden su fışkırttık;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26178,
            "SureId": 36,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "Onun ürünlerinden ve kendi elleriyle ürettiklerinden yesinler diye. Hâlâ şükretmeyecekler mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26185,
            "SureId": 36,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "Toprağın bitirdiklerini, kendilerini ve daha bilmedikleri nice şeyleri çifter çifter yaratan Allah her türlü eksiklikten uzaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26192,
            "SureId": 36,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "Gece de onlar için açık bir kanıttır. Gündüzü ondan çekip alırız da karanlıkta kalıverirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26199,
            "SureId": 36,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "Güneş kendisine ait yerleşik bir düzene göre (yörüngesinde) akıp gider. Bu, çok güçlü ve her şeyi bilen Allah’ın takdiridir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26206,
            "SureId": 36,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "Ay için de menziller belirledik; sonunda o, hurma salkımının (ağaçta kalan) yıllanmış sapı gibi olur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26213,
            "SureId": 36,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 442,
            "AyetText": "Ne güneşin aya yetişip çatması uygundur ne de gece gündüzü geçebilir. Her biri bir yörüngede yüzüp gider.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Yâsîn",
    "QuranSureLabel": "يٰسۤ",
