{
    "PointerList": null,
    "CuzNo": 18,
    "PageNo": 345,
    "ArCuzNo": "۱۸",
    "ArPageNo": "۳٤٥",
    "QuranAyats": [
        {
            "Id": 19012,
            "SureId": 23,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "مَا تَسْبِقُ مِنْ اُمَّةٍ اَجَلَهَا وَمَا یَسْتَاْخِرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19019,
            "SureId": 23,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "ثُمَّ اَرْسَلْنَا رُسُلَنَا تَتْرَاؕ كُلَّمَا جَٓاءَ اُمَّةً رَسُولُهَا كَذَّبُوهُ فَاَتْبَعْنَا بَعْضَهُمْ بَعْضًا وَجَعَلْنَاهُمْ اَحَادٖیثَۚ فَبُعْدًا لِقَوْمٍ لَا یُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19026,
            "SureId": 23,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "ثُمَّ اَرْسَلْنَا مُوسٰى وَاَخَاهُ هٰرُونَ بِاٰیَاتِنَا وَسُلْطَانٍ مُبٖینٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19033,
            "SureId": 23,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "اِلٰى فِرْعَوْنَ وَمَلَا𐻾ئِهٖ فَاسْتَكْبَرُوا وَكَانُوا قَوْمًا عَالٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19040,
            "SureId": 23,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "فَقَالُٓوا اَنُؤْمِنُ لِبَشَرَیْنِ مِثْلِنَا وَقَوْمُهُمَا لَنَا عَابِدُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19047,
            "SureId": 23,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "فَكَذَّبُوهُمَا فَكَانُوا مِنَ الْمُهْلَكٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19054,
            "SureId": 23,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "وَلَقَدْ اٰتَیْنَا مُوسَى الْكِتَابَ لَعَلَّهُمْ یَهْتَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19061,
            "SureId": 23,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "وَجَعَلْنَا ابْنَ مَرْیَمَ وَاُمَّهُٓ اٰیَةً وَاٰوَیْنَاهُمَٓا اِلٰى رَبْوَةٍ ذَاتِ قَرَارٍ وَمَعٖینٍࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19068,
            "SureId": 23,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "یَٓا اَیُّهَا الرُّسُلُ كُلُوا مِنَ الطَّیِّبَاتِ وَاعْمَلُوا صَالِحًاؕ اِنّٖی بِمَا تَعْمَلُونَ عَلٖیمٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19075,
            "SureId": 23,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "وَاِنَّ هٰذِهٖٓ اُمَّتُكُمْ اُمَّةً وَاحِدَةً وَاَنَا𐻾 رَبُّكُمْ فَاتَّقُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19082,
            "SureId": 23,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "فَتَقَطَّعُٓوا اَمْرَهُمْ بَیْنَهُمْ زُبُرًاؕ كُلُّ حِزْبٍ بِمَا لَدَیْهِمْ فَرِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19089,
            "SureId": 23,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "فَذَرْهُمْ فٖی غَمْرَتِهِمْ حَتّٰى حٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19096,
            "SureId": 23,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "اَیَحْسَبُونَ اَنَّمَا نُمِدُّهُمْ بِهٖ مِنْ مَالٍ وَبَنٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19103,
            "SureId": 23,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "نُسَارِعُ لَهُمْ فِی الْخَیْرَاتِؕ بَلْ لَا یَشْعُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19110,
            "SureId": 23,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "اِنَّ الَّذٖینَ هُمْ مِنْ خَشْیَةِ رَبِّهِمْ مُشْفِقُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19117,
            "SureId": 23,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "وَالَّذٖینَ هُمْ بِاٰیَاتِ رَبِّهِمْ یُؤْمِنُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19124,
            "SureId": 23,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "وَالَّذٖینَ هُمْ بِرَبِّهِمْ لَا یُشْرِكُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 19010,
            "SureId": 23,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Hiçbir ümmet kendi ecelinin ne önüne geçebilir ne de (ondan) sonraya kalabilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19017,
            "SureId": 23,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Sonra birbiri ardından elçilerimizi gönderdik. Her bir ümmete kendi peygamberi geldikçe hep onu yalancılıkla suçladılar; biz de onları birbiri peşinden tarihe gömdük, onları ibret hikâyelerine dönüştürdük. İnanmayanların cehenneme kadar yolu var!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19024,
            "SureId": 23,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45-46",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Sonra Mûsâ ve kardeşi Hârûn’u, âyetlerimizle ve apaçık bir delil ile Firavun’a ve onun önde gelen adamlarına gönderdik. Fakat onlar büyüklük tasladılar. Zaten onlar herkese tepeden bakan bir topluluktu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19031,
            "SureId": 23,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": false,
            "Page": 345,
            "AyetText": "Sonra Mûsâ ve kardeşi Hârûn’u, âyetlerimizle ve apaçık bir delil ile Firavun’a ve onun önde gelen adamlarına gönderdik. Fakat onlar büyüklük tasladılar. Zaten onlar herkese tepeden bakan bir topluluktu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19038,
            "SureId": 23,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Nitekim şöyle dediler: “Soydaşları bize kölelik ederlerken bizden farklı olmayan bu iki adama mı inanacağız!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19045,
            "SureId": 23,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Böylece onları yalancılıkla itham ettiler, sonuçta helâk edilenler arasına onlar da katıldı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19052,
            "SureId": 23,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Gerçek şu ki, belki İsrâiloğulları yollarını düzeltirler diye Mûsâ’ya kitabı vermiştik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19059,
            "SureId": 23,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Meryem oğlu ile annesini de bir mûcize yaptık; ikisini de kalmaya elverişli, kaynak suyu bulunan yüksekçe bir yere yerleştirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19066,
            "SureId": 23,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Ey peygamberler! Tertemiz nimetlerden yiyip için, güzel işler yapın. Kuşkusuz ben yaptıklarınızı eksiksiz bilmekteyim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19073,
            "SureId": 23,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Biliniz ki, sizin şu ümmetiniz bir tek ümmettir, ben de sizin rabbinizim. Onun için yolumdan çıkmaktan sakının.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19080,
            "SureId": 23,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Ama insanlar, aralarındaki inanç bağlarını keserek gruplara ayrıldılar. Her kesim kendi inancını beğenmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19087,
            "SureId": 23,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Şimdi sen onları bir süre için gaflet ve dalâletleri içinde kendi hallerine bırak!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19094,
            "SureId": 23,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55-56",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Sanıyorlar mı ki, onlara mal ve evlâtlar verirken yalnızca iyilikleri için çırpınıyoruz! Hayır, onlar işin farkına varamıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19101,
            "SureId": 23,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": false,
            "Page": 345,
            "AyetText": "Sanıyorlar mı ki, onlara mal ve evlâtlar verirken yalnızca iyilikleri için çırpınıyoruz! Hayır, onlar işin farkına varamıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19108,
            "SureId": 23,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Rablerine olan derin saygılarından dolayı sorumlu davrananlar;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19115,
            "SureId": 23,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Rablerinin âyetlerine inananlar;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19122,
            "SureId": 23,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 345,
            "AyetText": "Rablerine ortak tanımayanlar;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
