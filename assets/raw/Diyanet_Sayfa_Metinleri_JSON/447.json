{
    "PointerList": null,
    "CuzNo": 23,
    "PageNo": 447,
    "ArCuzNo": "۲۳",
    "ArPageNo": "٤٤۷",
    "QuranAyats": [
        {
            "Id": 26691,
            "SureId": 37,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "مَا لَكُمْ لَا تَنَاصَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 37,
                "MealInfo": "Mekke döneminde inmiştir. 182 âyettir. Sûre, adını ilk âyette geçen <b>“es-Sâffât” </b>kelimesinden almıştır.<b> Sâffât, sıra sıra dizilenler, saf saf duranlar demektir</b>. Sûrede başlıca, <b>meleklerden, cinlerden, kıyamet ve ahiret olaylarından söz edilmekte; Nûh, İbrahim, İsmail, İshak, Mûsâ, Hârun, İlyas, Lût ve Yûnus Peygamberlerin kıssaları</b>na yer verilmektedir.",
                "SureNameTurkish": "Sâffât",
                "SureNameArabic": "الصَّاۤفَّاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 56,
                "AyetCount": 182,
                "Cuz": 23,
                "FirstPage": 446,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26698,
            "SureId": 37,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "بَلْ هُمُ الْیَوْمَ مُسْتَسْلِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26705,
            "SureId": 37,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "وَاَقْبَلَ بَعْضُهُمْ عَلٰى بَعْضٍ یَتَسَٓاءَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26712,
            "SureId": 37,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "قَالُٓوا اِنَّكُمْ كُنْتُمْ تَاْتُونَنَا عَنِ الْیَمٖینِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26719,
            "SureId": 37,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "قَالُوا بَلْ لَمْ تَكُونُوا مُؤْمِنٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26726,
            "SureId": 37,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "وَمَا كَانَ لَنَا عَلَیْكُمْ مِنْ سُلْطَانٍۚ بَلْ كُنْتُمْ قَوْمًا طَاغٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26733,
            "SureId": 37,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "فَحَقَّ عَلَیْنَا قَوْلُ رَبِّنَاࣗ اِنَّا لَذَٓائِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26740,
            "SureId": 37,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "فَاَغْوَیْنَا‌كُمْ اِنَّا كُنَّا غَاوٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26747,
            "SureId": 37,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "فَاِنَّهُمْ یَوْمَئِذٍ فِی الْعَذَابِ مُشْتَرِكُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26754,
            "SureId": 37,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "اِنَّا كَذٰلِكَ نَفْعَلُ بِالْمُجْرِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26761,
            "SureId": 37,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "اِنَّهُمْ كَانُٓوا اِذَا قٖیلَ لَهُمْ لَٓا اِلٰهَ اِلَّا اللّٰهُ یَسْتَكْبِرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26768,
            "SureId": 37,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "وَیَقُولُونَ اَئِنَّا لَتَارِكُٓوا اٰلِهَتِنَا لِشَاعِرٍ مَجْنُونٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26775,
            "SureId": 37,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "بَلْ جَٓاءَ بِالْحَقِّ وَصَدَّقَ الْمُرْسَلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26782,
            "SureId": 37,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "اِنَّكُمْ لَذَٓائِقُوا الْعَذَابِ الْاَلٖیمِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26789,
            "SureId": 37,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "وَمَا تُجْزَوْنَ اِلَّا مَا كُنْتُمْ تَعْمَلُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26796,
            "SureId": 37,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "اِلَّا عِبَادَ اللّٰهِ الْمُخْلَصٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26803,
            "SureId": 37,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "اُو𐻾لٰٓئِكَ لَهُمْ رِزْقٌ مَعْلُومٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26810,
            "SureId": 37,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "فَوَا‌كِهُۚ وَهُمْ مُكْرَمُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26817,
            "SureId": 37,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "فٖی جَنَّاتِ النَّعٖیمِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26824,
            "SureId": 37,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "عَلٰى سُرُرٍ مُتَقَابِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26831,
            "SureId": 37,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "یُطَافُ عَلَیْهِمْ بِكَاْسٍ مِنْ مَعٖینٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26838,
            "SureId": 37,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "بَیْضَٓاءَ لَذَّةٍ لِلشَّارِبٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26845,
            "SureId": 37,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "لَا فٖیهَا غَوْلٌ وَلَا هُمْ عَنْهَا یُنْزَفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26852,
            "SureId": 37,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "وَعِنْدَهُمْ قَاصِرَاتُ الطَّرْفِ عٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26859,
            "SureId": 37,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "كَاَنَّهُنَّ بَیْضٌ مَكْنُونٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26866,
            "SureId": 37,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "فَاَقْبَلَ بَعْضُهُمْ عَلٰى بَعْضٍ یَتَسَٓاءَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26873,
            "SureId": 37,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "قَالَ قَٓائِلٌ مِنْهُمْ اِنّٖی كَانَ لٖی قَرٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 26689,
            "SureId": 37,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "“(Ey inkârcılar!) Size ne oldu ki şimdi birbirinize yardım etmiyorsunuz?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 37,
                "MealInfo": "Mekke döneminde inmiştir. 182 âyettir. Sûre, adını ilk âyette geçen <b>“es-Sâffât” </b>kelimesinden almıştır.<b> Sâffât, sıra sıra dizilenler, saf saf duranlar demektir</b>. Sûrede başlıca, <b>meleklerden, cinlerden, kıyamet ve ahiret olaylarından söz edilmekte; Nûh, İbrahim, İsmail, İshak, Mûsâ, Hârun, İlyas, Lût ve Yûnus Peygamberlerin kıssaları</b>na yer verilmektedir.",
                "SureNameTurkish": "Sâffât",
                "SureNameArabic": "الصَّاۤفَّاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 56,
                "AyetCount": 182,
                "Cuz": 23,
                "FirstPage": 446,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26696,
            "SureId": 37,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Evet, o gün onlar artık çaresiz boyun eğmişlerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26703,
            "SureId": 37,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Biri diğerine yönelir, karşılıklı birbirini sorumlu tutup suçlarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26710,
            "SureId": 37,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Derler ki: “Siz, evet siz, bize iyi niyetliymiş gibi görünerek gelirdiniz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26717,
            "SureId": 37,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Diğerleri, “Aksine” derler, “Siz inanmış kimseler değildiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26724,
            "SureId": 37,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Bizim, sizin üzerinizde hiçbir etkili baskımız olmamıştı; bilâkis siz azgın bir topluluktunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26731,
            "SureId": 37,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Sonuçta rabbimizin hükmünü hepimiz hak ettik; artık (gerekli cezayı) mutlaka tadacağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26738,
            "SureId": 37,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Evet, sizi saptırdık, çünkü biz kendimiz sapmıştık.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26745,
            "SureId": 37,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "O gün onlar azap görmede ortaktırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26752,
            "SureId": 37,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "İşte biz suçlulara böyle yaparız!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26759,
            "SureId": 37,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Ne zaman onlara, “Allah’tan başka tanrı yoktur” denilse küstahlık edip kibre kapılırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26766,
            "SureId": 37,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "“Cinlere kapılmış bir şairin sözüyle tanrılarımızı mı bırakacağız!” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26773,
            "SureId": 37,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Aksine o, gerçeği getirdi, Allah’ın diğer elçilerini de doğruladı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26780,
            "SureId": 37,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Ama siz, o acı azabı tadacaksınız!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26787,
            "SureId": 37,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Ve sadece yapmış olduklarınızdan dolayı cezalandırılacaksınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26794,
            "SureId": 37,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Ancak, Allah’ın samimi kulları bu cezanın dışındadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26801,
            "SureId": 37,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Onlar için belirli bir rızık vardır:",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26808,
            "SureId": 37,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Türlü meyveler… Onlara nice ikramlarda bulunulacaktır;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26815,
            "SureId": 37,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 447,
            "AyetText": "Nimetlerle dolu cennetlerde;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26822,
