    "QuranAyats": [
        {
            "Id": 20293,
            "SureId": 25,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "اَمْ تَحْسَبُ اَنَّ اَكْثَرَهُمْ یَسْمَعُونَ اَوْ یَعْقِلُونَؕ اِنْ هُمْ اِلَّا كَالْاَنْعَامِ بَلْ هُمْ اَضَلُّ سَبٖیلًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 25,
                "MealInfo": "Mekke döneminde inmiştir. 68-70. âyetlerin Medine döneminde indiği konusunda bir rivayet de vardır. 77 âyettir. Sûre, adını ilk âyette geçen <b>“elFurkân</b>” kelimesinden almaktadır. <b>Furkân, “hak ile batılı birbirinden ayıran”demek olup Kur’an’ın isimlerinden biridir.</b> Sûre de temel konular olarak Hz.Peygamber’in tüm insanlığa gönderildiği, onun tebliğ sırasında karşılaştığı zorluklar ve şirkin kökünün kazınacağı, geçmiş ümmetlerin hayatlarından bazı örnekler de verilerek ele alınmaktadır.",
                "SureNameTurkish": "Furkân",
                "SureNameArabic": "الْفُرْقَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 42,
                "AyetCount": 77,
                "Cuz": 18,
                "FirstPage": 359,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20300,
            "SureId": 25,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "اَلَمْ تَرَ اِلٰى رَبِّكَ كَیْفَ مَدَّ الظِّلَّۚ وَلَوْ شَٓاءَ لَجَعَلَهُ سَاكِنًاۚ ثُمَّ جَعَلْنَا الشَّمْسَ عَلَیْهِ دَلٖیلًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20307,
            "SureId": 25,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "ثُمَّ قَبَضْنَاهُ اِلَیْنَا قَبْضًا یَسٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20314,
            "SureId": 25,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "وَهُوَ الَّذٖی جَعَلَ لَكُمُ الَّیْلَ لِبَاسًا وَالنَّوْمَ سُبَاتًا وَجَعَلَ النَّهَارَ نُشُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20321,
            "SureId": 25,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "وَهُوَ الَّذٖٓی اَرْسَلَ الرِّیَاحَ بُشْرًا بَیْنَ یَدَیْ رَحْمَتِهٖۚ وَاَنْزَلْنَا مِنَ السَّمَٓاءِ مَٓاءً طَهُورًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20328,
            "SureId": 25,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "لِنُحْیِیَ بِهٖ بَلْدَةً مَیْتًا وَنُسْقِیَهُ مِمَّا خَلَقْنَٓا اَنْعَامًا وَاَنَاسِیَّ كَثٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20335,
            "SureId": 25,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "وَلَقَدْ صَرَّفْنَاهُ بَیْنَهُمْ لِیَذَّكَّرُواؗ فَاَبٰٓى اَكْثَرُ النَّاسِ اِلَّا كُفُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20342,
            "SureId": 25,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "وَلَوْ شِئْنَا لَبَعَثْنَا فٖی كُلِّ قَرْیَةٍ نَذٖیرًاؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20349,
            "SureId": 25,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "فَلَا تُطِعِ الْكَافِرٖینَ وَجَاهِدْهُمْ بِهٖ جِهَادًا كَبٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20356,
            "SureId": 25,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "وَهُوَ الَّذٖی مَرَجَ الْبَحْرَیْنِ هٰذَا عَذْبٌ فُرَاتٌ وَهٰذَا مِلْحٌ اُجَاجٌۚ وَجَعَلَ بَیْنَهُمَا بَرْزَخًا وَحِجْرًا مَحْجُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20363,
            "SureId": 25,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "وَهُوَ الَّذٖی خَلَقَ مِنَ الْمَٓاءِ بَشَرًا فَجَعَلَهُ نَسَبًا وَصِهْرًاؕ وَكَانَ رَبُّكَ قَدٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20370,
            "SureId": 25,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "وَیَعْبُدُونَ مِنْ دُونِ اللّٰهِ مَا لَا یَنْفَعُهُمْ وَلَا یَضُرُّهُمْؕ وَكَانَ الْكَافِرُ عَلٰى رَبِّهٖ ظَهٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 20291,
            "SureId": 25,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "Yoksa sen, onların büyük çoğunluğunun gerçekten senin davetine kulak verdiklerini yahut doğru dürüst düşündüklerini mi sanıyorsun? Aksine onlar, başka değil, bir hayvan sürüsü gibidirler, hatta tuttukları yol bakımından daha da sapkındırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 25,
                "MealInfo": "Mekke döneminde inmiştir. 68-70. âyetlerin Medine döneminde indiği konusunda bir rivayet de vardır. 77 âyettir. Sûre, adını ilk âyette geçen <b>“elFurkân</b>” kelimesinden almaktadır. <b>Furkân, “hak ile batılı birbirinden ayıran”demek olup Kur’an’ın isimlerinden biridir.</b> Sûre de temel konular olarak Hz.Peygamber’in tüm insanlığa gönderildiği, onun tebliğ sırasında karşılaştığı zorluklar ve şirkin kökünün kazınacağı, geçmiş ümmetlerin hayatlarından bazı örnekler de verilerek ele alınmaktadır.",
                "SureNameTurkish": "Furkân",
                "SureNameArabic": "الْفُرْقَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 42,
                "AyetCount": 77,
                "Cuz": 18,
                "FirstPage": 359,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20298,
            "SureId": 25,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "Rabbinin gölgeyi nasıl uzattığını görmedin mi? Eğer dileseydi onu elbet hareketsiz de kılardı. Sonra güneşi gölgeye yol gösterici kılmı­şızdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20305,
            "SureId": 25,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "Sonra da onu yavaş yavaş kendimize çekmekteyiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20312,
            "SureId": 25,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "Sizin için geceyi bir örtü, uykuyu dinlenme hali kılan, gündüz vaktini ise bir diriliş ortamı yapan O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20319,
            "SureId": 25,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48-49",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "Rüzgârları rahmetinin önünde müjdeci olarak gönderen O’dur. Gökten de tertemiz su indirdik ki onunla ölü toprağı canlandıralım ve hayvanıyla insanıyla yarattığımız nice varlıkları suya kavuşturalım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20326,
            "SureId": 25,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": false,
            "Page": 364,
            "AyetText": "Rüzgârları rahmetinin önünde müjdeci olarak gönderen O’dur. Gökten de tertemiz su indirdik ki onunla ölü toprağı canlandıralım ve hayvanıyla insanıyla yarattığımız nice varlıkları suya kavuşturalım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20333,
            "SureId": 25,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "Gerçek şu ki, biz bütün bunları, insanlar doğru dürüst düşünüp ders çıkarsınlar diye kendilerine tekrar tekrar anlatmışızdır; buna rağmen insanların çoğu nankörlükte direnip durmuşlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20340,
            "SureId": 25,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "Eğer isteseydik her yerleşik topluluğa bir uyarıcı gönderirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20347,
            "SureId": 25,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "Öyleyse artık inkârcılara boyun eğme, bu Kur’an’la onlara karşı bütün gücünle mücadeleni sürdür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20354,
            "SureId": 25,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "Biri tatlı ve susuzluğu giderici, diğeri tuzlu ve acı olan iki denizi karışacak şekilde salıveren ve ikisi arasına bir engel, aşılmaz bir perde koyan O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20361,
            "SureId": 25,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "İnsan türünü sudan yaratıp onların arasında soy ve sıhriyet bağı kuran da O’dur. Rabbin üstün kudret sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20368,
            "SureId": 25,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 364,
            "AyetText": "Ama onlar, Allah’ı bırakıp kendilerine ne faydası ne de zararı dokunan şeylere kulluk ediyorlar. Zaten inkârcı kişi, rabbine karşı inkârcıya arka çıkar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
