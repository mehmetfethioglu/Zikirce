{
    "PointerList": null,
    "CuzNo": 18,
    "PageNo": 346,
    "ArCuzNo": "۱۸",
    "ArPageNo": "۳٤٦",
    "QuranAyats": [
        {
            "Id": 19131,
            "SureId": 23,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "وَالَّذٖینَ یُؤْتُونَ مَٓا اٰتَوْا وَقُلُوبُهُمْ وَجِلَةٌ اَنَّهُمْ اِلٰى رَبِّهِمْ رَاجِعُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19138,
            "SureId": 23,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "اُو𐻾لٰٓئِكَ یُسَارِعُونَ فِی الْخَیْرَاتِ وَهُمْ لَهَا سَابِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19145,
            "SureId": 23,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "وَلَا نُكَلِّفُ نَفْسًا اِلَّا وُسْعَهَا وَلَدَیْنَا كِتَابٌ یَنْطِقُ بِالْحَقِّ وَهُمْ لَا یُظْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19152,
            "SureId": 23,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "بَلْ قُلُوبُهُمْ فٖی غَمْرَةٍ مِنْ هٰذَا وَلَهُمْ اَعْمَالٌ مِنْ دُونِ ذٰلِكَ هُمْ لَهَا عَامِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19159,
            "SureId": 23,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "حَتّٰٓى اِذَٓا اَخَذْنَا مُتْرَفٖیهِمْ بِالْعَذَابِ اِذَا هُمْ یَجْــَٔرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19166,
            "SureId": 23,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "لَا تَجْــَٔرُوا الْیَوْمَ اِنَّـكُمْ مِنَّا لَا تُنْصَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19173,
            "SureId": 23,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "قَدْ كَانَتْ اٰیَاتٖی تُتْلٰى عَلَیْكُمْ فَكُنْتُمْ عَلٰٓى اَعْقَابِكُمْ تَنْكِصُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19180,
            "SureId": 23,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "مُسْتَكْبِرٖینَ بِهٖࣗ سَامِرًا تَهْجُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19187,
            "SureId": 23,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "اَفَلَمْ یَدَّبَّرُوا الْقَوْلَ اَمْ جَٓاءَهُمْ مَا لَمْ یَاْتِ اٰبَٓاءَهُمُ الْاَوَّلٖینَؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19194,
            "SureId": 23,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "اَمْ لَمْ یَعْرِفُوا رَسُولَهُمْ فَهُمْ لَهُ مُنْكِرُونَؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19201,
            "SureId": 23,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "اَمْ یَقُولُونَ بِهٖ جِنَّةٌؕ بَلْ جَٓاءَهُمْ بِالْحَقِّ وَاَكْثَرُهُمْ لِلْحَقِّ كَارِهُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19208,
            "SureId": 23,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "وَلَوِ اتَّبَعَ الْحَقُّ اَهْوَٓاءَهُمْ لَفَسَدَتِ السَّمٰوَاتُ وَالْاَرْضُ وَمَنْ فٖیهِنَّؕ بَلْ اَتَیْنَاهُمْ بِذِكْرِهِمْ فَهُمْ عَنْ ذِكْرِهِمْ مُعْرِضُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19215,
            "SureId": 23,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "اَمْ تَسْـَٔلُهُمْ خَرْجًا فَخَرَاجُ رَبِّكَ خَیْرٌࣗ وَهُوَ خَیْرُ الرَّازِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19222,
            "SureId": 23,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "وَاِنَّكَ لَتَدْعُوهُمْ اِلٰى صِرَاطٍ مُسْتَقٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19229,
            "SureId": 23,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "وَاِنَّ الَّذٖینَ لَا یُؤْمِنُونَ بِالْاٰخِرَةِ عَنِ الصِّرَاطِ لَنَاكِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 19129,
            "SureId": 23,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "Verdiklerini, rablerine dönecekleri inancından dolayı kalpleri ürpererek verenler;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19136,
            "SureId": 23,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "İşte bunlar iyiliklere koşup, bu uğurda yarışırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19143,
            "SureId": 23,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "Biz hiç kimseyi gücünün yettiğinden fazlasıyla yükümlü kılmayız. Katımızda hakkı söyleyen bir kitap vardır, onlara haksızlık edilmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19150,
            "SureId": 23,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "Hayır! O inkârcıların kalpleri bu hususta tam bir bilgisizlik karanlığı içindedir, onların bunlar dışında da hep yapıp durdukları nice (kötü) işleri vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19157,
            "SureId": 23,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "İçlerinden refah ve bolluk içinde olanları, sonunda cezalandırmaya başladığımızda bakarsın ki feryadı basarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19164,
            "SureId": 23,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "Bugün boşuna sızlanmayın! Çünkü siz, bizden yardım göremeyeceksiniz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19171,
            "SureId": 23,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66-67",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "Zira âyetlerimiz size okunurdu da arkanızı dönüp giderdiniz; gece sohbetleri yaparken büyüklük taslayarak onun hakkında hezeyanlar savururdunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19178,
            "SureId": 23,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": false,
            "Page": 346,
            "AyetText": "Zira âyetlerimiz size okunurdu da ona arkanızı dönerdiniz; gece sohbetleri yaparken büyüklük taslayarak onun hakkında hezeyanlar savururdunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19185,
            "SureId": 23,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "Onlar bu söz (Kur’an) üzerinde hiç düşünmezler mi? Yoksa kendilerine, daha önce atalarına gelmeyen bir şey mi geldi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19192,
            "SureId": 23,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "Yahut kendi peygamberlerini daha tanımadılar da, o yüzden mi onu inkâr ­ediyorlar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19199,
            "SureId": 23,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "Veya onda bir çeşit cinnet bulunduğunu mu söylüyorlar? Bilâkis o, kendilerine gerçeği getirmiştir, ama onların çoğu gerçeği sevmiyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19206,
            "SureId": 23,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "Eğer hak onların keyfî arzularına uysaydı muhakkak ki gökler, yer ve bunlarda bulunanların düzeni bozulurdu. Hayır! Biz onlara şan ve şereflerini getirdik, fakat onlar kendi şereflerine sırt çevirmektedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19213,
            "SureId": 23,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "Sen onlardan bir karşılık mı istiyorsun ki! (İstemezsin, çünkü) rabbinin vereceği karşılık daha hayırlıdır; O, rızık verenlerin en üstünüdür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19220,
            "SureId": 23,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "Gerçek şu ki sen onları dosdoğru bir yola çağırıyorsun.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19227,
            "SureId": 23,
            "AyetId": 74,
            "LanguageId": 5,
            "AyetNumber": "74",
            "AyetVisible": true,
            "Page": 346,
            "AyetText": "Âhirete inanmayanlar ise ısrarla yoldan sapmaktalar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Mü'minûn",
    "QuranSureLabel": "الْمُؤْمِنُونَ",
    "EndPageSure": null
}