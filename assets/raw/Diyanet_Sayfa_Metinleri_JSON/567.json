{
    "PointerList": null,
    "CuzNo": 29,
    "PageNo": 567,
    "ArCuzNo": "۲۹",
    "ArPageNo": "٥٦۷",
    "QuranAyats": [
        {
            "Id": 37324,
            "SureId": 69,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "وَجَٓاءَ فِرْعَوْنُ وَمَنْ قَبْلَهُ وَالْمُؤْتَفِكَاتُ بِالْخَاطِئَةِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 69,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. Sûre, adını birinci âyeti oluşturan“el-Hâkka” kelimesinden almıştır. Hâkka, mutlaka gerçekleşecek olan kıyametdemektir. Sûrede başlıca, Kıyameti inkâr edenlerin görecekleri cezalarve mü’minler ile kâfirlerin dehşetli Kıyamet günündeki hâlleri konu edilmektedir.",
                "SureNameTurkish": "Hâkka",
                "SureNameArabic": "الْحَاقَّةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 78,
                "AyetCount": 52,
                "Cuz": 29,
                "FirstPage": 566,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37331,
            "SureId": 69,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "فَعَصَوْا رَسُولَ رَبِّهِمْ فَاَخَذَهُمْ اَخْذَةً رَابِیَةً",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37338,
            "SureId": 69,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "اِنَّا لَمَّا طَغَا الْمَٓاءُ حَمَلْنَاكُمْ فِی الْجَارِیَةِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37345,
            "SureId": 69,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِیَهَٓا اُذُنٌ وَاعِیَةٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37352,
            "SureId": 69,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "فَاِذَا نُفِخَ فِی الصُّورِ نَفْخَةٌ وَاحِدَةٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37359,
            "SureId": 69,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "وَحُمِلَتِ الْاَرْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةً وَاحِدَةً",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37366,
            "SureId": 69,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "فَیَوْمَئِذٍ وَقَعَتِ الْوَاقِعَةُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37373,
            "SureId": 69,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "وَانْشَقَّتِ السَّمَٓاءُ فَهِیَ یَوْمَئِذٍ وَاهِیَةٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37380,
            "SureId": 69,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "وَالْمَلَكُ عَلٰٓى اَرْجَٓائِهَاؕ وَیَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ یَوْمَئِذٍ ثَمَانِیَةٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37387,
            "SureId": 69,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "یَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفٰى مِنْكُمْ خَافِیَةٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37394,
            "SureId": 69,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "فَاَمَّا مَنْ اُو𐻿تِیَ كِتَابَهُ بِیَمٖینِهٖ فَیَقُولُ هَٓاؤُ𐻾مُ اقْرَؤُ𐻿ا كِتَابِیَهْۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37401,
            "SureId": 69,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "اِنّٖی ظَنَنْتُ اَنّٖی مُلَاقٍ حِسَابِیَهْۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37408,
            "SureId": 69,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "فَهُوَ فٖی عٖیشَةٍ رَاضِیَةٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37415,
            "SureId": 69,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "فٖی جَنَّةٍ عَالِیَةٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37422,
            "SureId": 69,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "قُطُوفُهَا دَانِیَةٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37429,
            "SureId": 69,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "كُلُوا وَاشْرَبُوا هَنٖٓیـًٔا بِمَٓا اَسْلَفْتُمْ فِی الْاَیَّامِ الْخَالِیَةِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37436,
            "SureId": 69,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "وَاَمَّا مَنْ اُو𐻿تِیَ كِتَابَهُ بِشِمَالِهٖ فَیَقُولُ یَا لَیْتَنٖی لَمْ اُو𐻿تَ كِتَابِیَهْۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37443,
            "SureId": 69,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "وَلَمْ اَدْرِ مَا حِسَابِیَهْۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37450,
            "SureId": 69,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "یَا لَیْتَهَا كَانَتِ الْقَاضِیَةَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37457,
            "SureId": 69,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "مَٓا اَغْنٰى عَنّٖی مَالِیَهْۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37464,
            "SureId": 69,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "هَلَكَ عَنّٖی سُلْطَانِیَهْۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37471,
            "SureId": 69,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "خُذُوهُ فَغُلُّوهُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37478,
            "SureId": 69,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "ثُمَّ الْجَحٖیمَ صَلُّوهُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37485,
            "SureId": 69,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "ثُمَّ فٖی سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَاسْلُكُوهُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37492,
            "SureId": 69,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "اِنَّهُ كَانَ لَا یُؤْمِنُ بِاللّٰهِ الْعَظٖیمِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37499,
            "SureId": 69,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "وَلَا یَحُضُّ عَلٰى طَعَامِ الْمِسْكٖینِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 37322,
            "SureId": 69,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Firavun, ondan öncekiler ve altı üstüne getirilen şehirler (halkı) hep o günahı işlediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 69,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. Sûre, adını birinci âyeti oluşturan“el-Hâkka” kelimesinden almıştır. Hâkka, mutlaka gerçekleşecek olan kıyametdemektir. Sûrede başlıca, Kıyameti inkâr edenlerin görecekleri cezalarve mü’minler ile kâfirlerin dehşetli Kıyamet günündeki hâlleri konu edilmektedir.",
                "SureNameTurkish": "Hâkka",
                "SureNameArabic": "الْحَاقَّةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 78,
                "AyetCount": 52,
                "Cuz": 29,
                "FirstPage": 566,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37329,
            "SureId": 69,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Rablerinin elçisine karşı geldiler, O da onları amansız bir şekilde yakalayıp ­cezalandırdı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37336,
            "SureId": 69,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Bir zamanlar sular coştuğu vakit sizi gemide kuşkusuz biz taşıdık;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37343,
            "SureId": 69,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Bunu sizin için ibretli bir ders olsun ve kulaklardan hiç çıkmasın diye yaptık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37350,
            "SureId": 69,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Sûra bir defa üflendiğinde;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37357,
            "SureId": 69,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Yeryüzü ve dağlar yerlerinden sökülüp birbirine bir defa çarptırılarak darmadağın ­edildiğinde;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37364,
            "SureId": 69,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "İşte o gün olacak olur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37371,
            "SureId": 69,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Gök yarılır, o gün (bütün) bunların düzeni çökmüştür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37378,
            "SureId": 69,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Melekler göklerin etrafındadır. O gün rabbinin arşını bunların da üstünde olan sekiz (melek) yüklenir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37385,
            "SureId": 69,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "O gün hesaba çekilirsiniz, size ait hiçbir sır gizli kalmaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37392,
            "SureId": 69,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Kitabı sağ tarafından verilen kimse der ki “Alın kitabımı okuyun;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37399,
            "SureId": 69,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Doğrusu ben, hesabımla karşılaşacağımı zaten bekliyordum.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37406,
            "SureId": 69,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Artık o, hoşnut olacağı bir hayat içindedir;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37413,
            "SureId": 69,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22-23",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Meyveleri kolayca devşirilebilir yüce bir cennettedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37420,
            "SureId": 69,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": false,
            "Page": 567,
            "AyetText": "Meyveleri kolayca devşirilebilir yüce bir cennettedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37427,
            "SureId": 69,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Onlara “Geçmiş günlerde yaptıklarınıza karşılık olarak âfiyetle yiyin için” denir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37434,
            "SureId": 69,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25-26",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Kitabı sol tarafından verilene gelince o, “Keşke” der, “Bana kitabım verilmeseydi de hesabımın ne olduğunu bilmeseydim!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37441,
            "SureId": 69,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": false,
            "Page": 567,
            "AyetText": "Kitabı sol tarafından verilene gelince o, \"Keşke\" der, \"Bana kitabım verilmeseydi de hesabımın ne olduğunu bilmeseydim!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37448,
            "SureId": 69,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Keşke ölümüm her şeyi bitirseydi!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37455,
            "SureId": 69,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Malım bana hiç fayda sağlamadı;",
