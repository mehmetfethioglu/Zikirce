        {
            "Id": 37462,
            "SureId": 69,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 567,
            "AyetText": "Güç ve saltanatım elimden çıkıp gitti.”",
