    "QuranAyats": [
        {
            "Id": 38136,
            "SureId": 72,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "قُلْ اُو𐻿حِیَ اِلَیَّ اَنَّهُ اسْتَمَعَ نَفَرٌ مِنَ الْجِنِّ فَقَالُٓوا اِنَّا سَمِعْنَا قُرْاٰنًا عَجَبًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 72,
                "MealInfo": "Mekke döneminde inmiştir. 28 âyettir. Ağırlıklı olarak cinlerden bahsettiğiiçin “Cin sûresi” adını almıştır. Sûrede ayrıca tevhit, peygamberlik ve öldüktensonra dirilmek gibi meseleler konu edilmektedir.",
                "SureNameTurkish": "Cin",
                "SureNameArabic": "الْجِنِّ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 40,
                "AyetCount": 28,
                "Cuz": 29,
                "FirstPage": 572,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 38143,
            "SureId": 72,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "یَهْدٖٓی اِلَى الرُّشْدِ فَاٰمَنَّا بِهٖؕ وَلَنْ نُشْرِكَ بِرَبِّنَٓا اَحَدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38150,
            "SureId": 72,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "وَاَنَّهُ تَعَالٰى جَدُّ رَبِّنَا مَا اتَّخَذَ صَاحِبَةً وَلَا وَلَدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38157,
            "SureId": 72,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "وَاَنَّهُ كَانَ یَقُولُ سَفٖیهُنَا عَلَى اللّٰهِ شَطَطًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38164,
            "SureId": 72,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "وَاَنَّا ظَنَنَّٓا اَنْ لَنْ تَقُولَ الْاِنْسُ وَالْجِنُّ عَلَى اللّٰهِ كَذِبًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38171,
            "SureId": 72,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "وَاَنَّهُ كَانَ رِجَالٌ مِنَ الْاِنْسِ یَعُوذُونَ بِرِجَالٍ مِنَ الْجِنِّ فَزَادُوهُمْ رَهَقًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38178,
            "SureId": 72,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "وَاَنَّهُمْ ظَنُّوا كَمَا ظَنَنْتُمْ اَنْ لَنْ یَبْعَثَ اللّٰهُ اَحَدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38185,
            "SureId": 72,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "وَاَنَّا لَمَسْنَا السَّمَٓاءَ فَوَجَدْنَاهَا مُلِئَتْ حَرَسًا شَدٖیدًا وَشُهُبًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38192,
            "SureId": 72,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "وَاَنَّا كُنَّا نَقْعُدُ مِنْهَا مَقَاعِدَ لِلسَّمْعِؕ فَمَنْ یَسْتَمِعِ الْاٰنَ یَجِدْ لَهُ شِهَابًا رَصَدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38199,
            "SureId": 72,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "وَاَنَّا لَا نَدْرٖٓی اَشَرٌّ اُرٖیدَ بِمَنْ فِی الْاَرْضِ اَمْ اَرَادَ بِهِمْ رَبُّهُمْ رَشَدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38206,
            "SureId": 72,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "وَاَنَّا مِنَّا الصَّالِحُونَ وَمِنَّا دُونَ ذٰلِكَؕ كُنَّا طَرَٓائِقَ قِدَدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38213,
            "SureId": 72,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "وَاَنَّا ظَنَنَّٓا اَنْ لَنْ نُعْجِزَ اللّٰهَ فِی الْاَرْضِ وَلَنْ نُعْجِزَهُ هَرَبًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38220,
            "SureId": 72,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "وَاَنَّا لَمَّا سَمِعْنَا الْهُدٰٓى اٰمَنَّا بِهٖؕ فَمَنْ یُؤْمِنْ بِرَبِّهٖ فَلَا یَخَافُ بَخْسًا وَلَا رَهَقًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 38134,
            "SureId": 72,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1-2",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "De ki: Cinlerden bir topluluğun (Kur’an’ı) dinleyip şöyle söyledikleri bana vahyolundu: “Biz, doğru yolu gösteren harika bir okuma dinledik ve ona iman ettik. Artık kesinlikle rabbimize kimseyi ortak koşmayacağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 72,
                "MealInfo": "Mekke döneminde inmiştir. 28 âyettir. Ağırlıklı olarak cinlerden bahsettiğiiçin “Cin sûresi” adını almıştır. Sûrede ayrıca tevhit, peygamberlik ve öldüktensonra dirilmek gibi meseleler konu edilmektedir.",
                "SureNameTurkish": "Cin",
                "SureNameArabic": "الْجِنِّ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 40,
                "AyetCount": 28,
                "Cuz": 29,
                "FirstPage": 572,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 38141,
            "SureId": 72,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": false,
            "Page": 572,
            "AyetText": "De ki: Cinlerden bir topluluğun (Kur’an’ı) dinleyip şöyle söyledikleri bana vahyolundu: \"Biz, doğru yolu gösteren harika bir okuma dinledik ve ona iman ettik. Artık kesinlikle rabbimize kimseyi ortak koşmayacağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38148,
            "SureId": 72,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "Şu muhakkak ki rabbimizin şanı çok yücedir; O, ne bir eş edinmiştir ne de çocuk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38155,
            "SureId": 72,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "Demek aramızdaki beyinsiz, Allah hakkında ipe sapa gelmez şeyler söylüyormuş.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38162,
            "SureId": 72,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "Oysa biz, insanların ve cinlerin Allah hakkında asla gerçek dışı şeyler söylemeyeceklerini ­sanırdık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38169,
            "SureId": 72,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "İnsanlardan bazı kimseler cinlerden bazı kimselere sığınırlardı, onlar da bunları daha sapkın hale getirirlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38176,
            "SureId": 72,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "Tıpkı sizin sandığınız gibi onlar da Allah’ın hiç kimseyi tekrar diriltmeyeceğini ­zannederlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38183,
            "SureId": 72,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "Hakikaten biz (cinler) göğü yokladık, onu güçlü muhafızlar ve alev toplarıyla doldurulmuş bulduk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38190,
            "SureId": 72,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "Halbuki biz (daha önce, göğü) dinlemek için onun oturulabilecek yerlerinde otururduk; fakat şimdi kim dinlemek isterse kendisini gözetleyen bir alev topuyla karşılaşıyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38197,
            "SureId": 72,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "Bilmiyoruz, yeryüzündekiler hakkında bir kötülük mü murat edildi yoksa rableri onlar için bir iyilik mi diledi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38204,
            "SureId": 72,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "Doğrusu içimizde iyiler var, ama aramızda başka türlü olanlar da var; hâsılı biz farklı gruplardan oluşuyoruz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38211,
            "SureId": 72,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "Sonunda anladık ki yeryüzünde Allah’ın iradesini asla engelleyemeyiz; kaçmakla da O’nun elinden kurtulamayız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38218,
            "SureId": 72,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 572,
            "AyetText": "Ve biz doğru yol rehberini dinler dinlemez ona iman ettik; rabbine iman eden kimse artık ne ziyandan ne de azıp sapmaktan korkar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
