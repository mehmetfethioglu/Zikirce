            "Sure": null
        },
        {
            "Id": 38626,
            "SureId": 74,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "ثُمَّ اَدْبَرَ وَاسْتَكْبَرَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38633,
            "SureId": 74,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "فَقَالَ اِنْ هٰذَٓا اِلَّا سِحْرٌ یُؤْثَرُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
