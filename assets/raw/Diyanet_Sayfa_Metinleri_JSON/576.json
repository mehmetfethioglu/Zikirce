            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38654,
            "SureId": 74,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "وَمَٓا اَدْرٰیكَ مَا سَقَرُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38661,
            "SureId": 74,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "لَا تُبْقٖی وَلَا تَذَرُۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38668,
            "SureId": 74,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "لَوَّاحَةٌ لِلْبَشَرِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38675,
            "SureId": 74,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "عَلَیْهَا تِسْعَةَ عَشَرَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38682,
            "SureId": 74,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "وَمَا جَعَلْنَٓا اَصْحَابَ النَّارِ اِلَّا مَلٰٓئِكَةًࣕ وَمَا جَعَلْنَا عِدَّتَهُمْ اِلَّا فِتْنَةً لِلَّذٖینَ كَفَرُواۙ لِیَسْتَیْقِنَ الَّذٖینَ اُو𐻿تُوا الْكِتَابَ وَیَزْدَادَ الَّذٖینَ اٰمَنُٓوا اٖیمَانًا وَلَا یَرْتَابَ الَّذٖینَ اُو𐻿تُوا الْكِتَابَ وَالْمُؤْمِنُونَۙ وَلِیَقُولَ الَّذٖینَ فٖی قُلُوبِهِمْ مَرَضٌ وَالْكَافِرُونَ مَاذَٓا اَرَادَ اللّٰهُ بِهٰذَا مَثَلًاؕ كَذٰلِكَ یُضِلُّ اللّٰهُ مَنْ یَشَٓاءُ وَیَهْدٖی مَنْ یَشَٓاءُؕ وَمَا یَعْلَمُ جُنُودَ رَبِّكَ اِلَّا هُوَؕ وَمَا هِیَ اِلَّا ذِكْرٰى لِلْبَشَرِࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38689,
            "SureId": 74,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "كَلَّا وَالْقَمَرِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38696,
            "SureId": 74,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "وَالَّیْلِ اِذْ اَدْبَرَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38703,
            "SureId": 74,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "وَالصُّبْحِ اِذَٓا اَسْفَرَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38710,
            "SureId": 74,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "اِنَّهَا لَاِحْدَى الْكُبَرِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38717,
            "SureId": 74,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "نَذٖیرًا لِلْبَشَرِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38724,
            "SureId": 74,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "لِمَنْ شَٓاءَ مِنْكُمْ اَنْ یَتَقَدَّمَ اَوْ یَتَاَخَّرَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38731,
            "SureId": 74,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "كُلُّ نَفْسٍ بِمَا كَسَبَتْ رَهٖینَةٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38738,
            "SureId": 74,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "اِلَّٓا اَصْحَابَ الْیَمٖینِؕۛ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38745,
            "SureId": 74,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "فٖی جَنَّاتٍؕۛ یَتَسَٓاءَلُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38752,
            "SureId": 74,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "عَنِ الْمُجْرِمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38759,
            "SureId": 74,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "مَا سَلَكَكُمْ فٖی سَقَرَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38766,
            "SureId": 74,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "قَالُوا لَمْ نَكُ مِنَ الْمُصَلّٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38773,
            "SureId": 74,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "وَلَمْ نَكُ نُطْعِمُ الْمِسْكٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38780,
            "SureId": 74,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "وَكُنَّا نَخُوضُ مَعَ الْخَٓائِضٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38787,
            "SureId": 74,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "وَكُنَّا نُكَذِّبُ بِیَوْمِ الدّٖینِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38794,
            "SureId": 74,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "حَتّٰٓى اَتٰینَا الْیَقٖینُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 38589,
            "SureId": 74,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "O, düşündü taşındı, ölçtü biçti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 74,
                "MealInfo": "Mekke döneminde inmiştir. 56 âyettir. Sûre, adını birinci âyette geçen “elMüddessir”kelimesinden almıştır. Müddessir, tıpkı bir önceki sûrenin adıolan müzzemmil gibi, örtünüp bürünen demektir. Sûrede başlıca, Hz. Peygamberintebliğ ve davetle görevlendirilmesi, müşriklerin ona karşı çıkmasıve onların cehennemle uyarılması konu edilmektedir.",
                "SureNameTurkish": "Müddessir",
                "SureNameArabic": "الْمُدَّثِّرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 4,
                "AyetCount": 56,
                "Cuz": 29,
                "FirstPage": 575,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 38596,
            "SureId": 74,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Kahrolası, ne biçim ölçtü biçti!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38603,
            "SureId": 74,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Sonra kahrolası ne biçim ölçtü biçti!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38610,
            "SureId": 74,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Sonra baktı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38617,
            "SureId": 74,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Sonra kaşlarını çattı, suratını astı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38624,
            "SureId": 74,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "En sonunda sırtını dönüp gitti ve kibrine yenildi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38631,
            "SureId": 74,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "“Bu” dedi, “Olsa olsa eskilerden nakledilmiş bir sihirdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38638,
            "SureId": 74,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Bu, insan sözünden başka bir şey değildir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38645,
            "SureId": 74,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Ben onu sekara (cehenneme) sokacağım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38652,
            "SureId": 74,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Sen bilir misin sekar nedir?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38659,
            "SureId": 74,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Bitirir ama yok olmaya da bırakmaz;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38666,
            "SureId": 74,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "İnsanları kavurur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38673,
            "SureId": 74,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Orada on dokuz görevli vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38680,
            "SureId": 74,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Biz cehennemin işlerine bakmakla yalnız melekleri görevlendirmişizdir. Onların sayısını da inkâr edenler için sadece bir imtihan vesilesi yaptık ki böylelikle kendilerine kitap verilenler kesin bilgi edinsinler, inananların imanı artsın; kendilerine kitap verilenler ve müminler şüpheye düşmesinler; kalplerinde hastalık bulunanlar ve inkârcılar da, “Allah bu sayı misaliyle ne demek istemiş olabilir?” desinler. İşte Allah böylece dilediğini sapkınlıkta bırakır, dilediğine de doğru yolu gösterir. Rabbinin ordularını kendisinden başkası bilmez. İşte bu, insanlık için sadece bir öğüttür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38687,
            "SureId": 74,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Hayır hayır (öğüt almazlar). Aya andolsun!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38694,
            "SureId": 74,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Dönüp gitmekte olan geceye;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38701,
            "SureId": 74,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Ağarmakta olan sabaha andolsun ki,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38708,
            "SureId": 74,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35-37",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "O (cehennem), insanlar için, sizden ileri gitmek ya da geri kalmak isteyen kimseler için uyarıcı büyük cezalardan biridir.",
            "Recitation": "",
