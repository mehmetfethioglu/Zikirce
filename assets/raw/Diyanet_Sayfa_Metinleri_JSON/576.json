            "SureId": 74,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "اِنْ هٰذَٓا اِلَّا قَوْلُ الْبَشَرِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38647,
            "SureId": 74,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "سَاُصْلٖیهِ سَقَرَ",
