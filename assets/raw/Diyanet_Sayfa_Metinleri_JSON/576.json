            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38736,
            "SureId": 74,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Ancak hakkın ve erdemin tarafında olanlar başka:",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38743,
            "SureId": 74,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40-41",
            "AyetVisible": true,
            "Page": 576,
            "AyetText": "Onlar cennetlerdedir; günahkârlar hakkında birbirlerine sorular sorarlar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38750,
            "SureId": 74,
            "AyetId": 41,
