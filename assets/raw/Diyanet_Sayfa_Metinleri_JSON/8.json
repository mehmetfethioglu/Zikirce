            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "وَاِذْ نَجَّیْنَاكُمْ مِنْ اٰلِ فِرْعَوْنَ یَسُومُونَكُمْ سُٓوءَ الْعَذَابِ یُذَبِّحُونَ اَبْنَٓاءَكُمْ وَیَسْتَحْیُونَ نِسَٓاءَكُمْؕ وَفٖی ذٰلِكُمْ بَلَٓاءٌ مِنْ رَبِّكُمْ عَظٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 2,
                "MealInfo": "Medine döneminde inmiştir. Kur’an-ı Kerim’in en uzun sûresi olup 286 âyettir. Adını, 67-73. âyetlerde yer alan <b>“bakara (<i>sığı</i>r)”</b> kelimesinden alır. Sûre, İslâm hukukunun ana konularıyla ilgili pek çok hüküm içermektedir.",
                "SureNameTurkish": "Bakara",
                "SureNameArabic": "الْبَقَرَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 87,
                "AyetCount": 286,
                "Cuz": 1,
                "FirstPage": 2,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 399,
            "SureId": 2,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "وَاِذْ فَرَقْنَا بِكُمُ الْبَحْرَ فَاَنْجَیْنَاكُمْ وَاَغْرَقْنَٓا اٰلَ فِرْعَوْنَ وَاَنْتُمْ تَنْظُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 406,
            "SureId": 2,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "وَاِذْ وٰعَدْنَا مُوسٰٓى اَرْبَعٖینَ لَیْلَةً ثُمَّ اتَّخَذْتُمُ الْعِجْلَ مِنْ بَعْدِهٖ وَاَنْتُمْ ظَالِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 413,
            "SureId": 2,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "ثُمَّ عَفَوْنَا عَنْكُمْ مِنْ بَعْدِ ذٰلِكَ لَعَلَّكُمْ تَشْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 420,
            "SureId": 2,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "وَاِذْ اٰتَیْنَا مُوسَى الْكِتَابَ وَالْفُرْقَانَ لَعَلَّكُمْ تَهْتَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 427,
            "SureId": 2,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "وَاِذْ قَالَ مُوسٰى لِقَوْمِهٖ یَا قَوْمِ اِنَّكُمْ ظَلَمْتُمْ اَنْفُسَكُمْ بِاتِّخَاذِكُمُ الْعِجْلَ فَتُوبُٓوا اِلٰى بَارِئِكُمْ فَاقْتُلُٓوا اَنْفُسَكُمْؕ ذٰلِكُمْ خَیْرٌ لَكُمْ عِنْدَ بَارِئِكُمْؕ فَتَابَ عَلَیْكُمْؕ اِنَّهُ هُوَ التَّوَّابُ الرَّحٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 434,
            "SureId": 2,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "وَاِذْ قُلْتُمْ یَا مُوسٰى لَنْ نُؤْمِنَ لَكَ حَتّٰى نَرَى اللّٰهَ جَهْرَةً فَاَخَذَتْكُمُ الصَّاعِقَةُ وَاَنْتُمْ تَنْظُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 441,
            "SureId": 2,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "ثُمَّ بَعَثْنَاكُمْ مِنْ بَعْدِ مَوْتِكُمْ لَعَلَّكُمْ تَشْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 448,
            "SureId": 2,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "وَظَلَّلْنَا عَلَیْكُمُ الْغَمَامَ وَاَنْزَلْنَا عَلَیْكُمُ الْمَنَّ وَالسَّلْوٰىؕ كُلُوا مِنْ طَیِّبَاتِ مَا رَزَقْنَاكُمْؕ وَمَا ظَلَمُونَا وَلٰكِنْ كَانُٓوا اَنْفُسَهُمْ یَظْلِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 390,
            "SureId": 2,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "Hatırlayın ki sizi Firavun’un adamlarından kurtardık. Onlar size işkencenin en kötüsünü revâ görüyorlar, erkek çocuklarınızı boğazlıyorlar, kızlarınızı sağ bırakıyorlardı. Bu size reva görülenlerde rabbinizden büyük bir imtihan vardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 2,
                "MealInfo": "Medine döneminde inmiştir. Kur’an-ı Kerim’in en uzun sûresi olup 286 âyettir. Adını, 67-73. âyetlerde yer alan <b>“bakara (<i>sığı</i>r)”</b> kelimesinden alır. Sûre, İslâm hukukunun ana konularıyla ilgili pek çok hüküm içermektedir.",
                "SureNameTurkish": "Bakara",
                "SureNameArabic": "الْبَقَرَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 87,
                "AyetCount": 286,
                "Cuz": 1,
                "FirstPage": 2,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 397,
            "SureId": 2,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "Bir zamanlar biz sizin için denizi yardık, sizi kurtardık; Firavun’un adamlarını da gözünüzün önünde denizde boğduk.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 404,
            "SureId": 2,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "Mûsâ’ya kırk gece için söz vermiştik. Mûsâ gittikten sonra siz, haksızlık ederek buzağıyı (tanrı) edindiniz.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 411,
            "SureId": 2,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "Bundan sonra da (akıllanıp) şükredersiniz diye sizi affettik.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 418,
            "SureId": 2,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "Doğru yolu bulasınız diye Mûsâ’ya kitabı ve hak ile bâtılı ayıran hükümleri ­vermiştik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 425,
            "SureId": 2,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "Mûsâ kavmine demişti ki: “Ey kavmim! Şüphesiz siz buzağıyı (tanrı) edinmekle kendinize zulmettiniz. Onun için yaratanınıza tövbe edin de nefislerinizi öldürün. Öyle yapmanız yaratıcınızın katında sizin için daha iyidir; böylece Allah tövbenizi kabul etmiş olur. Çünkü acıyıp tövbeleri kabul eden ancak O’dur”.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 432,
            "SureId": 2,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "Bir zamanlar, “Ey Mûsâ! Allah’ı açıkça görmedikçe sana asla inanmayız” demiştiniz de bakıp dururken hemen sizi yıldırım çarpmıştı.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 439,
            "SureId": 2,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "Sonra ölümünüzün ardından sizi dirilttik ki şükredesiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 446,
            "SureId": 2,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 8,
            "AyetText": "Ve sizi bulutlarla gölgeledik; size kudret helvası ve bıldırcın gönderdik; “Verdiğimiz güzel nimetlerden yiyin” (dedik). Gerçekte onlar bize değil, kendilerine kötülük ediyorlardı.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
