{
    "PointerList": null,
    "CuzNo": 29,
    "PageNo": 580,
    "ArCuzNo": "۲۹",
    "ArPageNo": "٥۸۰",
    "QuranAyats": [
        {
            "Id": 39319,
            "SureId": 76,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "وَمِنَ الَّیْلِ فَاسْجُدْ لَهُ وَسَبِّحْهُ لَیْلًا طَوٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 76,
                "MealInfo": "Medine döneminde inmiştir. 31 âyettir. Sûre, adını birinci âyetteki “insan” kelimesindenalmıştır. Aynı âyette geçen “ed-Dehr” kelimesinden dolayı Dehrsûresi diye de anılır. Dehr, zaman demektir. Sûrede başlıca, ahiret hayatıyla ilgilimeseleler ve özellikle takva sahiplerinin cennette kavuşacakları çeşitli nimetlerkonu edilmektedir.",
                "SureNameTurkish": "İnsân",
                "SureNameArabic": "الْاِنْسَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 98,
                "AyetCount": 31,
                "Cuz": 29,
                "FirstPage": 578,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 39326,
            "SureId": 76,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "اِنَّ هٰٓؤُ𐻾لَٓاءِ یُحِبُّونَ الْعَاجِلَةَ وَیَذَرُونَ وَرَٓاءَهُمْ یَوْمًا ثَقٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39333,
            "SureId": 76,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "نَحْنُ خَلَقْنَاهُمْ وَشَدَدْنَٓا اَسْرَهُمْۚ وَاِذَا شِئْنَا بَدَّلْنَٓا اَمْثَالَهُمْ تَبْدٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39340,
            "SureId": 76,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "اِنَّ هٰذِهٖ تَذْكِرَةٌۚ فَمَنْ شَٓاءَ اتَّخَذَ اِلٰى رَبِّهٖ سَبٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39347,
            "SureId": 76,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "وَمَا تَشَٓاؤُ𐻿نَ اِلَّٓا اَنْ یَشَٓاءَ اللّٰهُؕ اِنَّ اللّٰهَ كَانَ عَلٖیمًا حَكٖیمًاࣗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39354,
            "SureId": 76,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "یُدْخِلُ مَنْ یَشَٓاءُ فٖی رَحْمَتِهٖؕ وَالظَّالِمٖینَ اَعَدَّ لَهُمْ عَذَابًا اَلٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39361,
            "SureId": 77,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "وَالْمُرْسَلَاتِ عُرْفًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 77,
                "MealInfo": "Mekke döneminde inmiştir. 50 âyettir. Sûre, adını birinci âyette geçen “elMürselât”kelimesinden almıştır. Mürselât, gönderilenler demektir. Sûredebaşlıca, kıyametin, hesap ve azabın gerçekleşeceği, Allah’ın kudreti vegünahkârların akıbeti konu edilmektedir.",
                "SureNameTurkish": "Mürselât",
                "SureNameArabic": "الْمُرْسَلَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 33,
                "AyetCount": 50,
                "Cuz": 29,
                "FirstPage": 580,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 39368,
            "SureId": 77,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "فَالْعَاصِفَاتِ عَصْفًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39375,
            "SureId": 77,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "وَالنَّاشِرَاتِ نَشْرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39382,
            "SureId": 77,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "فَالْفَارِقَاتِ فَرْقًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39389,
            "SureId": 77,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "فَالْمُلْقِیَاتِ ذِكْرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39396,
            "SureId": 77,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "عُذْرًا اَوْ نُذْرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39403,
            "SureId": 77,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "اِنَّمَا تُوعَدُونَ لَوَاقِعٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39410,
            "SureId": 77,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "فَاِذَا النُّجُومُ طُمِسَتْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39417,
            "SureId": 77,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "وَاِذَا السَّمَٓاءُ فُرِجَتْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39424,
            "SureId": 77,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "وَاِذَا الْجِبَالُ نُسِفَتْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39431,
            "SureId": 77,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "وَاِذَا الرُّسُلُ اُقِّتَتْؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39438,
            "SureId": 77,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "لِاَیِّ یَوْمٍ اُجِّلَتْؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39445,
            "SureId": 77,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "لِیَوْمِ الْفَصْلِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39452,
            "SureId": 77,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "وَمَٓا اَدْرٰیكَ مَا یَوْمُ الْفَصْلِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39459,
            "SureId": 77,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "وَیْلٌ یَوْمَئِذٍ لِلْمُكَذِّبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39466,
            "SureId": 77,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "اَلَمْ نُهْلِكِ الْاَوَّلٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39473,
            "SureId": 77,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "ثُمَّ نُتْبِعُهُمُ الْاٰخِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39480,
            "SureId": 77,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "كَذٰلِكَ نَفْعَلُ بِالْمُجْرِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39487,
            "SureId": 77,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "وَیْلٌ یَوْمَئِذٍ لِلْمُكَذِّبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 39317,
            "SureId": 76,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Gecenin bir kısmında O’na secde et ve uzun gece boyunca O’nu tesbih et.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 76,
                "MealInfo": "Medine döneminde inmiştir. 31 âyettir. Sûre, adını birinci âyetteki “insan” kelimesindenalmıştır. Aynı âyette geçen “ed-Dehr” kelimesinden dolayı Dehrsûresi diye de anılır. Dehr, zaman demektir. Sûrede başlıca, ahiret hayatıyla ilgilimeseleler ve özellikle takva sahiplerinin cennette kavuşacakları çeşitli nimetlerkonu edilmektedir.",
                "SureNameTurkish": "İnsân",
                "SureNameArabic": "الْاِنْسَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 98,
                "AyetCount": 31,
                "Cuz": 29,
                "FirstPage": 578,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 39324,
            "SureId": 76,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Şu insanlar, geçici dünyayı seviyorlar, ileride kendilerini bekleyen zor günü ise umursamıyorlar,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39331,
            "SureId": 76,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Onları biz yarattık, yaratılışlarını sapasağlam yaptık. Dilediğimizde yerlerine benzerlerini de getiririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39338,
            "SureId": 76,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Şüphesiz ki bunlar birer öğüttür; artık dileyen rabbine bir yol tutar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39345,
            "SureId": 76,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Ancak Allah’ın (bir şeyi) dilemesi sayesinde dileyebilirsiniz. Şüphesiz Allah her şeyi bilendir, hikmet sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39352,
            "SureId": 76,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Allah dilediğini rahmetine dahil eder. Zalimlere gelince onlar için elem verici bir azap hazırlamıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39359,
            "SureId": 77,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Yemin olsun, birbiri ardından gönderilenlere;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 77,
                "MealInfo": "Mekke döneminde inmiştir. 50 âyettir. Sûre, adını birinci âyette geçen “elMürselât”kelimesinden almıştır. Mürselât, gönderilenler demektir. Sûredebaşlıca, kıyametin, hesap ve azabın gerçekleşeceği, Allah’ın kudreti vegünahkârların akıbeti konu edilmektedir.",
                "SureNameTurkish": "Mürselât",
                "SureNameArabic": "الْمُرْسَلَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 33,
                "AyetCount": 50,
                "Cuz": 29,
                "FirstPage": 580,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 39366,
            "SureId": 77,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Fırtına olup esenlere;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39373,
            "SureId": 77,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Yaydıkça yayanlara;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39380,
            "SureId": 77,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "(Hak ile bâtılı) birbirinden iyice ayıranlara;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39387,
            "SureId": 77,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5-6",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Mazereti ortadan kaldırmak veya uyarmak için vahyi iletenlere;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39394,
            "SureId": 77,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": false,
            "Page": 580,
            "AyetText": "Mazereti ortadan kaldırmak veya uyarmak için vahyi iletenlere;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39401,
            "SureId": 77,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Ki size vaad olunan şey mutlaka gerçekleşecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39408,
            "SureId": 77,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Yıldızların ışığı söndürüldüğünde;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39415,
            "SureId": 77,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Gök yarıldığında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39422,
            "SureId": 77,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Dağlar sökülüp savrulduğunda;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39429,
            "SureId": 77,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Peygamberlere toplantı vakti bildirildiğinde;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39436,
            "SureId": 77,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Bütün bunlar hangi güne ertelenmiştir?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39443,
            "SureId": 77,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 580,
            "AyetText": "Ayırım gününe.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39450,
            "SureId": 77,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
