    "QuranAyats": [
        {
            "Id": 91,
            "SureId": 2,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "اِنَّ الَّذٖینَ كَفَرُوا سَوَٓاءٌ عَلَیْهِمْ ءَاَنْذَرْتَهُمْ اَمْ لَمْ تُنْذِرْهُمْ لَا یُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 2,
                "MealInfo": "Medine döneminde inmiştir. Kur’an-ı Kerim’in en uzun sûresi olup 286 âyettir. Adını, 67-73. âyetlerde yer alan <b>“bakara (<i>sığı</i>r)”</b> kelimesinden alır. Sûre, İslâm hukukunun ana konularıyla ilgili pek çok hüküm içermektedir.",
                "SureNameTurkish": "Bakara",
                "SureNameArabic": "الْبَقَرَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 87,
                "AyetCount": 286,
                "Cuz": 1,
                "FirstPage": 2,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 98,
            "SureId": 2,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "خَتَمَ اللّٰهُ عَلٰى قُلُوبِهِمْ وَعَلٰى سَمْعِهِمْؕ وَعَلٰٓى اَبْصَارِهِمْ غِشَاوَةٌؗ وَلَهُمْ عَذَابٌ عَظٖیمٌࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 105,
            "SureId": 2,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "وَمِنَ النَّاسِ مَنْ یَقُولُ اٰمَنَّا بِاللّٰهِ وَبِالْیَوْمِ الْاٰخِرِ وَمَا هُمْ بِمُؤْمِنٖینَۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 112,
            "SureId": 2,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "یُخَادِعُونَ اللّٰهَ وَالَّذٖینَ اٰمَنُواۚ وَمَا یَخْدَعُونَ اِلَّٓا اَنْفُسَهُمْ وَمَا یَشْعُرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 119,
            "SureId": 2,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "فٖی قُلُوبِهِمْ مَرَضٌۙ فَزَادَهُمُ اللّٰهُ مَرَضًاۚ وَلَهُمْ عَذَابٌ اَلٖیمٌۙ بِمَا كَانُوا یَكْذِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 126,
            "SureId": 2,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "وَاِذَا قٖیلَ لَهُمْ لَا تُفْسِدُوا فِی الْاَرْضِۙ قَالُٓوا اِنَّمَا نَحْنُ مُصْلِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 133,
            "SureId": 2,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "اَلَٓا اِنَّهُمْ هُمُ الْمُفْسِدُونَ وَلٰكِنْ لَا یَشْعُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 140,
            "SureId": 2,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "وَاِذَا قٖیلَ لَهُمْ اٰمِنُوا كَمَٓا اٰمَنَ النَّاسُ قَالُٓوا اَنُؤْمِنُ كَمَٓا اٰمَنَ السُّفَهَٓاءُؕ اَلَٓا اِنَّهُمْ هُمُ السُّفَهَٓاءُ وَلٰكِنْ لَا یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 147,
            "SureId": 2,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "وَاِذَا لَقُوا الَّذٖینَ اٰمَنُوا قَالُٓوا اٰمَنَّاۚ وَاِذَا خَلَوْا اِلٰى شَیَاطٖینِهِمْۙ قَالُٓوا اِنَّا مَعَكُمْۙ اِنَّمَا نَحْنُ مُسْتَهْزِؤُ𐻿نَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 154,
            "SureId": 2,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "اَللّٰهُ یَسْتَهْزِئُ بِهِمْ وَیَمُدُّهُمْ فٖی طُغْیَانِهِمْ یَعْمَهُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 161,
            "SureId": 2,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "اُو𐻾لٰٓئِكَ الَّذٖینَ اشْتَرَوُا الضَّلَالَةَ بِالْهُدٰىࣕ فَمَا رَبِحَتْ تِجَارَتُهُمْ وَمَا كَانُوا مُهْتَدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 89,
            "SureId": 2,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "İnkâr edenleri uyarsan da uyarmasan da onlar için birdir, asla iman etmezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 2,
                "MealInfo": "Medine döneminde inmiştir. Kur’an-ı Kerim’in en uzun sûresi olup 286 âyettir. Adını, 67-73. âyetlerde yer alan <b>“bakara (<i>sığı</i>r)”</b> kelimesinden alır. Sûre, İslâm hukukunun ana konularıyla ilgili pek çok hüküm içermektedir.",
                "SureNameTurkish": "Bakara",
                "SureNameArabic": "الْبَقَرَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 87,
                "AyetCount": 286,
                "Cuz": 1,
                "FirstPage": 2,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 96,
            "SureId": 2,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "Allah onların kalplerini ve kulaklarını mühürlemiştir, gözlerinde de kalın bir perde bulunmaktadır ve onlar için büyük bir azap vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 103,
            "SureId": 2,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "İnsanlardan bazıları da vardır ki inanmadıkları halde “Allah’a ve âhiret gününe inandık” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 110,
            "SureId": 2,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "Akıllarınca Allah’ı ve iman edenleri aldatmaya kalkışıyorlar; hâlbuki onlar farkında olmadan yalnızca kendilerini aldatmış oluyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 117,
            "SureId": 2,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "Kalplerinde bir bozukluk vardır, Allah da onlardaki bozukluğu arttırmıştır. Yalan söylemeleri yüzünden, kendilerine acı veren bir azap da vardır.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 124,
            "SureId": 2,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "Onlara “Yeryüzünde düzeni bozmayın” denildiğinde, “Hayır, biz yalnızca ıslah edenleriz” derler.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 131,
            "SureId": 2,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "Biline ki, gerçekten bozanlar onların ta kendileridir, ama farkında olmuyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 138,
            "SureId": 2,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "Onlara “Diğer insanlar gibi siz de iman edin” denildiğinde, “Akılsızların inandıkları gibi biz de inanalım mı?” derler. Biline ki, asıl akılsızlar onlardır, fakat bilmezler.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 145,
            "SureId": 2,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "İman edenlerle karşılaşınca “inandık” derler, şeytanlarıyla baş başa kaldıklarında ise “Biz sizinleyiz, biz yalnızca alay etmekteyiz” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 152,
            "SureId": 2,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "Asıl onlarla alay eden ve azıp saparak dolaşmalarına izin veren Allah’tır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 159,
            "SureId": 2,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 3,
            "AyetText": "Doğruya karşılık sapkınlığı satın alanlar işte onlardır. Bu sebeple ticaretleri kâr etmemiş ve doğru yolu da bulamamışlardır.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Bakara",
    "QuranSureLabel": "الْبَقَرَةِ",
    "EndPageSure": null
}