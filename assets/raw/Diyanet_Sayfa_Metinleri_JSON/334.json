    "QuranAyats": [
        {
            "Id": 18277,
            "SureId": 22,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "وَكَذٰلِكَ اَنْزَلْنَاهُ اٰیَاتٍ بَیِّنَاتٍۙ وَاَنَّ اللّٰهَ یَهْدٖی مَنْ یُرٖیدُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 22,
                "MealInfo": "Âyetlerinin çoğu Mekke’de, bir kısmı ise Medine döneminde inmiştir. 78 âyettir. <b>Hac ibadetinden bahsettiği için bu adı almıştır.</b> Sûrede ayrıca kıyamet gününün dehşetinden, kıyamet günü yaşanacak sahnelerden, cihattan ve helâk edilmiş eski toplumlardan söz edilmektedir",
                "SureNameTurkish": "Hac",
                "SureNameArabic": "الْحَجِّ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 103,
                "AyetCount": 78,
                "Cuz": 17,
                "FirstPage": 332,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18284,
            "SureId": 22,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "اِنَّ الَّذٖینَ اٰمَنُوا وَالَّذٖینَ هَادُوا وَالصَّابِـٖٔینَ وَالنَّصَارٰى وَالْمَجُوسَ وَالَّذٖینَ اَشْرَكُواࣗ اِنَّ اللّٰهَ یَفْصِلُ بَیْنَهُمْ یَوْمَ الْقِیٰمَةِؕ اِنَّ اللّٰهَ عَلٰى كُلِّ شَیْءٍ شَهٖیدٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18291,
            "SureId": 22,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "اَلَمْ تَرَ اَنَّ اللّٰهَ یَسْجُدُ لَهُ مَنْ فِی السَّمٰوَاتِ وَمَنْ فِی الْاَرْضِ وَالشَّمْسُ وَالْقَمَرُ وَالنُّجُومُ وَالْجِبَالُ وَالشَّجَرُ وَالدَّوَٓابُّ وَكَثٖیرٌ مِنَ النَّاسِؕ وَكَثٖیرٌ حَقَّ عَلَیْهِ الْعَذَابُؕ وَمَنْ یُهِنِ اللّٰهُ فَمَا لَهُ مِنْ مُكْرِمٍؕ اِنَّ اللّٰهَ یَفْعَلُ مَا یَشَٓاءُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18298,
            "SureId": 22,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "هٰذَانِ خَصْمَانِ اخْتَصَمُوا فٖی رَبِّهِمْؗ فَالَّذٖینَ كَفَرُوا قُطِّعَتْ لَهُمْ ثِیَابٌ مِنْ نَارٍؕ یُصَبُّ مِنْ فَوْقِ رُؤُ𐻿سِهِمُ الْحَمٖیمُۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18305,
            "SureId": 22,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "یُصْهَرُ بِهٖ مَا فٖی بُطُونِهِمْ وَالْجُلُودُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18312,
            "SureId": 22,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "وَلَهُمْ مَقَامِعُ مِنْ حَدٖیدٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18319,
            "SureId": 22,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "كُلَّمَٓا اَرَادُٓوا اَنْ یَخْرُجُوا مِنْهَا مِنْ غَمٍّ اُعٖیدُوا فٖیهَا وَذُوقُوا عَذَابَ الْحَرٖیقِࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18326,
            "SureId": 22,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "اِنَّ اللّٰهَ یُدْخِلُ الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ جَنَّاتٍ تَجْرٖی مِنْ تَحْتِهَا الْاَنْهَارُ یُحَلَّوْنَ فٖیهَا مِنْ اَسَاوِرَ مِنْ ذَهَبٍ وَلُؤْلُؤً𐻾اؕ وَلِبَاسُهُمْ فٖیهَا حَرٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 18275,
            "SureId": 22,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "İşte böylece biz onu apaçık âyetler olarak indirdik. Kuşkusuz Allah dilediğini doğru yola iletir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 22,
                "MealInfo": "Âyetlerinin çoğu Mekke’de, bir kısmı ise Medine döneminde inmiştir. 78 âyettir. <b>Hac ibadetinden bahsettiği için bu adı almıştır.</b> Sûrede ayrıca kıyamet gününün dehşetinden, kıyamet günü yaşanacak sahnelerden, cihattan ve helâk edilmiş eski toplumlardan söz edilmektedir",
                "SureNameTurkish": "Hac",
                "SureNameArabic": "الْحَجِّ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 103,
                "AyetCount": 78,
                "Cuz": 17,
                "FirstPage": 332,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18282,
            "SureId": 22,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "Gerçek şu ki, iman edenler, Yahudiliği benimseyenler, Sâbiîler, Hristiyanlar, Mecûsîler ve şirke sapanların her biri hakkındaki hükmünü Allah kıyamet günü verecektir. Şüphesiz Allah her şeye tanıktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18289,
            "SureId": 22,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "Görmez misin göklerde ve yeryüzünde bulunanlar; güneş, ay, yıldızlar, dağlar, ağaçlar, hayvanlar ve insanların birçoğu hep O’na secde etmektedir! Niceleri de azabı hak etmiştir. Allah’ın hakir kıldığı kimseyi onurlandırabilecek birisi yoktur. Kuşkusuz Allah dilediğini yapar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18296,
            "SureId": 22,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "Şu ikisi rableri hakkında çekişip duran iki taraftır. Bunlardan inkârcı olanlar için ateşten giysiler biçilmiştir, başlarının üstünden de kaynar su dökülecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18303,
            "SureId": 22,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "Bununla karınlarının içindekiler ve derileri eritilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18310,
            "SureId": 22,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "Onlar için bir de demirden sopalar vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18317,
            "SureId": 22,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "Istıraptan ötürü oradan çıkmaya her teşebbüs ettiklerinde oraya geri döndürülecekler ve onlara, “Tadın bakalım bu yakıcı azabı!” denilecek.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18324,
            "SureId": 22,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 334,
            "AyetText": "İman edip dünya ve âhiret için yararlı işler yapanları ise Allah altından ırmaklar akan cennetlere koyacaktır. Onlar orada altın bilezik ve incilerle süsleneceklerdir. Orada onların giysileri de ipektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
