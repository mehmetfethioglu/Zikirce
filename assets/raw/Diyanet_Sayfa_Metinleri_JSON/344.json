{
    "PointerList": null,
    "CuzNo": 18,
    "PageNo": 344,
    "ArCuzNo": "۱۸",
    "ArPageNo": "۳٤٤",
    "QuranAyats": [
        {
            "Id": 18907,
            "SureId": 23,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "فَاِذَا اسْتَوَیْتَ اَنْتَ وَمَنْ مَعَكَ عَلَى الْفُلْكِ فَقُلِ الْحَمْدُ لِلّٰهِ الَّذٖی نَجّٰینَا مِنَ الْقَوْمِ الظَّالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18914,
            "SureId": 23,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "وَقُلْ رَبِّ اَنْزِلْنٖی مُنْزَلًا مُبَارَكًا وَاَنْتَ خَیْرُ الْمُنْزِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18921,
            "SureId": 23,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "اِنَّ فٖی ذٰلِكَ لَاٰیَاتٍ وَاِنْ كُنَّا لَمُبْتَلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18928,
            "SureId": 23,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "ثُمَّ اَنْشَاْنَا مِنْ بَعْدِهِمْ قَرْنًا اٰخَرٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18935,
            "SureId": 23,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "فَاَرْسَلْنَا فٖیهِمْ رَسُولًا مِنْهُمْ اَنِ اعْبُدُوا اللّٰهَ مَا لَكُمْ مِنْ اِلٰهٍ غَیْرُهُؕ اَفَلَا تَتَّقُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18942,
            "SureId": 23,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "وَقَالَ الْمَلَاُ مِنْ قَوْمِهِ الَّذٖینَ كَفَرُوا وَكَذَّبُوا بِلِقَٓاءِ الْاٰخِرَةِ وَاَتْرَفْنَاهُمْ فِی الْحَیٰوةِ الدُّنْیَاۙ مَا هٰذَٓا اِلَّا بَشَرٌ مِثْلُكُمْۙ یَاْكُلُ مِمَّا تَاْكُلُونَ مِنْهُ وَیَشْرَبُ مِمَّا تَشْرَبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18949,
            "SureId": 23,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "وَلَئِنْ اَطَعْتُمْ بَشَرًا مِثْلَكُمْ اِنَّكُمْ اِذًا لَخَاسِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18956,
            "SureId": 23,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "اَیَعِدُكُمْ اَنَّكُمْ اِذَا مِتُّمْ وَكُنْتُمْ تُرَابًا وَعِظَامًا اَنَّكُمْ مُخْرَجُونَࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18963,
            "SureId": 23,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "هَیْهَاتَ هَیْهَاتَ لِمَا تُوعَدُونَࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18970,
            "SureId": 23,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "اِنْ هِیَ اِلَّا حَیَاتُنَا الدُّنْیَا نَمُوتُ وَنَحْیَا وَمَا نَحْنُ بِمَبْعُوثٖینَࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18977,
            "SureId": 23,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "اِنْ هُوَ اِلَّا رَجُلٌࣙ افْـتَرٰى عَلَى اللّٰهِ كَذِبًا وَمَا نَحْنُ لَهُ بِمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18984,
            "SureId": 23,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "قَالَ رَبِّ انْصُرْنٖی بِمَا كَذَّبُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18991,
            "SureId": 23,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "قَالَ عَمَّا قَلٖیلٍ لَیُصْبِحُنَّ نَادِمٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18998,
            "SureId": 23,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "فَاَخَذَتْهُمُ الصَّیْحَةُ بِالْحَقِّ فَجَعَلْنَاهُمْ غُثَٓاءًۚ فَبُعْدًا لِلْقَوْمِ الظَّالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19005,
            "SureId": 23,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "ثُمَّ اَنْشَاْنَا مِنْ بَعْدِهِمْ قُرُونًا اٰخَرٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 18905,
            "SureId": 23,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "Yanındakilerle birlikte sen de gemiye yerleştiğinde, ‘Bizi bu zalimler topluluğundan kurtaran Allah’a hamdolsun!’ de.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18912,
            "SureId": 23,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "Yine de ki: ‘Rabbim! Beni bereketli bir yere indir; en uygun şekilde indirip yerleştiren sensin.’",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18919,
            "SureId": 23,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "Kuşkusuz bu anlatılanlarda ibretler vardır; muhakkak ki biz bunlarla insanları sınarız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18926,
            "SureId": 23,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "Sonra onların ardından başka bir nesil meydana getirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18933,
            "SureId": 23,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "Bunların arasından da kendilerine, “Allah’a kulluk edin; sizin O’ndan başka tanrınız yoktur. İsyan etmekten sakınmıyor musunuz?” diyen bir elçi gönderdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18940,
            "SureId": 23,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "Bu elçinin kavminden olup da inkâra sapan, âhirete ulaşmayı yalan sayan, dünya hayatında kendilerine refah verdiğimiz hatırlı kişiler halka şöyle dediler: “Bu da olsa olsa sizin gibi sıradan bir insan. Sizin yediğinizden yemekte, içtiğinizden ­içmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18947,
            "SureId": 23,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "Sizin gibi sıradan bir insana uyacak olursanız o zaman herhalde kaybedenlerden olursunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18954,
            "SureId": 23,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "O size, ölüp de toprak ve kemik yığını haline gelmişken tekrar hayat alanına çıkarılacağınızı mı söylüyor?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18961,
            "SureId": 23,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "Bu size söylenenler gerçek olmaktan çok çok uzak!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18968,
            "SureId": 23,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "Gerçek olan sadece şu yaşadığımız dünya hayatıdır. Ölür ve yaşarız. Bir daha da diriltilecek değiliz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18975,
            "SureId": 23,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "O, Allah hakkında sadece yalanlar düzüp koşan bir adamdır. Biz ona inanmıyoruz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18982,
            "SureId": 23,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "O peygamber şöyle dedi: “Rabbim! Bunların beni yalancılıkla suçlamalarına karşı bana yardım et!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18989,
            "SureId": 23,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "Allah buyurdu ki: “Pek yakında onlar mutlaka pişman olacaklar!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18996,
            "SureId": 23,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "Nitekim kaçınılmaz bir âkıbet olarak onları o korkunç ses yakalayıverdi; böylece sel süprüntüsüne çevirdik onları! Zalimlerin canı cehenneme!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19003,
            "SureId": 23,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 344,
            "AyetText": "Sonra onların ardından başka başka nesiller getirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Mü'minûn",
    "QuranSureLabel": "الْمُؤْمِنُونَ",
    "EndPageSure": null
}