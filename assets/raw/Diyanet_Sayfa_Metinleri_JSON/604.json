            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 604,
            "AyetText": "Ben sizin taptıklarınıza tapacak değilim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43482,
            "SureId": 109,
