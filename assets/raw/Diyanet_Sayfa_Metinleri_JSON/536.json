    "QuranAyats": [
        {
            "Id": 35210,
            "SureId": 56,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "ثُمَّ اِنَّكُمْ اَیُّهَا الضَّٓالُّونَ الْمُكَذِّبُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 56,
                "MealInfo": "Mekke döneminde inmiştir. 96 âyettir. Sûre, adını birinci âyette geçen<b> “elvâkı’a”</b> kelimesinden almıştır.<b> Vâkı’a, gerçekleşen, meydana gelen olay demektir</b>. Burada kıyameti ifade etmektedir. Sûrede başlıca, <b>kıyametin kopmasından önceki ve sonraki dehşetli hâller ve insanların amellerine göre içinde yer alacağı gruplar </b>konu edilmektedir.",
                "SureNameTurkish": "Vâkıa",
                "SureNameArabic": "الْوَاقِعَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 46,
                "AyetCount": 96,
                "Cuz": 27,
                "FirstPage": 534,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 35217,
            "SureId": 56,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "لَاٰكِلُونَ مِنْ شَجَرٍ مِنْ زَقُّومٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35224,
            "SureId": 56,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "فَمَالِؤُ𐻿نَ مِنْهَا الْبُطُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35231,
            "SureId": 56,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "فَشَارِبُونَ عَلَیْهِ مِنَ الْحَمٖیمِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35238,
            "SureId": 56,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "فَشَارِبُونَ شُرْبَ الْهٖیمِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35245,
            "SureId": 56,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "هٰذَا نُزُلُهُمْ یَوْمَ الدّٖینِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35252,
            "SureId": 56,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "نَحْنُ خَلَقْنَاكُمْ فَلَوْلَا تُصَدِّقُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35259,
            "SureId": 56,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "اَفَرَاَیْتُمْ مَا تُمْنُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35266,
            "SureId": 56,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "ءَاَنْتُمْ تَخْلُقُونَهُٓ اَمْ نَحْنُ الْخَالِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35273,
            "SureId": 56,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "نَحْنُ قَدَّرْنَا بَیْنَكُمُ الْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35280,
            "SureId": 56,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "عَلٰٓى اَنْ نُبَدِّلَ اَمْثَالَكُمْ وَنُنْشِئَكُمْ فٖی مَا لَا تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35287,
            "SureId": 56,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "وَلَقَدْ عَلِمْتُمُ النَّشْاَةَ الْاُو𐻿لٰى فَلَوْلَا تَذَكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35294,
            "SureId": 56,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "اَفَرَاَیْتُمْ مَا تَحْرُثُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35301,
            "SureId": 56,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "ءَاَنْتُمْ تَزْرَعُونَهُٓ اَمْ نَحْنُ الزَّارِعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35308,
            "SureId": 56,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "لَوْ نَشَٓاءُ لَجَعَلْنَاهُ حُطَامًا فَظَلْتُمْ تَفَكَّهُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35315,
            "SureId": 56,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "اِنَّا لَمُغْرَمُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35322,
            "SureId": 56,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "بَلْ نَحْنُ مَحْرُومُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35329,
            "SureId": 56,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "اَفَرَاَیْتُمُ الْمَٓاءَ الَّذٖی تَشْرَبُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35336,
            "SureId": 56,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "ءَاَنْتُمْ اَنْزَلْتُمُوهُ مِنَ الْمُزْنِ اَمْ نَحْنُ الْمُنْزِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35343,
            "SureId": 56,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "لَوْ نَشَٓاءُ جَعَلْنَاهُ اُجَاجًا فَلَوْلَا تَشْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35350,
            "SureId": 56,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "اَفَرَاَیْتُمُ النَّارَ الَّتٖی تُورُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35357,
            "SureId": 56,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "ءَاَنْتُمْ اَنْشَاْتُمْ شَجَرَتَهَٓا اَمْ نَحْنُ الْمُنْشِؤُ𐻿نَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35364,
            "SureId": 56,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "نَحْنُ جَعَلْنَاهَا تَذْكِرَةً وَمَتَاعًا لِلْمُقْوٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35371,
            "SureId": 56,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظٖیمِࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35378,
            "SureId": 56,
            "AyetId": 75,
            "LanguageId": 7,
            "AyetNumber": "٧٥",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "فَلَٓا اُقْسِمُ بِمَوَاقِـعِ النُّجُومِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35385,
            "SureId": 56,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "وَاِنَّهُ لَقَسَمٌ لَوْ تَعْلَمُونَ عَظٖیمٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 35208,
            "SureId": 56,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Sonra siz ey yoldan sapmış inkârcılar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 56,
                "MealInfo": "Mekke döneminde inmiştir. 96 âyettir. Sûre, adını birinci âyette geçen<b> “elvâkı’a”</b> kelimesinden almıştır.<b> Vâkı’a, gerçekleşen, meydana gelen olay demektir</b>. Burada kıyameti ifade etmektedir. Sûrede başlıca, <b>kıyametin kopmasından önceki ve sonraki dehşetli hâller ve insanların amellerine göre içinde yer alacağı gruplar </b>konu edilmektedir.",
                "SureNameTurkish": "Vâkıa",
                "SureNameArabic": "الْوَاقِعَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 46,
                "AyetCount": 96,
                "Cuz": 27,
                "FirstPage": 534,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 35215,
            "SureId": 56,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Mutlaka zakkum ağacından yiyeceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35222,
            "SureId": 56,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Karınlarınızı onunla dolduracaksınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35229,
            "SureId": 56,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Üstüne de o kaynar sudan içeceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35236,
            "SureId": 56,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Hem de susamış develerin suya kanmaz içişleriyle.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35243,
            "SureId": 56,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "İşte hesap gününde onların ağırlanması böyle olacak!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35250,
            "SureId": 56,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Sizi biz yarattık; artık inansanıza!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35257,
            "SureId": 56,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Akıttığınız meniyi düşündünüz mü?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35264,
            "SureId": 56,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Onu siz mi yaratıyorsunuz yoksa biz miyiz yaratan?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35271,
            "SureId": 56,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60-61",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Aranızda ölümü biz takdir ettik; sizi benzerlerinizle değiştirmemiz ve bilemeyeceğiniz bir şekilde sizi yeniden var etmemiz hususunda bizim önümüze asla geçilemez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35278,
            "SureId": 56,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": false,
            "Page": 536,
            "AyetText": "Aranızda ölümü biz takdir ettik; sizi benzerlerinizle değiştirmemiz ve bilemeyeceğiniz bir şekilde sizi yeniden var etmemiz hususunda bizim önümüze asla geçilemez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35285,
            "SureId": 56,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Hiç kuşkusuz ilk yaratılışınızı biliyorsunuz; düşünüp ibret alsanıza!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35292,
            "SureId": 56,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Ektiğiniz tohumu düşündünüz mü?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35299,
            "SureId": 56,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Onu siz mi bitiriyorsunuz yoksa biz miyiz bitiren?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35306,
            "SureId": 56,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Dileseydik onu kuru bir çöpe çevirirdik de şaşırır kalırdınız:",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35313,
            "SureId": 56,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "“Doğrusu çok zarara uğradık!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35320,
            "SureId": 56,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Daha doğrusu büsbütün mahrum kaldık” (derdiniz).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35327,
            "SureId": 56,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "İçtiğiniz suyu düşündünüz mü?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35334,
            "SureId": 56,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Onu buluttan siz mi indirdiniz yoksa biz miyiz indiren?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35341,
            "SureId": 56,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 536,
            "AyetText": "Dileseydik onu tuzlu yapardık. O halde şükretmeli değil misiniz?",
            "Recitation": "",
            "AyetMeta": null,
