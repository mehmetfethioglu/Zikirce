                "FirstPage": 2,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 1722,
            "SureId": 2,
            "AyetId": 239,
            "LanguageId": 7,
            "AyetNumber": "٢٣٩",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "فَاِنْ خِفْتُمْ فَرِجَالًا اَوْ رُكْبَانًاۚ فَاِذَٓا اَمِنْتُمْ فَاذْكُرُوا اللّٰهَ كَمَا عَلَّمَكُمْ مَا لَمْ تَكُونُوا تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1729,
            "SureId": 2,
            "AyetId": 240,
            "LanguageId": 7,
            "AyetNumber": "٢٤٠",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "وَالَّذٖینَ یُتَوَفَّوْنَ مِنْكُمْ وَیَذَرُونَ اَزْوَاجًاۚ وَصِیَّةً لِاَزْوَاجِهِمْ مَتَاعًا اِلَى الْحَوْلِ غَیْرَ اِخْرَاجٍۚ فَاِنْ خَرَجْنَ فَلَا جُنَاحَ عَلَیْكُمْ فٖی مَا فَعَلْنَ فٖٓی اَنْفُسِهِنَّ مِنْ مَعْرُوفٍؕ وَاللّٰهُ عَزٖیزٌ حَكٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1736,
            "SureId": 2,
            "AyetId": 241,
            "LanguageId": 7,
            "AyetNumber": "٢٤١",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "وَلِلْمُطَلَّقَاتِ مَتَاعٌ بِالْمَعْرُوفِؕ حَقًّا عَلَى الْمُتَّقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1743,
            "SureId": 2,
            "AyetId": 242,
            "LanguageId": 7,
            "AyetNumber": "٢٤٢",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "كَذٰلِكَ یُبَیِّنُ اللّٰهُ لَكُمْ اٰیَاتِهٖ لَعَلَّكُمْ تَعْقِلُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1750,
            "SureId": 2,
            "AyetId": 243,
            "LanguageId": 7,
            "AyetNumber": "٢٤٣",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "اَلَمْ تَرَ اِلَى الَّذٖینَ خَرَجُوا مِنْ دِیَارِهِمْ وَهُمْ اُلُوفٌ حَذَرَ الْمَوْتِࣕ فَقَالَ لَهُمُ اللّٰهُ مُوتُوا ثُمَّ اَحْیَاهُمْؕ اِنَّ اللّٰهَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلٰكِنَّ اَكْثَرَ النَّاسِ لَا یَشْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1757,
            "SureId": 2,
            "AyetId": 244,
            "LanguageId": 7,
            "AyetNumber": "٢٤٤",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "وَقَاتِلُوا فٖی سَبٖیلِ اللّٰهِ وَاعْلَمُٓوا اَنَّ اللّٰهَ سَمٖیعٌ عَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1764,
            "SureId": 2,
            "AyetId": 245,
            "LanguageId": 7,
            "AyetNumber": "٢٤٥",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "مَنْ ذَا الَّذٖی یُقْرِضُ اللّٰهَ قَرْضًا حَسَنًا فَیُضَاعِفَهُ لَهُٓ اَضْعَافًا كَثٖیرَةًؕ وَاللّٰهُ یَقْبِضُ وَیَبْصُۣطُࣕ وَاِلَیْهِ تُرْجَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 1713,
            "SureId": 2,
            "AyetId": 238,
            "LanguageId": 5,
            "AyetNumber": "238",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "Namazları ve orta namazı aksatmadan kılın, huşû içinde Allah’ın huzurunda durun.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 2,
                "MealInfo": "Medine döneminde inmiştir. Kur’an-ı Kerim’in en uzun sûresi olup 286 âyettir. Adını, 67-73. âyetlerde yer alan <b>“bakara (<i>sığı</i>r)”</b> kelimesinden alır. Sûre, İslâm hukukunun ana konularıyla ilgili pek çok hüküm içermektedir.",
                "SureNameTurkish": "Bakara",
                "SureNameArabic": "الْبَقَرَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 87,
                "AyetCount": 286,
                "Cuz": 1,
                "FirstPage": 2,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 1720,
            "SureId": 2,
            "AyetId": 239,
            "LanguageId": 5,
            "AyetNumber": "239",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "Bir şeyden korkarsanız yaya veya binek üzerinde kılabilirsiniz. Korkunuz geçince Allah’ı, daha önce bilmediğinizi size öğrettiği gibi anın.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1727,
            "SureId": 2,
            "AyetId": 240,
            "LanguageId": 5,
            "AyetNumber": "240",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "İçinizden vefat edip de geride eşler bırakanlar, bir yıla kadar evlerinden çıkarılmaksızın eşlerinin geçimliğini vasiyet etsinler. Onlar çıkar giderlerse kendiliklerinden yaptıkları uygun şeylerde sizin için bir vebal yoktur. Allah izzet ve hikmet sahibidir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1734,
            "SureId": 2,
            "AyetId": 241,
            "LanguageId": 5,
            "AyetNumber": "241",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "Boşanmış kadınlara faydalanacakları uygun bir şeyler verilmesi, Allah’ın rızasını gözetenlerin borcudur.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1741,
            "SureId": 2,
            "AyetId": 242,
            "LanguageId": 5,
            "AyetNumber": "242",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "Aklınızı kullanasınız diye Allah size âyetlerini işte böyle açıklıyor.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1748,
            "SureId": 2,
            "AyetId": 243,
            "LanguageId": 5,
            "AyetNumber": "243",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "Sayıca binleri buldukları halde ölüm korkusuyla yurtlarından çıkanları görmedin mi? Bunun üzerine Allah onlara “ölün!” dedi. Sonra kendilerine hayat verdi. Şüphesiz Allah’ın insanlar üzerinde büyük lütufları vardır ama insanların çoğu şükretmezler.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1755,
            "SureId": 2,
            "AyetId": 244,
            "LanguageId": 5,
            "AyetNumber": "244",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "Allah yolunda savaşın ve bilin ki, Allah her şeyi işiten ve bilendir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1762,
            "SureId": 2,
            "AyetId": 245,
            "LanguageId": 5,
            "AyetNumber": "245",
            "AyetVisible": true,
            "Page": 39,
            "AyetText": "Kim Allah’a güzel (karşılık beklemeden) bir borç verirse Allah da bunu kat kat fazlasıyla öder. Daraltan da genişleten de Allah’tır ve O’na döndürüleceksiniz.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
