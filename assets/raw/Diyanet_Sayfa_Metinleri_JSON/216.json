                "FirstPage": 208,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 9989,
            "SureId": 10,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "اَلَّذٖینَ اٰمَنُوا وَكَانُوا یَتَّقُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9996,
            "SureId": 10,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "لَهُمُ الْبُشْرٰى فِی الْحَیٰوةِ الدُّنْیَا وَفِی الْاٰخِرَةِؕ لَا تَبْدٖیلَ لِكَلِمَاتِ اللّٰهِؕ ذٰلِكَ هُوَ الْفَوْزُ الْعَظٖیمُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10003,
            "SureId": 10,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "وَلَا یَحْزُنْكَ قَوْلُهُمْۘ اِنَّ الْعِزَّةَ لِلّٰهِ جَمٖیعًاؕ هُوَ السَّمٖیعُ الْعَلٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10010,
            "SureId": 10,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "اَلَٓا اِنَّ لِلّٰهِ مَنْ فِی السَّمٰوَاتِ وَمَنْ فِی الْاَرْضِؕ وَمَا یَتَّبِعُ الَّذٖینَ یَدْعُونَ مِنْ دُونِ اللّٰهِ شُرَكَٓاءَؕ اِنْ یَتَّبِعُونَ اِلَّا الظَّنَّ وَاِنْ هُمْ اِلَّا یَخْرُصُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10017,
            "SureId": 10,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "هُوَ الَّذٖی جَعَلَ لَكُمُ الَّیْلَ لِتَسْكُنُوا فٖیهِ وَالنَّهَارَ مُبْصِرًاؕ اِنَّ فٖی ذٰلِكَ لَاٰیَاتٍ لِقَوْمٍ یَسْمَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10024,
            "SureId": 10,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "قَالُوا اتَّخَذَ اللّٰهُ وَلَدًا سُبْحَانَهُؕ هُوَ الْغَنِیُّؕ لَهُ مَا فِی السَّمٰوَاتِ وَمَا فِی الْاَرْضِؕ اِنْ عِنْدَ‌كُمْ مِنْ سُلْطَانٍ بِهٰذَاؕ اَتَقُولُونَ عَلَى اللّٰهِ مَا لَا تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10031,
            "SureId": 10,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "قُلْ اِنَّ الَّذٖینَ یَفْتَرُونَ عَلَى اللّٰهِ الْكَذِبَ لَا یُفْلِحُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10038,
            "SureId": 10,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "مَتَاعٌ فِی الدُّنْیَا ثُمَّ اِلَیْنَا مَرْجِعُهُمْ ثُمَّ نُذٖیقُهُمُ الْعَذَابَ الشَّدٖیدَ بِمَا كَانُوا یَكْفُرُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 9980,
            "SureId": 10,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "Bilesiniz ki Allah dostlarına asla korku yoktur; onlar üzüntü de çekmeyecekler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 10,
                "MealInfo": "40,94,95 ve 96. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir.109 âyettir. Sûrede temel konu olarak Allah’ın rahmetinin gazabına üstünolduğu vurgulanmaktadır. Sûrede, Yûnus, Nûh ve Mûsâ peygamberlerile bunların kavimlerinin kıssalarına yer verilmektedir. Sûre, adını içindekiYûnus kıssasından almıştır.",
                "SureNameTurkish": "Yûnus",
                "SureNameArabic": "يُونُسَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 51,
                "AyetCount": 109,
                "Cuz": 11,
                "FirstPage": 208,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 9987,
            "SureId": 10,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63-64",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "Onlar ki, iman etmişler ve takvâya ermişlerdir, işte onlara hem bu dünya hayatında hem de âhirette müjdeler olsun! Allah’ın sözlerinde değişme olmaz; (öyleyse) en büyük kazanç budur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9994,
            "SureId": 10,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": false,
            "Page": 216,
            "AyetText": "Onlar ki, iman etmişler ve takvâya ermişlerdir, işte onlara hem bu dünya hayatında hem de âhirette müjdeler olsun! Allah’ın sözlerinde değişme olmaz; (öyleyse) en büyük kazanç budur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10001,
            "SureId": 10,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "Onların sözleri seni üzmesin. Kuşkusuz güç tamamıyla Allah’ındır; O her şeyi duymaktadır, bilmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10008,
            "SureId": 10,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "Bilesiniz ki göklerde ve yerde olanlar Allah’ındır. Allah’ı bırakıp da O’na ortak koştukları sözde tanrılara tapanlar neyin peşinden gidiyorlar? Onlar yalnızca kuruntularının peşinden gidiyorlar ve sadece yalan söylüyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10015,
            "SureId": 10,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "İçinde dinlenesiniz diye geceyi, (işlerinizi) görmenizi sağlasın diye gündüzü size bahşeden O’dur. Kuşkusuz dinlemesini bilen bir topluluk için bunda dersler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10022,
            "SureId": 10,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "Onlar, “Allah çocuk edindi” dediler. Hâşâ!... O hiçbir şeye muhtaç değildir. Göklerde olanlar da yerde olanlar da O’nundur. Yanınızda bu iddianızı kanıtlayacak bir deliliniz asla yoktur. Allah’a karşı bilmediğiniz şeyleri mi söylüyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10029,
            "SureId": 10,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "De ki: “Allah hakkında asılsız şeyler yakıştıranlar kurtuluşa eremezler.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10036,
            "SureId": 10,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 216,
            "AyetText": "Bu dünyadaki, önemsiz bir menfaattir; sonunda onların dönüşü bizedir ve nihayet inkâr etmiş olmaları sebebiyle onlara şiddetli azabı tattıracağız!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
