            "AyetNumber": "١٠١",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "وَكَیْفَ تَكْفُرُونَ وَاَنْتُمْ تُتْلٰى عَلَیْكُمْ اٰیَاتُ اللّٰهِ وَفٖیكُمْ رَسُولُهُؕ وَمَنْ یَعْتَصِمْ بِاللّٰهِ فَقَدْ هُدِیَ اِلٰى صِرَاطٍ مُسْتَقٖیمٍࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 2765,
            "SureId": 3,
            "AyetId": 102,
            "LanguageId": 7,
            "AyetNumber": "١٠٢",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "یَٓا اَیُّهَا الَّذٖینَ اٰمَنُوا اتَّقُوا اللّٰهَ حَقَّ تُقَاتِهٖ وَلَا تَمُوتُنَّ اِلَّا وَاَنْتُمْ مُسْلِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2772,
            "SureId": 3,
            "AyetId": 103,
            "LanguageId": 7,
            "AyetNumber": "١٠٣",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "وَاعْتَصِمُوا بِحَبْلِ اللّٰهِ جَمٖیعًا وَلَا تَفَرَّقُواࣕ وَاذْكُرُوا نِعْمَتَ اللّٰهِ عَلَیْكُمْ اِذْ كُنْتُمْ اَعْدَٓاءً فَاَلَّفَ بَیْنَ قُلُوبِكُمْ فَاَصْبَحْتُمْ بِنِعْمَتِهٖٓ اِخْوَانًاۚ وَكُنْتُمْ عَلٰى شَفَا حُفْرَةٍ مِنَ النَّارِ فَاَنْقَذَكُمْ مِنْهَاؕ كَذٰلِكَ یُبَیِّنُ اللّٰهُ لَكُمْ اٰیَاتِهٖ لَعَلَّكُمْ تَهْتَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2779,
            "SureId": 3,
            "AyetId": 104,
            "LanguageId": 7,
            "AyetNumber": "١٠٤",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "وَلْتَكُنْ مِنْكُمْ اُمَّةٌ یَدْعُونَ اِلَى الْخَیْرِ وَیَاْمُرُونَ بِالْمَعْرُوفِ وَیَنْهَوْنَ عَنِ الْمُنْكَرِؕ وَاُو𐻾لٰٓئِكَ هُمُ الْمُفْلِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2786,
            "SureId": 3,
            "AyetId": 105,
            "LanguageId": 7,
            "AyetNumber": "١٠٥",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "وَلَا تَكُونُوا كَالَّذٖینَ تَفَرَّقُوا وَاخْتَلَفُوا مِنْ بَعْدِ مَا جَٓاءَهُمُ الْبَیِّنَاتُؕ وَاُو𐻾لٰٓئِكَ لَهُمْ عَذَابٌ عَظٖیمٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2793,
            "SureId": 3,
            "AyetId": 106,
            "LanguageId": 7,
            "AyetNumber": "١٠٦",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "یَوْمَ تَبْیَضُّ وُجُوهٌ وَتَسْوَدُّ وُجُوهٌۚ فَاَمَّا الَّذٖینَ اسْوَدَّتْ وُجُوهُهُمْࣞ اَكَفَرْتُمْ بَعْدَ اٖیمَانِكُمْ فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2800,
            "SureId": 3,
            "AyetId": 107,
            "LanguageId": 7,
            "AyetNumber": "١٠٧",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "وَاَمَّا الَّذٖینَ ابْیَضَّتْ وُجُوهُهُمْ فَفٖی رَحْمَةِ اللّٰهِؕ هُمْ فٖیهَا خَالِدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2807,
            "SureId": 3,
            "AyetId": 108,
            "LanguageId": 7,
            "AyetNumber": "١٠٨",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "تِلْكَ اٰیَاتُ اللّٰهِ نَتْلُوهَا عَلَیْكَ بِالْحَقِّؕ وَمَا اللّٰهُ یُرٖیدُ ظُلْمًا لِلْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 2756,
            "SureId": 3,
            "AyetId": 101,
            "LanguageId": 5,
            "AyetNumber": "101",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "Size Allah’ın âyetleri okunup dururken, üstelik Allah resulü de aranızda bulunurken nasıl inkâra saparsınız? Her kim Allah’a bağlanırsa kesinlikle doğru yola iletilmiştir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 2763,
            "SureId": 3,
            "AyetId": 102,
            "LanguageId": 5,
            "AyetNumber": "102",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "Ey iman edenler! Allah’a karşı gereği gibi saygılı olun ve ancak Müslüman olarak can verin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2770,
            "SureId": 3,
            "AyetId": 103,
            "LanguageId": 5,
            "AyetNumber": "103",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "Hep birlikte Allah’ın ipine sımsıkı yapışın; bölünüp parçalanmayın. Allah’ın size olan nimetini hatırlayın. Hani siz birbirinize düşman idiniz de Allah gönüllerinizi birleştirdi ve O’nun nimeti sayesinde kardeş oldunuz. Siz bir ateş çukurunun tam kenarında iken oradan da sizi Allah kurtarmıştı. İşte Allah size âyetlerini böyle açıklıyor ki doğru yolu bulasınız.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2777,
            "SureId": 3,
            "AyetId": 104,
            "LanguageId": 5,
            "AyetNumber": "104",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "İçinizden hayra çağıran, iyiliği emredip kötülüğü meneden bir topluluk bulunsun. İşte onlar kurtuluşa erenlerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2784,
            "SureId": 3,
            "AyetId": 105,
            "LanguageId": 5,
            "AyetNumber": "105",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "Kendilerine apaçık deliller geldikten sonra parçalanıp ayrılığa düşenler gibi olmayınız. İşte onlar için büyük bir azap vardır.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2791,
            "SureId": 3,
            "AyetId": 106,
            "LanguageId": 5,
            "AyetNumber": "106",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "Bir gün ki nice yüzler ağaracak, nice yüzler de kararacaktır; yüzleri kararanlara, “İman ettikten sonra kâfir mi oldunuz? Öyle ise inkâr etmiş olmanız yüzünden tadın azabı!” (denir).",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2798,
            "SureId": 3,
            "AyetId": 107,
            "LanguageId": 5,
            "AyetNumber": "107",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "Yüzleri ağaranlara gelince, onlar Allah’ın rahmeti içindedirler; orada onlar ebedî kalacaklardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2805,
            "SureId": 3,
            "AyetId": 108,
            "LanguageId": 5,
            "AyetNumber": "108",
            "AyetVisible": true,
            "Page": 63,
            "AyetText": "İşte bunlar Allah’ın âyetleridir. Bunları sana gerçek olarak okumaktayız. Allah hiçbir varlığa zulmedilmesini istemez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
