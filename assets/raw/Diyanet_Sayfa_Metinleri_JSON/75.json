            "AyetVisible": true,
            "Page": 75,
            "AyetText": "وَاِذْ اَخَذَ اللّٰهُ مٖیثَاقَ الَّذٖینَ اُو𐻿تُوا الْكِتَابَ لَتُبَیِّنُنَّهُ لِلنَّاسِ وَلَا تَكْتُمُونَهُؗ فَنَبَذُوهُ وَرَٓاءَ ظُهُورِهِمْ وَاشْتَرَوْا بِهٖ ثَمَنًا قَلٖیلًاؕ فَبِئْسَ مَا یَشْتَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 3367,
            "SureId": 3,
            "AyetId": 188,
            "LanguageId": 7,
            "AyetNumber": "١٨٨",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "لَا تَحْسَبَنَّ الَّذٖینَ یَفْرَحُونَ بِمَٓا اَتَوْا وَیُحِبُّونَ اَنْ یُحْمَدُوا بِمَا لَمْ یَفْعَلُوا فَلَا تَحْسَبَنَّهُمْ بِمَفَازَةٍ مِنَ الْعَذَابِۚ وَلَهُمْ عَذَابٌ اَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3374,
            "SureId": 3,
            "AyetId": 189,
            "LanguageId": 7,
            "AyetNumber": "١٨٩",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "وَلِلّٰهِ مُلْكُ السَّمٰوَاتِ وَالْاَرْضِؕ وَاللّٰهُ عَلٰى كُلِّ شَیْءٍ قَدٖیرٌࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3381,
            "SureId": 3,
            "AyetId": 190,
            "LanguageId": 7,
            "AyetNumber": "١٩٠",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "اِنَّ فٖی خَلْقِ السَّمٰوَاتِ وَالْاَرْضِ وَاخْتِلَافِ الَّیْلِ وَالنَّهَارِ لَاٰیَاتٍ لِاُو𐻾لِی الْاَلْبَابِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3388,
            "SureId": 3,
            "AyetId": 191,
            "LanguageId": 7,
            "AyetNumber": "١٩١",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "اَلَّذٖینَ یَذْكُرُونَ اللّٰهَ قِیَامًا وَقُعُودًا وَعَلٰى جُنُوبِهِمْ وَیَتَفَكَّرُونَ فٖی خَلْقِ السَّمٰوَاتِ وَالْاَرْضِۚ رَبَّنَا مَا خَلَقْتَ هٰذَا بَاطِلًاۚ سُبْحَانَكَ فَقِنَا عَذَابَ النَّارِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3395,
            "SureId": 3,
            "AyetId": 192,
            "LanguageId": 7,
            "AyetNumber": "١٩٢",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "رَبَّنَٓا اِنَّكَ مَنْ تُدْخِلِ النَّارَ فَقَدْ اَخْزَیْتَهُؕ وَمَا لِلظَّالِمٖینَ مِنْ اَنْصَارٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3402,
            "SureId": 3,
            "AyetId": 193,
            "LanguageId": 7,
            "AyetNumber": "١٩٣",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "رَبَّنَٓا اِنَّنَا سَمِعْنَا مُنَادِیًا یُنَادٖی لِلْاٖیمَانِ اَنْ اٰمِنُوا بِرَبِّكُمْ فَاٰمَنَّاࣗ رَبَّنَا فَاغْفِرْ لَنَا ذُنُوبَنَا وَكَفِّرْ عَنَّا سَیِّـَٔاتِنَا وَتَوَفَّنَا مَعَ الْاَبْرَارِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3409,
            "SureId": 3,
            "AyetId": 194,
            "LanguageId": 7,
            "AyetNumber": "١٩٤",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "رَبَّنَا وَاٰتِنَا مَا وَعَدْتَنَا عَلٰى رُسُلِكَ وَلَا تُخْزِنَا یَوْمَ الْقِیٰمَةِؕ اِنَّكَ لَا تُخْلِفُ الْمٖیعَادَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 3358,
            "SureId": 3,
            "AyetId": 187,
            "LanguageId": 5,
            "AyetNumber": "187",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "Allah, kendilerine kitap verilenlerden, “Onu insanlara mutlaka açıklayacaksınız, onu gizlemeyeceksiniz” diye sağlam söz almıştı. Ama onlar bunu kulak ardı edip kitabı az bir dünyalıkla değiştiler. Karşılığında aldıkları ne kadar da değersiz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 3365,
            "SureId": 3,
            "AyetId": 188,
            "LanguageId": 5,
            "AyetNumber": "188",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "Sanma ki yaptıklarından memnun olanlar, yapmadıklarıyla övülmekten hoşlananlar, evet, sanma ki onlar azaptan kurtulacaklardır! Onlar için elem verici bir azap vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3372,
            "SureId": 3,
            "AyetId": 189,
            "LanguageId": 5,
            "AyetNumber": "189",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "Göklerin ve yerin hükümranlığı Allah’ındır. Allah’ın her şeye gücü yeter.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3379,
            "SureId": 3,
            "AyetId": 190,
            "LanguageId": 5,
            "AyetNumber": "190",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "Göklerin ve yerin yaratılışında, gece ile gündüzün farklı oluşunda aklıselim sahipleri için elbette ibretler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3386,
            "SureId": 3,
            "AyetId": 191,
            "LanguageId": 5,
            "AyetNumber": "191",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "Onlar ayakta dururken, otururken, yatarken hep Allah’ı anarlar; göklerin ve yerin yaratılışını düşünürler (ve şöyle derler:) “Rabbimiz! Sen bunu boş yere yaratmadın, seni tenzih ve takdis ederiz. Bizi cehennem azabından koru!",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3393,
            "SureId": 3,
            "AyetId": 192,
            "LanguageId": 5,
            "AyetNumber": "192",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "Rabbimiz! Sen kimi ateşe sokarsan hiç şüphe yok onu rezil etmiş olursun. Zalimlerin hiç yardımcıları yoktur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3400,
            "SureId": 3,
            "AyetId": 193,
            "LanguageId": 5,
            "AyetNumber": "193",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "Rabbimiz! Doğrusu biz ‘Rabbinize inanın!’ diyerek, imana çağıran bir davetçiyi işitip iman ettik. Rabbimiz! Günahlarımızı bağışla, kötülüklerimizi sil ve bize iyilerin ölümünü nasip et.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3407,
            "SureId": 3,
            "AyetId": 194,
            "LanguageId": 5,
            "AyetNumber": "194",
            "AyetVisible": true,
            "Page": 75,
            "AyetText": "Rabbimiz! Peygamberlerin aracılığıyla bize vaad ettiklerini ver bize; kıyamet gününde bizi rezil etme. Sen asla sözünden caymazsın.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
