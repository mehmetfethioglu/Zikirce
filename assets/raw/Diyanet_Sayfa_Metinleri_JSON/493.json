    "QuranAyats": [
        {
            "Id": 30611,
            "SureId": 43,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "وَمَا نُرٖیهِمْ مِنْ اٰیَةٍ اِلَّا هِیَ اَكْبَرُ مِنْ اُخْتِهَاؗ وَاَخَذْنَاهُمْ بِالْعَذَابِ لَعَلَّهُمْ یَرْجِعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 43,
                "MealInfo": "Mekke döneminde inmiştir. 89 âyettir. Sûre, adını 35. âyette geçen <b>“Zuhruf ” </b>kelimesinden almaktadır. <b>Zuhruf; yaldız, mücevher, dünya hayatının geçici menfaati anlamlarına gelir. </b>Sûrede başlıca tevhit, iman ve vahyin getirdiği hakikatler ile insanların bu hakikatlere ters düşecek şekilde sırf geçici dünya menfaatlerine bağlanarak sergiledikleri çelişki vurgulanmakta, batıla karşı çıkan ve hakkı tutan şahsiyetler olarak İbrahim, Mûsâ ve İsa Peygamberlerden söz edilmektedir.",
                "SureNameTurkish": "Zuhruf",
                "SureNameArabic": "الزُّخْرُفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 63,
                "AyetCount": 89,
                "Cuz": 25,
                "FirstPage": 489,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30618,
            "SureId": 43,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "وَقَالُوا یَٓا اَیُّهَ السَّاحِرُ ادْعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِنْدَكَ اِنَّنَا لَمُهْتَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30625,
            "SureId": 43,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "فَلَمَّا كَشَفْنَا عَنْهُمُ الْعَذَابَ اِذَا هُمْ یَنْكُثُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30632,
            "SureId": 43,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "وَنَادٰى فِرْعَوْنُ فٖی قَوْمِهٖ قَالَ یَا قَوْمِ اَلَیْسَ لٖی مُلْكُ مِصْرَ وَهٰذِهِ الْاَنْهَارُ تَجْرٖی مِنْ تَحْتٖیۚ اَفَلَا تُبْصِرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30639,
            "SureId": 43,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "اَمْ اَنَا𐻾 خَیْرٌ مِنْ هٰذَا الَّذٖی هُوَ مَهٖینٌ وَلَا یَكَادُ یُبٖینُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30646,
            "SureId": 43,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "فَلَوْلَٓا اُلْقِیَ عَلَیْهِ اَسْوِرَةٌ مِنْ ذَهَبٍ اَوْ جَٓاءَ مَعَهُ الْمَلٰٓئِكَةُ مُقْتَرِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30653,
            "SureId": 43,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "فَاسْتَخَفَّ قَوْمَهُ فَاَطَاعُوهُؕ اِنَّهُمْ كَانُوا قَوْمًا فَاسِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30660,
            "SureId": 43,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "فَلَمَّٓا اٰسَفُونَا انْتَقَمْنَا مِنْهُمْ فَاَغْرَقْنَاهُمْ اَجْمَعٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30667,
            "SureId": 43,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "فَجَعَلْنَاهُمْ سَلَفًا وَمَثَلًا لِلْاٰخِرٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30674,
            "SureId": 43,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "وَلَمَّا ضُرِبَ ابْنُ مَرْیَمَ مَثَلًا اِذَا قَوْمُكَ مِنْهُ یَصِدُّونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30681,
            "SureId": 43,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "وَقَالُٓوا ءَاٰلِهَتُنَا خَیْرٌ اَمْ هُوَؕ مَا ضَرَبُوهُ لَكَ اِلَّا جَدَلًاؕ بَلْ هُمْ قَوْمٌ خَصِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30688,
            "SureId": 43,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "اِنْ هُوَ اِلَّا عَبْدٌ اَنْعَمْنَا عَلَیْهِ وَجَعَلْنَاهُ مَثَلًا لِبَنٖٓی اِسْرَٓایٖٔلَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30695,
            "SureId": 43,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "وَلَوْ نَشَٓاءُ لَجَعَلْنَا مِنْكُمْ مَلٰٓئِكَةً فِی الْاَرْضِ یَخْلُفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 30609,
            "SureId": 43,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "Oysa kendilerine gösterdiğimiz her mûcize bir diğerinden daha büyüktü. Belki yanlış yoldan dönerler diye kendilerini felâketlerle sarstık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 43,
                "MealInfo": "Mekke döneminde inmiştir. 89 âyettir. Sûre, adını 35. âyette geçen <b>“Zuhruf ” </b>kelimesinden almaktadır. <b>Zuhruf; yaldız, mücevher, dünya hayatının geçici menfaati anlamlarına gelir. </b>Sûrede başlıca tevhit, iman ve vahyin getirdiği hakikatler ile insanların bu hakikatlere ters düşecek şekilde sırf geçici dünya menfaatlerine bağlanarak sergiledikleri çelişki vurgulanmakta, batıla karşı çıkan ve hakkı tutan şahsiyetler olarak İbrahim, Mûsâ ve İsa Peygamberlerden söz edilmektedir.",
                "SureNameTurkish": "Zuhruf",
                "SureNameArabic": "الزُّخْرُفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 63,
                "AyetCount": 89,
                "Cuz": 25,
                "FirstPage": 489,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30616,
            "SureId": 43,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "Bunun üzerine şöyle dediler: “Ey büyücü! Rabbinin seninle sözleşmesine uygun olarak bize dua et, artık biz doğru yola döneceğiz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30623,
            "SureId": 43,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "(Dua sebebiyle) onların başından felâketi uzaklaştırınca bir de bakıyorsun sözlerinden dönüveriyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30630,
            "SureId": 43,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51-53",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "Firavun kavmine seslenerek şöyle dedi: “Ey milletim! Mısır’ın mülkiyeti benim değil mi? Şu ırmaklar ayaklarımın altında akmıyor mu? Bunları görmüyor musunuz? Ayrıca ben bu değersiz, neredeyse söylediğini anlatmaktan âciz adamdan daha iyi değil miyim? (O bir peygamber ise) kendisine altın bilezikler indirilse yahut dizi dizi melekler onunla birlikte gelseler ya!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30637,
            "SureId": 43,
            "AyetId": 52,
