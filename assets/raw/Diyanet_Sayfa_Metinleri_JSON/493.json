        },
        {
            "Id": 30651,
            "SureId": 43,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "Firavun bu konuşmalarla halkının aklını çeldi, hemen ona boyun eğdiler; onlar zaten yoldan çıkmış bir topluluk idi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30658,
            "SureId": 43,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "Bize karşı öfkelendirici davranışlarını sürdürünce onlara hak ettikleri cezayı verdik ve hepsini suya gömdük.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30665,
            "SureId": 43,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "Onları, arkadan gelecek diğerlerinin geçmişi ve ibretlik örneği kıldık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30672,
            "SureId": 43,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "Meryem’in oğlu misal olarak zikredilince senin kavmin bundan dolayı hemen yaygarayı basıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30679,
            "SureId": 43,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "“Bizim tanrılarımız mı iyi yoksa o mu?” diyorlar. Bu karşılaştırmayı sırf sana karşı çıkmış olmak için yapıyorlar. Onlar gerçekten inatçı bir muhalefet!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30686,
            "SureId": 43,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "Îsâ, kendisine lutuflarda bulunduğumuz ve İsrâiloğulları’na ilâhî kudretin örneği kıldığımız bir kuldur ancak.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30693,
            "SureId": 43,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 493,
            "AyetText": "İsteseydik sizin yerinize, yeryüzünde egemen olacak melekler yaratırdık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
