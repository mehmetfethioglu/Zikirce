    "QuranAyats": [
        {
            "Id": 10752,
            "SureId": 11,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "قَالَ یَا قَوْمِ اَرَاَیْتُمْ اِنْ كُنْتُ عَلٰى بَیِّنَةٍ مِنْ رَبّٖی وَاٰتٰینٖی مِنْهُ رَحْمَةً فَمَنْ یَنْصُرُنٖی مِنَ اللّٰهِ اِنْ عَصَیْتُهُ فَمَا تَزٖیدُونَنٖی غَیْرَ تَخْسٖیرٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 11,
                "MealInfo": "Mekke döneminde inmiştir. 123 âyettir. Sûre, adını içinde söz konusu edilen Hûd peygamberden almıştır. Sûre de başlıca tevhit, peygamberlik, öldükten sonra dirilme ve ceza konuları ele alınmakta ve bunlar bazı peygamberlerin kıssalarıyla desteklenmektedir.",
                "SureNameTurkish": "Hûd",
                "SureNameArabic": "هُودٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 52,
                "AyetCount": 123,
                "Cuz": 11,
                "FirstPage": 221,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 10759,
            "SureId": 11,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "وَیَا قَوْمِ هٰذِهٖ نَاقَةُ اللّٰهِ لَكُمْ اٰیَةً فَذَرُوهَا تَاْكُلْ فٖٓی اَرْضِ اللّٰهِ وَلَا تَمَسُّوهَا بِسُٓوءٍ فَیَاْخُذَكُمْ عَذَابٌ قَرٖیبٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10766,
            "SureId": 11,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "فَعَقَرُوهَا فَقَالَ تَمَتَّعُوا فٖی دَارِكُمْ ثَلٰثَةَ اَیَّامٍؕ ذٰلِكَ وَعْدٌ غَیْرُ مَكْذُوبٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10773,
            "SureId": 11,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "فَلَمَّا جَٓاءَ اَمْرُنَا نَجَّیْنَا صَالِحًا وَالَّذٖینَ اٰمَنُوا مَعَهُ بِرَحْمَةٍ مِنَّا وَمِنْ خِزْیِ یَوْمِئِذٍؕ اِنَّ رَبَّكَ هُوَ الْقَوِیُّ الْعَزٖیزُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10780,
            "SureId": 11,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "وَاَخَذَ الَّذٖینَ ظَلَمُوا الصَّیْحَةُ فَاَصْبَحُوا فٖی دِیَارِهِمْ جَاثِمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10787,
            "SureId": 11,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "كَاَنْ لَمْ یَغْنَوْا فٖیهَاؕ اَلَٓا اِنَّ ثَمُودَا𐻾 كَفَرُوا رَبَّهُمْؕ اَلَا بُعْدًا لِثَمُودَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10794,
            "SureId": 11,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "وَلَقَدْ جَٓاءَتْ رُسُلُنَٓا اِبْرٰهٖیمَ بِالْبُشْرٰى قَالُوا سَلَامًاؕ قَالَ سَلَامٌۚ فَمَا لَبِثَ اَنْ جَٓاءَ بِعِجْلٍ حَنٖیذٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10801,
            "SureId": 11,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "فَلَمَّا رَآٰ اَیْدِیَهُمْ لَا تَصِلُ اِلَیْهِ نَكِرَهُمْ وَاَوْجَسَ مِنْهُمْ خٖیفَةًؕ قَالُوا لَا تَخَفْ اِنَّٓا اُرْسِلْنَٓا اِلٰى قَوْمِ لُوطٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10808,
            "SureId": 11,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "وَامْرَاَتُهُ قَٓائِمَةٌ فَضَحِكَتْ فَبَشَّرْنَاهَا بِاِسْحٰقَۙ وَمِنْ وَرَٓاءِ اِسْحٰقَ یَعْقُوبَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 10750,
            "SureId": 11,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "Sâlih dedi ki: “Ey kavmim! Bir de şöyle düşünün: Ya ben rabbimden verilmiş apaçık bir delile dayanıyorsam ve O bana kendinden bir lutufta bulunmuşsa! Bu durum karşısında O’na âsi olursam beni Allah’a karşı kim korur? (Size uyarsam) benim ancak zararımı arttırırsınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 11,
                "MealInfo": "Mekke döneminde inmiştir. 123 âyettir. Sûre, adını içinde söz konusu edilen Hûd peygamberden almıştır. Sûre de başlıca tevhit, peygamberlik, öldükten sonra dirilme ve ceza konuları ele alınmakta ve bunlar bazı peygamberlerin kıssalarıyla desteklenmektedir.",
                "SureNameTurkish": "Hûd",
                "SureNameArabic": "هُودٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 52,
                "AyetCount": 123,
                "Cuz": 11,
                "FirstPage": 221,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 10757,
            "SureId": 11,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "Ey kavmim! İşte size mûcize olarak Allah’ın gönderdiği dişi deve. Onu bırakın Allah’ın mülkünde otlasın. Ona kötülük etmeyin; sonra sizi, yaklaşan bir azap yakalar.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10764,
            "SureId": 11,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "Buna rağmen o deveyi kestiler. Sâlih de, “Yurdunuzda üç gün daha yaşayın!” dedi. Bu, asılsız çıkmayacak bir tehdit idi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10771,
            "SureId": 11,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "Emrimiz gelince Sâlih’i ve onunla beraber iman edenleri, bizden bir rahmet olarak, helâk olmaktan ve o günün zilletinden kurtardık. Şüphesiz rabbin kuvvetlidir, üstündür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10778,
            "SureId": 11,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "Zulmedenleri de o korkunç ses yakaladı, yurtlarında diz üstü çöküp kaldılar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10785,
            "SureId": 11,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "Sanki orada hiç oturmamışlardı. İşte böyle, Semûd kavmi rablerini inkâr etti. Vay Semûd’un haline!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10792,
            "SureId": 11,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "Elçilerimiz İbrâhim’e müjdeyi getirip selâm vermişlerdi. O da “selâm” dedi, çok geçmeden (konuklarına) kızartılmış bir buzağı getirdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10799,
            "SureId": 11,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "Ona el uzatmadıklarını görünce, onları yadırgadı ve onlardan dolayı içine bir korku düştü. “Korkma! Biz Lût kavmine gönderildik” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10806,
            "SureId": 11,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": true,
            "Page": 229,
            "AyetText": "Ayakta bekleyen karısı rahatlayıp güldü; bu sırada ona İshak’ın, İshak’ın ardından da Ya‘kūb’un doğacağını müjdeledik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
