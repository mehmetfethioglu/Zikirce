{
    "PointerList": null,
    "CuzNo": 23,
    "PageNo": 445,
    "ArCuzNo": "۲۳",
    "ArPageNo": "٤٤٥",
    "QuranAyats": [
        {
            "Id": 26432,
            "SureId": 36,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "اَوَلَمْ یَرَوْا اَنَّا خَلَقْنَا لَهُمْ مِمَّا عَمِلَتْ اَیْدٖینَٓا اَنْعَامًا فَهُمْ لَهَا مَالِكُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 36,
                "MealInfo": "Mekke döneminde inmiştir. 83 âyettir. Sûre, adını ilk âyeti oluşturan <b>“Yâ-S</b>în” harflerinden almıştır. Sûrede başlıca i<b>nsanın ahlâkî sorumlulukları, vahiy, Hz. Peygamber’i yalanlayan Kureyş kabilesi, Antakya halkına gönderilen peygamberler, Allah’ın birliğini ve kudretini gösteren deliller, öldükten sonra dirilme,hesap ve ceza konu </b>edilmektedir.",
                "SureNameTurkish": "Yâsîn",
                "SureNameArabic": "يٰسۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 41,
                "AyetCount": 83,
                "Cuz": 22,
                "FirstPage": 440,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26439,
            "SureId": 36,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "وَذَلَّلْنَاهَا لَهُمْ فَمِنْهَا رَكُوبُهُمْ وَمِنْهَا یَاْكُلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26446,
            "SureId": 36,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "وَلَهُمْ فٖیهَا مَنَافِـعُ وَمَشَارِبُؕ اَفَلَا یَشْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26453,
            "SureId": 36,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "وَاتَّخَذُوا مِنْ دُونِ اللّٰهِ اٰلِهَةً لَعَلَّهُمْ یُنْصَرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26460,
            "SureId": 36,
            "AyetId": 75,
            "LanguageId": 7,
            "AyetNumber": "٧٥",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "لَا یَسْتَطٖیعُونَ نَصْرَهُمْۙ وَهُمْ لَهُمْ جُنْدٌ مُحْضَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26467,
            "SureId": 36,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "فَلَا یَحْزُنْكَ قَوْلُهُمْۘ اِنَّا نَعْلَمُ مَا یُسِرُّونَ وَمَا یُعْلِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26474,
            "SureId": 36,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "اَوَلَمْ یَرَ الْاِنْسَانُ اَنَّا خَلَقْنَاهُ مِنْ نُطْفَةٍ فَاِذَا هُوَ خَصٖیمٌ مُبٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26481,
            "SureId": 36,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "وَضَرَبَ لَنَا مَثَلًا وَنَسِیَ خَلْقَهُؕ قَالَ مَنْ یُحْيِ الْعِظَامَ وَهِیَ رَمٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26488,
            "SureId": 36,
            "AyetId": 79,
            "LanguageId": 7,
            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "قُلْ یُحْیٖیهَا الَّذٖٓی اَنْشَاَهَٓا اَوَّلَ مَرَّةٍؕ وَهُوَ بِكُلِّ خَلْقٍ عَلٖیمٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26495,
            "SureId": 36,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "اَلَّذٖی جَعَلَ لَكُمْ مِنَ الشَّجَرِ الْاَخْضَرِ نَارًا فَاِذَٓا اَنْتُمْ مِنْهُ تُوقِدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26502,
            "SureId": 36,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "اَوَلَیْسَ الَّذٖی خَلَقَ السَّمٰوَاتِ وَالْاَرْضَ بِقَادِرٍ عَلٰٓى اَنْ یَخْلُقَ مِثْلَهُمْؕ بَلٰى وَهُوَ الْخَلَّاقُ الْعَلٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26509,
            "SureId": 36,
            "AyetId": 82,
            "LanguageId": 7,
            "AyetNumber": "٨٢",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "اِنَّمَٓا اَمْرُهُٓ اِذَٓا اَرَادَ شَیْـًٔا اَنْ یَقُولَ لَهُ كُنْ فَیَكُونُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26516,
            "SureId": 36,
            "AyetId": 83,
            "LanguageId": 7,
            "AyetNumber": "٨٣",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "فَسُبْحَانَ الَّذٖی بِیَدِهٖ مَلَكُوتُ كُلِّ شَیْءٍ وَاِلَیْهِ تُرْجَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 26430,
            "SureId": 36,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "Görmezler mi ki kendi kudretimizin eserlerinden olmak üzere onlar için sahip oldukları nice hayvanlar yarattık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 36,
                "MealInfo": "Mekke döneminde inmiştir. 83 âyettir. Sûre, adını ilk âyeti oluşturan <b>“Yâ-S</b>în” harflerinden almıştır. Sûrede başlıca i<b>nsanın ahlâkî sorumlulukları, vahiy, Hz. Peygamber’i yalanlayan Kureyş kabilesi, Antakya halkına gönderilen peygamberler, Allah’ın birliğini ve kudretini gösteren deliller, öldükten sonra dirilme,hesap ve ceza konu </b>edilmektedir.",
                "SureNameTurkish": "Yâsîn",
                "SureNameArabic": "يٰسۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 41,
                "AyetCount": 83,
                "Cuz": 22,
                "FirstPage": 440,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26437,
            "SureId": 36,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "Bunları kendilerine boyun eğdirdik ki bir kısmı binekleridir, bir kısmını da yerler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26444,
            "SureId": 36,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "Bunlarda kendileri için içecekler ve başkaca yararlar da vardır. Hâlâ ­şükretmeyecekler mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26451,
            "SureId": 36,
            "AyetId": 74,
            "LanguageId": 5,
            "AyetNumber": "74",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "Onlar yardım göreceklerini umarak Allah’tan başka tanrılar edindiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26458,
            "SureId": 36,
            "AyetId": 75,
            "LanguageId": 5,
            "AyetNumber": "75",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "Halbuki o sözde tanrılar kendilerine yardım edemezler, aksine kendileri onların hizmetindeki askerlerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26465,
            "SureId": 36,
            "AyetId": 76,
            "LanguageId": 5,
            "AyetNumber": "76",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "Onların sözleri seni üzmesin. Biz onların gizlediklerini de açığa vurduklarını da elbette biliyoruz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26472,
            "SureId": 36,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "İnsan kendisini bir nutfeden yarattığımızı görmez mi? Oysa bak, şimdi o, açıktan açığa bize karşı duran biri olmuştur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26479,
            "SureId": 36,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "Kendi yaratılışını unutup bize örnek getirmeye kalkışıyor ve “Şu çürümüş kemiklere kim can verecekmiş?” diyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26486,
            "SureId": 36,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "De ki: “Onları ilk başta yaratmış olan diriltecek. O yaratmanın her türlüsünü bilir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26493,
            "SureId": 36,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "Yemyeşil ağaçtan sizin için ateş çıkaran O’dur; işte ondan yakıp durmaktasınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26500,
            "SureId": 36,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "Gökleri ve yeri yaratan Allah onların benzerini yaratmaya kādir değil mi? Elbette öyledir. O eşsiz yaratıcıdır, her şeyi bilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26507,
            "SureId": 36,
            "AyetId": 82,
            "LanguageId": 5,
            "AyetNumber": "82",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "Bir şeyi istediğinde, O’nun buyruğu “ol!” demekten ibarettir; hemen oluverir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26514,
            "SureId": 36,
            "AyetId": 83,
            "LanguageId": 5,
            "AyetNumber": "83",
            "AyetVisible": true,
            "Page": 445,
            "AyetText": "Her şeyin egemenliği kendi elinde olan Allah bütün eksikliklerden uzaktır ve hepiniz sonunda O’na döndürüleceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Yâsîn",
    "QuranSureLabel": "يٰسۤ",
    "EndPageSure": {
        "SureId": 37,
        "MealInfo": "Mekke döneminde inmiştir. 182 âyettir. Sûre, adını ilk âyette geçen <b>“es-Sâffât” </b>kelimesinden almıştır.<b> Sâffât, sıra sıra dizilenler, saf saf duranlar demektir</b>. Sûrede başlıca, <b>meleklerden, cinlerden, kıyamet ve ahiret olaylarından söz edilmekte; Nûh, İbrahim, İsmail, İshak, Mûsâ, Hârun, İlyas, Lût ve Yûnus Peygamberlerin kıssaları</b>na yer verilmektedir.",
