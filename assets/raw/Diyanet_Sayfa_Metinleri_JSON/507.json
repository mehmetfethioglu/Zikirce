    "QuranAyats": [
        {
            "Id": 31822,
            "SureId": 47,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "اَلَّذٖینَ كَفَرُوا وَصَدُّوا عَنْ سَبٖیلِ اللّٰهِ اَضَلَّ اَعْمَالَهُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 47,
                "MealInfo": "Medine döneminde inmiştir. 38 âyettir. <b>Sûre, adını Peygamber Efendimizin,ikinci âyette geçen adından almıştır.</b> Sûre, ayrıca yirminci âyette geçen <b>“elKıtâl</b>” kelimesinden dolayı<b> “Kıtâl sûresi</b>”, diye de anılmaktadır. Sûrede temel konu cihad olmak üzere başlıca, savaş, esirler, ganimetler ve münafıkların durumu konu edilmektedir.",
                "SureNameTurkish": "Muhammed",
                "SureNameArabic": "مُحَمَّدٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 95,
                "AyetCount": 38,
                "Cuz": 26,
                "FirstPage": 507,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 31829,
            "SureId": 47,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "وَالَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَاٰمَنُوا بِمَا نُزِّلَ عَلٰى مُحَمَّدٍ وَهُوَ الْحَقُّ مِنْ رَبِّهِمْۙ كَفَّرَ عَنْهُمْ سَیِّــَٔاتِهِمْ وَاَصْلَحَ بَالَهُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31836,
            "SureId": 47,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "ذٰلِكَ بِاَنَّ الَّذٖینَ كَفَرُوا اتَّبَعُوا الْبَاطِلَ وَاَنَّ الَّذٖینَ اٰمَنُوا اتَّبَعُوا الْحَقَّ مِنْ رَبِّهِمْؕ كَذٰلِكَ یَضْرِبُ اللّٰهُ لِلنَّاسِ اَمْثَالَهُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31843,
            "SureId": 47,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "فَاِذَا لَقٖیتُمُ الَّذٖینَ كَفَرُوا فَضَرْبَ الرِّقَابِؕ حَتّٰٓى اِذَٓا اَثْخَنْتُمُوهُمْ فَشُدُّوا الْوَثَاقَۙ فَاِمَّا مَنًّا بَعْدُ وَاِمَّا فِدَٓاءً حَتّٰى تَضَعَ الْحَرْبُ اَوْزَارَهَاۚۛ ذٰلِكَؕۛ وَلَوْ یَشَٓاءُ اللّٰهُ لَانْتَصَرَ مِنْهُمْۙ وَلٰكِنْ لِیَبْلُوَ𐻾ا بَعْضَكُمْ بِبَعْضٍؕ وَالَّذٖینَ قُتِلُوا فٖی سَبٖیلِ اللّٰهِ فَلَنْ یُضِلَّ اَعْمَالَهُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31850,
            "SureId": 47,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "سَیَهْدٖیهِمْ وَیُصْلِحُ بَالَهُمْۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31857,
            "SureId": 47,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "وَیُدْخِلُهُمُ الْجَنَّةَ عَرَّفَهَا لَهُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31864,
            "SureId": 47,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "یَٓا اَیُّهَا الَّذٖینَ اٰمَنُٓوا اِنْ تَنْصُرُوا اللّٰهَ یَنْصُرْكُمْ وَیُثَبِّتْ اَقْدَامَكُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31871,
            "SureId": 47,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "وَالَّذٖینَ كَفَرُوا فَتَعْسًا لَهُمْ وَاَضَلَّ اَعْمَالَهُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31878,
            "SureId": 47,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "ذٰلِكَ بِاَنَّهُمْ كَرِهُوا مَٓا اَنْزَلَ اللّٰهُ فَاَحْبَطَ اَعْمَالَهُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31885,
            "SureId": 47,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "اَفَلَمْ یَسٖیرُوا فِی الْاَرْضِ فَیَنْظُرُوا كَیْفَ كَانَ عَاقِبَةُ الَّذٖینَ مِنْ قَبْلِهِمْؕ دَمَّرَ اللّٰهُ عَلَیْهِمْؗ وَلِلْكَافِرٖینَ اَمْثَالُهَا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31892,
            "SureId": 47,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "ذٰلِكَ بِاَنَّ اللّٰهَ مَوْلَى الَّذٖینَ اٰمَنُوا وَاَنَّ الْكَافِرٖینَ لَا مَوْلٰى لَهُمْࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 31820,
            "SureId": 47,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "İnkâr yolunu seçip Allah yoluna da engel koyanların yapıp ettiklerini O boşa çıkarmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 47,
                "MealInfo": "Medine döneminde inmiştir. 38 âyettir. <b>Sûre, adını Peygamber Efendimizin,ikinci âyette geçen adından almıştır.</b> Sûre, ayrıca yirminci âyette geçen <b>“elKıtâl</b>” kelimesinden dolayı<b> “Kıtâl sûresi</b>”, diye de anılmaktadır. Sûrede temel konu cihad olmak üzere başlıca, savaş, esirler, ganimetler ve münafıkların durumu konu edilmektedir.",
                "SureNameTurkish": "Muhammed",
                "SureNameArabic": "مُحَمَّدٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 95,
                "AyetCount": 38,
                "Cuz": 26,
                "FirstPage": 507,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 31827,
            "SureId": 47,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "İman edip din ve dünyaya yararlı işler yapanların, rablerinden gelmiş bir gerçek olarak Muhammed’e indirilene inananların ise günahlarını affetmiş ve durumlarını düzeltmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31834,
            "SureId": 47,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "Bunun da sebebi şudur ki, inkâr edenler boş şeylerin peşine düşmüşlerdir, iman edenlerse rablerinden gelen gerçeğe uymuşlardır. Allah insanlara kendilerinden örnekleri işte böyle vermektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31841,
            "SureId": 47,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "Kâfirlerle savaşa girdiğinizde hemen öldürücü darbeyi vurun, nihayet onları çökertince esirleri sağlam bağlayın. Sonra ya karşılıksız bırakırsınız yahut bedel alarak. Ki böylece savaş ağır yüklerini indirsin (sona ersin). İşte böyle; Allah dileseydi onları bizzat cezalandırırdı, fakat sizleri birbirinizle denemek istiyor. Allah, yolunda öldürülenlerin amellerini asla boşa çıkarmayacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31848,
            "SureId": 47,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "(Dünyada) onlara doğru yolu gösterecek, durumlarını düzeltecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31855,
            "SureId": 47,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "(Âhirette ise) kendilerine tanıttığı cennete sokacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31862,
            "SureId": 47,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "Ey iman edenler! Allah’a yardım ederseniz O da size yardım eder ve ayaklarınızı sağlam bastırır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31869,
            "SureId": 47,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "İnkâr edenlere gelince onların sonu felâkettir, amellerini de Allah boşa çıkarmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31876,
            "SureId": 47,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "Bu onların, Allah’ın indirdiğinden nefret etmeleri sebebiyledir. Allah da onların yaptıklarını sonuçsuz kılmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31883,
            "SureId": 47,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "Yeryüzünde dolaşıp da kendilerinden öncekilerin sonlarının nasıl olduğunu görmediler mi? Allah onların köklerini kazıdı, bu kâfirleri de benzer sonuçlar beklemektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31890,
            "SureId": 47,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 507,
            "AyetText": "Bu, iman edenlerin yar ve yardımcılarının Allah olmasının, kâfirlerin ise böyle bir yardımcılarının bulunmamasının sonucudur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Muhammed",
    "QuranSureLabel": "مُحَمَّدٍ",
    "EndPageSure": null
}