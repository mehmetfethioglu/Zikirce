    "QuranAyats": [
        {
            "Id": 5586,
            "SureId": 6,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "وَلَوْ جَعَلْنَاهُ مَلَكًا لَجَعَلْنَاهُ رَجُلًا وَلَلَبَسْنَا عَلَیْهِمْ مَا یَلْبِسُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 6,
                "MealInfo": "Mekke döneminde inmiştir. Kuvvetli görüşe göre, 91, 92, 93, 151, 152 ve 153. âyetler Medine’de inmiştir. 165 âyettir. Adını, 136, 138 ve 139. âyetlerde yer alan <b>“el-En’âm</b>” kelimesinden almıştır. <b>En’âm, koyun, keçi, deve ve sığır cinsi ehli hayvanları ifade eden bir kelimedir.</b> Sûrede başlıca <b>tevhide, adalete, peygamberliğe, ahirete dair meseleler ile küfrün ve batıl inançların reddi ve bazı temel ahlâk kuralları </b>konu edilmektedir.",
                "SureNameTurkish": "En'âm",
                "SureNameArabic": "الْاَنْعَامِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 55,
                "AyetCount": 165,
                "Cuz": 7,
                "FirstPage": 128,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 5593,
            "SureId": 6,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "وَلَقَدِ اسْتُهْزِئَ بِرُسُلٍ مِنْ قَبْلِكَ فَحَاقَ بِالَّذٖینَ سَخِرُوا مِنْهُمْ مَا كَانُوا بِهٖ یَسْتَهْزِؤُ𐻿نَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5600,
            "SureId": 6,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "قُلْ سٖیرُوا فِی الْاَرْضِ ثُمَّ انْظُرُوا كَیْفَ كَانَ عَاقِبَةُ الْمُكَذِّبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5607,
            "SureId": 6,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "قُلْ لِمَنْ مَا فِی السَّمٰوَاتِ وَالْاَرْضِؕ قُلْ لِلّٰهِؕ كَتَبَ عَلٰى نَفْسِهِ الرَّحْمَةَؕ لَیَجْمَعَنَّكُمْ اِلٰى یَوْمِ الْقِیٰمَةِ لَا رَیْبَ فٖیهِؕ اَلَّذٖینَ خَسِرُٓوا اَنْفُسَهُمْ فَهُمْ لَا یُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5614,
            "SureId": 6,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "وَلَهُ مَا سَكَنَ فِی الَّیْلِ وَالنَّهَارِؕ وَهُوَ السَّمٖیعُ الْعَلٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5621,
            "SureId": 6,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "قُلْ اَغَیْرَ اللّٰهِ اَتَّخِذُ وَلِیًّا فَاطِرِ السَّمٰوَاتِ وَالْاَرْضِ وَهُوَ یُطْعِمُ وَلَا یُطْعَمُؕ قُلْ اِنّٖٓی اُمِرْتُ اَنْ اَكُونَ اَوَّلَ مَنْ اَسْلَمَ وَلَا تَكُونَنَّ مِنَ الْمُشْرِكٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5628,
            "SureId": 6,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "قُلْ اِنّٖٓی اَخَافُ اِنْ عَصَیْتُ رَبّٖی عَذَابَ یَوْمٍ عَظٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5635,
            "SureId": 6,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "مَنْ یُصْرَفْ عَنْهُ یَوْمَئِذٍ فَقَدْ رَحِمَهُؕ وَذٰلِكَ الْفَوْزُ الْمُبٖینُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5642,
            "SureId": 6,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "وَاِنْ یَمْسَسْكَ اللّٰهُ بِضُرٍّ فَلَا كَاشِفَ لَهُٓ اِلَّا هُوَؕ وَاِنْ یَمْسَسْكَ بِخَیْرٍ فَهُوَ عَلٰى كُلِّ شَیْءٍ قَدٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5649,
            "SureId": 6,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "وَهُوَ الْقَاهِرُ فَوْقَ عِبَادِهٖؕ وَهُوَ الْحَكٖیمُ الْخَبٖیرُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 5584,
            "SureId": 6,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "Şayet peygamberi bir melek kılsaydık muhakkak ki onu (yine) bir adam suretine sokar, onları yine halen içinde bulundukları kuşkuya düşürürdük.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 6,
                "MealInfo": "Mekke döneminde inmiştir. Kuvvetli görüşe göre, 91, 92, 93, 151, 152 ve 153. âyetler Medine’de inmiştir. 165 âyettir. Adını, 136, 138 ve 139. âyetlerde yer alan <b>“el-En’âm</b>” kelimesinden almıştır. <b>En’âm, koyun, keçi, deve ve sığır cinsi ehli hayvanları ifade eden bir kelimedir.</b> Sûrede başlıca <b>tevhide, adalete, peygamberliğe, ahirete dair meseleler ile küfrün ve batıl inançların reddi ve bazı temel ahlâk kuralları </b>konu edilmektedir.",
                "SureNameTurkish": "En'âm",
                "SureNameArabic": "الْاَنْعَامِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 55,
                "AyetCount": 165,
                "Cuz": 7,
                "FirstPage": 128,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 5591,
            "SureId": 6,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "Senden önceki peygamberlerle de alay edilmiş, sonunda onlarla alay edenleri, alaya aldıkları şey (azap) kuşatıvermişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5598,
            "SureId": 6,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "De ki: Yeryüzünde dolaşın, sonra (hakikati) yalan sayanların sonunun nasıl olduğuna bakın!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5605,
            "SureId": 6,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "“Göklerde ve yerde olanlar kimindir?” diye sor. De ki: “Allah’ındır. O, kendi üzerine rahmeti yazmıştır. Sizi, gerçekleşmesinde asla şüphe olmayan kıyamet gününde mutlaka toplayacaktır.” Kendilerini ziyan edenler var ya, işte onlar inanmazlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5612,
            "SureId": 6,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "Gece ve gündüzde barınan her şey O’nundur. O, her şeyi işitmekte, bilmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5619,
            "SureId": 6,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "De ki: “Gökleri ve yeri yoktan var eden, yediren ama yedirilmeye ihtiyacı olmayan Allah’tan başkasını mı dost edineceğim?” De ki: “Bana Müslüman olanların ilki olmam emredildi ve sakın müşriklerden olma (denildi).”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5626,
            "SureId": 6,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "De ki: “Ben rabbime isyan edersem gerçekten büyük günün (âhiret) azabına uğrayacağımdan korkarım.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5633,
            "SureId": 6,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "O gün kim azaptan kurtarılırsa gerçekten Allah onu esirgemiştir. İşte apaçık kurtuluş budur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5640,
            "SureId": 6,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "Eğer Allah seni bir zarara uğratırsa onu kendisinden başka giderecek yoktur; ve eğer sana bir hayır verirse bilesin ki O her şeye kādirdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 5647,
            "SureId": 6,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 129,
            "AyetText": "O, kullarının üstünde tam bir tasarrufa sahiptir. O hakîmdir, her şeyden haberdardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
