    "QuranAyats": [
        {
            "Id": 8239,
            "SureId": 8,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "فَلَمْ تَقْتُلُوهُمْ وَلٰكِنَّ اللّٰهَ قَتَلَهُمْࣕ وَمَا رَمَیْتَ اِذْ رَمَیْتَ وَلٰكِنَّ اللّٰهَ رَمٰىۚ وَلِیُبْلِیَ الْمُؤْمِنٖینَ مِنْهُ بَلَٓاءً حَسَنًاؕ اِنَّ اللّٰهَ سَمٖیعٌ عَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 8,
                "MealInfo": "Medine döneminde hicretin ikinci yılında Bedir savaşından sonra inmiştir.75 âyettir. Sûre, adını ilk ayetteki <b>“el-Enfâl”</b> kelimesinden almıştır. <b>“Enfâl”, <i>savaş ganimetleri</i> demektir. </b>Sûrede başlıca, <b>savaş, özellikle Bedir savaşı sonrası elde edilen ganimetlerle, bunların kimlere ve nasıl pay edileceği </b>konu edilmektedir.",
                "SureNameTurkish": "Enfâl",
                "SureNameArabic": "الْاَنْفَالِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 88,
                "AyetCount": 75,
                "Cuz": 9,
                "FirstPage": 177,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 8246,
            "SureId": 8,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "ذٰلِكُمْ وَاَنَّ اللّٰهَ مُوهِنُ كَیْدِ الْكَافِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8253,
            "SureId": 8,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "اِنْ تَسْتَفْتِحُوا فَقَدْ جَٓاءَكُمُ الْفَتْحُۚ وَاِنْ تَنْتَهُوا فَهُوَ خَیْرٌ لَكُمْۚ وَاِنْ تَعُودُوا نَعُدْۚ وَلَنْ تُغْنِیَ عَنْكُمْ فِئَتُكُمْ شَیْـًٔا وَلَوْ كَثُرَتْۙ وَاَنَّ اللّٰهَ مَعَ الْمُؤْمِنٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8260,
            "SureId": 8,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "یَٓا اَیُّهَا الَّذٖینَ اٰمَنُٓوا اَطٖیعُوا اللّٰهَ وَرَسُولَهُ وَلَا تَوَلَّوْا عَنْهُ وَاَنْتُمْ تَسْمَعُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8267,
            "SureId": 8,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "وَلَا تَكُونُوا كَالَّذٖینَ قَالُوا سَمِعْنَا وَهُمْ لَا یَسْمَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8274,
            "SureId": 8,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "اِنَّ شَرَّ الدَّوَٓابِّ عِنْدَ اللّٰهِ الصُّمُّ الْبُكْمُ الَّذٖینَ لَا یَعْقِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8281,
            "SureId": 8,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "وَلَوْ عَلِمَ اللّٰهُ فٖیهِمْ خَیْرًا لَاَسْمَعَهُمْؕ وَلَوْ اَسْمَعَهُمْ لَتَوَلَّوْا وَهُمْ مُعْرِضُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8288,
            "SureId": 8,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "یَٓا اَیُّهَا الَّذٖینَ اٰمَنُوا اسْتَجٖیبُوا لِلّٰهِ وَلِلرَّسُولِ اِذَا دَعَاكُمْ لِمَا یُحْیٖیكُمْۚ وَاعْلَمُٓوا اَنَّ اللّٰهَ یَحُولُ بَیْنَ الْمَرْءِ وَقَلْبِهٖ وَاَنَّهُٓ اِلَیْهِ تُحْشَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8295,
            "SureId": 8,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "وَاتَّقُوا فِتْنَةً لَا تُصٖیبَنَّ الَّذٖینَ ظَلَمُوا مِنْكُمْ خَٓاصَّةًۚ وَاعْلَمُٓوا اَنَّ اللّٰهَ شَدٖیدُ الْعِقَابِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 8237,
            "SureId": 8,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "Savaşta onları siz öldürmediniz, onları Allah öldürdü; (oku) attığında da sen atmadın, Allah attı; bunu da müminlere kendinden güzel bir lütufta bulunmuş olmak için yaptı. Allah her şeyi işitmekte, her şeyi bilmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 8,
                "MealInfo": "Medine döneminde hicretin ikinci yılında Bedir savaşından sonra inmiştir.75 âyettir. Sûre, adını ilk ayetteki <b>“el-Enfâl”</b> kelimesinden almıştır. <b>“Enfâl”, <i>savaş ganimetleri</i> demektir. </b>Sûrede başlıca, <b>savaş, özellikle Bedir savaşı sonrası elde edilen ganimetlerle, bunların kimlere ve nasıl pay edileceği </b>konu edilmektedir.",
                "SureNameTurkish": "Enfâl",
                "SureNameArabic": "الْاَنْفَالِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 88,
                "AyetCount": 75,
                "Cuz": 9,
                "FirstPage": 177,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 8244,
            "SureId": 8,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "İşte size lutfu! Allah inkâr edenlerin tuzaklarını hep bozmaktadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8251,
            "SureId": 8,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "Siz (ey putperestler), eğer zafer peşinde iseniz kazandığınız zaferi gördünüz! Son verirseniz bu sizin için en iyi olanıdır, tekrarlarsanız biz de tekrarlarız. Topluluğunuz çok da olsa amacınıza ulaşmanıza yetmeyecektir; zira Allah müminlerle beraberdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8258,
            "SureId": 8,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "Ey iman edenler! Allah ve resulüne itaat edin, söylediklerini işittiğiniz halde ondan yüz çevirmeyin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8265,
            "SureId": 8,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "Duymadıkları halde “duyduk” diyenler gibi de olmayın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8272,
            "SureId": 8,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "Allah katında canlıların en aşağı derecede olanları, sağır, dilsiz ve düşünemez olanlarıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8279,
            "SureId": 8,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "Allah onlarda (inkârcılarda) bir hayır görseydi elbette kendilerine işittirirdi, eğer işittirseydi yine reddederek yüz çevirirlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8286,
            "SureId": 8,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "Ey iman edenler! Sizi hayat verecek şeylere çağırdıklarında Allah ve resulünün çağrısına uyun ve şüphesiz bilin ki, Allah kişi ile kalbinin arasına girer. Unutmayın ki, O’nun huzuruna götürüleceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8293,
            "SureId": 8,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 179,
            "AyetText": "Sadece içinizden zulmedenlere dokunmakla kalmayacak olan fitneden sakının ve bilin ki Allah’ın cezası şiddetlidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
