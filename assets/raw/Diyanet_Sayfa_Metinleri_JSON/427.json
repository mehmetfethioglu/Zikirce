{
    "PointerList": null,
    "CuzNo": 22,
    "PageNo": 427,
    "ArCuzNo": "۲۲",
    "ArPageNo": "٤۲۷",
    "QuranAyats": [
        {
            "Id": 25172,
            "SureId": 33,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "یَسْـَٔلُكَ النَّاسُ عَنِ السَّاعَةِؕ قُلْ اِنَّمَا عِلْمُهَا عِنْدَ اللّٰهِؕ وَمَا یُدْرٖیكَ لَعَلَّ السَّاعَةَ تَكُونُ قَرٖیبًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 33,
                "MealInfo": "Medine döneminde inmiştir. 73 âyettir. Sûre, adını 20 ve 22. âyetlerde geçen&nbsp;<b>“el-Ahzâb”</b> kelimesinden almıştır. <b>Ahzâb, gruplar, demektir</b>. Sûrede başlıca H<b>endek ve Benî Kureyza savaşları ile aile hayatına dair bazı hükümler </b>konu edilmektedir.",
                "SureNameTurkish": "Ahzâb",
                "SureNameArabic": "الْاَحْزَابِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 90,
                "AyetCount": 73,
                "Cuz": 21,
                "FirstPage": 418,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 25179,
            "SureId": 33,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "اِنَّ اللّٰهَ لَعَنَ الْكَافِرٖینَ وَاَعَدَّ لَهُمْ سَعٖیرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25186,
            "SureId": 33,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "خَالِدٖینَ فٖیهَٓا اَبَدًاۚ لَا یَجِدُونَ وَلِیًّا وَلَا نَصٖیرًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25193,
            "SureId": 33,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "یَوْمَ تُقَلَّبُ وُجُوهُهُمْ فِی النَّارِ یَقُولُونَ یَا لَیْتَنَٓا اَطَعْنَا اللّٰهَ وَاَطَعْنَا الرَّسُولَا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25200,
            "SureId": 33,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "وَقَالُوا رَبَّنَٓا اِنَّٓا اَطَعْنَا سَادَتَنَا وَكُـبَرَٓاءَنَا فَاَضَلُّونَا السَّبٖیلَا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25207,
            "SureId": 33,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "رَبَّنَٓا اٰتِهِمْ ضِعْفَیْنِ مِنَ الْعَذَابِ وَالْعَنْهُمْ لَعْنًا كَبٖیرًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25214,
            "SureId": 33,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "یَٓا اَیُّهَا الَّذٖینَ اٰمَنُوا لَا تَكُونُوا كَالَّذٖینَ اٰذَوْا مُوسٰى فَبَرَّاَهُ اللّٰهُ مِمَّا قَالُواؕ وَكَانَ عِنْدَ اللّٰهِ وَجٖیهًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25221,
            "SureId": 33,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "یَٓا اَیُّهَا الَّذٖینَ اٰمَنُوا اتَّقُوا اللّٰهَ وَقُولُوا قَوْلًا سَدٖیدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25228,
            "SureId": 33,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "یُصْلِحْ لَكُمْ اَعْمَالَكُمْ وَیَغْفِرْ لَكُمْ ذُنُوبَكُمْؕ وَمَنْ یُطِـعِ اللّٰهَ وَرَسُولَهُ فَقَدْ فَازَ فَوْزًا عَظٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25235,
            "SureId": 33,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "اِنَّا عَرَضْنَا الْاَمَانَةَ عَلَى السَّمٰوَاتِ وَالْاَرْضِ وَالْجِبَالِ فَاَبَیْنَ اَنْ یَحْمِلْنَهَا وَاَشْفَقْنَ مِنْهَا وَحَمَلَهَا الْاِنْسَانُؕ اِنَّهُ كَانَ ظَلُومًا جَهُولًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25242,
            "SureId": 33,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "لِیُعَذِّبَ اللّٰهُ الْمُنَافِقٖینَ وَالْمُنَافِقَاتِ وَالْمُشْرِكٖینَ وَالْمُشْرِكَاتِ وَیَتُوبَ اللّٰهُ عَلَى الْمُؤْمِنٖینَ وَالْمُؤْمِنَاتِؕ وَكَانَ اللّٰهُ غَفُورًا رَحٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 25170,
            "SureId": 33,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "İnsanlar senden kıyametin ne zaman kopacağını soruyorlar. “Bunun bilgisi yalnızca Allah katındadır” de. Nereden bileceksin, belki de kıyamet yakında olacak.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 33,
                "MealInfo": "Medine döneminde inmiştir. 73 âyettir. Sûre, adını 20 ve 22. âyetlerde geçen&nbsp;<b>“el-Ahzâb”</b> kelimesinden almıştır. <b>Ahzâb, gruplar, demektir</b>. Sûrede başlıca H<b>endek ve Benî Kureyza savaşları ile aile hayatına dair bazı hükümler </b>konu edilmektedir.",
                "SureNameTurkish": "Ahzâb",
                "SureNameArabic": "الْاَحْزَابِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 90,
                "AyetCount": 73,
                "Cuz": 21,
                "FirstPage": 418,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 25177,
            "SureId": 33,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "Allah inkârcıları lânetlemiş, onlara çok yakıcı bir ateş hazırlamıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25184,
            "SureId": 33,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "Orada hiçbir koruyucu ve yardımcı bulamadan ebedî olarak kalacaklardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25191,
            "SureId": 33,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "Yüzleri ateşe çevrildiği gün, “Keşke Allah’a itaat etseydik, resulü dinleseydik” diyecekler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25198,
            "SureId": 33,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "Ve ekleyecekler: “Rabbimiz! Biz efendilerimizi ve büyüklerimizi dinledik, onlar da bizi yoldan saptırdılar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25205,
            "SureId": 33,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "Rabbimiz! Onlara iki kat azap ver ve onları ağır bir şekilde lânetle!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25212,
            "SureId": 33,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "Ey iman edenler! Mûsâ’yı incitenler gibi olmayın. Allah onun, hakkında söylediklerinden uzak, tertemiz biri olduğunu ortaya koymuştu. Gerçekten o, Allah katında itibarlı idi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25219,
            "SureId": 33,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70-71",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "Ey iman edenler! Allah’a itaatsizlikten sakının ve doğru söz söyleyin ki, Allah sizin işlerinizi düzeltsin, günahlarınızı bağışlasın. Kim Allah’a ve resulüne itaat ederse gerçekten büyük bir kazanç elde eder.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25226,
            "SureId": 33,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": false,
            "Page": 427,
            "AyetText": "Ey iman edenler! Allah’a itaatsizlikten sakının ve doğru söz söyleyin ki, Allah sizin işlerinizi düzeltsin, günahlarınızı bağışlasın. Kim Allah’a ve resulüne itaat ederse gerçekten büyük bir kazanç elde eder.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25233,
            "SureId": 33,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "Biz emaneti göklere, yerküreye ve dağlara teklif ettik, ama onlar bunu yüklenmek istemediler, ondan korktular ve onu insan yüklendi. Kuşkusuz insan çok zalim, çok bilgisizdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 25240,
            "SureId": 33,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73",
            "AyetVisible": true,
            "Page": 427,
            "AyetText": "Böyle yaptı ki Allah, münafık erkekleri ve münafık kadınları, müşrik erkekleri ve müşrik kadınları cezalandırsın, mümin erkeklerin ve mümin kadınların da tövbelerini kabul buyursun. Allah çok bağışlayıcı, ziyadesiyle esirgeyicidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Ahzâb",
    "QuranSureLabel": "الْاَحْزَابِ",
    "EndPageSure": null
}