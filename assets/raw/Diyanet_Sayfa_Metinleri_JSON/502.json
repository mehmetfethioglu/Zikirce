    "QuranAyats": [
        {
            "Id": 31542,
            "SureId": 45,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "وَبَدَا لَهُمْ سَیِّــَٔاتُ مَا عَمِلُوا وَحَاقَ بِهِمْ مَا كَانُوا بِهٖ یَسْتَهْزِؤُ𐻿نَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 45,
                "MealInfo": "Mekke döneminde inmiştir. 37 âyettir. Sûre, adını 28. âyette geçen <b>“Câsiye</b>” kelimesinden almıştır. <b>Câsiye, diz üstü çöken demektir</b>. Sûrede başlıca, <b>Kur’an’ın indirilmesi, dış âlemde Allah’ın varlığını ve birliğini gösteren deliller, Allah’ın kullarına bahşettiği nimetler, İsrailoğullarının kendilerine verilen nimetlere inkâr ve isyanla karşılık vermeleri</b> konu edilmektedir.",
                "SureNameTurkish": "Câsiye",
                "SureNameArabic": "الْجَاثِيَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 65,
                "AyetCount": 37,
                "Cuz": 25,
                "FirstPage": 499,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 31549,
            "SureId": 45,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "وَقٖیلَ الْیَوْمَ نَنْسٰیكُمْ كَمَا نَسٖیتُمْ لِقَٓاءَ یَوْمِكُمْ هٰذَا وَمَاْوٰیكُمُ النَّارُ وَمَا لَكُمْ مِنْ نَاصِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31556,
            "SureId": 45,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "ذٰلِكُمْ بِاَنَّكُمُ اتَّخَذْتُمْ اٰیَاتِ اللّٰهِ هُزُوًا وَغَرَّتْكُمُ الْحَیٰوةُ الدُّنْیَاۚ فَالْیَوْمَ لَا یُخْرَجُونَ مِنْهَا وَلَا هُمْ یُسْتَعْتَبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31563,
            "SureId": 45,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "فَلِلّٰهِ الْحَمْدُ رَبِّ السَّمٰوَاتِ وَرَبِّ الْاَرْضِ رَبِّ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31570,
            "SureId": 45,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "وَلَهُ الْكِبْرِیَٓاءُ فِی السَّمٰوَاتِ وَالْاَرْضِࣕ وَهُوَ الْعَزٖیزُ الْحَكٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31577,
            "SureId": 46,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "حٰمٓ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 46,
                "MealInfo": "Mekke döneminde inmiştir. 35 âyettir. Sûre, adını 21. âyette geçen <b>“Ahkâf ” </b>kelimesinden almıştır. <b>Ahkâf, sûrede sözü edilen “Âd” kavminin yaşadığı Yemen’de bir bölgenin adı olup, uzun ve kıvrımlı kum yığınları demekt</b>ir. Konusu itibariyle bir önceki sûrenin devamı niteliğindedir.",
                "SureNameTurkish": "Ahkâf",
                "SureNameArabic": "الْاَحْقَافِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 66,
                "AyetCount": 35,
                "Cuz": 26,
                "FirstPage": 502,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 31584,
            "SureId": 46,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "تَنْزٖیلُ الْكِتَابِ مِنَ اللّٰهِ الْعَزٖیزِ الْحَكٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31591,
            "SureId": 46,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "مَا خَلَقْنَا السَّمٰوَاتِ وَالْاَرْضَ وَمَا بَیْنَهُمَٓا اِلَّا بِالْحَقِّ وَاَجَلٍ مُسَمًّىؕ وَالَّذٖینَ كَفَرُوا عَمَّٓا اُنْذِرُوا مُعْرِضُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31598,
            "SureId": 46,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "قُلْ اَرَاَیْتُمْ مَا تَدْعُونَ مِنْ دُونِ اللّٰهِ اَرُونٖی مَاذَا خَلَقُوا مِنَ الْاَرْضِ اَمْ لَهُمْ شِرْكٌ فِی السَّمٰوَاتِؕ اٖیتُونٖی بِكِتَابٍ مِنْ قَبْلِ هٰذَٓا اَوْ اَثَارَةٍ مِنْ عِلْمٍ اِنْ كُنْتُمْ صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31605,
            "SureId": 46,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "وَمَنْ اَضَلُّ مِمَّنْ یَدْعُوا مِنْ دُونِ اللّٰهِ مَنْ لَا یَسْتَجٖیبُ لَهُٓ اِلٰى یَوْمِ الْقِیٰمَةِ وَهُمْ عَنْ دُعَٓائِهِمْ غَافِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 31540,
            "SureId": 45,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "(İlâhî vaad gerçekleşince) yaptıklarının ne kadar kötü şeyler olduğunu açıkça gördüler, alaya aldıkları gerçek onları kuşatıverdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 45,
                "MealInfo": "Mekke döneminde inmiştir. 37 âyettir. Sûre, adını 28. âyette geçen <b>“Câsiye</b>” kelimesinden almıştır. <b>Câsiye, diz üstü çöken demektir</b>. Sûrede başlıca, <b>Kur’an’ın indirilmesi, dış âlemde Allah’ın varlığını ve birliğini gösteren deliller, Allah’ın kullarına bahşettiği nimetler, İsrailoğullarının kendilerine verilen nimetlere inkâr ve isyanla karşılık vermeleri</b> konu edilmektedir.",
                "SureNameTurkish": "Câsiye",
                "SureNameArabic": "الْجَاثِيَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 65,
                "AyetCount": 37,
                "Cuz": 25,
                "FirstPage": 499,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 31547,
            "SureId": 45,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "Kendilerine şöyle denildi: “Siz bu günle yüzyüze geleceğinizi nasıl unuttunuzsa bugün de biz sizi unutuyoruz. Meskeniniz ateştir, size yardım edecek kimseler de yoktur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31554,
            "SureId": 45,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "Bu azap, âyetlerimizi alay konusu yapmış olmanız ve dünya hayatının sizi aldatmış olması yüzündendir.” O gün artık oradan çıkarılmazlar, mazeretleri de kabul edilmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31561,
            "SureId": 45,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "Göklerin rabbi, yerin rabbi, bütün âlemlerin rabbi olan Allah’a, yalnız O’na hamdolsun!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31568,
            "SureId": 45,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "Göklerde ve yerde ululuk O’na aittir. O sonsuz güç, sınırsız hikmet sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31575,
            "SureId": 46,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "Hâ-mîm.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 46,
                "MealInfo": "Mekke döneminde inmiştir. 35 âyettir. Sûre, adını 21. âyette geçen <b>“Ahkâf ” </b>kelimesinden almıştır. <b>Ahkâf, sûrede sözü edilen “Âd” kavminin yaşadığı Yemen’de bir bölgenin adı olup, uzun ve kıvrımlı kum yığınları demekt</b>ir. Konusu itibariyle bir önceki sûrenin devamı niteliğindedir.",
                "SureNameTurkish": "Ahkâf",
                "SureNameArabic": "الْاَحْقَافِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 66,
                "AyetCount": 35,
                "Cuz": 26,
                "FirstPage": 502,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 31582,
            "SureId": 46,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "Kitabın indirilmesi, izzet ve hikmet sahibi Allah’tandır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31589,
            "SureId": 46,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "Gökleri, yeri ve ikisi arasındakileri şüphesiz yerli yerince ve belli bir süre için yarattık. Ama inkâr edenler kendilerine karşı yapılan uyarıdan yüz çevirmektedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31596,
            "SureId": 46,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "Onlara şöyle de: “Allah’ı bırakıp da kendilerinden medet umduğunuz tanrıları bir düşündünüz mü? Yerden hangi parçayı yarattılar bana gösterin? Yoksa göklerde onların ortaklığı mı var? Eğer iddianız gerçek ise bana, bundan önce inmiş bir kitap veya bir bilgi kalıntısı getirin.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31603,
            "SureId": 46,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 502,
            "AyetText": "Allah’ı bırakıp da -yakarmasından habersiz olduğundan- kıyamete kadar kendisine cevap veremeyecek olan şeylere ibadet ve dua eden kimseden daha şaşkın kim vardır?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
