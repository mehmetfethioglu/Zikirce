            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "صٓ وَالْقُرْاٰنِ ذِی الذِّكْرِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 38,
                "MealInfo": "Mekke döneminde inmiştir. 88 âyettir. Sûre, adını birinci âyetteki <b>“Sâd”</b> harfinden almıştır. Sûrede başlıca, <b>Allah’ın birliği, müşriklerin inkârları ve sapıklıkları sebebiyle azabı hak etmiş oldukları, Davûd, Süleyman, Eyyüp, İbrahim, İshak, İsmail, el-Yesa’ ve Zülkifl Peygamberlerin kıssaları, Davûd Peygamberin hakemliği ve Hz. Peygamberin temel görevi konu </b>edilmektedir.",
                "SureNameTurkish": "Sâd",
                "SureNameArabic": "صۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 38,
                "AyetCount": 88,
                "Cuz": 23,
                "FirstPage": 453,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 27804,
            "SureId": 38,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "بَلِ الَّذٖینَ كَفَرُوا فٖی عِزَّةٍ وَشِقَاقٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27811,
            "SureId": 38,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "كَمْ اَهْلَكْنَا مِنْ قَبْلِهِمْ مِنْ قَرْنٍ فَنَادَوْا وَلَاتَ حٖینَ مَنَاصٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27818,
            "SureId": 38,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "وَعَجِبُٓوا اَنْ جَٓاءَهُمْ مُنْذِرٌ مِنْهُمْؗ وَقَالَ الْكَافِرُونَ هٰذَا سَاحِرٌ كَذَّابٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27825,
            "SureId": 38,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "اَجَعَلَ الْاٰلِهَةَ اِلٰهًا وَاحِدًاۚ اِنَّ هٰذَا لَشَیْءٌ عُجَابٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27832,
            "SureId": 38,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "وَانْطَلَقَ الْمَلَاُ مِنْهُمْ اَنِ امْشُوا وَاصْبِرُوا عَلٰٓى اٰلِهَتِكُمْۚ اِنَّ هٰذَا لَشَیْءٌ یُرَادُۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27839,
            "SureId": 38,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "مَا سَمِعْنَا بِهٰذَا فِی الْمِلَّةِ الْاٰخِرَةِۚ اِنْ هٰذَٓا اِلَّا اخْتِلَاقٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27846,
            "SureId": 38,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "ءَاُنْزِلَ عَلَیْهِ الذِّكْرُ مِنْ بَیْنِنَاؕ بَلْ هُمْ فٖی شَكٍّ مِنْ ذِكْرٖیۚ بَلْ لَمَّا یَذُوقُوا عَذَابِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27853,
            "SureId": 38,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "اَمْ عِنْدَهُمْ خَزَٓائِنُ رَحْمَةِ رَبِّكَ الْعَزٖیزِ الْوَهَّابِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27860,
            "SureId": 38,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "اَمْ لَهُمْ مُلْكُ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَیْنَهُمَاࣞ فَلْیَرْتَقُوا فِی الْاَسْبَابِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27867,
            "SureId": 38,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "جُنْدٌ مَا هُنَالِكَ مَهْزُومٌ مِنَ الْاَحْزَابِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27874,
            "SureId": 38,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَعَادٌ وَفِرْعَوْنُ ذُوالْاَوْتَادِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27881,
            "SureId": 38,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "وَثَمُودُ وَقَوْمُ لُوطٍ وَاَصْحَابُ لْــَٔیْكَةِؕ اُو𐻾لٰٓئِكَ الْاَحْزَابُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27888,
            "SureId": 38,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "اِنْ كُلٌّ اِلَّا كَذَّبَ الرُّسُلَ فَحَقَّ عِقَابِࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27895,
            "SureId": 38,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "وَمَا یَنْظُرُ هٰٓؤُ𐻾لَٓاءِ اِلَّا صَیْحَةً وَاحِدَةً مَا لَهَا مِنْ فَوَاقٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27902,
            "SureId": 38,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "وَقَالُوا رَبَّنَا عَجِّلْ لَنَا قِطَّنَا قَبْلَ یَوْمِ الْحِسَابِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 27795,
            "SureId": 38,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1-2",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "Sâd. Öğüt ve uyarı dolu Kur’an’a andolsun ki inkâr edenler, bu uyarıya kulak verecekleri yerde, gurura kapılmış ve ayrılığa düşmüşlerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 38,
                "MealInfo": "Mekke döneminde inmiştir. 88 âyettir. Sûre, adını birinci âyetteki <b>“Sâd”</b> harfinden almıştır. Sûrede başlıca, <b>Allah’ın birliği, müşriklerin inkârları ve sapıklıkları sebebiyle azabı hak etmiş oldukları, Davûd, Süleyman, Eyyüp, İbrahim, İshak, İsmail, el-Yesa’ ve Zülkifl Peygamberlerin kıssaları, Davûd Peygamberin hakemliği ve Hz. Peygamberin temel görevi konu </b>edilmektedir.",
                "SureNameTurkish": "Sâd",
                "SureNameArabic": "صۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 38,
                "AyetCount": 88,
                "Cuz": 23,
                "FirstPage": 453,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 27802,
            "SureId": 38,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": false,
            "Page": 453,
            "AyetText": "Sâd. Öğüt ve uyarı dolu Kur’an’a andolsun ki inkâr edenler, bu uyarıya kulak verecekleri yerde, gurura kapılmış ve muhalefete düşmüşlerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27809,
            "SureId": 38,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "Onlardan önce nice nesilleri helâk ettik; o sırada feryat ettiler ama artık zaman kurtulma zamanı değildi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27816,
            "SureId": 38,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "Şimdi bunlar da kendilerine aralarından bir uyarıcı gelmesine şaşıyorlar ve bu inkârcılar şöyle diyorlar: “Bu adam bir sihirbazdır, tam bir yalancıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27823,
            "SureId": 38,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "Tanrıları tek tanrıya mı indiriyor? Bu gerçekten şaşılacak bir şey!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27830,
            "SureId": 38,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "Onların ileri gelenleri harekete geçip şöyle dediler: “Yolunuzda yürüyün! Tanrılarınıza bağlılıkta direnin! İşte (sizden) istenen budur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27837,
            "SureId": 38,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "Bildiğimiz son dinde böyle bir şeyi işitmedik; bu uydurmadan başka bir şey değil.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27844,
            "SureId": 38,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "İlâhî uyarı içimizden ona mı indirildi şimdi!” İşin doğrusu onlar benim uyarım karşısında kuşku içindedirler. Hayır, azabımı henüz tatmadılar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27851,
            "SureId": 38,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "Yoksa senin aziz ve lutufkâr rabbinin rahmet hazineleri onların elinde midir?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27858,
            "SureId": 38,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "Ya da göklerle yerin ve ikisi arasında bulunanların hükümranlığı onlarda mı? Öyleyse çareler bulup göklere yükselseler ya!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27865,
            "SureId": 38,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "Onlar, orada çeşitli bölüklerden oluşmuş, bu durumda şimdiden yenilmeye mahkûm bir kalabalıktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27872,
            "SureId": 38,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12-13",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "Bunlardan önce Nûh kavmi, Âd kavmi, kazıklı Firavun, Semûd kavmi, Lût kavmi ve Eyke halkı, bütün bu topluluklar ısrarla gerçeği yalanlamışlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27879,
            "SureId": 38,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": false,
            "Page": 453,
            "AyetText": "Bunlardan önce Nûh kavmi, Âd kavmi, kazıklı Firavun, Semûd kavmi, Lût kavmi ve Eyke halkı, bütün bu topluluklar ısrarla gerçeği yalanlamışlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27886,
            "SureId": 38,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "Hepsi de elçileri yalancılıkla suçladılar, bu yüzden de kendilerini cezalandırmam hak oldu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27893,
            "SureId": 38,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "Bunlar da şimdi, bir daha geri dönüşe imkân bırakmayacak olan korkunç bir sesi, yalnızca bunu beklemektedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27900,
            "SureId": 38,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 453,
            "AyetText": "Onlar, (alaycı bir tavırla), “Rabbimiz! Hesap gününden önce payımıza düşen azabı hemen şimdi ver!” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Sâd",
    "QuranSureLabel": "صۤ",
    "EndPageSure": null
}