    "QuranAyats": [
        {
            "Id": 18837,
            "SureId": 23,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "وَاَنْزَلْنَا مِنَ السَّمَٓاءِ مَٓاءً بِقَدَرٍ فَاَسْكَنَّاهُ فِی الْاَرْضِࣗ وَاِنَّا عَلٰى ذَهَابٍ بِهٖ لَقَادِرُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18844,
            "SureId": 23,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "فَاَنْشَاْنَا لَكُمْ بِهٖ جَنَّاتٍ مِنْ نَخٖیلٍ وَاَعْنَابٍۘ لَكُمْ فٖیهَا فَوَاكِهُ𐻾 كَثٖیرَةٌ وَمِنْهَا تَاْكُلُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18851,
            "SureId": 23,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "وَشَجَرَةً تَخْرُجُ مِنْ طُورِ سَیْنَٓاءَ تَنْبُتُ بِالدُّهْنِ وَصِبْغٍ لِلْاٰكِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18858,
            "SureId": 23,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "وَاِنَّ لَكُمْ فِی الْاَنْعَامِ لَعِبْرَةًؕ نُسْقٖیكُمْ مِمَّا فٖی بُطُونِهَا وَلَكُمْ فٖیهَا مَنَافِعُ كَثٖیرَةٌ وَمِنْهَا تَاْكُلُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18865,
            "SureId": 23,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "وَعَلَیْهَا وَعَلَى الْفُلْكِ تُحْمَلُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18872,
            "SureId": 23,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "وَلَقَدْ اَرْسَلْنَا نُوحًا اِلٰى قَوْمِهٖ فَقَالَ یَا قَوْمِ اعْبُدُوا اللّٰهَ مَا لَكُمْ مِنْ اِلٰهٍ غَیْرُهُؕ اَفَلَا تَتَّقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18879,
            "SureId": 23,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "فَقَالَ الْمَلَؤُا الَّذٖینَ كَفَرُوا مِنْ قَوْمِهٖ مَا هٰذَٓا اِلَّا بَشَرٌ مِثْلُكُمْۙ یُرٖیدُ اَنْ یَتَفَضَّلَ عَلَیْكُمْؕ وَلَوْ شَٓاءَ اللّٰهُ لَاَنْزَلَ مَلٰٓئِكَةًۚ مَا سَمِعْنَا بِهٰذَا فٖٓی اٰبَٓائِنَا الْاَوَّلٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18886,
            "SureId": 23,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "اِنْ هُوَ اِلَّا رَجُلٌ بِهٖ جِنَّةٌ فَتَرَبَّصُوا بِهٖ حَتّٰى حٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18893,
            "SureId": 23,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "قَالَ رَبِّ انْصُرْنٖی بِمَا كَذَّبُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18900,
            "SureId": 23,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "فَاَوْحَیْنَٓا اِلَیْهِ اَنِ اصْنَعِ الْفُلْكَ بِاَعْیُنِنَا وَوَحْیِنَا فَاِذَا جَٓاءَ اَمْرُنَا وَفَارَ التَّنُّورُۙ فَاسْلُكْ فٖیهَا مِنْ كُلٍّ زَوْجَیْنِ اثْنَیْنِ وَاَهْلَكَ اِلَّا مَنْ سَبَقَ عَلَیْهِ الْقَوْلُ مِنْهُمْۚ وَلَا تُخَاطِبْنٖی فِی الَّذٖینَ ظَلَمُواۚ اِنَّهُمْ مُغْرَقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 18835,
            "SureId": 23,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "Gökten uygun ölçüde su indirir, onu arzda tutarız. Kuşkusuz bizim onu gidermeye de gücümüz yeter.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18842,
            "SureId": 23,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19-20",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "O su sayesinde sizin için, çok sayıda meyvelerin bulunduğu, yiyip beslendiğiniz hurma bahçeleri, üzüm bağları; kezâ Sînâ dağında yetişen, hem yağ hem de yiyenlerin ekmeğine katık veren bir ağaç (zeytin ağacı) meydana getiririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18849,
            "SureId": 23,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": false,
            "Page": 343,
            "AyetText": "O su sayesinde sizin için, çok sayıda meyvelerin bulunduğu, yiyip beslendiğiniz hurma bahçeleri, üzüm bağları; kezâ Sînâ dağında yetişen, hem yağ hem de yiyenlerin ekmeğine katık veren bir ağaç (zeytin ağacı) meydana getiririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18856,
            "SureId": 23,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "Sizin için hayvanlarda da alınacak ders vardır. Size onların karınlarında oluşan nesneden içiriyoruz; onlardan sağladığınız başka birçok fayda da var, onlardan yiyecek sağlıyorsunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18863,
            "SureId": 23,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "Onların üzerinde ve gemilerde taşınıyorsunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18870,
            "SureId": 23,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "Andolsun ki Nûh’u da kavmine gönderdik de, “Ey kavmim!” dedi, “Allah’a kulluk edin; sizin O’ndan başka bir tanrınız yoktur. İsyan etmekten sakınmıyor musunuz?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18877,
            "SureId": 23,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "Kavminin inkâra sapmış ileri gelenleri dediler ki: “Bu adam, size üstünlük kurmak isteyen, sadece sizin gibi sıradan bir insandır. Eğer Allah (elçi göndermek) isteseydi herhalde bir melek gönderirdi. Biz geçmiş atalarımızdan böyle bir şey duymadık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18884,
            "SureId": 23,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "Bu adam olsa olsa cin çarpmış biridir; bir süre onu gözetim altında tutun.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18891,
            "SureId": 23,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "Nûh, “Rabbim! Bunların beni yalancılıkla suçlamalarına karşı bana yardım et!” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18898,
            "SureId": 23,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 343,
            "AyetText": "Bunun üzerine ona şöyle vahyettik: “Bizim gözetimimiz altında ve bildirdiğimiz şekilde gemiyi yap. Buyruğumuz geldiğinde sular coşup yükselmeye başlayınca her cinsten birer çift hayvan ile kendileri aleyhinde hüküm kesinleşmiş olanların dışındaki aileni gemiye al; ama o haksızlığa sapmış olanlar konusunda sakın bana bir şey söyleme! Onlar kesinlikle boğulacaklar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
