{
    "PointerList": null,
    "CuzNo": 18,
    "PageNo": 349,
    "ArCuzNo": "۱۸",
    "ArPageNo": "۳٤۹",
    "QuranAyats": [
        {
            "Id": 19446,
            "SureId": 23,
            "AyetId": 105,
            "LanguageId": 7,
            "AyetNumber": "١٠٥",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "اَلَمْ تَكُنْ اٰیَاتٖی تُتْلٰى عَلَیْكُمْ فَكُنْتُمْ بِهَا تُكَذِّبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19453,
            "SureId": 23,
            "AyetId": 106,
            "LanguageId": 7,
            "AyetNumber": "١٠٦",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "قَالُوا رَبَّنَا غَلَبَتْ عَلَیْنَا شِقْوَتُنَا وَكُنَّا قَوْمًا ضَٓالّٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19460,
            "SureId": 23,
            "AyetId": 107,
            "LanguageId": 7,
            "AyetNumber": "١٠٧",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "رَبَّنَٓا اَخْرِجْنَا مِنْهَا فَاِنْ عُدْنَا فَاِنَّا ظَالِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19467,
            "SureId": 23,
            "AyetId": 108,
            "LanguageId": 7,
            "AyetNumber": "١٠٨",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "قَالَ اخْسَؤُ𐻿ا فٖیهَا وَلَا تُكَلِّمُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19474,
            "SureId": 23,
            "AyetId": 109,
            "LanguageId": 7,
            "AyetNumber": "١٠٩",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "اِنَّهُ كَانَ فَرٖیقٌ مِنْ عِبَادٖی یَقُولُونَ رَبَّنَٓا اٰمَنَّا فَاغْفِرْ لَنَا وَارْحَمْنَا وَاَنْتَ خَیْرُ الرَّاحِمٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19481,
            "SureId": 23,
            "AyetId": 110,
            "LanguageId": 7,
            "AyetNumber": "١١٠",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "فَاتَّخَذْتُمُوهُمْ سِخْرِیًّا حَتّٰٓى اَنْسَوْكُمْ ذِكْرٖی وَكُنْتُمْ مِنْهُمْ تَضْحَكُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19488,
            "SureId": 23,
            "AyetId": 111,
            "LanguageId": 7,
            "AyetNumber": "١١١",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "اِنّٖی جَزَیْتُهُمُ الْیَوْمَ بِمَا صَبَرُٓواۙ اَنَّهُمْ هُمُ الْفَٓائِزُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19495,
            "SureId": 23,
            "AyetId": 112,
            "LanguageId": 7,
            "AyetNumber": "١١٢",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "قَالَ كَمْ لَبِثْتُمْ فِی الْاَرْضِ عَدَدَ سِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19502,
            "SureId": 23,
            "AyetId": 113,
            "LanguageId": 7,
            "AyetNumber": "١١٣",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "قَالُوا لَبِثْنَا یَوْمًا اَوْ بَعْضَ یَوْمٍ فَسْـَٔلِ الْعَٓادّٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19509,
            "SureId": 23,
            "AyetId": 114,
            "LanguageId": 7,
            "AyetNumber": "١١٤",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "قَالَ اِنْ لَبِثْتُمْ اِلَّا قَلٖیلًا لَوْ اَنَّكُمْ كُنْتُمْ تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19516,
            "SureId": 23,
            "AyetId": 115,
            "LanguageId": 7,
            "AyetNumber": "١١٥",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "اَفَحَسِبْتُمْ اَنَّمَا خَلَقْنَاكُمْ عَبَثًا وَاَنَّكُمْ اِلَیْنَا لَا تُرْجَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19523,
            "SureId": 23,
            "AyetId": 116,
            "LanguageId": 7,
            "AyetNumber": "١١٦",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "فَتَعَالَى اللّٰهُ الْمَلِكُ الْحَقُّۚ لَٓا اِلٰهَ اِلَّا هُوَۚ رَبُّ الْعَرْشِ الْكَرٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19530,
            "SureId": 23,
            "AyetId": 117,
            "LanguageId": 7,
            "AyetNumber": "١١٧",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "وَمَنْ یَدْعُ مَعَ اللّٰهِ اِلٰهًا اٰخَرَۙ لَا بُرْهَانَ لَهُ بِهٖۙ فَاِنَّمَا حِسَابُهُ عِنْدَ رَبِّهٖؕ اِنَّهُ لَا یُفْلِحُ الْكَافِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19537,
            "SureId": 23,
            "AyetId": 118,
            "LanguageId": 7,
            "AyetNumber": "١١٨",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "وَقُلْ رَبِّ اغْفِرْ وَارْحَمْ وَاَنْتَ خَیْرُ الرَّاحِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 19444,
            "SureId": 23,
            "AyetId": 105,
            "LanguageId": 5,
            "AyetNumber": "105",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "Size âyetlerim okunurdu da onları yalanlardınız değil mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 19451,
            "SureId": 23,
            "AyetId": 106,
            "LanguageId": 5,
            "AyetNumber": "106",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "Derler ki: “Rabbimiz! Kötü yanımıza yenildik; biz bir sapkınlar topluluğu olduk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19458,
            "SureId": 23,
            "AyetId": 107,
            "LanguageId": 5,
            "AyetNumber": "107",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "Rabbimiz! Bizi buradan çıkar; eğer (çıkar da) bir daha eskiye dönersek, artık belli ki biz zalim insanlarız.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19465,
            "SureId": 23,
            "AyetId": 108,
            "LanguageId": 5,
            "AyetNumber": "108",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "Allah buyurur ki: “Yıkılın karşımdan! Ve artık bana bir şey söylemeyin!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19472,
            "SureId": 23,
            "AyetId": 109,
            "LanguageId": 5,
            "AyetNumber": "109",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "“Kullarım arasında, ‘Rabbimiz! Biz iman ettik; bizi affet, bize acı! Sen merhametlilerin en üstünüsün’ diyen bir kesim de şüphesiz vardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19479,
            "SureId": 23,
            "AyetId": 110,
            "LanguageId": 5,
            "AyetNumber": "110",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "Ama siz (ey müşrikler), işte onları alaya aldınız; sonunda bu tutumunuz size beni hatırlamayı unutturdu. Hep gülerdiniz onlara.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19486,
            "SureId": 23,
            "AyetId": 111,
            "LanguageId": 5,
            "AyetNumber": "111",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "“Bugün de ben onlara sabretmelerinin karşılığını veriyorum. Onlar hakikaten muratlarına ermişlerdir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19493,
            "SureId": 23,
            "AyetId": 112,
            "LanguageId": 5,
            "AyetNumber": "112",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "Allah, “Yeryüzünde kaç yıl kaldınız?” diye sorar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19500,
            "SureId": 23,
            "AyetId": 113,
            "LanguageId": 5,
            "AyetNumber": "113",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "“Bir gün veya günün bir bölümü kadar kaldık; işte, saymakla görevli olanlara sor” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19507,
            "SureId": 23,
            "AyetId": 114,
            "LanguageId": 5,
            "AyetNumber": "114",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "Allah buyurur: “Pek kısa bir süre kaldınız; keşke bunu (dünyada iken) bilmiş olsaydınız!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19514,
            "SureId": 23,
            "AyetId": 115,
            "LanguageId": 5,
            "AyetNumber": "115",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "Sizi sırf boş yere yarattığımızı ve sizin artık huzurumuza geri getirilmeyeceğinizi mi sandınız?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19521,
            "SureId": 23,
            "AyetId": 116,
            "LanguageId": 5,
            "AyetNumber": "116",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "Gerçek egemenliğin sahibi olan Allah yüceler yücesidir. O’ndan başka tanrı yoktur. O, şerefli arşın sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19528,
            "SureId": 23,
            "AyetId": 117,
            "LanguageId": 5,
            "AyetNumber": "117",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "Her kim Allah ile birlikte başka bir tanrıya taparsa -ki bu hususta hiçbir kanıtı olamaz- muhakkak surette o kişinin hesabı rabbinin katında görülecektir. Şu bir gerçektir ki inkârcılar iflah olmayacak!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 19535,
            "SureId": 23,
            "AyetId": 118,
            "LanguageId": 5,
            "AyetNumber": "118",
            "AyetVisible": true,
            "Page": 349,
            "AyetText": "(Resulüm!) De ki: “Bağışla ve acı rabbim! Sen merhametlilerin üstünüsün.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
