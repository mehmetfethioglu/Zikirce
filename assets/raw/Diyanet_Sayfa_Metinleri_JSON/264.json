    "QuranAyats": [
        {
            "Id": 12838,
            "SureId": 15,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "قَالَ یَٓا اِبْلٖیسُ مَا لَكَ اَلَّا تَكُونَ مَعَ السَّاجِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 15,
                "MealInfo": "Mekke döneminde inmiştir. 99 âyettir. Sûre, adını 80. âyette geçen <b>“Hicr” </b>kelimesinden almıştır. Hicr, Medine’nin kuzeyinde vaktiyle Semûd kavminin yaşadığı bir yerin adıdır. Sûre de başlıca Allah’ın birliği, peygamberlik, öldükten sonra dirilme ve hesap konuları; peygamberlerin, çeşitli zamanlarda azgınlara ve inkârcılara karşı verdikleri mücadeleler çerçevesinde ele alınmaktadır. Bu sûre de ayrıca ilâhî kitapların kendisiyle kemale erdiği Kur’an’ın, her türlü tahriften korunacağı hükmü de yer almaktadır.",
                "SureNameTurkish": "Hicr",
                "SureNameArabic": "الْحِجْرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 54,
                "AyetCount": 99,
                "Cuz": 14,
                "FirstPage": 262,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12845,
            "SureId": 15,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "قَالَ لَمْ اَكُنْ لِاَسْجُدَ لِبَشَرٍ خَلَقْتَهُ مِنْ صَلْصَالٍ مِنْ حَمَاٍ مَسْنُونٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12852,
            "SureId": 15,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "قَالَ فَاخْرُجْ مِنْهَا فَاِنَّكَ رَجٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12859,
            "SureId": 15,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "وَاِنَّ عَلَیْكَ اللَّعْنَةَ اِلٰى یَوْمِ الدّٖینِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12866,
            "SureId": 15,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "قَالَ رَبِّ فَاَنْظِرْنٖٓی اِلٰى یَوْمِ یُبْعَثُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12873,
            "SureId": 15,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "قَالَ فَاِنَّكَ مِنَ الْمُنْظَرٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12880,
            "SureId": 15,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "اِلٰى یَوْمِ الْوَقْتِ الْمَعْلُومِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12887,
            "SureId": 15,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "قَالَ رَبِّ بِمَٓا اَغْوَیْتَنٖی لَاُزَیِّنَنَّ لَهُمْ فِی الْاَرْضِ وَلَاُغْوِیَنَّهُمْ اَجْمَعٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12894,
            "SureId": 15,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "اِلَّا عِبَادَكَ مِنْهُمُ الْمُخْلَصٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12901,
            "SureId": 15,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "قَالَ هٰذَا صِرَاطٌ عَلَیَّ مُسْتَقٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12908,
            "SureId": 15,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "اِنَّ عِبَادٖی لَیْسَ لَكَ عَلَیْهِمْ سُلْطَانٌ اِلَّا مَنِ اتَّبَعَكَ مِنَ الْغَاوٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12915,
            "SureId": 15,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "وَاِنَّ جَهَنَّمَ لَمَوْعِدُهُمْ اَجْمَعٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12922,
            "SureId": 15,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "لَهَا سَبْعَةُ اَبْوَابٍؕ لِكُلِّ بَابٍ مِنْهُمْ جُزْءٌ مَقْسُومٌࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12929,
            "SureId": 15,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "اِنَّ الْمُتَّقٖینَ فٖی جَنَّاتٍ وَعُیُونٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12936,
            "SureId": 15,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "اُدْخُلُوهَا بِسَلَامٍ اٰمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12943,
            "SureId": 15,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "وَنَزَعْنَا مَا فٖی صُدُورِهِمْ مِنْ غِلٍّ اِخْوَانًا عَلٰى سُرُرٍ مُتَقَابِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12950,
            "SureId": 15,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "لَا یَمَسُّهُمْ فٖیهَا نَصَبٌ وَمَا هُمْ مِنْهَا بِمُخْرَجٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12957,
            "SureId": 15,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "نَبِّئْ عِبَادٖٓی اَنّٖٓی اَنَا الْغَفُورُ الرَّحٖیمُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12964,
            "SureId": 15,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "وَاَنَّ عَذَابٖی هُوَ الْعَذَابُ الْاَلٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12971,
            "SureId": 15,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "وَنَبِّئْهُمْ عَنْ ضَیْفِ اِبْرٰهٖیمَۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 12836,
            "SureId": 15,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Allah, “Ey İblîs! Secde edenlerle birlikte hareket etmeyişinin sebebi nedir?” diye sordu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 15,
                "MealInfo": "Mekke döneminde inmiştir. 99 âyettir. Sûre, adını 80. âyette geçen <b>“Hicr” </b>kelimesinden almıştır. Hicr, Medine’nin kuzeyinde vaktiyle Semûd kavminin yaşadığı bir yerin adıdır. Sûre de başlıca Allah’ın birliği, peygamberlik, öldükten sonra dirilme ve hesap konuları; peygamberlerin, çeşitli zamanlarda azgınlara ve inkârcılara karşı verdikleri mücadeleler çerçevesinde ele alınmaktadır. Bu sûre de ayrıca ilâhî kitapların kendisiyle kemale erdiği Kur’an’ın, her türlü tahriften korunacağı hükmü de yer almaktadır.",
                "SureNameTurkish": "Hicr",
                "SureNameArabic": "الْحِجْرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 54,
                "AyetCount": 99,
                "Cuz": 14,
                "FirstPage": 262,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12843,
            "SureId": 15,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Dedi ki: “Ben, şekillenebilir özlü balçıktan, (şekil verilip) kurutulmuş çamurdan yarattığın bir insana asla secde etmem!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12850,
            "SureId": 15,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Allah, “O halde çık oradan, dedi; artık kovuldun!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12857,
            "SureId": 15,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Kıyamet gününe kadar lânetlenmiş bulunmaktasın!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12864,
            "SureId": 15,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "“Rabbim! Öyleyse insanların yeniden diriltileceği güne kadar bana mühlet ver” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12871,
            "SureId": 15,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37-38",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Allah, “Vakti (katımızda) bilinen bir güne kadar mühlet verilmiş olanlardansın” buyurdu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12878,
            "SureId": 15,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": false,
            "Page": 264,
            "AyetText": "Allah, \"Vakti (katımızda) bilinen bir güne kadar mühlet verilmiş olanlardansın\" buyurdu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12885,
            "SureId": 15,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39-40",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "İblîs, “Rabbim! Benim sapmama imkân verdiğin için yemin olsun ki ben de yeryüzünde onlara (günahları) şirin göstereceğim ve -aralarından senin samimi kulların hariç- onların topunu kesinlikle yoldan çıkaracağım.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12892,
            "SureId": 15,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": false,
            "Page": 264,
            "AyetText": "İblîs, \"Rabbim! Benim sapmama imkân verdiğin için yemin olsun ki ben de yeryüzünde onlara (günahları) şirin göstereceğim ve -aralarından senin samimi kulların hariç- onların topunu kesinlikle yoldan çıkaracağım.\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12899,
            "SureId": 15,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Allah da buyurdu ki: “İşte bana varan doğru yol budur (hâlis kulların yolu).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12906,
            "SureId": 15,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Şüphesiz, sapmışlardan sana uyacak isyankârlar dışında kullarım üzerinde senin hâkimiyetin olmayacaktır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12913,
            "SureId": 15,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "“Kuşkusuz cehennem, o sana uyanların tamamının buluşma yeri olacaktır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12920,
            "SureId": 15,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Onun yedi kapısı vardır, her kapıdan girmek üzere de onlardan birer grup belirlenmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12927,
            "SureId": 15,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Allah’a karşı saygısızlıktan sakınanlar mutlaka cennet bahçelerinde ve pınar başlarında olacaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12934,
            "SureId": 15,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "“Esenlikle, güvenle girin oraya!” (denecek).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12941,
            "SureId": 15,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Onların gönüllerini düşmanlık duygularından temizledik; artık bir kardeşler topluluğu olarak sedirler üzerinde karşı karşıya oturacaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12948,
            "SureId": 15,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Orada hiçbir yorgunlukla karşılaşmayacaklar. Oradan çıkarılmaları da söz konusu olmayacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12955,
            "SureId": 15,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Kullarıma benim gerçekten çok bağışlayıcı, çok esirgeyici olduğumu bildir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12962,
            "SureId": 15,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Ama azabım da çok elem verici bir azaptır!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12969,
            "SureId": 15,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 264,
            "AyetText": "Onlara İbrâhim’in misafirlerini hatırlat.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
