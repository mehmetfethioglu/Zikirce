{
    "PointerList": null,
    "CuzNo": 16,
    "PageNo": 310,
    "ArCuzNo": "۱٦",
    "ArPageNo": "۳۱۰",
    "QuranAyats": [
        {
            "Id": 16205,
            "SureId": 19,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "رَبُّ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَیْنَهُمَا فَاعْبُدْهُ وَاصْطَبِرْ لِعِبَادَتِهٖؕ هَلْ تَعْلَمُ لَهُ سَمِیًّاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16212,
            "SureId": 19,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "وَیَقُولُ الْاِنْسَانُ ءَاِذَا مَا مِتُّ لَسَوْفَ اُخْرَجُ حَیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16219,
            "SureId": 19,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "اَوَلَا یَذْكُرُ الْاِنْسَانُ اَنَّا خَلَقْنَاهُ مِنْ قَبْلُ وَلَمْ یَكُ شَیْـًٔا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16226,
            "SureId": 19,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "فَوَرَبِّكَ لَنَحْشُرَنَّهُمْ وَالشَّیَاطٖینَ ثُمَّ لَنُحْضِرَنَّهُمْ حَوْلَ جَهَنَّمَ جِثِیًّاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16233,
            "SureId": 19,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "ثُمَّ لَنَنْزِعَنَّ مِنْ كُلِّ شٖیعَةٍ اَیُّهُمْ اَشَدُّ عَلَى الرَّحْمٰنِ عِتِیًّاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16240,
            "SureId": 19,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "ثُمَّ لَنَحْنُ اَعْلَمُ بِالَّذٖینَ هُمْ اَوْلٰى بِهَا صِلِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16247,
            "SureId": 19,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "وَاِنْ مِنْكُمْ اِلَّا وَارِدُهَاۚ كَانَ عَلٰى رَبِّكَ حَتْمًا مَقْضِیًّاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16254,
            "SureId": 19,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "ثُمَّ نُنَجِّی الَّذٖینَ اتَّقَوْا وَنَذَرُ الظَّالِمٖینَ فٖیهَا جِثِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16261,
            "SureId": 19,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "وَاِذَا تُتْلٰى عَلَیْهِمْ اٰیَاتُنَا بَیِّنَاتٍ قَالَ الَّذٖینَ كَفَرُوا لِلَّذٖینَ اٰمَنُٓواۙ اَیُّ الْفَرٖیقَیْنِ خَیْرٌ مَقَامًا وَاَحْسَنُ نَدِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16268,
            "SureId": 19,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "وَكَمْ اَهْلَكْنَا قَبْلَهُمْ مِنْ قَرْنٍ هُمْ اَحْسَنُ اَثَاثًا وَرِءْیًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16275,
            "SureId": 19,
            "AyetId": 75,
            "LanguageId": 7,
            "AyetNumber": "٧٥",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "قُلْ مَنْ كَانَ فِی الضَّلَالَةِ فَلْیَمْدُدْ لَهُ الرَّحْمٰنُ مَدًّاۚ حَتّٰٓى اِذَا رَاَوْا مَا یُوعَدُونَ اِمَّا الْعَذَابَ وَاِمَّا السَّاعَةَؕ فَسَیَعْلَمُونَ مَنْ هُوَ شَرٌّ مَكَانًا وَاَضْعَفُ جُنْدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16282,
            "SureId": 19,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "وَیَزٖیدُ اللّٰهُ الَّذٖینَ اهْتَدَوْا هُدًىؕ وَالْبَاقِیَاتُ الصَّالِحَاتُ خَیْرٌ عِنْدَ رَبِّكَ ثَوَابًا وَخَیْرٌ مَرَدًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 16203,
            "SureId": 19,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "O göklerin, yerin ve bu ikisi arasındakilerin rabbidir. Şu halde O’na sabır ve sebatla kulluk et. O’nun adını almaya lâyık başka birini biliyor musun?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16210,
            "SureId": 19,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "İnsan, “Ben öldükten bir süre sonra sahiden yeniden hayata döndürülecek miyim?” diyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16217,
            "SureId": 19,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "İnsan düşünmez mi ki, daha önce hiçbir şey değilken biz onu yaratmışızdır?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16224,
            "SureId": 19,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "Rabbine andolsun ki onları muhakkak şeytanlarla birlikte mahşerde toplayacağız; sonra onları cehennemin çevresinde diz üstü çökmüş vaziyette hazır tutacağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16231,
            "SureId": 19,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "Sonra her gruptan, Rahmân’a en çok âsi olanlar hangileri ise çekip çıkaracağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16238,
            "SureId": 19,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "Sonra ateşi boylamayı hak edenleri elbette en iyi biz biliriz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16245,
            "SureId": 19,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "İçinizden, oraya varmayacak hiçbir kimse yoktur. Bu, rabbinin kesinleşmiş bir hükmüdür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16252,
            "SureId": 19,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "Sonra biz kötülükten sakınanları (cehennemden) esirgeriz; zalimleri de diz üstü çökmüş olarak orada bırakırız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16259,
            "SureId": 19,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "Kendilerine âyetlerimiz açıkça okunduğu zaman inkâr edenler iman edenlere, “İki topluluktan hangimizin konumu daha üstün ve mensupları daha iyi?” diye sorarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16266,
            "SureId": 19,
            "AyetId": 74,
            "LanguageId": 5,
            "AyetNumber": "74",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "Oysa onlardan önce de daha varlıklı ve daha gösterişli olan nice nesiller helâk ettik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16273,
            "SureId": 19,
            "AyetId": 75,
            "LanguageId": 5,
            "AyetNumber": "75",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "De ki: “Kim sapkınlık içinde ise dilerim Rahmân ona süre versin!” Sonunda kendilerine vaad olunanı; azabı veya kıyameti gördükleri zaman, konumu daha kötü, askeri daha zayıf olanın kim olduğunu öğreneceklerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16280,
            "SureId": 19,
            "AyetId": 76,
            "LanguageId": 5,
            "AyetNumber": "76",
            "AyetVisible": true,
            "Page": 310,
            "AyetText": "Allah, doğru yola gidenlerin hidayetini güçlendirir. Kalıcı olan iyilikler, rabbinin katında hem mükâfat bakımından daha hayırlı, hem de sonuç bakımından daha iyidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Meryem",
    "QuranSureLabel": "مَرْيَمَ",
    "EndPageSure": null
}