            "AyetNumber": "20",
            "AyetVisible": false,
            "Page": 526,
            "AyetText": "Gördünüz değil mi (âciz durumdaki) Lât’ı, Uzzâ’yı ve üçüncüsü olan diğerini, Menât’ı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33633,
            "SureId": 53,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "Erkek çocuklar size de kızlar O’na öyle mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33640,
            "SureId": 53,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "Ama o takdirde bu insafsızca bir taksim!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33647,
            "SureId": 53,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "Bunlar sizin ve atalarınızın putlara taktığı boş isimlerden ibarettir. Allah onlara öyle bir yetki ve güç vermemiştir. Onlar (putperestler) sadece kuruntularına ve kişisel arzularına uyuyorlar. Oysa şimdi onlara rablerinden bir yol gösterici gelmiş bulunmaktadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33654,
            "SureId": 53,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "İnsan arzu ettiği her şeye sahip olabilir mi ki?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33661,
            "SureId": 53,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "Âhiret de Allah’ındır, dünya da.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33668,
            "SureId": 53,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "Göklerde nice melekler vardır ki, Allah dilediği ve razı olduğu kulları için izin vermedikçe onların bile şefaati hiçbir fayda sağlamaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
