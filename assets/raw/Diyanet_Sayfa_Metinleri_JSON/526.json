                "FirstPage": 526,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33502,
            "SureId": 53,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33509,
            "SureId": 53,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "وَمَا یَنْطِقُ عَنِ الْهَوٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33516,
            "SureId": 53,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "اِنْ هُوَ اِلَّا وَحْیٌ یُوحٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33523,
            "SureId": 53,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "عَلَّمَهُ شَدٖیدُ الْقُوٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33530,
            "SureId": 53,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "ذُومِرَّةٍؕ فَاسْتَوٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33537,
            "SureId": 53,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "وَهُوَ بِالْاُفُقِ الْاَعْلٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33544,
            "SureId": 53,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "ثُمَّ دَنَا فَتَدَلّٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33551,
            "SureId": 53,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "فَكَانَ قَابَ قَوْسَیْنِ اَوْ اَدْنٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33558,
            "SureId": 53,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "فَاَوْحٰٓى اِلٰى عَبْدِهٖ مَٓا اَوْحٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33565,
            "SureId": 53,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "مَا كَذَبَ الْفُؤَادُ مَا رَاٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33572,
            "SureId": 53,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "اَفَتُمَارُونَهُ عَلٰى مَا یَرٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33579,
            "SureId": 53,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "وَلَقَدْ رَاٰهُ نَزْلَةً اُخْرٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33586,
            "SureId": 53,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "عِنْدَ سِدْرَةِ الْمُنْتَهٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33593,
            "SureId": 53,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "عِنْدَهَا جَنَّةُ الْمَاْوٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33600,
            "SureId": 53,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "اِذْ یَغْشَى السِّدْرَةَ مَا یَغْشٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33607,
            "SureId": 53,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "مَا زَاغَ الْبَصَرُ وَمَا طَغٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33614,
            "SureId": 53,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "لَقَدْ رَاٰى مِنْ اٰیَاتِ رَبِّهِ الْكُبْرٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33621,
            "SureId": 53,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "اَفَرَاَیْتُمُ اللَّاتَ وَالْعُزّٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33628,
            "SureId": 53,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "وَمَنٰوةَ الثَّالِثَةَ الْاُخْرٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33635,
            "SureId": 53,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "اَلَكُمُ الذَّكَرُ وَلَهُ الْاُنْثٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33642,
            "SureId": 53,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "تِلْكَ اِذًا قِسْمَةٌ ضٖیزٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33649,
            "SureId": 53,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "اِنْ هِیَ اِلَّٓا اَسْمَٓاءٌ سَمَّیْتُمُوهَٓا اَنْتُمْ وَاٰبَٓاؤُ𐻾كُمْ مَٓا اَنْزَلَ اللّٰهُ بِهَا مِنْ سُلْطَانٍؕ اِنْ یَتَّبِعُونَ اِلَّا الظَّنَّ وَمَا تَهْوَى الْاَنْفُسُۚ وَلَقَدْ جَٓاءَهُمْ مِنْ رَبِّهِمُ الْهُدٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33656,
            "SureId": 53,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "اَمْ لِلْاِنْسَانِ مَا تَمَنّٰىؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33663,
            "SureId": 53,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "فَلِلّٰهِ الْاٰخِرَةُ وَالْاُو𐻿لٰىࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33670,
            "SureId": 53,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 526,
            "AyetText": "وَكَمْ مِنْ مَلَكٍ فِی السَّمٰوَاتِ لَا تُغْنٖی شَفَاعَتُهُمْ شَیْـًٔا اِلَّا مِنْ بَعْدِ اَنْ یَاْذَنَ اللّٰهُ لِمَنْ یَشَٓاءُ وَیَرْضٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
