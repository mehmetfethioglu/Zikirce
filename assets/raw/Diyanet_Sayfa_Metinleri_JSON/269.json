{
    "PointerList": null,
    "CuzNo": 14,
    "PageNo": 269,
    "ArCuzNo": "۱٤",
    "ArPageNo": "۲٦۹",
    "QuranAyats": [
        {
            "Id": 13412,
            "SureId": 16,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "وَاَلْقٰى فِی الْاَرْضِ رَوَاسِیَ اَنْ تَمٖیدَ بِكُمْ وَاَنْهَارًا وَسُبُلًا لَعَلَّكُمْ تَهْتَدُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
                "Cuz": 14,
                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 13419,
            "SureId": 16,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "وَعَلَامَاتٍؕ وَبِالنَّجْمِ هُمْ یَهْتَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13426,
            "SureId": 16,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "اَفَمَنْ یَخْلُقُ كَمَنْ لَا یَخْلُقُؕ اَفَلَا تَذَكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13433,
            "SureId": 16,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "وَاِنْ تَعُدُّوا نِعْمَةَ اللّٰهِ لَا تُحْصُوهَاؕ اِنَّ اللّٰهَ لَغَفُورٌ رَحٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13440,
            "SureId": 16,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "وَاللّٰهُ یَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13447,
            "SureId": 16,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "وَالَّذٖینَ یَدْعُونَ مِنْ دُونِ اللّٰهِ لَا یَخْلُقُونَ شَیْـًٔا وَهُمْ یُخْلَقُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13454,
            "SureId": 16,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "اَمْوَاتٌ غَیْرُ اَحْیَٓاءٍۚ وَمَا یَشْعُرُونَۙ اَیَّانَ یُبْعَثُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13461,
            "SureId": 16,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "اِلٰهُكُمْ اِلٰهٌ وَاحِدٌۚ فَالَّذٖینَ لَا یُؤْمِنُونَ بِالْاٰخِرَةِ قُلُوبُهُمْ مُنْكِرَةٌ وَهُمْ مُسْتَكْبِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13468,
            "SureId": 16,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "لَا جَرَمَ اَنَّ اللّٰهَ یَعْلَمُ مَا یُسِرُّونَ وَمَا یُعْلِنُونَؕ اِنَّهُ لَا یُحِبُّ الْمُسْتَكْبِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13475,
            "SureId": 16,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "وَاِذَا قٖیلَ لَهُمْ مَاذَٓا اَنْزَلَ رَبُّكُمْۙ قَالُٓوا اَسَاطٖیرُ الْاَوَّلٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13482,
            "SureId": 16,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "لِیَحْمِلُٓوا اَوْزَارَهُمْ كَامِلَةً یَوْمَ الْقِیٰمَةِۙ وَمِنْ اَوْزَارِ الَّذٖینَ یُضِلُّونَهُمْ بِغَیْرِ عِلْمٍؕ اَلَا سَٓاءَ مَا یَزِرُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13489,
            "SureId": 16,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "قَدْ مَكَرَ الَّذٖینَ مِنْ قَبْلِهِمْ فَاَتَى اللّٰهُ بُنْیَانَهُمْ مِنَ الْقَوَاعِدِ فَخَرَّ عَلَیْهِمُ السَّقْفُ مِنْ فَوْقِهِمْ وَاَتٰیهُمُ الْعَذَابُ مِنْ حَیْثُ لَا یَشْعُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 13410,
            "SureId": 16,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "O, sizi sarsmaması için yere sağlam dağlar yerleştirdi, ırmaklar ve yollar açtı ki gideceğiniz yere ulaşabilesiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
                "Cuz": 14,
                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 13417,
            "SureId": 16,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "Daha nice işaretler koydu. Yıldızlarla da insanlar yollarını bulurlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13424,
            "SureId": 16,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "O halde yaratanla yaratamayan bir olur mu? Siz düşünmez misiniz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13431,
            "SureId": 16,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "Allah’ın nimetini saymaya kalksanız başa çıkamazsınız. Allah gerçekten bağışlayıcıdır, merhametlidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13438,
            "SureId": 16,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "Allah, gizlediğinizi de açığa vurduğunuzu da bilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13445,
            "SureId": 16,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "Onların, Allah’ın dışında taptıkları varlıklar hiçbir şey yaratamazlar, onların kendileri yaratılmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13452,
            "SureId": 16,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "Onlar canlı değil ölüdürler; insanların ne zaman diriltileceklerini bilmezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13459,
            "SureId": 16,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "Sizin tanrınız bir tek tanrıdır. Âhirete inanmayanlara gelince, işte onların kalpleri inkârcıdır; onlar ululuk taslayan küstahlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13466,
            "SureId": 16,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "Hiç kuşku yok ki Allah onların saklı tuttuklarını da açığa vurduklarını da bilmektedir. O, ululuk taslayanları sevmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13473,
            "SureId": 16,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "Onlara, “Rabbiniz ne indirdi?” diye sorulduğunda “Eskilerin masallarını!” diye cevap verirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13480,
            "SureId": 16,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "Sonuç olarak, kıyamet gününde kendi günahlarını eksiksiz yüklendikleri gibi bilgisizce saptırdıkları kimselerin günahlarından da yüklenmiş oldular. İşte görün, yüklendikleri şey ne kadar kötü!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13487,
            "SureId": 16,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 269,
            "AyetText": "Bunlardan öncekiler de tuzak kurmuşlar, ama Allah da onların evlerini temellerinden sökmüş, üstlerindeki tavan tepelerine inmiş, böylece hiç farkında olmadıkları bir yerden kendilerine ceza ansızın gelmişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Nahl",
    "QuranSureLabel": "النَّحْلِ",
    "EndPageSure": null
}