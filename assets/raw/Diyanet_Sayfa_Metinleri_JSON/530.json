{
    "PointerList": null,
    "CuzNo": 27,
    "PageNo": 530,
    "ArCuzNo": "۲۷",
    "ArPageNo": "٥۳۰",
    "QuranAyats": [
        {
            "Id": 34118,
            "SureId": 54,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "وَنَبِّئْهُمْ اَنَّ الْمَٓاءَ قِسْمَةٌ بَیْنَهُمْۚ كُلُّ شِرْبٍ مُحْتَضَرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 54,
                "MealInfo": "Mekke döneminde inmiştir. 55 âyettir. Sûre, adını ilk âyette geçen <b>“el-Kamer” </b>kelimesinden almıştır. <b>Kamer, ay demektir</b>. Sûre de ana fikir olarak, <b>Kur’an’ı yalanlayanlar, çeşitli azap ve helâk örnekleri</b> de verilerek uyarılmaktadır.",
                "SureNameTurkish": "Kamer",
                "SureNameArabic": "الْقَمَرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 37,
                "AyetCount": 55,
                "Cuz": 27,
                "FirstPage": 528,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 34125,
            "SureId": 54,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "فَنَادَوْا صَاحِبَهُمْ فَتَعَاطٰى فَعَقَرَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34132,
            "SureId": 54,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "فَكَیْفَ كَانَ عَذَابٖی وَنُذُرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34139,
            "SureId": 54,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "اِنَّٓا اَرْسَلْنَا عَلَیْهِمْ صَیْحَةً وَاحِدَةً فَكَانُوا كَـهَشٖیمِ الْمُحْتَظِرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34146,
            "SureId": 54,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "وَلَقَدْ یَسَّرْنَا الْقُرْاٰنَ لِلذِّكْرِ فَهَلْ مِنْ مُدَّكِرٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34153,
            "SureId": 54,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "كَذَّبَتْ قَوْمُ لُوطٍ بِالنُّذُرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34160,
            "SureId": 54,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "اِنَّٓا اَرْسَلْنَا عَلَیْهِمْ حَاصِبًا اِلَّٓا اٰلَ لُوطٍؕ نَجَّیْنَاهُمْ بِسَحَرٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34167,
            "SureId": 54,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "نِعْمَةً مِنْ عِنْدِنَاؕ كَذٰلِكَ نَجْزٖی مَنْ شَكَرَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34174,
            "SureId": 54,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "وَلَقَدْ اَنْذَرَهُمْ بَطْشَتَنَا فَتَمَارَوْا بِالنُّذُرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34181,
            "SureId": 54,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "وَلَقَدْ رَاوَدُوهُ عَنْ ضَیْفِهٖ فَطَمَسْنَٓا اَعْیُنَهُمْ فَذُوقُوا عَذَابٖی وَنُذُرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34188,
            "SureId": 54,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "وَلَقَدْ صَبَّحَهُمْ بُكْرَةً عَذَابٌ مُسْتَقِرٌّۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34195,
            "SureId": 54,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "فَذُوقُوا عَذَابٖی وَنُذُرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34202,
            "SureId": 54,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "وَلَقَدْ یَسَّرْنَا الْقُرْاٰنَ لِلذِّكْرِ فَهَلْ مِنْ مُدَّكِرٍࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34209,
            "SureId": 54,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "وَلَقَدْ جَٓاءَ اٰلَ فِرْعَوْنَ النُّذُرُۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34216,
            "SureId": 54,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "كَذَّبُوا بِاٰیَاتِنَا كُلِّهَا فَاَخَذْنَاهُمْ اَخْذَ عَزٖیزٍ مُقْتَدِرٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34223,
            "SureId": 54,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "اَكُفَّارُكُمْ خَیْرٌ مِنْ اُو𐻾لٰٓئِكُمْ اَمْ لَكُمْ بَرَٓاءَةٌ فِی الزُّبُرِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34230,
            "SureId": 54,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "اَمْ یَقُولُونَ نَحْنُ جَمٖیعٌ مُنْتَصِرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34237,
            "SureId": 54,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "سَیُهْزَمُ الْجَمْعُ وَیُوَلُّونَ الدُّبُرَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34244,
            "SureId": 54,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "بَلِ السَّاعَةُ مَوْعِدُهُمْ وَالسَّاعَةُ اَدْهٰى وَاَمَرُّ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34251,
            "SureId": 54,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "اِنَّ الْمُجْرِمٖینَ فٖی ضَلَالٍ وَسُعُرٍۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34258,
            "SureId": 54,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "یَوْمَ یُسْحَبُونَ فِی النَّارِ عَلٰى وُجُوهِهِمْؕ ذُوقُوا مَسَّ سَقَرَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34265,
            "SureId": 54,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "اِنَّا كُلَّ شَیْءٍ خَلَقْنَاهُ بِقَدَرٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 34116,
            "SureId": 54,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Bir de onlara, suyun aralarında paylaşımlı olacağını bildir. Her hissenin sahibi (suyun) başına gelsin.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 54,
                "MealInfo": "Mekke döneminde inmiştir. 55 âyettir. Sûre, adını ilk âyette geçen <b>“el-Kamer” </b>kelimesinden almıştır. <b>Kamer, ay demektir</b>. Sûre de ana fikir olarak, <b>Kur’an’ı yalanlayanlar, çeşitli azap ve helâk örnekleri</b> de verilerek uyarılmaktadır.",
                "SureNameTurkish": "Kamer",
                "SureNameArabic": "الْقَمَرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 37,
                "AyetCount": 55,
                "Cuz": 27,
                "FirstPage": 528,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 34123,
            "SureId": 54,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Derken ilgili adamlarını çağırdılar; o da (deveye) saldırıp hunharca öldürdü.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34130,
            "SureId": 54,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Azabım ve uyarılarım nasılmış bir bakın!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34137,
            "SureId": 54,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Üzerlerine tek bir ses yolladık da hayvan ağılındaki (çiğnenip ufalanmış) kuru çalılar gibi oluverdiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34144,
            "SureId": 54,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Andolsun ki Kur’an’ı düşünülsün diye kolaylaştırdık. Düşünecek yok mu?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34151,
            "SureId": 54,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Lût kavmi de uyarıları ciddiye almadı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34158,
            "SureId": 54,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34-35",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Biz de üzerlerine taş yağdıran bir kasırga gönderdik. Ancak Lût ailesi hariç tutuldu; onları katımızdan bir lutuf olarak seher vakti kurtardık. Şükredenleri işte böyle ödüllendiririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34165,
            "SureId": 54,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": false,
            "Page": 530,
            "AyetText": "Biz de üzerlerine taş yağdıran bir kasırga gönderdik. Ancak Lût ailesi hariç tutuldu; onları katımızdan bir lutuf olarak seher vakti kurtardık. Şükredenleri işte böyle ödüllendiririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34172,
            "SureId": 54,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Aslında Lût, kendilerini bizim amansız yakalayışımıza karşı uyarmıştı; ama onlar bu uyarıları şüpheyle karşıladılar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34179,
            "SureId": 54,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Üstelik onun misafirleriyle ilgili çirkin bir talepte bulundular. Biz de gözlerini silme kör ediverdik; tadın bakalım azabımı ve uyardığım sonuçları!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34186,
            "SureId": 54,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Ve nihayet bir sabah erkenden kalıcı bir azap onları yakalayıverdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34193,
            "SureId": 54,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Tadın bakalım azabımı ve uyardığım sonuçları!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34200,
            "SureId": 54,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Andolsun ki Kur’an’ı düşünülsün diye kolaylaştırdık. Düşünecek yok mu?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34207,
            "SureId": 54,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Şüphesiz Firavun’un halkına da uyarılar gelmişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34214,
            "SureId": 54,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Ama onlar bütün delillerimizi yalan saydılar, biz de onları üstün ve güçlü olana yaraşır biçimde kıskıvrak yakaladık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34221,
            "SureId": 54,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Şimdi söyleyin bakalım (ey putperestler), sizin inkârcılarınız şu anılanlardan daha mı iyi; yoksa sizin için kitaplarda bir kurtuluş hükmü mü var?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34228,
            "SureId": 54,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Yoksa onlar “Biz yenilmez bir topluluğuz” mu diyorlar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34235,
            "SureId": 54,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Yakında o topluluk da yenilecek ve arkalarını dönüp kaçacaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34242,
            "SureId": 54,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Ama asıl vadeleri kıyamet günüdür ve kıyamet günü şüphesiz daha dehşetli ve daha acıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34249,
            "SureId": 54,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "Şu bir gerçek ki günaha batmış olanlar, doğru yoldan sapmış ve kendilerini ­yakmışlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34256,
            "SureId": 54,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 530,
            "AyetText": "O gün yüzüstü ateşe sürüklenirler: “Tadın bakalım cehennemin dokunuşunu!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34263,
            "SureId": 54,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
