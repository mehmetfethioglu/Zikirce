    "QuranAyats": [
        {
            "Id": 24605,
            "SureId": 32,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "وَلَوْ تَرٰٓى اِذِ الْمُجْرِمُونَ نَاكِسُوا رُؤُ𐻿سِهِمْ عِنْدَ رَبِّهِمْؕ رَبَّنَٓا اَبْصَرْنَا وَسَمِعْنَا فَارْجِعْنَا نَعْمَلْ صَالِحًا اِنَّا مُوقِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 32,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. <b>Sûre, adını mü’minlerin Allah’a secde etmelerinden bahseden 15. âyetten almıştır</b>. Sûrede ayrıca Allah’ın kudretinden,ahiret gününden, kitaplardan, peygamberlerden ve insanın yaratılışından söz edilmektedir.",
                "SureNameTurkish": "Secde",
                "SureNameArabic": "السَّجْدَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 75,
                "AyetCount": 30,
                "Cuz": 21,
                "FirstPage": 415,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 24612,
            "SureId": 32,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "وَلَوْ شِئْنَا لَاٰتَیْنَا كُلَّ نَفْسٍ هُدٰیهَا وَلٰكِنْ حَقَّ الْقَوْلُ مِنّٖی لَاَمْلَــَٔنَّ جَهَنَّمَ مِنَ الْجِنَّةِ وَالنَّاسِ اَجْمَعٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24619,
            "SureId": 32,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "فَذُوقُوا بِمَا نَسٖیتُمْ لِقَٓاءَ یَوْمِكُمْ هٰذَاۚ اِنَّا نَسٖینَاكُمْ وَذُوقُوا عَذَابَ الْخُلْدِ بِمَا كُنْتُمْ تَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24626,
            "SureId": 32,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "اِنَّمَا یُؤْمِنُ بِاٰیَاتِنَا الَّذٖینَ اِذَا ذُكِّرُوا بِهَا خَرُّوا سُجَّدًا وَسَبَّحُوا بِحَمْدِ رَبِّهِمْ وَهُمْ لَا یَسْتَكْبِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24633,
            "SureId": 32,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "تَتَجَافٰى جُنُوبُهُمْ عَنِ الْمَضَاجِعِ یَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًاؗ وَمِمَّا رَزَقْنَاهُمْ یُنْفِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24640,
            "SureId": 32,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "فَلَا تَعْلَمُ نَفْسٌ مَٓا اُخْفِیَ لَهُمْ مِنْ قُرَّةِ اَعْیُنٍۚ جَزَٓاءً بِمَا كَانُوا یَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24647,
            "SureId": 32,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "اَفَمَنْ كَانَ مُؤْمِنًا كَمَنْ كَانَ فَاسِقًاؕ لَا یَسْتَوُ𐻿نَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24654,
            "SureId": 32,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "اَمَّا الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ جَنَّاتُ الْمَاْوٰىؗ نُزُلًا بِمَا كَانُوا یَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24661,
            "SureId": 32,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "وَاَمَّا الَّذٖینَ فَسَقُوا فَمَاْوٰیهُمُ النَّارُؕ كُلَّمَٓا اَرَادُٓوا اَنْ یَخْرُجُوا مِنْهَٓا اُعٖیدُوا فٖیهَا وَقٖیلَ لَهُمْ ذُوقُوا عَذَابَ النَّارِ الَّذٖی كُنْتُمْ بِهٖ تُكَذِّبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 24603,
            "SureId": 32,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "O günahkârları rablerinin huzurunda başlarını önlerine eğmiş halde şöyle derlerken bir görsen: “Rabbimiz! Gördük ve işittik; bizi geri gönder de rızâna uygun işler yapalım, artık kesin olarak inandık!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 32,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. <b>Sûre, adını mü’minlerin Allah’a secde etmelerinden bahseden 15. âyetten almıştır</b>. Sûrede ayrıca Allah’ın kudretinden,ahiret gününden, kitaplardan, peygamberlerden ve insanın yaratılışından söz edilmektedir.",
                "SureNameTurkish": "Secde",
                "SureNameArabic": "السَّجْدَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 75,
                "AyetCount": 30,
                "Cuz": 21,
                "FirstPage": 415,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 24610,
            "SureId": 32,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "Dileseydik elbette herkesin doğru yolda yürümesini sağlardık. Fakat şu sözüm mutlaka gerçekleşecek: Cehennemi hem cinlerden hem insanlardan bir kısmıyla dolduracağım!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24617,
            "SureId": 32,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "(Onlara denecek ki:) “Bu gününüzle karşılaşmayı unutmanız sebebiyle cezayı tadın bakalım! İşte şimdi biz de sizi unuttuk; haydi yaptıklarınızın bedeli olarak ebedî azabı tadın şimdi!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24624,
            "SureId": 32,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "Âyetlerimize yürekten inananlar ancak o kimselerdir ki, bunlarla kendilerine öğüt verildiğinde büyüklük taslamadan secdeye kapanırlar ve rablerini hamd ile tesbih ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24631,
            "SureId": 32,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "Korku ve ümit içinde rablerine ibadet ve dua etmek üzere vücutları yatak görmez, kendilerine verdiğimiz rızıktan da Allah için harcarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24638,
            "SureId": 32,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "Yaptıklarına karşılık olarak onlar için ne mutluluklar saklandığını hiç kimse ­bilemez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24645,
            "SureId": 32,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "İman etmiş kimse günaha batmış kimse gibi olur mu? Bunlar elbette eşit değildirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24652,
            "SureId": 32,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "İman edip dünya ve âhirete yararlı işler yapanlara, yapmış olduklarına karşılık, hazır olarak onları bekleyen, huzur içinde kalacakları cennetler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24659,
            "SureId": 32,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 416,
            "AyetText": "Günaha batanların varacakları yer ise ateştir. Oradan her çıkmak istediklerinde oraya geri çevrilirler ve kendilerine şöyle denir: “Asılsız saydığınız cehennem azabını tadın!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
