            "AyetVisible": true,
            "Page": 374,
            "AyetText": "كَذَّبَتْ قَوْمُ لُوطٍࣙ الْمُرْسَلٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 21651,
            "SureId": 26,
            "AyetId": 161,
            "LanguageId": 7,
            "AyetNumber": "١٦١",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "اِذْ قَالَ لَهُمْ اَخُوهُمْ لُوطٌ اَلَا تَتَّقُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21658,
            "SureId": 26,
            "AyetId": 162,
            "LanguageId": 7,
            "AyetNumber": "١٦٢",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "اِنّٖی لَكُمْ رَسُولٌ اَمٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21665,
            "SureId": 26,
            "AyetId": 163,
            "LanguageId": 7,
            "AyetNumber": "١٦٣",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "فَاتَّقُوا اللّٰهَ وَاَطٖیعُونِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21672,
            "SureId": 26,
            "AyetId": 164,
            "LanguageId": 7,
            "AyetNumber": "١٦٤",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "وَمَٓا اَسْـَٔلُكُمْ عَلَیْهِ مِنْ اَجْرٍۚ اِنْ اَجْرِیَ اِلَّا عَلٰى رَبِّ الْعَالَمٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21679,
            "SureId": 26,
            "AyetId": 165,
            "LanguageId": 7,
            "AyetNumber": "١٦٥",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "اَتَاْتُونَ الذُّكْرَانَ مِنَ الْعَالَمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21686,
            "SureId": 26,
            "AyetId": 166,
            "LanguageId": 7,
            "AyetNumber": "١٦٦",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "وَتَذَرُونَ مَا خَلَقَ لَكُمْ رَبُّكُمْ مِنْ اَزْوَاجِكُمْؕ بَلْ اَنْتُمْ قَوْمٌ عَادُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21693,
            "SureId": 26,
            "AyetId": 167,
            "LanguageId": 7,
            "AyetNumber": "١٦٧",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "قَالُوا لَئِنْ لَمْ تَنْتَهِ𐻾 یَا لُوطُ لَتَكُونَنَّ مِنَ الْمُخْرَجٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21700,
            "SureId": 26,
            "AyetId": 168,
            "LanguageId": 7,
            "AyetNumber": "١٦٨",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "قَالَ اِنّٖی لِعَمَلِكُمْ مِنَ الْقَالٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21707,
            "SureId": 26,
            "AyetId": 169,
            "LanguageId": 7,
            "AyetNumber": "١٦٩",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "رَبِّ نَجِّنٖی وَاَهْلٖی مِمَّا یَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21714,
            "SureId": 26,
            "AyetId": 170,
            "LanguageId": 7,
            "AyetNumber": "١٧٠",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "فَنَجَّیْنَاهُ وَاَهْلَهُٓ اَجْمَعٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21721,
            "SureId": 26,
            "AyetId": 171,
            "LanguageId": 7,
            "AyetNumber": "١٧١",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "اِلَّا عَجُوزًا فِی الْغَابِرٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21728,
            "SureId": 26,
            "AyetId": 172,
            "LanguageId": 7,
            "AyetNumber": "١٧٢",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "ثُمَّ دَمَّرْنَا الْاٰخَرٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21735,
            "SureId": 26,
            "AyetId": 173,
            "LanguageId": 7,
            "AyetNumber": "١٧٣",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "وَاَمْطَرْنَا عَلَیْهِمْ مَطَرًاۚ فَسَٓاءَ مَطَرُ الْمُنْذَرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21742,
            "SureId": 26,
            "AyetId": 174,
            "LanguageId": 7,
            "AyetNumber": "١٧٤",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "اِنَّ فٖی ذٰلِكَ لَاٰیَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21749,
            "SureId": 26,
            "AyetId": 175,
            "LanguageId": 7,
            "AyetNumber": "١٧٥",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "وَاِنَّ رَبَّكَ لَهُوَ الْعَزٖیزُ الرَّحٖیمُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21756,
            "SureId": 26,
            "AyetId": 176,
            "LanguageId": 7,
            "AyetNumber": "١٧٦",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "كَذَّبَ اَصْحَابُ لْــَٔیْكَةِ الْمُرْسَلٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21763,
            "SureId": 26,
            "AyetId": 177,
            "LanguageId": 7,
            "AyetNumber": "١٧٧",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "اِذْ قَالَ لَهُمْ شُعَیْبٌ اَلَا تَتَّقُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21770,
            "SureId": 26,
            "AyetId": 178,
            "LanguageId": 7,
            "AyetNumber": "١٧٨",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "اِنّٖی لَكُمْ رَسُولٌ اَمٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21777,
            "SureId": 26,
            "AyetId": 179,
            "LanguageId": 7,
            "AyetNumber": "١٧٩",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "فَاتَّقُوا اللّٰهَ وَاَطٖیعُونِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21784,
            "SureId": 26,
            "AyetId": 180,
            "LanguageId": 7,
            "AyetNumber": "١٨٠",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "وَمَٓا اَسْـَٔلُكُمْ عَلَیْهِ مِنْ اَجْرٍۚ اِنْ اَجْرِیَ اِلَّا عَلٰى رَبِّ الْعَالَمٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21791,
            "SureId": 26,
            "AyetId": 181,
            "LanguageId": 7,
            "AyetNumber": "١٨١",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "اَوْفُوا الْكَیْلَ وَلَا تَكُونُوا مِنَ الْمُخْسِرٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21798,
            "SureId": 26,
            "AyetId": 182,
            "LanguageId": 7,
            "AyetNumber": "١٨٢",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "وَزِنُوا بِالْقِسْطَاسِ الْمُسْتَقٖیمِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21805,
            "SureId": 26,
            "AyetId": 183,
            "LanguageId": 7,
            "AyetNumber": "١٨٣",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "وَلَا تَبْخَسُوا النَّاسَ اَشْیَٓاءَهُمْ وَلَا تَعْثَوْا فِی الْاَرْضِ مُفْسِدٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 21642,
            "SureId": 26,
            "AyetId": 160,
            "LanguageId": 5,
            "AyetNumber": "160",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Lût kavmi de peygamberleri yalancılıkla suçladı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 21649,
            "SureId": 26,
            "AyetId": 161,
            "LanguageId": 5,
            "AyetNumber": "161",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Kardeşleri Lût onlara şöyle demişti: “Allah’a karşı gelmekten sakınmaz mısınız?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21656,
            "SureId": 26,
            "AyetId": 162,
            "LanguageId": 5,
            "AyetNumber": "162",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Bilin ki ben, size gönderilmiş güvenilir bir elçiyim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21663,
            "SureId": 26,
            "AyetId": 163,
            "LanguageId": 5,
            "AyetNumber": "163",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Artık Allah’a karşı gelmekten sakının ve bana itaat edin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21670,
            "SureId": 26,
            "AyetId": 164,
            "LanguageId": 5,
            "AyetNumber": "164",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Bunun için sizden karşılık beklemiyorum. Benim ecrimi vermek yalnız âlemlerin rabbine aittir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21677,
            "SureId": 26,
            "AyetId": 165,
            "LanguageId": 5,
            "AyetNumber": "165-166",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Rabbinizin sizler için yarattığı eşlerinizi bırakıp da insanlar arasından erkeklerle mi beraber oluyorsunuz? Doğrusu siz haddini aşan bir kavimsiniz!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21684,
            "SureId": 26,
            "AyetId": 166,
            "LanguageId": 5,
            "AyetNumber": "166",
            "AyetVisible": false,
            "Page": 374,
            "AyetText": "Rabbinizin sizler için yarattığı eşlerinizi bırakıp da insanlar arasından erkeklerle mi beraber oluyorsunuz? Doğrusu siz haddini aşan bir kavimsiniz!\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21691,
            "SureId": 26,
            "AyetId": 167,
            "LanguageId": 5,
            "AyetNumber": "167",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "“Ey Lût!” dediler, “Bu tutumundan vazgeçmezsen iyi bil ki sen de kovulacaksın!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21698,
            "SureId": 26,
            "AyetId": 168,
            "LanguageId": 5,
            "AyetNumber": "168",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Lût, “Doğrusu ben bu yaptığınızdan dolayı sizden nefret ediyorum” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21705,
            "SureId": 26,
            "AyetId": 169,
            "LanguageId": 5,
            "AyetNumber": "169",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "“Rabbim! Beni ve ailemi, bunların yapmakta olduklarının vebalinden kurtar” diye dua etti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21712,
            "SureId": 26,
            "AyetId": 170,
            "LanguageId": 5,
            "AyetNumber": "170-171",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Bunun üzerine geride kalanlar arasındaki yaşlı kadın müstesna, onu ve bütün ailesini kurtardık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21719,
            "SureId": 26,
            "AyetId": 171,
            "LanguageId": 5,
            "AyetNumber": "171",
            "AyetVisible": false,
            "Page": 374,
            "AyetText": "Bunun üzerine geride kalanlar arasındaki yaşlı kadın müstesna, onu ve bütün ailesini kurtardık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21726,
            "SureId": 26,
            "AyetId": 172,
            "LanguageId": 5,
            "AyetNumber": "172",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Sonra diğerlerini helâk ettik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21733,
            "SureId": 26,
            "AyetId": 173,
            "LanguageId": 5,
            "AyetNumber": "173",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Üzerlerine de görülmemiş bir yağmur yağdırdık, sonunda önceden uyarılmış olanların yağmuru korkunç oldu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21740,
            "SureId": 26,
            "AyetId": 174,
            "LanguageId": 5,
            "AyetNumber": "174",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Elbet bunda büyük bir ibret vardır; fakat çokları iman etmezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21747,
            "SureId": 26,
            "AyetId": 175,
            "LanguageId": 5,
            "AyetNumber": "175",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Şüphesiz rabbin, işte O, mutlak güç ve engin merhamet sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21754,
            "SureId": 26,
            "AyetId": 176,
            "LanguageId": 5,
            "AyetNumber": "176",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Eyke halkı da peygamberleri yalancılıkla suçladı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21761,
            "SureId": 26,
            "AyetId": 177,
            "LanguageId": 5,
            "AyetNumber": "177",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Şuayb onlara şöyle demişti: “Allah’a karşı gelmekten sakınmaz mısınız?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21768,
            "SureId": 26,
            "AyetId": 178,
            "LanguageId": 5,
            "AyetNumber": "178",
            "AyetVisible": true,
            "Page": 374,
            "AyetText": "Bakınız ben size gönderilmiş güvenilir bir elçiyim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21775,
            "SureId": 26,
            "AyetId": 179,
            "LanguageId": 5,
