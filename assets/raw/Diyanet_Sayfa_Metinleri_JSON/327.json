    "QuranAyats": [
        {
            "Id": 17787,
            "SureId": 21,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "فَجَعَلَهُمْ جُذَاذًا اِلَّا كَبٖیرًا لَهُمْ لَعَلَّهُمْ اِلَیْهِ یَرْجِعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17794,
            "SureId": 21,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "قَالُوا مَنْ فَعَلَ هٰذَا بِاٰلِهَتِنَٓا اِنَّهُ لَمِنَ الظَّالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17801,
            "SureId": 21,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "قَالُوا سَمِعْنَا فَتًى یَذْكُرُهُمْ یُقَالُ لَهُٓ اِبْرٰهٖیمُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17808,
            "SureId": 21,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "قَالُوا فَاْتُوا بِهٖ عَلٰٓى اَعْیُنِ النَّاسِ لَعَلَّهُمْ یَشْهَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17815,
            "SureId": 21,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "قَالُٓوا ءَاَنْتَ فَعَلْتَ هٰذَا بِاٰلِهَتِنَا یَٓا اِبْرٰهٖیمُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17822,
            "SureId": 21,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "قَالَ بَلْ فَعَلَهُࣗ كَبٖیرُهُمْ هٰذَا فَسْـَٔلُوهُمْ اِنْ كَانُوا یَنْطِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17829,
            "SureId": 21,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "فَرَجَعُٓوا اِلٰٓى اَنْفُسِهِمْ فَقَالُٓوا اِنَّكُمْ اَنْتُمُ الظَّالِمُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17836,
            "SureId": 21,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "ثُمَّ نُكِسُوا عَلٰى رُؤُ𐻿سِهِمْۚ لَقَدْ عَلِمْتَ مَا هٰٓؤُ𐻾لَٓاءِ یَنْطِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17843,
            "SureId": 21,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "قَالَ اَفَتَعْبُدُونَ مِنْ دُونِ اللّٰهِ مَا لَا یَنْفَعُكُمْ شَیْـًٔا وَلَا یَضُرُّكُمْؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17850,
            "SureId": 21,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "اُفٍّ لَكُمْ وَلِمَا تَعْبُدُونَ مِنْ دُونِ اللّٰهِؕ اَفَلَا تَعْقِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17857,
            "SureId": 21,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "قَالُوا حَرِّقُوهُ وَانْصُرُٓوا اٰلِهَتَكُمْ اِنْ كُنْتُمْ فَاعِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17864,
            "SureId": 21,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "قُلْنَا یَا نَارُ كُونٖی بَرْدًا وَسَلَامًا عَلٰٓى اِبْرٰهٖیمَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17871,
            "SureId": 21,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "وَاَرَادُوا بِهٖ كَیْدًا فَجَعَلْنَاهُمُ الْاَخْسَرٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17878,
            "SureId": 21,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "وَنَجَّیْنَاهُ وَلُوطًا اِلَى الْاَرْضِ الَّتٖی بَارَكْنَا فٖیهَا لِلْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17885,
            "SureId": 21,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "وَوَهَبْنَا لَهُٓ اِسْحٰقَؕ وَیَعْقُوبَ نَافِلَةًؕ وَكُلًّا جَعَلْنَا صَالِحٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 17785,
            "SureId": 21,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "(Onlar gidince) İbrâhim putları paramparça etti, belki ona başvururlar diye büyük putu bıraktı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17792,
            "SureId": 21,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "(Dönüp durumu gören) putperestler, “Bunu tanrılarımıza kim yaptı? Muhakkak o, zalimlerden biridir” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17799,
            "SureId": 21,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60-61",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "Bazıları, “İbrâhim denen bir gencin bunları diline doladığını işitmiştik” deyince, “O halde, onu hemen insanların önüne getirin, belki birileri şahitlik eder” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17806,
            "SureId": 21,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": false,
            "Page": 327,
            "AyetText": "Bazıları, \"İbrâhim denen bir gencin bunları diline doladığını işitmiştik\" deyince, \"O halde, onu hemen insanların önüne getirin, belki birileri şahitlik eder\" dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17813,
            "SureId": 21,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "“Bunu ilâhlarımıza sen mi yaptın, ey İbrâhim?” diye sordular.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17820,
            "SureId": 21,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "İbrâhim, “Hayır” dedi, “Bu işi şu büyükleri yapmıştır. Konuşabiliyorlarsa onlara sorun!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17827,
            "SureId": 21,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "Sonra kendi kendilerine dönüp, “Asıl haktan ayrılanlar sizlersiniz!” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17834,
            "SureId": 21,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "Sonra yine başlarını öne eğerek “Bunların konuşamayacağını pekâlâ biliyorsun” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17841,
            "SureId": 21,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66-67",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "İbrâhim, “öyleyse Allah’ı bırakıp da size ne fayda ne de zarar veremeyen şeylere mi tapıyorsunuz? Size de Allah’ı bırakıp taptığınız bu şeylere de yuf olsun! Siz aklınızı kullanmaz mısınız?” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17848,
            "SureId": 21,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": false,
            "Page": 327,
            "AyetText": "İbrâhim, \"Allah’ı bırakıp da size hiçbir fayda ve zarar veremeyen tanrılara mı tapıyorsunuz? Size de Allah’ı bırakıp taptığınız şeylere de yazıklar olsun! Siz aklınızı kullanmaz mısınız?\" dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17855,
            "SureId": 21,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "Putperestler, “Eğer bir şey yapacaksanız, yakın onu ve böylece tanrılarınıza yardım edin!” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17862,
            "SureId": 21,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "Biz de, “Ey ateş” dedik, “İbrâhim’e serin ve zararsız ol!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17869,
            "SureId": 21,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "Ona bir tuzak kurmak istediler; fakat biz onları daha çok zarar eden taraf yaptık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17876,
            "SureId": 21,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "Onu da Lût’u da kurtarıp herkes için bereketli kıldığımız yere ulaştırdık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17883,
            "SureId": 21,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 327,
            "AyetText": "İbrâhim’e İshak’ı ve üstüne bir de armağan olarak Ya‘kūb’u lütfettik; her birinin sâlih insan olmasını sağladık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
