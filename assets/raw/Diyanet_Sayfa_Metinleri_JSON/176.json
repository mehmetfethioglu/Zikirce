    "QuranAyats": [
        {
            "Id": 8050,
            "SureId": 7,
            "AyetId": 196,
            "LanguageId": 7,
            "AyetNumber": "١٩٦",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "اِنَّ وَلِـِّۧیَ اللّٰهُ الَّذٖی نَزَّلَ الْكِتَابَؗ وَهُوَ یَتَوَلَّى الصَّالِحٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 7,
                "MealInfo": "Mekke döneminde inmiştir. 163-170. âyetlerin Medine döneminde indiğini söyleyen âlimler de vardır. 206 âyettir. Sûre, adını 46. ve 48. âyetlerde geçen<b>“el-A’râf ” </b>kelimesinden almıştır. <b>“el-A’râf ”, <i>yüksek yerler, yüksek mevkiler</i> demektir</b>. Sûrede temel konu olarak, ilâhî vahyin doğruluğu ve vahye duyulan ihtiyaç işlenmektedir.",
                "SureNameTurkish": "A'râf",
                "SureNameArabic": "الْاَعْرَافِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 39,
                "AyetCount": 206,
                "Cuz": 8,
                "FirstPage": 151,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 8057,
            "SureId": 7,
            "AyetId": 197,
            "LanguageId": 7,
            "AyetNumber": "١٩٧",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "وَالَّذٖینَ تَدْعُونَ مِنْ دُونِهٖ لَا یَسْتَطٖیعُونَ نَصْرَكُمْ وَلَٓا اَنْفُسَهُمْ یَنْصُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8064,
            "SureId": 7,
            "AyetId": 198,
            "LanguageId": 7,
            "AyetNumber": "١٩٨",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "وَاِنْ تَدْعُوهُمْ اِلَى الْهُدٰى لَا یَسْمَعُواؕ وَتَرٰیهُمْ یَنْظُرُونَ اِلَیْكَ وَهُمْ لَا یُبْصِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8071,
            "SureId": 7,
            "AyetId": 199,
            "LanguageId": 7,
            "AyetNumber": "١٩٩",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "خُذِ الْعَفْوَ وَاْمُرْ بِالْعُرْفِ وَاَعْرِضْ عَنِ الْجَاهِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8078,
            "SureId": 7,
            "AyetId": 200,
            "LanguageId": 7,
            "AyetNumber": "٢٠٠",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "وَاِمَّا یَنْزَغَنَّكَ مِنَ الشَّیْطَانِ نَزْغٌ فَاسْتَعِذْ بِاللّٰهِؕ اِنَّهُ سَمٖیعٌ عَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8085,
            "SureId": 7,
            "AyetId": 201,
            "LanguageId": 7,
            "AyetNumber": "٢٠١",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "اِنَّ الَّذٖینَ اتَّقَوْا اِذَا مَسَّهُمْ طَٓائِفٌ مِنَ الشَّیْطَانِ تَذَكَّرُوا فَاِذَا هُمْ مُبْصِرُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8092,
            "SureId": 7,
            "AyetId": 202,
            "LanguageId": 7,
            "AyetNumber": "٢٠٢",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "وَاِخْوَانُهُمْ یَمُدُّونَهُمْ فِی الْغَیِّ ثُمَّ لَا یُقْصِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8099,
            "SureId": 7,
            "AyetId": 203,
            "LanguageId": 7,
            "AyetNumber": "٢٠٣",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "وَاِذَا لَمْ تَاْتِهِمْ بِاٰیَةٍ قَالُوا لَوْلَا اجْتَبَیْتَهَاؕ قُلْ اِنَّمَٓا اَتَّبِـعُ مَا یُوحٰٓى اِلَیَّ مِنْ رَبّٖیۚ هٰذَا بَصَٓائِرُ مِنْ رَبِّكُمْ وَهُدًى وَرَحْمَةٌ لِقَوْمٍ یُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8106,
            "SureId": 7,
            "AyetId": 204,
            "LanguageId": 7,
            "AyetNumber": "٢٠٤",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "وَاِذَا قُرِئَ الْقُرْاٰنُ فَاسْتَمِعُوا لَهُ وَاَنْصِتُوا لَعَلَّكُمْ تُرْحَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8113,
            "SureId": 7,
            "AyetId": 205,
            "LanguageId": 7,
            "AyetNumber": "٢٠٥",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "وَاذْكُرْ رَبَّكَ فٖی نَفْسِكَ تَضَرُّعًا وَخٖیفَةً وَدُونَ الْجَهْرِ مِنَ الْقَوْلِ بِالْغُدُوِّ وَالْاٰصَالِ وَلَا تَكُنْ مِنَ الْغَافِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8120,
            "SureId": 7,
            "AyetId": 206,
            "LanguageId": 7,
            "AyetNumber": "٢٠٦",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "اِنَّ الَّذٖینَ عِنْدَ رَبِّكَ لَا یَسْتَكْبِرُونَ عَنْ عِبَادَتِهٖ وَیُسَبِّحُونَهُ وَلَهُ یَسْجُدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 8048,
            "SureId": 7,
            "AyetId": 196,
            "LanguageId": 5,
            "AyetNumber": "196",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "Ama bilin ki benim velim, kitabı indiren Allah’tır. O, iyileri koruyup kollar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 7,
                "MealInfo": "Mekke döneminde inmiştir. 163-170. âyetlerin Medine döneminde indiğini söyleyen âlimler de vardır. 206 âyettir. Sûre, adını 46. ve 48. âyetlerde geçen<b>“el-A’râf ” </b>kelimesinden almıştır. <b>“el-A’râf ”, <i>yüksek yerler, yüksek mevkiler</i> demektir</b>. Sûrede temel konu olarak, ilâhî vahyin doğruluğu ve vahye duyulan ihtiyaç işlenmektedir.",
                "SureNameTurkish": "A'râf",
                "SureNameArabic": "الْاَعْرَافِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 39,
                "AyetCount": 206,
                "Cuz": 8,
                "FirstPage": 151,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 8055,
            "SureId": 7,
            "AyetId": 197,
            "LanguageId": 5,
            "AyetNumber": "197",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "O’nun dışında yalvarıp yakardıklarınız ise ne size yardım edebilirler, hatta ne de kendilerine yardımları dokunur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8062,
            "SureId": 7,
            "AyetId": 198,
            "LanguageId": 5,
            "AyetNumber": "198",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "Hidayete ulaşma hususunda onlara yalvarsanız sizi duymazlar, sana bakıyorlar zannedersin, oysa görmezler.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8069,
            "SureId": 7,
            "AyetId": 199,
            "LanguageId": 5,
            "AyetNumber": "199",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "Kolaylığı seç, iyi olanı emret, cahillere aldırma!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8076,
            "SureId": 7,
            "AyetId": 200,
            "LanguageId": 5,
            "AyetNumber": "200",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "Eğer şeytandan bir fitleme seni dürtüklerse hemen Allah’a sığın! Allah her şeyi işitir, her şeyi bilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8083,
            "SureId": 7,
            "AyetId": 201,
            "LanguageId": 5,
            "AyetNumber": "201",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "Takvâ sahipleri, içlerine şeytandan gelen bir saptırıcı fikir doğduğunda O’nu düşünüp hemen gerçeği görürler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8090,
            "SureId": 7,
            "AyetId": 202,
            "LanguageId": 5,
            "AyetNumber": "202",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "(Şeytanların dostları olan inkârcılara gelince,) dostları onları azgınlığa sürükler. Onlar da azgınlıktan hiç geri durmazlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8097,
            "SureId": 7,
            "AyetId": 203,
            "LanguageId": 5,
            "AyetNumber": "203",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "Sen onlara bir mûcize getirmediğin vakit, “Onu da derleyip toplasaydın ya!” derler. De ki: “Ben sadece rabbimden bana vahyedilene uyarım. İşte bu Kur’an, rabbinizden gelen kanıtlardır, inanan bir topluluk için hidayettir, rahmettir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8104,
            "SureId": 7,
            "AyetId": 204,
            "LanguageId": 5,
            "AyetNumber": "204",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "Kur’an okunduğu zaman onu dinleyin ve sessiz durun ki rahmete nâil olasınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8111,
            "SureId": 7,
            "AyetId": 205,
            "LanguageId": 5,
            "AyetNumber": "205",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "Kendi kendine, yalvararak ve ürpererek, alçak sesle sabah akşam rabbini zikret, gafillerden olma!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8118,
            "SureId": 7,
            "AyetId": 206,
            "LanguageId": 5,
            "AyetNumber": "206",
            "AyetVisible": true,
            "Page": 176,
            "AyetText": "Rabbinin katında bulunanlar bile O’na kulluk etmek hususunda kibre kapılmazlar, O’nu tesbih ederler ve yalnız O’na secde ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "A'râf",
    "QuranSureLabel": "الْاَعْرَافِ",
    "EndPageSure": null
}