    "ArCuzNo": "۱۷",
    "ArPageNo": "۳۳۱",
    "QuranAyats": [
        {
            "Id": 18095,
            "SureId": 21,
            "AyetId": 102,
            "LanguageId": 7,
            "AyetNumber": "١٠٢",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "لَا یَسْمَعُونَ حَسٖیسَهَاۚ وَهُمْ فٖی مَا اشْتَهَتْ اَنْفُسُهُمْ خَالِدُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18102,
            "SureId": 21,
            "AyetId": 103,
            "LanguageId": 7,
            "AyetNumber": "١٠٣",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "لَا یَحْزُنُهُمُ الْفَزَعُ الْاَكْبَرُ وَتَتَلَقّٰیهُمُ الْمَلٰٓئِكَةُؕ هٰذَا یَوْمُكُمُ الَّذٖی كُنْتُمْ تُوعَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18109,
            "SureId": 21,
            "AyetId": 104,
            "LanguageId": 7,
            "AyetNumber": "١٠٤",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "یَوْمَ نَطْوِی السَّمَٓاءَ كَطَیِّ السِّجِلِّ لِلْكُتُبِؕ كَمَا بَدَاْنَٓا اَوَّلَ خَلْقٍ نُعٖیدُهُؕ وَعْدًا عَلَیْنَاؕ اِنَّا كُنَّا فَاعِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18116,
            "SureId": 21,
            "AyetId": 105,
            "LanguageId": 7,
            "AyetNumber": "١٠٥",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "وَلَقَدْ كَتَبْنَا فِی الزَّبُورِ مِنْ بَعْدِ الذِّكْرِ اَنَّ الْاَرْضَ یَرِثُهَا عِبَادِیَ الصَّالِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18123,
            "SureId": 21,
            "AyetId": 106,
            "LanguageId": 7,
            "AyetNumber": "١٠٦",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "اِنَّ فٖی هٰذَا لَبَلَاغًا لِقَوْمٍ عَابِدٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18130,
            "SureId": 21,
            "AyetId": 107,
            "LanguageId": 7,
            "AyetNumber": "١٠٧",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "وَمَٓا اَرْسَلْنَاكَ اِلَّا رَحْمَةً لِلْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18137,
            "SureId": 21,
            "AyetId": 108,
            "LanguageId": 7,
            "AyetNumber": "١٠٨",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "قُلْ اِنَّمَا یُوحٰٓى اِلَیَّ اَنَّمَٓا اِلٰهُكُمْ اِلٰهٌ وَاحِدٌۚ فَهَلْ اَنْتُمْ مُسْلِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18144,
            "SureId": 21,
            "AyetId": 109,
            "LanguageId": 7,
            "AyetNumber": "١٠٩",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "فَاِنْ تَوَلَّوْا فَقُلْ اٰذَنْتُكُمْ عَلٰى سَوَٓاءٍؕ وَاِنْ اَدْرٖٓی اَقَرٖیبٌ اَمْ بَعٖیدٌ مَا تُوعَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18151,
            "SureId": 21,
            "AyetId": 110,
            "LanguageId": 7,
            "AyetNumber": "١١٠",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "اِنَّهُ یَعْلَمُ الْجَهْرَ مِنَ الْقَوْلِ وَیَعْلَمُ مَا تَكْتُمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18158,
            "SureId": 21,
            "AyetId": 111,
            "LanguageId": 7,
            "AyetNumber": "١١١",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "وَاِنْ اَدْرٖی لَعَلَّهُ فِتْنَةٌ لَكُمْ وَمَتَاعٌ اِلٰى حٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18165,
            "SureId": 21,
            "AyetId": 112,
            "LanguageId": 7,
            "AyetNumber": "١١٢",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "قَالَ رَبِّ احْكُمْ بِالْحَقِّؕ وَرَبُّنَا الرَّحْمٰنُ الْمُسْتَعَانُ عَلٰى مَا تَصِفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 18093,
            "SureId": 21,
            "AyetId": 102,
            "LanguageId": 5,
            "AyetNumber": "102",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "Onlar cehennemin uğultusunu işitmezler, canlarının istediği nimetler içinde ebedî olarak kalırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18100,
            "SureId": 21,
            "AyetId": 103,
            "LanguageId": 5,
            "AyetNumber": "103",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "En büyük dehşet bile onları tasalandırmaz. Melekler onları, “İşte bu size vaad edilmiş olan (mutlu) gününüzdür” diyerek karşılar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18107,
            "SureId": 21,
            "AyetId": 104,
            "LanguageId": 5,
            "AyetNumber": "104",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "O dehşet günü gökleri yazılı kâğıt tomarlarını dürer gibi düreriz. Yaratmaya başlamadan önceki hale döndürürüz. Sözümüz sözdür; biz bunu mutlaka yaparız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18114,
            "SureId": 21,
            "AyetId": 105,
            "LanguageId": 5,
            "AyetNumber": "105",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "Andolsun zikirden sonra Zebûr’da da, “Yeryüzü iyi kullarıma kalacaktır” diye yazmıştık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18121,
            "SureId": 21,
            "AyetId": 106,
            "LanguageId": 5,
            "AyetNumber": "106",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "İşte bunda, Allah’a kulluk eden topluluk için yeterli açıklama vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18128,
            "SureId": 21,
            "AyetId": 107,
            "LanguageId": 5,
            "AyetNumber": "107",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "Ve seni ancak âlemlere rahmet olarak gönderdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18135,
            "SureId": 21,
            "AyetId": 108,
            "LanguageId": 5,
            "AyetNumber": "108",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "De ki: “Bana ilâhınız bir tek ilâhtır diye vahyediliyor; siz hâlâ teslim olmayacak mısınız?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18142,
            "SureId": 21,
            "AyetId": 109,
            "LanguageId": 5,
            "AyetNumber": "109",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "Eğer yüz çevirirlerse de ki: “Ben gerçeği hepinize aynı şekilde açıkladım. Artık size vaad olunan şey yakın mı uzak mı bilmiyorum.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18149,
            "SureId": 21,
            "AyetId": 110,
            "LanguageId": 5,
            "AyetNumber": "110",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "Şüphesiz Allah sözün açıkça söylenenini de bilir, gizli tuttuklarınızı da bilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18156,
            "SureId": 21,
            "AyetId": 111,
            "LanguageId": 5,
            "AyetNumber": "111",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "Bilmiyorum, belki de azabın ertelenmesi sizi denemek ve bir zamana kadar sizi dünyadan nasiplendirmek içindir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18163,
            "SureId": 21,
            "AyetId": 112,
            "LanguageId": 5,
            "AyetNumber": "112",
            "AyetVisible": true,
            "Page": 331,
            "AyetText": "Peygamber şöyle dedi: “Rabbim! Adaletinle hükmünü ver. Rabbimiz rahmândır. Asılsız iddialarınıza karşı yardımına sığınılacak da yalnız O’dur.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
