{
    "PointerList": null,
    "CuzNo": 16,
    "PageNo": 315,
    "ArCuzNo": "۱٦",
    "ArPageNo": "۳۱٥",
    "QuranAyats": [
        {
            "Id": 16800,
            "SureId": 20,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "قَالَ عِلْمُهَا عِنْدَ رَبّٖی فٖی كِتَابٍۚ لَا یَضِلُّ رَبّٖی وَلَا یَنْسٰىؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16807,
            "SureId": 20,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "اَلَّذٖی جَعَلَ لَكُمُ الْاَرْضَ مَهْدًا وَسَلَكَ لَكُمْ فٖیهَا سُبُلًا وَاَنْزَلَ مِنَ السَّمَٓاءِ مَٓاءًؕ فَاَخْرَجْنَا بِهٖٓ اَزْوَاجًا مِنْ نَبَاتٍ شَتّٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16814,
            "SureId": 20,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "كُلُوا وَارْعَوْا اَنْعَامَكُمْؕ اِنَّ فٖی ذٰلِكَ لَاٰیَاتٍ لِاُو𐻾لِی النُّهٰىࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16821,
            "SureId": 20,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "مِنْهَا خَلَقْنَاكُمْ وَفٖیهَا نُعٖیدُكُمْ وَمِنْهَا نُخْرِجُكُمْ تَارَةً اُخْرٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16828,
            "SureId": 20,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "وَلَقَدْ اَرَیْنَاهُ اٰیَاتِنَا كُلَّهَا فَكَذَّبَ وَاَبٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16835,
            "SureId": 20,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "قَالَ اَجِئْتَنَا لِتُخْرِجَنَا مِنْ اَرْضِنَا بِسِحْرِكَ یَا مُوسٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16842,
            "SureId": 20,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "فَلَنَاْتِیَنَّكَ بِسِحْرٍ مِثْلِهٖ فَاجْعَلْ بَیْنَنَا وَبَیْنَكَ مَوْعِدًا لَا نُخْلِفُهُ نَحْنُ وَلَٓا اَنْتَ مَكَانًا سُوًى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16849,
            "SureId": 20,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "قَالَ مَوْعِدُكُمْ یَوْمُ الزّٖینَةِ وَاَنْ یُحْشَرَ النَّاسُ ضُحًى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16856,
            "SureId": 20,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "فَتَوَلّٰى فِرْعَوْنُ فَجَمَعَ كَیْدَهُ ثُمَّ اَتٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16863,
            "SureId": 20,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "قَالَ لَهُمْ مُوسٰى وَیْلَكُمْ لَا تَفْتَرُوا عَلَى اللّٰهِ كَذِبًا فَیُسْحِتَكُمْ بِعَذَابٍۚ وَقَدْ خَابَ مَنِ افْتَرٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16870,
            "SureId": 20,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "فَتَنَازَعُٓوا اَمْرَهُمْ بَیْنَهُمْ وَاَسَرُّوا النَّجْوٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16877,
            "SureId": 20,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "قَالُٓوا اِنْ هٰذَانِ لَسَاحِرَانِ یُرٖیدَانِ اَنْ یُخْرِجَاكُمْ مِنْ اَرْضِكُمْ بِسِحْرِهِمَا وَیَذْهَبَا بِطَرٖیقَتِكُمُ الْمُثْلٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16884,
            "SureId": 20,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "فَاَجْمِعُوا كَیْدَكُمْ ثُمَّ ائْتُوا صَفًّاۚ وَقَدْ اَفْلَحَ الْیَوْمَ مَنِ اسْتَعْلٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 16798,
            "SureId": 20,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "Mûsâ, “Onlar hakkındaki bilgi rabbimin katındaki bir kitaptadır; rabbim ne yanılır ne unutur” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16805,
            "SureId": 20,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "Yeryüzünü sizin için bir beşik yapan, onda size yollar açan ve gökten su indiren O’dur. Onunla her çeşitten çift çift bitkiler çıkardık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16812,
            "SureId": 20,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "Kendiniz yiyin, hayvanlarınızı da otlatın. Kuşkusuz bunlarda akıl sahiplerinin çıkaracağı dersler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16819,
            "SureId": 20,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "Sizi ondan yarattık, yine ona döndüreceğiz ve sonra oradan bir defa daha çıkaracağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16826,
            "SureId": 20,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "Andolsun ona bütün kanıtlarımızı gösterdik; fakat o yalan saydı ve kabule yanaşmadı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16833,
            "SureId": 20,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "Dedi ki: “Ey Mûsâ! Yaptığın sihirle bizi yurdumuzdan çıkarmak için mi geldin?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16840,
            "SureId": 20,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "Biz de sana benzeri bir sihirle mutlaka karşılık vereceğiz. Şimdi sen, aramızda -senin de bizim de caymayacağımız- uygun bir yerde bir buluşma zamanı belirle.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16847,
            "SureId": 20,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "Mûsâ, “Buluşma zamanınız şenlik günü ve ahalinin toplanacağı kuşluk vakti olsun” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16854,
            "SureId": 20,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "Bunun üzerine Firavun dönüp gitti; bütün tedbirlerini aldı, sonra (sihirbazlarıyla) geldi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16861,
            "SureId": 20,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "Mûsâ onlara şöyle dedi: “Yazıklar olsun size! Allah’a karşı yalan uydurmayın, yoksa ağır bir ceza ile kökünüzü kazır; iftira eden mutlaka perişan olur.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16868,
            "SureId": 20,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "Bunun üzerine yapacakları işi aralarında tartıştılar ve konuşmalarını gizli tutmaya çalıştılar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16875,
            "SureId": 20,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "Şöyle diyorlardı: “Bunlar sizi sihirleriyle yurdunuzdan çıkarmak ve tuttuğunuz örnek yolu ortadan kaldırmak isteyen iki sihirbazdan başka bir şey değil!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16882,
            "SureId": 20,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 315,
            "AyetText": "O halde siz de bütün hilelerinizi birleştirin ve saf düzeninde gelin. Bugün üstün gelen kendini kurtarmıştır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Tâhâ",
    "QuranSureLabel": "طٰهٰ",
    "EndPageSure": null
}