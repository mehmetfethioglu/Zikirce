{
    "PointerList": null,
    "CuzNo": 29,
    "PageNo": 563,
    "ArCuzNo": "۲۹",
    "ArPageNo": "٥٦۳",
    "QuranAyats": [
        {
            "Id": 36778,
            "SureId": 67,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "وَاَسِرُّوا قَوْلَكُمْ اَوِ اجْهَرُوا بِهٖؕ اِنَّهُ عَلٖیمٌ بِذَاتِ الصُّدُورِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 67,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. Sûre, adını birinci âyette geçen “elMülk”kelimesinden almıştır. Sûrede başlıca, Allah’ın azameti, Allah’ın birliğinindelilleri ve öldükten sonra dirilmeyi inkâr edenlerin akıbetleri konuedilmektedir",
                "SureNameTurkish": "Mülk",
                "SureNameArabic": "الْمُلْكِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 77,
                "AyetCount": 30,
                "Cuz": 29,
                "FirstPage": 562,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 36785,
            "SureId": 67,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "اَلَا یَعْلَمُ مَنْ خَلَقَؕ وَهُوَ اللَّطٖیفُ الْخَبٖیرُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36792,
            "SureId": 67,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "هُوَ الَّذٖی جَعَلَ لَكُمُ الْاَرْضَ ذَلُولًا فَامْشُوا فٖی مَنَاكِبِهَا وَكُلُوا مِنْ رِزْقِهٖؕ وَاِلَیْهِ النُّشُورُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36799,
            "SureId": 67,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "ءَاَمِنْتُمْ مَنْ فِی السَّمَٓاءِ اَنْ یَخْسِفَ بِكُمُ الْاَرْضَ فَاِذَا هِیَ تَمُورُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36806,
            "SureId": 67,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "اَمْ اَمِنْتُمْ مَنْ فِی السَّمَٓاءِ اَنْ یُرْسِلَ عَلَیْكُمْ حَاصِبًاؕ فَسَتَعْلَمُونَ كَیْفَ نَذٖیرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36813,
            "SureId": 67,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "وَلَقَدْ كَذَّبَ الَّذٖینَ مِنْ قَبْلِهِمْ فَكَیْفَ كَانَ نَكٖیرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36820,
            "SureId": 67,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "اَوَلَمْ یَرَوْا اِلَى الطَّیْرِ فَوْقَهُمْ صَٓافَّاتٍ وَیَقْبِضْنَؕ مَا یُمْسِكُهُنَّ اِلَّا الرَّحْمٰنُؕ اِنَّهُ بِكُلِّ شَیْءٍ بَصٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36827,
            "SureId": 67,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "اَمَّنْ هٰذَا الَّذٖی هُوَ جُنْدٌ لَكُمْ یَنْصُرُكُمْ مِنْ دُونِ الرَّحْمٰنِؕ اِنِ الْكَافِرُونَ اِلَّا فٖی غُرُورٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36834,
            "SureId": 67,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "اَمَّنْ هٰذَا الَّذٖی یَرْزُقُكُمْ اِنْ اَمْسَكَ رِزْقَهُۚ بَلْ لَجُّوا فٖی عُتُوٍّ وَنُفُورٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36841,
            "SureId": 67,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "اَفَمَنْ یَمْشٖی مُكِبًّا عَلٰى وَجْهِهٖٓ اَهْدٰٓى اَمَّنْ یَمْشٖی سَوِیًّا عَلٰى صِرَاطٍ مُسْتَقٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36848,
            "SureId": 67,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "قُلْ هُوَ الَّذٖٓی اَنْشَاَكُمْ وَجَعَلَ لَكُمُ السَّمْعَ وَالْاَبْصَارَ وَالْاَفْــِٔدَةَؕ قَلٖیلًا مَا تَشْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36855,
            "SureId": 67,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "قُلْ هُوَ الَّذٖی ذَرَاَكُمْ فِی الْاَرْضِ وَاِلَیْهِ تُحْشَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36862,
            "SureId": 67,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "وَیَقُولُونَ مَتٰى هٰذَا الْوَعْدُ اِنْ كُنْتُمْ صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36869,
            "SureId": 67,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "قُلْ اِنَّمَا الْعِلْمُ عِنْدَ اللّٰهِࣕ وَاِنَّمَٓا اَنَا𐻾 نَذٖیرٌ مُبٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 36776,
            "SureId": 67,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "Sözünüzü ister gizleyin isterse açığa vurun; unutmayın ki O, kalplerin içindekini bilmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 67,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. Sûre, adını birinci âyette geçen “elMülk”kelimesinden almıştır. Sûrede başlıca, Allah’ın azameti, Allah’ın birliğinindelilleri ve öldükten sonra dirilmeyi inkâr edenlerin akıbetleri konuedilmektedir",
                "SureNameTurkish": "Mülk",
                "SureNameArabic": "الْمُلْكِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 77,
                "AyetCount": 30,
                "Cuz": 29,
                "FirstPage": 562,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 36783,
            "SureId": 67,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "Yaratan bilmez olur mu? O, bütün inceliklerin farkındadır ve her şeyden ­haberdardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36790,
            "SureId": 67,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "Yeryüzünü sizin için kullanışlı hale getiren O’dur. Üzerinde dolaşın ve Allah’ın rızkından yiyip için; (ama unutmayın ki) dönüş yalnız Allah’adır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36797,
            "SureId": 67,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "Göktekinin sizi yerin dibine batırmayacağından emin misiniz? Bir de bakarsınız yeryüzü altüst olmuş!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36804,
            "SureId": 67,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "Yahut gökte olanın üzerinize taş yağdıran bir fırtına göndermeyeceğinden emin misiniz? Uyarılarımın ne demek olduğunu yakında anlayacaksınız!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36811,
            "SureId": 67,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "Onlardan öncekiler de (dinimi) asılsız saymışlardı; ama verdiğim ceza da nasıl olmuştu?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36818,
            "SureId": 67,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "Üstlerinde kanatlarını aça kapaya uçan kuşları hiç görmediler mi? Onları (havada) Rahmân’dan başkası tutmuyor. Şüphesiz O her şeyi görmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36825,
            "SureId": 67,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "Peki, Rahmân’a karşı size yardım edecek askerleriniz kimler? İnkârcılar sadece derin bir gaflet içinde bulunmaktadırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36832,
            "SureId": 67,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "Yahut Allah lutfettiği rızkı kesiverse size rızık verebilecek olan kim? Hayır! Onlar azgınlıkta ve haktan sapıp uzaklaşmakta ısrar ediyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36839,
            "SureId": 67,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "Şimdi (düşünün, önünü görmeden), yüzüstü sürünen mi hedefe erişir, yoksa doğru yolda düzgün yürüyen mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36846,
            "SureId": 67,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "De ki: “Sizi yaratan, size işitme duyusu, gözler ve kalpler veren O’dur. Ne az şükrediyorsunuz!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36853,
            "SureId": 67,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "De ki: “Sizi yeryüzünde çoğaltıp yayan O’dur; sadece gelip O’nun huzurunda toplanacaksınız.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36860,
            "SureId": 67,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "“Doğru sözlü iseniz (söyleyin), bu tehdit ne zaman gerçekleşecek?” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 36867,
            "SureId": 67,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 563,
            "AyetText": "De ki: “O bilgi yalnız Allah’a mahsustur, ben ise sadece açık bir uyarıcıyım.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Mülk",
    "QuranSureLabel": "الْمُلْكِ",
