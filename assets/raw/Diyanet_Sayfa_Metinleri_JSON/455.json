    "QuranAyats": [
        {
            "Id": 27979,
            "SureId": 38,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "وَمَا خَلَقْنَا السَّمَٓاءَ وَالْاَرْضَ وَمَا بَیْنَهُمَا بَاطِلًاؕ ذٰلِكَ ظَنُّ الَّذٖینَ كَفَرُواۚ فَوَیْلٌ لِلَّذٖینَ كَفَرُوا مِنَ النَّارِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 38,
                "MealInfo": "Mekke döneminde inmiştir. 88 âyettir. Sûre, adını birinci âyetteki <b>“Sâd”</b> harfinden almıştır. Sûrede başlıca, <b>Allah’ın birliği, müşriklerin inkârları ve sapıklıkları sebebiyle azabı hak etmiş oldukları, Davûd, Süleyman, Eyyüp, İbrahim, İshak, İsmail, el-Yesa’ ve Zülkifl Peygamberlerin kıssaları, Davûd Peygamberin hakemliği ve Hz. Peygamberin temel görevi konu </b>edilmektedir.",
                "SureNameTurkish": "Sâd",
                "SureNameArabic": "صۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 38,
                "AyetCount": 88,
                "Cuz": 23,
                "FirstPage": 453,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 27986,
            "SureId": 38,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "اَمْ نَجْعَلُ الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ كَالْمُفْسِدٖینَ فِی الْاَرْضِؗ اَمْ نَجْعَلُ الْمُتَّقٖینَ كَالْفُجَّارِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27993,
            "SureId": 38,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "كِتَابٌ اَنْزَلْنَاهُ اِلَیْكَ مُبَارَكٌ لِیَدَّبَّرُٓوا اٰیَاتِهٖ وَلِیَتَذَكَّرَ اُو𐻾لُوا الْاَلْبَابِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28000,
            "SureId": 38,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "وَوَهَبْنَا لِدَاوُ𐻿دَ سُلَیْمٰنَؕ نِعْمَ الْعَبْدُؕ اِنَّهُٓ اَوَّابٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28007,
            "SureId": 38,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "اِذْ عُرِضَ عَلَیْهِ بِالْعَشِیِّ الصَّافِنَاتُ الْجِیَادُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28014,
            "SureId": 38,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "فَقَالَ اِنّٖٓی اَحْبَبْتُ حُبَّ الْخَیْرِ عَنْ ذِكْرِ رَبّٖیۚ حَتّٰى تَوَارَتْ بِالْحِجَابِࣞ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28021,
            "SureId": 38,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "رُدُّوهَا عَلَیَّؕ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْاَعْنَاقِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28028,
            "SureId": 38,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "وَلَقَدْ فَتَنَّا سُلَیْمٰنَ وَاَلْقَیْنَا عَلٰى كُرْسِیِّهٖ جَسَدًا ثُمَّ اَنَابَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28035,
            "SureId": 38,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "قَالَ رَبِّ اغْفِرْ لٖی وَهَبْ لٖی مُلْكًا لَا یَنْبَغٖی لِاَحَدٍ مِنْ بَعْدٖیۚ اِنَّكَ اَنْتَ الْوَهَّابُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28042,
            "SureId": 38,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "فَسَخَّرْنَا لَهُ الرّٖیحَ تَجْرٖی بِاَمْرِهٖ رُخَٓاءً حَیْثُ اَصَابَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28049,
            "SureId": 38,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "وَالشَّیَاطٖینَ كُلَّ بَنَّٓاءٍ وَغَوَّاصٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28056,
            "SureId": 38,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "وَاٰخَرٖینَ مُقَرَّنٖینَ فِی الْاَصْفَادِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28063,
            "SureId": 38,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "هٰذَا عَطَٓاؤُ𐻾نَا فَامْنُنْ اَوْ اَمْسِكْ بِغَیْرِ حِسَابٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28070,
            "SureId": 38,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "وَاِنَّ لَهُ عِنْدَنَا لَزُلْفٰى وَحُسْنَ مَاٰبٍࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28077,
            "SureId": 38,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "وَاذْكُرْ عَبْدَنَٓا اَیُّوبَۘ اِذْ نَادٰى رَبَّهُٓ اَنّٖی مَسَّنِیَ الشَّیْطَانُ بِنُصْبٍ وَعَذَابٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28084,
            "SureId": 38,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "اُرْكُضْ بِرِجْلِكَۚ هٰذَا مُغْتَسَلٌ بَارِدٌ وَشَرَابٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 27977,
            "SureId": 38,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "Göğü, yeri ve ikisi arasındakileri boş yere yaratmadık. Bu, inkâr edenlerin zannıdır. Cehennem ateşinden vay o inkârcıların başına geleceklere!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 38,
                "MealInfo": "Mekke döneminde inmiştir. 88 âyettir. Sûre, adını birinci âyetteki <b>“Sâd”</b> harfinden almıştır. Sûrede başlıca, <b>Allah’ın birliği, müşriklerin inkârları ve sapıklıkları sebebiyle azabı hak etmiş oldukları, Davûd, Süleyman, Eyyüp, İbrahim, İshak, İsmail, el-Yesa’ ve Zülkifl Peygamberlerin kıssaları, Davûd Peygamberin hakemliği ve Hz. Peygamberin temel görevi konu </b>edilmektedir.",
                "SureNameTurkish": "Sâd",
                "SureNameArabic": "صۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 38,
                "AyetCount": 88,
                "Cuz": 23,
                "FirstPage": 453,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 27984,
            "SureId": 38,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "Yoksa iman edip dünya ve âhirete yararlı işler yapanları yeryüzünde fesat çıkaranlarla bir mi tutacaktık? Yahut günah işlemekten sakınanları günaha batanlar gibi mi sayacaktık?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27991,
            "SureId": 38,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "Bu bir mübarek kitaptır ki onu sana, insanlar âyetleri üzerinde iyice düşünsünler, akıl iz‘an sahipleri ondan dersler, öğütler alsınlar diye indirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27998,
            "SureId": 38,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "Biz Dâvûd’a Süleyman’ı armağan ettik. O ne iyi kuldu! Yönü hep Allah’a dönüktü.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28005,
            "SureId": 38,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31-32",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "Bir gün akşama doğru alımlı, soylu koşu atları önüne getirildiğinde, “Ben malı (atları), rabbimi hatırlattığı için sevdim” dedi. Derken (güneş batınca) onlar karanlığın perdesiyle gizlendi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28012,
            "SureId": 38,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": false,
            "Page": 455,
            "AyetText": "Bir gün akşama doğru alımlı, soylu koşu atları önüne getirildiğinde, \"Ben malı (atları), rabbimi hatırlattığı için sevdim\" dedi. Derken (güneş batınca) onlar karanlığın perdesiyle gizlendi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28019,
            "SureId": 38,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "(Daha sonra) “Onları bana geri getirin” dedi; bacaklarını ve boyunlarını sıvazlamaya başladı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28026,
            "SureId": 38,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "Andolsun biz Süleyman’ı bir sınavdan geçirmiş, tahtının üstüne bir ceset koymuştuk; sonra o bize yöneldi;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28033,
            "SureId": 38,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35-38",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "“Rabbim” dedi, “Beni bağışla; benden sonra hiç kimsenin ulaşamayacağı bir hükümranlık ver bana. Lutfu sınırsız olan yalnız sensin.” Bunun üzerine, emriyle dilediği yöne doğru tatlı tatlı esen rüzgârı, bina kuran ve dalgıçlık yapan bütün şeytanları ve zincirlerle bağlanmış diğer yaratıkları onun buyruğuna verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28040,
            "SureId": 38,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": false,
            "Page": 455,
            "AyetText": "\"Rabbim\" dedi, \"Beni bağışla; benden sonra hiç kimsenin ulaşamayacağı bir hükümranlık ver bana. Lutfu sınırsız olan yalnız sensin.\" Bunun üzerine, emriyle dilediği yöne doğru tatlı tatlı esen rüzgârı, bina kuran ve dalgıçlık yapan bütün şeytanları ve zincirlerle bağlanmış diğer yaratıkları onun buyruğuna verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28047,
            "SureId": 38,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": false,
            "Page": 455,
            "AyetText": "\"Rabbim\" dedi, \"Beni bağışla; benden sonra hiç kimsenin ulaşamayacağı bir hükümranlık ver bana. Lutfu sınırsız olan yalnız sensin.\" Bunun üzerine, emriyle dilediği yöne doğru tatlı tatlı esen rüzgârı, bina kuran ve dalgıçlık yapan bütün şeytanları ve zincirlerle bağlanmış diğer yaratıkları onun buyruğuna verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28054,
            "SureId": 38,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": false,
            "Page": 455,
            "AyetText": "\"Rabbim\" dedi, \"Beni bağışla; benden sonra hiç kimsenin ulaşamayacağı bir hükümranlık ver bana. Lutfu sınırsız olan yalnız sensin.\" Bunun üzerine, emriyle dilediği yöne doğru tatlı tatlı esen rüzgârı, bina kuran ve dalgıçlık yapan bütün şeytanları ve zincirlerle bağlanmış diğer yaratıkları onun buyruğuna verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28061,
            "SureId": 38,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "“Bu bizim bağışımızdır; hiçbir hesap kaygısı taşımadan ister başkalarına ver ister elinde tut” (dedik).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28068,
            "SureId": 38,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "Kuşkusuz onun katımızda yüksek bir yakınlık derecesi ve güzel bir geleceği vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28075,
            "SureId": 38,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "Kulumuz Eyyûb’u da an. O, rabbine, “Şeytan bana sıkıntı ve acı vermektedir” diye seslenmişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28082,
            "SureId": 38,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 455,
            "AyetText": "“Ayağını yere vur (dedik), işte yıkanılacak ve içilecek serin bir su!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
