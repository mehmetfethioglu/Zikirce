{
    "PointerList": null,
    "CuzNo": 19,
    "PageNo": 369,
    "ArCuzNo": "۱۹",
    "ArPageNo": "۳٦۹",
    "QuranAyats": [
        {
            "Id": 20804,
            "SureId": 26,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "لَعَلَّنَا نَتَّبِعُ السَّحَرَةَ اِنْ كَانُوا هُمُ الْغَالِبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20811,
            "SureId": 26,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "فَلَمَّا جَٓاءَ السَّحَرَةُ قَالُوا لِفِرْعَوْنَ اَئِنَّ لَنَا لَاَجْرًا اِنْ كُنَّا نَحْنُ الْغَالِبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20818,
            "SureId": 26,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "قَالَ نَعَمْ وَاِنَّكُمْ اِذًا لَمِنَ الْمُقَرَّبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20825,
            "SureId": 26,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "قَالَ لَهُمْ مُوسٰٓى اَلْقُوا مَٓا اَنْتُمْ مُلْقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20832,
            "SureId": 26,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "فَاَلْقَوْا حِبَالَهُمْ وَعِصِیَّهُمْ وَقَالُوا بِعِزَّةِ فِرْعَوْنَ اِنَّا لَنَحْنُ الْغَالِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20839,
            "SureId": 26,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "فَاَلْقٰى مُوسٰى عَصَاهُ فَاِذَا هِیَ تَلْقَفُ مَا یَاْفِكُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20846,
            "SureId": 26,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "فَاُلْقِیَ السَّحَرَةُ سَاجِدٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20853,
            "SureId": 26,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "قَالُٓوا اٰمَنَّا بِرَبِّ الْعَالَمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20860,
            "SureId": 26,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "رَبِّ مُوسٰى وَهٰرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20867,
            "SureId": 26,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "قَالَ اٰمَنْتُمْ لَهُ قَبْلَ اَنْ اٰذَنَ لَكُمْۚ اِنَّهُ لَكَبٖیرُكُمُ الَّذٖی عَلَّمَكُمُ السِّحْرَۚ فَلَسَوْفَ تَعْلَمُونَؕ لَاُقَطِّعَنَّ اَیْدِیَكُمْ وَاَرْجُلَكُمْ مِنْ خِلَافٍ وَلَاُصَلِّبَنَّكُمْ اَجْمَعٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20874,
            "SureId": 26,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "قَالُوا لَا ضَیْرَؗ اِنَّٓا اِلٰى رَبِّنَا مُنْقَلِبُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20881,
            "SureId": 26,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "اِنَّا نَطْمَعُ اَنْ یَغْفِرَ لَنَا رَبُّنَا خَطَایَانَٓا اَنْ كُنَّٓا اَوَّلَ الْمُؤْمِنٖینَؕࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20888,
            "SureId": 26,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "وَاَوْحَیْنَٓا اِلٰى مُوسٰٓى اَنْ اَسْرِ بِعِبَادٖٓی اِنَّكُمْ مُتَّبَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20895,
            "SureId": 26,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "فَاَرْسَلَ فِرْعَوْنُ فِی الْمَدَٓائِنِ حَاشِرٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20902,
            "SureId": 26,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "اِنَّ هٰٓؤُ𐻾لَٓاءِ لَشِرْذِمَةٌ قَلٖیلُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20909,
            "SureId": 26,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "وَاِنَّهُمْ لَنَا لَغَٓائِظُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20916,
            "SureId": 26,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "وَاِنَّا لَجَمٖیعٌ حَاذِرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20923,
            "SureId": 26,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "فَاَخْرَجْنَاهُمْ مِنْ جَنَّاتٍ وَعُیُونٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20930,
            "SureId": 26,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "وَكُنُوزٍ وَمَقَامٍ كَرٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20937,
            "SureId": 26,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "كَذٰلِكَؕ وَاَوْرَثْنَاهَا بَنٖٓی اِسْرَٓایٖٔلَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20944,
            "SureId": 26,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "فَاَتْبَعُوهُمْ مُشْرِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 20802,
            "SureId": 26,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "“Sihirbazlar üstün gelirlerse -ki ümidimiz budur- herhalde onların yolundan gideriz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20809,
            "SureId": 26,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "Sihirbazlar geldiklerinde Firavun’a, “Üstün gelen biz olursak herhalde bize bir ödül vardır, değil mi?” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20816,
            "SureId": 26,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "Firavun, “Evet”, dedi; “O takdirde gerçekten has adamlarımdan olacaksınız.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20823,
            "SureId": 26,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "Mûsâ sihirbazlara, “Ne atacaksanız atın!” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20830,
            "SureId": 26,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "Bunun üzerine iplerini, değneklerini yere attılar ve dediler ki: “Firavun’un üstün gücü adına, elbette üstün gelen biz olacağız.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20837,
            "SureId": 26,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "Sonra Mûsâ da değneğini yere attı; bir de ne görsünler, onların düzmece nesnelerini yutuveriyor!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20844,
            "SureId": 26,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "Sihirbazlar derhal secdeye kapandılar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20851,
            "SureId": 26,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47-48",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "“Âlemlerin rabbine, Mûsâ ve Hârûn’un rabbine iman ettik” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20858,
            "SureId": 26,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": false,
            "Page": 369,
            "AyetText": "\"Âlemlerin rabbine, Mûsâ ve Hârûn’un rabbine iman ettik\" dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20865,
            "SureId": 26,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "Firavun dedi ki: “Benim size izin vermemi beklemeden ona iman ediyorsunuz, öyle mi? Anlaşılan o, size sihri öğreten üstadınızmış! Ama şimdi göreceksiniz! Andolsun, ellerinizi ve ayaklarınızı çaprazlama kestireceğim, hepinizi astıracağım!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20872,
            "SureId": 26,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "“Zararı yok” dediler, “Nasıl olsa biz rabbimize dönüyoruz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20879,
            "SureId": 26,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "İlk iman edenler olduğumuz için rabbimizin hatalarımızı bağışlayacağını ­umuyoruz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20886,
            "SureId": 26,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "Mûsâ’ya, “Kullarımı geceleyin yola çıkar, çünkü takip edileceksiniz” diye vahyettik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20893,
            "SureId": 26,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "Firavun da asker toplamak üzere şehirlere adamlar gönderdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20900,
            "SureId": 26,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "(Adamlarına) “Bunlar, sayıları az, önemsiz bir topluluk;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20907,
            "SureId": 26,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "Fakat bize karşı nefretle doludurlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20914,
            "SureId": 26,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "Biz de kuşkusuz tedbirli, tek vücut bir topluluğuz” (dedi).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20921,
            "SureId": 26,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57-58",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "Daha sonra onları (Firavun ve topluluğunu) bahçelerden, pınarlardan, hazinelerden ve değerli bir konumdan mahrum ettik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20928,
            "SureId": 26,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": false,
            "Page": 369,
            "AyetText": "Daha sonra onları (Firavun ve topluluğunu) bahçelerden, pınarlardan, hazinelerden ve değerli bir konumdan mahrum ettik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20935,
            "SureId": 26,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "İşte böyle. Bu nimetleri onların yerine İsrâiloğulları’na verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20942,
            "SureId": 26,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 369,
            "AyetText": "(Olaya gelince) Arkadan Firavun ve adamları gün doğarken onlara yetiştiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
