            }
        },
        {
            "Id": 14035,
            "SureId": 16,
            "AyetId": 104,
            "LanguageId": 7,
            "AyetNumber": "١٠٤",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "اِنَّ الَّذٖینَ لَا یُؤْمِنُونَ بِاٰیَاتِ اللّٰهِۙ لَا یَهْدٖیهِمُ اللّٰهُ وَلَهُمْ عَذَابٌ اَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14042,
            "SureId": 16,
            "AyetId": 105,
            "LanguageId": 7,
            "AyetNumber": "١٠٥",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "اِنَّمَا یَفْتَرِی الْكَذِبَ الَّذٖینَ لَا یُؤْمِنُونَ بِاٰیَاتِ اللّٰهِۚ وَاُو𐻾لٰٓئِكَ هُمُ الْكَاذِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14049,
            "SureId": 16,
            "AyetId": 106,
            "LanguageId": 7,
            "AyetNumber": "١٠٦",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "مَنْ كَفَرَ بِاللّٰهِ مِنْ بَعْدِ اٖیمَانِهٖٓ اِلَّا مَنْ اُكْرِهَ وَقَلْبُهُ مُطْمَئِنٌّ بِالْاٖیمَانِ وَلٰكِنْ مَنْ شَرَحَ بِالْكُفْرِ صَدْرًا فَعَلَیْهِمْ غَضَبٌ مِنَ اللّٰهِۚ وَلَهُمْ عَذَابٌ عَظٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14056,
            "SureId": 16,
            "AyetId": 107,
            "LanguageId": 7,
            "AyetNumber": "١٠٧",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "ذٰلِكَ بِاَنَّهُمُ اسْتَحَبُّوا الْحَیٰوةَ الدُّنْیَا عَلَى الْاٰخِرَةِۙ وَاَنَّ اللّٰهَ لَا یَهْدِی الْقَوْمَ الْكَافِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14063,
            "SureId": 16,
            "AyetId": 108,
            "LanguageId": 7,
            "AyetNumber": "١٠٨",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "اُو𐻾لٰٓئِكَ الَّذٖینَ طَبَعَ اللّٰهُ عَلٰى قُلُوبِهِمْ وَسَمْعِهِمْ وَاَبْصَارِهِمْۚ وَاُو𐻾لٰٓئِكَ هُمُ الْغَافِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14070,
            "SureId": 16,
            "AyetId": 109,
            "LanguageId": 7,
            "AyetNumber": "١٠٩",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "لَا جَرَمَ اَنَّهُمْ فِی الْاٰخِرَةِ هُمُ الْخَاسِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14077,
            "SureId": 16,
            "AyetId": 110,
            "LanguageId": 7,
            "AyetNumber": "١١٠",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "ثُمَّ اِنَّ رَبَّكَ لِلَّذٖینَ هَاجَرُوا مِنْ بَعْدِ مَا فُتِنُوا ثُمَّ جَاهَدُوا وَصَبَرُٓواۙ اِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحٖیمٌࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 14026,
