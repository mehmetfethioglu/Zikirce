                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14033,
            "SureId": 16,
            "AyetId": 104,
            "LanguageId": 5,
            "AyetNumber": "104",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "Allah’ın âyetlerine inanmayanlar yok mu, Allah onlara hidayet vermeyecek; onlar için elem verici bir azap vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14040,
            "SureId": 16,
            "AyetId": 105,
            "LanguageId": 5,
            "AyetNumber": "105",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "Ancak Allah’ın âyetlerine inanmayanlar böyle bir yalanı uydurabilirler, asıl yalancılar onların kendileridir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14047,
            "SureId": 16,
            "AyetId": 106,
            "LanguageId": 5,
            "AyetNumber": "106",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "Kim iman ettikten sonra Allah’ı inkâra saparsa -kalbi imanla dolu olduğu halde baskı altında kalanın durumu müstesna olmak üzere- kim kalbini inkâra açarsa işte Allah’ın gazabı bunlaradır; bunlar için çok büyük bir azap vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14054,
            "SureId": 16,
            "AyetId": 107,
            "LanguageId": 5,
            "AyetNumber": "107",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "Bu, onların dünya hayatını âhirete tercih etmelerindendir. Allah kâfirler topluluğuna hidayet vermez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14061,
            "SureId": 16,
            "AyetId": 108,
            "LanguageId": 5,
            "AyetNumber": "108",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "Bunlar, Allah’ın kalplerini, kulaklarını ve gözlerini mühürlediği kimselerdir; gaflette olanlar da işte bunlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14068,
            "SureId": 16,
            "AyetId": 109,
            "LanguageId": 5,
            "AyetNumber": "109",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "Hiç kuşku yok ki âhirette kaybedecek olanlar bunlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14075,
            "SureId": 16,
            "AyetId": 110,
            "LanguageId": 5,
            "AyetNumber": "110",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "Öte yandan, bilesin ki rabbin, eziyetlerle sınandıktan sonra yurtlarından göçenlerin, ardından çabalarını sürdürüp sabır gösterenlerin yardımcısıdır; artık bu yapılanlardan sonra rabbin elbette çok bağışlayıcı, çok merhametlidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
