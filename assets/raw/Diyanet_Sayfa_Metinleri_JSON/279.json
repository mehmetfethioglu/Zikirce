            "AyetNumber": "١٠٣",
            "AyetVisible": true,
            "Page": 279,
            "AyetText": "وَلَقَدْ نَعْلَمُ اَنَّهُمْ یَقُولُونَ اِنَّمَا یُعَلِّمُهُ بَشَرٌؕ لِسَانُ الَّذٖی یُلْحِدُونَ اِلَیْهِ اَعْجَمِیٌّ وَهٰذَا لِسَانٌ عَرَبِیٌّ مُبٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
