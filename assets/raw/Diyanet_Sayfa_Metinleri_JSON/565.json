            }
        },
        {
            "Id": 37014,
            "SureId": 68,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17-18",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Biz, vaktiyle şu bahçe sahiplerine belâ verdiğimiz gibi onlara da belâ verdik. Hani bahçe sahipleri, (“Allah izin verirse” gibi) bir kayıt koymaksızın sabah erkenden bahçenin mahsulünü kesinlikle devşireceklerine yemin etmişlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37021,
            "SureId": 68,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": false,
            "Page": 565,
            "AyetText": "Biz, vaktiyle şu bahçe sahiplerine belâ verdiğimiz gibi onlara da belâ verdik. Hani bahçe sahipleri, (\"Allah izin verirse\" gibi) bir kayıt koymaksızın sabah erkenden bahçenin mahsulünü kesinlikle devşireceklerine yemin etmişlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37028,
            "SureId": 68,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19-20",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Fakat onlar uykudayken rabbin tarafından gelen kuşatıcı bir âfet bahçeyi sarıverdi de bahçe kesilip kurumuş gibi oldu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37035,
            "SureId": 68,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": false,
            "Page": 565,
            "AyetText": "Fakat onlar uykudayken rabbin tarafından gelen kuşatıcı bir âfet bahçeyi sarıverdi de bahçe kesilip kurumuş gibi oldu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37042,
            "SureId": 68,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Sabahleyin birbirlerine şöyle seslendiler:",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37049,
            "SureId": 68,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "“Eğer devşirecekseniz erkenden tarlanızın başına gidin!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37056,
            "SureId": 68,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Derken yola koyuldular. Birbirlerine şöyle fısıldıyorlardı:",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37063,
            "SureId": 68,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "“Aman, bugün orada hiçbir yoksul yanınıza sokulmasın!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37070,
            "SureId": 68,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Amaçlarını, planladıkları gibi gerçekleştirmek üzere erkenden yola düşüp gittiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37077,
            "SureId": 68,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26-27",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Bahçeyi gördüklerinde ise, “Herhalde yanlış yere gelmişiz; yok yok, ürünü kaybetmişiz” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37084,
            "SureId": 68,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": false,
            "Page": 565,
            "AyetText": "Bahçeyi gördüklerinde ise, \"Herhalde yanlış yere gelmişiz; yok yok, ürünü kaybetmişiz\" dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37091,
            "SureId": 68,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "İçlerinden aklı başında olan biri şöyle dedi: “Ben size, ‘Allah’ın yüceliğini dile getirmelisiniz’ dememiş miydim?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37098,
            "SureId": 68,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Şöyle cevap verdiler: “Rabbimizin şanı yücedir; doğrusu biz haksızlık etmişiz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37105,
            "SureId": 68,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Ardından, birbirlerini kınamaya başladılar:",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37112,
            "SureId": 68,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "“Yazıklar olsun bize!” dediler, “Gerçekten biz azmış ve sapmıştık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37119,
            "SureId": 68,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Belki rabbimiz bize bunun yerine daha iyisini verir. Biz rabbimizden bunu ­diliyoruz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37126,
            "SureId": 68,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "İşte ceza budur. Âhiret azabı ise elbette daha büyüktür. Keşke bilselerdi!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37133,
            "SureId": 68,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Şüphesiz Allah’a itaatsizlikten sakınanlar için rableri katında nimetlerle dolu cennetler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37140,
            "SureId": 68,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Öyle ya, emrimize boyun eğenleri o günahkârlarla bir mi tutacağız?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37147,
            "SureId": 68,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Size ne oluyor? Ne biçim hüküm veriyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37154,
            "SureId": 68,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37-38",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Yoksa elinizde okuduğunuz bir kitap var da orada istediğinizin sizin olacağı mı yazılı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37161,
            "SureId": 68,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": false,
            "Page": 565,
            "AyetText": "Yoksa elinizde okuduğunuz bir kitap var da orada dilediğinizin sizin olacağı mı yazılı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37168,
            "SureId": 68,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Yoksa, “Neye hüküm verirseniz o mutlaka sizindir” diye tarafımızdan lehinize verilmiş, kıyamet gününe kadar geçerli kesin sözler mi var?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37175,
            "SureId": 68,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Sor onlara: İçlerinden kim buna kefil oluyor?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37182,
            "SureId": 68,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Yoksa onların (kendilerine akıl veren) ortakları mı var? Doğru söylüyorlarsa haydi getirsinler ortaklarını!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37189,
            "SureId": 68,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "O büyük korku ve dehşet günü gelip de secdeye çağrıldıklarında bunu yapamazlar;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
