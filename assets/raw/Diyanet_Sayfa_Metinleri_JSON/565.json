                "ExcludeMenu": false
            }
        },
        {
            "Id": 37016,
            "SureId": 68,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "اِنَّا بَلَوْنَاهُمْ كَمَا بَلَوْنَٓا اَصْحَابَ الْجَنَّةِۚ اِذْ اَقْسَمُوا لَیَصْرِمُنَّهَا مُصْبِحٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37023,
            "SureId": 68,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "وَلَا یَسْتَثْنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37030,
            "SureId": 68,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "فَطَافَ عَلَیْهَا طَٓائِفٌ مِنْ رَبِّكَ وَهُمْ نَٓائِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37037,
            "SureId": 68,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "فَاَصْبَحَتْ كَالصَّرٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37044,
            "SureId": 68,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "فَتَنَادَوْا مُصْبِحٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37051,
            "SureId": 68,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "اَنِ اغْدُوا عَلٰى حَرْثِكُمْ اِنْ كُنْتُمْ صَارِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37058,
            "SureId": 68,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "فَانْطَلَقُوا وَهُمْ یَتَخَافَتُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37065,
            "SureId": 68,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "اَنْ لَا یَدْخُلَنَّهَا الْیَوْمَ عَلَیْكُمْ مِسْكٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37072,
            "SureId": 68,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "وَغَدَوْا عَلٰى حَرْدٍ قَادِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37079,
            "SureId": 68,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "فَلَمَّا رَاَوْهَا قَالُٓوا اِنَّا لَضَٓالُّونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37086,
            "SureId": 68,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "بَلْ نَحْنُ مَحْرُومُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37093,
            "SureId": 68,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "قَالَ اَوْسَطُهُمْ اَلَمْ اَقُلْ لَكُمْ لَوْلَا تُسَبِّحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37100,
            "SureId": 68,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "قَالُوا سُبْحَانَ رَبِّنَٓا اِنَّا كُنَّا ظَالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37107,
            "SureId": 68,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "فَاَقْبَلَ بَعْضُهُمْ عَلٰى بَعْضٍ یَتَلَاوَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37114,
            "SureId": 68,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "قَالُوا یَا وَیْلَنَٓا اِنَّا كُنَّا طَاغٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37121,
            "SureId": 68,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "عَسٰى رَبُّنَٓا اَنْ یُبْدِلَنَا خَیْرًا مِنْهَٓا اِنَّٓا اِلٰى رَبِّنَا رَاغِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37128,
            "SureId": 68,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "كَذٰلِكَ الْعَذَابُؕ وَلَعَذَابُ الْاٰخِرَةِ اَكْبَرُۘ لَوْ كَانُوا یَعْلَمُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37135,
            "SureId": 68,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "اِنَّ لِلْمُتَّقٖینَ عِنْدَ رَبِّهِمْ جَنَّاتِ النَّعٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37142,
            "SureId": 68,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "اَفَنَجْعَلُ الْمُسْلِمٖینَ كَالْمُجْرِمٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37149,
            "SureId": 68,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "مَا لَكُمْࣞ كَیْفَ تَحْكُمُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37156,
            "SureId": 68,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "اَمْ لَكُمْ كِتَابٌ فٖیهِ تَدْرُسُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37163,
            "SureId": 68,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "اِنَّ لَكُمْ فٖیهِ لَمَا تَخَیَّرُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37170,
            "SureId": 68,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "اَمْ لَكُمْ اَیْمَانٌ عَلَیْنَا بَالِغَةٌ اِلٰى یَوْمِ الْقِیٰمَةِۙ اِنَّ لَكُمْ لَمَا تَحْكُمُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37177,
            "SureId": 68,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "سَلْهُمْ اَیُّهُمْ بِذٰلِكَ زَعٖیمٌۚۛ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37184,
            "SureId": 68,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "اَمْ لَهُمْ شُرَكَٓاءُۚۛ فَلْیَاْتُوا بِشُرَكَٓائِهِمْ اِنْ كَانُوا صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37191,
            "SureId": 68,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "یَوْمَ یُكْشَفُ عَنْ سَاقٍ وَیُدْعَوْنَ اِلَى السُّجُودِ فَلَا یَسْتَطٖیعُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 37007,
            "SureId": 68,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 565,
            "AyetText": "Yakında onun alnına (cehennemlik) damgasını vuracağız!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 68,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. Sûre, adını birinci âyette geçen “elKalem”kelimesinden almıştır. “Nûn” sûresi diye de anılır. Sûrede başlıca, Hz.Muhammed’in peygamberliğinin ispatı ve mü’minler ile kâfirlerin akıbetlerikonu edilmiştir.",
                "SureNameTurkish": "Kalem",
                "SureNameArabic": "الْقَلَمِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 2,
