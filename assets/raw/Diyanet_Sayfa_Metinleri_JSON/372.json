    "QuranAyats": [
        {
            "Id": 21308,
            "SureId": 26,
            "AyetId": 112,
            "LanguageId": 7,
            "AyetNumber": "١١٢",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "قَالَ وَمَا عِلْمٖی بِمَا كَانُوا یَعْمَلُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 21315,
            "SureId": 26,
            "AyetId": 113,
            "LanguageId": 7,
            "AyetNumber": "١١٣",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "اِنْ حِسَابُهُمْ اِلَّا عَلٰى رَبّٖی لَوْ تَشْعُرُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21322,
            "SureId": 26,
            "AyetId": 114,
            "LanguageId": 7,
            "AyetNumber": "١١٤",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "وَمَٓا اَنَا𐻾 بِطَارِدِ الْمُؤْمِنٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21329,
            "SureId": 26,
            "AyetId": 115,
            "LanguageId": 7,
            "AyetNumber": "١١٥",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "اِنْ اَنَا𐻾 اِلَّا نَذٖیرٌ مُبٖینٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21336,
            "SureId": 26,
            "AyetId": 116,
            "LanguageId": 7,
            "AyetNumber": "١١٦",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "قَالُوا لَئِنْ لَمْ تَنْتَهِ𐻾 یَا نُوحُ لَتَكُونَنَّ مِنَ الْمَرْجُومٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21343,
            "SureId": 26,
            "AyetId": 117,
            "LanguageId": 7,
            "AyetNumber": "١١٧",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "قَالَ رَبِّ اِنَّ قَوْمٖی كَذَّبُونِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21350,
            "SureId": 26,
            "AyetId": 118,
            "LanguageId": 7,
            "AyetNumber": "١١٨",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "فَافْتَحْ بَیْنٖی وَبَیْنَهُمْ فَتْحًا وَنَجِّنٖی وَمَنْ مَعِیَ مِنَ الْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21357,
            "SureId": 26,
            "AyetId": 119,
            "LanguageId": 7,
            "AyetNumber": "١١٩",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "فَاَنْجَیْنَاهُ وَمَنْ مَعَهُ فِی الْفُلْكِ الْمَشْحُونِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21364,
            "SureId": 26,
            "AyetId": 120,
            "LanguageId": 7,
            "AyetNumber": "١٢٠",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "ثُمَّ اَغْرَقْنَا بَعْدُ الْبَاقٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21371,
            "SureId": 26,
            "AyetId": 121,
            "LanguageId": 7,
            "AyetNumber": "١٢١",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "اِنَّ فٖی ذٰلِكَ لَاٰیَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21378,
            "SureId": 26,
            "AyetId": 122,
            "LanguageId": 7,
            "AyetNumber": "١٢٢",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "وَاِنَّ رَبَّكَ لَهُوَ الْعَزٖیزُ الرَّحٖیمُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21385,
            "SureId": 26,
            "AyetId": 123,
            "LanguageId": 7,
            "AyetNumber": "١٢٣",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "كَذَّبَتْ عَادٌࣙ الْمُرْسَلٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21392,
            "SureId": 26,
            "AyetId": 124,
            "LanguageId": 7,
            "AyetNumber": "١٢٤",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "اِذْ قَالَ لَهُمْ اَخُوهُمْ هُودٌ اَلَا تَتَّقُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21399,
            "SureId": 26,
            "AyetId": 125,
            "LanguageId": 7,
            "AyetNumber": "١٢٥",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "اِنّٖی لَكُمْ رَسُولٌ اَمٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21406,
            "SureId": 26,
            "AyetId": 126,
            "LanguageId": 7,
            "AyetNumber": "١٢٦",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "فَاتَّقُوا اللّٰهَ وَاَطٖیعُونِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21413,
            "SureId": 26,
            "AyetId": 127,
            "LanguageId": 7,
            "AyetNumber": "١٢٧",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "وَمَٓا اَسْـَٔلُكُمْ عَلَیْهِ مِنْ اَجْرٍۚ اِنْ اَجْرِیَ اِلَّا عَلٰى رَبِّ الْعَالَمٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21420,
            "SureId": 26,
            "AyetId": 128,
            "LanguageId": 7,
            "AyetNumber": "١٢٨",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "اَتَبْنُونَ بِكُلِّ رٖیعٍ اٰیَةً تَعْبَثُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21427,
            "SureId": 26,
            "AyetId": 129,
            "LanguageId": 7,
            "AyetNumber": "١٢٩",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "وَتَتَّخِذُونَ مَصَانِـعَ لَعَلَّكُمْ تَخْلُدُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21434,
            "SureId": 26,
            "AyetId": 130,
            "LanguageId": 7,
            "AyetNumber": "١٣٠",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "وَاِذَا بَطَشْتُمْ بَطَشْتُمْ جَبَّارٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21441,
            "SureId": 26,
            "AyetId": 131,
            "LanguageId": 7,
            "AyetNumber": "١٣١",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "فَاتَّقُوا اللّٰهَ وَاَطٖیعُونِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21448,
            "SureId": 26,
            "AyetId": 132,
            "LanguageId": 7,
            "AyetNumber": "١٣٢",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "وَاتَّقُوا الَّذٖٓی اَمَدَّكُمْ بِمَا تَعْلَمُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21455,
            "SureId": 26,
            "AyetId": 133,
            "LanguageId": 7,
            "AyetNumber": "١٣٣",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "اَمَدَّكُمْ بِاَنْعَامٍ وَبَنٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21462,
            "SureId": 26,
            "AyetId": 134,
            "LanguageId": 7,
            "AyetNumber": "١٣٤",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "وَجَنَّاتٍ وَعُیُونٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21469,
            "SureId": 26,
            "AyetId": 135,
            "LanguageId": 7,
            "AyetNumber": "١٣٥",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "اِنّٖٓی اَخَافُ عَلَیْكُمْ عَذَابَ یَوْمٍ عَظٖیمٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21476,
            "SureId": 26,
            "AyetId": 136,
            "LanguageId": 7,
            "AyetNumber": "١٣٦",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "قَالُوا سَوَٓاءٌ عَلَیْنَٓا اَوَعَظْتَ اَمْ لَمْ تَكُنْ مِنَ الْوَاعِظٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 21306,
            "SureId": 26,
            "AyetId": 112,
            "LanguageId": 5,
            "AyetNumber": "112",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Nûh dedi ki: “Onların vaktiyle ne yaptıklarını bilmem.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 21313,
            "SureId": 26,
            "AyetId": 113,
            "LanguageId": 5,
            "AyetNumber": "113",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Onların hesabı ancak rabbime aittir. Düşünseydiniz bunu anlardınız!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21320,
            "SureId": 26,
            "AyetId": 114,
            "LanguageId": 5,
            "AyetNumber": "114",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Ben iman etmiş kimseleri kovacak değilim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21327,
            "SureId": 26,
            "AyetId": 115,
            "LanguageId": 5,
            "AyetNumber": "115",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Ben sadece gerçekleri apaçık ortaya koyan bir uyarıcıyım.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21334,
            "SureId": 26,
            "AyetId": 116,
            "LanguageId": 5,
            "AyetNumber": "116",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "“Ey Nûh!” dediler, “Bu işten vazgeçmezsen, kesinlikle sen de taşlanacaksın!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21341,
            "SureId": 26,
            "AyetId": 117,
            "LanguageId": 5,
            "AyetNumber": "117",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Nûh, “Rabbim!” dedi, “Kavmim beni yalancılıkla suçluyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21348,
            "SureId": 26,
            "AyetId": 118,
            "LanguageId": 5,
            "AyetNumber": "118",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Artık benimle onların arasındaki durumu sen hükmünle açıklığa kavuştur, beni ve beraberimdeki müminleri kurtar!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21355,
            "SureId": 26,
            "AyetId": 119,
            "LanguageId": 5,
            "AyetNumber": "119",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Bunun üzerine biz onu ve beraberindekileri, o her şeyle dopdolu geminin içinde kurtardık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21362,
            "SureId": 26,
            "AyetId": 120,
            "LanguageId": 5,
            "AyetNumber": "120",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Sonra geri kalanları da sulara gömdük.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21369,
            "SureId": 26,
            "AyetId": 121,
            "LanguageId": 5,
            "AyetNumber": "121",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Doğrusu anlayanlar için bu kıssada büyük bir ders vardır; ama çokları iman etmezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21376,
            "SureId": 26,
            "AyetId": 122,
            "LanguageId": 5,
            "AyetNumber": "122",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Şüphesiz rabbin, işte O, mutlak güçlüdür, engin merhamet sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21383,
            "SureId": 26,
            "AyetId": 123,
            "LanguageId": 5,
            "AyetNumber": "123",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Âd kavmi de peygamberleri yalancılıkla suçladılar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21390,
            "SureId": 26,
            "AyetId": 124,
            "LanguageId": 5,
            "AyetNumber": "124",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Kardeşleri Hûd onlara şöyle demişti: “Allah’a karşı gelmekten sakınmıyor ­musunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21397,
            "SureId": 26,
            "AyetId": 125,
            "LanguageId": 5,
            "AyetNumber": "125",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Ben, size gönderilmiş güvenilir bir elçiyim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21404,
            "SureId": 26,
            "AyetId": 126,
            "LanguageId": 5,
            "AyetNumber": "126",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Artık Allah’a karşı gelmekten sakının ve bana itaat edin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21411,
            "SureId": 26,
            "AyetId": 127,
            "LanguageId": 5,
            "AyetNumber": "127",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Bunun için sizden bir karşılık beklemiyorum. Benim ecrimi vermek yalnız âlemlerin rabbine aittir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21418,
            "SureId": 26,
            "AyetId": 128,
            "LanguageId": 5,
            "AyetNumber": "128",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Siz boş şeylerle uğraşarak her yüksek yere bir anıt mı dikersiniz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21425,
            "SureId": 26,
            "AyetId": 129,
            "LanguageId": 5,
            "AyetNumber": "129",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Temelli kalacağınızı umarak mı büyük konaklar yaparsınız?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21432,
            "SureId": 26,
            "AyetId": 130,
            "LanguageId": 5,
            "AyetNumber": "130",
            "AyetVisible": true,
            "Page": 372,
            "AyetText": "Gücünüzü hep zalim zorbalar gibi mi kullanırsınız?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21439,
            "SureId": 26,
            "AyetId": 131,
            "LanguageId": 5,
            "AyetNumber": "131",
            "AyetVisible": true,
            "Page": 372,
