        {
            "Id": 34333,
            "SureId": 55,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Ona anlama ve anlatmayı öğretti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34340,
            "SureId": 55,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Güneş ve ay bir hesaba bağlı (olarak hareket ederler).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34347,
            "SureId": 55,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Yıldızlar da ağaçlar da secde ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34354,
            "SureId": 55,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7-8",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Göğü O yükseltti, denge ve ölçüyü O koydu ki dengeden sapmayasınız;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34361,
            "SureId": 55,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": false,
            "Page": 531,
            "AyetText": "Göğü O yükseltti, denge ve ölçüyü O koydu ki dengeden sapmayasınız;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34368,
            "SureId": 55,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Ölçüyü düzgün tutasınız ve eksik tartmayasınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34375,
            "SureId": 55,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "O yeryüzünü canlıların altına serdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34382,
            "SureId": 55,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Orada meyveler ve tomurcuklu hurma ağaçları var.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34389,
            "SureId": 55,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Çimlenen taneler ve hoş kokulu bitkiler var.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34396,
            "SureId": 55,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Artık rabbinizin nimetlerinden hangisini inkâr edebilirsiniz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34403,
            "SureId": 55,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "O, insanı ateşte pişirilmiş toprak kaplar gibi kurutulmuş çamurdan yarattı.",
