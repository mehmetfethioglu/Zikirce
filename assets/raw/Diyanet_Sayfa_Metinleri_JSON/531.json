    "QuranAyats": [
        {
            "Id": 34272,
            "SureId": 54,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "وَمَٓا اَمْرُنَٓا اِلَّا وَاحِدَةٌ كَلَمْحٍ بِالْبَصَرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 54,
                "MealInfo": "Mekke döneminde inmiştir. 55 âyettir. Sûre, adını ilk âyette geçen <b>“el-Kamer” </b>kelimesinden almıştır. <b>Kamer, ay demektir</b>. Sûre de ana fikir olarak, <b>Kur’an’ı yalanlayanlar, çeşitli azap ve helâk örnekleri</b> de verilerek uyarılmaktadır.",
                "SureNameTurkish": "Kamer",
                "SureNameArabic": "الْقَمَرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 37,
                "AyetCount": 55,
                "Cuz": 27,
                "FirstPage": 528,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 34279,
            "SureId": 54,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "وَلَقَدْ اَهْلَكْنَٓا اَشْیَاعَكُمْ فَهَلْ مِنْ مُدَّكِرٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34286,
            "SureId": 54,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "وَكُلُّ شَیْءٍ فَعَلُوهُ فِی الزُّبُرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34293,
            "SureId": 54,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "وَكُلُّ صَغٖیرٍ وَكَبٖیرٍ مُسْتَطَرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34300,
            "SureId": 54,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "اِنَّ الْمُتَّقٖینَ فٖی جَنَّاتٍ وَنَهَرٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34307,
            "SureId": 54,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "فٖی مَقْعَدِ صِدْقٍ عِنْدَ مَلٖیكٍ مُقْتَدِرٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34314,
            "SureId": 55,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "اَلرَّحْمٰنُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 55,
                "MealInfo": "Mekke döneminde inmiştir. 78 âyettir. Sûre, adını ilk âyeti oluşturan ve Allah’ın sıfatlarından biri olan <b>“er-Rahmân”</b> kelimesinden almıştır. Sûrede başlıca,<b> Allah’ın nimetleri, birliğini ve kudretini gösteren kâinat delilleri ve günahkârların kıyamette karşılaşacakları korku ve şiddet</b> konu edilmektedir.",
                "SureNameTurkish": "Rahmân",
                "SureNameArabic": "الرَّحْمٰنِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 97,
                "AyetCount": 78,
                "Cuz": 27,
                "FirstPage": 531,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 34321,
            "SureId": 55,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "عَلَّمَ الْقُرْاٰنَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34328,
            "SureId": 55,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "خَلَقَ الْاِنْسَانَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34335,
            "SureId": 55,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "عَلَّمَهُ الْبَیَانَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34342,
            "SureId": 55,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "اَلشَّمْسُ وَالْقَمَرُ بِحُسْبَانٍࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34349,
            "SureId": 55,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "وَالنَّجْمُ وَالشَّجَرُ یَسْجُدَانِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34356,
            "SureId": 55,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "وَالسَّمَٓاءَ رَفَعَهَا وَوَضَعَ الْمٖیزَانَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34363,
            "SureId": 55,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "اَلَّا تَطْغَوْا فِی الْمٖیزَانِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34370,
            "SureId": 55,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "وَاَقٖیمُوا الْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُوا الْمٖیزَانَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34377,
            "SureId": 55,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "وَالْاَرْضَ وَضَعَهَا لِلْاَنَامِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34384,
            "SureId": 55,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "فٖیهَا فَاكِهَةٌࣕ وَالنَّخْلُ ذَاتُ الْاَكْمَامِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34391,
            "SureId": 55,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "وَالْحَبُّ ذُوالْعَصْفِ وَالرَّیْحَانُۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34398,
            "SureId": 55,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "فَبِاَیِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34405,
            "SureId": 55,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "خَلَقَ الْاِنْسَانَ مِنْ صَلْصَالٍ كَالْفَخَّارِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34412,
            "SureId": 55,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "وَخَلَقَ الْجَٓانَّ مِنْ مَارِجٍ مِنْ نَارٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34419,
            "SureId": 55,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "فَبِاَیِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
