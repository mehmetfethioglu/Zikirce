            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34410,
            "SureId": 55,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Cinleri de yalın ateşten yarattı.",
