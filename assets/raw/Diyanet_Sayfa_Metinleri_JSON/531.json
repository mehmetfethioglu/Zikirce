            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Ve bizim buyruğumuz tektir, göz açıp kapayıncaya kadar olup biter.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 54,
                "MealInfo": "Mekke döneminde inmiştir. 55 âyettir. Sûre, adını ilk âyette geçen <b>“el-Kamer” </b>kelimesinden almıştır. <b>Kamer, ay demektir</b>. Sûre de ana fikir olarak, <b>Kur’an’ı yalanlayanlar, çeşitli azap ve helâk örnekleri</b> de verilerek uyarılmaktadır.",
                "SureNameTurkish": "Kamer",
                "SureNameArabic": "الْقَمَرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 37,
                "AyetCount": 55,
                "Cuz": 27,
                "FirstPage": 528,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 34277,
            "SureId": 54,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Andolsun biz sizin nice benzerlerinizi helâk ettik. Düşünecek yok mu?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34284,
            "SureId": 54,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Yaptıkları her şey defterlerde kayıtlıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34291,
            "SureId": 54,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Büyük küçük hepsi satır satır yazılmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34298,
            "SureId": 54,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Takvâ sahipleri cennetlerde ve ırmak kenarlarındadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34305,
            "SureId": 54,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 531,
            "AyetText": "Doğruluğun hâkim olduğu bir ortamda, gücüne sınır olmayan bir hükümdarın huzurundadırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
