    "ArCuzNo": "۲٥",
    "ArPageNo": "٤۹٥",
    "QuranAyats": [
        {
            "Id": 30793,
            "SureId": 43,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "اِنَّ الْمُجْرِمٖینَ فٖی عَذَابِ جَهَنَّمَ خَالِدُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 43,
                "MealInfo": "Mekke döneminde inmiştir. 89 âyettir. Sûre, adını 35. âyette geçen <b>“Zuhruf ” </b>kelimesinden almaktadır. <b>Zuhruf; yaldız, mücevher, dünya hayatının geçici menfaati anlamlarına gelir. </b>Sûrede başlıca tevhit, iman ve vahyin getirdiği hakikatler ile insanların bu hakikatlere ters düşecek şekilde sırf geçici dünya menfaatlerine bağlanarak sergiledikleri çelişki vurgulanmakta, batıla karşı çıkan ve hakkı tutan şahsiyetler olarak İbrahim, Mûsâ ve İsa Peygamberlerden söz edilmektedir.",
                "SureNameTurkish": "Zuhruf",
                "SureNameArabic": "الزُّخْرُفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 63,
                "AyetCount": 89,
                "Cuz": 25,
                "FirstPage": 489,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30800,
            "SureId": 43,
            "AyetId": 75,
            "LanguageId": 7,
            "AyetNumber": "٧٥",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "لَا یُفَتَّرُ عَنْهُمْ وَهُمْ فٖیهِ مُبْلِسُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30807,
            "SureId": 43,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "وَمَا ظَلَمْنَاهُمْ وَلٰكِنْ كَانُوا هُمُ الظَّالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30814,
            "SureId": 43,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "وَنَادَوْا یَا مَالِكُ لِیَقْضِ عَلَیْنَا رَبُّكَؕ قَالَ اِنَّكُمْ مَاكِثُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30821,
            "SureId": 43,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "لَقَدْ جِئْنَاكُمْ بِالْحَقِّ وَلٰكِنَّ اَكْثَرَكُمْ لِلْحَقِّ كَارِهُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30828,
            "SureId": 43,
            "AyetId": 79,
            "LanguageId": 7,
            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "اَمْ اَبْرَمُٓوا اَمْرًا فَاِنَّا مُبْرِمُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30835,
            "SureId": 43,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "اَمْ یَحْسَبُونَ اَنَّا لَا نَسْمَعُ سِرَّهُمْ وَنَجْوٰیهُمْؕ بَلٰى وَرُسُلُنَا لَدَیْهِمْ یَكْتُبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30842,
            "SureId": 43,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "قُلْ اِنْ كَانَ لِلرَّحْمٰنِ وَلَدٌࣗ فَاَنَا𐻾 اَوَّلُ الْعَابِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30849,
            "SureId": 43,
            "AyetId": 82,
            "LanguageId": 7,
            "AyetNumber": "٨٢",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "سُبْحَانَ رَبِّ السَّمٰوَاتِ وَالْاَرْضِ رَبِّ الْعَرْشِ عَمَّا یَصِفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30856,
            "SureId": 43,
            "AyetId": 83,
            "LanguageId": 7,
            "AyetNumber": "٨٣",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "فَذَرْهُمْ یَخُوضُوا وَیَلْعَبُوا حَتّٰى یُلَاقُوا یَوْمَهُمُ الَّذٖی یُوعَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30863,
            "SureId": 43,
            "AyetId": 84,
            "LanguageId": 7,
            "AyetNumber": "٨٤",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "وَهُوَ الَّذٖی فِی السَّمَٓاءِ اِلٰهٌ وَفِی الْاَرْضِ اِلٰهٌؕ وَهُوَ الْحَكٖیمُ الْعَلٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30870,
            "SureId": 43,
            "AyetId": 85,
            "LanguageId": 7,
            "AyetNumber": "٨٥",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "وَتَبَارَكَ الَّذٖی لَهُ مُلْكُ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَیْنَهُمَاۚ وَعِنْدَهُ عِلْمُ السَّاعَةِۚ وَاِلَیْهِ تُرْجَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30877,
            "SureId": 43,
            "AyetId": 86,
            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "وَلَا یَمْلِكُ الَّذٖینَ یَدْعُونَ مِنْ دُونِهِ الشَّفَاعَةَ اِلَّا مَنْ شَهِدَ بِالْحَقِّ وَهُمْ یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30884,
            "SureId": 43,
            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "وَلَئِنْ سَاَلْتَهُمْ مَنْ خَلَقَهُمْ لَیَقُولُنَّ اللّٰهُ فَاَنّٰى یُؤْفَكُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30891,
            "SureId": 43,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "وَقٖیلِهٖ یَا رَبِّ اِنَّ هٰٓؤُ𐻾لَٓاءِ قَوْمٌ لَا یُؤْمِنُونَۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30898,
            "SureId": 43,
            "AyetId": 89,
            "LanguageId": 7,
            "AyetNumber": "٨٩",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "فَاصْفَحْ عَنْهُمْ وَقُلْ سَلَامٌؕ فَسَوْفَ یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 30791,
            "SureId": 43,
            "AyetId": 74,
            "LanguageId": 5,
            "AyetNumber": "74-75",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "Günaha batıp kalmış olanlar kuşkusuz cehennem azabında devamlı kalacaklar, azapları hafifletilmeyecek ve (kurtuluştan) ümit kesip susacaklar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 43,
                "MealInfo": "Mekke döneminde inmiştir. 89 âyettir. Sûre, adını 35. âyette geçen <b>“Zuhruf ” </b>kelimesinden almaktadır. <b>Zuhruf; yaldız, mücevher, dünya hayatının geçici menfaati anlamlarına gelir. </b>Sûrede başlıca tevhit, iman ve vahyin getirdiği hakikatler ile insanların bu hakikatlere ters düşecek şekilde sırf geçici dünya menfaatlerine bağlanarak sergiledikleri çelişki vurgulanmakta, batıla karşı çıkan ve hakkı tutan şahsiyetler olarak İbrahim, Mûsâ ve İsa Peygamberlerden söz edilmektedir.",
                "SureNameTurkish": "Zuhruf",
                "SureNameArabic": "الزُّخْرُفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 63,
                "AyetCount": 89,
                "Cuz": 25,
                "FirstPage": 489,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30798,
            "SureId": 43,
            "AyetId": 75,
            "LanguageId": 5,
            "AyetNumber": "75",
            "AyetVisible": false,
            "Page": 495,
            "AyetText": "Günaha batıp kalmış olanlar kuşkusuz cehennem azabında devamlı kalacaklar, azapları hafifletilmeyecek ve (kurtuluştan) ümit kesip susacaklar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30805,
            "SureId": 43,
            "AyetId": 76,
            "LanguageId": 5,
            "AyetNumber": "76",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "Biz onlara haksızlık etmedik, kendilerine haksızlık edenler onlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30812,
            "SureId": 43,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "“Ey Mâlik, rabbin bizim işimizi bitirsin!” diyecekler; o da “Burada kalıcısınız” cevabını verecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30819,
            "SureId": 43,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "Şüphesiz size gerçeği bildirmiştik, fakat çoğunuz o gerçeği kabul etmek ­istemediniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30826,
            "SureId": 43,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "Onlar bir şeye kesin karar verdilerse biz de vermişizdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30833,
            "SureId": 43,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "Yoksa onlar, gizlediklerini ve fısıldaştıklarını bizim işitmediğimizi mi sanıyorlar! Hayır! Doğrusu şudur ki onların yanındaki elçi meleklerimiz her şeyi kaydediyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30840,
            "SureId": 43,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81-82",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "De ki: “Rahmân’ın çocuğu olsa ona ibadet edenlerin başında ben olurum. Göklerin ve yerin rabbini, arşın rabbini onların yakıştırdığı niteliklerden tenzih ederim”.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30847,
            "SureId": 43,
            "AyetId": 82,
            "LanguageId": 5,
            "AyetNumber": "82",
            "AyetVisible": false,
            "Page": 495,
            "AyetText": "\"Rahmânın çocuğu olsa ona ibadet edenlerin başında ben olurum. Göklerin ve yerin rabbini, arşın rabbini onların yakıştırdığı niteliklerden tenzih ederim\" de.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30854,
            "SureId": 43,
            "AyetId": 83,
            "LanguageId": 5,
            "AyetNumber": "83",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "Geleceği kendilerine söylenen günlerine ulaşıncaya kadar bırak onları dünyaya dalıp eğlensinler!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30861,
            "SureId": 43,
            "AyetId": 84,
            "LanguageId": 5,
            "AyetNumber": "84",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "Gökteki ilâh da O’dur, yerdeki ilâh da O’dur. O sınırsız hikmet ve ilim sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30868,
            "SureId": 43,
            "AyetId": 85,
            "LanguageId": 5,
            "AyetNumber": "85",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "Göklerin, yerin ve bunlar arasında bulunanların mülkiyeti kendisinin olan, kıyametin kopacağı zamanı yalnızca kendisi bilen ve kendisine döneceğiniz Allah’ın şanı ne yücedir!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30875,
            "SureId": 43,
            "AyetId": 86,
            "LanguageId": 5,
            "AyetNumber": "86",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "Allah’ı bırakıp kendilerine dua ettikleri varlıklar asla şefaat edemezler; bilerek hakka tanıklık edenler başka.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30882,
            "SureId": 43,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "“Onları kim yarattı?” diye sorsan kuşkusuz “Allah yarattı” diyecekler. Şu halde (Allah’ı bırakıp) nasıl onlara dönebiliyorlar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30889,
            "SureId": 43,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "Allah, peygamberin “Ey rabbim! Bunlar iman etmemekte direnen bir topluluk” dediğini de biliyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30896,
            "SureId": 43,
            "AyetId": 89,
            "LanguageId": 5,
            "AyetNumber": "89",
            "AyetVisible": true,
            "Page": 495,
            "AyetText": "Onları bırak ve “Sizinle kavgam yok” de. Yakında bilecekler!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Zuhruf",
    "QuranSureLabel": "الزُّخْرُفِ",
    "EndPageSure": null
}