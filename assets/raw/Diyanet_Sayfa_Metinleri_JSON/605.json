                "FirstPage": 605,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 43587,
            "SureId": 113,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 605,
            "AyetText": "Yarattığı şeylerden gelebilecek kötülüklerden;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43594,
            "SureId": 113,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 605,
            "AyetText": "Karanlığı çöktüğü zaman gecenin şerrinden;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43601,
            "SureId": 113,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 605,
            "AyetText": "Düğümlere üfürenlerin şerrinden;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43608,
            "SureId": 113,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 605,
            "AyetText": "Bir de kıskandığı vakit kıskanç kişinin şerrinden!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
