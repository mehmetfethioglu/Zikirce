            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 605,
            "AyetText": "De ki: “Sabahın rabbine sığınırım;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 113,
                "MealInfo": "Medine döneminde inmiştir. 5 âyettir. Felâk, sabah aydınlığı demektir",
