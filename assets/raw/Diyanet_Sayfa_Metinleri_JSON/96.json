            "AyetNumber": "١٠٦",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "وَاسْتَغْفِرِ اللّٰهَؕ اِنَّ اللّٰهَ كَانَ غَفُورًا رَحٖیمًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 4,
                "MealInfo": "Medine döneminde inmiştir. 176 âyettir. Sûre, özellikle kadın haklarından,onların hukûkî ve sosyal konumlarından bahsettiği için bu adı almıştır. <b>“Nisâ” kadınlar demektir.</b>",
                "SureNameTurkish": "Nisâ",
                "SureNameArabic": "النِّسَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 92,
                "AyetCount": 176,
                "Cuz": 4,
                "FirstPage": 77,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 4200,
            "SureId": 4,
            "AyetId": 107,
            "LanguageId": 7,
            "AyetNumber": "١٠٧",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "وَلَا تُجَادِلْ عَنِ الَّذٖینَ یَخْتَانُونَ اَنْفُسَهُمْؕ اِنَّ اللّٰهَ لَا یُحِبُّ مَنْ كَانَ خَوَّانًا اَثٖیمًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 4207,
            "SureId": 4,
            "AyetId": 108,
            "LanguageId": 7,
            "AyetNumber": "١٠٨",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "یَسْتَخْفُونَ مِنَ النَّاسِ وَلَا یَسْتَخْفُونَ مِنَ اللّٰهِ وَهُوَ مَعَهُمْ اِذْ یُبَیِّتُونَ مَا لَا یَرْضٰى مِنَ الْقَوْلِؕ وَكَانَ اللّٰهُ بِمَا یَعْمَلُونَ مُحٖیطًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 4214,
            "SureId": 4,
            "AyetId": 109,
            "LanguageId": 7,
            "AyetNumber": "١٠٩",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "هَٓا اَنْتُمْ هٰٓؤُ𐻾لَٓاءِ جَادَلْتُمْ عَنْهُمْ فِی الْحَیٰوةِ الدُّنْیَا فَمَنْ یُجَادِلُ اللّٰهَ عَنْهُمْ یَوْمَ الْقِیٰمَةِ اَمْ مَنْ یَكُونُ عَلَیْهِمْ وَكٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 4221,
            "SureId": 4,
            "AyetId": 110,
            "LanguageId": 7,
            "AyetNumber": "١١٠",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "وَمَنْ یَعْمَلْ سُٓوءًا اَوْ یَظْلِمْ نَفْسَهُ ثُمَّ یَسْتَغْفِرِ اللّٰهَ یَجِدِ اللّٰهَ غَفُورًا رَحٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 4228,
            "SureId": 4,
            "AyetId": 111,
            "LanguageId": 7,
            "AyetNumber": "١١١",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "وَمَنْ یَكْسِبْ اِثْمًا فَاِنَّمَا یَكْسِبُهُ عَلٰى نَفْسِهٖؕ وَكَانَ اللّٰهُ عَلٖیمًا حَكٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 4235,
            "SureId": 4,
            "AyetId": 112,
            "LanguageId": 7,
            "AyetNumber": "١١٢",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "وَمَنْ یَكْسِبْ خَطٖٓیـَٔةً اَوْ اِثْمًا ثُمَّ یَرْمِ بِهٖ بَرٖٓیـًٔا فَقَدِ احْتَمَلَ بُهْتَانًا وَاِثْمًا مُبٖینًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 4242,
            "SureId": 4,
            "AyetId": 113,
            "LanguageId": 7,
            "AyetNumber": "١١٣",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "وَلَوْلَا فَضْلُ اللّٰهِ عَلَیْكَ وَرَحْمَتُهُ لَهَمَّتْ طَٓائِفَةٌ مِنْهُمْ اَنْ یُضِلُّوكَؕ وَمَا یُضِلُّونَ اِلَّٓا اَنْفُسَهُمْ وَمَا یَضُرُّونَكَ مِنْ شَیْءٍؕ وَاَنْزَلَ اللّٰهُ عَلَیْكَ الْكِتَابَ وَالْحِكْمَةَ وَعَلَّمَكَ مَا لَمْ تَكُنْ تَعْلَمُؕ وَكَانَ فَضْلُ اللّٰهِ عَلَیْكَ عَظٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 4191,
            "SureId": 4,
            "AyetId": 106,
            "LanguageId": 5,
            "AyetNumber": "106",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "Allah’tan mağfiret dile. Şüphesiz Allah çok bağışlayıcı, ziyadesiyle esirgeyicidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 4,
                "MealInfo": "Medine döneminde inmiştir. 176 âyettir. Sûre, özellikle kadın haklarından,onların hukûkî ve sosyal konumlarından bahsettiği için bu adı almıştır. <b>“Nisâ” kadınlar demektir.</b>",
                "SureNameTurkish": "Nisâ",
                "SureNameArabic": "النِّسَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 92,
                "AyetCount": 176,
                "Cuz": 4,
                "FirstPage": 77,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 4198,
            "SureId": 4,
            "AyetId": 107,
            "LanguageId": 5,
            "AyetNumber": "107",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "Kendilerine hıyanet edenleri savunma. Çünkü Allah, hainlik edenleri, günahta ısrarcı olanları sevmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 4205,
            "SureId": 4,
            "AyetId": 108,
            "LanguageId": 5,
            "AyetNumber": "108",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "İnsanlardan gizlerler de -razı olmadığı sözü geceden kurup düzdüklerinde yanlarında olan- Allah’tan gizleyemezler. Allah onların bütün yapıp ettiklerini kuşatmaktadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 4212,
            "SureId": 4,
            "AyetId": 109,
            "LanguageId": 5,
            "AyetNumber": "109",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "Haydi siz dünya hayatında onlara taraf çıkıp savundunuz; ama kıyamet günü Allah’a karşı onları kim savunacak yahut onlara kim vekil olacak?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 4219,
            "SureId": 4,
            "AyetId": 110,
            "LanguageId": 5,
            "AyetNumber": "110",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "Kim bir kötülük yapar veya nefsine zulmeder de sonra Allah’tan mağfiret dilerse, Allah’ı çok bağışlayıcı ve esirgeyici bulacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 4226,
            "SureId": 4,
            "AyetId": 111,
            "LanguageId": 5,
            "AyetNumber": "111",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "Kim bir günah işlerse onu ancak kendi aleyhine işlemiş olur. Allah her şeyi bilmektedir, büyük hikmet sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 4233,
            "SureId": 4,
            "AyetId": 112,
            "LanguageId": 5,
            "AyetNumber": "112",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "Kim de bir hata veya günah işler, sonra onu bir suçsuzun üzerine atarsa şüphesiz ağır bir iftira suçunu ve apaçık bir günahı yüklenmiş olur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 4240,
            "SureId": 4,
            "AyetId": 113,
            "LanguageId": 5,
            "AyetNumber": "113",
            "AyetVisible": true,
            "Page": 96,
            "AyetText": "Allah’ın sana lütfu ve esirgemesi olmasaydı onlardan bir güruh seni yanıltmaya yeltenmişti; hâlbuki onlar ancak kendilerini saptırırlar, sana hiçbir zarar veremezler. Allah sana kitabı ve hikmeti indirmiş, bilmediğini sana öğretmiştir. Sana Allah’ın lütfu gerçekten büyük olmuştur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
