    "QuranAyats": [
        {
            "Id": 22274,
            "SureId": 27,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "اِنّٖی وَجَدْتُ امْرَاَةً تَمْلِكُهُمْ وَاُو𐻿تِیَتْ مِنْ كُلِّ شَیْءٍ وَلَهَا عَرْشٌ عَظٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 27,
                "MealInfo": "Mekke döneminde inmiştir. 93 âyettir. Sûre, adını 18. âyette yer alan <b>“enNeml</b>” kelimesinden almaktadır. <b>Neml, karınca demektir. </b>Sûre de başlıca, <b>Süleyman peygamber ve Sebe’ melikesi, Belkıs kıssası ile Salih ve Lût peygamberler&nbsp;</b>konu edilmekte, ayrıca mü’minlerin kurtuluşa ereceği, İslâm karşıtlarının kötü akıbetleri, öldükten sonra dirilmek ve kıyamet dile getirilmektedir.",
                "SureNameTurkish": "Neml",
                "SureNameArabic": "النَّمْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 48,
                "AyetCount": 93,
                "Cuz": 19,
                "FirstPage": 377,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 22281,
            "SureId": 27,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "وَجَدْتُهَا وَقَوْمَهَا یَسْجُدُونَ لِلشَّمْسِ مِنْ دُونِ اللّٰهِ وَزَیَّنَ لَهُمُ الشَّیْطَانُ اَعْمَالَهُمْ فَصَدَّهُمْ عَنِ السَّبٖیلِ فَهُمْ لَا یَهْتَدُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22288,
            "SureId": 27,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "اَلَّا یَسْجُدُوا لِلّٰهِ الَّذٖی یُخْرِجُ الْخَبْءَ فِی السَّمٰوَاتِ وَالْاَرْضِ وَیَعْلَمُ مَا تُخْفُونَ وَمَا تُعْلِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22295,
            "SureId": 27,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "اَللّٰهُ لَٓا اِلٰهَ اِلَّا هُوَ رَبُّ الْعَرْشِ الْعَظٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22302,
            "SureId": 27,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "قَالَ سَنَنْظُرُ اَصَدَقْتَ اَمْ كُنْتَ مِنَ الْكَاذِبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22309,
            "SureId": 27,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "اِذْهَبْ بِكِتَابٖی هٰذَا فَاَلْقِهْ اِلَیْهِمْ ثُمَّ تَوَلَّ عَنْهُمْ فَانْظُرْ مَاذَا یَرْجِعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22316,
            "SureId": 27,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "قَالَتْ یَٓا اَیُّهَا الْمَلَؤُ𐻾ا اِنّٖٓی اُلْقِیَ اِلَیَّ كِتَابٌ كَرٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22323,
            "SureId": 27,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "اِنَّهُ مِنْ سُلَیْمٰنَ وَاِنَّهُ بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحٖیمِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22330,
            "SureId": 27,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "اَلَّا تَعْلُوا عَلَیَّ وَاْتُونٖی مُسْلِمٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22337,
            "SureId": 27,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "قَالَتْ یَٓا اَیُّهَا الْمَلَؤُ𐻾ا اَفْتُونٖی فٖٓی اَمْرٖیۚ مَا كُنْتُ قَاطِعَةً اَمْرًا حَتّٰى تَشْهَدُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22344,
            "SureId": 27,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "قَالُوا نَحْنُ اُو𐻾لُوا قُوَّةٍ وَاُو𐻾لُوا بَاْسٍ شَدٖیدٍ وَالْاَمْرُ اِلَیْكِ فَانْظُرٖی مَاذَا تَاْمُرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22351,
            "SureId": 27,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "قَالَتْ اِنَّ الْمُلُوكَ اِذَا دَخَلُوا قَرْیَةً اَفْسَدُوهَا وَجَعَلُٓوا اَعِزَّةَ اَهْلِهَٓا اَذِلَّةًۚ وَكَذٰلِكَ یَفْعَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22358,
            "SureId": 27,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "وَاِنّٖی مُرْسِلَةٌ اِلَیْهِمْ بِهَدِیَّةٍ فَنَاظِرَةٌ بِمَ یَرْجِعُ الْمُرْسَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 22272,
            "SureId": 27,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "“Onları bir kadın hükümdarın yönettiğini gördüm; kendisine her imkân verilmiş; bir de muhteşem tahtı var.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 27,
                "MealInfo": "Mekke döneminde inmiştir. 93 âyettir. Sûre, adını 18. âyette yer alan <b>“enNeml</b>” kelimesinden almaktadır. <b>Neml, karınca demektir. </b>Sûre de başlıca, <b>Süleyman peygamber ve Sebe’ melikesi, Belkıs kıssası ile Salih ve Lût peygamberler&nbsp;</b>konu edilmekte, ayrıca mü’minlerin kurtuluşa ereceği, İslâm karşıtlarının kötü akıbetleri, öldükten sonra dirilmek ve kıyamet dile getirilmektedir.",
                "SureNameTurkish": "Neml",
                "SureNameArabic": "النَّمْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 48,
                "AyetCount": 93,
                "Cuz": 19,
                "FirstPage": 377,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 22279,
            "SureId": 27,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "Ancak onun ve halkının Allah’ı bırakıp güneşe taptıklarını da gördüm. Şeytan onlara yaptıklarını güzel göstermiş, böylece onları yoldan alıkoymuş; bu yüzden doğru yolu bulamıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22286,
            "SureId": 27,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "(Şeytan bunu) göklerde ve yerde gizli olanı açığa çıkaran, gizlediğinizi ve açıkladığınızı bilen Allah’a secde etmesinler, diye yapmış.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22293,
            "SureId": 27,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "Oysa büyük arşın sahibi olan Allah’tan başka tanrı yoktur.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22300,
            "SureId": 27,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "Süleyman da, “Doğru mu söylüyorsun yoksa yalancılardan biri misin, göreceğiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22307,
            "SureId": 27,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "Şu mektubumu götür, önlerine bırak, sonra onların yanından çekil de ne sonuca varacaklarına bak.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22314,
            "SureId": 27,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "Sebe melikesi (adamlarına) şöyle dedi: “Beyler! Bana çok önemli bir mektup gönderilmiş!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22321,
            "SureId": 27,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "Mektup Süleyman’dan gelmekte, rahmân ve rahîm olan Allah’ın adıyla ­başlamaktadır;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22328,
            "SureId": 27,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "‘Bana üstünlük taslamayın, gelip bana teslim olun’ denilmektedir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22335,
            "SureId": 27,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "Kraliçe şöyle dedi: “Efendiler! İçinde bulunduğum durum hakkında bana görüşünüzü açıklayın. Sizin görüşünüzü almadan asla bir işe kesin karar vermem.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22342,
            "SureId": 27,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "Şu cevabı verdiler: “Biz güçlüyüz, zorlu savaşçılarız, yine de yetki senindir; artık ne buyuracağını sen düşün.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22349,
            "SureId": 27,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "Kraliçe şöyle dedi: “Krallar bir ülkeye girdiler mi, oranın altını üstüne getirirler ve halkının ulularını aşağılanmış duruma düşürürler. Bunlar da öyle yapacaklardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22356,
            "SureId": 27,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 379,
            "AyetText": "Ben bunlara bir hediye göndereceğim, sonra bakacağım elçiler ne ile dönecekler?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
