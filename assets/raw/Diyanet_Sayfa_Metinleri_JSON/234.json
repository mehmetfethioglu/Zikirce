    "QuranAyats": [
        {
            "Id": 11074,
            "SureId": 11,
            "AyetId": 109,
            "LanguageId": 7,
            "AyetNumber": "١٠٩",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "فَلَا تَكُ فٖی مِرْیَةٍ مِمَّا یَعْبُدُ هٰٓؤُ𐻾لَٓاءِؕ مَا یَعْبُدُونَ اِلَّا كَمَا یَعْبُدُ اٰبَٓاؤُ𐻾هُمْ مِنْ قَبْلُؕ وَاِنَّا لَمُوَفُّوهُمْ نَصٖیبَهُمْ غَیْرَ مَنْقُوصٍࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 11,
                "MealInfo": "Mekke döneminde inmiştir. 123 âyettir. Sûre, adını içinde söz konusu edilen Hûd peygamberden almıştır. Sûre de başlıca tevhit, peygamberlik, öldükten sonra dirilme ve ceza konuları ele alınmakta ve bunlar bazı peygamberlerin kıssalarıyla desteklenmektedir.",
                "SureNameTurkish": "Hûd",
                "SureNameArabic": "هُودٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 52,
                "AyetCount": 123,
                "Cuz": 11,
                "FirstPage": 221,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11081,
            "SureId": 11,
            "AyetId": 110,
            "LanguageId": 7,
            "AyetNumber": "١١٠",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "وَلَقَدْ اٰتَیْنَا مُوسَى الْكِتَابَ فَاخْتُلِفَ فٖیهِؕ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِیَ بَیْنَهُمْؕ وَاِنَّهُمْ لَفٖی شَكٍّ مِنْهُ مُرٖیبٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11088,
            "SureId": 11,
            "AyetId": 111,
            "LanguageId": 7,
            "AyetNumber": "١١١",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "وَاِنَّ كُلًّا لَمَّا لَیُوَفِّیَنَّهُمْ رَبُّكَ اَعْمَالَهُمْؕ اِنَّهُ بِمَا یَعْمَلُونَ خَبٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11095,
            "SureId": 11,
            "AyetId": 112,
            "LanguageId": 7,
            "AyetNumber": "١١٢",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "فَاسْتَقِمْ كَمَٓا اُمِرْتَ وَمَنْ تَابَ مَعَكَ وَلَا تَطْغَوْاؕ اِنَّهُ بِمَا تَعْمَلُونَ بَصٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11102,
            "SureId": 11,
            "AyetId": 113,
            "LanguageId": 7,
            "AyetNumber": "١١٣",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "وَلَا تَرْكَنُٓوا اِلَى الَّذٖینَ ظَلَمُوا فَتَمَسَّكُمُ النَّارُۙ وَمَا لَكُمْ مِنْ دُونِ اللّٰهِ مِنْ اَوْلِیَٓاءَ ثُمَّ لَا تُنْصَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11109,
            "SureId": 11,
            "AyetId": 114,
            "LanguageId": 7,
            "AyetNumber": "١١٤",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "وَاَقِمِ الصَّلٰوةَ طَرَفَیِ النَّهَارِ وَزُلَفًا مِنَ الَّیْلِؕ اِنَّ الْحَسَنَاتِ یُذْهِبْنَ السَّیِّــَٔاتِؕ ذٰلِكَ ذِكْرٰى لِلذَّاكِرٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11116,
            "SureId": 11,
            "AyetId": 115,
            "LanguageId": 7,
            "AyetNumber": "١١٥",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "وَاصْبِرْ فَاِنَّ اللّٰهَ لَا یُضٖیعُ اَجْرَ الْمُحْسِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11123,
            "SureId": 11,
            "AyetId": 116,
            "LanguageId": 7,
            "AyetNumber": "١١٦",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "فَلَوْلَا كَانَ مِنَ الْقُرُونِ مِنْ قَبْلِكُمْ اُو𐻾لُوا بَقِیَّةٍ یَنْهَوْنَ عَنِ الْفَسَادِ فِی الْاَرْضِ اِلَّا قَلٖیلًا مِمَّنْ اَنْجَیْنَا مِنْهُمْۚ وَاتَّبَعَ الَّذٖینَ ظَلَمُوا مَٓا اُتْرِفُوا فٖیهِ وَكَانُوا مُجْرِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11130,
            "SureId": 11,
            "AyetId": 117,
            "LanguageId": 7,
            "AyetNumber": "١١٧",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "وَمَا كَانَ رَبُّكَ لِیُهْلِكَ الْقُرٰى بِظُلْمٍ وَاَهْلُهَا مُصْلِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 11072,
            "SureId": 11,
            "AyetId": 109,
            "LanguageId": 5,
            "AyetNumber": "109",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "O halde onların taptıklarının boş şeyler olduğundan şüphen olmasın; onlar daha önce babalarının tapındığı gibi tapınmaktan başka bir şey yapmıyorlar. Biz onların hak ettiklerini elbette eksiksiz olarak vereceğiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 11,
                "MealInfo": "Mekke döneminde inmiştir. 123 âyettir. Sûre, adını içinde söz konusu edilen Hûd peygamberden almıştır. Sûre de başlıca tevhit, peygamberlik, öldükten sonra dirilme ve ceza konuları ele alınmakta ve bunlar bazı peygamberlerin kıssalarıyla desteklenmektedir.",
                "SureNameTurkish": "Hûd",
                "SureNameArabic": "هُودٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 52,
                "AyetCount": 123,
                "Cuz": 11,
                "FirstPage": 221,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11079,
            "SureId": 11,
            "AyetId": 110,
            "LanguageId": 5,
            "AyetNumber": "110",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "Gerçek şu ki biz Mûsâ’ya da kitabı vermiştik; onda da ihtilâfa düşüldü. Eğer rabbin tarafından daha önce verilmiş bir söz olmasaydı işleri bitirilirdi. Onlar kitap hakkında derin bir şüphe içindedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11086,
            "SureId": 11,
            "AyetId": 111,
            "LanguageId": 5,
            "AyetNumber": "111",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "Şüphesiz rabbin, onların her birine yaptıklarının karşılığını tam olarak verecektir. Rabbin, onların yapmakta olduklarından haberdardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11093,
            "SureId": 11,
            "AyetId": 112,
            "LanguageId": 5,
            "AyetNumber": "112",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "Senin yanında hak yola dönenlerle birlikte, sana buyurulduğu gibi dosdoğru ol! Siz de azıp sapmayın. Allah, yaptıklarınızı çok iyi görmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11100,
            "SureId": 11,
            "AyetId": 113,
            "LanguageId": 5,
            "AyetNumber": "113",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "Zalimlerin yanında olmayın; sonra ateş sizi de yakar. Allah’tan başka dostlarınız olmadığına göre bir yerden yardım da göremezsiniz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11107,
            "SureId": 11,
            "AyetId": 114,
            "LanguageId": 5,
            "AyetNumber": "114",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "Gündüzün iki tarafında, gecenin de gündüze yakın saatlerinde namaz kılın. Şüphesiz ki iyilikler kötülükleri yok eder. İşte bu, öğüt almak isteyenler için bir hatırlatmadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11114,
            "SureId": 11,
            "AyetId": 115,
            "LanguageId": 5,
            "AyetNumber": "115",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "Sabret! Allah güzel davrananların mükâfatını zayi etmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11121,
            "SureId": 11,
            "AyetId": 116,
            "LanguageId": 5,
            "AyetNumber": "116",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "Sizden önceki toplumlar içinde yeryüzünde bozgunculuğu önleyecek birikimli kimseler bulunsaydı ya! Onlardan, kurtuluşa erdirdiğimiz az bir kesim bunu yaptı. Zulmedenlerse içinde şımartıldıkları refahın peşine düşüp günahkâr oldular.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11128,
            "SureId": 11,
            "AyetId": 117,
            "LanguageId": 5,
            "AyetNumber": "117",
            "AyetVisible": true,
            "Page": 234,
            "AyetText": "Rabbin, halkı iyilik peşinde olan ülkeleri haksız yere helâk edecek değildir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Hûd",
    "QuranSureLabel": "هُودٍ",
    "EndPageSure": null
}