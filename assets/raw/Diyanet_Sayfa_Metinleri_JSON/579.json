{
    "PointerList": null,
    "CuzNo": 29,
    "PageNo": 579,
    "ArCuzNo": "۲۹",
    "ArPageNo": "٥۷۹",
    "QuranAyats": [
        {
            "Id": 39179,
            "SureId": 76,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "عَیْنًا یَشْرَبُ بِهَا عِبَادُ اللّٰهِ یُفَجِّرُونَهَا تَفْجٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 76,
                "MealInfo": "Medine döneminde inmiştir. 31 âyettir. Sûre, adını birinci âyetteki “insan” kelimesindenalmıştır. Aynı âyette geçen “ed-Dehr” kelimesinden dolayı Dehrsûresi diye de anılır. Dehr, zaman demektir. Sûrede başlıca, ahiret hayatıyla ilgilimeseleler ve özellikle takva sahiplerinin cennette kavuşacakları çeşitli nimetlerkonu edilmektedir.",
                "SureNameTurkish": "İnsân",
                "SureNameArabic": "الْاِنْسَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 98,
                "AyetCount": 31,
                "Cuz": 29,
                "FirstPage": 578,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 39186,
            "SureId": 76,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "یُوفُونَ بِالنَّذْرِ وَیَخَافُونَ یَوْمًا كَانَ شَرُّهُ مُسْتَطٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39193,
            "SureId": 76,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "وَیُطْعِمُونَ الطَّعَامَ عَلٰى حُبِّهٖ مِسْكٖینًا وَیَتٖیمًا وَاَسٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39200,
            "SureId": 76,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "اِنَّمَا نُطْعِمُكُمْ لِوَجْهِ اللّٰهِ لَا نُرٖیدُ مِنْكُمْ جَزَٓاءً وَلَا شُكُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39207,
            "SureId": 76,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "اِنَّا نَخَافُ مِنْ رَبِّنَا یَوْمًا عَبُوسًا قَمْطَرٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39214,
            "SureId": 76,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "فَوَقٰیهُمُ اللّٰهُ شَرَّ ذٰلِكَ الْیَوْمِ وَلَقّٰیهُمْ نَضْرَةً وَسُرُورًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39221,
            "SureId": 76,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "وَجَزٰیهُمْ بِمَا صَبَرُوا جَنَّةً وَحَرٖیرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39228,
            "SureId": 76,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "مُتَّكِــٖٔینَ فٖیهَا عَلَى الْاَرَٓائِكِۚ لَا یَرَوْنَ فٖیهَا شَمْسًا وَلَا زَمْهَرٖیرًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39235,
            "SureId": 76,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "وَدَانِیَةً عَلَیْهِمْ ظِلَالُهَا وَذُلِّلَتْ قُطُوفُهَا تَذْلٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39242,
            "SureId": 76,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "وَیُطَافُ عَلَیْهِمْ بِاٰنِیَةٍ مِنْ فِضَّةٍ وَاَكْوَابٍ كَانَتْ قَوَارٖیرَاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39249,
            "SureId": 76,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "قَوَارٖیرَ مِنْ فِضَّةٍ قَدَّرُوهَا تَقْدٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39256,
            "SureId": 76,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "وَیُسْقَوْنَ فٖیهَا كَاْسًا كَانَ مِزَاجُهَا زَنْجَبٖیلًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39263,
            "SureId": 76,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "عَیْنًا فٖیهَا تُسَمّٰى سَلْسَبٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39270,
            "SureId": 76,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "وَیَطُوفُ عَلَیْهِمْ وِلْدَانٌ مُخَلَّدُونَۚ اِذَا رَاَیْتَهُمْ حَسِبْتَهُمْ لُؤْلُؤً𐻾ا مَنْثُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39277,
            "SureId": 76,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "وَاِذَا رَاَیْتَ ثَمَّ رَاَیْتَ نَعٖیمًا وَمُلْكًا كَبٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39284,
            "SureId": 76,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "عَالِیَهُمْ ثِیَابُ سُنْدُسٍ خُضْرٌ وَاِسْتَبْرَقٌؗ وَحُلُّٓوا اَسَاوِرَ مِنْ فِضَّةٍۚ وَسَقٰیهُمْ رَبُّهُمْ شَرَابًا طَهُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39291,
            "SureId": 76,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "اِنَّ هٰذَا كَانَ لَكُمْ جَزَٓاءً وَكَانَ سَعْیُكُمْ مَشْكُورًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39298,
            "SureId": 76,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "اِنَّا نَحْنُ نَزَّلْنَا عَلَیْكَ الْقُرْاٰنَ تَنْزٖیلًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39305,
            "SureId": 76,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تُطِعْ مِنْهُمْ اٰثِمًا اَوْ كَفُورًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39312,
            "SureId": 76,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "وَاذْكُرِ اسْمَ رَبِّكَ بُكْرَةً وَاَصٖیلًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 39177,
            "SureId": 76,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Bir su kaynağı ki Allah’ın has kulları istedikleri yerlere akıtarak ondan bol bol içerler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 76,
                "MealInfo": "Medine döneminde inmiştir. 31 âyettir. Sûre, adını birinci âyetteki “insan” kelimesindenalmıştır. Aynı âyette geçen “ed-Dehr” kelimesinden dolayı Dehrsûresi diye de anılır. Dehr, zaman demektir. Sûrede başlıca, ahiret hayatıyla ilgilimeseleler ve özellikle takva sahiplerinin cennette kavuşacakları çeşitli nimetlerkonu edilmektedir.",
                "SureNameTurkish": "İnsân",
                "SureNameArabic": "الْاِنْسَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 98,
                "AyetCount": 31,
                "Cuz": 29,
                "FirstPage": 578,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 39184,
            "SureId": 76,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Onlar, verdikleri sözü yerine getirirler ve dehşeti her yerde hissedilen bir günden korkarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39191,
            "SureId": 76,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Onlar, kendileri (yemek) istedikleri halde yiyeceği yoksula, yetime ve esire ikram ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39198,
            "SureId": 76,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "(Ve şöyle derler:) “Biz sizi Allah rızâsı için doyuruyoruz; sizden ne bir karşılık ne de bir teşekkür bekliyoruz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39205,
            "SureId": 76,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Biz, dehşetli, çetin bir günde rabbimizden korkarız.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39212,
            "SureId": 76,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Bu tutumları sebebiyle Allah onları o günün dehşetinden korur; yüzlerine aydınlık, gönüllerine sürur verir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39219,
            "SureId": 76,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Sabretmelerine karşılık onları cennetle ve ipekli giysilerle ödüllendirir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39226,
            "SureId": 76,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Orada koltuklara kurulurlar. Ne yakıcı güneş görürler orada ne de dondurucu soğuk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39233,
            "SureId": 76,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Ağaçların gölgesi hemen üzerlerinde, meyveleri emirlerine âmâde kılınmış.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39240,
            "SureId": 76,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15-16",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Her birinin etrafında gümüş kaplar, billûr kadehler, gümüş beyazlığında şeffaf kupalar dolaştırılır; ölçülerini de isteklerine göre belirlerler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39247,
            "SureId": 76,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": false,
            "Page": 579,
            "AyetText": "Her birinin etrafında gümüş kaplar, billûr kadehler, gümüş beyazlığında şeffaf kupalar dolaştırılır; ölçülerini de isteklerine göre belirlerler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39254,
            "SureId": 76,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Ayrıca kendilerine orada zencefil karışımlı dolu bir kadeh sunulur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39261,
            "SureId": 76,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Oradaki selsebil denilen bir pınardan.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39268,
            "SureId": 76,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Her birinin etrafında ölümsüz gençler pervane olur. Baktığında onları etrafa saçılmış inciler sanırsın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39275,
            "SureId": 76,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Orada etrafa göz gezdirdiğinde benzersiz nimetler ve muhteşem bir saltanat ­görürsün.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39282,
            "SureId": 76,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Oradakilerin üzerlerinde yeşil renkli, ince ve kalın ipek elbiseler vardır; gümüş bileziklerle süslenmişlerdir, rableri onlara tertemiz bir içecek verir;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39289,
            "SureId": 76,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "“Bunlar sizin ödülünüzdür, çabanız boşa gitmemiştir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39296,
            "SureId": 76,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Kur’an’ı sana biz, evet biz vahyederek indirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39303,
            "SureId": 76,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Öyleyse rabbinin hükmüne sabret; onlardan hiçbir günahkâra yahut nanköre boyun eğme.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39310,
            "SureId": 76,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 579,
            "AyetText": "Sabah akşam rabbinin adını an.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "İnsân",
    "QuranSureLabel": "الْاِنْسَانِ",
    "EndPageSure": null
}