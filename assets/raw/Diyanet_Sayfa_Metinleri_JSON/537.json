    "QuranAyats": [
        {
            "Id": 35392,
            "SureId": 56,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "اِنَّهُ لَقُرْاٰنٌ كَرٖیمٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 56,
                "MealInfo": "Mekke döneminde inmiştir. 96 âyettir. Sûre, adını birinci âyette geçen<b> “elvâkı’a”</b> kelimesinden almıştır.<b> Vâkı’a, gerçekleşen, meydana gelen olay demektir</b>. Burada kıyameti ifade etmektedir. Sûrede başlıca, <b>kıyametin kopmasından önceki ve sonraki dehşetli hâller ve insanların amellerine göre içinde yer alacağı gruplar </b>konu edilmektedir.",
                "SureNameTurkish": "Vâkıa",
                "SureNameArabic": "الْوَاقِعَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 46,
                "AyetCount": 96,
                "Cuz": 27,
                "FirstPage": 534,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 35399,
            "SureId": 56,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "فٖی كِتَابٍ مَكْنُونٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35406,
            "SureId": 56,
            "AyetId": 79,
            "LanguageId": 7,
            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "لَا یَمَسُّهُٓ اِلَّا الْمُطَهَّرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35413,
            "SureId": 56,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "تَنْزٖیلٌ مِنْ رَبِّ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35420,
            "SureId": 56,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "اَفَبِهٰذَا الْحَدٖیثِ اَنْتُمْ مُدْهِنُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35427,
            "SureId": 56,
            "AyetId": 82,
            "LanguageId": 7,
            "AyetNumber": "٨٢",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "وَتَجْعَلُونَ رِزْقَكُمْ اَنَّكُمْ تُكَذِّبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35434,
            "SureId": 56,
            "AyetId": 83,
            "LanguageId": 7,
            "AyetNumber": "٨٣",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "فَلَوْلَٓا اِذَا بَلَغَتِ الْحُلْقُومَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35441,
            "SureId": 56,
            "AyetId": 84,
            "LanguageId": 7,
            "AyetNumber": "٨٤",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "وَاَنْتُمْ حٖینَئِذٍ تَنْظُرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35448,
            "SureId": 56,
            "AyetId": 85,
            "LanguageId": 7,
            "AyetNumber": "٨٥",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "وَنَحْنُ اَقْرَبُ اِلَیْهِ مِنْكُمْ وَلٰكِنْ لَا تُبْصِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35455,
            "SureId": 56,
            "AyetId": 86,
            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "فَلَوْلَٓا اِنْ كُنْتُمْ غَیْرَ مَدٖینٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35462,
            "SureId": 56,
            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "تَرْجِعُونَهَٓا اِنْ كُنْتُمْ صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35469,
            "SureId": 56,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "فَاَمَّٓا اِنْ كَانَ مِنَ الْمُقَرَّبٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35476,
            "SureId": 56,
            "AyetId": 89,
            "LanguageId": 7,
            "AyetNumber": "٨٩",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "فَرَوْحٌ وَرَیْحَانٌ وَجَنَّتُ نَعٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35483,
            "SureId": 56,
            "AyetId": 90,
            "LanguageId": 7,
            "AyetNumber": "٩٠",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "وَاَمَّٓا اِنْ كَانَ مِنْ اَصْحَابِ الْیَمٖینِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35490,
            "SureId": 56,
            "AyetId": 91,
            "LanguageId": 7,
            "AyetNumber": "٩١",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "فَسَلَامٌ لَكَ مِنْ اَصْحَابِ الْیَمٖینِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35497,
            "SureId": 56,
            "AyetId": 92,
            "LanguageId": 7,
            "AyetNumber": "٩٢",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "وَاَمَّٓا اِنْ كَانَ مِنَ الْمُكَذِّبٖینَ الضَّٓالّٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35504,
            "SureId": 56,
            "AyetId": 93,
            "LanguageId": 7,
            "AyetNumber": "٩٣",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "فَنُزُلٌ مِنْ حَمٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35511,
            "SureId": 56,
            "AyetId": 94,
            "LanguageId": 7,
            "AyetNumber": "٩٤",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "وَتَصْلِیَةُ جَحٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35518,
            "SureId": 56,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "اِنَّ هٰذَا لَهُوَ حَقُّ الْیَقٖینِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35525,
            "SureId": 56,
            "AyetId": 96,
            "LanguageId": 7,
            "AyetNumber": "٩٦",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "فَسَبِّـحْ بِاسْمِ رَبِّكَ الْعَظٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35532,
            "SureId": 57,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "سَبَّحَ لِلّٰهِ مَا فِی السَّمٰوَاتِ وَالْاَرْضِۚ وَهُوَ الْعَزٖیزُ الْحَكٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 57,
                "MealInfo": "Medine döneminde inmiştir. 29 âyettir. Sûre, adını 25. âyette geçen <b>“elHadîd</b>” kelimesinden almıştır. <b>Hadîd, demir demektir</b>. Sûrede başlıca, <b>tüm kâinatın Allah’a ait olduğu ve kâinatta dilediği gibi tasarruf edeceği, Allah’ın dinini yüceltmek için can ve mal ile mücadelenin gerekliliği, dünya hayatının geçiciliği ve aldatıcılığı</b> konu edilmektedir.",
                "SureNameTurkish": "Hadîd",
                "SureNameArabic": "الْحَد۪يدِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 94,
                "AyetCount": 29,
                "Cuz": 27,
                "FirstPage": 537,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 35539,
            "SureId": 57,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "لَهُ مُلْكُ السَّمٰوَاتِ وَالْاَرْضِۚ یُحْيٖ وَیُمٖیتُۚ وَهُوَ عَلٰى كُلِّ شَیْءٍ قَدٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35546,
            "SureId": 57,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "هُوَ الْاَوَّلُ وَالْاٰخِرُ وَالظَّاهِرُ وَالْبَاطِنُۚ وَهُوَ بِكُلِّ شَیْءٍ عَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 35390,
            "SureId": 56,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Kuşkusuz o, değeri çok yüce Kur’an’dır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 56,
                "MealInfo": "Mekke döneminde inmiştir. 96 âyettir. Sûre, adını birinci âyette geçen<b> “elvâkı’a”</b> kelimesinden almıştır.<b> Vâkı’a, gerçekleşen, meydana gelen olay demektir</b>. Burada kıyameti ifade etmektedir. Sûrede başlıca, <b>kıyametin kopmasından önceki ve sonraki dehşetli hâller ve insanların amellerine göre içinde yer alacağı gruplar </b>konu edilmektedir.",
                "SureNameTurkish": "Vâkıa",
                "SureNameArabic": "الْوَاقِعَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 46,
                "AyetCount": 96,
                "Cuz": 27,
                "FirstPage": 534,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 35397,
            "SureId": 56,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "(Aslı) korunmuş bir kitaptadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35404,
            "SureId": 56,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Ona ancak tertemiz olanlar (melekler) dokunabilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35411,
            "SureId": 56,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "O, âlemlerin rabbinden indirilmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35418,
            "SureId": 56,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Şimdi siz bu sözü mü küçümsüyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35425,
            "SureId": 56,
            "AyetId": 82,
            "LanguageId": 5,
            "AyetNumber": "82",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Size verilen rızka yalanlamayla mı karşılık veriyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35432,
            "SureId": 56,
            "AyetId": 83,
            "LanguageId": 5,
            "AyetNumber": "83",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Ama can boğaza gelip dayandığında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35439,
            "SureId": 56,
            "AyetId": 84,
            "LanguageId": 5,
            "AyetNumber": "84",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "İşte o zaman siz (çaresiz) bakar durursunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35446,
            "SureId": 56,
            "AyetId": 85,
            "LanguageId": 5,
            "AyetNumber": "85",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Biz ona sizden yakınız, fakat göremezsiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35453,
            "SureId": 56,
            "AyetId": 86,
            "LanguageId": 5,
            "AyetNumber": "86",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Madem ki kimsenin hâkimiyeti altında değilmişsiniz;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35460,
            "SureId": 56,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Haydi onu (hayatı) geri döndürün, sözünüzde doğruysanız!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35467,
            "SureId": 56,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Şayet o, Allah’a yakın olanlardan ise;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35474,
            "SureId": 56,
            "AyetId": 89,
            "LanguageId": 5,
            "AyetNumber": "89",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Ona huzur, güzel nasip ve nimetlerle dolu cennet vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35481,
            "SureId": 56,
            "AyetId": 90,
            "LanguageId": 5,
            "AyetNumber": "90-91",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Eğer amel defteri sağından verilenlerden ise, (ona şöyle denir:) “Selâm sana ey hakkın ve erdemin yanında olmuş kişi!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35488,
            "SureId": 56,
            "AyetId": 91,
            "LanguageId": 5,
            "AyetNumber": "91",
            "AyetVisible": false,
            "Page": 537,
            "AyetText": "Eğer amel defteri sağından verilenlerden ise, (ona şöyle denir:) \"Selâm sana ey hakkın ve erdemin yanında olmuş kişi!\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35495,
            "SureId": 56,
            "AyetId": 92,
            "LanguageId": 5,
            "AyetNumber": "92",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Ama yoldan sapmış inkârcılardan ise;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35502,
            "SureId": 56,
            "AyetId": 93,
            "LanguageId": 5,
            "AyetNumber": "93-94",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Onu da kaynar sudan bir ziyafet ve atılacağı cehennem ateşi beklemektedir!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35509,
            "SureId": 56,
            "AyetId": 94,
            "LanguageId": 5,
            "AyetNumber": "94",
            "AyetVisible": false,
            "Page": 537,
            "AyetText": "Onu da kaynar sudan bir ziyafet ve atılacağı cehennem ateşi beklemektedir!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35516,
            "SureId": 56,
            "AyetId": 95,
            "LanguageId": 5,
            "AyetNumber": "95",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Şüphesiz bu kesin gerçeğin ta kendisidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35523,
            "SureId": 56,
            "AyetId": 96,
            "LanguageId": 5,
            "AyetNumber": "96",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Öyleyse ulu rabbinin ismini tesbih et.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35530,
            "SureId": 57,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 537,
            "AyetText": "Göklerde ve yerde bulunanlar Allah’ı tesbih etmektedir. O üstündür, her yaptığında hikmet vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 57,
