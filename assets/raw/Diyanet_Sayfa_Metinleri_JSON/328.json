            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "وَجَعَلْنَاهُمْ اَئِمَّةً یَهْدُونَ بِاَمْرِنَا وَاَوْحَیْنَٓا اِلَیْهِمْ فِعْلَ الْخَیْرَاتِ وَاِقَامَ الصَّلٰوةِ وَاٖیتَٓاءَ الزَّكٰوةِۚ وَكَانُوا لَنَا عَابِدٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17899,
            "SureId": 21,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "وَلُوطًا اٰتَیْنَاهُ حُكْمًا وَعِلْمًا وَنَجَّیْنَاهُ مِنَ الْقَرْیَةِ الَّتٖی كَانَتْ تَعْمَلُ الْخَبَٓائِثَؕ اِنَّهُمْ كَانُوا قَوْمَ سَوْءٍ فَاسِقٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17906,
            "SureId": 21,
            "AyetId": 75,
            "LanguageId": 7,
            "AyetNumber": "٧٥",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "وَاَدْخَلْنَاهُ فٖی رَحْمَتِنَاؕ اِنَّهُ مِنَ الصَّالِحٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17913,
            "SureId": 21,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "وَنُوحًا اِذْ نَادٰى مِنْ قَبْلُ فَاسْتَجَبْنَا لَهُ فَنَجَّیْنَاهُ وَاَهْلَهُ مِنَ الْكَرْبِ الْعَظٖیمِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17920,
            "SureId": 21,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "وَنَصَرْنَاهُ مِنَ الْقَوْمِ الَّذٖینَ كَذَّبُوا بِاٰیَاتِنَاؕ اِنَّهُمْ كَانُوا قَوْمَ سَوْءٍ فَاَغْرَقْنَاهُمْ اَجْمَعٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17927,
            "SureId": 21,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "وَدَاوُ𐻿دَ وَسُلَیْمٰنَ اِذْ یَحْكُمَانِ فِی الْحَرْثِ اِذْ نَفَشَتْ فٖیهِ غَنَمُ الْقَوْمِۚ وَكُنَّا لِحُكْمِهِمْ شَاهِدٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17934,
            "SureId": 21,
            "AyetId": 79,
            "LanguageId": 7,
            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "فَفَهَّمْنَاهَا سُلَیْمٰنَۚ وَكُلًّا اٰتَیْنَا حُكْمًا وَعِلْمًاؗ وَسَخَّرْنَا مَعَ دَاوُ𐻿دَ الْجِبَالَ یُسَبِّحْنَ وَالطَّیْرَؕ وَكُنَّا فَاعِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17941,
            "SureId": 21,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "وَعَلَّمْنَاهُ صَنْعَةَ لَبُوسٍ لَكُمْ لِتُحْصِنَكُمْ مِنْ بَاْسِكُمْۚ فَهَلْ اَنْتُمْ شَاكِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17948,
            "SureId": 21,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "وَلِسُلَیْمٰنَ الرّٖیحَ عَاصِفَةً تَجْرٖی بِاَمْرِهٖٓ اِلَى الْاَرْضِ الَّتٖی بَارَكْنَا فٖیهَاؕ وَكُنَّا بِكُلِّ شَیْءٍ عَالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 17890,
            "SureId": 21,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "Onları, emrimiz uyarınca doğru yolu gösteren önderler yaptık ve kendilerine hayırlı işler yapmayı, namaz kılıp zekât vermeyi vahyettik. Onlar, bize hep kulluk ettiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17897,
            "SureId": 21,
            "AyetId": 74,
            "LanguageId": 5,
            "AyetNumber": "74",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "Lût’a da hikmet ve ilim verdik; onu çirkin şeyler yapan kasaba halkından kurtardık. Gerçekten onlar yoldan çıkmış kötü bir topluluktu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17904,
            "SureId": 21,
            "AyetId": 75,
            "LanguageId": 5,
            "AyetNumber": "75",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "Lût’u rahmetimize kabul ettik; çünkü o iyilerdendi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17911,
            "SureId": 21,
            "AyetId": 76,
            "LanguageId": 5,
            "AyetNumber": "76",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "Nûh’u da hatırla; daha önce o dua etmişti, biz de duasını kabul edip kendisini ve yakınlarını büyük sıkıntıdan kurtarmıştık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17918,
            "SureId": 21,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "Onu, âyetlerimizi inkâr eden kavimden korumuştuk. Gerçekten onlar, kötü insanlardı; bu yüzden hepsini suda boğduk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17925,
            "SureId": 21,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "Dâvûd’u ve Süleyman’ı da an. Bir zamanlar, (zarar görmüş) bir ekin konusunda hüküm veriyorlardı. Bir topluluğun koyun sürüsü, geceleyin başı boş bir vaziyette bu ekinin içine dağılıp ziyan vermişti. Biz de onların hükmüne tanık idik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17932,
            "SureId": 21,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "Süleyman’ın dava konusunu iyi anlamasını sağladık. Her birine de hükmetme yeteneği ve ilim verdik. Kuşları ve tesbih eden dağları da Dâvûd’un buyruğu altına soktuk. Bunları yapan bizdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17939,
            "SureId": 21,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "Ona sizin için zırh yapmayı öğrettik ki savaş darbelerinden sizi korusun. Artık şükredecek misiniz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17946,
            "SureId": 21,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81",
            "AyetVisible": true,
            "Page": 328,
            "AyetText": "Süleyman’ın emrine de onun isteğine göre, içinde bereketler yarattığımız yere doğru esmek üzere güçlü rüzgârı verdik. Biz her şeyi biliriz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
