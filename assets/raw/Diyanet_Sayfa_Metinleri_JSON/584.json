    "QuranAyats": [
        {
            "Id": 40089,
            "SureId": 79,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "هَلْ اَتٰیكَ حَدٖیثُ مُوسٰىۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 79,
                "MealInfo": "Mekke döneminde inmiştir. 46 âyettir. Sûre, adını birinci âyetteki “en-Nâzi’ât”kelimesinden almıştır. Nâzi’ât burada, “ruhları çekip alan melekler” demektir.Sûrede başlıca, tevhit, peygamberlik, öldükten sonra dirilme ve hesap konuedilmektedir.",
                "SureNameTurkish": "Naziât",
                "SureNameArabic": "النَّازِعَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 81,
                "AyetCount": 46,
                "Cuz": 30,
                "FirstPage": 583,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 40096,
            "SureId": 79,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "اِذْ نَادٰیهُ رَبُّهُ بِالْوَادِ الْمُقَدَّسِ طُوًىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40103,
            "SureId": 79,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "اِذْهَبْ اِلٰى فِرْعَوْنَ اِنَّهُ طَغٰىؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40110,
            "SureId": 79,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "فَقُلْ هَلْ لَكَ اِلٰٓى اَنْ تَزَكّٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40117,
            "SureId": 79,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "وَاَهْدِیَكَ اِلٰى رَبِّكَ فَتَخْشٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40124,
            "SureId": 79,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "فَاَرٰیهُ الْاٰیَةَ الْكُبْرٰىؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40131,
            "SureId": 79,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "فَكَذَّبَ وَعَصٰىؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40138,
            "SureId": 79,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "ثُمَّ اَدْبَرَ یَسْعٰىؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40145,
            "SureId": 79,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "فَحَشَرَ فَنَادٰىؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40152,
            "SureId": 79,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "فَقَالَ اَنَا𐻾 رَبُّكُمُ الْاَعْلٰىؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40159,
            "SureId": 79,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "فَاَخَذَهُ اللّٰهُ نَكَالَ الْاٰخِرَةِ وَالْاُو𐻿لٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40166,
            "SureId": 79,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "اِنَّ فٖی ذٰلِكَ لَعِبْرَةً لِمَنْ یَخْشٰىؕࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40173,
            "SureId": 79,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "ءَاَنْتُمْ اَشَدُّ خَلْقًا اَمِ السَّمَٓاءُؕ بَنٰیهَاࣞ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40180,
            "SureId": 79,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "رَفَعَ سَمْكَهَا فَسَوّٰیهَاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40187,
            "SureId": 79,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "وَاَغْطَشَ لَیْلَهَا وَاَخْرَجَ ضُحٰیهَاࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40194,
            "SureId": 79,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "وَالْاَرْضَ بَعْدَ ذٰلِكَ دَحٰیهَاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40201,
            "SureId": 79,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "اَخْرَجَ مِنْهَا مَٓاءَهَا وَمَرْعٰیهَاࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40208,
            "SureId": 79,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "وَالْجِبَالَ اَرْسٰیهَاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40215,
            "SureId": 79,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "مَتَاعًا لَكُمْ وَلِاَنْعَامِكُمْؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40222,
            "SureId": 79,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "فَاِذَا جَٓاءَتِ الطَّٓامَّةُ الْكُبْرٰىؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40229,
            "SureId": 79,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "یَوْمَ یَتَذَكَّرُ الْاِنْسَانُ مَا سَعٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40236,
            "SureId": 79,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "وَبُرِّزَتِ الْجَحٖیمُ لِمَنْ یَرٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40243,
            "SureId": 79,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "فَاَمَّا مَنْ طَغٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40250,
            "SureId": 79,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "وَاٰثَرَ الْحَیٰوةَ الدُّنْیَاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40257,
            "SureId": 79,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "فَاِنَّ الْجَحٖیمَ هِیَ الْمَاْوٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40264,
            "SureId": 79,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "وَاَمَّا مَنْ خَافَ مَقَامَ رَبِّهٖ وَنَهَى النَّفْسَ عَنِ الْهَوٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40271,
            "SureId": 79,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "فَاِنَّ الْجَنَّةَ هِیَ الْمَاْوٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40278,
            "SureId": 79,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "یَسْـَٔلُونَكَ عَنِ السَّاعَةِ اَیَّانَ مُرْسٰیهَاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40285,
            "SureId": 79,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "فٖیمَ اَنْتَ مِنْ ذِكْرٰیهَاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40292,
            "SureId": 79,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "اِلٰى رَبِّكَ مُنْتَهٰیهَاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40299,
            "SureId": 79,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "اِنَّمَٓا اَنْتَ مُنْذِرُ مَنْ یَخْشٰیهَاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40306,
            "SureId": 79,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "كَاَنَّهُمْ یَوْمَ یَرَوْنَهَا لَمْ یَلْبَثُٓوا اِلَّا عَشِیَّةً اَوْ ضُحٰیهَا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 40087,
            "SureId": 79,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Sana Mûsâ’nın haberi geldi mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 79,
                "MealInfo": "Mekke döneminde inmiştir. 46 âyettir. Sûre, adını birinci âyetteki “en-Nâzi’ât”kelimesinden almıştır. Nâzi’ât burada, “ruhları çekip alan melekler” demektir.Sûrede başlıca, tevhit, peygamberlik, öldükten sonra dirilme ve hesap konuedilmektedir.",
                "SureNameTurkish": "Naziât",
                "SureNameArabic": "النَّازِعَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 81,
                "AyetCount": 46,
                "Cuz": 30,
                "FirstPage": 583,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 40094,
            "SureId": 79,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Rabbi ona kutsal vadi Tuvâ’da şöyle seslenmişti:",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40101,
            "SureId": 79,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "“Firavun’a git! O hakikaten azdı.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40108,
            "SureId": 79,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18-19",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Ona de ki: “Arınmayı ve seni rabbinin yoluna iletmemi ister misin? Böylece O’na saygılı davranırsın.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40115,
            "SureId": 79,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": false,
            "Page": 584,
            "AyetText": "De ki: \"Arınmayı ve seni rabbinin yoluna iletmemi ister misin? Böylece O’na saygılı davranırsın.\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40122,
            "SureId": 79,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Ve Mûsâ ona en büyük mûcizeyi gösterdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40129,
            "SureId": 79,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "O ise hemen yalanladı ve karşı çıktı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40136,
            "SureId": 79,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Sonra dönüp gitti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40143,
            "SureId": 79,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Derhal adamlarını toplayıp seslendi:",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40150,
            "SureId": 79,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "“Ben sizin en yüce rabbinizim!” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40157,
            "SureId": 79,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Allah da ona ibretlik dünya ve âhiret cezası verdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40164,
            "SureId": 79,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Elbette bunda Allah’a itaatsizlikten korkanların alacağı büyük bir ders vardır!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40171,
            "SureId": 79,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "(Ey inkârcılar!) Sizi yaratmak mı daha zor yoksa göğü yaratmak mı? Onu Allah bina etti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40178,
            "SureId": 79,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Onu yükseltip kusursuz biçimde düzenledi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40185,
            "SureId": 79,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Gecesini kararttı, gündüzünü aydınlattı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40192,
            "SureId": 79,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Bundan sonra da yeryüzünü yayıp döşedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40199,
            "SureId": 79,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Oradan su ve bitkiler çıkardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40206,
            "SureId": 79,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Dağları sağlam bir şekilde yerleştirdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40213,
            "SureId": 79,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Hepsi sizin ve hayvanlarınızın yararlanması için.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40220,
            "SureId": 79,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "O büyük felâket (kıyamet) geldiğinde;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40227,
            "SureId": 79,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "O gün insan yapıp ettiklerini iyice hatırlayacak;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40234,
            "SureId": 79,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Ve görecek olanlara cehennem açık bir şekilde gösterilecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40241,
            "SureId": 79,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37-38",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Azgınlık yapan ve dünya hayatını âhirete tercih eden kişi;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40248,
            "SureId": 79,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": false,
            "Page": 584,
            "AyetText": "Azan ve dünya hayatını âhirete tercih eden kişi;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40255,
            "SureId": 79,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Cehennem işte onun için tek barınaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40262,
            "SureId": 79,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40-41",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Rabbinin huzurunda (hesap vermekten) korkan ve nefsine kötü arzuları yasaklayana gelince, onun barınağı da şüphe yok ki cennetin ta kendisidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40269,
            "SureId": 79,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": false,
            "Page": 584,
            "AyetText": "Rabbinin huzurunda (hesap vermekten) korkan ve nefsine kötü arzuları yasaklayana gelince, onun barınağı da cennetin ta kendisidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40276,
            "SureId": 79,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "“Ne zaman gelip çatacak?” diye sana kıyameti sorarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40283,
            "SureId": 79,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Sen onun hakkında ne söyleyebilirsin ki!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40290,
            "SureId": 79,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Onun hakkındaki nihaî bilgi rabbine aittir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40297,
            "SureId": 79,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Sen ancak ondan korkanları uyarırsın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40304,
            "SureId": 79,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 584,
            "AyetText": "Kıyamet gününü gördüklerinde (dünyada) sadece bir akşam vakti veya onun kuşluğu kadar kaldıklarını sanırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
