    "QuranAyats": [
        {
            "Id": 15666,
            "SureId": 18,
            "AyetId": 98,
            "LanguageId": 7,
            "AyetNumber": "٩٨",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "قَالَ هٰذَا رَحْمَةٌ مِنْ رَبّٖیۚ فَاِذَا جَٓاءَ وَعْدُ رَبّٖی جَعَلَهُ دَكَّٓاءَۚ وَكَانَ وَعْدُ رَبّٖی حَقًّاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 18,
                "MealInfo": "Mekke döneminde inmiştir. 28. âyetin Medine döneminde indiği de rivayet edilmiştir. 110 âyettir. Sûre, adını; ilk defa dokuzuncu âyette olmak üzere,birkaç yerde geçen <b>“kehf ”</b> kelimesinden almıştır.<b> Kehf, mağara demektir</b>. Sûre de temel konu olarak, inançları sebebiyle öldürülmekten kurtulmak için bir mağaraya sığınan gençlerin mucizevî hâlleri, ayrıca <b>Hz. Mûsâ</b> ile <b>Zülkarneyn&nbsp;</b>konu edilmektedir.",
                "SureNameTurkish": "Kehf",
                "SureNameArabic": "الْكَهْفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 69,
                "AyetCount": 110,
                "Cuz": 15,
                "FirstPage": 293,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 15673,
            "SureId": 18,
            "AyetId": 99,
            "LanguageId": 7,
            "AyetNumber": "٩٩",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "وَتَرَكْنَا بَعْضَهُمْ یَوْمَئِذٍ یَمُوجُ فٖی بَعْضٍ وَنُفِخَ فِی الصُّورِ فَجَمَعْنَاهُمْ جَمْعًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15680,
            "SureId": 18,
            "AyetId": 100,
            "LanguageId": 7,
            "AyetNumber": "١٠٠",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "وَعَرَضْنَا جَهَنَّمَ یَوْمَئِذٍ لِلْكَافِرٖینَ عَرْضًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15687,
            "SureId": 18,
            "AyetId": 101,
            "LanguageId": 7,
            "AyetNumber": "١٠١",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "اَلَّذٖینَ كَانَتْ اَعْیُنُهُمْ فٖی غِطَٓاءٍ عَنْ ذِكْرٖی وَكَانُوا لَا یَسْتَطٖیعُونَ سَمْعًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15694,
            "SureId": 18,
            "AyetId": 102,
            "LanguageId": 7,
            "AyetNumber": "١٠٢",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "اَفَحَسِبَ الَّذٖینَ كَفَرُٓوا اَنْ یَتَّخِذُوا عِبَادٖی مِنْ دُونٖٓی اَوْلِیَٓاءَؕ اِنَّٓا اَعْتَدْنَا جَهَنَّمَ لِلْكَافِرٖینَ نُزُلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15701,
            "SureId": 18,
            "AyetId": 103,
            "LanguageId": 7,
            "AyetNumber": "١٠٣",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "قُلْ هَلْ نُنَبِّئُكُمْ بِالْاَخْسَرٖینَ اَعْمَالًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15708,
            "SureId": 18,
            "AyetId": 104,
            "LanguageId": 7,
            "AyetNumber": "١٠٤",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "اَلَّذٖینَ ضَلَّ سَعْیُهُمْ فِی الْحَیٰوةِ الدُّنْیَا وَهُمْ یَحْسَبُونَ اَنَّهُمْ یُحْسِنُونَ صُنْعًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15715,
            "SureId": 18,
            "AyetId": 105,
            "LanguageId": 7,
            "AyetNumber": "١٠٥",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "اُو𐻾لٰٓئِكَ الَّذٖینَ كَفَرُوا بِاٰیَاتِ رَبِّهِمْ وَلِقَٓائِهٖ فَحَبِطَتْ اَعْمَالُهُمْ فَلَا نُقٖیمُ لَهُمْ یَوْمَ الْقِیٰمَةِ وَزْنًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15722,
            "SureId": 18,
            "AyetId": 106,
            "LanguageId": 7,
            "AyetNumber": "١٠٦",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "ذٰلِكَ جَزَٓاؤُ𐻾هُمْ جَهَنَّمُ بِمَا كَفَرُوا وَاتَّخَذُٓوا اٰیَاتٖی وَرُسُلٖی هُزُوًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15729,
            "SureId": 18,
            "AyetId": 107,
            "LanguageId": 7,
            "AyetNumber": "١٠٧",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "اِنَّ الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ كَانَتْ لَهُمْ جَنَّاتُ الْفِرْدَوْسِ نُزُلًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15736,
            "SureId": 18,
            "AyetId": 108,
            "LanguageId": 7,
            "AyetNumber": "١٠٨",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "خَالِدٖینَ فٖیهَا لَا یَبْغُونَ عَنْهَا حِوَلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15743,
            "SureId": 18,
            "AyetId": 109,
            "LanguageId": 7,
            "AyetNumber": "١٠٩",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "قُلْ لَوْ كَانَ الْبَحْرُ مِدَادًا لِكَلِمَاتِ رَبّٖی لَنَفِدَ الْبَحْرُ قَبْلَ اَنْ تَنْفَدَ كَلِمَاتُ رَبّٖی وَلَوْ جِئْنَا بِمِثْلِهٖ مَدَدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15750,
            "SureId": 18,
            "AyetId": 110,
            "LanguageId": 7,
            "AyetNumber": "١١٠",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "قُلْ اِنَّمَٓا اَنَا𐻾 بَشَرٌ مِثْلُكُمْ یُوحٰٓى اِلَیَّ اَنَّمَٓا اِلٰهُكُمْ اِلٰهٌ وَاحِدٌۚ فَمَنْ كَانَ یَرْجُوا لِقَٓاءَ رَبِّهٖ فَلْیَعْمَلْ عَمَلًا صَالِحًا وَلَا یُشْرِكْ بِعِبَادَةِ رَبِّهٖٓ اَحَدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 15664,
            "SureId": 18,
            "AyetId": 98,
            "LanguageId": 5,
            "AyetNumber": "98",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "Zülkarneyn, “Bu, rabbimden bir rahmettir. Fakat rabbimin vaadi gelince O, bunu yerle bir eder. Rabbimin vaadi haktır” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 18,
                "MealInfo": "Mekke döneminde inmiştir. 28. âyetin Medine döneminde indiği de rivayet edilmiştir. 110 âyettir. Sûre, adını; ilk defa dokuzuncu âyette olmak üzere,birkaç yerde geçen <b>“kehf ”</b> kelimesinden almıştır.<b> Kehf, mağara demektir</b>. Sûre de temel konu olarak, inançları sebebiyle öldürülmekten kurtulmak için bir mağaraya sığınan gençlerin mucizevî hâlleri, ayrıca <b>Hz. Mûsâ</b> ile <b>Zülkarneyn&nbsp;</b>konu edilmektedir.",
                "SureNameTurkish": "Kehf",
                "SureNameArabic": "الْكَهْفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 69,
                "AyetCount": 110,
                "Cuz": 15,
                "FirstPage": 293,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 15671,
            "SureId": 18,
            "AyetId": 99,
            "LanguageId": 5,
            "AyetNumber": "99",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "O gün (kıyamet günü) biz onları, birbirine çarparak çalkalanır bir halde bırakmışızdır; sûra da üfürülmüş, böylece onları bütünüyle bir araya getirmişizdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15678,
            "SureId": 18,
            "AyetId": 100,
            "LanguageId": 5,
            "AyetNumber": "100-101",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "Ve (dünyada iken) gözleri beni hatırlatacak delillere kapalı bulunan, vahye kulak vermeye de tahammül edemez olan kâfirleri o gün cehennemle yüz yüze getirmişizdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15685,
            "SureId": 18,
            "AyetId": 101,
            "LanguageId": 5,
            "AyetNumber": "101",
            "AyetVisible": false,
            "Page": 304,
            "AyetText": "Ve (dünyada iken) gözleri beni hatırlatacak delillere kapalı bulunan, vahye kulak vermeye de tahammül edemez olan kâfirleri o gün cehennemle yüz yüze getirmişizdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15692,
            "SureId": 18,
            "AyetId": 102,
            "LanguageId": 5,
            "AyetNumber": "102",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "O inkârcılar, beni bırakıp kullarımı yardımcı edineceklerini mi sandılar? Biz cehennemi inkârcılar için bir konak olarak hazırladık!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15699,
            "SureId": 18,
            "AyetId": 103,
            "LanguageId": 5,
            "AyetNumber": "103",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "De ki: “Size, iş ve davranışları bakımından en çok ziyana uğrayanları bildirelim mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15706,
            "SureId": 18,
            "AyetId": 104,
            "LanguageId": 5,
            "AyetNumber": "104",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "Onlar, iyi yaptıklarını sandıkları halde, dünya hayatında çabaları boşa giden kimselerdir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15713,
            "SureId": 18,
            "AyetId": 105,
            "LanguageId": 5,
            "AyetNumber": "105",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "İşte onlar, rablerinin âyetlerini ve O’na kavuşmayı inkâr eden, bu yüzden amelleri boşa gitmiş olanlardır. Bu sebeple biz kıyamet gününde onların (dünyadaki) amellerine değer vermeyiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15720,
            "SureId": 18,
            "AyetId": 106,
            "LanguageId": 5,
            "AyetNumber": "106",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "İnkâr etmeleri, âyetlerimi ve resullerimi alaya almaları sebebiyle işte onların cezası cehennemdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15727,
            "SureId": 18,
            "AyetId": 107,
            "LanguageId": 5,
            "AyetNumber": "107",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "İman edip dünya ve âhiret için yararlı işler yapanlara gelince, onlar için de konak olarak firdevs cennetleri vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15734,
            "SureId": 18,
            "AyetId": 108,
            "LanguageId": 5,
            "AyetNumber": "108",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "Orada ebedî kalacaklardır. Oradan hiç ayrılmak istemezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15741,
            "SureId": 18,
            "AyetId": 109,
            "LanguageId": 5,
            "AyetNumber": "109",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "De ki: “Rabbimin sözlerini yazmak için denizler mürekkep olsa, bir o kadar mürekkep ilâve etseydik dahi rabbimin sözleri bitmeden mutlaka deniz tükenirdi.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15748,
            "SureId": 18,
            "AyetId": 110,
            "LanguageId": 5,
            "AyetNumber": "110",
            "AyetVisible": true,
            "Page": 304,
            "AyetText": "De ki: “Ben, yalnızca sizin gibi bir insanım. Şu var ki bana, ilâhınızın, sadece bir ilâh olduğu vahyolunuyor. Artık her kim rabbine kavuşmayı bekliyorsa dünya ve âhirete yararlı iş yapsın ve rabbine ibadette hiçbir şeyi ortak koşmasın.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
