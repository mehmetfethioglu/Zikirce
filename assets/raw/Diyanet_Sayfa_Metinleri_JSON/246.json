            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "یَا بَنِیَّ اذْهَبُوا فَتَحَسَّسُوا مِنْ یُوسُفَ وَاَخٖیهِ وَلَا تَایْــَٔسُوا مِنْ رَوْحِ اللّٰهِؕ اِنَّهُ لَا یَایْــَٔسُ مِنْ رَوْحِ اللّٰهِ اِلَّا الْقَوْمُ الْكَافِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 12,
                "MealInfo": "Mekke döneminde inmiştir. 111 âyettir. Bu sûrede Yûsuf Peygamberin hayatta karşılaştığı sıkıntılar ve bunlara sabrederek nasıl başarıya ulaştığı anlatılmakta ve inananlar için faydalı öğütler, önemli mesajlar verilmektedir. Kur’an’da baştan sona kadar bir tek konuyu anlatan tek sûre budur.",
                "SureNameTurkish": "Yûsuf",
                "SureNameArabic": "يُوسُفَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 53,
                "AyetCount": 111,
                "Cuz": 12,
                "FirstPage": 235,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11788,
            "SureId": 12,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "فَلَمَّا دَخَلُوا عَلَیْهِ قَالُوا یَٓا اَیُّهَا الْعَزٖیزُ مَسَّنَا وَاَهْلَنَا الضُّرُّ وَجِئْنَا بِبِضَاعَةٍ مُزْجٰیةٍ فَاَوْفِ لَنَا الْكَیْلَ وَتَصَدَّقْ عَلَیْنَاؕ اِنَّ اللّٰهَ یَجْزِی الْمُتَصَدِّقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11795,
            "SureId": 12,
            "AyetId": 89,
            "LanguageId": 7,
            "AyetNumber": "٨٩",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "قَالَ هَلْ عَلِمْتُمْ مَا فَعَلْتُمْ بِیُوسُفَ وَاَخٖیهِ اِذْ اَنْتُمْ جَاهِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11802,
            "SureId": 12,
            "AyetId": 90,
            "LanguageId": 7,
            "AyetNumber": "٩٠",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "قَالُٓوا ءَاِنَّكَ لَاَنْتَ یُوسُفُؕ قَالَ اَنَا𐻾 یُوسُفُ وَهٰذَٓا اَخٖیؗ قَدْ مَنَّ اللّٰهُ عَلَیْنَاؕ اِنَّهُ مَنْ یَتَّقِ وَیَصْبِرْ فَاِنَّ اللّٰهَ لَا یُضٖیعُ اَجْرَ الْمُحْسِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11809,
            "SureId": 12,
            "AyetId": 91,
            "LanguageId": 7,
            "AyetNumber": "٩١",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "قَالُوا تَاللّٰهِ لَقَدْ اٰثَرَكَ اللّٰهُ عَلَیْنَا وَاِنْ كُنَّا لَخَاطِـٖٔینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11816,
            "SureId": 12,
            "AyetId": 92,
            "LanguageId": 7,
            "AyetNumber": "٩٢",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "قَالَ لَا تَثْرٖیبَ عَلَیْكُمُ الْیَوْمَؕ یَغْفِرُ اللّٰهُ لَكُمْؗ وَهُوَ اَرْحَمُ الرَّاحِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11823,
            "SureId": 12,
            "AyetId": 93,
            "LanguageId": 7,
            "AyetNumber": "٩٣",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "اِذْهَبُوا بِقَمٖیصٖی هٰذَا فَاَلْقُوهُ عَلٰى وَجْهِ اَبٖی یَاْتِ بَصٖیرًاۚ وَاْتُونٖی بِاَهْلِكُمْ اَجْمَعٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11830,
            "SureId": 12,
            "AyetId": 94,
            "LanguageId": 7,
            "AyetNumber": "٩٤",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "وَلَمَّا فَصَلَتِ الْعٖیرُ قَالَ اَبُوهُمْ اِنّٖی لَاَجِدُ رٖیحَ یُوسُفَ لَوْلَٓا اَنْ تُفَنِّدُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11837,
            "SureId": 12,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "قَالُوا تَاللّٰهِ اِنَّكَ لَفٖی ضَلَالِكَ الْقَدٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 11779,
            "SureId": 12,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "Ey oğullarım! Gidin de Yûsuf’u ve kardeşini iyice araştırın, Allah’ın rahmetinden ümit kesmeyin. Çünkü inkâr edenlerden başkası Allah’ın rahmetinden ümit kesmez!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 12,
                "MealInfo": "Mekke döneminde inmiştir. 111 âyettir. Bu sûrede Yûsuf Peygamberin hayatta karşılaştığı sıkıntılar ve bunlara sabrederek nasıl başarıya ulaştığı anlatılmakta ve inananlar için faydalı öğütler, önemli mesajlar verilmektedir. Kur’an’da baştan sona kadar bir tek konuyu anlatan tek sûre budur.",
                "SureNameTurkish": "Yûsuf",
                "SureNameArabic": "يُوسُفَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 53,
                "AyetCount": 111,
                "Cuz": 12,
                "FirstPage": 235,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11786,
            "SureId": 12,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "Yûsuf’un huzuruna girdiklerinde dediler ki: “Ey Aziz! Bizi ve ailemizi kıtlık bastı ve biz, az bir bedel ile geldik. Yine de bize talebimizi karşılayacak kadar ver; bize bağışta da bulun. Şüphesiz Allah bağış yapanları mükâfatlandırır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11793,
            "SureId": 12,
            "AyetId": 89,
            "LanguageId": 5,
            "AyetNumber": "89",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "Yûsuf, “Siz, cahilliğiniz yüzünden Yûsuf ve kardeşine yaptıklarınızı biliyor musunuz? dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11800,
            "SureId": 12,
            "AyetId": 90,
            "LanguageId": 5,
            "AyetNumber": "90",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "“Yoksa sen, gerçekten sen Yûsuf musun?” diye sordular. O da “Evet” dedi, “Ben Yûsufum, bu da kardeşim. Allah bize iyilik etti. Kim Allah’tan korkar ve sabrederse, şüphesiz Allah güzel davrananların mükâfatını zayi etmez.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11807,
            "SureId": 12,
            "AyetId": 91,
            "LanguageId": 5,
            "AyetNumber": "91",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "Dediler ki: “Allah’a andolsun, hakikaten Allah seni bize üstün kılmış. Gerçekten biz hataya düşmüşüz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11814,
            "SureId": 12,
            "AyetId": 92,
            "LanguageId": 5,
            "AyetNumber": "92",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "Yûsuf şöyle dedi: “Bugün yaptıklarınız yüzünüze vurulmayacak, Allah sizi affetsin! O, merhametlilerin en merhametlisidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11821,
            "SureId": 12,
            "AyetId": 93,
            "LanguageId": 5,
            "AyetNumber": "93",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "Şu benim gömleğimi götürün de onu babamın yüzüne koyun, gözleri görecek duruma gelir. Bütün ailenizi de bana getirin.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11828,
            "SureId": 12,
            "AyetId": 94,
            "LanguageId": 5,
            "AyetNumber": "94",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "Kafile Mısır’dan ayrılınca babaları, “Eğer bana bunamış demezseniz, inanın ben Yûsuf’un kokusunu alıyorum!” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11835,
            "SureId": 12,
            "AyetId": 95,
            "LanguageId": 5,
            "AyetNumber": "95",
            "AyetVisible": true,
            "Page": 246,
            "AyetText": "Yanındakiler ise, “Vallahi sen hâlâ eski şaşkınlığındasın” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
