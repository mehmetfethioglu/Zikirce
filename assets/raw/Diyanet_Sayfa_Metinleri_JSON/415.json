            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "الٓـمٓࣞ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 32,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. <b>Sûre, adını mü’minlerin Allah’a secde etmelerinden bahseden 15. âyetten almıştır</b>. Sûrede ayrıca Allah’ın kudretinden,ahiret gününden, kitaplardan, peygamberlerden ve insanın yaratılışından söz edilmektedir.",
                "SureNameTurkish": "Secde",
                "SureNameArabic": "السَّجْدَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 75,
                "AyetCount": 30,
                "Cuz": 21,
                "FirstPage": 415,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 24535,
            "SureId": 32,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "تَنْزٖیلُ الْكِتَابِ لَا رَیْبَ فٖیهِ مِنْ رَبِّ الْعَالَمٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24542,
            "SureId": 32,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "اَمْ یَقُولُونَ افْتَرٰیهُۚ بَلْ هُوَ الْحَقُّ مِنْ رَبِّكَ لِتُنْذِرَ قَوْمًا مَٓا اَتٰیهُمْ مِنْ نَذٖیرٍ مِنْ قَبْلِكَ لَعَلَّهُمْ یَهْتَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24549,
            "SureId": 32,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "اَللّٰهُ الَّذٖی خَلَقَ السَّمٰوَاتِ وَالْاَرْضَ وَمَا بَیْنَهُمَا فٖی سِتَّةِ اَیَّامٍ ثُمَّ اسْتَوٰى عَلَى الْعَرْشِؕ مَا لَكُمْ مِنْ دُونِهٖ مِنْ وَلِیٍّ وَلَا شَفٖیعٍؕ اَفَلَا تَتَذَكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24556,
            "SureId": 32,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "یُدَبِّرُ الْاَمْرَ مِنَ السَّمَٓاءِ اِلَى الْاَرْضِ ثُمَّ یَعْرُجُ اِلَیْهِ فٖی یَوْمٍ كَانَ مِقْدَارُهُٓ اَلْفَ سَنَةٍ مِمَّا تَعُدُّونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24563,
            "SureId": 32,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "ذٰلِكَ عَالِمُ الْغَیْبِ وَالشَّهَادَةِ الْعَزٖیزُ الرَّحٖیمُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24570,
            "SureId": 32,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "اَلَّذٖٓی اَحْسَنَ كُلَّ شَیْءٍ خَلَقَهُ وَبَدَاَ خَلْقَ الْاِنْسَانِ مِنْ طٖینٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24577,
            "SureId": 32,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "ثُمَّ جَعَلَ نَسْلَهُ مِنْ سُلَالَةٍ مِنْ مَٓاءٍ مَهٖینٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24584,
            "SureId": 32,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "ثُمَّ سَوّٰیهُ وَنَفَخَ فٖیهِ مِنْ رُوحِهٖ وَجَعَلَ لَكُمُ السَّمْعَ وَالْاَبْصَارَ وَالْاَفْــِٔدَةَؕ قَلٖیلًا مَا تَشْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24591,
            "SureId": 32,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "وَقَالُٓوا ءَاِذَا ضَلَلْنَا فِی الْاَرْضِ ءَاِنَّا لَفٖی خَلْقٍ جَدٖیدٍؕ بَلْ هُمْ بِلِقَٓاءِ رَبِّهِمْ كَافِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24598,
            "SureId": 32,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "قُلْ یَتَوَفّٰیكُمْ مَلَكُ الْمَوْتِ الَّذٖی وُكِّلَ بِكُمْ ثُمَّ اِلٰى رَبِّكُمْ تُرْجَعُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 24526,
            "SureId": 32,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "Elif-lâm-mîm.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 32,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. <b>Sûre, adını mü’minlerin Allah’a secde etmelerinden bahseden 15. âyetten almıştır</b>. Sûrede ayrıca Allah’ın kudretinden,ahiret gününden, kitaplardan, peygamberlerden ve insanın yaratılışından söz edilmektedir.",
                "SureNameTurkish": "Secde",
                "SureNameArabic": "السَّجْدَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 75,
                "AyetCount": 30,
                "Cuz": 21,
                "FirstPage": 415,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 24533,
            "SureId": 32,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "Bu kitabın, âlemlerin rabbi tarafından indirildiğinde asla kuşku yoktur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24540,
            "SureId": 32,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "Buna rağmen “Onu (Muhammed) kendisi uydurdu” diyorlar öyle mi? Hayır! O, senden önce kendilerine uyarıcı gelmemiş bir toplumu uyarman için rabbin tarafından gönderilen hak kitaptır. Umulur ki doğru yolu bulurlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24547,
            "SureId": 32,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "Gökleri, yeri ve bunların arasındakileri altı günde yaratan, sonra arşa istivâ eden Allah’tır. O’nsuz size ne bir dost ne bir şefaatçi bulunur. Hâlâ düşünüp ders almaz mısınız?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24554,
            "SureId": 32,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "O gökten yere her işi düzenleyip yönetir. Sonra bütün işler sizin hesabınıza göre bin yıl tutan bir günde O’nun katına çıkar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24561,
            "SureId": 32,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "İşte O, duyular ve akılla idrak edilemeyeni de edileni de bilmektedir, izzeti sınırsız, rahmeti boldur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24568,
            "SureId": 32,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "O yarattığı her şeyi güzel yapmış ve ilk başta insanı çamurdan yaratmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24575,
            "SureId": 32,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "Sonra onun neslini önemsenmeyen bir suyun özünden yaratıp sürdürmüştür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24582,
            "SureId": 32,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "Sonra ona düzgün bir şekil vermiş ve ruhundan ona üflemiş; sizi kulak, göz ve gönüllerle donatmıştır. Ne kadar da az şükrediyorsunuz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24589,
            "SureId": 32,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "İnkârcılar şöyle derler: “Toprakta kaybolup gittiğimizde biz yeniden mi yaratılacakmışız?” Gerçek şu ki, onlar rablerinin huzuruna çıkacaklarını inkâr etmektedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24596,
            "SureId": 32,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 415,
            "AyetText": "De ki: “Sizin için görevlendirilmiş bulunan ölüm meleği canınızı alacak, sonra rabbinize döndürüleceksiniz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Secde",
    "QuranSureLabel": "السَّجْدَةِ",
    "EndPageSure": null
}