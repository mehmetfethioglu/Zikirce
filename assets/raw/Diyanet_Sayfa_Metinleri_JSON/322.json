    "QuranAyats": [
        {
            "Id": 17388,
            "SureId": 21,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "اِقْتَرَبَ لِلنَّاسِ حِسَابُهُمْ وَهُمْ فٖی غَفْلَةٍ مُعْرِضُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17395,
            "SureId": 21,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "مَا یَاْتٖیهِمْ مِنْ ذِكْرٍ مِنْ رَبِّهِمْ مُحْدَثٍ اِلَّا اسْتَمَعُوهُ وَهُمْ یَلْعَبُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17402,
            "SureId": 21,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "لَاهِیَةً قُلُوبُهُمْؕ وَاَسَرُّوا النَّجْوٰىࣗ اَلَّذٖینَ ظَلَمُواࣗ هَلْ هٰذَٓا اِلَّا بَشَرٌ مِثْلُكُمْۚ اَفَتَاْتُونَ السِّحْرَ وَاَنْتُمْ تُبْصِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17409,
            "SureId": 21,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "قَالَ رَبّٖی یَعْلَمُ الْقَوْلَ فِی السَّمَٓاءِ وَالْاَرْضِؗ وَهُوَ السَّمٖیعُ الْعَلٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17416,
            "SureId": 21,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "بَلْ قَالُٓوا اَضْغَاثُ اَحْلَامٍ بَلِ افْتَرٰیهُ بَلْ هُوَ شَاعِرٌۚ فَلْیَاْتِنَا بِاٰیَةٍ كَمَٓا اُرْسِلَ الْاَوَّلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17423,
            "SureId": 21,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "مَٓا اٰمَنَتْ قَبْلَهُمْ مِنْ قَرْیَةٍ اَهْلَكْنَاهَاۚ اَفَهُمْ یُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17430,
            "SureId": 21,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "وَمَٓا اَرْسَلْنَا قَبْلَكَ اِلَّا رِجَالًا نُوحٖٓی اِلَیْهِمْ فَسْـَٔلُٓوا اَهْلَ الذِّكْرِ اِنْ كُنْتُمْ لَا تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17437,
            "SureId": 21,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "وَمَا جَعَلْنَاهُمْ جَسَدًا لَا یَاْكُلُونَ الطَّعَامَ وَمَا كَانُوا خَالِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17444,
            "SureId": 21,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "ثُمَّ صَدَقْنَاهُمُ الْوَعْدَ فَاَنْجَیْنَاهُمْ وَمَنْ نَشَٓاءُ وَاَهْلَكْنَا الْمُسْرِفٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17451,
            "SureId": 21,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "لَقَدْ اَنْزَلْنَٓا اِلَیْكُمْ كِتَابًا فٖیهِ ذِكْرُكُمْؕ اَفَلَا تَعْقِلُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 17386,
            "SureId": 21,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "İnsanların hesaba çekilecekleri gün iyice yaklaştı; halbuki onlar gaflet içinde haktan yüz çevirmektedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17393,
            "SureId": 21,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2-3",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "Ne zaman rablerinden kendilerine yeni bir ihtar gelse, onlar bunu, akılları başka yerde, kendileri oyun ve eğlence içinde iken dinlemişlerdir. O zalimler, “Bu da sizin gibi sadece bir insan değil midir? Şimdi siz göz göre göre büyüye mi kapılıyorsunuz?” diye gizlice fısıldaşmaktalar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17400,
            "SureId": 21,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": false,
            "Page": 322,
            "AyetText": "Ne zaman rablerinden kendilerine yeni bir ihtar gelse, onlar bunu, akılları başka yerde, kendileri oyun ve eğlence içinde iken dinlemişlerdir. O zalimler, \"Bu da sizin gibi sadece bir insan değil midir? Şimdi siz göz göre göre büyüye mi kapılıyorsunuz?\" diye gizlice fısıldaşmaktalar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17407,
            "SureId": 21,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "Peygamber dedi ki: “Benim rabbim yerde ve gökte konuşulan her sözü bilir. O, hakkıyla işitendir, bilendir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17414,
            "SureId": 21,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "“Hayır” dediler, “Bunlar karma karışık düşlerdir; hayır, onu kendisi uydurmuştur. O olsa olsa şairdir. Böyle değilse bize, öncekilere gönderilenin benzeri bir mûcize getirsin.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17421,
            "SureId": 21,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "Bunlardan önce helâk ettiğimiz hiçbir yerin halkı iman etmemişti; şimdi (aynı yolu tutan) bunlar mı iman edecekler?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17428,
            "SureId": 21,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "Senden önce de ancak kendilerine vahyettiğimiz kimseleri peygamber olarak gönderdik; eğer bilmiyorsanız kitaplar hakkında bilgi sahibi olanlara sorun.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17435,
            "SureId": 21,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "Onları yiyip içmez bir beden kılmadık, ölümsüz de değillerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17442,
            "SureId": 21,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "Sonra onlara verdiğimiz sözü yerine getirdik. Böylece, hem onları hem de dilediğimiz kimseleri kurtuluşa erdirdik; haddi aşanları ise helâk ettik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17449,
            "SureId": 21,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 322,
            "AyetText": "Andolsun, size içinde sizin için öğüt bulunan bir kitap indirdik. Hâlâ aklınızı kullanmayacak mısınız?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
