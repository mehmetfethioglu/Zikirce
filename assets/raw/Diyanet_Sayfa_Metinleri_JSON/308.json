{
    "PointerList": null,
    "CuzNo": 16,
    "PageNo": 308,
    "ArCuzNo": "۱٦",
    "ArPageNo": "۳۰۸",
    "QuranAyats": [
        {
            "Id": 16023,
            "SureId": 19,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "وَاَنْذِرْهُمْ یَوْمَ الْحَسْرَةِ اِذْ قُضِیَ الْاَمْرُۚ وَهُمْ فٖی غَفْلَةٍ وَهُمْ لَا یُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16030,
            "SureId": 19,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "اِنَّا نَحْنُ نَرِثُ الْاَرْضَ وَمَنْ عَلَیْهَا وَاِلَیْنَا یُرْجَعُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16037,
            "SureId": 19,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "وَاذْكُرْ فِی الْكِتَابِ اِبْرٰهٖیمَؕ اِنَّهُ كَانَ صِدّٖیقًا نَبِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16044,
            "SureId": 19,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "اِذْ قَالَ لِاَبٖیهِ یَٓا اَبَتِ لِمَ تَعْبُدُ مَا لَا یَسْمَعُ وَلَا یُبْصِرُ وَلَا یُغْنٖی عَنْكَ شَیْـًٔا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16051,
            "SureId": 19,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "یَٓا اَبَتِ اِنّٖی قَدْ جَٓاءَنٖی مِنَ الْعِلْمِ مَا لَمْ یَاْتِكَ فَاتَّبِعْنٖٓی اَهْدِكَ صِرَاطًا سَوِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16058,
            "SureId": 19,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "یَٓا اَبَتِ لَا تَعْبُدِ الشَّیْطَانَؕ اِنَّ الشَّیْطَانَ كَانَ لِلرَّحْمٰنِ عَصِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16065,
            "SureId": 19,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "یَٓا اَبَتِ اِنّٖٓی اَخَافُ اَنْ یَمَسَّكَ عَذَابٌ مِنَ الرَّحْمٰنِ فَتَكُونَ لِلشَّیْطَانِ وَلِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16072,
            "SureId": 19,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "قَالَ اَرَاغِبٌ اَنْتَ عَنْ اٰلِهَتٖی یَٓا اِبْرٰهٖیمُۚ لَئِنْ لَمْ تَنْتَهِ𐻾 لَاَرْجُمَنَّكَ وَاهْجُرْنٖی مَلِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16079,
            "SureId": 19,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "قَالَ سَلَامٌ عَلَیْكَۚ سَاَسْتَغْفِرُ لَكَ رَبّٖیؕ اِنَّهُ كَانَ بٖی حَفِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16086,
            "SureId": 19,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "وَاَعْتَزِلُكُمْ وَمَا تَدْعُونَ مِنْ دُونِ اللّٰهِ وَاَدْعُوا رَبّٖیؗ عَسٰٓى اَلَّٓا اَكُونَ بِدُعَٓاءِ رَبّٖی شَقِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16093,
            "SureId": 19,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "فَلَمَّا اعْتَزَلَهُمْ وَمَا یَعْبُدُونَ مِنْ دُونِ اللّٰهِۙ وَهَبْنَا لَهُٓ اِسْحٰقَ وَیَعْقُوبَؕ وَكُلًّا جَعَلْنَا نَبِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16100,
            "SureId": 19,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "وَوَهَبْنَا لَهُمْ مِنْ رَحْمَتِنَا وَجَعَلْنَا لَهُمْ لِسَانَ صِدْقٍ عَلِیًّاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16107,
            "SureId": 19,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "وَاذْكُرْ فِی الْكِتَابِ مُوسٰىؗ اِنَّهُ كَانَ مُخْلَصًا وَكَانَ رَسُولًا نَبِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 16021,
            "SureId": 19,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "Sen onları pişmanlık günü hakkında uyar; o gün onlar bir gafletin içine dalmış oldukları halde ve henüz iman etmemişken iş olup bitecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16028,
            "SureId": 19,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "Yeryüzü ve onun üzerindekiler sonunda yalnız bize kalır ve hepsi bize dönerler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16035,
            "SureId": 19,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "Bu kitapta İbrâhim’i de okuyup an! Kuşkusuz o, özü sözü doğru bir insan, bir peygamberdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16042,
            "SureId": 19,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "Bir gün babasına şöyle demişti: Babacığım! Duymayan, görmeyen ve sana hiçbir fayda sağlamayan bir şeye niçin taparsın?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16049,
            "SureId": 19,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "Babacığım! Sana gelmeyen bir bilgi hakikaten bana geldi, bu sebeple bana uy ki seni düz yola çıkarayım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16056,
            "SureId": 19,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "Babacığım! Şeytana kulluk etme! Çünkü şeytan, rahmânın buyruğuna uymamıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16063,
            "SureId": 19,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "Babacığım! Allah’ın azabına uğramandan ve böylece şeytanın yandaşı olmandan korkuyorum.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16070,
            "SureId": 19,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "(Babası:) “Ey İbrâhim! Sen benim tanrılarımdan yüz mü çeviriyorsun? Eğer vazgeçmezsen, andolsun seni taşlatırım; şimdi uzun bir süre gözüme görünme!” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16077,
            "SureId": 19,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "İbrâhim şöyle dedi: “Esen kal! Rabbimden senin için mağfiret dileyeceğim. Çünkü O, bana karşı çok lutufkârdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16084,
            "SureId": 19,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "Sizden de Allah’ın dışında taptığınız şeylerden de uzaklaşıyor ve rabbime niyaz ediyorum. Umudum odur ki rabbime niyazımdan eli boş dönmeyeceğim.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16091,
            "SureId": 19,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "Nihayet İbrâhim onlardan ve Allah’ın dışında taptıklarından uzaklaşınca, biz ona İshak ve Ya‘kūb’u bahşettik, her birini peygamber yaptık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16098,
            "SureId": 19,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "Onlara da rahmetimizden bağışlarda bulunduk ve onlara hak ettikleri yüksek bir övgü ile anılmayı nasip ettik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16105,
            "SureId": 19,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 308,
            "AyetText": "Bu kitapta Mûsâ’yı da okuyarak an. Gerçekten o ihlâslı biriydi, elçi-peygamberdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Meryem",
    "QuranSureLabel": "مَرْيَمَ",
    "EndPageSure": null
}