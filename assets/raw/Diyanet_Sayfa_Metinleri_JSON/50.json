        },
        {
            "Id": 2072,
            "SureId": 3,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 50,
            "AyetText": "نَزَّلَ عَلَیْكَ الْكِتَابَ بِالْحَقِّ مُصَدِّقًا لِمَا بَیْنَ یَدَیْهِ وَاَنْزَلَ التَّوْرٰیةَ وَالْاِنْجٖیلَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2079,
            "SureId": 3,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 50,
            "AyetText": "مِنْ قَبْلُ هُدًى لِلنَّاسِ وَاَنْزَلَ الْفُرْقَانَؕ اِنَّ الَّذٖینَ كَفَرُوا بِاٰیَاتِ اللّٰهِ لَهُمْ عَذَابٌ شَدٖیدٌؕ وَاللّٰهُ عَزٖیزٌ ذُو انْتِقَامٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2086,
            "SureId": 3,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 50,
            "AyetText": "اِنَّ اللّٰهَ لَا یَخْفٰى عَلَیْهِ شَیْءٌ فِی الْاَرْضِ وَلَا فِی السَّمَٓاءِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2093,
            "SureId": 3,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 50,
            "AyetText": "هُوَ الَّذٖی یُصَوِّرُكُمْ فِی الْاَرْحَامِ كَیْفَ یَشَٓاءُؕ لَٓا اِلٰهَ اِلَّا هُوَ الْعَزٖیزُ الْحَكٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2100,
            "SureId": 3,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 50,
            "AyetText": "هُوَ الَّذٖٓی اَنْزَلَ عَلَیْكَ الْكِتَابَ مِنْهُ اٰیَاتٌ مُحْكَمَاتٌ هُنَّ اُمُّ الْكِتَابِ وَاُخَرُ مُتَشَابِهَاتٌؕ فَاَمَّا الَّذٖینَ فٖی قُلُوبِهِمْ زَیْغٌ فَیَتَّبِعُونَ مَا تَشَابَهَ مِنْهُ ابْتِغَٓاءَ الْفِتْنَةِ وَابْتِغَٓاءَ تَاْوٖیلِهٖۚ وَمَا یَعْلَمُ تَاْوٖیلَهُٓ اِلَّا اللّٰهُۘ وَالرَّاسِخُونَ فِی الْعِلْمِ یَقُولُونَ اٰمَنَّا بِهٖۙ كُلٌّ مِنْ عِنْدِ رَبِّنَاۚ وَمَا یَذَّكَّرُ اِلَّٓا اُو𐻾لُوا الْاَلْبَابِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2107,
            "SureId": 3,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 50,
            "AyetText": "رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ اِذْ هَدَیْتَنَا وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةًۚ اِنَّكَ اَنْتَ الْوَهَّابُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2114,
            "SureId": 3,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 50,
            "AyetText": "رَبَّنَٓا اِنَّكَ جَامِعُ النَّاسِ لِیَوْمٍ لَا رَیْبَ فٖیهِؕ اِنَّ اللّٰهَ لَا یُخْلِفُ الْمٖیعَادَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
