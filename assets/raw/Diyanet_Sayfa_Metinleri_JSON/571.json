{
    "PointerList": null,
    "CuzNo": 29,
    "PageNo": 571,
    "ArCuzNo": "۲۹",
    "ArPageNo": "٥۷۱",
    "QuranAyats": [
        {
            "Id": 38010,
            "SureId": 71,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "یُرْسِلِ السَّمَٓاءَ عَلَیْكُمْ مِدْرَارًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 71,
                "MealInfo": "Mekke döneminde inmiştir. 28 âyettir. Sûrede başlıca, Nûh peygamberin mücadeleleri ve Nûh Tufanı konu edilmektedir. Sûre, adını konusundan almıştır.",
                "SureNameTurkish": "Nûh",
                "SureNameArabic": "نُوحٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 71,
                "AyetCount": 28,
                "Cuz": 29,
                "FirstPage": 570,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 38017,
            "SureId": 71,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "وَیُمْدِدْكُمْ بِاَمْوَالٍ وَبَنٖینَ وَیَجْعَلْ لَكُمْ جَنَّاتٍ وَیَجْعَلْ لَكُمْ اَنْهَارًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38024,
            "SureId": 71,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "مَا لَكُمْ لَا تَرْجُونَ لِلّٰهِ وَقَارًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38031,
            "SureId": 71,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "وَقَدْ خَلَقَكُمْ اَطْوَارًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38038,
            "SureId": 71,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "اَلَمْ تَرَوْا كَیْفَ خَلَقَ اللّٰهُ سَبْعَ سَمٰوَاتٍ طِبَاقًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38045,
            "SureId": 71,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "وَجَعَلَ الْقَمَرَ فٖیهِنَّ نُورًا وَجَعَلَ الشَّمْسَ سِرَاجًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38052,
            "SureId": 71,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "وَاللّٰهُ اَنْبَتَكُمْ مِنَ الْاَرْضِ نَبَاتًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38059,
            "SureId": 71,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "ثُمَّ یُعٖیدُكُمْ فٖیهَا وَیُخْرِجُكُمْ اِخْرَاجًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38066,
            "SureId": 71,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "وَاللّٰهُ جَعَلَ لَكُمُ الْاَرْضَ بِسَاطًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38073,
            "SureId": 71,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "لِتَسْلُكُوا مِنْهَا سُبُلًا فِجَاجًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38080,
            "SureId": 71,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "قَالَ نُوحٌ رَبِّ اِنَّهُمْ عَصَوْنٖی وَاتَّبَعُوا مَنْ لَمْ یَزِدْهُ مَالُهُ وَوَلَدُهُٓ اِلَّا خَسَارًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38087,
            "SureId": 71,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "وَمَكَرُوا مَكْرًا كُبَّارًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38094,
            "SureId": 71,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "وَقَالُوا لَا تَذَرُنَّ اٰلِهَتَكُمْ وَلَا تَذَرُنَّ وَدًّا وَلَا سُوَاعًاۙ وَلَا یَغُوثَ وَیَعُوقَ وَنَسْرًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38101,
            "SureId": 71,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "وَقَدْ اَضَلُّوا كَثٖیرًاۚ وَلَا تَزِدِ الظَّالِمٖینَ اِلَّا ضَلَالًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38108,
            "SureId": 71,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "مِمَّا خَطٖٓیـَٔاتِهِمْ اُغْرِقُوا فَاُدْخِلُوا نَارًا فَلَمْ یَجِدُوا لَهُمْ مِنْ دُونِ اللّٰهِ اَنْصَارًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38115,
            "SureId": 71,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "وَقَالَ نُوحٌ رَبِّ لَا تَذَرْ عَلَى الْاَرْضِ مِنَ الْكَافِرٖینَ دَیَّارًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38122,
            "SureId": 71,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "اِنَّكَ اِنْ تَذَرْهُمْ یُضِلُّوا عِبَادَكَ وَلَا یَلِدُٓوا اِلَّا فَاجِرًا كَفَّارًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38129,
            "SureId": 71,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "رَبِّ اغْفِرْ لٖی وَلِوَالِدَیَّ وَلِمَنْ دَخَلَ بَیْتِیَ مُؤْمِنًا وَلِلْمُؤْمِنٖینَ وَالْمُؤْمِنَاتِؕ وَلَا تَزِدِ الظَّالِمٖینَ اِلَّا تَبَارًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 38008,
            "SureId": 71,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "(Dileyin ki) üzerinize gökten bol bol yağmur indirsin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 71,
                "MealInfo": "Mekke döneminde inmiştir. 28 âyettir. Sûrede başlıca, Nûh peygamberin mücadeleleri ve Nûh Tufanı konu edilmektedir. Sûre, adını konusundan almıştır.",
                "SureNameTurkish": "Nûh",
                "SureNameArabic": "نُوحٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 71,
                "AyetCount": 28,
                "Cuz": 29,
                "FirstPage": 570,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 38015,
            "SureId": 71,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Mallar ve oğullar vererek sizi desteklesin, size bahçeler versin ve sizin için ırmaklar akıtsın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38022,
            "SureId": 71,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Ne oluyor size de Allah’ın büyüklüğünü hesaba katmıyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38029,
            "SureId": 71,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Oysa O sizi türlü evrelerden geçirerek yaratmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38036,
            "SureId": 71,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Görmüyor musunuz Allah yedi göğü birbiriyle nasıl uyumlu yaratmıştır?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38043,
            "SureId": 71,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Onların içinde ayı bir ışık, güneşi ışık kaynağı yapmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38050,
            "SureId": 71,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Allah sizi yerden bitirip yetiştirmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38057,
            "SureId": 71,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Sonra sizi yine oraya döndürecek ve yeniden çıkaracaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38064,
            "SureId": 71,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19-20",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Allah yeryüzünü sizin için sergi gibi döşemiştir ki onda geniş yollar edinip dolaşabilesiniz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38071,
            "SureId": 71,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": false,
            "Page": 571,
            "AyetText": "Allah yeryüzünü sizin için sergi gibi döşemiştir ki onda geniş yollar edinip dolaşabilesiniz.\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38078,
            "SureId": 71,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Nûh, “Rabbim, dedi, doğrusu bunlar beni dinlemediler, malı ve çocuğu kendi ziyanını arttırmaktan başka bir şeye yaramayan kimseye uydular.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38085,
            "SureId": 71,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Onlar çok büyük tuzaklar kurdular.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38092,
            "SureId": 71,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "İnsanlara dediler ki: Sakın ilâhlarınızı bırakmayın; hele Ved’den, Suvâ’dan, Yegūs’tan, Yeûk’tan ve Nesr’den asla vazgeçmeyin!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38099,
            "SureId": 71,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Gerçekten de birçoklarını saptırdılar; (Rabbim!) sen de artık bu zalimlerin şaşkınlıklarını arttır!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38106,
            "SureId": 71,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Sonunda günahları yüzünden tûfanda boğuldular, ardından ateşe atıldılar, kendilerine Allah’tan başka yardımcılar da bulamadılar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38113,
            "SureId": 71,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Nûh “Rabbim” dedi, “Yeryüzünde inkârcılardan hiç kimseyi sağ bırakma!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38120,
            "SureId": 71,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Sen onları bırakırsan kullarını saptırırlar ve sadece günahkâr nankör nesiller yetiştirirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38127,
            "SureId": 71,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 571,
            "AyetText": "Rabbim! Beni, annemi babamı, inanmış olarak evime girenleri, mümin erkekleri ve mümin kadınları bağışla, zalimleri ise daima helâk et.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Nûh",
    "QuranSureLabel": "نُوحٍ",
    "EndPageSure": null
}