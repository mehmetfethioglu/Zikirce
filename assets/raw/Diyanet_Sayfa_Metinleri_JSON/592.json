            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "سَبِّحِ اسْمَ رَبِّكَ الْاَعْلٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 87,
                "MealInfo": "Mekke döneminde inmiştir. 19 âyettir. Sûre, adını birinci âyette yer alan ve AllahTeâlâ’yı niteleyen “el-A’lâ” kelimesinden almıştır. A’lâ, en yüce demektir.",
                "SureNameTurkish": "A'lâ",
                "SureNameArabic": "الْاَعْلٰى",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 8,
                "AyetCount": 19,
                "Cuz": 30,
                "FirstPage": 592,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 41650,
            "SureId": 87,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "اَلَّذٖی خَلَقَ فَسَوّٰىࣕۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41657,
            "SureId": 87,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "وَالَّذٖی قَدَّرَ فَهَدٰىࣕۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41664,
            "SureId": 87,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "وَالَّذٖٓی اَخْرَجَ الْمَرْعٰىࣕۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41671,
            "SureId": 87,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "فَجَعَلَهُ غُثَٓاءً اَحْوٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41678,
            "SureId": 87,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "سَنُقْرِئُكَ فَلَا تَنْسٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41685,
            "SureId": 87,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "اِلَّا مَا شَٓاءَ اللّٰهُؕ اِنَّهُ یَعْلَمُ الْجَهْرَ وَمَا یَخْفٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41692,
            "SureId": 87,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "وَنُیَسِّرُكَ لِلْیُسْرٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41699,
            "SureId": 87,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "فَذَكِّرْ اِنْ نَفَعَتِ الذِّكْرٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41706,
            "SureId": 87,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "سَیَذَّكَّرُ مَنْ یَخْشٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41713,
            "SureId": 87,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "وَیَتَجَنَّبُهَا الْاَشْقٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41720,
            "SureId": 87,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "اَلَّذٖی یَصْلَى النَّارَ الْكُبْرٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41727,
            "SureId": 87,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "ثُمَّ لَا یَمُوتُ فٖیهَا وَلَا یَحْیٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41734,
            "SureId": 87,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "قَدْ اَفْلَحَ مَنْ تَزَكّٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41741,
            "SureId": 87,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "وَذَكَرَ اسْمَ رَبِّهٖ فَصَلّٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41748,
            "SureId": 87,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "بَلْ تُؤْثِرُونَ الْحَیٰوةَ الدُّنْیَاؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41755,
            "SureId": 87,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "وَالْاٰخِرَةُ خَیْرٌ وَاَبْقٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41762,
            "SureId": 87,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "اِنَّ هٰذَا لَفِی الصُّحُفِ الْاُو𐻿لٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41769,
            "SureId": 87,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "صُحُفِ اِبْرٰهٖیمَ وَمُوسٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41776,
            "SureId": 88,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "هَلْ اَتٰیكَ حَدٖیثُ الْغَاشِیَةِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 88,
                "MealInfo": "Mekke döneminde inmiştir. 26 âyettir. Sûre, adını birinci âyetteki “el-Gâşiye”kelimesinden almıştır. Ğâşiye, kaplayıp bürüyen demektir.",
                "SureNameTurkish": "Gâşiye",
                "SureNameArabic": "الْغَاشِيَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 68,
                "AyetCount": 26,
                "Cuz": 30,
                "FirstPage": 592,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 41783,
            "SureId": 88,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "وُجُوهٌ یَوْمَئِذٍ خَاشِعَةٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41790,
            "SureId": 88,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "عَامِلَةٌ نَاصِبَةٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41797,
            "SureId": 88,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "تَصْلٰى نَارًا حَامِیَةًۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41804,
            "SureId": 88,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "تُسْقٰى مِنْ عَیْنٍ اٰنِیَةٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41811,
            "SureId": 88,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "لَیْسَ لَهُمْ طَعَامٌ اِلَّا مِنْ ضَرٖیعٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41818,
            "SureId": 88,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "لَا یُسْمِنُ وَلَا یُغْنٖی مِنْ جُوعٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41825,
            "SureId": 88,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "وُجُوهٌ یَوْمَئِذٍ نَاعِمَةٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41832,
            "SureId": 88,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "لِسَعْیِهَا رَاضِیَةٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41839,
            "SureId": 88,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "فٖی جَنَّةٍ عَالِیَةٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41846,
            "SureId": 88,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "لَا تَسْمَعُ فٖیهَا لَاغِیَةًؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 41641,
            "SureId": 87,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "Yüce rabbinin adını takdis ve tenzih ederek an.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 87,
                "MealInfo": "Mekke döneminde inmiştir. 19 âyettir. Sûre, adını birinci âyette yer alan ve AllahTeâlâ’yı niteleyen “el-A’lâ” kelimesinden almıştır. A’lâ, en yüce demektir.",
                "SureNameTurkish": "A'lâ",
                "SureNameArabic": "الْاَعْلٰى",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 8,
                "AyetCount": 19,
                "Cuz": 30,
                "FirstPage": 592,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 41648,
            "SureId": 87,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "Yaratıp uygun şekil veren;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41655,
            "SureId": 87,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "Ölçülü ve amaçlı yapan, yol gösteren;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41662,
            "SureId": 87,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4-5",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "Yeşil bitkileri çıkartan, sonra onları kapkara bitki kalıntısı haline getiren (rabbinin adını).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41669,
            "SureId": 87,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": false,
            "Page": 592,
            "AyetText": "Yeşil bitkileri çıkartan, sonra onları kapkara bitki kalıntısı haline getiren (rabbinin).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41676,
            "SureId": 87,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6-7",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "Sana okutacağız ve Allah öyle dilemedikçe unutmayacaksın. O, açık olanı da bilir, gizli olanı da.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41683,
            "SureId": 87,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": false,
            "Page": 592,
            "AyetText": "Sana okutacağız ve Allah dilemedikçe unutmayacaksın. O, açık olanı da bilir, gizli olanı da.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41690,
            "SureId": 87,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "Sana kolaylık ve huzurun yollarını açacağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41697,
            "SureId": 87,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "O halde öğüt ver; öğüt mutlaka fayda sağlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41704,
            "SureId": 87,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "Allah’tan korkan öğüt alacaktır;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41711,
            "SureId": 87,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "Ebedî mutluluktan nasibi olmayan da ondan uzak durur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41718,
            "SureId": 87,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "İşte en büyük ateşe girecek olan odur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41725,
            "SureId": 87,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "Sonra orada ne ölür ne de yaşar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41732,
            "SureId": 87,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14-15",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "Doğrusu arınan ve rabbinin adını anıp namaz kılan kurtuluşa ermiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41739,
            "SureId": 87,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": false,
            "Page": 592,
            "AyetText": "Doğrusu arınan ve rabbinin adını anıp namaz kılan kurtuluşa ermiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41746,
            "SureId": 87,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "Fakat siz dünya hayatını tercih ediyorsunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41753,
            "SureId": 87,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "Oysa âhiret daha hayırlı ve süreklidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41760,
            "SureId": 87,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18-19",
            "AyetVisible": true,
            "Page": 592,
            "AyetText": "Bunlar önceki kitaplarda, İbrâhim ve Mûsâ’nın kitaplarında da vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41767,
            "SureId": 87,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": false,
            "Page": 592,
