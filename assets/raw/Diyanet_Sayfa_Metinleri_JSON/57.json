                "ExcludeMenu": false
            }
        },
        {
            "Id": 2429,
            "SureId": 3,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "وَمَكَرُوا وَمَكَرَ اللّٰهُؕ وَاللّٰهُ خَیْرُ الْمَاكِرٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2436,
            "SureId": 3,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "اِذْ قَالَ اللّٰهُ یَا عٖیسٰٓى اِنّٖی مُتَوَفّٖیكَ وَرَافِعُكَ اِلَیَّ وَمُطَهِّرُكَ مِنَ الَّذٖینَ كَفَرُوا وَجَاعِلُ الَّذٖینَ اتَّبَعُوكَ فَوْقَ الَّذٖینَ كَفَرُٓوا اِلٰى یَوْمِ الْقِیٰمَةِۚ ثُمَّ اِلَیَّ مَرْجِعُكُمْ فَاَحْكُمُ بَیْنَكُمْ فٖیمَا كُنْتُمْ فٖیهِ تَخْتَلِفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2443,
            "SureId": 3,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "فَاَمَّا الَّذٖینَ كَفَرُوا فَاُعَذِّبُهُمْ عَذَابًا شَدٖیدًا فِی الدُّنْیَا وَالْاٰخِرَةِؗ وَمَا لَهُمْ مِنْ نَاصِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2450,
            "SureId": 3,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "وَاَمَّا الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَیُوَفّٖیهِمْ اُجُورَهُمْؕ وَاللّٰهُ لَا یُحِبُّ الظَّالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2457,
            "SureId": 3,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "ذٰلِكَ نَتْلُوهُ عَلَیْكَ مِنَ الْاٰیَاتِ وَالذِّكْرِ الْحَكٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2464,
            "SureId": 3,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "اِنَّ مَثَلَ عٖیسٰى عِنْدَ اللّٰهِ كَمَثَلِ اٰدَمَؕ خَلَقَهُ مِنْ تُرَابٍ ثُمَّ قَالَ لَهُ كُنْ فَیَكُونُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2471,
            "SureId": 3,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "اَلْحَقُّ مِنْ رَبِّكَ فَلَا تَكُنْ مِنَ الْمُمْتَرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2478,
            "SureId": 3,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "فَمَنْ حَٓاجَّكَ فٖیهِ مِنْ بَعْدِ مَا جَٓاءَكَ مِنَ الْعِلْمِ فَقُلْ تَعَالَوْا نَدْعُ اَبْنَٓاءَنَا وَاَبْنَٓاءَكُمْ وَنِسَٓاءَنَا وَنِسَٓاءَكُمْ وَاَنْفُسَنَا وَاَنْفُسَكُمْ ثُمَّ نَبْتَهِلْ فَنَجْعَلْ لَعْنَتَ اللّٰهِ عَلَى الْكَاذِبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 2420,
            "SureId": 3,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "“Rabbimiz! İndirdiğine inandık ve peygambere tâbi olduk; artık bizi şahitlerle beraber yaz.”",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 2427,
            "SureId": 3,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "(Yahudiler) tuzak kurdular, Allah da onların tuzaklarını bozdu. Evet, Allah en iyi tuzak bozucudur.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2434,
            "SureId": 3,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "Allah buyurmuştu ki: “Ey Îsâ! Ben seni vefat ettireceğim, seni katıma yükselteceğim, seni o inkârcılardan arındıracağım ve sana tâbi olanları kıyamet gününe kadar inkâr edenlerden üstün kılacağım. Sonra dönüşünüz bana olacak. İşte, ayrılığa düşüp durduğunuz hususlarda aranızda hükmü o zaman ben vereceğim.”",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2441,
            "SureId": 3,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "“İnkâr edenleri dünyada da âhirette de şiddetli bir azaba çarptıracağım; onların hiç yardımcıları da olmayacak.”",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2448,
            "SureId": 3,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "İman edip dünya ve âhirete faydalı işler yapanlara gelince, Allah onlara mükâfatlarını eksiksiz verecektir. Allah zalimleri sevmez.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2455,
            "SureId": 3,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "İşte bu sana okuduğumuz apaçık delillerdir, hikmet dolu sözlerdir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2462,
            "SureId": 3,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "Allah nezdinde Îsâ’nın durumu Âdem’in durumu gibidir. Onu topraktan var etti; sonra ona “ol” dedi ve oluverdi.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2469,
            "SureId": 3,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "Gerçek, rabbinden gelendir. Öyle ise kuşkulananlardan olma.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2476,
            "SureId": 3,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": true,
            "Page": 57,
            "AyetText": "Sana gelen bu bilgiden sonra her kim bu konuda seninle tartışmaya kalkışırsa, de ki: “Gelin, çocuklarımızı ve çocuklarınızı, kadınlarımızı ve kadınlarınızı, kendimizi ve kendinizi çağıralım, sonra da Allah’ın lâneti yalancıların üzerine olsun diye dua edelim.”",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
