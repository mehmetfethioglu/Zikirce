    "QuranAyats": [
        {
            "Id": 26320,
            "SureId": 36,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "اِنَّ اَصْحَابَ الْجَنَّةِ الْیَوْمَ فٖی شُغُلٍ فَاكِهُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 36,
                "MealInfo": "Mekke döneminde inmiştir. 83 âyettir. Sûre, adını ilk âyeti oluşturan <b>“Yâ-S</b>în” harflerinden almıştır. Sûrede başlıca i<b>nsanın ahlâkî sorumlulukları, vahiy, Hz. Peygamber’i yalanlayan Kureyş kabilesi, Antakya halkına gönderilen peygamberler, Allah’ın birliğini ve kudretini gösteren deliller, öldükten sonra dirilme,hesap ve ceza konu </b>edilmektedir.",
                "SureNameTurkish": "Yâsîn",
                "SureNameArabic": "يٰسۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 41,
                "AyetCount": 83,
                "Cuz": 22,
                "FirstPage": 440,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26327,
            "SureId": 36,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "هُمْ وَاَزْوَاجُهُمْ فٖی ظِلَالٍ عَلَى الْاَرَٓائِكِ مُتَّكِؤُ𐻿نَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26334,
            "SureId": 36,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "لَهُمْ فٖیهَا فَاكِهَةٌ وَلَهُمْ مَا یَدَّعُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26341,
            "SureId": 36,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "سَلَامٌ قَوْلًا مِنْ رَبٍّ رَحٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26348,
            "SureId": 36,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "وَامْتَازُوا الْیَوْمَ اَیُّهَا الْمُجْرِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26355,
            "SureId": 36,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "اَلَمْ اَعْهَدْ اِلَیْكُمْ یَا بَنٖٓی اٰدَمَ اَنْ لَا تَعْبُدُوا الشَّیْطَانَۚ اِنَّهُ لَكُمْ عَدُوٌّ مُبٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26362,
            "SureId": 36,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "وَاَنِ اعْبُدُونٖیؕ هٰذَا صِرَاطٌ مُسْتَقٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26369,
            "SureId": 36,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "وَلَقَدْ اَضَلَّ مِنْكُمْ جِبِلًّا كَثٖیرًاؕ اَفَلَمْ تَكُونُوا تَعْقِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26376,
            "SureId": 36,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "هٰذِهٖ جَهَنَّمُ الَّتٖی كُنْتُمْ تُوعَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26383,
            "SureId": 36,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "اِصْلَوْهَا الْیَوْمَ بِمَا كُنْتُمْ تَكْفُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26390,
            "SureId": 36,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "اَلْیَوْمَ نَخْتِمُ عَلٰٓى اَفْوَاهِهِمْ وَتُكَلِّمُنَٓا اَیْدٖیهِمْ وَتَشْهَدُ اَرْجُلُهُمْ بِمَا كَانُوا یَكْسِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26397,
            "SureId": 36,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "وَلَوْ نَشَٓاءُ لَطَمَسْنَا عَلٰٓى اَعْیُنِهِمْ فَاسْتَبَقُوا الصِّرَاطَ فَاَنّٰى یُبْصِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26404,
            "SureId": 36,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "وَلَوْ نَشَٓاءُ لَمَسَخْنَاهُمْ عَلٰى مَكَانَتِهِمْ فَمَا اسْتَطَاعُوا مُضِیًّا وَلَا یَرْجِعُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26411,
            "SureId": 36,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "وَمَنْ نُعَمِّرْهُ نُنَكِّسْهُ فِی الْخَلْقِؕ اَفَلَا یَعْقِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26418,
            "SureId": 36,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "وَمَا عَلَّمْنَاهُ الشِّعْرَ وَمَا یَنْبَغٖی لَهُؕ اِنْ هُوَ اِلَّا ذِكْرٌ وَقُرْاٰنٌ مُبٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26425,
            "SureId": 36,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "لِیُنْذِرَ مَنْ كَانَ حَیًّا وَیَحِقَّ الْقَوْلُ عَلَى الْكَافِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 26318,
            "SureId": 36,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "O gün cennetlikler safa sürmekle meşguldürler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 36,
                "MealInfo": "Mekke döneminde inmiştir. 83 âyettir. Sûre, adını ilk âyeti oluşturan <b>“Yâ-S</b>în” harflerinden almıştır. Sûrede başlıca i<b>nsanın ahlâkî sorumlulukları, vahiy, Hz. Peygamber’i yalanlayan Kureyş kabilesi, Antakya halkına gönderilen peygamberler, Allah’ın birliğini ve kudretini gösteren deliller, öldükten sonra dirilme,hesap ve ceza konu </b>edilmektedir.",
                "SureNameTurkish": "Yâsîn",
                "SureNameArabic": "يٰسۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 41,
                "AyetCount": 83,
                "Cuz": 22,
                "FirstPage": 440,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26325,
            "SureId": 36,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "Kendileri ve eşleri gölgelik yerlerde, tahtlarına kurulacaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26332,
            "SureId": 36,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "Orada onlar için her tür meyve vardır ve bütün istekleri yerine getirilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26339,
            "SureId": 36,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "Engin merhamet sahibi rabden gelen söz şu olacak: “Selâm size!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26346,
            "SureId": 36,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "Ve “Ey günahkârlar! Siz bugün şöyle ayrılın!” (denir).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26353,
            "SureId": 36,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60-61",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "Ey Âdemoğulları! Size “Şeytana kulluk etmeyin, o sizin için apaçık bir düşmandır; bana kulluk edin, doğru yol budur” dememiş miydim?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26360,
            "SureId": 36,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": false,
            "Page": 444,
            "AyetText": "Ey Âdemoğulları! Size \"Şeytana kulluk etmeyin, o sizin için apaçık bir düşmandır; bana kulluk edin, doğru yol budur\" dememiş miydim?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26367,
            "SureId": 36,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "Nitekim o şeytan sizden nice nesilleri saptırdı. Hiç aklınızı kullanmıyor muydunuz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26374,
            "SureId": 36,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "İşte size bildirilen cehennem bu!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26381,
            "SureId": 36,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "İnkârcılıkta ısrar etmenize karşılık girin oraya!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26388,
            "SureId": 36,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "O gün onların ağızlarını mühürleriz; yapmış olduklarını elleri bize anlatır, ayakları da tanıklık eder.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26395,
            "SureId": 36,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "Dilesek (dünyada da) gözlerini büsbütün kör ederdik de yolu bulmak için çabalayıp dururlardı; ama o takdirde nasıl görebileceklerdi ki?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26402,
            "SureId": 36,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "Yine dilesek oldukları yerde onların mahiyetlerini değiştirirdik de (taş gibi) artık ne ileri gidebilirler ne de geri dönebilirlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26409,
            "SureId": 36,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "Kime uzun ömür verirsek onu yaratılış çizgisinde tersine çeviririz. Hiç düşünmezler mi!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26416,
            "SureId": 36,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "Biz ona şiir öğretmedik; zaten ona yaraşmazdı da. Ona vahyedilen, ancak bir öğüt ve apaçık Kur’an’dır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26423,
            "SureId": 36,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 444,
            "AyetText": "Diri olanları uyarsın ve inkârcılar hakkındaki o söz (ceza) gerçekleşsin diye (gönderilmiştir).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Yâsîn",
    "QuranSureLabel": "يٰسۤ",
