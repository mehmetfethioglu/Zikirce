    "QuranAyats": [
        {
            "Id": 37702,
            "SureId": 70,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "یُبَصَّرُونَهُمْؕ یَوَدُّ الْمُجْرِمُ لَوْ یَفْتَدٖی مِنْ عَذَابِ یَوْمِئِذٍ بِبَنٖیهِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 70,
                "MealInfo": "Mekke döneminde inmiştir. 44 âyettir. Sûre, adını üçüncü âyetteki “elMe’âric”kelimesinden almıştır. Me’âric, yükselme yolları demektir. Sûredebaşlıca, Mekke müşriklerinin inkâr, inat ve azgınlıkları, insan tabiatının bazıyönleri, ölüm ötesi hayatın gerçekliği konu edilmektedir",
                "SureNameTurkish": "Meâric",
                "SureNameArabic": "الْمَعَارِجِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 79,
                "AyetCount": 44,
                "Cuz": 29,
                "FirstPage": 568,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37709,
            "SureId": 70,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "وَصَاحِبَتِهٖ وَاَخٖیهِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37716,
            "SureId": 70,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "وَفَصٖیلَتِهِ الَّتٖی تُــْٔوٖیهِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37723,
            "SureId": 70,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "وَمَنْ فِی الْاَرْضِ جَمٖیعًاۙ ثُمَّ یُنْجٖیهِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37730,
            "SureId": 70,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "كَلَّاؕ اِنَّهَا لَظٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37737,
            "SureId": 70,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "نَزَّاعَةً لِلشَّوٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37744,
            "SureId": 70,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "تَدْعُوا مَنْ اَدْبَرَ وَتَوَلّٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37751,
            "SureId": 70,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "وَجَمَعَ فَاَوْعٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37758,
            "SureId": 70,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "اِنَّ الْاِنْسَانَ خُلِقَ هَلُوعًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37765,
            "SureId": 70,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "اِذَا مَسَّهُ الشَّرُّ جَزُوعًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37772,
            "SureId": 70,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "وَاِذَا مَسَّهُ الْخَیْرُ مَنُوعًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37779,
            "SureId": 70,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "اِلَّا الْمُصَلّٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37786,
            "SureId": 70,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "اَلَّذٖینَ هُمْ عَلٰى صَلَاتِهِمْ دَٓائِمُونَࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37793,
            "SureId": 70,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "وَالَّذٖینَ فٖٓی اَمْوَالِهِمْ حَقٌّ مَعْلُومٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37800,
            "SureId": 70,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "لِلسَّٓائِلِ وَالْمَحْرُومِࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37807,
            "SureId": 70,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "وَالَّذٖینَ یُصَدِّقُونَ بِیَوْمِ الدّٖینِࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37814,
            "SureId": 70,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "وَالَّذٖینَ هُمْ مِنْ عَذَابِ رَبِّهِمْ مُشْفِقُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37821,
            "SureId": 70,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "اِنَّ عَذَابَ رَبِّهِمْ غَیْرُ مَاْمُونٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37828,
            "SureId": 70,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "وَالَّذٖینَ هُمْ لِفُرُوجِهِمْ حَافِظُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37835,
            "SureId": 70,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "اِلَّا عَلٰٓى اَزْوَاجِهِمْ اَوْ مَا مَلَكَتْ اَیْمَانُهُمْ فَاِنَّهُمْ غَیْرُ مَلُومٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37842,
            "SureId": 70,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "فَمَنِ ابْتَغٰى وَرَٓاءَ ذٰلِكَ فَاُو𐻾لٰٓئِكَ هُمُ الْعَادُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37849,
            "SureId": 70,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "وَالَّذٖینَ هُمْ لِاَمَانَاتِهِمْ وَعَهْدِهِمْ رَاعُونَࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37856,
            "SureId": 70,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "وَالَّذٖینَ هُمْ بِشَهَادَاتِهِمْ قَٓائِمُونَࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37863,
            "SureId": 70,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "وَالَّذٖینَ هُمْ عَلٰى صَلَاتِهِمْ یُحَافِظُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37870,
            "SureId": 70,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "اُو𐻾لٰٓئِكَ فٖی جَنَّاتٍ مُكْرَمُونَؕࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37877,
            "SureId": 70,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "فَمَالِ الَّذٖینَ كَفَرُوا قِبَلَكَ مُهْطِعٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37884,
            "SureId": 70,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "عَنِ الْیَمٖینِۙ وَعَنِ الشِّمَالِ عِزٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37891,
            "SureId": 70,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "اَیَطْمَعُ كُلُّ امْرِئٍ مِنْهُمْ اَنْ یُدْخَلَ جَنَّةَ نَعٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37898,
            "SureId": 70,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 569,
            "AyetText": "كَلَّاؕ اِنَّا خَلَقْنَاهُمْ مِمَّا یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
