    "QuranAyats": [
        {
            "Id": 2695,
            "SureId": 3,
            "AyetId": 92,
            "LanguageId": 7,
            "AyetNumber": "٩٢",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "لَنْ تَنَالُوا الْبِرَّ حَتّٰى تُنْفِقُوا مِمَّا تُحِبُّونَؕ وَمَا تُنْفِقُوا مِنْ شَیْءٍ فَاِنَّ اللّٰهَ بِهٖ عَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 2702,
            "SureId": 3,
            "AyetId": 93,
            "LanguageId": 7,
            "AyetNumber": "٩٣",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "كُلُّ الطَّعَامِ كَانَ حِلًّا لِبَنٖٓی اِسْرَٓایٖٔلَ اِلَّا مَا حَرَّمَ اِسْرَٓایٖٔلُ عَلٰى نَفْسِهٖ مِنْ قَبْلِ اَنْ تُنَزَّلَ التَّوْرٰیةُؕ قُلْ فَاْتُوا بِالتَّوْرٰیةِ فَاتْلُوهَٓا اِنْ كُنْتُمْ صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2709,
            "SureId": 3,
            "AyetId": 94,
            "LanguageId": 7,
            "AyetNumber": "٩٤",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "فَمَنِ افْتَرٰى عَلَى اللّٰهِ الْكَذِبَ مِنْ بَعْدِ ذٰلِكَ فَاُو𐻾لٰٓئِكَ هُمُ الظَّالِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2716,
            "SureId": 3,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "قُلْ صَدَقَ اللّٰهُ فَاتَّبِعُوا مِلَّةَ اِبْرٰهٖیمَ حَنٖیفًاؕ وَمَا كَانَ مِنَ الْمُشْرِكٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2723,
            "SureId": 3,
            "AyetId": 96,
            "LanguageId": 7,
            "AyetNumber": "٩٦",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "اِنَّ اَوَّلَ بَیْتٍ وُضِعَ لِلنَّاسِ لَلَّذٖی بِبَكَّةَ مُبَارَكًا وَهُدًى لِلْعَالَمٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2730,
            "SureId": 3,
            "AyetId": 97,
            "LanguageId": 7,
            "AyetNumber": "٩٧",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "فٖیهِ اٰیَاتٌ بَیِّنَاتٌ مَقَامُ اِبْرٰهٖیمَۚ وَمَنْ دَخَلَهُ كَانَ اٰمِنًاؕ وَلِلّٰهِ عَلَى النَّاسِ حِجُّ الْبَیْتِ مَنِ اسْتَطَاعَ اِلَیْهِ سَبٖیلًاؕ وَمَنْ كَفَرَ فَاِنَّ اللّٰهَ غَنِیٌّ عَنِ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2737,
            "SureId": 3,
            "AyetId": 98,
            "LanguageId": 7,
            "AyetNumber": "٩٨",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "قُلْ یَٓا اَهْلَ الْكِتَابِ لِمَ تَكْفُرُونَ بِاٰیَاتِ اللّٰهِࣗ وَاللّٰهُ شَهٖیدٌ عَلٰى مَا تَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2744,
            "SureId": 3,
            "AyetId": 99,
            "LanguageId": 7,
            "AyetNumber": "٩٩",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "قُلْ یَٓا اَهْلَ الْكِتَابِ لِمَ تَصُدُّونَ عَنْ سَبٖیلِ اللّٰهِ مَنْ اٰمَنَ تَبْغُونَهَا عِوَجًا وَاَنْتُمْ شُهَدَٓاءُؕ وَمَا اللّٰهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2751,
            "SureId": 3,
            "AyetId": 100,
            "LanguageId": 7,
            "AyetNumber": "١٠٠",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "یَٓا اَیُّهَا الَّذٖینَ اٰمَنُٓوا اِنْ تُطٖیعُوا فَرٖیقًا مِنَ الَّذٖینَ اُو𐻿تُوا الْكِتَابَ یَرُدُّوكُمْ بَعْدَ اٖیمَانِكُمْ كَافِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 2693,
            "SureId": 3,
            "AyetId": 92,
            "LanguageId": 5,
            "AyetNumber": "92",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "Allah yolunda sevdiğiniz şeylerden harcamadıkça iyiliğe asla eremezsiniz. Ne harcarsanız Allah onu hakkıyla bilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 2700,
            "SureId": 3,
            "AyetId": 93,
            "LanguageId": 5,
            "AyetNumber": "93",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "Tevrat indirilmeden önce, İsrâil’in kendisine haram kıldıkları dışında, yiyeceklerin her türlüsü İsrâiloğulları’na helâl idi. De ki: “Doğru söylüyorsanız Tevrat’ı getirip okuyun!”",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2707,
            "SureId": 3,
            "AyetId": 94,
            "LanguageId": 5,
            "AyetNumber": "94",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "Artık bundan sonra kim Allah hakkında yalan uydurursa işte onlar zalimlerin ta kendileridir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2714,
            "SureId": 3,
            "AyetId": 95,
            "LanguageId": 5,
            "AyetNumber": "95",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "De ki: “Allah doğruyu söylemiştir. Öyle ise, Hanîf olan İbrâhim’in dinine uyunuz. O müşriklerden değildi.”",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2721,
            "SureId": 3,
            "AyetId": 96,
            "LanguageId": 5,
            "AyetNumber": "96",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "Gerçek şu ki, insanlar için yapılmış olan ilk ev, âlemlere bir hidayet ve bir bereket kaynağı olan Mekke’deki evdir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2728,
            "SureId": 3,
            "AyetId": 97,
            "LanguageId": 5,
            "AyetNumber": "97",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "Orada apaçık deliller, İbrâhim’in makamı vardır. Oraya giren emniyette olur. Gitmeye gücü yetenin o evi ziyaret etmesi, Allah’ın insanlar üzerinde bir hakkıdır. Kim inkâr ederse bilmelidir ki, Allah hiçbir şeye muhtaç değildir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2735,
            "SureId": 3,
            "AyetId": 98,
            "LanguageId": 5,
            "AyetNumber": "98",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "De ki: “Ey Ehl-i kitap! Allah yaptıklarınızı görüp dururken niçin Allah’ın âyetlerini inkâr edersiniz?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2742,
            "SureId": 3,
            "AyetId": 99,
            "LanguageId": 5,
            "AyetNumber": "99",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "De ki: “Ey Ehl-i kitap! (Gerçeği) görüp bildiğiniz halde niçin Allah’ın yolunu eğri göstermeye yeltenerek müminleri Allah yolundan çevirmeye kalkışıyorsunuz? Allah yaptıklarınızdan habersiz değildir.”",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2749,
            "SureId": 3,
            "AyetId": 100,
            "LanguageId": 5,
            "AyetNumber": "100",
            "AyetVisible": true,
            "Page": 62,
            "AyetText": "Ey iman edenler! Kendilerine kitap verilenlerden bir grubun sözünü dinlerseniz sizi imanınızdan vazgeçirip yeniden küfre döndürürler.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
