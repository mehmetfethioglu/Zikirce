{
    "PointerList": null,
    "CuzNo": 21,
    "PageNo": 410,
    "ArCuzNo": "۲۱",
    "ArPageNo": "٤۱۰",
    "QuranAyats": [
        {
            "Id": 24220,
            "SureId": 30,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "وَلَئِنْ اَرْسَلْنَا رٖیحًا فَرَاَوْهُ مُصْفَرًّا لَظَلُّوا مِنْ بَعْدِهٖ یَكْفُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 30,
                "MealInfo": "Mekke döneminde inmiştir. 60 âyettir. Sûre, adını ikinci âyette geçen <b>“erRûm”</b> kelimesinden almıştır. Sûre de başlıca <b>kıyametin hâllerinden, Allah’ın kudretine ve birliğine delalet eden kevnî meseleler ile Kureyş kabilesinin İslâm’a karşı olumsuz tutumu</b> konu edilmiştir.",
                "SureNameTurkish": "Rûm",
                "SureNameArabic": "الرُّومِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 84,
                "AyetCount": 60,
                "Cuz": 21,
                "FirstPage": 404,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 24227,
            "SureId": 30,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "فَاِنَّكَ لَا تُسْمِـعُ الْمَوْتٰى وَلَا تُسْمِـعُ الصُّمَّ الدُّعَٓاءَ اِذَا وَلَّوْا مُدْبِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24234,
            "SureId": 30,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "وَمَٓا اَنْتَ بِهَادِ الْعُمْیِ عَنْ ضَلَالَتِهِمْؕ اِنْ تُسْمِعُ اِلَّا مَنْ یُؤْمِنُ بِاٰیَاتِنَا فَهُمْ مُسْلِمُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24241,
            "SureId": 30,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "اَللّٰهُ الَّذٖی خَلَقَكُمْ مِنْ ضَعْفٍ ثُمَّ جَعَلَ مِنْ بَعْدِ ضَعْفٍ قُوَّةً ثُمَّ جَعَلَ مِنْ بَعْدِ قُوَّةٍ ضَعْفًا وَشَیْبَةًؕ یَخْلُقُ مَا یَشَٓاءُۚ وَهُوَ الْعَلٖیمُ الْقَدٖیرُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24248,
            "SureId": 30,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "وَیَوْمَ تَقُومُ السَّاعَةُ یُقْسِمُ الْمُجْرِمُونَۙ مَا لَبِثُوا غَیْرَ سَاعَةٍؕ كَذٰلِكَ كَانُوا یُؤْفَكُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24255,
            "SureId": 30,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "وَقَالَ الَّذٖینَ اُو𐻿تُوا الْعِلْمَ وَالْاٖیمَانَ لَقَدْ لَبِثْتُمْ فٖی كِتَابِ اللّٰهِ اِلٰى یَوْمِ الْبَعْثِؗ فَهٰذَا یَوْمُ الْبَعْثِ وَلٰكِنَّكُمْ كُنْتُمْ لَا تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24262,
            "SureId": 30,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "فَیَوْمَئِذٍ لَا یَنْفَعُ الَّذٖینَ ظَلَمُوا مَعْذِرَتُهُمْ وَلَا هُمْ یُسْتَعْتَبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24269,
            "SureId": 30,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "وَلَقَدْ ضَرَبْنَا لِلنَّاسِ فٖی هٰذَا الْقُرْاٰنِ مِنْ كُلِّ مَثَلٍؕ وَلَئِنْ جِئْتَهُمْ بِاٰیَةٍ لَیَقُولَنَّ الَّذٖینَ كَفَرُٓوا اِنْ اَنْتُمْ اِلَّا مُبْطِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24276,
            "SureId": 30,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "كَذٰلِكَ یَطْبَعُ اللّٰهُ عَلٰى قُلُوبِ الَّذٖینَ لَا یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24283,
            "SureId": 30,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "فَاصْبِرْ اِنَّ وَعْدَ اللّٰهِ حَقٌّ وَلَا یَسْتَخِفَّنَّكَ الَّذٖینَ لَا یُوقِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 24218,
            "SureId": 30,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "Andolsun ki, bir rüzgâr göndersek de onu (ekini) sararmış görseler, hemen nankörlük etmeye başlarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 30,
                "MealInfo": "Mekke döneminde inmiştir. 60 âyettir. Sûre, adını ikinci âyette geçen <b>“erRûm”</b> kelimesinden almıştır. Sûre de başlıca <b>kıyametin hâllerinden, Allah’ın kudretine ve birliğine delalet eden kevnî meseleler ile Kureyş kabilesinin İslâm’a karşı olumsuz tutumu</b> konu edilmiştir.",
                "SureNameTurkish": "Rûm",
                "SureNameArabic": "الرُّومِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 84,
                "AyetCount": 60,
                "Cuz": 21,
                "FirstPage": 404,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 24225,
            "SureId": 30,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "Bil ki sen ölülere işittiremezsin; dönüp giderlerken sağırlara da çağrıyı duyuramazsın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24232,
            "SureId": 30,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "Sen körleri yanlış gittikleri yoldan çevirip doğru yola sokamazsın. Sen (çağrını) ancak âyetlerimize inanıp teslim olanlara duyurabilirsin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24239,
            "SureId": 30,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "Sizi güçsüz yaratan, güçsüzlüğün ardından kuvvet veren, kuvvetli halinizden sonra da güçsüz hale getiren ve yaşlandıran Allah’tır. O dilediğini yaratır. O hakkıyla bilendir, üstün kudret sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24246,
            "SureId": 30,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "Günaha saplanmış olanlar kıyamet koptuğu gün (dünyada) sadece çok kısa bir süre kaldıklarına yemin ederler. İşte onlar haktan (oradayken de) böyle saptırılıyorlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24253,
            "SureId": 30,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "Kendilerine bilgi ve iman verilenler ise şöyle derler: “Andolsun ki siz, Allah’ın yazısına uygun olarak yeniden dirilme gününe kadar kaldınız. İşte bu diriliş günüdür; fakat siz onu tanımıyordunuz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24260,
            "SureId": 30,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "Artık o gün zulmedenlerin mazeretleri fayda sağlamayacak, onlardan Allah’ı hoşnut etmeye çalışmaları da istenmeyecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24267,
            "SureId": 30,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "Andolsun ki biz bu Kur’an’da insanlar için her türlü örneği verdik. Şayet sen onlara bir mûcize getirecek olsan, inkâr edenler mutlaka şöyle diyeceklerdir: “Siz ancak aslı esası olmayan şeyler ortaya koymaktasınız!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24274,
            "SureId": 30,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "İşte Allah, ilimden nasibi olmayanların kalplerini böyle mühürler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 24281,
            "SureId": 30,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 410,
            "AyetText": "Şimdi sen sabret. Bil ki Allah’ın vaadi gerçektir. İnanmayanlar sakın seni yolundan çevirmesin!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Rûm",
    "QuranSureLabel": "الرُّومِ",
    "EndPageSure": null
}