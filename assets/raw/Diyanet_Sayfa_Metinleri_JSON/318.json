    "QuranAyats": [
        {
            "Id": 17052,
            "SureId": 20,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "فَاَخْرَجَ لَهُمْ عِجْلًا جَسَدًا لَهُ خُوَارٌ فَقَالُوا هٰذَٓا اِلٰهُكُمْ وَاِلٰهُ مُوسٰى فَنَسِیَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17059,
            "SureId": 20,
            "AyetId": 89,
            "LanguageId": 7,
            "AyetNumber": "٨٩",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "اَفَلَا یَرَوْنَ اَلَّا یَرْجِعُ اِلَیْهِمْ قَوْلًاۙ وَلَا یَمْلِكُ لَهُمْ ضَرًّا وَلَا نَفْعًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17066,
            "SureId": 20,
            "AyetId": 90,
            "LanguageId": 7,
            "AyetNumber": "٩٠",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "وَلَقَدْ قَالَ لَهُمْ هٰرُونُ مِنْ قَبْلُ یَا قَوْمِ اِنَّمَا فُتِنْتُمْ بِهٖۚ وَاِنَّ رَبَّكُمُ الرَّحْمٰنُ فَاتَّبِعُونٖی وَاَطٖیعُٓوا اَمْرٖی",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17073,
            "SureId": 20,
            "AyetId": 91,
            "LanguageId": 7,
            "AyetNumber": "٩١",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "قَالُوا لَنْ نَبْرَحَ عَلَیْهِ عَاكِفٖینَ حَتّٰى یَرْجِعَ اِلَیْنَا مُوسٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17080,
            "SureId": 20,
            "AyetId": 92,
            "LanguageId": 7,
            "AyetNumber": "٩٢",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "قَالَ یَا هٰرُونُ مَا مَنَعَكَ اِذْ رَاَیْتَهُمْ ضَلُّواۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17087,
            "SureId": 20,
            "AyetId": 93,
            "LanguageId": 7,
            "AyetNumber": "٩٣",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "اَلَّا تَتَّبِعَنِؕ اَفَعَصَیْتَ اَمْرٖی",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17094,
            "SureId": 20,
            "AyetId": 94,
            "LanguageId": 7,
            "AyetNumber": "٩٤",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "قَالَ یَبْنَؤُ𐻾مَّ لَا تَاْخُذْ بِلِحْیَتٖی وَلَا بِرَاْسٖیۚ اِنّٖی خَشٖیتُ اَنْ تَقُولَ فَرَّقْتَ بَیْنَ بَنٖٓی اِسْرَٓایٖٔلَ وَلَمْ تَرْقُبْ قَوْلٖی",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17101,
            "SureId": 20,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "قَالَ فَمَا خَطْبُكَ یَا سَامِرِیُّ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17108,
            "SureId": 20,
            "AyetId": 96,
            "LanguageId": 7,
            "AyetNumber": "٩٦",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "قَالَ بَصُرْتُ بِمَا لَمْ یَبْصُرُوا بِهٖ فَقَبَضْتُ قَبْضَةً مِنْ اَثَرِ الرَّسُولِ فَنَبَذْتُهَا وَكَذٰلِكَ سَوَّلَتْ لٖی نَفْسٖی",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17115,
            "SureId": 20,
            "AyetId": 97,
            "LanguageId": 7,
            "AyetNumber": "٩٧",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "قَالَ فَاذْهَبْ فَاِنَّ لَكَ فِی الْحَیٰوةِ اَنْ تَقُولَ لَا مِسَاسَࣕ وَاِنَّ لَكَ مَوْعِدًا لَنْ تُخْلَفَهُۚ وَانْظُرْ اِلٰٓى اِلٰهِكَ الَّذٖی ظَلْتَ عَلَیْهِ عَاكِفًاؕ لَنُحَرِّقَنَّهُ ثُمَّ لَنَنْسِفَنَّهُ فِی الْیَمِّ نَسْفًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17122,
            "SureId": 20,
            "AyetId": 98,
            "LanguageId": 7,
            "AyetNumber": "٩٨",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "اِنَّمَٓا اِلٰهُكُمُ اللّٰهُ الَّذٖی لَٓا اِلٰهَ اِلَّا هُوَؕ وَسِعَ كُلَّ شَیْءٍ عِلْمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 17050,
            "SureId": 20,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "Derken onlara böğürebilen bir buzağı heykeli yaptı. (Ona uyanlar) “İşte bu sizin de tanrınız, Mûsâ’nın da tanrısıdır, fakat o bunu unuttu” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17057,
            "SureId": 20,
            "AyetId": 89,
            "LanguageId": 5,
            "AyetNumber": "89",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "Peki görmüyorlar mıydı ki o (heykel) kendilerine bir sözle karşılık veremiyordu, onlara zarar veremediği gibi fayda da sağlayamıyordu!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17064,
            "SureId": 20,
            "AyetId": 90,
            "LanguageId": 5,
            "AyetNumber": "90",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "Gerçek şu ki daha önce Hârûn onlara, “Ey kavmim! Siz bununla sınanmaktasınız; kuşkusuz sizin rabbiniz o rahmândır. O halde bana uyun ve emrime itaat edin” demişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17071,
            "SureId": 20,
            "AyetId": 91,
            "LanguageId": 5,
            "AyetNumber": "91",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "Şöyle cevap verdiler: “Mûsâ yanımıza dönünceye kadar ona tapmaktan asla vazgeçmeyeceğiz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17078,
            "SureId": 20,
            "AyetId": 92,
            "LanguageId": 5,
            "AyetNumber": "92-93",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "(Mûsâ dönünce) dedi ki: “Ey Hârûn! Onların saptıklarını gördüğünde beni izlemekten seni alıkoyan neydi? Yoksa emrime isyan mı ettin?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17085,
            "SureId": 20,
            "AyetId": 93,
            "LanguageId": 5,
            "AyetNumber": "93",
            "AyetVisible": false,
            "Page": 318,
            "AyetText": "(Mûsâ dönünce) dedi ki: \"Ey Hârûn! Onların saptıklarını gördüğünde beni izleyip gelmekten seni alıkoyan neydi? Yoksa emrime isyan mı ettin?\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17092,
            "SureId": 20,
            "AyetId": 94,
            "LanguageId": 5,
            "AyetNumber": "94",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "O şöyle cevap verdi: “Ey anamın oğlu! Sakalımı saçımı çekme. Emin ol ki ben senin, ‘Sözüme riayet etmedin de İsrâiloğulları’nın arasına ayrılık soktun!’ diyeceğinden endişelenmiştim.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17099,
            "SureId": 20,
            "AyetId": 95,
            "LanguageId": 5,
            "AyetNumber": "95",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "Mûsâ sordu: “Peki senin zorun neydi ey Sâmirî?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17106,
            "SureId": 20,
            "AyetId": 96,
            "LanguageId": 5,
            "AyetNumber": "96",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "“Ben onların görmediklerini gördüm, bu yüzden elçinin izinden bir avuç avuçladım ve onu attım. Nefsim beni böyle yapmaya itti” diye cevap verdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17113,
            "SureId": 20,
            "AyetId": 97,
            "LanguageId": 5,
            "AyetNumber": "97",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "(Mûsâ) şöyle dedi: “Haydi git! Artık hayatın boyunca sana düşen ‘Bana dokunmak yok!’ demekten ibarettir. Ve bil ki asla kaçıp kurtulamayacağın bir hesap günü de seni beklemektedir. Şimdi şu tapıp durmakta olduğun tanrına bir bak; biz onu iyice yakacağız, sonra da küllerini denize savuracağız!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17120,
            "SureId": 20,
            "AyetId": 98,
            "LanguageId": 5,
            "AyetNumber": "98",
            "AyetVisible": true,
            "Page": 318,
            "AyetText": "Sizin yegâne tanrınız o Allah’tır ki O’ndan başka ilâh yoktur. O ilmiyle her şeyi kuşatmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
