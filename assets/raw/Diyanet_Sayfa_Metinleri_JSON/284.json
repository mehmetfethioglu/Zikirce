{
    "PointerList": null,
    "CuzNo": 15,
    "PageNo": 284,
    "ArCuzNo": "۱٥",
    "ArPageNo": "۲۸٤",
    "QuranAyats": [
        {
            "Id": 14329,
            "SureId": 17,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "مَنْ كَانَ یُرٖیدُ الْعَاجِلَةَ عَجَّلْنَا لَهُ فٖیهَا مَا نَشَٓاءُ لِمَنْ نُرٖیدُ ثُمَّ جَعَلْنَا لَهُ جَهَنَّمَۚ یَصْلٰیهَا مَذْمُومًا مَدْحُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14336,
            "SureId": 17,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "وَمَنْ اَرَادَ الْاٰخِرَةَ وَسَعٰى لَهَا سَعْیَهَا وَهُوَ مُؤْمِنٌ فَاُو𐻾لٰٓئِكَ كَانَ سَعْیُهُمْ مَشْكُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14343,
            "SureId": 17,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "كُلًّا نُمِدُّ هٰٓؤُ𐻾لَٓاءِ وَهٰٓؤُ𐻾لَٓاءِ مِنْ عَطَٓاءِ رَبِّكَؕ وَمَا كَانَ عَطَٓاءُ رَبِّكَ مَحْظُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14350,
            "SureId": 17,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "اُنْظُرْ كَیْفَ فَضَّلْنَا بَعْضَهُمْ عَلٰى بَعْضٍؕ وَلَلْاٰخِرَةُ اَكْبَرُ دَرَجَاتٍ وَاَكْبَرُ تَفْضٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14357,
            "SureId": 17,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "لَا تَجْعَلْ مَعَ اللّٰهِ اِلٰهًا اٰخَرَ فَتَقْعُدَ مَذْمُومًا مَخْذُولًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14364,
            "SureId": 17,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "وَقَضٰى رَبُّكَ اَلَّا تَعْبُدُٓوا اِلَّٓا اِیَّاهُ وَبِالْوَالِدَیْنِ اِحْسَانًاؕ اِمَّا یَبْلُغَنَّ عِنْدَكَ الْكِبَرَ اَحَدُهُمَٓا اَوْ كِلَاهُمَا فَلَا تَقُلْ لَهُمَٓا اُفٍّ وَلَا تَنْهَرْهُمَا وَقُلْ لَهُمَا قَوْلًا كَرٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14371,
            "SureId": 17,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "وَاخْفِضْ لَهُمَا جَنَاحَ الذُّلِّ مِنَ الرَّحْمَةِ وَقُلْ رَبِّ ارْحَمْهُمَا كَمَا رَبَّیَانٖی صَغٖیرًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14378,
            "SureId": 17,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "رَبُّكُمْ اَعْلَمُ بِمَا فٖی نُفُوسِكُمْؕ اِنْ تَكُونُوا صَالِحٖینَ فَاِنَّهُ كَانَ لِلْاَوَّابٖینَ غَفُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14385,
            "SureId": 17,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "وَاٰتِ ذَا الْقُرْبٰى حَقَّهُ وَالْمِسْكٖینَ وَابْنَ السَّبٖیلِ وَلَا تُبَذِّرْ تَبْذٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14392,
            "SureId": 17,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "اِنَّ الْمُبَذِّرٖینَ كَانُٓوا اِخْوَانَ الشَّیَاطٖینِؕ وَكَانَ الشَّیْطَانُ لِرَبِّهٖ كَفُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 14327,
            "SureId": 17,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "Kim bu geçici dünyayı isterse burada istediğimiz kimseye dilediğimiz şeyleri veririz; sonra da onu cehenneme göndeririz; oraya kınanmış ve kovulmuş olarak girer.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14334,
            "SureId": 17,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "Kim de âhireti ister ve bir mümin olarak âhiret için ona yaraşır bir çabayla çalışırsa işte böylelerinin çabaları karşılık görecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14341,
            "SureId": 17,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "Hepsine, bunlara da ötekilere de rabbinin ihsanından kesintisiz veririz. Rabbinin ihsanı sınırlı değildir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14348,
            "SureId": 17,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "Baksana, biz insanların kimini kiminden nasıl farklı kılmışızdır. Elbette âhiretteki dereceler ve farklılıklar daha büyük olacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14355,
            "SureId": 17,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "Allah’tan başka tanrı tanıma; sonra kınanmış ve yalnızlığa terkedilmiş olarak kalırsın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14362,
            "SureId": 17,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "Rabbin, sadece kendisine kulluk etmenizi ve anne babanıza iyi davranmanızı emretti. Onlardan biri veya ikisi senin yanında yaşlanırsa onlara öf bile deme! Onları azarlama! İkisine de gönül alıcı güzel sözler söyle.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14369,
            "SureId": 17,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "Onlara merhametle ve alçak gönüllülükle kol kanat ger. “Rabbim! Onlar nasıl küçüklükte beni şefkatle eğitip yetiştirdilerse şimdi sen de onlara merhamet göster” diyerek dua et.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14376,
            "SureId": 17,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "Kalplerinizdekini en iyi bilen rabbinizdir. Eğer iyi olursanız bilesiniz ki Allah kendisine yönelenleri bağışlayıcıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14383,
            "SureId": 17,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "Akrabaya, yoksula ve yolcuya hakkını ver. Gereksiz yere de saçıp savurma!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14390,
            "SureId": 17,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 284,
            "AyetText": "Çünkü savurganlar şeytanların dostlarıdır. Şeytan da rabbine karşı çok nankördür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "İsrâ",
    "QuranSureLabel": "الْاِسْرَاۤءِ",
    "EndPageSure": null
