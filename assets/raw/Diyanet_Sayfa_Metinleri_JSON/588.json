            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "وَیْلٌ لِلْمُطَفِّفٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 83,
                "MealInfo": "Mekke döneminde inmiştir. 36 âyettir. Sûre, adını ilk âyette geçen “elMutaffifîn”kelimesinden almıştır. Mutaffifîn, ölçüde ve tartıda hile yapanlardemektir.",
                "SureNameTurkish": "Mutaffifîn",
                "SureNameArabic": "الْمُطَفِّف۪ينَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 86,
                "AyetCount": 36,
                "Cuz": 30,
                "FirstPage": 588,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 40950,
            "SureId": 83,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "اَلَّذٖینَ اِذَا ا‌كْتَالُوا عَلَى النَّاسِ یَسْتَوْفُونَؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40957,
            "SureId": 83,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "وَاِذَا كَالُوهُمْ اَوْ وَزَنُوهُمْ یُخْسِرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40964,
            "SureId": 83,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "اَلَا یَظُنُّ اُو𐻾لٰٓئِكَ اَنَّهُمْ مَبْعُوثُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40971,
            "SureId": 83,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "لِیَوْمٍ عَظٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40978,
            "SureId": 83,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "یَوْمَ یَقُومُ النَّاسُ لِرَبِّ الْعَالَمٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40985,
            "SureId": 83,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "كَلَّٓا اِنَّ كِتَابَ الْفُجَّارِ لَفٖی سِجّٖینٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40992,
            "SureId": 83,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "وَمَٓا اَدْرٰیكَ مَا سِجّٖینٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40999,
            "SureId": 83,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "كِتَابٌ مَرْقُومٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41006,
            "SureId": 83,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "وَیْلٌ یَوْمَئِذٍ لِلْمُكَذِّبٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41013,
            "SureId": 83,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "اَلَّذٖینَ یُكَذِّبُونَ بِیَوْمِ الدّٖینِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41020,
            "SureId": 83,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "وَمَا یُكَذِّبُ بِهٖٓ اِلَّا كُلُّ مُعْتَدٍ اَثٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41027,
            "SureId": 83,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "اِذَا تُتْلٰى عَلَیْهِ اٰیَاتُنَا قَالَ اَسَاطٖیرُ الْاَوَّلٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41034,
            "SureId": 83,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "كَلَّا بَلْ𐻽 رَانَ عَلٰى قُلُوبِهِمْ مَا كَانُوا یَكْسِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41041,
            "SureId": 83,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "كَلَّٓا اِنَّهُمْ عَنْ رَبِّهِمْ یَوْمَئِذٍ لَمَحْجُوبُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41048,
            "SureId": 83,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "ثُمَّ اِنَّهُمْ لَصَالُوا الْجَحٖیمِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41055,
            "SureId": 83,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "ثُمَّ یُقَالُ هٰذَا الَّذٖی كُنْتُمْ بِهٖ تُكَذِّبُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41062,
            "SureId": 83,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "كَلَّٓا اِنَّ كِتَابَ الْاَبْرَارِ لَفٖی عِلِّیّٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41069,
            "SureId": 83,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "وَمَٓا اَدْرٰیكَ مَا عِلِّیُّونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41076,
            "SureId": 83,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "كِتَابٌ مَرْقُومٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41083,
            "SureId": 83,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "یَشْهَدُهُ الْمُقَرَّبُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41090,
            "SureId": 83,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "اِنَّ الْاَبْرَارَ لَفٖی نَعٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41097,
            "SureId": 83,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "عَلَى الْاَرَٓائِكِ یَنْظُرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41104,
            "SureId": 83,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "تَعْرِفُ فٖی وُجُوهِهِمْ نَضْرَةَ النَّعٖیمِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41111,
            "SureId": 83,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "یُسْقَوْنَ مِنْ رَحٖیقٍ مَخْتُومٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41118,
            "SureId": 83,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "خِتَامُهُ مِسْكٌؕ وَفٖی ذٰلِكَ فَلْیَتَنَافَسِ الْمُتَنَافِسُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 40941,
            "SureId": 83,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Eksik ölçüp tartanların vay haline!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 83,
                "MealInfo": "Mekke döneminde inmiştir. 36 âyettir. Sûre, adını ilk âyette geçen “elMutaffifîn”kelimesinden almıştır. Mutaffifîn, ölçüde ve tartıda hile yapanlardemektir.",
                "SureNameTurkish": "Mutaffifîn",
                "SureNameArabic": "الْمُطَفِّف۪ينَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 86,
                "AyetCount": 36,
                "Cuz": 30,
                "FirstPage": 588,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 40948,
            "SureId": 83,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Onlar, insanlardan ölçerek bir şey aldıklarında tam ölçerler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40955,
            "SureId": 83,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Kendileri başkalarına vermek için ölçüp tarttıklarında ise haksızlık ederler (eksiltirler).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40962,
            "SureId": 83,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4-6",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Onlar, o büyük gün için -insanların âlemlerin rabbinin huzuruna çıkacakları gün için- diriltileceklerini akıllarına getirmiyorlar mı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40969,
            "SureId": 83,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": false,
            "Page": 588,
            "AyetText": "Onlar, o büyük günde -ki, işte o gün insanlar âlemlerin rabbinin huzuruna çıkacaklar- diriltileceklerini akıllarına getirmiyorlar mı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40976,
            "SureId": 83,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": false,
            "Page": 588,
            "AyetText": "Onlar, o büyük günde -ki, işte o gün insanlar âlemlerin rabbinin huzuruna çıkacaklar- diriltileceklerini akıllarına getirmiyorlar mı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40983,
            "SureId": 83,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Doğrusu şudur ki, günahkârların yazısı muhakkak siccîndedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40990,
            "SureId": 83,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Siccîn nedir, bilir misin?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40997,
            "SureId": 83,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "O, amellerin kaydedilmiş bulunduğu bir defterdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41004,
            "SureId": 83,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Gerçeği yalan sayanların o gün vay haline!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41011,
            "SureId": 83,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Onlar yargı gününü asılsız sayanlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41018,
            "SureId": 83,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Oysa onu, haddi aşan günahkârdan başkası inkâr etmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41025,
            "SureId": 83,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Ona âyetlerimiz okunduğu zaman, “eskilerin masalları” der.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41032,
            "SureId": 83,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Hayır! Gerçek şu ki, yapıp ettikleri kalplerini kaplayıp karartmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41039,
            "SureId": 83,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Ve gerçek şu ki onlar, o gün elbette rablerinden mahrum kalacaklardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41046,
            "SureId": 83,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Sonra onlar mutlaka cehenneme gireceklerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41053,
            "SureId": 83,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Sonra da onlara, “İşte inkâr etmiş olduğunuz cehennem budur!” denilecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41060,
            "SureId": 83,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Hayır hayır! Şüphe yok ki erdem sahiplerinin kaydı illiyyîndedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41067,
            "SureId": 83,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "Bilir misin nedir illiyyîn?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41074,
            "SureId": 83,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20-21",
            "AyetVisible": true,
            "Page": 588,
            "AyetText": "O, amellerin kaydedildiği bir defterdir; onu Allah’a yakın olanlar görür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41081,
            "SureId": 83,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": false,
            "Page": 588,
            "AyetText": "O, Allah’a yakın olanların görüp durdukları, (ameller) kaydedilmiş bir defterdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
