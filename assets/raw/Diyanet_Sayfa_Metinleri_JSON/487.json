    "QuranAyats": [
        {
            "Id": 30128,
            "SureId": 42,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "وَمِنْ اٰیَاتِهِ الْجَوَارِ فِی الْبَحْرِ كَالْاَعْلَامِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 42,
                "MealInfo": "Mekke döneminde inmiştir. 53 âyettir. Sûre, adını 38. âyette geçen<b> “Şûrâ” </b>kelimesinden almıştır.<b> Şûrâ, danışma demektir.</b> Sûrede <b>başlıca müslümanların işlerini kendi aralarında danışma yoluyla yürüttükleri, ayrıca kâinatta Allah’ın birliğini gösteren deliller ve kıyamet gününün hâlleri konu </b>edilmektedir",
                "SureNameTurkish": "Şûrâ",
                "SureNameArabic": "الشُّورٰى",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 62,
                "AyetCount": 53,
                "Cuz": 25,
                "FirstPage": 483,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30135,
            "SureId": 42,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "اِنْ یَشَاْ یُسْكِنِ الرّٖیحَ فَیَظْلَلْنَ رَوَاكِدَ عَلٰى ظَهْرِهٖؕ اِنَّ فٖی ذٰلِكَ لَاٰیَاتٍ لِكُلِّ صَبَّارٍ شَكُورٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30142,
            "SureId": 42,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "اَوْ یُوبِقْهُنَّ بِمَا كَسَبُوا وَیَعْفُ عَنْ كَثٖیرٍؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30149,
            "SureId": 42,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "وَیَعْلَمَ الَّذٖینَ یُجَادِلُونَ فٖٓی اٰیَاتِنَاؕ مَا لَهُمْ مِنْ مَحٖیصٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30156,
            "SureId": 42,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "فَمَٓا اُو𐻿تٖیتُمْ مِنْ شَیْءٍ فَمَتَاعُ الْحَیٰوةِ الدُّنْیَاۚ وَمَا عِنْدَ اللّٰهِ خَیْرٌ وَاَبْقٰى لِلَّذٖینَ اٰمَنُوا وَعَلٰى رَبِّهِمْ یَتَوَكَّلُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30163,
            "SureId": 42,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "وَالَّذٖینَ یَجْتَنِبُونَ كَبَٓائِرَ الْاِثْمِ وَالْفَوَاحِشَ وَاِذَا مَا غَضِبُوا هُمْ یَغْفِرُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30170,
            "SureId": 42,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "وَالَّذٖینَ اسْتَجَابُوا لِرَبِّهِمْ وَاَقَامُوا الصَّلٰوةَࣕ وَاَمْرُهُمْ شُورٰى بَیْنَهُمْࣕ وَمِمَّا رَزَقْنَاهُمْ یُنْفِقُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30177,
            "SureId": 42,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "وَالَّذٖینَ اِذَٓا اَصَابَهُمُ الْبَغْیُ هُمْ یَنْتَصِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30184,
            "SureId": 42,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "وَجَزٰٓؤُ𐻾ا سَیِّئَةٍ سَیِّئَةٌ مِثْلُهَاۚ فَمَنْ عَفَا وَاَصْلَحَ فَاَجْرُهُ عَلَى اللّٰهِؕ اِنَّهُ لَا یُحِبُّ الظَّالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30191,
            "SureId": 42,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "وَلَمَنِ انْتَصَرَ بَعْدَ ظُلْمِهٖ فَاُو𐻾لٰٓئِكَ مَا عَلَیْهِمْ مِنْ سَبٖیلٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30198,
            "SureId": 42,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "اِنَّمَا السَّبٖیلُ عَلَى الَّذٖینَ یَظْلِمُونَ النَّاسَ وَیَبْغُونَ فِی الْاَرْضِ بِغَیْرِ الْحَقِّؕ اُو𐻾لٰٓئِكَ لَهُمْ عَذَابٌ اَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30205,
            "SureId": 42,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "وَلَمَنْ صَبَرَ وَغَفَرَ اِنَّ ذٰلِكَ لَمِنْ عَزْمِ الْاُمُورِࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30212,
            "SureId": 42,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "وَمَنْ یُضْلِلِ اللّٰهُ فَمَا لَهُ مِنْ وَلِیٍّ مِنْ بَعْدِهٖؕ وَتَرَى الظَّالِمٖینَ لَمَّا رَاَوُا الْعَذَابَ یَقُولُونَ هَلْ اِلٰى مَرَدٍّ مِنْ سَبٖیلٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 30126,
            "SureId": 42,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "Denizde (yelkenlerini) bayraklar gibi (açarak) süzülüp giden gemiler de O’nun kudretinin kanıtlarındandır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 42,
                "MealInfo": "Mekke döneminde inmiştir. 53 âyettir. Sûre, adını 38. âyette geçen<b> “Şûrâ” </b>kelimesinden almıştır.<b> Şûrâ, danışma demektir.</b> Sûrede <b>başlıca müslümanların işlerini kendi aralarında danışma yoluyla yürüttükleri, ayrıca kâinatta Allah’ın birliğini gösteren deliller ve kıyamet gününün hâlleri konu </b>edilmektedir",
                "SureNameTurkish": "Şûrâ",
                "SureNameArabic": "الشُّورٰى",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 62,
                "AyetCount": 53,
                "Cuz": 25,
                "FirstPage": 483,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30133,
            "SureId": 42,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "O dilese rüzgârı dindirir de gemiler denizin üzerinde hareketsiz kalıverirler. Şüphesiz bunda çok sabreden, çok şükreden herkes için ibretler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30140,
            "SureId": 42,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "Yahut yapıp ettiklerinden dolayı onları batırıp içindekileri helâk eder; birçoğunu da bağışlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30147,
            "SureId": 42,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "Böylece âyetlerimize karşı mücadele verenler bilsinler ki kendileri için kaçacak yer yoktur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30154,
            "SureId": 42,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "Size verilen her şey dünya hayatının geçici zevklerinden ibarettir. Allah katında olanlar ise daha iyi ve daha kalıcıdır. Bunlar, iman eden ve rablerine dayanıp güvenenler içindir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30161,
            "SureId": 42,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "Onlar büyük günahlardan ve hayâsızlıklardan kaçınırlar, öfkelendiklerinde dahi bağışlarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30168,
            "SureId": 42,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "Rablerinin çağrısına uyarlar, namazı özenle kılarlar. İşleri de aralarındaki danışma ile yürür. Kendilerine verdiğimiz rızıktan başkaları için harcarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30175,
            "SureId": 42,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "Onlara haksız bir saldırı yapıldığında elbirliğiyle kendilerini savunurlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30182,
            "SureId": 42,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "Bir kötülüğün karşılığı ona denk bir kötülüktür; ama kim bağışlar, düzeltme yolunu tutarsa onun mükâfatını Allah verir. Hiç şüphe yok ki O haksızlık edenleri sevmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30189,
            "SureId": 42,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "Haksızlığa uğradığı için karşılık verenlere gelince, onlar aleyhine bir yol tutulamaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30196,
            "SureId": 42,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "Kınama ve cezalandırma ancak insanlara zulmeden ve yeryüzünde haksız yere saldırıda bulunanlara yöneliktir. Onlar için elem verici bir azap da vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30203,
            "SureId": 42,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "Ama kim sabreder ve bağışlarsa, işte bu güçlü irade gerektiren işlerdendir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30210,
            "SureId": 42,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 487,
            "AyetText": "Allah kimi sapkınlığıyla baş başa bırakırsa, artık onun bir velîsi olmaz. Azapla yüz yüze geldiklerinde zalimlerin, “Geri dönmenin bir yolu yok mu?” diye feryat ettiklerini göreceksin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Şûrâ",
    "QuranSureLabel": "الشُّورٰى",
    "EndPageSure": null
}