    "QuranAyats": [
        {
            "Id": 32774,
            "SureId": 51,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "وَالسَّمَٓاءِ ذَاتِ الْحُبُكِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 51,
                "MealInfo": "Mekke döneminde inmiştir. 60 âyettir. Sûre, adını ilk âyette geçen <b>“ez-zâriyât” </b>kelimesinden almıştır.<b> Zâriyât, esip savuran rüzgârlar demektir.</b> Sûrede başlıca, <b>öldükten sonra hesap için toplanma, inkârcıların ahirette karşılaşacakları azap, mü’minlere verilecek mükâfatlar, Allah’ın varlığını ve birliğini gösteren kevni deliller</b> konu edilmektedir.",
                "SureNameTurkish": "Zâriyât",
                "SureNameArabic": "الذَّارِيَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 67,
                "AyetCount": 60,
                "Cuz": 26,
                "FirstPage": 520,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 32781,
            "SureId": 51,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "اِنَّكُمْ لَفٖی قَوْلٍ مُخْتَلِفٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32788,
            "SureId": 51,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "یُؤْفَكُ عَنْهُ مَنْ اُفِكَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32795,
            "SureId": 51,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "قُتِلَ الْخَرَّاصُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32802,
            "SureId": 51,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "اَلَّذٖینَ هُمْ فٖی غَمْرَةٍ سَاهُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32809,
            "SureId": 51,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "یَسْـَٔلُونَ اَیَّانَ یَوْمُ الدّٖینِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32816,
            "SureId": 51,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "یَوْمَ هُمْ عَلَى النَّارِ یُفْتَنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32823,
            "SureId": 51,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "ذُوقُوا فِتْنَتَكُمْؕ هٰذَا الَّذٖی كُنْتُمْ بِهٖ تَسْتَعْجِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32830,
            "SureId": 51,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "اِنَّ الْمُتَّقٖینَ فٖی جَنَّاتٍ وَعُیُونٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32837,
            "SureId": 51,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "اٰخِذٖینَ مَٓا اٰتٰیهُمْ رَبُّهُمْؕ اِنَّهُمْ كَانُوا قَبْلَ ذٰلِكَ مُحْسِنٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32844,
            "SureId": 51,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "كَانُوا قَلٖیلًا مِنَ الَّیْلِ مَا یَهْجَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32851,
            "SureId": 51,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "وَبِالْاَسْحَارِ هُمْ یَسْتَغْفِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32858,
            "SureId": 51,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "وَفٖٓی اَمْوَالِهِمْ حَقٌّ لِلسَّٓائِلِ وَالْمَحْرُومِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32865,
            "SureId": 51,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "وَفِی الْاَرْضِ اٰیَاتٌ لِلْمُوقِنٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32872,
            "SureId": 51,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "وَفٖٓی اَنْفُسِكُمْؕ اَفَلَا تُبْصِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32879,
            "SureId": 51,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "وَفِی السَّمَٓاءِ رِزْقُكُمْ وَمَا تُوعَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32886,
            "SureId": 51,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "فَوَرَبِّ السَّمَٓاءِ وَالْاَرْضِ اِنَّهُ لَحَقٌّ مِثْلَ مَٓا اَنَّكُمْ تَنْطِقُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32893,
            "SureId": 51,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "هَلْ اَتٰیكَ حَدٖیثُ ضَیْفِ اِبْرٰهٖیمَ الْمُكْرَمٖینَۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32900,
            "SureId": 51,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "اِذْ دَخَلُوا عَلَیْهِ فَقَالُوا سَلَامًاؕ قَالَ سَلَامٌۚ قَوْمٌ مُنْكَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32907,
            "SureId": 51,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "فَرَاغَ اِلٰٓى اَهْلِهٖ فَجَٓاءَ بِعِجْلٍ سَمٖینٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32914,
            "SureId": 51,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "فَقَرَّبَهُٓ اِلَیْهِمْ قَالَ اَلَا تَاْكُلُونَؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32921,
            "SureId": 51,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "فَاَوْجَسَ مِنْهُمْ خٖیفَةًؕ قَالُوا لَا تَخَفْؕ وَبَشَّرُوهُ بِغُلَامٍ عَلٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32928,
            "SureId": 51,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "فَاَقْبَلَتِ امْرَاَتُهُ فٖی صَرَّةٍ فَصَكَّتْ وَجْهَهَا وَقَالَتْ عَجُوزٌ عَقٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32935,
            "SureId": 51,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "قَالُوا كَذٰلِكِۙ قَالَ رَبُّكِؕ اِنَّهُ هُوَ الْحَكٖیمُ الْعَلٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 32772,
            "SureId": 51,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7-8",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Alanları ayrılmış yıldız kümeleri ile dolu göğe andolsun ki siz çelişkili sözler söylemektesiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 51,
                "MealInfo": "Mekke döneminde inmiştir. 60 âyettir. Sûre, adını ilk âyette geçen <b>“ez-zâriyât” </b>kelimesinden almıştır.<b> Zâriyât, esip savuran rüzgârlar demektir.</b> Sûrede başlıca, <b>öldükten sonra hesap için toplanma, inkârcıların ahirette karşılaşacakları azap, mü’minlere verilecek mükâfatlar, Allah’ın varlığını ve birliğini gösteren kevni deliller</b> konu edilmektedir.",
                "SureNameTurkish": "Zâriyât",
                "SureNameArabic": "الذَّارِيَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 67,
                "AyetCount": 60,
                "Cuz": 26,
                "FirstPage": 520,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 32779,
            "SureId": 51,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": false,
            "Page": 521,
            "AyetText": "Alanları ayrılmış yıldız kümeleri ile dolu göğe andolsun ki siz farklı inanç ve görüşler içindesiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32786,
            "SureId": 51,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Çarpık düşünceli olanlar doğru yoldan başkasına yönelirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32793,
            "SureId": 51,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10-12",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Kahrolası yalancılar, o gaflet içinde yüzen kendini bilmezler, “Hani son yargılama günü ne zaman?” diye sorarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32800,
            "SureId": 51,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": false,
            "Page": 521,
            "AyetText": "",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32807,
            "SureId": 51,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": false,
            "Page": 521,
            "AyetText": "",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32814,
            "SureId": 51,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "O gün onlar ateşle sınanacaklar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32821,
            "SureId": 51,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Tadın bakalım cezanızı! Çabucak gelmesini isteyip durduğunuz işte bu!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32828,
            "SureId": 51,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15-16",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Allah’a saygısızlıktan sakınanlar ise rablerinin kendilerine verdiklerini alarak cennetlerde ve pınar başlarında olacaklar. Çünkü onlar daha önce güzel davranışlar içindeydiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32835,
            "SureId": 51,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": false,
            "Page": 521,
            "AyetText": "Allah’a saygısızlıktan sakınanlar ise rablerinin kendilerine verdiklerini alarak cennetlerde ve pınar başlarında olacaklar. Çünkü onlar daha önce güzel davranışlar içindeydiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32842,
            "SureId": 51,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Onlar gecenin az bir kısmında uyurlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32849,
            "SureId": 51,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Seher vakitlerinde rablerinden bağışlanmalarını dilerlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32856,
            "SureId": 51,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Yardım isteyenlere ve yoksullara mallarından belli bir pay ayırırlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32863,
            "SureId": 51,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Sağlam düşünce ve inanç sahipleri için yeryüzünde açık kanıtlar vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32870,
            "SureId": 51,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Hatta kendinizde de. Hiç görmüyor musunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32877,
            "SureId": 51,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Rızkınız ve size vaad edilenler göktedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32884,
            "SureId": 51,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Göğün ve yerin rabbine andolsun ki bu, tıpkı sizin konuşmanız kadar gerçek!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32891,
            "SureId": 51,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "İbrâhim’in değerli konuklarıyla ilgili kıssa sana ulaştı mı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32898,
            "SureId": 51,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Onun yanına girdiklerinde “selâm” demişler, o da “selâm” demiş; (içinden) “Hiç de tanıdık kimseler değil” diye geçirmişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32905,
            "SureId": 51,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Belli etmeden hemen ailesinin yanına gitti ve (kızartılmış) besili bir buzağı getirdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32912,
            "SureId": 51,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 521,
            "AyetText": "Onu önlerine koydu ve “Buyurmaz mısınız?” dedi.",
            "Recitation": "",
            "AyetMeta": null,
