    "QuranAyats": [
        {
            "Id": 38227,
            "SureId": 72,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "وَاَنَّا مِنَّا الْمُسْلِمُونَ وَمِنَّا الْقَاسِطُونَؕ فَمَنْ اَسْلَمَ فَاُو𐻾لٰٓئِكَ تَحَرَّوْا رَشَدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 72,
                "MealInfo": "Mekke döneminde inmiştir. 28 âyettir. Ağırlıklı olarak cinlerden bahsettiğiiçin “Cin sûresi” adını almıştır. Sûrede ayrıca tevhit, peygamberlik ve öldüktensonra dirilmek gibi meseleler konu edilmektedir.",
                "SureNameTurkish": "Cin",
                "SureNameArabic": "الْجِنِّ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 40,
                "AyetCount": 28,
                "Cuz": 29,
                "FirstPage": 572,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 38234,
            "SureId": 72,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "وَاَمَّا الْقَاسِطُونَ فَكَانُوا لِجَهَنَّمَ حَطَبًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38241,
            "SureId": 72,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "وَاَنْ لَوِ اسْتَقَامُوا عَلَى الطَّرٖیقَةِ لَاَسْقَیْنَاهُمْ مَٓاءً غَدَقًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38248,
            "SureId": 72,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "لِنَفْتِنَهُمْ فٖیهِۚ وَمَنْ یُعْرِضْ عَنْ ذِكْرِ رَبِّهٖ یَسْلُكْهُ عَذَابًا صَعَدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38255,
            "SureId": 72,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "وَاَنَّ الْمَسَاجِدَ لِلّٰهِ فَلَا تَدْعُوا مَعَ اللّٰهِ اَحَدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38262,
            "SureId": 72,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "وَاَنَّهُ لَمَّا قَامَ عَبْدُ اللّٰهِ یَدْعُوهُ كَادُوا یَكُونُونَ عَلَیْهِ لِبَدًاؕࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38269,
            "SureId": 72,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "قُلْ اِنَّمَٓا اَدْعُوا رَبّٖی وَلَٓا اُشْرِكُ بِهٖٓ اَحَدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38276,
            "SureId": 72,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "قُلْ اِنّٖی لَٓا اَمْلِكُ لَكُمْ ضَرًّا وَلَا رَشَدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38283,
            "SureId": 72,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "قُلْ اِنّٖی لَنْ یُجٖیرَنٖی مِنَ اللّٰهِ اَحَدٌ وَلَنْ اَجِدَ مِنْ دُونِهٖ مُلْتَحَدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38290,
            "SureId": 72,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "اِلَّا بَلَاغًا مِنَ اللّٰهِ وَرِسَالَاتِهٖؕ وَمَنْ یَعْصِ اللّٰهَ وَرَسُولَهُ فَاِنَّ لَهُ نَارَ جَهَنَّمَ خَالِدٖینَ فٖیهَٓا اَبَدًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38297,
            "SureId": 72,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "حَتّٰٓى اِذَا رَاَوْا مَا یُوعَدُونَ فَسَیَعْلَمُونَ مَنْ اَضْعَفُ نَاصِرًا وَاَقَلُّ عَدَدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38304,
            "SureId": 72,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "قُلْ اِنْ اَدْرٖٓی اَقَرٖیبٌ مَا تُوعَدُونَ اَمْ یَجْعَلُ لَهُ رَبّٖٓی اَمَدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38311,
            "SureId": 72,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "عَالِمُ الْغَیْبِ فَلَا یُظْهِرُ عَلٰى غَیْبِهٖٓ اَحَدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38318,
            "SureId": 72,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "اِلَّا مَنِ ارْتَضٰى مِنْ رَسُولٍ فَاِنَّهُ یَسْلُكُ مِنْ بَیْنِ یَدَیْهِ وَمِنْ خَلْفِهٖ رَصَدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38325,
            "SureId": 72,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "لِیَعْلَمَ اَنْ قَدْ اَبْلَغُوا رِسَالَاتِ رَبِّهِمْ وَاَحَاطَ بِمَا لَدَیْهِمْ وَاَحْصٰى كُلَّ شَیْءٍ عَدَدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 38225,
            "SureId": 72,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "Aramızda ilâhî emirlere boyun eğenler var, ama hak yoldan sapanlarımız da var. Boyun eğenler doğru yolu hedeflemişlerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 72,
                "MealInfo": "Mekke döneminde inmiştir. 28 âyettir. Ağırlıklı olarak cinlerden bahsettiğiiçin “Cin sûresi” adını almıştır. Sûrede ayrıca tevhit, peygamberlik ve öldüktensonra dirilmek gibi meseleler konu edilmektedir.",
                "SureNameTurkish": "Cin",
                "SureNameArabic": "الْجِنِّ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 40,
                "AyetCount": 28,
                "Cuz": 29,
                "FirstPage": 572,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 38232,
            "SureId": 72,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "Hak yoldan sapanlar ise cehennemin yakıtı olmuşlardır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38239,
            "SureId": 72,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16-17",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "Eğer (kullarımız) hak yolda dosdoğru yürürlerse kendilerini, içinde denemek üzere nimetlere boğarız; kim de rabbini anmaktan yüz çevirirse Allah onu gitgide artan bir azaba uğratır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38246,
            "SureId": 72,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": false,
            "Page": 573,
            "AyetText": "Eğer (kullarımız) hak yolda dosdoğru yürürlerse kendilerini, içinde denemek üzere nimetlere boğarız; kim de rabbini anmaktan yüz çevirirse Allah onu gitgide artan bir azaba uğratır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38253,
            "SureId": 72,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "Mescidler yalnız Allah’ındır. O halde Allah ile birlikte başkasına da tapmayın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38260,
            "SureId": 72,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "Allah’ın kulu O’na ibadet etmek üzere kalktığında üstüne çıkarcasına etrafına üşüşüyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38267,
            "SureId": 72,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "De ki: “Ben kendisine hiç kimseyi ortak koşmaksızın yalnız rabbime yakarıp kulluk ederim.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38274,
            "SureId": 72,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "De ki: “Doğrusu ben size ne zarar verme ne de istikametinizi düzeltme gücüne sahibim.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38281,
            "SureId": 72,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22-23",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "Şunu da söyle: “Şüphe yok ki, Allah’ın dinini tebliğ edip gönderdiklerini yerine ulaştırmadıkça beni de Allah’a karşı kimse koruyamaz; O’ndan başka sığınılacak kimse de bulamam.” Artık Allah’a ve resulüne isyan edenler bilsinler ki, içinde ebedî kalacakları cehennem ateşi onları beklemektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38288,
            "SureId": 72,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": false,
            "Page": 573,
            "AyetText": "Şunu da söyle: \"Şüphe yok ki, Allah’ın gönderdiklerini tebliğ etmedikçe beni de Allah’a karşı kimse koruyamaz; O’ndan başka sığınacak kimse de bulamam.\" Artık kim Allah’a ve resulüne karşı gelirse bilsin ki, içinde ebedî kalacakları cehennem ateşi onu beklemektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38295,
            "SureId": 72,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "Sonunda tehdit edildikleri azabı gördükleri zaman kimin yardımcılarının daha güçsüz ve sayıca daha az olduğunu anlayacaklar.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38302,
            "SureId": 72,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "De ki: “Tehdit edildiğiniz azap yakın mıdır yoksa rabbim onun için uzun bir süre mi koyar, bilemem.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38309,
            "SureId": 72,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "Gaybı O bilir, gizlisini kimseye açmaz;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38316,
            "SureId": 72,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27-28",
            "AyetVisible": true,
            "Page": 573,
            "AyetText": "Ancak elçi olarak seçtiği başka. Allah, bu elçilerin her türlü durumlarını ilmiyle kuşattığı ve her şeyin sayısını belirlediği halde, rablerinin mesajlarını tebliğ ettiklerini ortaya çıkarmak için onların önlerinden ve arkalarından gözcüler gönderir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
