    "QuranAyats": [
        {
            "Id": 30352,
            "SureId": 43,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "وَالَّذٖی نَزَّلَ مِنَ السَّمَٓاءِ مَٓاءً بِقَدَرٍۚ فَاَنْشَرْنَا بِهٖ بَلْدَةً مَیْتًاۚ كَذٰلِكَ تُخْرَجُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 43,
                "MealInfo": "Mekke döneminde inmiştir. 89 âyettir. Sûre, adını 35. âyette geçen <b>“Zuhruf ” </b>kelimesinden almaktadır. <b>Zuhruf; yaldız, mücevher, dünya hayatının geçici menfaati anlamlarına gelir. </b>Sûrede başlıca tevhit, iman ve vahyin getirdiği hakikatler ile insanların bu hakikatlere ters düşecek şekilde sırf geçici dünya menfaatlerine bağlanarak sergiledikleri çelişki vurgulanmakta, batıla karşı çıkan ve hakkı tutan şahsiyetler olarak İbrahim, Mûsâ ve İsa Peygamberlerden söz edilmektedir.",
                "SureNameTurkish": "Zuhruf",
                "SureNameArabic": "الزُّخْرُفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 63,
                "AyetCount": 89,
                "Cuz": 25,
                "FirstPage": 489,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30359,
            "SureId": 43,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "وَالَّذٖی خَلَقَ الْاَزْوَاجَ كُلَّهَا وَجَعَلَ لَكُمْ مِنَ الْفُلْكِ وَالْاَنْعَامِ مَا تَرْكَبُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30366,
            "SureId": 43,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "لِتَسْتَوُ𐻿ا عَلٰى ظُهُورِهٖ ثُمَّ تَذْكُرُوا نِعْمَةَ رَبِّكُمْ اِذَا اسْتَوَیْتُمْ عَلَیْهِ وَتَقُولُوا سُبْحَانَ الَّذٖی سَخَّرَ لَنَا هٰذَا وَمَا كُنَّا لَهُ مُقْرِنٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30373,
            "SureId": 43,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "وَاِنَّٓا اِلٰى رَبِّنَا لَمُنْقَلِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30380,
            "SureId": 43,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "وَجَعَلُوا لَهُ مِنْ عِبَادِهٖ جُزْءًاؕ اِنَّ الْاِنْسَانَ لَكَفُورٌ مُبٖینٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30387,
            "SureId": 43,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "اَمِ اتَّخَذَ مِمَّا یَخْلُقُ بَنَاتٍ وَاَصْفٰیكُمْ بِالْبَنٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30394,
            "SureId": 43,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "وَاِذَا بُشِّرَ اَحَدُهُمْ بِمَا ضَرَبَ لِلرَّحْمٰنِ مَثَلًا ظَلَّ وَجْهُهُ مُسْوَدًّا وَهُوَ كَظٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30401,
            "SureId": 43,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "اَوَمَنْ یُنَشَّؤُ𐻾ا فِی الْحِلْیَةِ وَهُوَ فِی الْخِصَامِ غَیْرُ مُبٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30408,
            "SureId": 43,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "وَجَعَلُوا الْمَلٰٓئِكَةَ الَّذٖینَ هُمْ عِبَادُ الرَّحْمٰنِ اِنَاثًاؕ اَشَهِدُوا خَلْقَهُمْؕ سَتُكْتَبُ شَهَادَتُهُمْ وَیُسْـَٔلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30415,
            "SureId": 43,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "وَقَالُوا لَوْ شَٓاءَ الرَّحْمٰنُ مَا عَبَدْنَاهُمْؕ مَا لَهُمْ بِذٰلِكَ مِنْ عِلْمٍࣗ اِنْ هُمْ اِلَّا یَخْرُصُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30422,
            "SureId": 43,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "اَمْ اٰتَیْنَاهُمْ كِتَابًا مِنْ قَبْلِهٖ فَهُمْ بِهٖ مُسْتَمْسِكُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30429,
            "SureId": 43,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "بَلْ قَالُٓوا اِنَّا وَجَدْنَٓا اٰبَٓاءَنَا عَلٰٓى اُمَّةٍ وَاِنَّا عَلٰٓى اٰثَارِهِمْ مُهْتَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 30350,
            "SureId": 43,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "Gökten ölçülü olarak su indiren de O’dur. Onunla ölü bir beldeye yeniden hayat veririz. İşte siz de böyle diriltilip çıkarılacaksınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 43,
                "MealInfo": "Mekke döneminde inmiştir. 89 âyettir. Sûre, adını 35. âyette geçen <b>“Zuhruf ” </b>kelimesinden almaktadır. <b>Zuhruf; yaldız, mücevher, dünya hayatının geçici menfaati anlamlarına gelir. </b>Sûrede başlıca tevhit, iman ve vahyin getirdiği hakikatler ile insanların bu hakikatlere ters düşecek şekilde sırf geçici dünya menfaatlerine bağlanarak sergiledikleri çelişki vurgulanmakta, batıla karşı çıkan ve hakkı tutan şahsiyetler olarak İbrahim, Mûsâ ve İsa Peygamberlerden söz edilmektedir.",
                "SureNameTurkish": "Zuhruf",
                "SureNameArabic": "الزُّخْرُفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 63,
                "AyetCount": 89,
                "Cuz": 25,
                "FirstPage": 489,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30357,
            "SureId": 43,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "Bütün çiftleri yaratan, bineceğiniz gemileri ve hayvanları sizin için var eden de O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30364,
            "SureId": 43,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13-14",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "Var etti ki, sırtlarına binesiniz, sonra üzerine yerleştiğinizde rabbinizin nimetini hatırlayasınız ve şöyle diyesiniz: “Bunu bize boyun eğdiren Allah noksanlardan münezzehtir, yoksa biz buna güç yetiremezdik! Ve biz kuşkusuz rabbimize geri döneceğiz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30371,
            "SureId": 43,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "13-14",
            "AyetVisible": false,
            "Page": 490,
            "AyetText": "Var etti ki, sırtlarına binesiniz, üzerine yerleştiğinizde rabbinizin nimetini hatırlayasınız ve şöyle diyesiniz: \"Bunu bize boyun eğdiren Allah noksanlardan münezzehtir, yoksa biz buna güç yetiremezdik! Ve biz kuşkusuz rabbimize geri döneceğiz.\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30378,
            "SureId": 43,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "Kimi kullarını O’nun bir parçası saydılar. Şüphesiz insan apaçık bir nankör!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30385,
            "SureId": 43,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "Yoksa O, yarattıkları arasından kızları kendisinin saydı da erkek çocukları size mi ayırdı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30392,
            "SureId": 43,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "Onlardan biri, Rahmân’a yakıştırdığı (kız çocuğu) ile müjdelenince öfkeye kapılarak yüzü mosmor olur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30399,
            "SureId": 43,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "“Mücadelede başarısız olarak ömrünü süslenmekle geçirecek olan kız çocuğu mu?” diye öfkeyle sorar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30406,
            "SureId": 43,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "Rahmân’ın kulları olan melekleri dişi saydılar. Yoksa yaratılışlarına tanık mı oldular? Tanıklıkları kaydedilecek ve bundan sorguya çekileceklerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30413,
            "SureId": 43,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "“Rahmân dileseydi biz onlara ibadet etmezdik” dediler. Bu konuda hiçbir bilgileri yoktur, yalnızca boş bir iddiada bulunuyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30420,
            "SureId": 43,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "Yoksa bundan (Kur’an’dan) önce kendilerine bir kitap verdik de ona mı sarılıyorlar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30427,
            "SureId": 43,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 490,
            "AyetText": "Hayır hayır! Onların dedikleri şundan ibarettir: “Biz babalarımızı bir inanç üzerinde bulduk, elbette biz onların izlerinden giderek doğru yolu buluruz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
