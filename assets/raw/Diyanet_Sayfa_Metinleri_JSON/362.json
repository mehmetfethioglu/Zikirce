    "CuzNo": 19,
    "PageNo": 362,
    "ArCuzNo": "۱۹",
    "ArPageNo": "۳٦۲",
    "QuranAyats": [
        {
            "Id": 20132,
            "SureId": 25,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "وَقَالَ الَّذٖینَ لَا یَرْجُونَ لِقَٓاءَنَا لَوْلَٓا اُنْزِلَ عَلَیْنَا الْمَلٰٓئِكَةُ اَوْ نَرٰى رَبَّنَاؕ لَقَدِ اسْتَكْبَرُوا فٖٓی اَنْفُسِهِمْ وَعَتَوْ عُتُوًّا كَبٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 25,
                "MealInfo": "Mekke döneminde inmiştir. 68-70. âyetlerin Medine döneminde indiği konusunda bir rivayet de vardır. 77 âyettir. Sûre, adını ilk âyette geçen <b>“elFurkân</b>” kelimesinden almaktadır. <b>Furkân, “hak ile batılı birbirinden ayıran”demek olup Kur’an’ın isimlerinden biridir.</b> Sûre de temel konular olarak Hz.Peygamber’in tüm insanlığa gönderildiği, onun tebliğ sırasında karşılaştığı zorluklar ve şirkin kökünün kazınacağı, geçmiş ümmetlerin hayatlarından bazı örnekler de verilerek ele alınmaktadır.",
                "SureNameTurkish": "Furkân",
                "SureNameArabic": "الْفُرْقَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 42,
                "AyetCount": 77,
                "Cuz": 18,
                "FirstPage": 359,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20139,
            "SureId": 25,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "یَوْمَ یَرَوْنَ الْمَلٰٓئِكَةَ لَا بُشْرٰى یَوْمَئِذٍ لِلْمُجْرِمٖینَ وَیَقُولُونَ حِجْرًا مَحْجُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20146,
            "SureId": 25,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "وَقَدِمْنَٓا اِلٰى مَا عَمِلُوا مِنْ عَمَلٍ فَجَعَلْنَاهُ هَبَٓاءً مَنْثُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20153,
            "SureId": 25,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "اَصْحَابُ الْجَنَّةِ یَوْمَئِذٍ خَیْرٌ مُسْتَقَرًّا وَاَحْسَنُ مَقٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20160,
            "SureId": 25,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "وَیَوْمَ تَشَقَّقُ السَّمَٓاءُ بِالْغَمَامِ وَنُزِّلَ الْمَلٰٓئِكَةُ تَنْزٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20167,
            "SureId": 25,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "اَلْمُلْكُ یَوْمَئِذٍࣙ الْحَقُّ لِلرَّحْمٰنِؕ وَكَانَ یَوْمًا عَلَى الْكَافِرٖینَ عَسٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20174,
            "SureId": 25,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "وَیَوْمَ یَعَضُّ الظَّالِمُ عَلٰى یَدَیْهِ یَقُولُ یَا لَیْتَنِی اتَّخَذْتُ مَعَ الرَّسُولِ سَبٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20181,
            "SureId": 25,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "یَا وَیْلَتٰى لَیْتَنٖی لَمْ اَتَّخِذْ فُلَانًا خَلٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20188,
            "SureId": 25,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "لَقَدْ اَضَلَّنٖی عَنِ الذِّكْرِ بَعْدَ اِذْ جَٓاءَنٖیؕ وَكَانَ الشَّیْطَانُ لِلْاِنْسَانِ خَذُولًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20195,
            "SureId": 25,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "وَقَالَ الرَّسُولُ یَا رَبِّ اِنَّ قَوْمِی اتَّخَذُوا هٰذَا الْقُرْاٰنَ مَهْجُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20202,
            "SureId": 25,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "وَكَذٰلِكَ جَعَلْنَا لِكُلِّ نَبِیٍّ عَدُوًّا مِنَ الْمُجْرِمٖینَؕ وَكَفٰى بِرَبِّكَ هَادِیًا وَنَصٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20209,
            "SureId": 25,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "وَقَالَ الَّذٖینَ كَفَرُوا لَوْلَا نُزِّلَ عَلَیْهِ الْقُرْاٰنُ جُمْلَةً وَاحِدَةًۚ كَذٰلِكَ لِنُثَبِّتَ بِهٖ فُؤَادَكَ وَرَتَّلْنَاهُ تَرْتٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 20130,
            "SureId": 25,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "Bizim huzurumuza çıkarılacaklarını hiç beklemeyenler, “Bize melekler gönderilmesi veya rabbimizi görmemiz gerekmez miydi?” diyorlar. Gerçek şu ki onlar içlerinde derin bir kibir duygusu besliyor, azgınlıkta sınır tanımıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 25,
                "MealInfo": "Mekke döneminde inmiştir. 68-70. âyetlerin Medine döneminde indiği konusunda bir rivayet de vardır. 77 âyettir. Sûre, adını ilk âyette geçen <b>“elFurkân</b>” kelimesinden almaktadır. <b>Furkân, “hak ile batılı birbirinden ayıran”demek olup Kur’an’ın isimlerinden biridir.</b> Sûre de temel konular olarak Hz.Peygamber’in tüm insanlığa gönderildiği, onun tebliğ sırasında karşılaştığı zorluklar ve şirkin kökünün kazınacağı, geçmiş ümmetlerin hayatlarından bazı örnekler de verilerek ele alınmaktadır.",
                "SureNameTurkish": "Furkân",
                "SureNameArabic": "الْفُرْقَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 42,
                "AyetCount": 77,
                "Cuz": 18,
                "FirstPage": 359,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20137,
            "SureId": 25,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "Melekleri görecekleri gün, işte o zaman, günahlara boğulmuş olanlar için hiçbir iyi haber olmayacak ve onlar (meleklere), “Her şeyden mahrum olduk!” diyecekler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20144,
            "SureId": 25,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "Onların yaptığı her işi ele almış ve onu savrulup giden toz toprak haline getirmiş olacağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20151,
            "SureId": 25,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "O gün cennetliklere kalınacak yerlerin en iyisi, dinlenme yerlerinin en güzeli bahşedilmiş olacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20158,
            "SureId": 25,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "O gün semayı örten bulutlar (perdeler) açılacak, melekler peş peşe indirilecek.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20165,
            "SureId": 25,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "İşte o gün gerçek egemenlik Rahmân’ındır ve o gün inkârcılar için çok zor bir gün olacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20172,
            "SureId": 25,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "O gün, (dünyada iken) haktan sapmış kişi ellerini ısırarak şöyle diyecek: “Keşke peygamberle birlikte aynı yolda olsaydım!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20179,
            "SureId": 25,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "Eyvah! Keşke falancayı kendime dost edinmeseydim!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20186,
            "SureId": 25,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "Meğer bana uyarıcı mesaj geldikten sonra, o dost bildiğim kişi bu mesajdan beni saptırmış!” İşte şeytan insanı (böyle) çaresizlik içinde yapayalnız bırakır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20193,
            "SureId": 25,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "Resul, “Rabbim! Kavmim bu Kur’an’a büsbütün ilgisiz kaldılar” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20200,
            "SureId": 25,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "İşte bunun gibi her peygambere karşı, günaha batmış kimseler içinden bir düşman çıkardık. Ama yol gösterici ve yardımcı olarak rabbin yeterlidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20207,
            "SureId": 25,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 362,
            "AyetText": "İnkârcılar, “Kur’an ona bütünüyle bir defada indirilseydi ya!” diyorlar. Oysa biz onu senin kalbine iyice yerleştirmek için böyle yaptık ve onu uygun aralıklarla parça parça gönderdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Furkân",
    "QuranSureLabel": "الْفُرْقَانِ",
