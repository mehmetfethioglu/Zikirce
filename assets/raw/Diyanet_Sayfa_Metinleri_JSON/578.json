            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Hakikatte biz insanı katışık bir nutfeden yarattık; imtihan edelim diye onu işitir ve görür kıldık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
