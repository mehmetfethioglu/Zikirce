            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "كَلَّا بَلْ تُحِبُّونَ الْعَاجِلَةَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 75,
                "MealInfo": "Mekke döneminde inmiştir. 40 âyettir. Sûre, adını birinci âyetteki “el-Kıyâme”kelimesinden almıştır. Sûrede başlıca, öldükten sonra dirilme ve ceza, ölümsırasında insanın durumu ve kâfirlerin ahirette karşılaşacağı zorluklar konuedilmektedir",
                "SureNameTurkish": "Kıyâmet",
                "SureNameArabic": "الْقِيٰمَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 31,
                "AyetCount": 40,
                "Cuz": 29,
                "FirstPage": 577,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 39004,
            "SureId": 75,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "وَتَذَرُونَ الْاٰخِرَةَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39011,
            "SureId": 75,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "وُجُوهٌ یَوْمَئِذٍ نَاضِرَةٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39018,
            "SureId": 75,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "اِلٰى رَبِّهَا نَاظِرَةٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39025,
            "SureId": 75,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "وَوُجُوهٌ یَوْمَئِذٍ بَاسِرَةٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39032,
            "SureId": 75,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "تَظُنُّ اَنْ یُفْعَلَ بِهَا فَاقِرَةٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39039,
            "SureId": 75,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "كَلَّٓا اِذَا بَلَغَتِ التَّرَاقِیَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39046,
            "SureId": 75,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "وَقٖیلَ مَنْ𐻽 رَاقٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39053,
            "SureId": 75,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "وَظَنَّ اَنَّهُ الْفِرَاقُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39060,
            "SureId": 75,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "وَالْتَفَّتِ السَّاقُ بِالسَّاقِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39067,
            "SureId": 75,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "اِلٰى رَبِّكَ یَوْمَئِذٍࣙ الْمَسَاقُؕ‌ࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39074,
            "SureId": 75,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "فَلَا صَدَّقَ وَلَا صَلّٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39081,
            "SureId": 75,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "وَلٰكِنْ كَذَّبَ وَتَوَلّٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39088,
            "SureId": 75,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "ثُمَّ ذَهَبَ اِلٰٓى اَهْلِهٖ یَتَمَطّٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39095,
            "SureId": 75,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "اَوْلٰى لَكَ فَاَوْلٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39102,
            "SureId": 75,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "ثُمَّ اَوْلٰى لَكَ فَاَوْلٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39109,
            "SureId": 75,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "اَیَحْسَبُ الْاِنْسَانُ اَنْ یُتْرَكَ سُدًىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39116,
            "SureId": 75,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "اَلَمْ یَكُ نُطْفَةً مِنْ مَنِیٍّ یُمْنٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39123,
            "SureId": 75,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوّٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39130,
            "SureId": 75,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "فَجَعَلَ مِنْهُ الزَّوْجَیْنِ الذَّكَرَ وَالْاُنْثٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39137,
            "SureId": 75,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "اَلَیْسَ ذٰلِكَ بِقَادِرٍ عَلٰٓى اَنْ یُحْیِیَ الْمَوْتٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39144,
            "SureId": 76,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "هَلْ اَتٰى عَلَى الْاِنْسَانِ حٖینٌ مِنَ الدَّهْرِ لَمْ یَكُنْ شَیْـًٔا مَذْكُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 76,
                "MealInfo": "Medine döneminde inmiştir. 31 âyettir. Sûre, adını birinci âyetteki “insan” kelimesindenalmıştır. Aynı âyette geçen “ed-Dehr” kelimesinden dolayı Dehrsûresi diye de anılır. Dehr, zaman demektir. Sûrede başlıca, ahiret hayatıyla ilgilimeseleler ve özellikle takva sahiplerinin cennette kavuşacakları çeşitli nimetlerkonu edilmektedir.",
                "SureNameTurkish": "İnsân",
                "SureNameArabic": "الْاِنْسَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 98,
                "AyetCount": 31,
                "Cuz": 29,
                "FirstPage": 578,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 39151,
            "SureId": 76,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "اِنَّا خَلَقْنَا الْاِنْسَانَ مِنْ نُطْفَةٍ اَمْشَاجٍࣗ نَبْتَلٖیهِ فَجَعَلْنَاهُ سَمٖیعًا بَصٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39158,
            "SureId": 76,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "اِنَّا هَدَیْنَاهُ السَّبٖیلَ اِمَّا شَا‌كِرًا وَاِمَّا كَفُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39165,
            "SureId": 76,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "اِنَّٓا اَعْتَدْنَا لِلْكَافِرٖینَ سَلَاسِلَا𐻾 وَاَغْلَالًا وَسَعٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39172,
            "SureId": 76,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "اِنَّ الْاَبْرَارَ یَشْرَبُونَ مِنْ كَاْسٍ كَانَ مِزَاجُهَا كَافُورًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 38995,
            "SureId": 75,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Hayır (ey insanlar)! Doğrusu siz çabucak gelip geçeni seviyorsunuz,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 75,
                "MealInfo": "Mekke döneminde inmiştir. 40 âyettir. Sûre, adını birinci âyetteki “el-Kıyâme”kelimesinden almıştır. Sûrede başlıca, öldükten sonra dirilme ve ceza, ölümsırasında insanın durumu ve kâfirlerin ahirette karşılaşacağı zorluklar konuedilmektedir",
                "SureNameTurkish": "Kıyâmet",
                "SureNameArabic": "الْقِيٰمَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 31,
                "AyetCount": 40,
                "Cuz": 29,
                "FirstPage": 577,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 39002,
            "SureId": 75,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Âhireti ise bir yana bırakıyorsunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39009,
            "SureId": 75,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22-23",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Oysa o gün bir kısım yüzler rablerine bakarak mutlulukla parıldayacak;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39016,
            "SureId": 75,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": false,
            "Page": 578,
            "AyetText": "Oysa o gün bir kısım yüzler rablerine bakarak mutlulukla parıldayacaktır;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39023,
            "SureId": 75,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24-25",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Bir kısım yüzler ise o gün insanın belini kıracak bir felâketi sezerek sararıp solacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39030,
            "SureId": 75,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": false,
            "Page": 578,
            "AyetText": "Bir kısım yüzler ise o gün insanın belini kıracak bir felâketi sezerek sararıp solacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39037,
            "SureId": 75,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Hayır artık çok geç! Can boğaza gelip dayandığında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39044,
            "SureId": 75,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "“Yok mu bir şifacı?” dendiğinde;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39051,
            "SureId": 75,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "(Hasta) bunun beklenen ayrılış olduğunu anladığında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39058,
            "SureId": 75,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Ve bacaklar birbirine dolaştığında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39065,
            "SureId": 75,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "İşte o gün sevkedilen yer sadece rabbinin huzurudur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39072,
            "SureId": 75,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Vaktiyle o hakka inanmamış, namaz da kılmamıştı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39079,
            "SureId": 75,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Aksine inkâr etmiş, haktan yüz çevirmişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39086,
            "SureId": 75,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Sonra da çalım sata sata yürüyüp yandaşlarına gitmişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39093,
            "SureId": 75,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "(Ey insan!) Acı sonun yaklaştıkça yaklaşıyor!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39100,
            "SureId": 75,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Evet o sana yaklaştıkça yaklaşıyor!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39107,
            "SureId": 75,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "İnsan, kendisinin başı boş bırakılacağını mı sanır?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39114,
            "SureId": 75,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "O akıtılan meniden bir damlacık (sperm) değil miydi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39121,
            "SureId": 75,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Sonra o, alaka (asılıp tutunan zigot) olmuş, derken Allah onu yaratıp ­şekillendirmiş;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39128,
            "SureId": 75,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Ondan iki eşi, erkek ve dişiyi yaratmıştır.",
            "Recitation": "",
