            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 578,
            "AyetText": "Şüphesiz biz ona doğru yolu gösterdik; artık o isterse şükreden olur, isterse nankör.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
