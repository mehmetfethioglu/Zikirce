    "ArCuzNo": "۲۲",
    "ArPageNo": "٤٤۱",
    "QuranAyats": [
        {
            "Id": 26026,
            "SureId": 36,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "وَاضْرِبْ لَهُمْ مَثَلًا اَصْحَابَ الْقَرْیَةِۘ اِذْ جَٓاءَهَا الْمُرْسَلُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 36,
                "MealInfo": "Mekke döneminde inmiştir. 83 âyettir. Sûre, adını ilk âyeti oluşturan <b>“Yâ-S</b>în” harflerinden almıştır. Sûrede başlıca i<b>nsanın ahlâkî sorumlulukları, vahiy, Hz. Peygamber’i yalanlayan Kureyş kabilesi, Antakya halkına gönderilen peygamberler, Allah’ın birliğini ve kudretini gösteren deliller, öldükten sonra dirilme,hesap ve ceza konu </b>edilmektedir.",
                "SureNameTurkish": "Yâsîn",
                "SureNameArabic": "يٰسۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 41,
                "AyetCount": 83,
                "Cuz": 22,
                "FirstPage": 440,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26033,
            "SureId": 36,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "اِذْ اَرْسَلْنَٓا اِلَیْهِمُ اثْنَیْنِ فَكَذَّبُوهُمَا فَعَزَّزْنَا بِثَالِثٍ فَقَالُٓوا اِنَّٓا اِلَیْكُمْ مُرْسَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26040,
            "SureId": 36,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "قَالُوا مَٓا اَنْتُمْ اِلَّا بَشَرٌ مِثْلُنَاۙ وَمَٓا اَنْزَلَ الرَّحْمٰنُ مِنْ شَیْءٍۙ اِنْ اَنْتُمْ اِلَّا تَكْذِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26047,
            "SureId": 36,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "قَالُوا رَبُّنَا یَعْلَمُ اِنَّٓا اِلَیْكُمْ لَمُرْسَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26054,
            "SureId": 36,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "وَمَا عَلَیْنَٓا اِلَّا الْبَلَاغُ الْمُبٖینُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26061,
            "SureId": 36,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "قَالُٓوا اِنَّا تَطَیَّرْنَا بِكُمْۚ لَئِنْ لَمْ تَنْتَهُوا لَنَرْجُمَنَّكُمْ وَلَیَمَسَّنَّكُمْ مِنَّا عَذَابٌ اَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26068,
            "SureId": 36,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "قَالُوا طَٓائِرُكُمْ مَعَكُمْؕ اَئِنْ ذُكِّرْتُمْؕ بَلْ اَنْتُمْ قَوْمٌ مُسْرِفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26075,
            "SureId": 36,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "وَجَٓاءَ مِنْ اَقْصَا الْمَدٖینَةِ رَجُلٌ یَسْعٰى قَالَ یَا قَوْمِ اتَّبِعُوا الْمُرْسَلٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26082,
            "SureId": 36,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "اِتَّبِعُوا مَنْ لَا یَسْـَٔلُكُمْ اَجْرًا وَهُمْ مُهْتَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26089,
            "SureId": 36,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "وَمَا لِیَ لَٓا اَعْبُدُ الَّذٖی فَطَرَنٖی وَاِلَیْهِ تُرْجَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26096,
            "SureId": 36,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "ءَاَتَّخِذُ مِنْ دُونِهٖٓ اٰلِهَةً اِنْ یُرِدْنِ الرَّحْمٰنُ بِضُرٍّ لَا تُغْنِ عَنّٖی شَفَاعَتُهُمْ شَیْـًٔا وَلَا یُنْقِذُونِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26103,
            "SureId": 36,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "اِنّٖٓی اِذًا لَفٖی ضَلَالٍ مُبٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26110,
            "SureId": 36,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "اِنّٖٓی اٰمَنْتُ بِرَبِّكُمْ فَاسْمَعُونِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26117,
            "SureId": 36,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "قٖیلَ ادْخُلِ الْجَنَّةَؕ قَالَ یَا لَیْتَ قَوْمٖی یَعْلَمُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26124,
            "SureId": 36,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "بِمَا غَفَرَ لٖی رَبّٖی وَجَعَلَنٖی مِنَ الْمُكْرَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 26024,
            "SureId": 36,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "Onlara mâlûm şehir halkını örnek göster. Oraya elçiler gelmişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 36,
                "MealInfo": "Mekke döneminde inmiştir. 83 âyettir. Sûre, adını ilk âyeti oluşturan <b>“Yâ-S</b>în” harflerinden almıştır. Sûrede başlıca i<b>nsanın ahlâkî sorumlulukları, vahiy, Hz. Peygamber’i yalanlayan Kureyş kabilesi, Antakya halkına gönderilen peygamberler, Allah’ın birliğini ve kudretini gösteren deliller, öldükten sonra dirilme,hesap ve ceza konu </b>edilmektedir.",
                "SureNameTurkish": "Yâsîn",
                "SureNameArabic": "يٰسۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 41,
                "AyetCount": 83,
                "Cuz": 22,
                "FirstPage": 440,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26031,
            "SureId": 36,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "Biz kendilerine iki kişi göndermiştik ama ikisini de yalancılıkla itham ettiler. Bunun üzerine bir üçüncüyle destekledik. Onlar “Biz size gönderilmiş elçileriz” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26038,
            "SureId": 36,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "Diğerleri ise şöyle karşılık verdiler: “Siz de ancak bizler gibi insanlarsınız. Hem rahmân herhangi bir şey indirmiş değil; siz sadece yalan söylüyorsunuz!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26045,
            "SureId": 36,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "“Rabbimiz biliyor ki” dediler, “Biz gerçekten size gönderilmiş elçileriz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26052,
            "SureId": 36,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "Bize düşen, açıkça tebliğ etmekten ibarettir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26059,
            "SureId": 36,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "(İnkârcılar) şu karşılığı verdiler: “Doğrusu sizin yüzünüzden üzerimize uğursuzluk geldi. Eğer vazgeçmezseniz, biliniz ki sizi taşlayacağız ve tarafımızdan size acı veren bir işkence yapılacaktır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26066,
            "SureId": 36,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "Onlar da dediler ki: “Uğursuzluğunuz kendinizdendir. Size öğüt verildi diye öyle mi? Hayır! Siz sınırı aşmış bir topluluksunuz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26073,
            "SureId": 36,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "O sırada şehrin öbür ucundan bir adam koşarak geldi; şöyle dedi: “Ey kavmim! Bu elçilere uyun.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26080,
            "SureId": 36,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "Sizden bir ücret istemeyen o kimselere tâbi olun; onlar doğru yoldadırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26087,
            "SureId": 36,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "Hem ne diye beni yaratan ve sizin de dönüp kendisine varacağınız Allah’a kulluk etmeyeyim ki?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26094,
            "SureId": 36,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "Hiç O’ndan başka mâbudlar edinir miyim! Eğer Rahmân bana bir zarar vermek isterse onların şefaati bana hiçbir yarar sağlamaz ve onlar beni kurtaramazlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26101,
            "SureId": 36,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "İşte o takdirde (başka bir tanrı edinirsem) ben apaçık bir sapkınlık içine düşmüş olurum.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26108,
            "SureId": 36,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "İşte ben rabbinize iman etmiş bulunuyorum; bana kulak verin.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26115,
            "SureId": 36,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26-27",
            "AyetVisible": true,
            "Page": 441,
            "AyetText": "Ona, “Cennete gir” denildi. “Rabbimin beni bağışladığını ve güzel biçimde ağırlananlardan eylediğini keşke kavmim bilseydi!” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26122,
            "SureId": 36,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": false,
            "Page": 441,
            "AyetText": "Ona, \"Cennete gir\" denildi. \"Rabbimin beni bağışladığını ve güzel biçimde ağırlananlardan eylediğini keşke kavmim bilseydi!\" dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
