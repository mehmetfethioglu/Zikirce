{
    "PointerList": null,
    "CuzNo": 14,
    "PageNo": 263,
    "ArCuzNo": "۱٤",
    "ArPageNo": "۲٦۳",
    "QuranAyats": [
        {
            "Id": 12726,
            "SureId": 15,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "وَلَقَدْ جَعَلْنَا فِی السَّمَٓاءِ بُرُوجًا وَزَیَّنَّاهَا لِلنَّاظِرٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 15,
                "MealInfo": "Mekke döneminde inmiştir. 99 âyettir. Sûre, adını 80. âyette geçen <b>“Hicr” </b>kelimesinden almıştır. Hicr, Medine’nin kuzeyinde vaktiyle Semûd kavminin yaşadığı bir yerin adıdır. Sûre de başlıca Allah’ın birliği, peygamberlik, öldükten sonra dirilme ve hesap konuları; peygamberlerin, çeşitli zamanlarda azgınlara ve inkârcılara karşı verdikleri mücadeleler çerçevesinde ele alınmaktadır. Bu sûre de ayrıca ilâhî kitapların kendisiyle kemale erdiği Kur’an’ın, her türlü tahriften korunacağı hükmü de yer almaktadır.",
                "SureNameTurkish": "Hicr",
                "SureNameArabic": "الْحِجْرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 54,
                "AyetCount": 99,
                "Cuz": 14,
                "FirstPage": 262,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12733,
            "SureId": 15,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "وَحَفِظْنَاهَا مِنْ كُلِّ شَیْطَانٍ رَجٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12740,
            "SureId": 15,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "اِلَّا مَنِ اسْتَرَقَ السَّمْعَ فَاَتْبَعَهُ شِهَابٌ مُبٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12747,
            "SureId": 15,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "وَالْاَرْضَ مَدَدْنَاهَا وَاَلْقَیْنَا فٖیهَا رَوَاسِیَ وَاَنْبَتْنَا فٖیهَا مِنْ كُلِّ شَیْءٍ مَوْزُونٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12754,
            "SureId": 15,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "وَجَعَلْنَا لَكُمْ فٖیهَا مَعَایِشَ وَمَنْ لَسْتُمْ لَهُ بِرَازِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12761,
            "SureId": 15,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "وَاِنْ مِنْ شَیْءٍ اِلَّا عِنْدَنَا خَزَٓائِنُهُؗ وَمَا نُنَزِّلُهُٓ اِلَّا بِقَدَرٍ مَعْلُومٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12768,
            "SureId": 15,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "وَاَرْسَلْنَا الرِّیَاحَ لَوَاقِـحَ فَاَنْزَلْنَا مِنَ السَّمَٓاءِ مَٓاءً فَاَسْقَیْنَاكُمُوهُۚ وَمَٓا اَنْتُمْ لَهُ بِخَازِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12775,
            "SureId": 15,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "وَاِنَّا لَنَحْنُ نُحْيٖ وَنُمٖیتُ وَنَحْنُ الْوَارِثُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12782,
            "SureId": 15,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "وَلَقَدْ عَلِمْنَا الْمُسْتَقْدِمٖینَ مِنْكُمْ وَلَقَدْ عَلِمْنَا الْمُسْتَاْخِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12789,
            "SureId": 15,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "وَاِنَّ رَبَّكَ هُوَ یَحْشُرُهُمْؕ اِنَّهُ حَكٖیمٌ عَلٖیمٌࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12796,
            "SureId": 15,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "وَلَقَدْ خَلَقْنَا الْاِنْسَانَ مِنْ صَلْصَالٍ مِنْ حَمَاٍ مَسْنُونٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12803,
            "SureId": 15,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "وَالْجَٓانَّ خَلَقْنَاهُ مِنْ قَبْلُ مِنْ نَارِ السَّمُومِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12810,
            "SureId": 15,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "وَاِذْ قَالَ رَبُّكَ لِلْمَلٰٓئِكَةِ اِنّٖی خَالِقٌ بَشَرًا مِنْ صَلْصَالٍ مِنْ حَمَاٍ مَسْنُونٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12817,
            "SureId": 15,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "فَاِذَا سَوَّیْتُهُ وَنَفَخْتُ فٖیهِ مِنْ رُوحٖی فَقَعُوا لَهُ سَاجِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12824,
            "SureId": 15,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "فَسَجَدَ الْمَلٰٓئِكَةُ كُلُّهُمْ اَجْمَعُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12831,
            "SureId": 15,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "اِلَّٓا اِبْلٖیسَؕ اَبٰٓى اَنْ یَكُونَ مَعَ السَّاجِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 12724,
            "SureId": 15,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Andolsun biz gökte yıldız kümeleri oluşturduk ve seyredenler için ona güzel bir görünüm verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 15,
                "MealInfo": "Mekke döneminde inmiştir. 99 âyettir. Sûre, adını 80. âyette geçen <b>“Hicr” </b>kelimesinden almıştır. Hicr, Medine’nin kuzeyinde vaktiyle Semûd kavminin yaşadığı bir yerin adıdır. Sûre de başlıca Allah’ın birliği, peygamberlik, öldükten sonra dirilme ve hesap konuları; peygamberlerin, çeşitli zamanlarda azgınlara ve inkârcılara karşı verdikleri mücadeleler çerçevesinde ele alınmaktadır. Bu sûre de ayrıca ilâhî kitapların kendisiyle kemale erdiği Kur’an’ın, her türlü tahriften korunacağı hükmü de yer almaktadır.",
                "SureNameTurkish": "Hicr",
                "SureNameArabic": "الْحِجْرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 54,
                "AyetCount": 99,
                "Cuz": 14,
                "FirstPage": 262,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12731,
            "SureId": 15,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Onları her kovulmuş şeytana karşı koruduk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12738,
            "SureId": 15,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Ancak kulak hırsızlığı yapmaya kalkışan olursa onu da parlak bir ışık kovalar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12745,
            "SureId": 15,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Arzı da yaydık, oraya sağlam dağlar yerleştirdik, orada ölçüleri belli her türden ürünler bitirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12752,
            "SureId": 15,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Yine orada hem sizin için hem de rızkı size borç olmayanlar için uygun geçim şartları yarattık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12759,
            "SureId": 15,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Her şeyin hazineleri sadece bizim katımızdadır ve biz oradan indirdiğimizi belirli bir ölçüye göre indiririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12766,
            "SureId": 15,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Biz, rüzgârları aşılayıcı olarak gönderdik, gökten su indirip onunla sizin su ihtiyacınızı karşıladık. Onu depolayan siz değildiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12773,
            "SureId": 15,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Kuşkusuz hayat veren de öldüren de biziz; her şeyin son sahibi de biz oluruz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12780,
            "SureId": 15,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Andolsun biz, içinizden önce gelip geçenleri de biliriz, geri kalanları da muhakkak biliriz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12787,
            "SureId": 15,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Ve senin rabbin, onları kıyamette toplayıp bir araya getirecektir. O, hakîmdir, alîmdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12794,
            "SureId": 15,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Andolsun biz insanı şekillenebilir özlü balçıktan, (şekil verilip) kurutulmuş çamurdan yarattık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12801,
            "SureId": 15,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Cin türüne gelince daha önce onu da kavurucu ateşten yaratmıştık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12808,
            "SureId": 15,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Hani rabbin meleklere demişti ki: “Ben şekillenebilir özlü balçıktan, (şekil verilip) kurutulmuş çamurdan bir insan yaratacağım” demişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12815,
            "SureId": 15,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "“Onun şeklini tamamladığım ve ona ruhumdan üflediğim vakit siz de hemen onun için secdeye kapanın.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12822,
            "SureId": 15,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Bunun üzerine meleklerin hepsi secde ettiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12829,
            "SureId": 15,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 263,
            "AyetText": "Yalnız İblîs hariç; o, secde edenlerle birlikte olmaktan kaçındı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Hicr",
    "QuranSureLabel": "الْحِجْرِ",
    "EndPageSure": null
}