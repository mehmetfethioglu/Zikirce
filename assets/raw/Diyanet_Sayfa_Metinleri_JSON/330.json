    "QuranAyats": [
        {
            "Id": 18018,
            "SureId": 21,
            "AyetId": 91,
            "LanguageId": 7,
            "AyetNumber": "٩١",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "وَالَّتٖٓی اَحْصَنَتْ فَرْجَهَا فَنَفَخْنَا فٖیهَا مِنْ رُوحِنَا وَجَعَلْنَاهَا وَابْنَهَٓا اٰیَةً لِلْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18025,
            "SureId": 21,
            "AyetId": 92,
            "LanguageId": 7,
            "AyetNumber": "٩٢",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "اِنَّ هٰذِهٖٓ اُمَّتُكُمْ اُمَّةً وَاحِدَةًؗ وَاَنَا𐻾 رَبُّكُمْ فَاعْبُدُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18032,
            "SureId": 21,
            "AyetId": 93,
            "LanguageId": 7,
            "AyetNumber": "٩٣",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "وَتَقَطَّعُٓوا اَمْرَهُمْ بَیْنَهُمْؕ كُلٌّ اِلَیْنَا رَاجِعُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18039,
            "SureId": 21,
            "AyetId": 94,
            "LanguageId": 7,
            "AyetNumber": "٩٤",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "فَمَنْ یَعْمَلْ مِنَ الصَّالِحَاتِ وَهُوَ مُؤْمِنٌ فَلَا كُفْرَانَ لِسَعْیِهٖۚ وَاِنَّا لَهُ كَاتِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18046,
            "SureId": 21,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "وَحَرَامٌ عَلٰى قَرْیَةٍ اَهْلَكْنَاهَٓا اَنَّهُمْ لَا یَرْجِعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18053,
            "SureId": 21,
            "AyetId": 96,
            "LanguageId": 7,
            "AyetNumber": "٩٦",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "حَتّٰٓى اِذَا فُتِحَتْ یَاْجُوجُ وَمَاْجُوجُ وَهُمْ مِنْ كُلِّ حَدَبٍ یَنْسِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18060,
            "SureId": 21,
            "AyetId": 97,
            "LanguageId": 7,
            "AyetNumber": "٩٧",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "وَاقْتَرَبَ الْوَعْدُ الْحَقُّ فَاِذَا هِیَ شَاخِصَةٌ اَبْصَارُ الَّذٖینَ كَفَرُواؕ یَا وَیْلَنَا قَدْ كُنَّا فٖی غَفْلَةٍ مِنْ هٰذَا بَلْ كُنَّا ظَالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18067,
            "SureId": 21,
            "AyetId": 98,
            "LanguageId": 7,
            "AyetNumber": "٩٨",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "اِنَّكُمْ وَمَا تَعْبُدُونَ مِنْ دُونِ اللّٰهِ حَصَبُ جَهَنَّمَؕ اَنْتُمْ لَهَا وَارِدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18074,
            "SureId": 21,
            "AyetId": 99,
            "LanguageId": 7,
            "AyetNumber": "٩٩",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "لَوْ كَانَ هٰٓؤُ𐻾لَٓاءِ اٰلِهَةً مَا وَرَدُوهَاؕ وَكُلٌّ فٖیهَا خَالِدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18081,
            "SureId": 21,
            "AyetId": 100,
            "LanguageId": 7,
            "AyetNumber": "١٠٠",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "لَهُمْ فٖیهَا زَفٖیرٌ وَهُمْ فٖیهَا لَا یَسْمَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18088,
            "SureId": 21,
            "AyetId": 101,
            "LanguageId": 7,
            "AyetNumber": "١٠١",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "اِنَّ الَّذٖینَ سَبَقَتْ لَهُمْ مِنَّا الْحُسْنٰٓىۙ اُو𐻾لٰٓئِكَ عَنْهَا مُبْعَدُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 18016,
            "SureId": 21,
            "AyetId": 91,
            "LanguageId": 5,
            "AyetNumber": "91",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "İffetini korumuş olan kadını da an! Ona ruhumuzdan üfledik; onu ve oğlunu cümle âlem için bir işaret kıldık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18023,
            "SureId": 21,
            "AyetId": 92,
            "LanguageId": 5,
            "AyetNumber": "92",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "“Gerçekten bu, tek bir din topluluğu olarak sizin ümmetinizdir; ben de sizin rabbinizim. Şu halde bana kulluk edin” (dedik).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18030,
            "SureId": 21,
            "AyetId": 93,
            "LanguageId": 5,
            "AyetNumber": "93",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "Ama insanlar kendi aralarında birliği paramparça ettiler. Oysa hepsi bize ­dönecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18037,
            "SureId": 21,
            "AyetId": 94,
            "LanguageId": 5,
            "AyetNumber": "94",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "Bu durumda her kim mümin olarak dünya ve âhiret için yararlı işler yaparsa çabası asla inkâr edilmez, biz onu yazmaktayız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18044,
            "SureId": 21,
            "AyetId": 95,
            "LanguageId": 5,
            "AyetNumber": "95",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "Helâk ettiğimiz bir belde için artık dönüş imkânsızdır; onlar geri ­dönemeyeceklerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18051,
            "SureId": 21,
            "AyetId": 96,
            "LanguageId": 5,
            "AyetNumber": "96",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "Nihayet Ye’cûc ve Me’cûc (sedleri) açıldığı ve onlar her tepeden akın ettiği zaman;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18058,
            "SureId": 21,
            "AyetId": 97,
            "LanguageId": 5,
            "AyetNumber": "97",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "Şaşmaz sözün gerçekleşmesi yaklaşmıştır; bir de bakarsın ki inkârcıların gözleri yerinden fırlamış! “Gerçekten biz, bu konuda gaflet içindeymişiz; daha da ötesi büsbütün zulme batmışız” diye yakınmaktadırlar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18065,
            "SureId": 21,
            "AyetId": 98,
            "LanguageId": 5,
            "AyetNumber": "98",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "Şüphe yok ki siz ve Allah’tan başka taptığınız tanrılar cehennem yakıtısınız, hepiniz oraya gideceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18072,
            "SureId": 21,
            "AyetId": 99,
            "LanguageId": 5,
            "AyetNumber": "99",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "Onlar tanrı olsalardı cehenneme gitmezlerdi. Oysa hepsi orada ebedî kalacaklardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18079,
            "SureId": 21,
            "AyetId": 100,
            "LanguageId": 5,
            "AyetNumber": "100",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "Orada onlara sızlanıp inlemek düşer. Onlar orada başka bir şey işitmezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18086,
            "SureId": 21,
            "AyetId": 101,
            "LanguageId": 5,
            "AyetNumber": "101",
            "AyetVisible": true,
            "Page": 330,
            "AyetText": "Daha önce bizden en güzel sonucun vaadini almış olanlara gelince, işte onlar cehennemden uzak tutulurlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
