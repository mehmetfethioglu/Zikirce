                "FirstPage": 596,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42420,
            "SureId": 92,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "وَالنَّهَارِ اِذَا تَجَلّٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42427,
            "SureId": 92,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "وَمَا خَلَقَ الذَّكَرَ وَالْاُنْثٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42434,
            "SureId": 92,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "اِنَّ سَعْیَكُمْ لَشَتّٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42441,
            "SureId": 92,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "فَاَمَّا مَنْ اَعْطٰى وَاتَّقٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42448,
            "SureId": 92,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "وَصَدَّقَ بِالْحُسْنٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42455,
            "SureId": 92,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "فَسَنُیَسِّرُهُ لِلْیُسْرٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42462,
            "SureId": 92,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "وَاَمَّا مَنْ بَخِلَ وَاسْتَغْنٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42469,
            "SureId": 92,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "وَكَذَّبَ بِالْحُسْنٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42476,
            "SureId": 92,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "فَسَنُیَسِّرُهُ لِلْعُسْرٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42483,
            "SureId": 92,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "وَمَا یُغْنٖی عَنْهُ مَالُهُٓ اِذَا تَرَدّٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42490,
            "SureId": 92,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "اِنَّ عَلَیْنَا لَلْهُدٰىؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42497,
            "SureId": 92,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "وَاِنَّ لَنَا لَلْاٰخِرَةَ وَالْاُو𐻿لٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42504,
            "SureId": 92,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "فَاَنْذَرْتُكُمْ نَارًا تَلَظّٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42511,
            "SureId": 92,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "لَا یَصْلٰیهَٓا اِلَّا الْاَشْقٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42518,
            "SureId": 92,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "اَلَّذٖی كَذَّبَ وَتَوَلّٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42525,
            "SureId": 92,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "وَسَیُجَنَّبُهَا الْاَتْقٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42532,
            "SureId": 92,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "اَلَّذٖی یُؤْتٖی مَالَهُ یَتَزَكّٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42539,
            "SureId": 92,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "وَمَا لِاَحَدٍ عِنْدَهُ مِنْ نِعْمَةٍ تُجْزٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42546,
            "SureId": 92,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "اِلَّا ابْتِغَٓاءَ وَجْهِ رَبِّهِ الْاَعْلٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42553,
            "SureId": 92,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "وَلَسَوْفَ یَرْضٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42560,
            "SureId": 93,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "وَالضُّحٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 93,
                "MealInfo": "Mekke döneminde inmiştir. 11 âyettir. Duhâ, kuşluk vakti demektir",
                "SureNameTurkish": "Duhâ",
                "SureNameArabic": "الضُّحٰى",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 11,
                "AyetCount": 11,
                "Cuz": 30,
                "FirstPage": 596,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42567,
            "SureId": 93,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "وَالَّیْلِ اِذَا سَجٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42574,
            "SureId": 93,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 42411,
            "SureId": 92,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Yemin olsun, bürüyüp örttüğünde geceye;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 92,
                "MealInfo": "Mekke döneminde inmiştir. 21 âyettir. Leyl, gece demektir",
                "SureNameTurkish": "Leyl",
                "SureNameArabic": "الَّيْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 9,
                "AyetCount": 21,
                "Cuz": 30,
                "FirstPage": 596,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42418,
            "SureId": 92,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Aydınlandığında gündüze;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42425,
            "SureId": 92,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Erkeği ve dişiyi yaratan ilâhî kudrete ki,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42432,
            "SureId": 92,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Çabalarınız elbette farklı farklıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42439,
            "SureId": 92,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Artık kim cömert davranır, günah işlemekten sakınırsa;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42446,
            "SureId": 92,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Bunların güzel karşılığına da inanırsa;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42453,
            "SureId": 92,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Biz ona iyilik yollarını kolaylaştırırız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42460,
            "SureId": 92,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Ama kim cimrilik eder, kendisiyle yetinirse;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42467,
            "SureId": 92,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Güzel karşılığı da yalan sayarsa;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42474,
            "SureId": 92,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Biz onu zora sokarız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42481,
            "SureId": 92,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Kabir çukuruna düştüğü zaman da malı kendisine hiç fayda vermez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42488,
            "SureId": 92,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Doğru yolu göstermek bize aittir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42495,
            "SureId": 92,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Şüphesiz âhiret de dünya da bizimdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42502,
            "SureId": 92,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Böylece alev alev yanan bir ateşe karşı sizi uyarmış bulunuyorum.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42509,
            "SureId": 92,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15-16",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "O ateşe ancak gerçeği yalan sayıp sırt çeviren isyankâr kişi girer.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42516,
            "SureId": 92,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": false,
            "Page": 596,
            "AyetText": "O ateşe ancak gerçeği yalan sayıp sırt çeviren isyankâr kişi girer.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42523,
            "SureId": 92,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17-18",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Malını Allah yolunda verip arınan takvâ ehli ise ondan (ateşten) uzak tutulur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42530,
            "SureId": 92,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": false,
            "Page": 596,
            "AyetText": "Malını Allah yolunda verip arınan takvâ ehli ise ondan uzak tutulur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42537,
            "SureId": 92,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19-20",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "O öyle biridir ki, hiç kimsenin kendisi üzerinde karşılığını ödeyeceği bir hakkı olmadığı halde sırf yüce rabbinin rızâsını kazanmak için yardım eder.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42544,
            "SureId": 92,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": false,
            "Page": 596,
            "AyetText": "Ancak yüce rabbinin rızâsını kazanmak için verir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42551,
            "SureId": 92,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Ve sonunda hoşnut da olacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42558,
            "SureId": 93,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Yemin olsun, kuşluk vaktine;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 93,
                "MealInfo": "Mekke döneminde inmiştir. 11 âyettir. Duhâ, kuşluk vakti demektir",
                "SureNameTurkish": "Duhâ",
                "SureNameArabic": "الضُّحٰى",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 11,
                "AyetCount": 11,
                "Cuz": 30,
                "FirstPage": 596,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42565,
            "SureId": 93,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Kararıp sakinleştiğinde geceye ki;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42572,
            "SureId": 93,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 596,
            "AyetText": "Rabbin seni bırakmadı ve sana darılmadı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
