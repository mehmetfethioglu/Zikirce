    "QuranAyats": [
        {
            "Id": 13608,
            "SureId": 16,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "وَمَٓا اَرْسَلْنَا مِنْ قَبْلِكَ اِلَّا رِجَالًا نُوحٖٓی اِلَیْهِمْ فَسْـَٔلُٓوا اَهْلَ الذِّكْرِ اِنْ كُنْتُمْ لَا تَعْلَمُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
                "Cuz": 14,
                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 13615,
            "SureId": 16,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "بِالْبَیِّنَاتِ وَالزُّبُرِؕ وَاَنْزَلْنَٓا اِلَیْكَ الذِّكْرَ لِتُبَیِّنَ لِلنَّاسِ مَا نُزِّلَ اِلَیْهِمْ وَلَعَلَّهُمْ یَتَفَكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13622,
            "SureId": 16,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "اَفَاَمِنَ الَّذٖینَ مَكَرُوا السَّیِّــَٔاتِ اَنْ یَخْسِفَ اللّٰهُ بِهِمُ الْاَرْضَ اَوْ یَاْتِیَهُمُ الْعَذَابُ مِنْ حَیْثُ لَا یَشْعُرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13629,
            "SureId": 16,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "اَوْ یَاْخُذَهُمْ فٖی تَقَلُّبِهِمْ فَمَا هُمْ بِمُعْجِزٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13636,
            "SureId": 16,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "اَوْ یَاْخُذَهُمْ عَلٰى تَخَوُّفٍؕ فَاِنَّ رَبَّكُمْ لَرَؤُ𐻿فٌ رَحٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13643,
            "SureId": 16,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "اَوَلَمْ یَرَوْا اِلٰى مَا خَلَقَ اللّٰهُ مِنْ شَیْءٍ یَتَفَیَّؤُ𐻾ا ظِلَالُهُ عَنِ الْیَمٖینِ وَالشَّمَٓائِلِ سُجَّدًا لِلّٰهِ وَهُمْ دَاخِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13650,
            "SureId": 16,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "وَلِلّٰهِ یَسْجُدُ مَا فِی السَّمٰوَاتِ وَمَا فِی الْاَرْضِ مِنْ دَٓابَّةٍ وَالْمَلٰٓئِكَةُ وَهُمْ لَا یَسْتَكْبِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13657,
            "SureId": 16,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "یَخَافُونَ رَبَّهُمْ مِنْ فَوْقِهِمْ وَیَفْعَلُونَ مَا یُؤْمَرُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13664,
            "SureId": 16,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "وَقَالَ اللّٰهُ لَا تَتَّخِذُٓوا اِلٰهَیْنِ اثْنَیْنِۚ اِنَّمَا هُوَ اِلٰهٌ وَاحِدٌۚ فَاِیَّایَ فَارْهَبُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13671,
            "SureId": 16,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "وَلَهُ مَا فِی السَّمٰوَاتِ وَالْاَرْضِ وَلَهُ الدّٖینُ وَاصِبًاؕ اَفَغَیْرَ اللّٰهِ تَتَّقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13678,
            "SureId": 16,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "وَمَا بِكُمْ مِنْ نِعْمَةٍ فَمِنَ اللّٰهِ ثُمَّ اِذَا مَسَّكُمُ الضُّرُّ فَاِلَیْهِ تَجْــَٔرُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13685,
            "SureId": 16,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "ثُمَّ اِذَا كَشَفَ الضُّرَّ عَنْكُمْ اِذَا فَرٖیقٌ مِنْكُمْ بِرَبِّهِمْ یُشْرِكُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 13606,
            "SureId": 16,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "Senden önce de ancak kendilerine vahiy indirdiğimiz kişileri peygamber olarak gönderdik. Eğer bilmiyorsanız bilgi sahibi olanlara sorun.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
                "Cuz": 14,
                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 13613,
            "SureId": 16,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "O peygamberleri apaçık delillerle ve kutsal metinlerle gönderdik. İnsanlara indirileni kendilerine açıklaman için ve (ola ki üzerinde) düşünürler diye sana da uyarıcı kitabı indirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13620,
            "SureId": 16,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45-46",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "Şimdi şu kötülükleri planlayanlar, Allah’ın onları yerin dibine geçirmeyeceğinden veya hiç bilemeyecekleri bir yerden kendilerine azabın gelmeyeceğinden ya da onlar işe güce dalmışken Allah’ın kendilerini kıskıvrak yakalamayacağından emin mi oldular? Onların bunu engelleme güçleri de yoktur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13627,
            "SureId": 16,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46-47",
            "AyetVisible": false,
            "Page": 272,
            "AyetText": "Şimdi şu kötülükleri planlayanlar, Allah’ın onları yerin dibine geçirmeyeceğinden veya hiç bilemeyecekleri bir yerden kendilerine azabın gelmeyeceğinden ya da onlar işe güce dalmışken Allah’ın kendilerini kıskıvrak yakalamayacağından emin mi oldular? Onların bunu engelleme güçleri de yoktur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13634,
            "SureId": 16,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "Yoksa Allah’ın içlerine felâket korkusu salarak kendilerini cezalandırmayacağına dair bir güvenceleri mi var? Ama sizin rabbiniz kuşkusuz çok şefkatli, çok merhametlidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13641,
            "SureId": 16,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "Allah’ın yarattığı nesneleri görmüyorlar mı? Onların gölgeleri sağa ve sola dönmekte, Allah’a secde edip yere kapanmaktadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13648,
            "SureId": 16,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "Göklerdekiler, yerdeki canlılar ve melekler büyüklük taslamadan Allah’a secde ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13655,
            "SureId": 16,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "Onlar, yüceler yücesi bildikleri rablerinden korkar, kendilerine buyurulanı yerine getirirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13662,
            "SureId": 16,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "Allah buyurdu ki: “İki tanrı edinmeyin, Tanrı bir tektir. Şu halde yalnız benden korkun.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13669,
            "SureId": 16,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "Göklerde ve yerde ne varsa O’nundur, itaat da daima ve yalnız O’na yapılır. Allah’tan başkasından mı korkuyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13676,
            "SureId": 16,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "Elinizde nimet olarak ne varsa Allah’tandır. Sonra başınıza bir sıkıntı geldiğinde O’na yalvarırsınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13683,
            "SureId": 16,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 272,
            "AyetText": "Allah sizi sıkıntıdan kurtardığında içinizden bazıları, gariptir ki, hemen rablerine ortak koşarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
