            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "وَقَالَ فِرْعَوْنُ ائْتُونٖی بِكُلِّ سَاحِرٍ عَلٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 10,
                "MealInfo": "40,94,95 ve 96. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir.109 âyettir. Sûrede temel konu olarak Allah’ın rahmetinin gazabına üstünolduğu vurgulanmaktadır. Sûrede, Yûnus, Nûh ve Mûsâ peygamberlerile bunların kavimlerinin kıssalarına yer verilmektedir. Sûre, adını içindekiYûnus kıssasından almıştır.",
                "SureNameTurkish": "Yûnus",
                "SureNameArabic": "يُونُسَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 51,
                "AyetCount": 109,
                "Cuz": 11,
                "FirstPage": 208,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 10108,
            "SureId": 10,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "فَلَمَّا جَٓاءَ السَّحَرَةُ قَالَ لَهُمْ مُوسٰٓى اَلْقُوا مَٓا اَنْتُمْ مُلْقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10115,
            "SureId": 10,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "فَلَمَّٓا اَلْقَوْا قَالَ مُوسٰى مَا جِئْتُمْ بِهِ السِّحْرُؕ اِنَّ اللّٰهَ سَیُبْطِلُهُؕ اِنَّ اللّٰهَ لَا یُصْلِحُ عَمَلَ الْمُفْسِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10122,
            "SureId": 10,
            "AyetId": 82,
            "LanguageId": 7,
            "AyetNumber": "٨٢",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "وَیُحِقُّ اللّٰهُ الْحَقَّ بِكَلِمَاتِهٖ وَلَوْ كَرِهَ الْمُجْرِمُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10129,
            "SureId": 10,
            "AyetId": 83,
            "LanguageId": 7,
            "AyetNumber": "٨٣",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "فَمَٓا اٰمَنَ لِمُوسٰٓى اِلَّا ذُرِّیَّةٌ مِنْ قَوْمِهٖ عَلٰى خَوْفٍ مِنْ فِرْعَوْنَ وَمَلَا𐻾ئِهِمْ اَنْ یَفْتِنَهُمْؕ وَاِنَّ فِرْعَوْنَ لَعَالٍ فِی الْاَرْضِۚ وَاِنَّهُ لَمِنَ الْمُسْرِفٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10136,
            "SureId": 10,
            "AyetId": 84,
            "LanguageId": 7,
            "AyetNumber": "٨٤",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "وَقَالَ مُوسٰى یَا قَوْمِ اِنْ كُنْتُمْ اٰمَنْتُمْ بِاللّٰهِ فَعَلَیْهِ تَوَكَّلُٓوا اِنْ كُنْتُمْ مُسْلِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10143,
            "SureId": 10,
            "AyetId": 85,
            "LanguageId": 7,
            "AyetNumber": "٨٥",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "فَقَالُوا عَلَى اللّٰهِ تَوَكَّلْنَاۚ رَبَّنَا لَا تَجْعَلْنَا فِتْنَةً لِلْقَوْمِ الظَّالِمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10150,
            "SureId": 10,
            "AyetId": 86,
            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "وَنَجِّنَا بِرَحْمَتِكَ مِنَ الْقَوْمِ الْكَافِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10157,
            "SureId": 10,
            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "وَاَوْحَیْنَٓا اِلٰى مُوسٰى وَاَخٖیهِ اَنْ تَبَوَّاٰ لِقَوْمِكُمَا بِمِصْرَ بُیُوتًا وَاجْعَلُوا بُیُوتَكُمْ قِبْلَةً وَاَقٖیمُوا الصَّلٰوةَؕ وَبَشِّرِ الْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10164,
            "SureId": 10,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "وَقَالَ مُوسٰى رَبَّنَٓا اِنَّكَ اٰتَیْتَ فِرْعَوْنَ وَمَلَاَهُ زٖینَةً وَاَمْوَالًا فِی الْحَیٰوةِ الدُّنْیَاۙ رَبَّنَا لِیُضِلُّوا عَنْ سَبٖیلِكَۚ رَبَّنَا اطْمِسْ عَلٰٓى اَمْوَالِهِمْ وَاشْدُدْ عَلٰى قُلُوبِهِمْ فَلَا یُؤْمِنُوا حَتّٰى یَرَوُا الْعَذَابَ الْاَلٖیمَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 10099,
            "SureId": 10,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "Firavun da, “İşi bilen bütün sihirbazları huzuruma getirin” diye emretti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 10,
                "MealInfo": "40,94,95 ve 96. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir.109 âyettir. Sûrede temel konu olarak Allah’ın rahmetinin gazabına üstünolduğu vurgulanmaktadır. Sûrede, Yûnus, Nûh ve Mûsâ peygamberlerile bunların kavimlerinin kıssalarına yer verilmektedir. Sûre, adını içindekiYûnus kıssasından almıştır.",
                "SureNameTurkish": "Yûnus",
                "SureNameArabic": "يُونُسَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 51,
                "AyetCount": 109,
                "Cuz": 11,
                "FirstPage": 208,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 10106,
            "SureId": 10,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "Sihirbazlar gelince Mûsâ onlara: “Haydi atabileceklerinizi atın” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10113,
            "SureId": 10,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "Onlar hünerlerini ortaya koyunca Mûsâ şöyle dedi: “Asıl bu sizin ortaya koyduğunuz sihirdir. Allah onu mutlaka boşa çıkaracaktır. Kuşkusuz Allah bozgunculuk edenlerin işini düzeltmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10120,
            "SureId": 10,
            "AyetId": 82,
            "LanguageId": 5,
            "AyetNumber": "82",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "Allah, günaha batmış olanlar hoşlanmasa da, sözleriyle gerçeği ortaya çıkarır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10127,
            "SureId": 10,
            "AyetId": 83,
            "LanguageId": 5,
            "AyetNumber": "83",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "Hâsılı, kavminden ancak az sayıda insan, Firavun ve adamlarının kendilerine kötülük edeceğinden korka korka Mûsâ’ya iman etti. Çünkü Firavun o topraklarda gerçekten güç ve iktidar sahibiydi, üstelik kötülükte sınır tanımaz biriydi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10134,
            "SureId": 10,
            "AyetId": 84,
            "LanguageId": 5,
            "AyetNumber": "84",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "Mûsâ “Ey kavmim!” dedi, “Eğer Allah’a iman ettiyseniz, gerçekten O’na teslim olduysanız, artık yalnız O’na güvenip dayanın.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10141,
            "SureId": 10,
            "AyetId": 85,
            "LanguageId": 5,
            "AyetNumber": "85",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "Onlar da şöyle karşılık verdiler: “Yalnız Allah’a dayanıp güvendik. Rabbimiz! Bizi o zalimler için imtihan aracı kılma!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10148,
            "SureId": 10,
            "AyetId": 86,
            "LanguageId": 5,
            "AyetNumber": "86",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "Merhametinle bizi o inkârcılar güruhundan kurtar.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10155,
            "SureId": 10,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "Mûsâ’ya ve kardeşine şöyle vahyettik: “Kavminiz için Mısır’da evler hazırlayın, evlerinizi ibadet mahalli yapın ve namazı kılın. (Ey Mûsâ!) İnananları müjdele.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10162,
            "SureId": 10,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": true,
            "Page": 218,
            "AyetText": "Mûsâ, “Rabbimiz!” dedi, “Sen Firavun’a ve adamlarına dünya hayatında ihtişam ve servet verdin; insanları senin yolundan saptırsınlar diye mi yâ rab! Ey rabbimiz! Artık onların servetlerini silip yok et, kalplerine sıkıntı ver; elem veren cezayı görmedikçe iman etmesinler de görsünler!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
