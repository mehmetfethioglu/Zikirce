{
    "PointerList": null,
    "CuzNo": 23,
    "PageNo": 449,
    "ArCuzNo": "۲۳",
    "ArPageNo": "٤٤۹",
    "QuranAyats": [
        {
            "Id": 27055,
            "SureId": 37,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "وَجَعَلْنَا ذُرِّیَّتَهُ هُمُ الْبَاقٖینَؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 37,
                "MealInfo": "Mekke döneminde inmiştir. 182 âyettir. Sûre, adını ilk âyette geçen <b>“es-Sâffât” </b>kelimesinden almıştır.<b> Sâffât, sıra sıra dizilenler, saf saf duranlar demektir</b>. Sûrede başlıca, <b>meleklerden, cinlerden, kıyamet ve ahiret olaylarından söz edilmekte; Nûh, İbrahim, İsmail, İshak, Mûsâ, Hârun, İlyas, Lût ve Yûnus Peygamberlerin kıssaları</b>na yer verilmektedir.",
                "SureNameTurkish": "Sâffât",
                "SureNameArabic": "الصَّاۤفَّاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 56,
                "AyetCount": 182,
                "Cuz": 23,
                "FirstPage": 446,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 27062,
            "SureId": 37,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "وَتَرَكْنَا عَلَیْهِ فِی الْاٰخِرٖینَؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27069,
            "SureId": 37,
            "AyetId": 79,
            "LanguageId": 7,
            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "سَلَامٌ عَلٰى نُوحٍ فِی الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27076,
            "SureId": 37,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "اِنَّا كَذٰلِكَ نَجْزِی الْمُحْسِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27083,
            "SureId": 37,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "اِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27090,
            "SureId": 37,
            "AyetId": 82,
            "LanguageId": 7,
            "AyetNumber": "٨٢",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "ثُمَّ اَغْرَقْنَا الْاٰخَرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27097,
            "SureId": 37,
            "AyetId": 83,
            "LanguageId": 7,
            "AyetNumber": "٨٣",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "وَاِنَّ مِنْ شٖیعَتِهٖ لَاِبْرٰهٖیمَۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27104,
            "SureId": 37,
            "AyetId": 84,
            "LanguageId": 7,
            "AyetNumber": "٨٤",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "اِذْ جَٓاءَ رَبَّهُ بِقَلْبٍ سَلٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27111,
            "SureId": 37,
            "AyetId": 85,
            "LanguageId": 7,
            "AyetNumber": "٨٥",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "اِذْ قَالَ لِاَبٖیهِ وَقَوْمِهٖ مَاذَا تَعْبُدُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27118,
            "SureId": 37,
            "AyetId": 86,
            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "اَئِفْكًا اٰلِهَةً دُونَ اللّٰهِ تُرٖیدُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27125,
            "SureId": 37,
            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "فَمَا ظَنُّكُمْ بِرَبِّ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27132,
            "SureId": 37,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "فَنَظَرَ نَظْرَةً فِی النُّجُومِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27139,
            "SureId": 37,
            "AyetId": 89,
            "LanguageId": 7,
            "AyetNumber": "٨٩",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "فَقَالَ اِنّٖی سَقٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27146,
            "SureId": 37,
            "AyetId": 90,
            "LanguageId": 7,
            "AyetNumber": "٩٠",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "فَتَوَلَّوْا عَنْهُ مُدْبِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27153,
            "SureId": 37,
            "AyetId": 91,
            "LanguageId": 7,
            "AyetNumber": "٩١",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "فَرَاغَ اِلٰٓى اٰلِهَتِهِمْ فَقَالَ اَلَا تَاْكُلُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27160,
            "SureId": 37,
            "AyetId": 92,
            "LanguageId": 7,
            "AyetNumber": "٩٢",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "مَا لَكُمْ لَا تَنْطِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27167,
            "SureId": 37,
            "AyetId": 93,
            "LanguageId": 7,
            "AyetNumber": "٩٣",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "فَرَاغَ عَلَیْهِمْ ضَرْبًا بِالْیَمٖینِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27174,
            "SureId": 37,
            "AyetId": 94,
            "LanguageId": 7,
            "AyetNumber": "٩٤",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "فَاَقْبَلُٓوا اِلَیْهِ یَزِفُّونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27181,
            "SureId": 37,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "قَالَ اَتَعْبُدُونَ مَا تَنْحِتُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27188,
            "SureId": 37,
            "AyetId": 96,
            "LanguageId": 7,
            "AyetNumber": "٩٦",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "وَاللّٰهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27195,
            "SureId": 37,
            "AyetId": 97,
            "LanguageId": 7,
            "AyetNumber": "٩٧",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "قَالُوا ابْنُوا لَهُ بُنْیَانًا فَاَلْقُوهُ فِی الْجَحٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27202,
            "SureId": 37,
            "AyetId": 98,
            "LanguageId": 7,
            "AyetNumber": "٩٨",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "فَاَرَادُوا بِهٖ كَیْدًا فَجَعَلْنَاهُمُ الْاَسْفَلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27209,
            "SureId": 37,
            "AyetId": 99,
            "LanguageId": 7,
            "AyetNumber": "٩٩",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "وَقَالَ اِنّٖی ذَاهِبٌ اِلٰى رَبّٖی سَیَهْدٖینِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27216,
            "SureId": 37,
            "AyetId": 100,
            "LanguageId": 7,
            "AyetNumber": "١٠٠",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "رَبِّ هَبْ لٖی مِنَ الصَّالِحٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27223,
            "SureId": 37,
            "AyetId": 101,
            "LanguageId": 7,
            "AyetNumber": "١٠١",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "فَبَشَّرْنَاهُ بِغُلَامٍ حَلٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27230,
            "SureId": 37,
            "AyetId": 102,
            "LanguageId": 7,
            "AyetNumber": "١٠٢",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "فَلَمَّا بَلَغَ مَعَهُ السَّعْیَ قَالَ یَا بُنَیَّ اِنّٖٓی اَرٰى فِی الْمَنَامِ اَنّٖٓی اَذْبَحُكَ فَانْظُرْ مَاذَا تَرٰىؕ قَالَ یَٓا اَبَتِ افْعَلْ مَا تُؤْمَرُؗ سَتَجِدُنٖٓی اِنْ شَٓاءَ اللّٰهُ مِنَ الصَّابِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 27053,
            "SureId": 37,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Ve yalnız onun soyunu kalıcı kıldık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 37,
                "MealInfo": "Mekke döneminde inmiştir. 182 âyettir. Sûre, adını ilk âyette geçen <b>“es-Sâffât” </b>kelimesinden almıştır.<b> Sâffât, sıra sıra dizilenler, saf saf duranlar demektir</b>. Sûrede başlıca, <b>meleklerden, cinlerden, kıyamet ve ahiret olaylarından söz edilmekte; Nûh, İbrahim, İsmail, İshak, Mûsâ, Hârun, İlyas, Lût ve Yûnus Peygamberlerin kıssaları</b>na yer verilmektedir.",
                "SureNameTurkish": "Sâffât",
                "SureNameArabic": "الصَّاۤفَّاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 56,
                "AyetCount": 182,
                "Cuz": 23,
                "FirstPage": 446,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 27060,
            "SureId": 37,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78-79",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Sonradan gelen nesiller arasında onun hakkında (iyi bir ün) bıraktık. Bütün âlemlerde ona selâm olsun!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27067,
            "SureId": 37,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": false,
            "Page": 449,
            "AyetText": "Sonradan gelen nesiller arasında onun hakkında (iyi bir ün) bıraktık. Bütün âlemlerde ona selâm olsun!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27074,
            "SureId": 37,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "İşte biz iyileri böyle ödüllendiririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27081,
            "SureId": 37,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Çünkü o bizim mümin kullarımızdandı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27088,
            "SureId": 37,
            "AyetId": 82,
            "LanguageId": 5,
            "AyetNumber": "82",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Sonunda ötekileri sulara gömdük.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27095,
            "SureId": 37,
            "AyetId": 83,
            "LanguageId": 5,
            "AyetNumber": "83",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Kuşkusuz İbrâhim Nûh’un yolunu izleyenlerdendi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27102,
            "SureId": 37,
            "AyetId": 84,
            "LanguageId": 5,
            "AyetNumber": "84",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "O, tertemiz bir kalple rabbine yönelmişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27109,
            "SureId": 37,
            "AyetId": 85,
            "LanguageId": 5,
            "AyetNumber": "85",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Babasına ve halkına, “Siz neye tapıyorsunuz?” demişti;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27116,
            "SureId": 37,
            "AyetId": 86,
            "LanguageId": 5,
            "AyetNumber": "86",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "“Allah’tan başka birtakım düzmece tanrılar mı edinmek istiyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27123,
            "SureId": 37,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Peki, âlemlerin rabbiyle ilgili düşünceniz nedir?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27130,
            "SureId": 37,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Sonra yıldızlara şöyle bir baktı;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27137,
            "SureId": 37,
            "AyetId": 89,
            "LanguageId": 5,
            "AyetNumber": "89",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "“Ben rahatsızım” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27144,
            "SureId": 37,
            "AyetId": 90,
            "LanguageId": 5,
            "AyetNumber": "90",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Bunun üzerine diğerleri onu arkalarında bırakıp gittiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27151,
            "SureId": 37,
            "AyetId": 91,
            "LanguageId": 5,
            "AyetNumber": "91",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "İbrâhim gizlice tanrılarının yanına vardı; “Niçin bir şeyler yemiyorsunuz?” dedi;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27158,
            "SureId": 37,
            "AyetId": 92,
            "LanguageId": 5,
            "AyetNumber": "92",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "“Neyiniz var, niçin konuşmuyorsunuz?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27165,
            "SureId": 37,
            "AyetId": 93,
            "LanguageId": 5,
            "AyetNumber": "93",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Sonra onlara güçlü darbeler indirmeye başladı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27172,
            "SureId": 37,
            "AyetId": 94,
            "LanguageId": 5,
            "AyetNumber": "94",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Diğerleri öfke içinde koşarak İbrâhim’in yanına geldiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27179,
            "SureId": 37,
            "AyetId": 95,
            "LanguageId": 5,
            "AyetNumber": "95",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Dedi ki: “Kendi ellerinizle yonttuğunuz şeylere mi tapıyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27186,
            "SureId": 37,
            "AyetId": 96,
            "LanguageId": 5,
            "AyetNumber": "96",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Oysa sizi de yaptıklarınızı da Allah yarattı.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27193,
            "SureId": 37,
            "AyetId": 97,
            "LanguageId": 5,
            "AyetNumber": "97",
            "AyetVisible": true,
            "Page": 449,
            "AyetText": "Ötekiler, “Onun için bir yapı kurun ve (orada hazırlayacağınız) kuvvetli ateşe atın onu!” dediler.",
