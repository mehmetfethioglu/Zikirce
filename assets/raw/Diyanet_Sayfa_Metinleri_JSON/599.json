        },
        {
            "Id": 42889,
            "SureId": 97,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "وَمَٓا اَدْرٰیكَ مَا لَیْلَةُ الْقَدْرِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42896,
            "SureId": 97,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "لَیْلَةُ الْقَدْرِ خَیْرٌ مِنْ اَلْفِ شَهْرٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42903,
            "SureId": 97,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "تَنَزَّلُ الْمَلٰٓئِكَةُ وَالرُّوحُ فٖیهَا بِاِذْنِ رَبِّهِمْۚ مِنْ كُلِّ اَمْرٍۙۛ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42910,
            "SureId": 97,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "سَلَامٌࣞۛ هِیَ حَتّٰى مَطْلَعِ الْفَجْرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42917,
            "SureId": 98,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "لَمْ یَكُنِ الَّذٖینَ كَفَرُوا مِنْ اَهْلِ الْكِتَابِ وَالْمُشْرِكٖینَ مُنْفَكّٖینَ حَتّٰى تَاْتِیَهُمُ الْبَیِّنَةُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 98,
                "MealInfo": "Medine döneminde inmiştir. 8 âyettir. Beyyine, apaçık delil demektir.",
                "SureNameTurkish": "Beyyine",
                "SureNameArabic": "الْبَيِّنَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 100,
                "AyetCount": 8,
                "Cuz": 30,
                "FirstPage": 599,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42924,
            "SureId": 98,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "رَسُولٌ مِنَ اللّٰهِ یَتْلُوا صُحُفًا مُطَهَّرَةًۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42931,
            "SureId": 98,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "فٖیهَا كُتُبٌ قَیِّمَةٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42938,
            "SureId": 98,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "وَمَا تَفَرَّقَ الَّذٖینَ اُو𐻿تُوا الْكِتَابَ اِلَّا مِنْ بَعْدِ مَا جَٓاءَتْهُمُ الْبَیِّنَةُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42945,
            "SureId": 98,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "وَمَٓا اُمِرُٓوا اِلَّا لِیَعْبُدُوا اللّٰهَ مُخْلِصٖینَ لَهُ الدّٖینَ حُنَفَٓاءَ وَیُقٖیمُوا الصَّلٰوةَ وَیُؤْتُوا الزَّكٰوةَ وَذٰلِكَ دٖینُ الْقَیِّمَةِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42952,
            "SureId": 98,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "اِنَّ الَّذٖینَ كَفَرُوا مِنْ اَهْلِ الْكِتَابِ وَالْمُشْرِكٖینَ فٖی نَارِ جَهَنَّمَ خَالِدٖینَ فٖیهَاؕ اُو𐻾لٰٓئِكَ هُمْ شَرُّ الْبَرِیَّةِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42959,
            "SureId": 98,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "اِنَّ الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِۙ اُو𐻾لٰٓئِكَ هُمْ خَیْرُ الْبَرِیَّةِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42966,
            "SureId": 98,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "جَزَٓاؤُ𐻾هُمْ عِنْدَ رَبِّهِمْ جَنَّاتُ عَدْنٍ تَجْرٖی مِنْ تَحْتِهَا الْاَنْهَارُ خَالِدٖینَ فٖیهَٓا اَبَدًاؕ رَضِیَ اللّٰهُ عَنْهُمْ وَرَضُوا عَنْهُؕ ذٰلِكَ لِمَنْ خَشِیَ رَبَّهُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
