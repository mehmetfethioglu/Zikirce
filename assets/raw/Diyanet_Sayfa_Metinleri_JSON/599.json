            }
        },
        {
            "Id": 42887,
            "SureId": 97,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "Bilir misin nedir Kadir gecesi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42894,
            "SureId": 97,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "Kadir gecesi bin aydan hayırlıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42901,
            "SureId": 97,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "O gece melekler ve ruh, rablerinin izniyle her bir iş için iner dururlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42908,
            "SureId": 97,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "O gece tan yeri ağarıncaya kadar esenlik doludur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42915,
            "SureId": 98,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1-2",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "Ehl-i kitap’tan ve müşriklerden hakkı inkâr edenler, kendilerine açık kanıt ve Allah tarafından gönderilen, tertemiz sayfaları okuyan bir elçi gelinceye kadar (hakkı inkârcılıktan) ayrılacak değillerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 98,
                "MealInfo": "Medine döneminde inmiştir. 8 âyettir. Beyyine, apaçık delil demektir.",
                "SureNameTurkish": "Beyyine",
                "SureNameArabic": "الْبَيِّنَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 100,
                "AyetCount": 8,
                "Cuz": 30,
                "FirstPage": 599,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42922,
            "SureId": 98,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": false,
            "Page": 599,
            "AyetText": "Ehl-i kitap’tan ve müşriklerden hakkı inkâr edenler, kendilerine açık kanıt; Allah tarafından gönderilen, tertemiz sayfaları okuyan bir elçi gelinceye kadar (bulundukları durumdan) ayrılacak değillerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42929,
            "SureId": 98,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "O sayfalarda dosdoğru hükümler yer almaktadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42936,
            "SureId": 98,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "Ehl-i kitap ancak kendilerine o açık kanıt geldikten sonra ayrılığa düştüler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42943,
            "SureId": 98,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "Halbuki onlara, Allah’a kulluk etmeleri, Hanîfler olarak O’na yürekten inanıp boyun eğmeleri, namaz kılmaları ve zekât vermeleri emredilmişti. Doğru din de işte budur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42950,
            "SureId": 98,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "Ehl-i kitap’tan ve müşriklerden hakkı inkâr edenler, içinde ebedî olarak kalacakları cehennem ateşindedirler. İşte halkın en kötüleri onlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42957,
            "SureId": 98,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "İman edip dünya ve âhiret için yararlı işler yapanlara gelince, halkın en hayırlısı da onlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42964,
            "SureId": 98,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 599,
            "AyetText": "Onların rableri katındaki ödülleri, altından ırmaklar akan, içinde devamlı kalacakları adn cennetleridir. Allah onlardan râzı olmuş, onlar da Allah’tan râzı olmuşlardır. İşte bu, rabbini sayıp O’ndan korkanlar içindir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
