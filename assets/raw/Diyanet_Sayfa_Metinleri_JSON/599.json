            "AyetText": "اِنَّٓا اَنْزَلْنَاهُ فٖی لَیْلَةِ الْقَدْرِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 97,
                "MealInfo": "Mekke döneminde inmiştir. 5 âyettir. Sûre, Kadir gecesini anlattığı için bu adıalmıştır. Kadr, azamet ve şeref demektir.",
                "SureNameTurkish": "Kadir",
                "SureNameArabic": "الْقَدْرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 25,
