    "QuranAyats": [
        {
            "Id": 16114,
            "SureId": 19,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "وَنَادَیْنَاهُ مِنْ جَانِبِ الطُّورِ الْاَیْمَنِ وَقَرَّبْنَاهُ نَجِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16121,
            "SureId": 19,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "وَوَهَبْنَا لَهُ مِنْ رَحْمَتِنَٓا اَخَاهُ هٰرُونَ نَبِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16128,
            "SureId": 19,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "وَاذْكُرْ فِی الْكِتَابِ اِسْمٰعٖیلَؗ اِنَّهُ كَانَ صَادِقَ الْوَعْدِ وَكَانَ رَسُولًا نَبِیًّاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16135,
            "SureId": 19,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "وَكَانَ یَاْمُرُ اَهْلَهُ بِالصَّلٰوةِ وَالزَّكٰوةِࣕ وَكَانَ عِنْدَ رَبِّهٖ مَرْضِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16142,
            "SureId": 19,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "وَاذْكُرْ فِی الْكِتَابِ اِدْرٖیسَؗ اِنَّهُ كَانَ صِدّٖیقًا نَبِیًّاࣗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16149,
            "SureId": 19,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "وَرَفَعْنَاهُ مَكَانًا عَلِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16156,
            "SureId": 19,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "اُو𐻾لٰٓئِكَ الَّذٖینَ اَنْعَمَ اللّٰهُ عَلَیْهِمْ مِنَ النَّبِیّٖنَ مِنْ ذُرِّیَّةِ اٰدَمَ وَمِمَّنْ حَمَلْنَا مَعَ نُوحٍؗ وَمِنْ ذُرِّیَّةِ اِبْرٰهٖیمَ وَاِسْرَٓایٖٔلَ وَمِمَّنْ هَدَیْنَا وَاجْتَبَیْنَاؕ اِذَا تُتْلٰى عَلَیْهِمْ اٰیَاتُ الرَّحْمٰنِ خَرُّوا سُجَّدًا وَبُكِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16163,
            "SureId": 19,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "فَخَلَفَ مِنْ بَعْدِهِمْ خَلْفٌ اَضَاعُوا الصَّلٰوةَ وَاتَّبَعُوا الشَّهَوَاتِ فَسَوْفَ یَلْقَوْنَ غَیًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16170,
            "SureId": 19,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "اِلَّا مَنْ تَابَ وَاٰمَنَ وَعَمِلَ صَالِحًا فَاُو𐻾لٰٓئِكَ یَدْخُلُونَ الْجَنَّةَ وَلَا یُظْلَمُونَ شَیْـًٔاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16177,
            "SureId": 19,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "جَنَّاتِ عَدْنٍࣙ الَّتٖی وَعَدَ الرَّحْمٰنُ عِبَادَهُ بِالْغَیْبِؕ اِنَّهُ كَانَ وَعْدُهُ مَاْتِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16184,
            "SureId": 19,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "لَا یَسْمَعُونَ فٖیهَا لَغْوًا اِلَّا سَلَامًاؕ وَلَهُمْ رِزْقُهُمْ فٖیهَا بُكْرَةً وَعَشِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16191,
            "SureId": 19,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "تِلْكَ الْجَنَّةُ الَّتٖی نُورِثُ مِنْ عِبَادِنَا مَنْ كَانَ تَقِیًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16198,
            "SureId": 19,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "وَمَا نَتَنَزَّلُ اِلَّا بِاَمْرِ رَبِّكَۚ لَهُ مَا بَیْنَ اَیْدٖینَا وَمَا خَلْفَنَا وَمَا بَیْنَ ذٰلِكَۚ وَمَا كَانَ رَبُّكَ نَسِیًّاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 16112,
            "SureId": 19,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "Ona Tûr’un sağ tarafından seslendik ve onu fısıldaşırcasına (kendimize) yaklaştırdık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16119,
            "SureId": 19,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "Rahmetimizin bir sonucu olmak üzere kardeşi Hârûn’u da bir peygamber olarak onun yanına verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16126,
            "SureId": 19,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "Bu kitapta İsmâil’i de okuyup an. O gerçekten sözüne sadıktı; elçi-peygamberdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16133,
            "SureId": 19,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "Halkına namazı ve zekâtı emrederdi ve rabbinin rızâsına ermişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16140,
            "SureId": 19,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "Kitapta İdrîs’i de okuyarak an. Hakikaten o, pek doğru bir insandı ve bir peygamberdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16147,
            "SureId": 19,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "Onu üstün bir konuma getirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16154,
            "SureId": 19,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "İşte bunlar, Allah’ın kendilerine lütuflarda bulunduğu, Âdem’in soyundan gelen peygamberler; Nûh ile birlikte (gemide) taşıdıklarımız, İbrâhim ve İsrâil’in (Ya‘kūb) soyundan gelenler ve doğruya ulaştırdığımız ve seçkin kıldığımız kimselerden olup, kendilerine Rahmân’ın âyetleri okunduğunda ağlayarak ve secde ederek yere kapanırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16161,
            "SureId": 19,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "Sonra bunların ardından artık namazı kılmayan ve nefsânî arzulara uyan bir nesil geldi. Bunlar elbette azgınlıklarının cezasını bulacaklardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16168,
            "SureId": 19,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60-61",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "Ancak tövbe eden, iman eden ve iyi davranışta bulunan kimseler böyle değildir. Bunlar hiçbir haksızlığa uğratılmaksızın cennete; çok esirgeyici olan Allah’ın, kullarına vaad ettiği, onların idraklerini aşan adn cennetlerine gireceklerdir. Şüphesiz O’nun vaadi yerine gelecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16175,
            "SureId": 19,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": false,
            "Page": 309,
            "AyetText": "Ancak tövbe eden, iman eden ve iyi davranışta bulunan kimseler böyle değildir. Bunlar hiçbir haksızlığa uğratılmaksızın cennete; çok esirgeyici olan Allah’ın, kullarına vaad ettiği, onların idraklerini aşan adn cennetlerine gireceklerdir. Şüphesiz O’nun vaadi yerine gelecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16182,
            "SureId": 19,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "Orada boş söz işitmezler, kendilerine yalnız esenlikler dilenir. Orada, sabah akşam rızıkları hazırdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16189,
            "SureId": 19,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "Kullarımızdan takvâ sahibi kimselere vereceğimiz cennet işte budur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16196,
            "SureId": 19,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 309,
            "AyetText": "(Melek dedi ki:) “Biz ancak rabbinin emriyle ineriz. Önümüzde, arkamızda ve bunlar arasında olan her şey O’na aittir. Senin rabbin unutkan değildir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
