{
    "PointerList": null,
    "CuzNo": 14,
    "PageNo": 273,
    "ArCuzNo": "۱٤",
    "ArPageNo": "۲۷۳",
    "QuranAyats": [
        {
            "Id": 13692,
            "SureId": 16,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "لِیَكْفُرُوا بِمَٓا اٰتَیْنَاهُمْؕ فَتَمَتَّعُواࣞ فَسَوْفَ تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
                "Cuz": 14,
                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 13699,
            "SureId": 16,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "وَیَجْعَلُونَ لِمَا لَا یَعْلَمُونَ نَصٖیبًا مِمَّا رَزَقْنَاهُمْؕ تَاللّٰهِ لَتُسْـَٔلُنَّ عَمَّا كُنْتُمْ تَفْتَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13706,
            "SureId": 16,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "وَیَجْعَلُونَ لِلّٰهِ الْبَنَاتِ سُبْحَانَهُۙ وَلَهُمْ مَا یَشْتَهُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13713,
            "SureId": 16,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "وَاِذَا بُشِّرَ اَحَدُهُمْ بِالْاُنْثٰى ظَلَّ وَجْهُهُ مُسْوَدًّا وَهُوَ كَظٖیمٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13720,
            "SureId": 16,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "یَتَوَارٰى مِنَ الْقَوْمِ مِنْ سُٓوءِ مَا بُشِّرَ بِهٖؕ اَیُمْسِكُهُ عَلٰى هُونٍ اَمْ یَدُسُّهُ فِی التُّرَابِؕ اَلَا سَٓاءَ مَا یَحْكُمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13727,
            "SureId": 16,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "لِلَّذٖینَ لَا یُؤْمِنُونَ بِالْاٰخِرَةِ مَثَلُ السَّوْءِۚ وَلِلّٰهِ الْمَثَلُ الْاَعْلٰىؕ وَهُوَ الْعَزٖیزُ الْحَكٖیمُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13734,
            "SureId": 16,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "وَلَوْ یُؤَاخِذُ اللّٰهُ النَّاسَ بِظُلْمِهِمْ مَا تَرَكَ عَلَیْهَا مِنْ دَٓابَّةٍ وَلٰكِنْ یُؤَخِّرُهُمْ اِلٰٓى اَجَلٍ مُسَمًّىۚ فَاِذَا جَٓاءَ اَجَلُهُمْ لَا یَسْتَاْخِرُونَ سَاعَةً وَلَا یَسْتَقْدِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13741,
            "SureId": 16,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "وَیَجْعَلُونَ لِلّٰهِ مَا یَكْرَهُونَ وَتَصِفُ اَلْسِنَتُهُمُ الْكَذِبَ اَنَّ لَهُمُ الْحُسْنٰىؕ لَا جَرَمَ اَنَّ لَهُمُ النَّارَ وَاَنَّهُمْ مُفْرَطُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13748,
            "SureId": 16,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "تَاللّٰهِ لَقَدْ اَرْسَلْنَٓا اِلٰٓى اُمَمٍ مِنْ قَبْلِكَ فَزَیَّنَ لَهُمُ الشَّیْطَانُ اَعْمَالَهُمْ فَهُوَ وَلِیُّهُمُ الْیَوْمَ وَلَهُمْ عَذَابٌ اَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13755,
            "SureId": 16,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "وَمَٓا اَنْزَلْنَا عَلَیْكَ الْكِتَابَ اِلَّا لِتُبَیِّنَ لَهُمُ الَّذِی اخْتَلَفُوا فٖیهِۙ وَهُدًى وَرَحْمَةً لِقَوْمٍ یُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 13690,
            "SureId": 16,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "Kendilerine verdiklerimize karşı nankörlük etmek için (böyle yaparlar). Yiyip için bakalım, ama yakında anlayacaksınız!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
                "Cuz": 14,
                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 13697,
            "SureId": 16,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "Onlar, kendilerine rızık olarak verdiklerimizden, bilmedikleri şeylere de bir pay ayırırlar. Allah’a yemin olsun ki böyle kendi uydurduğunuz putlardan dolayı mutlaka sorguya çekileceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13704,
            "SureId": 16,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "Yine onlar -hâşâ- “Kızlar Allah’ındır” diyorlar. Akıllarınca beğendikleri de kendilerinin oluyor!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13711,
            "SureId": 16,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "Onlardan birine bir kız müjdelendiğinde, öfkelenerek yüzü mosmor kesilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13718,
            "SureId": 16,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "(Aklınca) verilen müjdenin kötülüğünden dolayı halktan gizlenir. Böyle bir alçaltıcı duruma rağmen onu yanında mı tutsun yoksa toprağa mı gömsün! Görün işte, ne kötü yargıda bulunuyorlar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13725,
            "SureId": 16,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "Âhirete inanmayanlar kötü sıfatlarla anılır; Allah’a ise en yüce sıfatlar yaraşır. O azîzdir, hakîmdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13732,
            "SureId": 16,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "Eğer Allah insanları haksızlıkları yüzünden hemen cezalandıracak olsaydı yeryüzünde hiçbir canlı bırakmazdı. Fakat onlara belirlenmiş bir sürenin sonuna kadar mühlet tanıyor. Ama süreleri dolduğunda onu bir an bile ne erteleyebilirler ne de öne alabilirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13739,
            "SureId": 16,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "Hoşlanmadıkları şeyleri Allah’a nisbet ediyorlar. Öte yandan en güzel sonucun kendileri için olacağı yolunda dillerinden asılsız iddialar dökülüyor. Kaçınılmaz olarak onlara ancak ateş vardır ve onlar oraya sürüleceklerdir!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13746,
            "SureId": 16,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "Allah’a andolsun, senden önceki çeşitli topluluklara da mutlaka elçiler göndermiştik; fakat şeytan onlara yaptıklarını allayıp pulladı. Bugün de şeytan öylelerinin velîsidir. Onlar için dehşetli bir azap vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13753,
            "SureId": 16,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 273,
            "AyetText": "Sana kitabı, özellikle ayrılığa düştükleri konuda onları aydınlatman için ve inanan bir topluluğa rehber ve rahmet olsun diye indirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Nahl",
    "QuranSureLabel": "النَّحْلِ",
    "EndPageSure": null
}