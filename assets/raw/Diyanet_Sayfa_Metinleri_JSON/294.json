{
    "PointerList": null,
    "CuzNo": 15,
    "PageNo": 294,
    "ArCuzNo": "۱٥",
    "ArPageNo": "۲۹٤",
    "QuranAyats": [
        {
            "Id": 15015,
            "SureId": 18,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "مَا لَهُمْ بِهٖ مِنْ عِلْمٍ وَلَا لِاٰبَٓائِهِمْؕ كَبُرَتْ كَلِمَةً تَخْرُجُ مِنْ اَفْوَاهِهِمْؕ اِنْ یَقُولُونَ اِلَّا كَذِبًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 18,
                "MealInfo": "Mekke döneminde inmiştir. 28. âyetin Medine döneminde indiği de rivayet edilmiştir. 110 âyettir. Sûre, adını; ilk defa dokuzuncu âyette olmak üzere,birkaç yerde geçen <b>“kehf ”</b> kelimesinden almıştır.<b> Kehf, mağara demektir</b>. Sûre de temel konu olarak, inançları sebebiyle öldürülmekten kurtulmak için bir mağaraya sığınan gençlerin mucizevî hâlleri, ayrıca <b>Hz. Mûsâ</b> ile <b>Zülkarneyn&nbsp;</b>konu edilmektedir.",
                "SureNameTurkish": "Kehf",
                "SureNameArabic": "الْكَهْفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 69,
                "AyetCount": 110,
                "Cuz": 15,
                "FirstPage": 293,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 15022,
            "SureId": 18,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "فَلَعَلَّكَ بَاخِعٌ نَفْسَكَ عَلٰٓى اٰثَارِهِمْ اِنْ لَمْ یُؤْمِنُوا بِهٰذَا الْحَدٖیثِ اَسَفًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15029,
            "SureId": 18,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "اِنَّا جَعَلْنَا مَا عَلَى الْاَرْضِ زٖینَةً لَهَا لِنَبْلُوَهُمْ اَیُّهُمْ اَحْسَنُ عَمَلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15036,
            "SureId": 18,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "وَاِنَّا لَجَاعِلُونَ مَا عَلَیْهَا صَعٖیدًا جُرُزًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15043,
            "SureId": 18,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "اَمْ حَسِبْتَ اَنَّ اَصْحَابَ الْكَهْفِ وَالرَّقٖیمِ كَانُوا مِنْ اٰیَاتِنَا عَجَبًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15050,
            "SureId": 18,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "اِذْ اَوَى الْفِتْیَةُ اِلَى الْكَهْفِ فَقَالُوا رَبَّنَٓا اٰتِنَا مِنْ لَدُنْكَ رَحْمَةً وَهَیِّئْ لَنَا مِنْ اَمْرِنَا رَشَدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15057,
            "SureId": 18,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "فَضَرَبْنَا عَلٰٓى اٰذَانِهِمْ فِی الْكَهْفِ سِنٖینَ عَدَدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15064,
            "SureId": 18,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "ثُمَّ بَعَثْنَاهُمْ لِنَعْلَمَ اَیُّ الْحِزْبَیْنِ اَحْصٰى لِمَا لَبِثُٓوا اَمَدًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15071,
            "SureId": 18,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "نَحْنُ نَقُصُّ عَلَیْكَ نَبَاَهُمْ بِالْحَقِّؕ اِنَّهُمْ فِتْیَةٌ اٰمَنُوا بِرَبِّهِمْ وَزِدْنَاهُمْ هُدًىࣗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15078,
            "SureId": 18,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "وَرَبَطْنَا عَلٰى قُلُوبِهِمْ اِذْ قَامُوا فَقَالُوا رَبُّنَا رَبُّ السَّمٰوَاتِ وَالْاَرْضِ لَنْ نَدْعُوَ𐻾ا مِنْ دُونِهٖٓ اِلٰهًا لَقَدْ قُلْنَٓا اِذًا شَطَطًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15085,
            "SureId": 18,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "هٰٓؤُ𐻾لَٓاءِ قَوْمُنَا اتَّخَذُوا مِنْ دُونِهٖٓ اٰلِهَةًؕ لَوْلَا یَاْتُونَ عَلَیْهِمْ بِسُلْطَانٍ بَیِّنٍؕ فَمَنْ اَظْلَمُ مِمَّنِ افْتَرٰى عَلَى اللّٰهِ كَذِبًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 15013,
            "SureId": 18,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "Bu konuda ne onların ne de atalarının bir bilgisi var. Ağızlarından çıkan bu söz ne kadar çirkin! Yalandan başka bir şey söylemiyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 18,
                "MealInfo": "Mekke döneminde inmiştir. 28. âyetin Medine döneminde indiği de rivayet edilmiştir. 110 âyettir. Sûre, adını; ilk defa dokuzuncu âyette olmak üzere,birkaç yerde geçen <b>“kehf ”</b> kelimesinden almıştır.<b> Kehf, mağara demektir</b>. Sûre de temel konu olarak, inançları sebebiyle öldürülmekten kurtulmak için bir mağaraya sığınan gençlerin mucizevî hâlleri, ayrıca <b>Hz. Mûsâ</b> ile <b>Zülkarneyn&nbsp;</b>konu edilmektedir.",
                "SureNameTurkish": "Kehf",
                "SureNameArabic": "الْكَهْفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 69,
                "AyetCount": 110,
                "Cuz": 15,
                "FirstPage": 293,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 15020,
            "SureId": 18,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "Durum böyleyken bu son kitaba inanmazlarsa arkalarından üzülerek neredeyse kendini helâk edeceksin!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15027,
            "SureId": 18,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "Biz, kimlerin daha güzel amel edeceğini deneyelim diye yeryüzündeki her şeyi oranın süsü yaptık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15034,
            "SureId": 18,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "Ve biz oradaki her şeyi mutlaka kupkuru bir toprak yapacağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15041,
            "SureId": 18,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "Yoksa sen, bizim âyetlerimizden olan Ashâb-ı Kehf ve Rakīm’i mi şaşırtıcı buldun?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15048,
            "SureId": 18,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "O gençler mağaraya sığınmışlar ve “Rabbimiz! Bize katından rahmet gönder ve bize içinde bulunduğumuz durumdan bir çıkış yolu göster!” demişlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15055,
            "SureId": 18,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "Bunun üzerine biz de onları o mağarada yıllarca derin bir uykuya daldırdık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15062,
            "SureId": 18,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "Sonra da iki gruptan hangisinin, kaldıkları müddeti daha iyi hesap edip değerlendireceğini ortaya koyalım diye onları uyandırdık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15069,
            "SureId": 18,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "Biz sana onların başından geçenleri gerçeğe uygun olarak anlatıyoruz. Hakikaten onlar rablerine inanmış gençlerdi; biz de onların doğru yolda yürüyüşlerine katkıda bulunduk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15076,
            "SureId": 18,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "(Haksızların karşısında) ayağa kalkıp şöyle derken onların yüreklerini güçlendirdik: “Bizim rabbimiz, göklerin ve yerin rabbidir; O’ndan başkasına asla tanrı deyip yakarmayız. Yoksa kesinlikle yanlış bir şey dillendirmiş oluruz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15083,
            "SureId": 18,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 294,
            "AyetText": "Şu bizim kavmimiz Allah’tan başka tanrılar edindiler. Onların tanrı olduğuna dair açık bir delil getirseler ya! Allah hakkında yalan uydurandan daha zalim kim olabilir!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Kehf",
    "QuranSureLabel": "الْكَهْفِ",
    "EndPageSure": null
}