            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "وَتَحْمِلُ اَثْقَالَكُمْ اِلٰى بَلَدٍ لَمْ تَكُونُوا بَالِغٖیهِ اِلَّا بِشِقِّ الْاَنْفُسِؕ اِنَّ رَبَّكُمْ لَرَؤُ𐻿فٌ رَحٖیمٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
                "Cuz": 14,
                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 13363,
            "SureId": 16,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "وَالْخَیْلَ وَالْبِغَالَ وَالْحَمٖیرَ لِتَرْكَبُوهَا وَزٖینَةًؕ وَیَخْلُقُ مَا لَا تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13370,
            "SureId": 16,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "وَعَلَى اللّٰهِ قَصْدُ السَّبٖیلِ وَمِنْهَا جَٓائِرٌؕ وَلَوْ شَٓاءَ لَهَدٰیكُمْ اَجْمَعٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13377,
            "SureId": 16,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "هُوَ الَّذٖٓی اَنْزَلَ مِنَ السَّمَٓاءِ مَٓاءً لَكُمْ مِنْهُ شَرَابٌ وَمِنْهُ شَجَرٌ فٖیهِ تُسٖیمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13384,
            "SureId": 16,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "یُنْبِتُ لَكُمْ بِهِ الزَّرْعَ وَالزَّیْتُونَ وَالنَّخٖیلَ وَالْاَعْنَابَ وَمِنْ كُلِّ الثَّمَرَاتِؕ اِنَّ فٖی ذٰلِكَ لَاٰیَةً لِقَوْمٍ یَتَفَكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13391,
            "SureId": 16,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "وَسَخَّرَ لَكُمُ الَّیْلَ وَالنَّهَارَۙ وَالشَّمْسَ وَالْقَمَرَؕ وَالنُّجُومُ مُسَخَّرَاتٌ بِاَمْرِهٖؕ اِنَّ فٖی ذٰلِكَ لَاٰیَاتٍ لِقَوْمٍ یَعْقِلُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13398,
            "SureId": 16,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "وَمَا ذَرَاَ لَكُمْ فِی الْاَرْضِ مُخْتَلِفًا اَلْوَانُهُؕ اِنَّ فٖی ذٰلِكَ لَاٰیَةً لِقَوْمٍ یَذَّكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13405,
            "SureId": 16,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "وَهُوَ الَّذٖی سَخَّرَ الْبَحْرَ لِتَاْكُلُوا مِنْهُ لَحْمًا طَرِیًّا وَتَسْتَخْرِجُوا مِنْهُ حِلْیَةً تَلْبَسُونَهَاۚ وَتَرَى الْفُلْكَ مَوَاخِرَ فٖیهِ وَلِتَبْتَغُوا مِنْ فَضْلِهٖ وَلَعَلَّكُمْ تَشْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 13354,
            "SureId": 16,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "Bu hayvanlar ancak kendinizi fazlasıyla yorarak ulaşabileceğiniz bir beldeye yüklerinizi taşır. Kuşkusuz rabbiniz çok şefkatli, çok merhametlidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
                "Cuz": 14,
                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 13361,
            "SureId": 16,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "Binmeniz ve güzelliğini seyretmeniz için atları, katırları, eşekleri de yarattı. O, sizin bilmediğiniz başka şeyler de yaratır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13368,
            "SureId": 16,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "Doğru yol Allah’a aittir. Yolun eğrisi de vardır. Allah dileseydi hepinizi doğru yola iletirdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13375,
            "SureId": 16,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "Gökten su indiren O’dur. Ondan hem kendiniz için içecek su hem de hayvanlarınıza yedireceğiniz bitkiler verir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13382,
            "SureId": 16,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "Allah o su ile size ekin, zeytin, hurma, üzüm ve daha türlü türlü ürünler de bitirir. İşte bunda düşünen bir topluluk için büyük ibret vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13389,
            "SureId": 16,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "O, geceyle gündüzü, ayla güneşi hizmetinize verdi; yıldızlar da O’nun emrine boyun eğmişlerdir. Bunda aklını kullanan bir topluluk için önemli ibretler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13396,
            "SureId": 16,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "Sizin için yerden türlü renklerde bitirdiği şeyler de böyle; bunda da düşünüp taşınan bir topluluk için büyük ibret vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13403,
            "SureId": 16,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 268,
            "AyetText": "Taze etinden yemeniz ve mücevherini çıkarıp takınmanız için denizi hizmetinize veren de O’dur. Gemilerin denizi yararak gittiklerini görürsün ki, bu da O’nun lütfuna nâil olmanız ve O’na şükretmeniz içindir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Nahl",
    "QuranSureLabel": "النَّحْلِ",
