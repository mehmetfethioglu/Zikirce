        {
            "Id": 2324,
            "SureId": 3,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "فَنَادَتْهُ الْمَلٰٓئِكَةُ وَهُوَ قَٓائِمٌ یُصَلّٖی فِی الْمِحْرَابِۙ اَنَّ اللّٰهَ یُبَشِّرُكَ بِیَحْیٰى مُصَدِّقًا بِكَلِمَةٍ مِنَ اللّٰهِ وَسَیِّدًا وَحَصُورًا وَنَبِیًّا مِنَ الصَّالِحٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2331,
            "SureId": 3,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "قَالَ رَبِّ اَنّٰى یَكُونُ لٖی غُلَامٌ وَقَدْ بَلَغَنِیَ الْكِبَرُ وَامْرَاَتٖی عَاقِرٌؕ قَالَ كَذٰلِكَ اللّٰهُ یَفْعَلُ مَا یَشَٓاءُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2338,
            "SureId": 3,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "قَالَ رَبِّ اجْعَلْ لٖٓی اٰیَةًؕ قَالَ اٰیَتُكَ اَلَّا تُكَلِّمَ النَّاسَ ثَلٰثَةَ اَیَّامٍ اِلَّا رَمْزًاؕ وَاذْكُرْ رَبَّكَ كَثٖیرًا وَسَبِّحْ بِالْعَشِیِّ وَالْاِبْكَارِࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2345,
            "SureId": 3,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "وَاِذْ قَالَتِ الْمَلٰٓئِكَةُ یَا مَرْیَمُ اِنَّ اللّٰهَ اصْطَفٰیكِ وَطَهَّرَكِ وَاصْطَفٰیكِ عَلٰى نِسَٓاءِ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2352,
            "SureId": 3,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "یَا مَرْیَمُ اقْنُتٖی لِرَبِّكِ وَاسْجُدٖی وَارْكَعٖی مَعَ الرَّاكِعٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2359,
            "SureId": 3,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "ذٰلِكَ مِنْ اَنْبَٓاءِ الْغَیْبِ نُوحٖیهِ اِلَیْكَؕ وَمَا كُنْتَ لَدَیْهِمْ اِذْ یُلْقُونَ اَقْلَامَهُمْ اَیُّهُمْ یَكْفُلُ مَرْیَمَࣕ وَمَا كُنْتَ لَدَیْهِمْ اِذْ یَخْتَصِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2366,
            "SureId": 3,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "اِذْ قَالَتِ الْمَلٰٓئِكَةُ یَا مَرْیَمُ اِنَّ اللّٰهَ یُبَشِّرُكِ بِكَلِمَةٍ مِنْهُࣗ اِسْمُهُ الْمَسٖیحُ عٖیسَى ابْنُ مَرْیَمَ وَجٖیهًا فِی الدُّنْیَا وَالْاٰخِرَةِ وَمِنَ الْمُقَرَّبٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 2315,
            "SureId": 3,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "Orada Zekeriyyâ rabbine dua edip dedi ki: “Rabbim! Bana tarafından temiz bir nesil ihsan eyle! Kuşkusuz sen duayı işitmektesin.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 2322,
            "SureId": 3,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "O mâbedde durmuş namaz kılarken melekler ona şöyle seslendiler: “Allah’ın bir kelimesini (Hz. İsâ’yı) tasdik edici, efendi, iffetli ve sâlih kullardan bir peygamber olarak Yahyâ’yı Allah sana müjdeliyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2329,
            "SureId": 3,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "Zekeriyyâ ise şöyle dedi: “Rabbim! Bana ihtiyarlık gelip çattığı, üstelik karım da kısır olduğu halde benim nasıl oğlum olabilir?” Buyurdu ki: “İşte böyle; Allah dilediğini yapar.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2336,
            "SureId": 3,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "“Rabbim, dedi, bana bir alâmet göster.” Şöyle buyurdu: “Senin için alâmet insanlara üç gün ancak işaretle konuşmandır. Rabbini çok an, sabah akşam tesbih et.”",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2343,
            "SureId": 3,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "Melekler şöyle demişti: “Ey Meryem! Allah seni seçti, seni tertemiz kıldı ve seni bütün dünyadaki kadınlara üstün eyledi.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2350,
            "SureId": 3,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "Ey Meryem! Rabbine ibadet et; secdeye kapan, huzurunda eğilenlerle beraber sen de eğil.”",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2357,
            "SureId": 3,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "Bunlar sana vahiy yoluyla bildirmekte olduğumuz gayb haberlerindendir. İçlerinden hangisi Meryem’i himayesine alacak diye kura çekmek üzere kalemlerini atarlarken sen onların yanında değildin; onlar tartışırken de sen yanlarında değildin.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2364,
            "SureId": 3,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 55,
            "AyetText": "Melekler demişti ki: “Ey Meryem! Allah seni kendisinden bir kelime ile müjdeliyor. Adı Meryem oğlu Îsâ Mesîh’tir, dünyada da âhirette de itibarlı ve (Allah’a) yakın kılınanlardandır.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
