    "QuranAyats": [
        {
            "Id": 11662,
            "SureId": 12,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "فَلَمَّا جَهَّزَهُمْ بِجَهَازِهِمْ جَعَلَ السِّقَایَةَ فٖی رَحْلِ اَخٖیهِ ثُمَّ اَذَّنَ مُؤَذِّنٌ اَیَّتُهَا الْعٖیرُ اِنَّكُمْ لَسَارِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 12,
                "MealInfo": "Mekke döneminde inmiştir. 111 âyettir. Bu sûrede Yûsuf Peygamberin hayatta karşılaştığı sıkıntılar ve bunlara sabrederek nasıl başarıya ulaştığı anlatılmakta ve inananlar için faydalı öğütler, önemli mesajlar verilmektedir. Kur’an’da baştan sona kadar bir tek konuyu anlatan tek sûre budur.",
                "SureNameTurkish": "Yûsuf",
                "SureNameArabic": "يُوسُفَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 53,
                "AyetCount": 111,
                "Cuz": 12,
                "FirstPage": 235,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11669,
            "SureId": 12,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "قَالُوا وَاَقْبَلُوا عَلَیْهِمْ مَاذَا تَفْقِدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11676,
            "SureId": 12,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "قَالُوا نَفْقِدُ صُوَاعَ الْمَلِكِ وَلِمَنْ جَٓاءَ بِهٖ حِمْلُ بَعٖیرٍ وَاَنَا𐻾 بِهٖ زَعٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11683,
            "SureId": 12,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "قَالُوا تَاللّٰهِ لَقَدْ عَلِمْتُمْ مَا جِئْنَا لِنُفْسِدَ فِی الْاَرْضِ وَمَا كُنَّا سَارِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11690,
            "SureId": 12,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "قَالُوا فَمَا جَزَٓاؤُ𐻾هُٓ اِنْ كُنْتُمْ كَاذِبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11697,
            "SureId": 12,
            "AyetId": 75,
            "LanguageId": 7,
            "AyetNumber": "٧٥",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "قَالُوا جَزَٓاؤُ𐻾هُ مَنْ وُجِدَ فٖی رَحْلِهٖ فَهُوَ جَزَٓاؤُ𐻾هُؕ كَذٰلِكَ نَجْزِی الظَّالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11704,
            "SureId": 12,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "فَبَدَاَ بِاَوْعِیَتِهِمْ قَبْلَ وِعَٓاءِ اَخٖیهِ ثُمَّ اسْتَخْرَجَهَا مِنْ وِعَٓاءِ اَخٖیهِؕ كَذٰلِكَ كِدْنَا لِیُوسُفَؕ مَا كَانَ لِیَاْخُذَ اَخَاهُ فٖی دٖینِ الْمَلِكِ اِلَّٓا اَنْ یَشَٓاءَ اللّٰهُؕ نَرْفَعُ دَرَجَاتٍ مَنْ نَشَٓاءُؕ وَفَوْقَ كُلِّ ذٖی عِلْمٍ عَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11711,
            "SureId": 12,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "قَالُٓوا اِنْ یَسْرِقْ فَقَدْ سَرَقَ اَخٌ لَهُ مِنْ قَبْلُۚ فَاَسَرَّهَا یُوسُفُ فٖی نَفْسِهٖ وَلَمْ یُبْدِهَا لَهُمْ قَالَ اَنْتُمْ شَرٌّ مَكَانًاۚ وَاللّٰهُ اَعْلَمُ بِمَا تَصِفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11718,
            "SureId": 12,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "قَالُوا یَٓا اَیُّهَا الْعَزٖیزُ اِنَّ لَهُٓ اَبًا شَیْخًا كَبٖیرًا فَخُذْ اَحَدَنَا مَكَانَهُۚ اِنَّا نَرٰیكَ مِنَ الْمُحْسِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 11660,
            "SureId": 12,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "Yûsuf, onlara yüklerini hazırlattığı zaman (saraya ait bir) su kabını kardeşinin yükü içine koydurdu. Sonra bir görevli, “Ey kafile! Siz kesinlikle hırsızsınız!” diye bağırdı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 12,
                "MealInfo": "Mekke döneminde inmiştir. 111 âyettir. Bu sûrede Yûsuf Peygamberin hayatta karşılaştığı sıkıntılar ve bunlara sabrederek nasıl başarıya ulaştığı anlatılmakta ve inananlar için faydalı öğütler, önemli mesajlar verilmektedir. Kur’an’da baştan sona kadar bir tek konuyu anlatan tek sûre budur.",
                "SureNameTurkish": "Yûsuf",
                "SureNameArabic": "يُوسُفَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 53,
                "AyetCount": 111,
                "Cuz": 12,
                "FirstPage": 235,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11667,
            "SureId": 12,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "Kardeşleri onlara dönerek, “Ne arıyorsunuz?” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11674,
            "SureId": 12,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "“Kralın su kabını arıyoruz; onu getirene bir deve yükü (bahşiş) var” diye cevap verdiler. (İçlerinden biri) “Ben bu söze kefilim” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11681,
            "SureId": 12,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "Onlar, “Allah’a andolsun ki bizim bu yerde fesat çıkarmak için gelmediğimizi siz de biliyorsunuz, biz hırsız da değiliz” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11688,
            "SureId": 12,
            "AyetId": 74,
            "LanguageId": 5,
            "AyetNumber": "74",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "(Görevliler), “Peki, yalan söylüyorsanız (sizde) bunun cezası nedir?” diye sordular.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11695,
            "SureId": 12,
            "AyetId": 75,
            "LanguageId": 5,
            "AyetNumber": "75",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "“Onun cezası, kayıp eşya kimin yükünde bulunursa onun buna karşılık alıkonulmasıdır. Biz zalimleri böyle cezalandırırız” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11702,
            "SureId": 12,
            "AyetId": 76,
            "LanguageId": 5,
            "AyetNumber": "76",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "Bunun üzerine Yûsuf, kardeşinin yükünden önce onların yüklerini aramaya başladı. Sonra da su kabını kardeşinin yükünden çıkardı. İşte biz Yûsuf’a böyle bir tedbiri öğrettik, yoksa Allah dileyip bunu öğretmeseydi kralın kanununa göre kardeşini alıkoyamazdı. Biz dilediğimizi derecelerle yükseltiriz. Her bilenin üstünde daha çok bilen biri vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11709,
            "SureId": 12,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "Dediler ki: “Eğer o çaldıysa, daha önce onun kardeşi de çalmıştı.” Yûsuf onlara belli etmeksizin içinden şunları geçirdi: “Asıl sizin durumunuz kötü! Allah, sizin suçladığınız hususu çok iyi bilmektedir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11716,
            "SureId": 12,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78",
            "AyetVisible": true,
            "Page": 244,
            "AyetText": "Dediler ki: “Efendimiz! Gerçekten onun çok yaşlı bir babası var. Onun yerine içimizden birini alıkoy. Şüphesiz biz seni iyilik sever biri olarak görüyoruz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Yûsuf",
    "QuranSureLabel": "يُوسُفَ",
    "EndPageSure": null
}