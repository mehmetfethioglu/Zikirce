            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 440,
            "AyetText": "وَالْقُرْاٰنِ الْحَكٖیمِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
