            "SureId": 74,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": false,
            "Page": 575,
            "AyetText": "Önüne nimetleri serdikçe serdiğim, arkasından daha fazla vermemi bekleyen kişiyi!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
