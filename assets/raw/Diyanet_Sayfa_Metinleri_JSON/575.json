            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "Ey örtüsüne bürünen!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
