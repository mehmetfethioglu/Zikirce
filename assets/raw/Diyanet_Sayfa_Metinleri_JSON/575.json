            }
        },
        {
            "Id": 38477,
            "SureId": 74,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "Kalk ve uyar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38484,
            "SureId": 74,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "Sadece rabbinin büyüklüğünü dile getir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38491,
            "SureId": 74,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "Elbiseni tertemiz tut.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38498,
            "SureId": 74,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "Her türlü pislikten uzak dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38505,
            "SureId": 74,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "Yaptığın iyiliği çok görerek başa kakma.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38512,
            "SureId": 74,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "Rabbinin rızâsına ermek için sabret.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38519,
            "SureId": 74,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "Sûra üflendiği zaman;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38526,
            "SureId": 74,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "İşte o gün zorlu bir gündür;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38533,
            "SureId": 74,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "İnkârcılar için hiç de kolay olmayan bir gündür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38540,
            "SureId": 74,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "Yarattığım o şahsı (cezalandırmak üzere) tek başına bana bırak!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38547,
            "SureId": 74,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12-13",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "Kendisine geniş bir servet ve gözü önünde duran oğullar verdiğim;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38554,
            "SureId": 74,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": false,
            "Page": 575,
            "AyetText": "Kendisine geniş bir servet ve gözü önünde duran oğullar verdiğim;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38561,
            "SureId": 74,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14-15",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "Önüne nimetleri serdikçe serdiğim, arkasından daha fazla vermemi bekleyen kişiyi!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
