            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "یَٓا اَیُّهَا الْمُدَّثِّرُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 74,
                "MealInfo": "Mekke döneminde inmiştir. 56 âyettir. Sûre, adını birinci âyette geçen “elMüddessir”kelimesinden almıştır. Müddessir, tıpkı bir önceki sûrenin adıolan müzzemmil gibi, örtünüp bürünen demektir. Sûrede başlıca, Hz. Peygamberintebliğ ve davetle görevlendirilmesi, müşriklerin ona karşı çıkmasıve onların cehennemle uyarılması konu edilmektedir.",
                "SureNameTurkish": "Müddessir",
                "SureNameArabic": "الْمُدَّثِّرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 4,
                "AyetCount": 56,
                "Cuz": 29,
                "FirstPage": 575,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 38479,
            "SureId": 74,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "قُمْ فَاَنْذِرْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38486,
            "SureId": 74,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "وَرَبَّكَ فَكَبِّرْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38493,
            "SureId": 74,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "وَثِیَابَكَ فَطَهِّرْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38500,
            "SureId": 74,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "وَالرُّجْزَ فَاهْجُرْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38507,
            "SureId": 74,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "وَلَا تَمْنُنْ تَسْتَكْثِرُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38514,
            "SureId": 74,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "وَلِرَبِّكَ فَاصْبِرْؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38521,
            "SureId": 74,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "فَاِذَا نُقِرَ فِی النَّاقُورِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38528,
            "SureId": 74,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "فَذٰلِكَ یَوْمَئِذٍ یَوْمٌ عَسٖیرٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38535,
            "SureId": 74,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "عَلَى الْكَافِرٖینَ غَیْرُ یَسٖیرٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38542,
            "SureId": 74,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "ذَرْنٖی وَمَنْ خَلَقْتُ وَحٖیدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38549,
            "SureId": 74,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "وَجَعَلْتُ لَهُ مَالًا مَمْدُودًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38556,
            "SureId": 74,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "وَبَنٖینَ شُهُودًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38563,
            "SureId": 74,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "وَمَهَّدْتُ لَهُ تَمْهٖیدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38570,
            "SureId": 74,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "ثُمَّ یَطْمَعُ اَنْ اَزٖیدَࣗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38577,
            "SureId": 74,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "كَلَّاؕ اِنَّهُ كَانَ لِاٰیَاتِنَا عَنٖیدًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38584,
            "SureId": 74,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "سَاُرْهِقُهُ صَعُودًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 38463,
            "SureId": 73,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "Senin, gecenin üçte ikisine yakın kısmını, yarısını, üçte birini ibadetle geçirdiğini ve beraberinde bulunanlardan bir grubun da (böyle yaptığını) rabbin elbette bilir. Gece ve gündüzü belirleyen ancak Allah’tır. O, sizin (istenen) vakti tesbit edemeyeceğinizi bilmektedir. Bu yüzden de sizi bağışlamıştır. Artık Kur’an’dan kolayınıza geleni okuyun. Allah bilmektedir ki içinizde hastalar bulunacak, bir kısmınız Allah’ın lutfundan rızık aramak üzere yeryüzünde yol tepecek, diğerleri de Allah yolunda çarpışacaktır. O halde Kur’an’dan kolayınıza geleni okuyun. Namazı kılın, zekâtı ödeyin, Allah’a güzel bir borç verin. Kendiniz için önceden ne iyilik hazırlarsanız Allah katında onu bulursunuz; işte bu daha iyidir ve mükâfatı daha büyüktür. Allah’tan bağışlanmayı dileyin, şüphesiz Allah çok bağışlayıcı çok esirgeyicidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 73,
                "MealInfo": "Mekke döneminde inmiştir. 20 âyettir. Sûre, adını birinci âyette geçen “elMüzzemmil”kelimesinden almıştır. Müzzemmil, örtünüp bürünen demektir.Sûrede başlıca, Hz. Peygamberin ibadet ve taat hayatı konu edilmiştir.",
                "SureNameTurkish": "Müzzemmil",
                "SureNameArabic": "الْمُزَّمِّلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 3,
                "AyetCount": 20,
                "Cuz": 29,
                "FirstPage": 574,
                "ExcludeMenu": false
            }
        },
        {
