    "QuranAyats": [
        {
            "Id": 38465,
            "SureId": 73,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 575,
            "AyetText": "اِنَّ رَبَّكَ یَعْلَمُ اَنَّكَ تَقُومُ اَدْنٰى مِنْ ثُلُثَیِ الَّیْلِ وَنِصْفَهُ وَثُلُثَهُ وَطَٓائِفَةٌ مِنَ الَّذٖینَ مَعَكَؕ وَاللّٰهُ یُقَدِّرُ الَّیْلَ وَالنَّهَارَؕ عَلِمَ اَنْ لَنْ تُحْصُوهُ فَتَابَ عَلَیْكُمْ فَاقْرَؤُ𐻿ا مَا تَیَسَّرَ مِنَ الْقُرْاٰنِؕ عَلِمَ اَنْ سَیَكُونُ مِنْكُمْ مَرْضٰىۙ وَاٰخَرُونَ یَضْرِبُونَ فِی الْاَرْضِ یَبْتَغُونَ مِنْ فَضْلِ اللّٰهِۙ وَاٰخَرُونَ یُقَاتِلُونَ فٖی سَبٖیلِ اللّٰهِؗ فَاقْرَؤُ𐻿ا مَا تَیَسَّرَ مِنْهُۙ وَاَقٖیمُوا الصَّلٰوةَ وَاٰتُوا الزَّكٰوةَ وَاَقْرِضُوا اللّٰهَ قَرْضًا حَسَنًاؕ وَمَا تُقَدِّمُوا لِاَنْفُسِكُمْ مِنْ خَیْرٍ تَجِدُوهُ عِنْدَ اللّٰهِ هُوَ خَیْرًا وَاَعْظَمَ اَجْرًاؕ وَاسْتَغْفِرُوا اللّٰهَؕ اِنَّ اللّٰهَ غَفُورٌ رَحٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
