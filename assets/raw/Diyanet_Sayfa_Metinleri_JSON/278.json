    "QuranAyats": [
        {
            "Id": 13965,
            "SureId": 16,
            "AyetId": 94,
            "LanguageId": 7,
            "AyetNumber": "٩٤",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "وَلَا تَتَّخِذُٓوا اَیْمَانَكُمْ دَخَلًا بَیْنَكُمْ فَتَزِلَّ قَدَمٌ بَعْدَ ثُبُوتِهَا وَتَذُوقُوا السُّٓوءَ بِمَا صَدَدْتُمْ عَنْ سَبٖیلِ اللّٰهِۚ وَلَكُمْ عَذَابٌ عَظٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
                "Cuz": 14,
                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 13972,
            "SureId": 16,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "وَلَا تَشْتَرُوا بِعَهْدِ اللّٰهِ ثَمَنًا قَلٖیلًاؕ اِنَّمَا عِنْدَ اللّٰهِ هُوَ خَیْرٌ لَكُمْ اِنْ كُنْتُمْ تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13979,
            "SureId": 16,
            "AyetId": 96,
            "LanguageId": 7,
            "AyetNumber": "٩٦",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "مَا عِنْدَكُمْ یَنْفَدُ وَمَا عِنْدَ اللّٰهِ بَاقٍؕ وَلَنَجْزِیَنَّ الَّذٖینَ صَبَرُٓوا اَجْرَهُمْ بِاَحْسَنِ مَا كَانُوا یَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13986,
            "SureId": 16,
            "AyetId": 97,
            "LanguageId": 7,
            "AyetNumber": "٩٧",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "مَنْ عَمِلَ صَالِحًا مِنْ ذَكَرٍ اَوْ اُنْثٰى وَهُوَ مُؤْمِنٌ فَلَنُحْیِیَنَّهُ حَیٰوةً طَیِّبَةًۚ وَلَنَجْزِیَنَّهُمْ اَجْرَهُمْ بِاَحْسَنِ مَا كَانُوا یَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13993,
            "SureId": 16,
            "AyetId": 98,
            "LanguageId": 7,
            "AyetNumber": "٩٨",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "فَاِذَا قَرَاْتَ الْقُرْاٰنَ فَاسْتَعِذْ بِاللّٰهِ مِنَ الشَّیْطَانِ الرَّجٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14000,
            "SureId": 16,
            "AyetId": 99,
            "LanguageId": 7,
            "AyetNumber": "٩٩",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "اِنَّهُ لَیْسَ لَهُ سُلْطَانٌ عَلَى الَّذٖینَ اٰمَنُوا وَعَلٰى رَبِّهِمْ یَتَوَكَّلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14007,
            "SureId": 16,
            "AyetId": 100,
            "LanguageId": 7,
            "AyetNumber": "١٠٠",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "اِنَّمَا سُلْطَانُهُ عَلَى الَّذٖینَ یَتَوَلَّوْنَهُ وَالَّذٖینَ هُمْ بِهٖ مُشْرِكُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14014,
            "SureId": 16,
            "AyetId": 101,
            "LanguageId": 7,
            "AyetNumber": "١٠١",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "وَاِذَا بَدَّلْنَٓا اٰیَةً مَكَانَ اٰیَةٍۙ وَاللّٰهُ اَعْلَمُ بِمَا یُنَزِّلُ قَالُٓوا اِنَّمَٓا اَنْتَ مُفْتَرٍؕ بَلْ اَكْثَرُهُمْ لَا یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14021,
            "SureId": 16,
            "AyetId": 102,
            "LanguageId": 7,
            "AyetNumber": "١٠٢",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "قُلْ نَزَّلَهُ رُوحُ الْقُدُسِ مِنْ رَبِّكَ بِالْحَقِّ لِیُثَبِّتَ الَّذٖینَ اٰمَنُوا وَهُدًى وَبُشْرٰى لِلْمُسْلِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 13963,
            "SureId": 16,
            "AyetId": 94,
            "LanguageId": 5,
            "AyetNumber": "94",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "Evet, yeminlerinizi aranızda bir kandırma aracı yapmayın; sonra sapasağlam basmışken ayağınız kayar ve insanları Allah yolundan saptırmanızın acı meyvesini tadarsınız, ayrıca ağır bir azapla da cezalandırılırsınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
                "Cuz": 14,
                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 13970,
            "SureId": 16,
            "AyetId": 95,
            "LanguageId": 5,
            "AyetNumber": "95",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "Allah’a verdiğiniz sözü küçük bir menfaate satmayın! Eğer bilirseniz sizin için Allah’ın katında olan daha hayırlıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13977,
            "SureId": 16,
            "AyetId": 96,
            "LanguageId": 5,
            "AyetNumber": "96",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "Sizde bulunanlar tükenip gider, ama Allah’ın katındakiler kalıcıdır. Asla kuşkunuz olmasın ki, güçlüklere göğüs gerenlerin ecirlerini, yapmış olduklarının daha da güzeliyle vereceğiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13984,
            "SureId": 16,
            "AyetId": 97,
            "LanguageId": 5,
            "AyetNumber": "97",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "Erkek olsun kadın olsun, kim inanmış bir insan olarak dünya ve âhirete yararlı işler yaparsa kesinlikle ona güzel bir hayat yaşatacağız ve böylelerinin ecirlerini de muhakkak surette yapmış olduklarının daha güzeliyle vereceğiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13991,
            "SureId": 16,
            "AyetId": 98,
            "LanguageId": 5,
            "AyetNumber": "98",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "Kur’an okuyacağın vakit, o kovulmuş şeytandan Allah’a sığın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13998,
            "SureId": 16,
            "AyetId": 99,
            "LanguageId": 5,
            "AyetNumber": "99",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "Gerçek şu ki o şeytanın, iman etmiş olanlar ve rablerine dayanıp güvenenler üzerinde bir hâkimiyeti olamaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14005,
            "SureId": 16,
            "AyetId": 100,
            "LanguageId": 5,
            "AyetNumber": "100",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "Şeytanın hâkimiyeti ancak onu kendilerine velî edinenler ve onun yüzünden müşrik olanlar üzerinde geçerlidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14012,
            "SureId": 16,
            "AyetId": 101,
            "LanguageId": 5,
            "AyetNumber": "101",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "Biz bir âyetin yerine başka bir âyeti getirdiğimiz zaman -ki Allah neyi indireceğini çok iyi bilir- “Sen sadece uyduruyorsun” dediler. Öyle değil, fakat onların çoğu bilmezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14019,
            "SureId": 16,
            "AyetId": 102,
            "LanguageId": 5,
            "AyetNumber": "102",
            "AyetVisible": true,
            "Page": 278,
            "AyetText": "İman edenlere sebat kazandırsın, müslümanlara rehber ve müjde olsun diye rabbin tarafından bir gerçek olmak üzere Kur’an’ı Ruhulkudüs’ün indirdiğini söyle.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
