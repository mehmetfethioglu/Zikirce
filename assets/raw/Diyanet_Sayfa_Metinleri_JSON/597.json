            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "O seni yetim bulup barındırmadı mı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42600,
            "SureId": 93,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "Seni yol bilmez halde bulup yol göstermedi mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42607,
            "SureId": 93,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "Ve seni yoksul bulup zengin etmedi mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42614,
            "SureId": 93,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "O halde sakın yetimi ezme!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42621,
            "SureId": 93,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "El açıp isteyeni de sakın boş çevirme!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
