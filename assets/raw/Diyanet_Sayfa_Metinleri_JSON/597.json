            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42616,
            "SureId": 93,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "فَاَمَّا الْیَتٖیمَ فَلَا تَقْهَرْؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42623,
            "SureId": 93,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "وَاَمَّا السَّٓائِلَ فَلَا تَنْهَرْؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42630,
            "SureId": 93,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "وَاَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
