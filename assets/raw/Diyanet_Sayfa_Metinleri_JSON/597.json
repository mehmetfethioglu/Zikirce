            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "Rabbin sana mutlaka lutuflarda bulunacak, sen de memnun olacaksın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
