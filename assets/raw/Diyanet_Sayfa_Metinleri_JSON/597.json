            "SureId": 93,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "وَوَجَدَكَ عَٓائِلًا فَاَغْنٰىؕ",
