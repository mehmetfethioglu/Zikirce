            "SureId": 94,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ",
