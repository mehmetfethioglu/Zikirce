            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "فَاِنَّ مَعَ الْعُسْرِ یُسْرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
