            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "وَلَسَوْفَ یُعْطٖیكَ رَبُّكَ فَتَرْضٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
