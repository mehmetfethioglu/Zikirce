            "SureId": 93,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "اَلَمْ یَجِدْكَ یَتٖیمًا فَاٰوٰىࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42602,
            "SureId": 93,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "وَوَجَدَكَ ضَٓالًّا فَهَدٰىࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
