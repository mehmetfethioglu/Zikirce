            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "اَلَّذٖٓی اَنْقَضَ ظَهْرَكَۙ",
