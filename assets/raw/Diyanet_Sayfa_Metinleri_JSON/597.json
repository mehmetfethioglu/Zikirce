            "SureId": 94,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "وَرَفَعْنَا لَكَ ذِكْرَكَؕ",
