            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 597,
            "AyetText": "اِنَّ مَعَ الْعُسْرِ یُسْرًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
