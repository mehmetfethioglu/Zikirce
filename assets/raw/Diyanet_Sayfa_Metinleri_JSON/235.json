    "QuranAyats": [
        {
            "Id": 11137,
            "SureId": 11,
            "AyetId": 118,
            "LanguageId": 7,
            "AyetNumber": "١١٨",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "وَلَوْ شَٓاءَ رَبُّكَ لَجَعَلَ النَّاسَ اُمَّةً وَاحِدَةً وَلَا یَزَالُونَ مُخْتَلِفٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 11,
                "MealInfo": "Mekke döneminde inmiştir. 123 âyettir. Sûre, adını içinde söz konusu edilen Hûd peygamberden almıştır. Sûre de başlıca tevhit, peygamberlik, öldükten sonra dirilme ve ceza konuları ele alınmakta ve bunlar bazı peygamberlerin kıssalarıyla desteklenmektedir.",
                "SureNameTurkish": "Hûd",
                "SureNameArabic": "هُودٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 52,
                "AyetCount": 123,
                "Cuz": 11,
                "FirstPage": 221,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11144,
            "SureId": 11,
            "AyetId": 119,
            "LanguageId": 7,
            "AyetNumber": "١١٩",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "اِلَّا مَنْ رَحِمَ رَبُّكَؕ وَلِذٰلِكَ خَلَقَهُمْؕ وَتَمَّتْ كَلِمَةُ رَبِّكَ لَاَمْلَــَٔنَّ جَهَنَّمَ مِنَ الْجِنَّةِ وَالنَّاسِ اَجْمَعٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11151,
            "SureId": 11,
            "AyetId": 120,
            "LanguageId": 7,
            "AyetNumber": "١٢٠",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "وَكُلًّا نَقُصُّ عَلَیْكَ مِنْ اَنْبَٓاءِ الرُّسُلِ مَا نُثَبِّتُ بِهٖ فُؤَادَكَۚ وَجَٓاءَكَ فٖی هٰذِهِ الْحَقُّ وَمَوْعِظَةٌ وَذِكْرٰى لِلْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11158,
            "SureId": 11,
            "AyetId": 121,
            "LanguageId": 7,
            "AyetNumber": "١٢١",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "وَقُلْ لِلَّذٖینَ لَا یُؤْمِنُونَ اعْمَلُوا عَلٰى مَكَانَتِكُمْؕ اِنَّا عَامِلُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11165,
            "SureId": 11,
            "AyetId": 122,
            "LanguageId": 7,
            "AyetNumber": "١٢٢",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "وَانْتَظِرُواۚ اِنَّا مُنْتَظِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11172,
            "SureId": 11,
            "AyetId": 123,
            "LanguageId": 7,
            "AyetNumber": "١٢٣",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "وَلِلّٰهِ غَیْبُ السَّمٰوَاتِ وَالْاَرْضِ وَاِلَیْهِ یُرْجَعُ الْاَمْرُ كُلُّهُ فَاعْبُدْهُ وَتَوَكَّلْ عَلَیْهِؕ وَمَا رَبُّكَ بِغَافِلٍ عَمَّا تَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11179,
            "SureId": 12,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "الٓـرٰࣞ تِلْكَ اٰیَاتُ الْكِتَابِ الْمُبٖینِࣞ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 12,
                "MealInfo": "Mekke döneminde inmiştir. 111 âyettir. Bu sûrede Yûsuf Peygamberin hayatta karşılaştığı sıkıntılar ve bunlara sabrederek nasıl başarıya ulaştığı anlatılmakta ve inananlar için faydalı öğütler, önemli mesajlar verilmektedir. Kur’an’da baştan sona kadar bir tek konuyu anlatan tek sûre budur.",
                "SureNameTurkish": "Yûsuf",
                "SureNameArabic": "يُوسُفَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 53,
                "AyetCount": 111,
                "Cuz": 12,
                "FirstPage": 235,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11186,
            "SureId": 12,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "اِنَّٓا اَنْزَلْنَاهُ قُرْءٰنًا عَرَبِیًّا لَعَلَّكُمْ تَعْقِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11193,
            "SureId": 12,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "نَحْنُ نَقُصُّ عَلَیْكَ اَحْسَنَ الْقَصَصِ بِمَٓا اَوْحَیْنَٓا اِلَیْكَ هٰذَا الْقُرْاٰنَࣗ وَاِنْ كُنْتَ مِنْ قَبْلِهٖ لَمِنَ الْغَافِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11200,
            "SureId": 12,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "اِذْ قَالَ یُوسُفُ لِاَبٖیهِ یَٓا اَبَتِ اِنّٖی رَاَیْتُ اَحَدَ عَشَرَ كَوْكَبًا وَالشَّمْسَ وَالْقَمَرَ رَاَیْتُهُمْ لٖی سَاجِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 11135,
            "SureId": 11,
            "AyetId": 118,
            "LanguageId": 5,
            "AyetNumber": "118-119",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "Rabbin dileseydi insanları elbette tek bir ümmet yapardı. Fakat onlar hep ihtilâf içinde olacaklardır, rabbinin esirgedikleri müstesna; zaten O insanları buna uygun yaratmıştır. Böylece rabbinin, “Andolsun ki cehennemi hem insanlar hem cinlerle dolduracağım” sözü yerini bulmuş oldu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 11,
                "MealInfo": "Mekke döneminde inmiştir. 123 âyettir. Sûre, adını içinde söz konusu edilen Hûd peygamberden almıştır. Sûre de başlıca tevhit, peygamberlik, öldükten sonra dirilme ve ceza konuları ele alınmakta ve bunlar bazı peygamberlerin kıssalarıyla desteklenmektedir.",
                "SureNameTurkish": "Hûd",
                "SureNameArabic": "هُودٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 52,
                "AyetCount": 123,
                "Cuz": 11,
                "FirstPage": 221,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11142,
            "SureId": 11,
            "AyetId": 119,
            "LanguageId": 5,
            "AyetNumber": "119",
            "AyetVisible": false,
            "Page": 235,
            "AyetText": "Rabbin dileseydi insanları elbette tek bir ümmet yapardı. Fakat onlar hep ihtilâf içinde olacaklardır, rabbinin esirgedikleri müstesna; zaten O insanları buna uygun yaratmıştır. Böylece rabbinin, \"Andolsun ki cehennemi hem insanlar hem cinlerle dolduracağım\" sözü yerini bulmuş oldu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11149,
            "SureId": 11,
            "AyetId": 120,
            "LanguageId": 5,
            "AyetNumber": "120",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "Peygamberlerin haberlerinden, senin kalbini kuvvetlendireceğimiz bilgilerin her birini sana anlatıyoruz. Bunlarda sana gerçeğin bilgisi, müminlere de bir öğüt ve bir uyarı ulaşıyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11156,
            "SureId": 11,
            "AyetId": 121,
            "LanguageId": 5,
            "AyetNumber": "121",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "İman etmeyenlere de ki: “Elinizden geleni yapın! Biz de yapacağız!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11163,
            "SureId": 11,
            "AyetId": 122,
            "LanguageId": 5,
            "AyetNumber": "122",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "Bekleyin! Şüphesiz biz de beklemekteyiz!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11170,
            "SureId": 11,
            "AyetId": 123,
            "LanguageId": 5,
            "AyetNumber": "123",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "Göklerin ve yerin gizlisi (gaybı) yalnız Allah’a aittir. Her iş O’na döndürülür. Öyleyse O’na kulluk et ve O’na güvenip dayan! Rabbin yapmakta olduklarınızdan habersiz değildir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11177,
            "SureId": 12,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "Elif-lâm-râ. Bunlar apaçık kitabın âyetleridir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 12,
                "MealInfo": "Mekke döneminde inmiştir. 111 âyettir. Bu sûrede Yûsuf Peygamberin hayatta karşılaştığı sıkıntılar ve bunlara sabrederek nasıl başarıya ulaştığı anlatılmakta ve inananlar için faydalı öğütler, önemli mesajlar verilmektedir. Kur’an’da baştan sona kadar bir tek konuyu anlatan tek sûre budur.",
                "SureNameTurkish": "Yûsuf",
                "SureNameArabic": "يُوسُفَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 53,
                "AyetCount": 111,
                "Cuz": 12,
                "FirstPage": 235,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11184,
            "SureId": 12,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "Anlayabilesiniz diye biz onu Arapça bir Kur’an olarak indirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11191,
            "SureId": 12,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "Biz bu Kur’an’ı sana vahyetmekle (başka konular yanında) en güzel kıssayı da anlatıyoruz. Gerçek şu ki, sen daha önce bunları bilmiyordun.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11198,
            "SureId": 12,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 235,
            "AyetText": "Bir gün Yûsuf, babasına demişti ki: “Babacığım! Ben rüyamda on bir yıldızla güneşi ve ayı gördüm; onları bana secde ederken gördüm.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
