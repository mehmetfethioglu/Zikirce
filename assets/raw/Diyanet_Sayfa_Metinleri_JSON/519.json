{
    "PointerList": null,
    "CuzNo": 26,
    "PageNo": 519,
    "ArCuzNo": "۲٦",
    "ArPageNo": "٥۱۹",
    "QuranAyats": [
        {
            "Id": 32522,
            "SureId": 50,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "وَلَقَدْ خَلَقْنَا الْاِنْسَانَ وَنَعْلَمُ مَا تُوَسْوِسُ بِهٖ نَفْسُهُۚ وَنَحْنُ اَقْرَبُ اِلَیْهِ مِنْ حَبْلِ الْوَرٖیدِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 50,
                "MealInfo": "Mekke döneminde inmiştir. 45 âyettir. Sûre, adını başındaki <b>“Kâf ”</b> harfindenalmıştır. Sûrede başlıca <b>İslâm inancının temel esasları çerçevesinde, Allah’ın birliğinin delilleri, Peygamberlik, öldükten sonra dirilme ve geçmişteki inkârcı milletlerin başlarına gelen felaketler, uğradıkları azaplar konu</b> edilmektedir.",
                "SureNameTurkish": "Kâf",
                "SureNameArabic": "قۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 34,
                "AyetCount": 45,
                "Cuz": 26,
                "FirstPage": 518,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 32529,
            "SureId": 50,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "اِذْ یَتَلَقَّى الْمُتَلَقِّیَانِ عَنِ الْیَمٖینِ وَعَنِ الشِّمَالِ قَعٖیدٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32536,
            "SureId": 50,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "مَا یَلْفِظُ مِنْ قَوْلٍ اِلَّا لَدَیْهِ رَقٖیبٌ عَتٖیدٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32543,
            "SureId": 50,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "وَجَٓاءَتْ سَكْرَةُ الْمَوْتِ بِالْحَقِّؕ ذٰلِكَ مَا كُنْتَ مِنْهُ تَحٖیدُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32550,
            "SureId": 50,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "وَنُفِـخَ فِی الصُّورِؕ ذٰلِكَ یَوْمُ الْوَعٖیدِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32557,
            "SureId": 50,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "وَجَٓاءَتْ كُلُّ نَفْسٍ مَعَهَا سَٓائِقٌ وَشَهٖیدٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32564,
            "SureId": 50,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "لَقَدْ كُنْتَ فٖی غَفْلَةٍ مِنْ هٰذَا فَكَشَفْنَا عَنْكَ غِطَٓاءَكَ فَبَصَرُكَ الْیَوْمَ حَدٖیدٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32571,
            "SureId": 50,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "وَقَالَ قَرٖینُهُ هٰذَا مَا لَدَیَّ عَتٖیدٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32578,
            "SureId": 50,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "اَلْقِیَا فٖی جَهَنَّمَ كُلَّ كَفَّارٍ عَنٖیدٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32585,
            "SureId": 50,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "مَنَّاعٍ لِلْخَیْرِ مُعْتَدٍ مُرٖیبٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32592,
            "SureId": 50,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "اَلَّذٖی جَعَلَ مَعَ اللّٰهِ اِلٰهًا اٰخَرَ فَاَلْقِیَاهُ فِی الْعَذَابِ الشَّدٖیدِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32599,
            "SureId": 50,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "قَالَ قَرٖینُهُ رَبَّنَا مَٓا اَطْغَیْتُهُ وَلٰكِنْ كَانَ فٖی ضَلَالٍ بَعٖیدٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32606,
            "SureId": 50,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "قَالَ لَا تَخْتَصِمُوا لَدَیَّ وَقَدْ قَدَّمْتُ اِلَیْكُمْ بِالْوَعٖیدِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32613,
            "SureId": 50,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "مَا یُبَدَّلُ الْقَوْلُ لَدَیَّ وَمَٓا اَنَا𐻾 بِظَلَّامٍ لِلْعَبٖیدِࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32620,
            "SureId": 50,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "یَوْمَ نَقُولُ لِجَهَنَّمَ هَلِ امْتَلَاْتِ وَتَقُولُ هَلْ مِنْ مَزٖیدٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32627,
            "SureId": 50,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "وَاُزْلِفَتِ الْجَنَّةُ لِلْمُتَّقٖینَ غَیْرَ بَعٖیدٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32634,
            "SureId": 50,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "هٰذَا مَا تُوعَدُونَ لِكُلِّ اَوَّابٍ حَفٖیظٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32641,
            "SureId": 50,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "مَنْ خَشِیَ الرَّحْمٰنَ بِالْغَیْبِ وَجَٓاءَ بِقَلْبٍ مُنٖیبٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32648,
            "SureId": 50,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "اُدْخُلُوهَا بِسَلَامٍؕ ذٰلِكَ یَوْمُ الْخُلُودِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32655,
            "SureId": 50,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "لَهُمْ مَا یَشَٓاؤُ𐻿نَ فٖیهَا وَلَدَیْنَا مَزٖیدٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 32520,
            "SureId": 50,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16-17",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "İnsanı biz yarattık ve elbette içinden geçenleri biliriz; sağında solunda oturmuş iki alıcı (yaptıklarını) alıp kaydederken biz ona şah damarından daha yakınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 50,
                "MealInfo": "Mekke döneminde inmiştir. 45 âyettir. Sûre, adını başındaki <b>“Kâf ”</b> harfindenalmıştır. Sûrede başlıca <b>İslâm inancının temel esasları çerçevesinde, Allah’ın birliğinin delilleri, Peygamberlik, öldükten sonra dirilme ve geçmişteki inkârcı milletlerin başlarına gelen felaketler, uğradıkları azaplar konu</b> edilmektedir.",
                "SureNameTurkish": "Kâf",
                "SureNameArabic": "قۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 34,
                "AyetCount": 45,
                "Cuz": 26,
                "FirstPage": 518,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 32527,
            "SureId": 50,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": false,
            "Page": 519,
            "AyetText": "İnsanı biz yarattık ve elbette içinden geçenleri biliriz; sağında solunda oturmuş iki alıcı (yaptığını) alıp kaydederken biz ona şah damarından daha yakınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32534,
            "SureId": 50,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "O hiçbir söz söylemez ki yanında çok dikkatli bir gözetleyici olmasın!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32541,
            "SureId": 50,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "Bu durumda iken ölüm sarhoşluğu kaçınılamaz bir gerçek olarak çöküverir. (Ona şöyle denir:) “İşte bu, senin kendisinden kaçıp durduğun şeydir!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32548,
            "SureId": 50,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "Derken sûra üfürülür; işte bu, ceza uyarısı yapılmış olan gündür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32555,
            "SureId": 50,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "Her şahıs, yanında bir sürüp götüren görevli, bir de tanıkla gelir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32562,
            "SureId": 50,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "(Ona şöyle seslenilir:) “Sen bu konuda tam bir gaflet içindeydin, artık gözünden perdeni kaldırdık, şimdi gözün keskindir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32569,
            "SureId": 50,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "Arkadaşı (melek), “İşte hep beraber olduğum şahıs burada” der.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32576,
            "SureId": 50,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24-26",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "(Ve şu emir gelir:) “Atın cehenneme her inatçı kâfiri! İyiliği engelleyen, hak tanımayan, insanları şüpheye düşüren, Allah’ın yanına başka bir tanrı daha koyan kimseyi, atın onu dayanılmaz azaba!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32583,
            "SureId": 50,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": false,
            "Page": 519,
            "AyetText": "(Ve şu emir gelir:) \"Atın cehenneme her inatçı kâfiri! İyiliği engelleyen, hak tanımayan, insanları şüpheye düşüren, Allah’ın yanına başka bir tanrı daha koyan kimseyi, atın onu dayanılmaz azaba!\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32590,
            "SureId": 50,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": false,
            "Page": 519,
            "AyetText": "(Ve şu emir gelir:) \"Atın cehenneme her inatçı kâfiri! İyiliği engelleyen, hak tanımayan, insanları şüpheye düşüren, Allah’ın yanına başka bir tanrı daha koyan kimseyi, atın onu dayanılmaz azaba!\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32597,
            "SureId": 50,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "Yandaşı (şeytan), “Rabbim! Onu ben azdırmadım, o kendisi apaçık bir sapkınlık içinde idi” der.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32604,
            "SureId": 50,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "Allah şöyle buyurur: “Huzurumda tartışmayın, sizi daha önce uyarmıştım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32611,
            "SureId": 50,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "Bende söz değişmez ve ben asla kullara zulmetmem.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32618,
            "SureId": 50,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "O gün cehenneme “Doldun mu?” diyeceğiz; cevap verecek: “Daha yok mu?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32625,
            "SureId": 50,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "Allah’a itaatsizlikten sakınanlar için de cennet, iyice yakınlarına getirilecek.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32632,
            "SureId": 50,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32-33",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "Ve kendilerine şöyle denecektir: “İşte sizlere; daima Allah’a yönelen, O’nu aklından çıkarmayan, görmediği halde Rahmân’dan çekinip korkan ve samimi bir kalp ile gelen kimseye vaad edilen cennet!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32639,
            "SureId": 50,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": false,
            "Page": 519,
            "AyetText": "Ve kendilerine şöyle denecektir: \"İşte sizlere; daima Allah’a yönelen, O’nu aklından çıkarmayan, görmediği halde rahmândan çekinen ve tamamen rabbine dönük bir kalp ile gelen kimseye vaad edilen cennet!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32646,
            "SureId": 50,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "Oraya esenlikle girin, bu sonsuza kadar sürecek gündür.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32653,
            "SureId": 50,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 519,
            "AyetText": "Orada istedikleri her şey onlarındır, üstelik katımızda fazlası da vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
