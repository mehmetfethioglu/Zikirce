{
    "PointerList": null,
    "CuzNo": 11,
    "PageNo": 214,
    "ArCuzNo": "۱۱",
    "ArPageNo": "۲۱٤",
    "QuranAyats": [
        {
            "Id": 9849,
            "SureId": 10,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "وَمِنْهُمْ مَنْ یَنْظُرُ اِلَیْكَؕ اَفَاَنْتَ تَهْدِی الْعُمْیَ وَلَوْ كَانُوا لَا یُبْصِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 10,
                "MealInfo": "40,94,95 ve 96. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir.109 âyettir. Sûrede temel konu olarak Allah’ın rahmetinin gazabına üstünolduğu vurgulanmaktadır. Sûrede, Yûnus, Nûh ve Mûsâ peygamberlerile bunların kavimlerinin kıssalarına yer verilmektedir. Sûre, adını içindekiYûnus kıssasından almıştır.",
                "SureNameTurkish": "Yûnus",
                "SureNameArabic": "يُونُسَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 51,
                "AyetCount": 109,
                "Cuz": 11,
                "FirstPage": 208,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 9856,
            "SureId": 10,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "اِنَّ اللّٰهَ لَا یَظْلِمُ النَّاسَ شَیْـًٔا وَلٰكِنَّ النَّاسَ اَنْفُسَهُمْ یَظْلِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9863,
            "SureId": 10,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "وَیَوْمَ یَحْشُرُهُمْ كَاَنْ لَمْ یَلْبَثُٓوا اِلَّا سَاعَةً مِنَ النَّهَارِ یَتَعَارَفُونَ بَیْنَهُمْؕ قَدْ خَسِرَ الَّذٖینَ كَذَّبُوا بِلِقَٓاءِ اللّٰهِ وَمَا كَانُوا مُهْتَدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9870,
            "SureId": 10,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "وَاِمَّا نُرِیَنَّكَ بَعْضَ الَّذٖی نَعِدُهُمْ اَوْ نَتَوَفَّیَنَّكَ فَاِلَیْنَا مَرْجِعُهُمْ ثُمَّ اللّٰهُ شَهٖیدٌ عَلٰى مَا یَفْعَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9877,
            "SureId": 10,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "وَلِكُلِّ اُمَّةٍ رَسُولٌۚ فَاِذَا جَٓاءَ رَسُولُهُمْ قُضِیَ بَیْنَهُمْ بِالْقِسْطِ وَهُمْ لَا یُظْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9884,
            "SureId": 10,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "وَیَقُولُونَ مَتٰى هٰذَا الْوَعْدُ اِنْ كُنْتُمْ صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9891,
            "SureId": 10,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "قُلْ لَٓا اَمْلِكُ لِنَفْسٖی ضَرًّا وَلَا نَفْعًا اِلَّا مَا شَٓاءَ اللّٰهُؕ لِكُلِّ اُمَّةٍ اَجَلٌؕ اِذَا جَٓاءَ اَجَلُهُمْ فَلَا یَسْتَاْخِرُونَ سَاعَةً وَلَا یَسْتَقْدِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9898,
            "SureId": 10,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "قُلْ اَرَاَیْتُمْ اِنْ اَتٰیكُمْ عَذَابُهُ بَیَاتًا اَوْ نَهَارًا مَاذَا یَسْتَعْجِلُ مِنْهُ الْمُجْرِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9905,
            "SureId": 10,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "اَثُمَّ اِذَا مَا وَقَعَ اٰمَنْتُمْ بِهٖؕ آٰلْــٰٔنَ وَقَدْ كُنْتُمْ بِهٖ تَسْتَعْجِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9912,
            "SureId": 10,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "ثُمَّ قٖیلَ لِلَّذٖینَ ظَلَمُوا ذُوقُوا عَذَابَ الْخُلْدِۚ هَلْ تُجْزَوْنَ اِلَّا بِمَا كُنْتُمْ تَكْسِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9919,
            "SureId": 10,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "وَیَسْتَنْبِؤُ𐻿نَكَ اَحَقٌّ هُوَؕ قُلْ اٖی وَرَبّٖٓی اِنَّهُ لَحَقٌّ وَمَٓا اَنْتُمْ بِمُعْجِزٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 9847,
            "SureId": 10,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "Onların arasında sana bakanlar da var; ama eğer görmüyorlarsa körlere doğru yolu sen nasıl göstereceksin?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 10,
                "MealInfo": "40,94,95 ve 96. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir.109 âyettir. Sûrede temel konu olarak Allah’ın rahmetinin gazabına üstünolduğu vurgulanmaktadır. Sûrede, Yûnus, Nûh ve Mûsâ peygamberlerile bunların kavimlerinin kıssalarına yer verilmektedir. Sûre, adını içindekiYûnus kıssasından almıştır.",
                "SureNameTurkish": "Yûnus",
                "SureNameArabic": "يُونُسَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 51,
                "AyetCount": 109,
                "Cuz": 11,
                "FirstPage": 208,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 9854,
            "SureId": 10,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "Gerçek şu ki Allah insanlara zerrece kötülük etmez, fakat insanlar kendilerine kötülük ediyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9861,
            "SureId": 10,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "Allah onları mahşerde topladığı vakit, sanki (dünyada) sadece günün bir saatinde, aralarında tanışacak kadar kısa bir süre kaldıklarını sanacaklardır. (İşte o vakit) Allah’ın huzuruna çıkarılacakları uyarısını asılsız sayanlar ve doğru yolda yaşamamış olanlar hüsrana uğramış olacaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9868,
            "SureId": 10,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "Onlara bildirdiğimiz cezanın bir kısmını ya sana gösteririz veya (görmeden) seni vefat ettiririz; ama sonuçta dönüşleri bizedir; sonra Allah onların neler yaptığına da şahittir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9875,
            "SureId": 10,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "Her ümmetin bir peygamberi olmuştur. Onlara peygamberleri geldiğine göre aralarında olup bitenler hakkında adaletle hüküm verilir, haksızlığa uğratılmazlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9882,
            "SureId": 10,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "“Şayet dedikleriniz doğruysa ne zaman gerçekleşecek şu tehdit?” diyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9889,
            "SureId": 10,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "De ki: “Allah dilemedikçe ben kendime bile ne bir zarar ne de fayda vermeye muktedirim. Her ümmetin bir eceli vardır. Ecelleri geldiğinde ne bir an geri kalır ne de bir an ileri gidebilirler.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9896,
            "SureId": 10,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "Şunu da söyle: “Ne dersiniz, ya O’nun azabı bir gece veya gündüz vakti üstünüze inerse!” Günah içinde boğulmuş olanların böyle âcilen olmasını istedikleri bunların hangisidir?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9903,
            "SureId": 10,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "Olacaklar olduktan sonra mı buna iman edeceksiniz? O anda, öyle mi? Hani azabın çarçabuk gelmesini istemiştiniz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9910,
            "SureId": 10,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "Sonra o kötülük edenlere şöyle denilir: “Tadın bitmeyen azabı! Vaktiyle yaptıklarınızdan başka şeyler sebebiyle mi cezalandırılıyorsunuz?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 9917,
            "SureId": 10,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 214,
            "AyetText": "“Sahi bu doğru mu?” diye sana soruyorlar. De ki: “Elbette! Rabbime yemin ederim ki bu söylenenler kuşku götürmez bir gerçektir. Siz de bunları önleyemeyeceksiniz!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Yûnus",
    "QuranSureLabel": "يُونُسَ",
    "EndPageSure": null
}