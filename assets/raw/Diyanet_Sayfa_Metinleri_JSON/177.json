    "QuranAyats": [
        {
            "Id": 8127,
            "SureId": 8,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "یَسْـَٔلُونَكَ عَنِ الْاَنْفَالِؕ قُلِ الْاَنْفَالُ لِلّٰهِ وَالرَّسُولِۚ فَاتَّقُوا اللّٰهَ وَاَصْلِحُوا ذَاتَ بَیْنِكُمْࣕ وَاَطٖیعُوا اللّٰهَ وَرَسُولَهُٓ اِنْ كُنْتُمْ مُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 8,
                "MealInfo": "Medine döneminde hicretin ikinci yılında Bedir savaşından sonra inmiştir.75 âyettir. Sûre, adını ilk ayetteki <b>“el-Enfâl”</b> kelimesinden almıştır. <b>“Enfâl”, <i>savaş ganimetleri</i> demektir. </b>Sûrede başlıca, <b>savaş, özellikle Bedir savaşı sonrası elde edilen ganimetlerle, bunların kimlere ve nasıl pay edileceği </b>konu edilmektedir.",
                "SureNameTurkish": "Enfâl",
                "SureNameArabic": "الْاَنْفَالِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 88,
                "AyetCount": 75,
                "Cuz": 9,
                "FirstPage": 177,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 8134,
            "SureId": 8,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "اِنَّمَا الْمُؤْمِنُونَ الَّذٖینَ اِذَا ذُكِرَ اللّٰهُ وَجِلَتْ قُلُوبُهُمْ وَاِذَا تُلِیَتْ عَلَیْهِمْ اٰیَاتُهُ زَادَتْهُمْ اٖیمَانًا وَعَلٰى رَبِّهِمْ یَتَوَكَّلُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8141,
            "SureId": 8,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "اَلَّذٖینَ یُقٖیمُونَ الصَّلٰوةَ وَمِمَّا رَزَقْنَاهُمْ یُنْفِقُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8148,
            "SureId": 8,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "اُو𐻾لٰٓئِكَ هُمُ الْمُؤْمِنُونَ حَقًّاؕ لَهُمْ دَرَجَاتٌ عِنْدَ رَبِّهِمْ وَمَغْفِرَةٌ وَرِزْقٌ كَرٖیمٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8155,
            "SureId": 8,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "كَمَٓا اَخْرَجَكَ رَبُّكَ مِنْ بَیْتِكَ بِالْحَقِّࣕ وَاِنَّ فَرٖیقًا مِنَ الْمُؤْمِنٖینَ لَكَارِهُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8162,
            "SureId": 8,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "یُجَادِلُونَكَ فِی الْحَقِّ بَعْدَ مَا تَبَیَّنَ كَاَنَّمَا یُسَاقُونَ اِلَى الْمَوْتِ وَهُمْ یَنْظُرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8169,
            "SureId": 8,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "وَاِذْ یَعِدُكُمُ اللّٰهُ اِحْدَى الطَّٓائِفَتَیْنِ اَنَّهَا لَكُمْ وَتَوَدُّونَ اَنَّ غَیْرَ ذَاتِ الشَّوْكَةِ تَكُونُ لَكُمْ وَیُرٖیدُ اللّٰهُ اَنْ یُحِقَّ الْحَقَّ بِكَلِمَاتِهٖ وَیَقْطَعَ دَابِرَ الْكَافِرٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8176,
            "SureId": 8,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "لِیُحِقَّ الْحَقَّ وَیُبْطِلَ الْبَاطِلَ وَلَوْ كَرِهَ الْمُجْرِمُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 8125,
            "SureId": 8,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "Sana ganimetleri soruyorlar. Ganimetlerin Allah’a ve resulüne ait olduğunu söyle! O halde siz gerçek müminler iseniz Allah’a karşı saygısızlıktan sakının, aranızı düzeltin, Allah ve resulüne itaat edin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 8,
                "MealInfo": "Medine döneminde hicretin ikinci yılında Bedir savaşından sonra inmiştir.75 âyettir. Sûre, adını ilk ayetteki <b>“el-Enfâl”</b> kelimesinden almıştır. <b>“Enfâl”, <i>savaş ganimetleri</i> demektir. </b>Sûrede başlıca, <b>savaş, özellikle Bedir savaşı sonrası elde edilen ganimetlerle, bunların kimlere ve nasıl pay edileceği </b>konu edilmektedir.",
                "SureNameTurkish": "Enfâl",
                "SureNameArabic": "الْاَنْفَالِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 88,
                "AyetCount": 75,
                "Cuz": 9,
                "FirstPage": 177,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 8132,
            "SureId": 8,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "Müminler o kimselerdir ki, Allah’ın adı anıldığında yürekleri titrer, kendilerine Allah’ın âyetleri okunduğunda bu onların imanlarını arttırır. Onlar yalnızca rablerine güvenirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8139,
            "SureId": 8,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "Namazlarını özenle kılarlar, kendilerine verdiğimiz şeylerden bir kısmını Allah yolunda harcarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8146,
            "SureId": 8,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "Gerçek müminler işte onlardır. Rableri katında onlar için yüksek mevkiler, bağışlanma ve değerli rızık vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8153,
            "SureId": 8,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "Nitekim müminlerden bir kısmı isteksiz oldukları halde rabbin seni, doğru bir kararla evinden savaşa çıkarmıştı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8160,
            "SureId": 8,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "Doğru olan apaçık ortaya çıktıktan sonra, sanki gözleri göre göre ölüme sürükleniyorlarmış gibi bu konuda seninle tartışıyorlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8167,
            "SureId": 8,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "Hatırlayın, Allah size “iki topluluktan biri sizindir” diye vaad ediyordu, siz güçsüz olanın sizin olmasını istiyordunuz, Allah ise iradesi ve sözleriyle hakkı hâkim kılmayı ve inkâr edenlerin kökünü kesmeyi murat ediyordu.\n",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 8174,
            "SureId": 8,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 177,
            "AyetText": "Ki böylece günah yolunu tutanların hoşlarına gitmese de hakkı hâkim, bâtılı geçersiz kılsın! ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
