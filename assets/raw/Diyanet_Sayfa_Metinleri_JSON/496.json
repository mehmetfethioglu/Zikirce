            "AyetVisible": true,
            "Page": 496,
            "AyetText": "حٰمٓؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 44,
                "MealInfo": "Mekke döneminde inmiştir. 59 âyettir. Sûre, adını onuncu âyette geçen <b>“duhân” </b>kelimesinden almıştır. <b>Duhan, duman demektir</b>. Sûrede başlıca, <b>Kur’an’ın indirilişi, müşriklerin ona karşı tutumu, Firavun ve halkının başlarına gelen azaplar, Kureyş’in Hz. Peygamberi yalanlaması, iyilerin ve kötülerin karşılaşacakları akıbet</b> konu edilmektedir.",
                "SureNameTurkish": "Duhân",
                "SureNameArabic": "الدُّخَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 64,
                "AyetCount": 59,
                "Cuz": 25,
                "FirstPage": 496,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30912,
            "SureId": 44,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "وَالْكِتَابِ الْمُبٖینِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30919,
            "SureId": 44,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "اِنَّٓا اَنْزَلْنَاهُ فٖی لَیْلَةٍ مُبَارَكَةٍ اِنَّا كُنَّا مُنْذِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30926,
            "SureId": 44,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "فٖیهَا یُفْرَقُ كُلُّ اَمْرٍ حَكٖیمٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30933,
            "SureId": 44,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "اَمْرًا مِنْ عِنْدِنَاؕ اِنَّا كُنَّا مُرْسِلٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30940,
            "SureId": 44,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "رَحْمَةً مِنْ رَبِّكَؕ اِنَّهُ هُوَ السَّمٖیعُ الْعَلٖیمُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30947,
            "SureId": 44,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "رَبِّ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَیْنَهُمَاۘ اِنْ كُنْتُمْ مُوقِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30954,
            "SureId": 44,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "لَٓا اِلٰهَ اِلَّا هُوَ یُحْيٖ وَیُمٖیتُؕ رَبُّكُمْ وَرَبُّ اٰبَٓائِكُمُ الْاَوَّلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30961,
            "SureId": 44,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "بَلْ هُمْ فٖی شَكٍّ یَلْعَبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30968,
            "SureId": 44,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "فَارْتَقِبْ یَوْمَ تَاْتِی السَّمَٓاءُ بِدُخَانٍ مُبٖینٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30975,
            "SureId": 44,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "یَغْشَى النَّاسَؕ هٰذَا عَذَابٌ اَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30982,
            "SureId": 44,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "رَبَّنَا اكْشِفْ عَنَّا الْعَذَابَ اِنَّا مُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30989,
            "SureId": 44,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "اَنّٰى لَهُمُ الذِّكْرٰى وَقَدْ جَٓاءَهُمْ رَسُولٌ مُبٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30996,
            "SureId": 44,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "ثُمَّ تَوَلَّوْا عَنْهُ وَقَالُوا مُعَلَّمٌ مَجْنُونٌۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31003,
            "SureId": 44,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "اِنَّا كَاشِفُوا الْعَذَابِ قَلٖیلًا اِنَّكُمْ عَٓائِدُونَۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31010,
            "SureId": 44,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "یَوْمَ نَبْطِشُ الْبَطْشَةَ الْكُبْرٰىۚ اِنَّا مُنْتَقِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31017,
            "SureId": 44,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَٓاءَهُمْ رَسُولٌ كَرٖیمٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31024,
            "SureId": 44,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 496,
            "AyetText": "اَنْ اَدُّٓوا اِلَیَّ عِبَادَ اللّٰهِؕ اِنّٖی لَكُمْ رَسُولٌ اَمٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
