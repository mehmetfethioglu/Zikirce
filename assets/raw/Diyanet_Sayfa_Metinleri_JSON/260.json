    "QuranAyats": [
        {
            "Id": 12488,
            "SureId": 14,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "وَاٰتٰیكُمْ مِنْ كُلِّ مَا سَاَلْتُمُوهُؕ وَاِنْ تَعُدُّوا نِعْمَتَ اللّٰهِ لَا تُحْصُوهَاؕ اِنَّ الْاِنْسَانَ لَظَلُومٌ كَفَّارٌࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 14,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. İçinde Hz. İbrahim’den ve ailesinden söz edildiği için bu adı almıştır. Sûre de başlıca imanın temel konuları olan Allah’a iman, peygamberlere iman, öldükten sonra dirilme ve hesap ele alınmaktadır.",
                "SureNameTurkish": "İbrâhîm",
                "SureNameArabic": "اِبْرٰه۪يمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 72,
                "AyetCount": 52,
                "Cuz": 13,
                "FirstPage": 255,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12495,
            "SureId": 14,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "وَاِذْ قَالَ اِبْرٰهٖیمُ رَبِّ اجْعَلْ هٰذَا الْبَلَدَ اٰمِنًا وَاجْنُبْنٖی وَبَنِیَّ اَنْ نَعْبُدَ الْاَصْنَامَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12502,
            "SureId": 14,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "رَبِّ اِنَّهُنَّ اَضْلَلْنَ كَثٖیرًا مِنَ النَّاسِۚ فَمَنْ تَبِعَنٖی فَاِنَّهُ مِنّٖیۚ وَمَنْ عَصَانٖی فَاِنَّكَ غَفُورٌ رَحٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12509,
            "SureId": 14,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "رَبَّنَٓا اِنّٖٓی اَسْكَنْتُ مِنْ ذُرِّیَّتٖی بِوَادٍ غَیْرِ ذٖی زَرْعٍ عِنْدَ بَیْتِكَ الْمُحَرَّمِۙ رَبَّنَا لِیُقٖیمُوا الصَّلٰوةَ فَاجْعَلْ اَفْــِٔدَةً مِنَ النَّاسِ تَهْوٖٓی اِلَیْهِمْ وَارْزُقْهُمْ مِنَ الثَّمَرَاتِ لَعَلَّهُمْ یَشْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12516,
            "SureId": 14,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "رَبَّنَٓا اِنَّكَ تَعْلَمُ مَا نُخْفٖی وَمَا نُعْلِنُؕ وَمَا یَخْفٰى عَلَى اللّٰهِ مِنْ شَیْءٍ فِی الْاَرْضِ وَلَا فِی السَّمَٓاءِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12523,
            "SureId": 14,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "اَلْحَمْدُ لِلّٰهِ الَّذٖی وَهَبَ لٖی عَلَى الْكِبَرِ اِسْمٰعٖیلَ وَاِسْحٰقَؕ اِنَّ رَبّٖی لَسَمٖیعُ الدُّعَٓاءِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12530,
            "SureId": 14,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "رَبِّ اجْعَلْنٖی مُقٖیمَ الصَّلٰوةِ وَمِنْ ذُرِّیَّتٖیࣗ رَبَّنَا وَتَقَبَّلْ دُعَٓاءِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12537,
            "SureId": 14,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "رَبَّنَا اغْفِرْ لٖی وَلِوَالِدَیَّ وَلِلْمُؤْمِنٖینَ یَوْمَ یَقُومُ الْحِسَابُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12544,
            "SureId": 14,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "وَلَا تَحْسَبَنَّ اللّٰهَ غَافِلًا عَمَّا یَعْمَلُ الظَّالِمُونَؕ اِنَّمَا یُؤَخِّرُهُمْ لِیَوْمٍ تَشْخَصُ فٖیهِ الْاَبْصَارُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 12486,
            "SureId": 14,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "O size istediğiniz her şeyi verdi. Allah’ın nimetlerini saymaya kalksanız başa çıkamazsınız. Şu bir gerçek ki insanoğlu çok zalim, çok nankördür!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 14,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. İçinde Hz. İbrahim’den ve ailesinden söz edildiği için bu adı almıştır. Sûre de başlıca imanın temel konuları olan Allah’a iman, peygamberlere iman, öldükten sonra dirilme ve hesap ele alınmaktadır.",
                "SureNameTurkish": "İbrâhîm",
                "SureNameArabic": "اِبْرٰه۪يمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 72,
                "AyetCount": 52,
                "Cuz": 13,
                "FirstPage": 255,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12493,
            "SureId": 14,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "İbrâhim şöyle dua etmişti: “Rabbim! Bu şehri güvenli kıl, beni ve çocuklarımı putlara tapmaktan uzak tut!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12500,
            "SureId": 14,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "Rabbim! Putlar insanlardan birçoğunun sapmasına sebep oldu. Bundan böyle kim bana uyarsa o bendendir; kim de bana karşı gelirse artık sen çok bağışlayan, pek esirgeyensin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12507,
            "SureId": 14,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "Ey rabbimiz! Ben zürriyetimden bir kısmını, senin kutsal evinin (Kâbe) yanında tarıma elverişli olmayan bir vadiye yerleştirdim. Bunu yaptım ki rabbim, namazı kılsınlar. İnsanların gönüllerini onlara meylettir ve çeşitli ürünlerden onlara rızık ver ki şükretsinler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12514,
            "SureId": 14,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "Rabbimiz! Şüphesiz ki sen gizlediğimizi de açıkladığımızı da bilirsin. Yerde ve gökte hiçbir şey Allah’a gizli kalmaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12521,
            "SureId": 14,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "Yaşlılığıma rağmen bana İsmâil’i ve İshak’ı armağan eden Allah’a hamdolsun! Şüphesiz rabbim duaları kabul edendir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12528,
            "SureId": 14,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "Rabbim! Beni ve soyumdan gelecek olanları namazı devamlı kılanlardan eyle; rabbimiz, duamı kabul et.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12535,
            "SureId": 14,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "Rabbimiz! Hesap kurulacağı gün beni, anamı, babamı ve müminleri bağışla.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12542,
            "SureId": 14,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 260,
            "AyetText": "Sakın, Allah’ı zalimlerin yaptıklarından habersiz sanma! O sadece, onların işini bir güne erteliyor ki, o gün gözler dehşetten dışarı fırlamış;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
