        },
        {
            "Id": 714,
            "SureId": 2,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "وَلَنْ یَتَمَنَّوْهُ اَبَدًا بِمَا قَدَّمَتْ اَیْدٖیهِمْؕ وَاللّٰهُ عَلٖیمٌ بِالظَّالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 721,
            "SureId": 2,
            "AyetId": 96,
            "LanguageId": 7,
            "AyetNumber": "٩٦",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "وَلَتَجِدَنَّهُمْ اَحْرَصَ النَّاسِ عَلٰى حَیٰوةٍۚ وَمِنَ الَّذٖینَ اَشْرَكُوا یَوَدُّ اَحَدُهُمْ لَوْ یُعَمَّرُ اَلْفَ سَنَةٍۚ وَمَا هُوَ بِمُزَحْزِحِهٖ مِنَ الْعَذَابِ اَنْ یُعَمَّرَؕ وَاللّٰهُ بَصٖیرٌ بِمَا یَعْمَلُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 728,
            "SureId": 2,
            "AyetId": 97,
            "LanguageId": 7,
            "AyetNumber": "٩٧",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "قُلْ مَنْ كَانَ عَدُوًّا لِجِبْرٖیلَ فَاِنَّهُ نَزَّلَهُ عَلٰى قَلْبِكَ بِاِذْنِ اللّٰهِ مُصَدِّقًا لِمَا بَیْنَ یَدَیْهِ وَهُدًى وَبُشْرٰى لِلْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 735,
            "SureId": 2,
            "AyetId": 98,
            "LanguageId": 7,
            "AyetNumber": "٩٨",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "مَنْ كَانَ عَدُوًّا لِلّٰهِ وَمَلٰٓئِكَتِهٖ وَرُسُلِهٖ وَجِبْرٖیلَ وَمٖیكَالَ فَاِنَّ اللّٰهَ عَدُوٌّ لِلْكَافِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 742,
            "SureId": 2,
            "AyetId": 99,
            "LanguageId": 7,
            "AyetNumber": "٩٩",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "وَلَقَدْ اَنْزَلْنَٓا اِلَیْكَ اٰیَاتٍ بَیِّنَاتٍۚ وَمَا یَكْفُرُ بِهَٓا اِلَّا الْفَاسِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 749,
            "SureId": 2,
            "AyetId": 100,
            "LanguageId": 7,
            "AyetNumber": "١٠٠",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "اَوَكُلَّمَا عَاهَدُوا عَهْدًا نَبَذَهُ فَرٖیقٌ مِنْهُمْؕ بَلْ اَكْثَرُهُمْ لَا یُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 756,
            "SureId": 2,
            "AyetId": 101,
            "LanguageId": 7,
            "AyetNumber": "١٠١",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "وَلَمَّا جَٓاءَهُمْ رَسُولٌ مِنْ عِنْدِ اللّٰهِ مُصَدِّقٌ لِمَا مَعَهُمْ نَبَذَ فَرٖیقٌ مِنَ الَّذٖینَ اُو𐻿تُوا الْكِتَابَࣗ كِتَابَ اللّٰهِ وَرَٓاءَ ظُهُورِهِمْ كَاَنَّهُمْ لَا یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 705,
            "SureId": 2,
            "AyetId": 94,
            "LanguageId": 5,
            "AyetNumber": "94",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "Onlara, “Şayet Allah katında, âhiret yurdu diğer insanlara değil de yalnız size ait ise ve bu iddianızda doğruysanız haydi ölümü isteyin bakalım!” de.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 2,
                "MealInfo": "Medine döneminde inmiştir. Kur’an-ı Kerim’in en uzun sûresi olup 286 âyettir. Adını, 67-73. âyetlerde yer alan <b>“bakara (<i>sığı</i>r)”</b> kelimesinden alır. Sûre, İslâm hukukunun ana konularıyla ilgili pek çok hüküm içermektedir.",
                "SureNameTurkish": "Bakara",
                "SureNameArabic": "الْبَقَرَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 87,
                "AyetCount": 286,
                "Cuz": 1,
                "FirstPage": 2,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 712,
            "SureId": 2,
            "AyetId": 95,
            "LanguageId": 5,
            "AyetNumber": "95",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "Kendi elleriyle yapıp ettikleri işler sebebiyle hiçbir zaman ölümü temenni etmeyeceklerdir. Allah zalimleri iyi bilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 719,
            "SureId": 2,
            "AyetId": 96,
            "LanguageId": 5,
            "AyetNumber": "96",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "Yemin olsun ki, onları insanların yaşamaya en düşkünü olarak bulursun; müşriklerden de çok; her biri ister ki bin sene yaşasın. Oysa çok yaşatılması hiç kimseyi azaptan kurtaramaz. Allah onların yapmakta olduklarını eksiksiz görür.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 726,
            "SureId": 2,
            "AyetId": 97,
            "LanguageId": 5,
            "AyetNumber": "97",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "Söyle (yahudilere): Cebrâil’e kim düşmansa bilsin ki, Allah’ın izniyle önce gelen kitapları doğrulayıcı, müminler için bir hidayet rehberi ve müjdeci olarak Kur’an’ı senin kalbine indiren odur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 733,
            "SureId": 2,
            "AyetId": 98,
            "LanguageId": 5,
            "AyetNumber": "98",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "Her kim Allah’a, meleklerine, peygamberlerine, Cebrâil’e ve Mîkâil’e düşman ise bilsin ki Allah da inkârcıların düşmanıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 740,
            "SureId": 2,
            "AyetId": 99,
            "LanguageId": 5,
            "AyetNumber": "99",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "Andolsun ki sana apaçık âyetler indirdik. Onları ancak fâsıklar inkâr eder.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 747,
            "SureId": 2,
            "AyetId": 100,
            "LanguageId": 5,
            "AyetNumber": "100",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "Ne zaman onlar bir söz verdilerse yine kendilerinden bir grup onu bozup bir kenara atmadı mı? Zaten onların çoğu iman etmezler.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 754,
            "SureId": 2,
            "AyetId": 101,
            "LanguageId": 5,
            "AyetNumber": "101",
            "AyetVisible": true,
            "Page": 15,
            "AyetText": "Allah tarafından kendilerine, yanlarında bulunanı (Tevrat) tasdik edici bir elçi gelince Ehl-i kitabın bir kısmı, Allah’ın kitabını sanki bilmiyorlarmış gibi arkalarına atıp terk ettiler.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
