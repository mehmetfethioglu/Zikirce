    "QuranAyats": [
        {
            "Id": 1127,
            "SureId": 2,
            "AyetId": 154,
            "LanguageId": 7,
            "AyetNumber": "١٥٤",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "وَلَا تَقُولُوا لِمَنْ یُقْتَلُ فٖی سَبٖیلِ اللّٰهِ اَمْوَاتٌؕ بَلْ اَحْیَٓاءٌ وَلٰكِنْ لَا تَشْعُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 2,
                "MealInfo": "Medine döneminde inmiştir. Kur’an-ı Kerim’in en uzun sûresi olup 286 âyettir. Adını, 67-73. âyetlerde yer alan <b>“bakara (<i>sığı</i>r)”</b> kelimesinden alır. Sûre, İslâm hukukunun ana konularıyla ilgili pek çok hüküm içermektedir.",
                "SureNameTurkish": "Bakara",
                "SureNameArabic": "الْبَقَرَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 87,
                "AyetCount": 286,
                "Cuz": 1,
                "FirstPage": 2,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 1134,
            "SureId": 2,
            "AyetId": 155,
            "LanguageId": 7,
            "AyetNumber": "١٥٥",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "وَلَنَبْلُوَنَّكُمْ بِشَیْءٍ مِنَ الْخَوْفِ وَالْجُوعِ وَنَقْصٍ مِنَ الْاَمْوَالِ وَالْاَنْفُسِ وَالثَّمَرَاتِؕ وَبَشِّرِ الصَّابِرٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1141,
            "SureId": 2,
            "AyetId": 156,
            "LanguageId": 7,
            "AyetNumber": "١٥٦",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "اَلَّذٖینَ اِذَٓا اَصَابَتْهُمْ مُصٖیبَةٌۙ قَالُٓوا اِنَّا لِلّٰهِ وَاِنَّٓا اِلَیْهِ رَاجِعُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1148,
            "SureId": 2,
            "AyetId": 157,
            "LanguageId": 7,
            "AyetNumber": "١٥٧",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "اُو𐻾لٰٓئِكَ عَلَیْهِمْ صَلَوَاتٌ مِنْ رَبِّهِمْ وَرَحْمَةٌ وَاُو𐻾لٰٓئِكَ هُمُ الْمُهْتَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1155,
            "SureId": 2,
            "AyetId": 158,
            "LanguageId": 7,
            "AyetNumber": "١٥٨",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "اِنَّ الصَّفَا وَالْمَرْوَةَ مِنْ شَعَٓائِرِ اللّٰهِۚ فَمَنْ حَجَّ الْبَیْتَ اَوِ اعْتَمَرَ فَلَا جُنَاحَ عَلَیْهِ اَنْ یَطَّوَّفَ بِهِمَاؕ وَمَنْ تَطَوَّعَ خَیْرًاۙ فَاِنَّ اللّٰهَ شَاكِرٌ عَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1162,
            "SureId": 2,
            "AyetId": 159,
            "LanguageId": 7,
            "AyetNumber": "١٥٩",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "اِنَّ الَّذٖینَ یَكْتُمُونَ مَٓا اَنْزَلْنَا مِنَ الْبَیِّنَاتِ وَالْهُدٰى مِنْ بَعْدِ مَا بَیَّنَّاهُ لِلنَّاسِ فِی الْكِتَابِۙ اُو𐻾لٰٓئِكَ یَلْعَنُهُمُ اللّٰهُ وَیَلْعَنُهُمُ اللَّاعِنُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1169,
            "SureId": 2,
            "AyetId": 160,
            "LanguageId": 7,
            "AyetNumber": "١٦٠",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "اِلَّا الَّذٖینَ تَابُوا وَاَصْلَحُوا وَبَیَّنُوا فَاُو𐻾لٰٓئِكَ اَتُوبُ عَلَیْهِمْۚ وَاَنَا التَّوَّابُ الرَّحٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1176,
            "SureId": 2,
            "AyetId": 161,
            "LanguageId": 7,
            "AyetNumber": "١٦١",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "اِنَّ الَّذٖینَ كَفَرُوا وَمَاتُوا وَهُمْ كُفَّارٌ اُو𐻾لٰٓئِكَ عَلَیْهِمْ لَعْنَةُ اللّٰهِ وَالْمَلٰٓئِكَةِ وَالنَّاسِ اَجْمَعٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1183,
            "SureId": 2,
            "AyetId": 162,
            "LanguageId": 7,
            "AyetNumber": "١٦٢",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "خَالِدٖینَ فٖیهَاۚ لَا یُخَفَّفُ عَنْهُمُ الْعَذَابُ وَلَا هُمْ یُنْظَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1190,
            "SureId": 2,
            "AyetId": 163,
            "LanguageId": 7,
            "AyetNumber": "١٦٣",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "وَاِلٰهُكُمْ اِلٰهٌ وَاحِدٌۚ لَٓا اِلٰهَ اِلَّا هُوَ الرَّحْمٰنُ الرَّحٖیمُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 1125,
            "SureId": 2,
            "AyetId": 154,
            "LanguageId": 5,
            "AyetNumber": "154",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "Allah yolunda öldürülenler için “ölüler” demeyin. Hayır, onlar diridirler, fakat siz bilemezsiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 2,
                "MealInfo": "Medine döneminde inmiştir. Kur’an-ı Kerim’in en uzun sûresi olup 286 âyettir. Adını, 67-73. âyetlerde yer alan <b>“bakara (<i>sığı</i>r)”</b> kelimesinden alır. Sûre, İslâm hukukunun ana konularıyla ilgili pek çok hüküm içermektedir.",
                "SureNameTurkish": "Bakara",
                "SureNameArabic": "الْبَقَرَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 87,
                "AyetCount": 286,
                "Cuz": 1,
                "FirstPage": 2,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 1132,
            "SureId": 2,
            "AyetId": 155,
            "LanguageId": 5,
            "AyetNumber": "155",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "Andolsun ki sizi biraz korku ve açlıkla; mallardan, canlardan ve ürünlerden eksiltmekle sınayacağız. Sabredenleri müjdele!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1139,
            "SureId": 2,
            "AyetId": 156,
            "LanguageId": 5,
            "AyetNumber": "156",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "Onlar, başlarına bir musibet geldiğinde, “Doğrusu biz Allah’a aidiz ve kuşkusuz O’na döneceğiz” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1146,
            "SureId": 2,
            "AyetId": 157,
            "LanguageId": 5,
            "AyetNumber": "157",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "İşte rablerinin lütufları ve rahmeti bunlar içindir ve işte doğru yola ulaşmış olanlar da bunlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1153,
            "SureId": 2,
            "AyetId": 158,
            "LanguageId": 5,
            "AyetNumber": "158",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "Safâ ile Merve Allah’ın nişânelerindendir; dolayısıyla hac veya umre yaparak Beytullah’ı ziyaret eden bir kimsenin bu yerleri tavaf etmesinde kendisi için bir günah yoktur. Kim gönüllü bir iyilik yaparsa bilsin ki Allah iyiliği mükâfatıyla karşılayan ve çok iyi bilendir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1160,
            "SureId": 2,
            "AyetId": 159,
            "LanguageId": 5,
            "AyetNumber": "159",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "İndirdiğimiz açık delillerle hidayet bilgisini -kitapta onu insanlara apaçık göstermemizden sonra- gizleyenler yok mu, işte onlara hem Allah lânet eder hem de lânet okuyanlar lânet eder.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1167,
            "SureId": 2,
            "AyetId": 160,
            "LanguageId": 5,
            "AyetNumber": "160",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "Ancak tövbe edenler, kendilerini düzeltenler ve gerçeği açıkça ifade edenler bunun dışındadır. İşte bunların tövbesini kabul edeceğim. Doğrusu ben tövbeleri çokça kabul eden ve rahmeti bol olanım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1174,
            "SureId": 2,
            "AyetId": 161,
            "LanguageId": 5,
            "AyetNumber": "161",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "Gerçekleri inkâr eden ve inkârcılığa saplanmış olarak ölenlere gelince, Allah’ın, meleklerin ve bütün insanların lâneti onların üzerinedir!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1181,
            "SureId": 2,
            "AyetId": 162,
            "LanguageId": 5,
            "AyetNumber": "162",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "Onlar hep lânette kalacaklar; azapları hafifletilmeyecek ve yüzlerine bakılmayacak!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 1188,
            "SureId": 2,
            "AyetId": 163,
            "LanguageId": 5,
            "AyetNumber": "163",
            "AyetVisible": true,
            "Page": 24,
            "AyetText": "Mabudunuz tek ilâh olan Allah’tır; O’ndan başka ilâh yoktur; O rahmândır, rahîmdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
