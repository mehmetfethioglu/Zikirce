{
    "PointerList": null,
    "CuzNo": 24,
    "PageNo": 465,
    "ArCuzNo": "۲٤",
    "ArPageNo": "٤٦٥",
    "QuranAyats": [
        {
            "Id": 28805,
            "SureId": 39,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "اَوْ تَقُولَ لَوْ اَنَّ اللّٰهَ هَدٰینٖی لَكُنْتُ مِنَ الْمُتَّقٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 39,
                "MealInfo": "Mekke döneminde inmiştir. 75 âyettir. Sûre, adını 71 ve 73. âyetlerde geçen<b> “Zümer” </b>kelimesinden almıştır. <b>Zümer; zümreler, gruplar demektir.</b> Sûrede başlıca,<b> göklerde ve yerde Allah’ın birliğini gösteren deliller, mü’minlerin cennete, kâfirlerin cehenneme sevk edilecekleri konu edilmekte; kullar, ölüm gelip çatmadan Allah’a yönelmey</b>e çağrılmaktadır.",
                "SureNameTurkish": "Zümer",
                "SureNameArabic": "الزُّمَرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 59,
                "AyetCount": 75,
                "Cuz": 23,
                "FirstPage": 458,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 28812,
            "SureId": 39,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "اَوْ تَقُولَ حٖینَ تَرَى الْعَذَابَ لَوْ اَنَّ لٖی كَرَّةً فَاَكُونَ مِنَ الْمُحْسِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28819,
            "SureId": 39,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "بَلٰى قَدْ جَٓاءَتْكَ اٰیَاتٖی فَكَذَّبْتَ بِهَا وَاسْتَكْبَرْتَ وَكُنْتَ مِنَ الْكَافِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28826,
            "SureId": 39,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "وَیَوْمَ الْقِیٰمَةِ تَرَى الَّذٖینَ كَذَبُوا عَلَى اللّٰهِ وُجُوهُهُمْ مُسْوَدَّةٌؕ اَلَیْسَ فٖی جَهَنَّمَ مَثْوًى لِلْمُتَكَبِّرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28833,
            "SureId": 39,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "وَیُنَجِّی اللّٰهُ الَّذٖینَ اتَّقَوْا بِمَفَازَتِهِمْؗ لَا یَمَسُّهُمُ السُّٓوءُ وَلَا هُمْ یَحْزَنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28840,
            "SureId": 39,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "اَللّٰهُ خَالِقُ كُلِّ شَیْءٍؗ وَهُوَ عَلٰى كُلِّ شَیْءٍ وَكٖیلٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28847,
            "SureId": 39,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "لَهُ مَقَالٖیدُ السَّمٰوَاتِ وَالْاَرْضِؕ وَالَّذٖینَ كَفَرُوا بِاٰیَاتِ اللّٰهِ اُو𐻾لٰٓئِكَ هُمُ الْخَاسِرُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28854,
            "SureId": 39,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "قُلْ اَفَغَیْرَ اللّٰهِ تَاْمُرُٓونّٖٓی اَعْبُدُ اَیُّهَا الْجَاهِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28861,
            "SureId": 39,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "وَلَقَدْ اُو𐻿حِیَ اِلَیْكَ وَاِلَى الَّذٖینَ مِنْ قَبْلِكَۚ لَئِنْ اَشْرَكْتَ لَیَحْبَطَنَّ عَمَلُكَ وَلَتَكُونَنَّ مِنَ الْخَاسِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28868,
            "SureId": 39,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "بَلِ اللّٰهَ فَاعْبُدْ وَكُنْ مِنَ الشَّاكِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28875,
            "SureId": 39,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "وَمَا قَدَرُوا اللّٰهَ حَقَّ قَدْرِهٖࣗ وَالْاَرْضُ جَمٖیعًا قَبْضَتُهُ یَوْمَ الْقِیٰمَةِ وَالسَّمٰوَاتُ مَطْوِیَّاتٌ بِیَمٖینِهٖؕ سُبْحَانَهُ وَتَعَالٰى عَمَّا یُشْرِكُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 28803,
            "SureId": 39,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "Yahut “Eğer Allah bana hidayet nasip etseydi günahtan sakınanlardan olurdum” diyerek;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 39,
                "MealInfo": "Mekke döneminde inmiştir. 75 âyettir. Sûre, adını 71 ve 73. âyetlerde geçen<b> “Zümer” </b>kelimesinden almıştır. <b>Zümer; zümreler, gruplar demektir.</b> Sûrede başlıca,<b> göklerde ve yerde Allah’ın birliğini gösteren deliller, mü’minlerin cennete, kâfirlerin cehenneme sevk edilecekleri konu edilmekte; kullar, ölüm gelip çatmadan Allah’a yönelmey</b>e çağrılmaktadır.",
                "SureNameTurkish": "Zümer",
                "SureNameArabic": "الزُّمَرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 59,
                "AyetCount": 75,
                "Cuz": 23,
                "FirstPage": 458,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 28810,
            "SureId": 39,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "Ya da azabı gördüğünde, “Keşke bana bir fırsat daha tanınsa da iyilerden biri olsam!” diyerek hayıflanmasın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28817,
            "SureId": 39,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "(Allah ona şöyle diyecek:) “Hayır! Vaktiyle âyetlerim sana gelmişti ama sen onların asılsız olduğunu söylemiştin, büyüklük taslayıp inkârcılar arasında yer almıştın.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28824,
            "SureId": 39,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "Artık kıyamet gününde Allah hakkında asılsız inançlar ileri sürenleri, yüzleri kararmış göreceksin. Büyüklük taslayanların kalacağı yer cehennemde değil midir?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28831,
            "SureId": 39,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "İsyandan sakınanları da Allah, amaçlarına ulaşmış olarak kurtuluşa erdirecektir; onlara ne bir kötülük dokunacak ne de üzüntü çekecekler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28838,
            "SureId": 39,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "Allah her şeyin yaratıcısıdır ve her şeyi koruyup yöneten de O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28845,
            "SureId": 39,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "Göklerin ve yerin anahtarları O’ndadır. Allah’ın âyetlerini inkâr edenlerin durumuna gelince işte hüsrana uğrayanlar onlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28852,
            "SureId": 39,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "De ki: “Ey cahiller! Bana Allah’tan başkasına kulluk etmemi mi teklif ediyorsunuz?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28859,
            "SureId": 39,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "Sana ve senden öncekilere şöyle vahyedildi: Eğer Allah’a ortak koşarsan bilmiş ol ki yaptıkların boşa gidecek ve mutlaka hüsrana uğrayanlardan olacaksın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28866,
            "SureId": 39,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "Hayır! Yalnız Allah’a kulluk et ve şükredenlerden ol!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28873,
            "SureId": 39,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 465,
            "AyetText": "Onlar Allah’ı gereği gibi takdir edip tanımadılar. Kıyamet gününde bütün dünya O’nun avucundadır; gökler de O’nun kudret elinde dürülüp bükülmüştür. Allah, müşriklerin koştukları ortaklardan uzaktır ve yücedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Zümer",
    "QuranSureLabel": "الزُّمَرِ",
    "EndPageSure": null
}