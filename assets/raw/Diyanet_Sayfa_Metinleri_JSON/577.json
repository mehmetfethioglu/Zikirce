            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 577,
            "AyetText": "اَیَحْسَبُ الْاِنْسَانُ اَلَّنْ نَجْمَعَ عِظَامَهُؕ",
