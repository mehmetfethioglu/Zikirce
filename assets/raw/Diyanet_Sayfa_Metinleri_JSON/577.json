            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 577,
            "AyetText": "فَمَا تَنْفَعُهُمْ شَفَاعَةُ الشَّافِعٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 74,
                "MealInfo": "Mekke döneminde inmiştir. 56 âyettir. Sûre, adını birinci âyette geçen “elMüddessir”kelimesinden almıştır. Müddessir, tıpkı bir önceki sûrenin adıolan müzzemmil gibi, örtünüp bürünen demektir. Sûrede başlıca, Hz. Peygamberintebliğ ve davetle görevlendirilmesi, müşriklerin ona karşı çıkmasıve onların cehennemle uyarılması konu edilmektedir.",
                "SureNameTurkish": "Müddessir",
                "SureNameArabic": "الْمُدَّثِّرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 4,
                "AyetCount": 56,
                "Cuz": 29,
                "FirstPage": 575,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 38808,
            "SureId": 74,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 577,
            "AyetText": "فَمَا لَهُمْ عَنِ التَّذْكِرَةِ مُعْرِضٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38815,
            "SureId": 74,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 577,
            "AyetText": "كَاَنَّهُمْ حُمُرٌ مُسْتَنْفِرَةٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38822,
            "SureId": 74,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 577,
            "AyetText": "فَرَّتْ مِنْ قَسْوَرَةٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38829,
            "SureId": 74,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 577,
            "AyetText": "بَلْ یُرٖیدُ كُلُّ امْرِئٍ مِنْهُمْ اَنْ یُؤْتٰى صُحُفًا مُنَشَّرَةًۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38836,
            "SureId": 74,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 577,
            "AyetText": "كَلَّاؕ بَلْ لَا یَخَافُونَ الْاٰخِرَةَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
