            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 577,
            "AyetText": "یَسْـَٔلُ اَیَّانَ یَوْمُ الْقِیٰمَةِؕ",
            "Recitation": "",
            "AyetMeta": null,
