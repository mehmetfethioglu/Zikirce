            "SureId": 74,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 577,
            "AyetText": "(Uyarıcılardan) öğüt almak yerine onlardan her biri, kendisine, açılmış sahîfeler (ilâhî vahiy) verilmesini istiyor.",
            "Recitation": "",
