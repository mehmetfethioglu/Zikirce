            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 577,
            "AyetText": "بَلٰى قَادِرٖینَ عَلٰٓى اَنْ نُسَوِّیَ بَنَانَهُ",
