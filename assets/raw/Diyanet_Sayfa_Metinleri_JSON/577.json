            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 577,
            "AyetText": "وَلَٓا اُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ",
