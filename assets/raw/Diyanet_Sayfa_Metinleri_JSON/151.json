    "QuranAyats": [
        {
            "Id": 6685,
            "SureId": 7,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "الٓمٓصٓؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 7,
                "MealInfo": "Mekke döneminde inmiştir. 163-170. âyetlerin Medine döneminde indiğini söyleyen âlimler de vardır. 206 âyettir. Sûre, adını 46. ve 48. âyetlerde geçen<b>“el-A’râf ” </b>kelimesinden almıştır. <b>“el-A’râf ”, <i>yüksek yerler, yüksek mevkiler</i> demektir</b>. Sûrede temel konu olarak, ilâhî vahyin doğruluğu ve vahye duyulan ihtiyaç işlenmektedir.",
                "SureNameTurkish": "A'râf",
                "SureNameArabic": "الْاَعْرَافِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 39,
                "AyetCount": 206,
                "Cuz": 8,
                "FirstPage": 151,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 6692,
            "SureId": 7,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "كِتَابٌ اُنْزِلَ اِلَیْكَ فَلَا یَكُنْ فٖی صَدْرِكَ حَرَجٌ مِنْهُ لِتُنْذِرَ بِهٖ وَذِكْرٰى لِلْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6699,
            "SureId": 7,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "اِتَّبِعُوا مَٓا اُنْزِلَ اِلَیْكُمْ مِنْ رَبِّكُمْ وَلَا تَتَّبِعُوا مِنْ دُونِهٖٓ اَوْلِیَٓاءَؕ قَلٖیلًا مَا تَذَكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6706,
            "SureId": 7,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "وَكَمْ مِنْ قَرْیَةٍ اَهْلَكْنَاهَا فَجَٓاءَهَا بَاْسُنَا بَیَاتًا اَوْ هُمْ قَٓائِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6713,
            "SureId": 7,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "فَمَا كَانَ دَعْوٰیهُمْ اِذْ جَٓاءَهُمْ بَاْسُنَٓا اِلَّٓا اَنْ قَالُٓوا اِنَّا كُنَّا ظَالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6720,
            "SureId": 7,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "فَلَنَسْـَٔلَنَّ الَّذٖینَ اُرْسِلَ اِلَیْهِمْ وَلَنَسْـَٔلَنَّ الْمُرْسَلٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6727,
            "SureId": 7,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "فَلَنَقُصَّنَّ عَلَیْهِمْ بِعِلْمٍ وَمَا كُنَّا غَٓائِبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6734,
            "SureId": 7,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "وَالْوَزْنُ یَوْمَئِذٍࣙ الْحَقُّۚ فَمَنْ ثَقُلَتْ مَوَازٖینُهُ فَاُو𐻾لٰٓئِكَ هُمُ الْمُفْلِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6741,
            "SureId": 7,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "وَمَنْ خَفَّتْ مَوَازٖینُهُ فَاُو𐻾لٰٓئِكَ الَّذٖینَ خَسِرُٓوا اَنْفُسَهُمْ بِمَا كَانُوا بِاٰیَاتِنَا یَظْلِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6748,
            "SureId": 7,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "وَلَقَدْ مَكَّنَّاكُمْ فِی الْاَرْضِ وَجَعَلْنَا لَكُمْ فٖیهَا مَعَایِشَؕ قَلٖیلًا مَا تَشْكُرُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6755,
            "SureId": 7,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "وَلَقَدْ خَلَقْنَاكُمْ ثُمَّ صَوَّرْنَاكُمْ ثُمَّ قُلْنَا لِلْمَلٰٓئِكَةِ اسْجُدُوا لِاٰدَمَࣗ فَسَجَدُٓوا اِلَّٓا اِبْلٖیسَؕ لَمْ یَكُنْ مِنَ السَّاجِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 6683,
            "SureId": 7,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "Elif-lâm-mîm-sâd.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 7,
                "MealInfo": "Mekke döneminde inmiştir. 163-170. âyetlerin Medine döneminde indiğini söyleyen âlimler de vardır. 206 âyettir. Sûre, adını 46. ve 48. âyetlerde geçen<b>“el-A’râf ” </b>kelimesinden almıştır. <b>“el-A’râf ”, <i>yüksek yerler, yüksek mevkiler</i> demektir</b>. Sûrede temel konu olarak, ilâhî vahyin doğruluğu ve vahye duyulan ihtiyaç işlenmektedir.",
                "SureNameTurkish": "A'râf",
                "SureNameArabic": "الْاَعْرَافِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 39,
                "AyetCount": 206,
                "Cuz": 8,
                "FirstPage": 151,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 6690,
            "SureId": 7,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "Bu, kendisiyle insanları uyarman, inananlara öğüt vermen için sana indirilen bir kitaptır. Artık bu hususta kalbinde bir sıkıntı olmasın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6697,
            "SureId": 7,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "Rabbinizden size indirilene uyun; O’nu bırakıp da başka önderlerin ardından gitmeyin. Ne kadar da az öğüt alıyorsunuz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6704,
            "SureId": 7,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "Nice ülkeler var ki onları helâk ettik. Azabımız onlara geceleyin yahut gündüz istirahat ederlerken geliverdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6711,
            "SureId": 7,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "Azabımız onlara gelip çattığında, “Biz gerçekten zalim kişilermişiz!” diye yakınmaktan başka söyleyecekleri söz kalmadı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6718,
            "SureId": 7,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "Elbette kendilerine peygamber gönderilen kimseleri de, gönderilen peygamberleri de mutlaka sorgulayacağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6725,
            "SureId": 7,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "Ve onlara (olup bitenleri) tam bir bilgi ile mutlaka anlatacağız. Biz (olup bitenlerden) uzakta değiliz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6732,
            "SureId": 7,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "O gün ölçü-tartı haktır. Artık kimin tartıları ağır gelirse işte onlar kurtuluşa erenlerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6739,
            "SureId": 7,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "Kimin de tartıları hafif gelirse işte onlar, âyetlerimize karşı haksızlık ettiklerinden dolayı kendilerini ziyana sokanlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6746,
            "SureId": 7,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "Doğrusu sizi yeryüzüne yerleştirdik ve orada size geçim vasıtaları verdik. Ne kadar da az şükrediyorsunuz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6753,
            "SureId": 7,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 151,
            "AyetText": "Andolsun sizi yarattık; sonra size şekil verdik; sonra da meleklere, “Âdem’e secde edin” diye emrettik. İblîs’in dışındakiler secde ettiler. O secde edenler arasında yer almadı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
