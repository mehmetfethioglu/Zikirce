{
    "PointerList": null,
    "CuzNo": 23,
    "PageNo": 457,
    "ArCuzNo": "۲۳",
    "ArPageNo": "٤٥۷",
    "QuranAyats": [
        {
            "Id": 28224,
            "SureId": 38,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "وَقَالُوا مَا لَنَا لَا نَرٰى رِجَالًا كُنَّا نَعُدُّهُمْ مِنَ الْاَشْرَارِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 38,
                "MealInfo": "Mekke döneminde inmiştir. 88 âyettir. Sûre, adını birinci âyetteki <b>“Sâd”</b> harfinden almıştır. Sûrede başlıca, <b>Allah’ın birliği, müşriklerin inkârları ve sapıklıkları sebebiyle azabı hak etmiş oldukları, Davûd, Süleyman, Eyyüp, İbrahim, İshak, İsmail, el-Yesa’ ve Zülkifl Peygamberlerin kıssaları, Davûd Peygamberin hakemliği ve Hz. Peygamberin temel görevi konu </b>edilmektedir.",
                "SureNameTurkish": "Sâd",
                "SureNameArabic": "صۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 38,
                "AyetCount": 88,
                "Cuz": 23,
                "FirstPage": 453,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 28231,
            "SureId": 38,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "اَتَّخَذْنَاهُمْ سِخْرِیًّا اَمْ زَاغَتْ عَنْهُمُ الْاَبْصَارُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28238,
            "SureId": 38,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "اِنَّ ذٰلِكَ لَحَقٌّ تَخَاصُمُ اَهْلِ النَّارِࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28245,
            "SureId": 38,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "قُلْ اِنَّمَٓا اَنَا𐻾 مُنْذِرٌࣗ وَمَا مِنْ اِلٰهٍ اِلَّا اللّٰهُ الْوَاحِدُ الْقَهَّارُۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28252,
            "SureId": 38,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "رَبُّ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَیْنَهُمَا الْعَزٖیزُ الْغَفَّارُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28259,
            "SureId": 38,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "قُلْ هُوَ نَبَؤٌا عَظٖیمٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28266,
            "SureId": 38,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "اَنْتُمْ عَنْهُ مُعْرِضُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28273,
            "SureId": 38,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "مَا كَانَ لِیَ مِنْ عِلْمٍ بِالْمَلَاِ الْاَعْلٰٓى اِذْ یَخْتَصِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28280,
            "SureId": 38,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "اِنْ یُوحٰٓى اِلَیَّ اِلَّٓا اَنَّمَٓا اَنَا𐻾 نَذٖیرٌ مُبٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28287,
            "SureId": 38,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "اِذْ قَالَ رَبُّكَ لِلْمَلٰٓئِكَةِ اِنّٖی خَالِقٌ بَشَرًا مِنْ طٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28294,
            "SureId": 38,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "فَاِذَا سَوَّیْتُهُ وَنَفَخْتُ فٖیهِ مِنْ رُوحٖی فَقَعُوا لَهُ سَاجِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28301,
            "SureId": 38,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "فَسَجَدَ الْمَلٰٓئِكَةُ كُلُّهُمْ اَجْمَعُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28308,
            "SureId": 38,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "اِلَّٓا اِبْلٖیسَؕ اِسْتَكْبَرَ وَكَانَ مِنَ الْكَافِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28315,
            "SureId": 38,
            "AyetId": 75,
            "LanguageId": 7,
            "AyetNumber": "٧٥",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "قَالَ یَٓا اِبْلٖیسُ مَا مَنَعَكَ اَنْ تَسْجُدَ لِمَا خَلَقْتُ بِیَدَیَّؕ اَسْتَكْبَرْتَ اَمْ كُنْتَ مِنَ الْعَالٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28322,
            "SureId": 38,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "قَالَ اَنَا𐻾 خَیْرٌ مِنْهُؕ خَلَقْتَنٖی مِنْ نَارٍ وَخَلَقْتَهُ مِنْ طٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28329,
            "SureId": 38,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "قَالَ فَاخْرُجْ مِنْهَا فَاِنَّكَ رَجٖیمٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28336,
            "SureId": 38,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "وَاِنَّ عَلَیْكَ لَعْنَتٖٓی اِلٰى یَوْمِ الدّٖینِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28343,
            "SureId": 38,
            "AyetId": 79,
            "LanguageId": 7,
            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "قَالَ رَبِّ فَاَنْظِرْنٖٓی اِلٰى یَوْمِ یُبْعَثُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28350,
            "SureId": 38,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "قَالَ فَاِنَّكَ مِنَ الْمُنْظَرٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28357,
            "SureId": 38,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "اِلٰى یَوْمِ الْوَقْتِ الْمَعْلُومِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28364,
            "SureId": 38,
            "AyetId": 82,
            "LanguageId": 7,
            "AyetNumber": "٨٢",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "قَالَ فَبِعِزَّتِكَ لَاُغْوِیَنَّهُمْ اَجْمَعٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28371,
            "SureId": 38,
            "AyetId": 83,
            "LanguageId": 7,
            "AyetNumber": "٨٣",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "اِلَّا عِبَادَكَ مِنْهُمُ الْمُخْلَصٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 28222,
            "SureId": 38,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "Ve soracaklar: “Nasıl oluyor da vaktiyle kendilerini kötülerden saydığımız adamları şimdi burada göremiyoruz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 38,
                "MealInfo": "Mekke döneminde inmiştir. 88 âyettir. Sûre, adını birinci âyetteki <b>“Sâd”</b> harfinden almıştır. Sûrede başlıca, <b>Allah’ın birliği, müşriklerin inkârları ve sapıklıkları sebebiyle azabı hak etmiş oldukları, Davûd, Süleyman, Eyyüp, İbrahim, İshak, İsmail, el-Yesa’ ve Zülkifl Peygamberlerin kıssaları, Davûd Peygamberin hakemliği ve Hz. Peygamberin temel görevi konu </b>edilmektedir.",
                "SureNameTurkish": "Sâd",
                "SureNameArabic": "صۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 38,
                "AyetCount": 88,
                "Cuz": 23,
                "FirstPage": 453,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 28229,
            "SureId": 38,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "Onları (haksız olarak) mı alaya almışız, yoksa (buradalar da) gözden mi kaçırdık?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28236,
            "SureId": 38,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "İşte bu, yani cehennem ehlinin birbiriyle çekişmesi olayı bir hakikattir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28243,
            "SureId": 38,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "De ki: “Ben sadece bir uyarıcıyım. Karşı konulmaz güç sahibi tek Allah’tan başka tanrı yoktur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28250,
            "SureId": 38,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "O, göklerin, yerin ve ikisi arasındaki her şeyin rabbidir, daima galiptir, çok ­bağışlayıcıdır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28257,
            "SureId": 38,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "De ki: “Bu (vahiy ile gelen) çok önemli bir bilgidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28264,
            "SureId": 38,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "Siz ise ona sırt çeviriyorsunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28271,
            "SureId": 38,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "Yüce topluluk, kendi aralarında tartışırlarken onlarla bulunup bilgi edinmiş değilim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28278,
            "SureId": 38,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "Bana, yalnızca apaçık bir uyarıcılık görevi yüklendiğim için vahiy gelmektedir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28285,
            "SureId": 38,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "Hani rabbin meleklere demişti ki: “Ben çamurdan bir insan yaratacağım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28292,
            "SureId": 38,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "Ona tam şeklini verip ruhumdan da üflediğim vakit hemen onun için secdeye kapanın.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28299,
            "SureId": 38,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "Bunun üzerine meleklerin hepsi secde ettiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28306,
            "SureId": 38,
            "AyetId": 74,
            "LanguageId": 5,
            "AyetNumber": "74",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "Yalnız İblîs hariç; o, kibir duygusuna kapılıp kâfirlerden oldu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28313,
            "SureId": 38,
            "AyetId": 75,
            "LanguageId": 5,
            "AyetNumber": "75",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "Allah, “Ey İblîs” dedi, “Kendi ellerimle yarattığım şu varlığın önünde secde etmekten seni alıkoyan nedir? Büyüklük mü taslıyorsun yoksa ululardan mısın?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28320,
            "SureId": 38,
            "AyetId": 76,
            "LanguageId": 5,
            "AyetNumber": "76",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "İblîs, “Ben ondan daha üstünüm. Çünkü beni ateşten yarattın, onu çamurdan yarattın” diye cevap verdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28327,
            "SureId": 38,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "Allah, “O halde çık oradan!” dedi; “Sen artık kovuldun!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28334,
            "SureId": 38,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "Kıyamet gününe kadar rahmetimden uzak kalacaksın!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28341,
            "SureId": 38,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "“Rabbim! Öyleyse insanların yeniden diriltileceği güne kadar bana mühlet ver” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28348,
            "SureId": 38,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80-81",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "Allah, “Mâlum vakte kadar mühlet verilmiş olanlar arasındasın” buyurdu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28355,
            "SureId": 38,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81",
            "AyetVisible": false,
            "Page": 457,
            "AyetText": "Allah, \"Mâlum vakte kadar mühlet verilmiş olanlar arasındasın\" buyurdu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28362,
            "SureId": 38,
            "AyetId": 82,
            "LanguageId": 5,
            "AyetNumber": "82-83",
            "AyetVisible": true,
            "Page": 457,
            "AyetText": "İblîs, “Senin kudretine andolsun ki rabbim, içlerinden samimi kulların hariç, insanların topunu kesinlikle yoldan çıkaracağım” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28369,
            "SureId": 38,
            "AyetId": 83,
            "LanguageId": 5,
            "AyetNumber": "83",
