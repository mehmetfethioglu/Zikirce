{
    "PointerList": null,
    "CuzNo": 19,
    "PageNo": 363,
    "ArCuzNo": "۱۹",
    "ArPageNo": "۳٦۳",
    "QuranAyats": [
        {
            "Id": 20216,
            "SureId": 25,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "وَلَا یَاْتُونَكَ بِمَثَلٍ اِلَّا جِئْنَاكَ بِالْحَقِّ وَاَحْسَنَ تَفْسٖیرًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 25,
                "MealInfo": "Mekke döneminde inmiştir. 68-70. âyetlerin Medine döneminde indiği konusunda bir rivayet de vardır. 77 âyettir. Sûre, adını ilk âyette geçen <b>“elFurkân</b>” kelimesinden almaktadır. <b>Furkân, “hak ile batılı birbirinden ayıran”demek olup Kur’an’ın isimlerinden biridir.</b> Sûre de temel konular olarak Hz.Peygamber’in tüm insanlığa gönderildiği, onun tebliğ sırasında karşılaştığı zorluklar ve şirkin kökünün kazınacağı, geçmiş ümmetlerin hayatlarından bazı örnekler de verilerek ele alınmaktadır.",
                "SureNameTurkish": "Furkân",
                "SureNameArabic": "الْفُرْقَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 42,
                "AyetCount": 77,
                "Cuz": 18,
                "FirstPage": 359,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20223,
            "SureId": 25,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "اَلَّذٖینَ یُحْشَرُونَ عَلٰى وُجُوهِهِمْ اِلٰى جَهَنَّمَۙ اُو𐻾لٰٓئِكَ شَرٌّ مَكَانًا وَاَضَلُّ سَبٖیلًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20230,
            "SureId": 25,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "وَلَقَدْ اٰتَیْنَا مُوسَى الْكِتَابَ وَجَعَلْنَا مَعَهُٓ اَخَاهُ هٰرُونَ وَزٖیرًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20237,
            "SureId": 25,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "فَقُلْنَا اذْهَبَٓا اِلَى الْقَوْمِ الَّذٖینَ كَذَّبُوا بِاٰیَاتِنَاؕ فَدَمَّرْنَاهُمْ تَدْمٖیرًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20244,
            "SureId": 25,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "وَقَوْمَ نُوحٍ لَمَّا كَذَّبُوا الرُّسُلَ اَغْرَقْنَاهُمْ وَجَعَلْنَاهُمْ لِلنَّاسِ اٰیَةًؕ وَاَعْتَدْنَا لِلظَّالِمٖینَ عَذَابًا اَلٖیمًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20251,
            "SureId": 25,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "وَعَادًا وَثَمُودَا𐻾 وَاَصْحَابَ الرَّسِّ وَقُرُونًا بَیْنَ ذٰلِكَ كَثٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20258,
            "SureId": 25,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "وَكُلًّا ضَرَبْنَا لَهُ الْاَمْثَالَؗ وَكُلًّا تَبَّرْنَا تَتْبٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20265,
            "SureId": 25,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "وَلَقَدْ اَتَوْا عَلَى الْقَرْیَةِ الَّتٖٓی اُمْطِرَتْ مَطَرَ السَّوْءِؕ اَفَلَمْ یَكُونُوا یَرَوْنَهَاۚ بَلْ كَانُوا لَا یَرْجُونَ نُشُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20272,
            "SureId": 25,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "وَاِذَا رَاَوْكَ اِنْ یَتَّخِذُونَكَ اِلَّا هُزُوًاؕ اَهٰذَا الَّذٖی بَعَثَ اللّٰهُ رَسُولًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20279,
            "SureId": 25,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "اِنْ كَادَ لَیُضِلُّنَا عَنْ اٰلِهَتِنَا لَوْلَٓا اَنْ صَبَرْنَا عَلَیْهَاؕ وَسَوْفَ یَعْلَمُونَ حٖینَ یَرَوْنَ الْعَذَابَ مَنْ اَضَلُّ سَبٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20286,
            "SureId": 25,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "اَرَاَیْتَ مَنِ اتَّخَذَ اِلٰهَهُ هَوٰیهُؕ اَفَاَنْتَ تَكُونُ عَلَیْهِ وَكٖیلًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 20214,
            "SureId": 25,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "Onlar ne zaman bir talep ileri sürseler biz sana mutlaka kesin gerçeği ve en güzel açıklamayı bildiririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 25,
                "MealInfo": "Mekke döneminde inmiştir. 68-70. âyetlerin Medine döneminde indiği konusunda bir rivayet de vardır. 77 âyettir. Sûre, adını ilk âyette geçen <b>“elFurkân</b>” kelimesinden almaktadır. <b>Furkân, “hak ile batılı birbirinden ayıran”demek olup Kur’an’ın isimlerinden biridir.</b> Sûre de temel konular olarak Hz.Peygamber’in tüm insanlığa gönderildiği, onun tebliğ sırasında karşılaştığı zorluklar ve şirkin kökünün kazınacağı, geçmiş ümmetlerin hayatlarından bazı örnekler de verilerek ele alınmaktadır.",
                "SureNameTurkish": "Furkân",
                "SureNameArabic": "الْفُرْقَانِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 42,
                "AyetCount": 77,
                "Cuz": 18,
                "FirstPage": 359,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20221,
            "SureId": 25,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "Yüzüstü cehenneme sürülecek olanlar, evet işte onların yerleri en kötü yer, yolları da en yanlış yoldur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20228,
            "SureId": 25,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "Gerçek şu ki biz Mûsâ’ya da kitap vermiş, kardeşi Hârûn’u onun yanında yardımcı tayin etmiştik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20235,
            "SureId": 25,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "Onlara, “Âyetlerimizi yalan sayan topluluğun yanına gidin” dedik. Ama sonunda o (söz dinlemeyen) topluluğu yıkıp yok ettik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20242,
            "SureId": 25,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "Peygamberleri yalancı saymaları üzerine Nûh kavmini de sulara gömdük ve böylece onları insanlık için bir ibret yaptık. Biz, zalimler için çok acı bir azap hazırladık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20249,
            "SureId": 25,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "Âd’ı, Semûd’u, Res halkını, bunlar arasında daha birçok nesli de (cezalandırdık).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20256,
            "SureId": 25,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "Oysa her birine ibretli örnekler vermiştik. Nihayet hepsini kırıp geçirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20263,
            "SureId": 25,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "Bunlar, felâket yağmuruna tutulmuş olan o beldeye gitmişlerdi; peki oraları görmüyorlar mıydı? Hayır hayır! Bunlar öldükten sonra yeniden dirilmek diye bir şeyi beklemiyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20270,
            "SureId": 25,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "Onlar ne zaman seni görseler, “Bu mu Allah’ın resul olarak gönderdiği adam!” diyerek mutlaka seninle alay ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20277,
            "SureId": 25,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "“Eğer tanrılarımıza kararlılıkla bağlı kalmasaydık neredeyse bizi onlardan koparacaktı” derler. Ama azabı gördüklerinde yolunu büsbütün şaşırmışların kimler olduğunu anlayacaklar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20284,
            "SureId": 25,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 363,
            "AyetText": "Bayağı arzularını tanrılaştıran kişiyi gördün mü? Şimdi sen, bu adamı da doğru yola getirmekle yükümlü olabilir misin?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Furkân",
    "QuranSureLabel": "الْفُرْقَانِ",
    "EndPageSure": null
}