    "QuranAyats": [
        {
            "Id": 30702,
            "SureId": 43,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "وَاِنَّهُ لَعِلْمٌ لِلسَّاعَةِ فَلَا تَمْتَرُنَّ بِهَا وَاتَّبِعُونِؕ هٰذَا صِرَاطٌ مُسْتَقٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 43,
                "MealInfo": "Mekke döneminde inmiştir. 89 âyettir. Sûre, adını 35. âyette geçen <b>“Zuhruf ” </b>kelimesinden almaktadır. <b>Zuhruf; yaldız, mücevher, dünya hayatının geçici menfaati anlamlarına gelir. </b>Sûrede başlıca tevhit, iman ve vahyin getirdiği hakikatler ile insanların bu hakikatlere ters düşecek şekilde sırf geçici dünya menfaatlerine bağlanarak sergiledikleri çelişki vurgulanmakta, batıla karşı çıkan ve hakkı tutan şahsiyetler olarak İbrahim, Mûsâ ve İsa Peygamberlerden söz edilmektedir.",
                "SureNameTurkish": "Zuhruf",
                "SureNameArabic": "الزُّخْرُفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 63,
                "AyetCount": 89,
                "Cuz": 25,
                "FirstPage": 489,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30709,
            "SureId": 43,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "وَلَا یَصُدَّنَّكُمُ الشَّیْطَانُۚ اِنَّهُ لَكُمْ عَدُوٌّ مُبٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30716,
            "SureId": 43,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "وَلَمَّا جَٓاءَ عٖیسٰى بِالْبَیِّنَاتِ قَالَ قَدْ جِئْتُكُمْ بِالْحِكْمَةِ وَلِاُبَیِّنَ لَكُمْ بَعْضَ الَّذٖی تَخْتَلِفُونَ فٖیهِۚ فَاتَّقُوا اللّٰهَ وَاَطٖیعُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30723,
            "SureId": 43,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "اِنَّ اللّٰهَ هُوَ رَبّٖی وَرَبُّكُمْ فَاعْبُدُوهُؕ هٰذَا صِرَاطٌ مُسْتَقٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30730,
            "SureId": 43,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "فَاخْتَلَفَ الْاَحْزَابُ مِنْ بَیْنِهِمْۚ فَوَیْلٌ لِلَّذٖینَ ظَلَمُوا مِنْ عَذَابِ یَوْمٍ اَلٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30737,
            "SureId": 43,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "هَلْ یَنْظُرُونَ اِلَّا السَّاعَةَ اَنْ تَاْتِیَهُمْ بَغْتَةً وَهُمْ لَا یَشْعُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30744,
            "SureId": 43,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "اَلْاَخِلَّٓاءُ یَوْمَئِذٍ بَعْضُهُمْ لِبَعْضٍ عَدُوٌّ اِلَّا الْمُتَّقٖینَؕ‌ࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30751,
            "SureId": 43,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "یَا عِبَادِ لَا خَوْفٌ عَلَیْكُمُ الْیَوْمَ وَلَٓا اَنْتُمْ تَحْزَنُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30758,
            "SureId": 43,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "اَلَّذٖینَ اٰمَنُوا بِاٰیَاتِنَا وَكَانُوا مُسْلِمٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30765,
            "SureId": 43,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "اُدْخُلُوا الْجَنَّةَ اَنْتُمْ وَاَزْوَاجُكُمْ تُحْبَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30772,
            "SureId": 43,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "یُطَافُ عَلَیْهِمْ بِصِحَافٍ مِنْ ذَهَبٍ وَاَكْوَابٍۚ وَفٖیهَا مَا تَشْتَهٖیهِ الْاَنْفُسُ وَتَلَذُّ الْاَعْیُنُۚ وَاَنْتُمْ فٖیهَا خَالِدُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30779,
            "SureId": 43,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "وَتِلْكَ الْجَنَّةُ الَّتٖٓی اُو𐻿رِثْتُمُوهَا بِمَا كُنْتُمْ تَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30786,
            "SureId": 43,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "لَكُمْ فٖیهَا فَاكِهَةٌ كَثٖیرَةٌ مِنْهَا تَاْكُلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 30700,
            "SureId": 43,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "Bilin ki, o kıyamete ait bir bilgidir. Sakın ondan şüphe etmeyin ve bana tâbi olun. Bu dosdoğru yoldur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 43,
                "MealInfo": "Mekke döneminde inmiştir. 89 âyettir. Sûre, adını 35. âyette geçen <b>“Zuhruf ” </b>kelimesinden almaktadır. <b>Zuhruf; yaldız, mücevher, dünya hayatının geçici menfaati anlamlarına gelir. </b>Sûrede başlıca tevhit, iman ve vahyin getirdiği hakikatler ile insanların bu hakikatlere ters düşecek şekilde sırf geçici dünya menfaatlerine bağlanarak sergiledikleri çelişki vurgulanmakta, batıla karşı çıkan ve hakkı tutan şahsiyetler olarak İbrahim, Mûsâ ve İsa Peygamberlerden söz edilmektedir.",
                "SureNameTurkish": "Zuhruf",
                "SureNameArabic": "الزُّخْرُفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 63,
                "AyetCount": 89,
                "Cuz": 25,
                "FirstPage": 489,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30707,
            "SureId": 43,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "Şeytan sizi sakın doğru yoldan engellemesin, o sizin apaçık düşmanınızdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30714,
            "SureId": 43,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63-64",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "Îsâ sağlam kanıtlarla geldiğinde şöyle dedi: “Size hikmeti getirdim ve anlaşmazlığa düştüğünüz bazı konuları açıklamaya geldim. Allah’a itaatsizlikten sakının ve bana uyun. Kuşkusuz Allah benim de rabbimdir, sizin de rabbinizdir. Şu halde O’na kulluk edin; işte bu dosdoğru yoldur.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30721,
            "SureId": 43,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": false,
            "Page": 494,
            "AyetText": "Îsâ sağlam kanıtlarla geldiğinde şöyle dedi: \"Size hikmeti getirdim ve anlaşmazlığa düştüğünüz bazı konuları açıklamaya geldim. Allah’a itaatsizlikten sakının ve bana uyun. Kuşkusuz Allah benim de rabbimdir, sizin de rabbinizdir. Şu halde O’na kulluk edin; işte bu dosdoğru yoldur.\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30728,
            "SureId": 43,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "Gruplar aralarında anlaşmazlığa düştüler. Haksızlığa sapanların, elem verici bir günün azabından çekecekleri var!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30735,
            "SureId": 43,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "Bütün yaptıkları, kendileri farkında bile olmadan kıyametin ansızın kopmasını beklemekten ibaret!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30742,
            "SureId": 43,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "Allah’a itaatsizlikten sakınanlar dışında, dostlar bile o gün birbirinin düşmanıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30749,
            "SureId": 43,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68-69",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "Ey kullarım, âyetlerimize iman edenler ve emirlerimize boyun eğenler! O gün size korku yoktur, üzüntü de çekmeyeceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30756,
            "SureId": 43,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": false,
            "Page": 494,
            "AyetText": "Ey kullarım, âyetlerimize iman edenler ve emirlerimize boyun eğenler! O gün size korku yoktur, üzüntü de çekmeyeceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30763,
            "SureId": 43,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "Siz ve eşleriniz, muhteşem bir şekilde karşılanıp ağırlanmak üzere cennete girin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30770,
            "SureId": 43,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "Orada altın tepsiler ve bardaklar cennetliklerin çevrelerinde dolaştırılacaktır. Orada canların istediği, gözlerin zevk aldığı her şey vardır ve siz orada sonsuza kadar kalıcısınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30777,
            "SureId": 43,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "İşte bu, yapıp ettiklerinizle girmeyi hak ettiğiniz cennettir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30784,
            "SureId": 43,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73",
            "AyetVisible": true,
            "Page": 494,
            "AyetText": "Orada sizin için çeşitli meyveler vardır, onlardan âfiyetle yersiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
