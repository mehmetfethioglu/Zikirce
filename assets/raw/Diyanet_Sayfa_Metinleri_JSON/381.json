    "ArCuzNo": "۱۹",
    "ArPageNo": "۳۸۱",
    "QuranAyats": [
        {
            "Id": 22428,
            "SureId": 27,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "وَلَقَدْ اَرْسَلْنَٓا اِلٰى ثَمُودَ اَخَاهُمْ صَالِحًا اَنِ اعْبُدُوا اللّٰهَ فَاِذَا هُمْ فَرٖیقَانِ یَخْتَصِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 27,
                "MealInfo": "Mekke döneminde inmiştir. 93 âyettir. Sûre, adını 18. âyette yer alan <b>“enNeml</b>” kelimesinden almaktadır. <b>Neml, karınca demektir. </b>Sûre de başlıca, <b>Süleyman peygamber ve Sebe’ melikesi, Belkıs kıssası ile Salih ve Lût peygamberler&nbsp;</b>konu edilmekte, ayrıca mü’minlerin kurtuluşa ereceği, İslâm karşıtlarının kötü akıbetleri, öldükten sonra dirilmek ve kıyamet dile getirilmektedir.",
                "SureNameTurkish": "Neml",
                "SureNameArabic": "النَّمْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 48,
                "AyetCount": 93,
                "Cuz": 19,
                "FirstPage": 377,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 22435,
            "SureId": 27,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "قَالَ یَا قَوْمِ لِمَ تَسْتَعْجِلُونَ بِالسَّیِّئَةِ قَبْلَ الْحَسَنَةِۚ لَوْلَا تَسْتَغْفِرُونَ اللّٰهَ لَعَلَّكُمْ تُرْحَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22442,
            "SureId": 27,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "قَالُوا اطَّیَّرْنَا بِكَ وَبِمَنْ مَعَكَؕ قَالَ طَٓائِرُكُمْ عِنْدَ اللّٰهِ بَلْ اَنْتُمْ قَوْمٌ تُفْتَنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22449,
            "SureId": 27,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "وَكَانَ فِی الْمَدٖینَةِ تِسْعَةُ رَهْطٍ یُفْسِدُونَ فِی الْاَرْضِ وَلَا یُصْلِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22456,
            "SureId": 27,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "قَالُوا تَقَاسَمُوا بِاللّٰهِ لَنُبَیِّتَنَّهُ وَاَهْلَهُ ثُمَّ لَنَقُولَنَّ لِوَلِیِّهٖ مَا شَهِدْنَا مَهْلِكَ اَهْلِهٖ وَاِنَّا لَصَادِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22463,
            "SureId": 27,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "وَمَكَرُوا مَكْرًا وَمَكَرْنَا مَكْرًا وَهُمْ لَا یَشْعُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22470,
            "SureId": 27,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "فَانْظُرْ كَیْفَ كَانَ عَاقِبَةُ مَكْرِهِمْۙ اَنَّا دَمَّرْنَاهُمْ وَقَوْمَهُمْ اَجْمَعٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22477,
            "SureId": 27,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "فَتِلْكَ بُیُوتُهُمْ خَاوِیَةً بِمَا ظَلَمُواؕ اِنَّ فٖی ذٰلِكَ لَاٰیَةً لِقَوْمٍ یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22484,
            "SureId": 27,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "وَاَنْجَیْنَا الَّذٖینَ اٰمَنُوا وَكَانُوا یَتَّقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22491,
            "SureId": 27,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "وَلُوطًا اِذْ قَالَ لِقَوْمِهٖٓ اَتَاْتُونَ الْفَاحِشَةَ وَاَنْتُمْ تُبْصِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22498,
            "SureId": 27,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "اَئِنَّكُمْ لَتَاْتُونَ الرِّجَالَ شَهْوَةً مِنْ دُونِ النِّسَٓاءِؕ بَلْ اَنْتُمْ قَوْمٌ تَجْهَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 22426,
            "SureId": 27,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "Semûd kavmine, “Allah’a kulluk edin” demesi için kardeşleri Sâlih’i gönderdik. Ama hemen birbiriyle çekişen iki grup oluverdiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 27,
                "MealInfo": "Mekke döneminde inmiştir. 93 âyettir. Sûre, adını 18. âyette yer alan <b>“enNeml</b>” kelimesinden almaktadır. <b>Neml, karınca demektir. </b>Sûre de başlıca, <b>Süleyman peygamber ve Sebe’ melikesi, Belkıs kıssası ile Salih ve Lût peygamberler&nbsp;</b>konu edilmekte, ayrıca mü’minlerin kurtuluşa ereceği, İslâm karşıtlarının kötü akıbetleri, öldükten sonra dirilmek ve kıyamet dile getirilmektedir.",
                "SureNameTurkish": "Neml",
                "SureNameArabic": "النَّمْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 48,
                "AyetCount": 93,
                "Cuz": 19,
                "FirstPage": 377,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 22433,
            "SureId": 27,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "Sâlih, “Ey kavmim!” dedi, “İyilik dururken niçin kötülüğe koşuyorsunuz; size merhamet edilmesi için Allah’tan bağışlanmayı dileseniz olmaz mı?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22440,
            "SureId": 27,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "Şöyle cevap verdiler: “Sen ve beraberindekiler bize uğursuz geldiniz.” Sâlih, “Başınıza gelenler Allah katındandır. Doğrusu siz imtihana çekilen bir topluluksunuz” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22447,
            "SureId": 27,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "O şehirde dokuz elebaşı vardı; bunlar yeryüzünde bozgunculuk yapıyor, iyileştirme ve düzeltme cihetine gitmiyorlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22454,
            "SureId": 27,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "Allah’a and içerek aralarında şöyle konuştular: “Gece baskınıyla onu ve ailesini öldürelim, sonra velisine, ‘Biz Sâlih ailesinin öldürülmesi sırasında orada değildik, gerçekten doğru söylüyoruz’ diyelim.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22461,
            "SureId": 27,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "Onlar böyle bir tuzak kurdular, biz de kendileri farkında olmadan bir plan kurduk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22468,
            "SureId": 27,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "Bak işte tuzaklarının sonu ne oldu: Onları da kavimlerini de (nasıl) toptan helâk ettik!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22475,
            "SureId": 27,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "İşte haksızlıkları yüzünden çökmüş evleri! Anlayan bir kavim için elbette bunda ibret vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22482,
            "SureId": 27,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "İman edip Allah’a karşı gelmekten sakınanları ise o felâketten kurtardık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22489,
            "SureId": 27,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54-55",
            "AyetVisible": true,
            "Page": 381,
            "AyetText": "Lût’u da hatırla! O kavmine, “Göz göre göre hâlâ o hayâsızlığı yapacak mısınız? Gerçekten siz kadınları bırakıp da şehvetle erkeklere mi yöneliyorsunuz? Doğrusu siz değerleri bilmeyen bir topluluksunuz” demişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22496,
            "SureId": 27,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": false,
            "Page": 381,
            "AyetText": "Lût’u da hatırla! O kavmine, \"Göz göre göre hâlâ o hayâsızlığı yapacak mısınız? Gerçekten siz kadınları bırakıp da şehvetle erkeklere mi yöneliyorsunuz? Doğrusu siz değerleri bilmeyen bir topluluksunuz\" demişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
