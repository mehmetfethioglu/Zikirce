{
    "PointerList": null,
    "CuzNo": 27,
    "PageNo": 524,
    "ArCuzNo": "۲۷",
    "ArPageNo": "٥۲٤",
    "QuranAyats": [
        {
            "Id": 33250,
            "SureId": 52,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "اَفَسِحْرٌ هٰذَٓا اَمْ اَنْتُمْ لَا تُبْصِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 52,
                "MealInfo": "Mekke döneminde inmiştir. 49 âyettir. Sûre, adını birinci âyette geçen <b>“etTûr”</b> kelimesinden almıştır. <b>Tûr, dağ demektir.</b> Burada <b>Hz. Mûsâ’</b>ya ilk vahyin geldiği, Sina Yarımadası’nın güneyindeki <b>Sina dağı</b> kastedilmektedir. Sûrede başlıca, <b>ahiret hâlleri, kâfirlerin karşılaşacakları ceza, mü’minlerin mükâfatları konu edilmekte ve müşriklerin Hz. Peygamber hakkındaki batıl iddiaları</b> reddedilmektedir.",
                "SureNameTurkish": "Tûr",
                "SureNameArabic": "الطُّورِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 76,
                "AyetCount": 49,
                "Cuz": 27,
                "FirstPage": 523,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33257,
            "SureId": 52,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "اِصْلَوْهَا فَاصْبِرُٓوا اَوْ لَا تَصْبِرُواۚ سَوَٓاءٌ عَلَیْكُمْؕ اِنَّمَا تُجْزَوْنَ مَا كُنْتُمْ تَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33264,
            "SureId": 52,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "اِنَّ الْمُتَّقٖینَ فٖی جَنَّاتٍ وَنَعٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33271,
            "SureId": 52,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "فَاكِهٖینَ بِمَٓا اٰتٰیهُمْ رَبُّهُمْۚ وَوَقٰیهُمْ رَبُّهُمْ عَذَابَ الْجَحٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33278,
            "SureId": 52,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "كُلُوا وَاشْرَبُوا هَنٖٓیـًٔا بِمَا كُنْتُمْ تَعْمَلُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33285,
            "SureId": 52,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "مُتَّكِــٖٔینَ عَلٰى سُرُرٍ مَصْفُوفَةٍۚ وَزَوَّجْنَاهُمْ بِحُورٍ عٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33292,
            "SureId": 52,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "وَالَّذٖینَ اٰمَنُوا وَاتَّبَعَتْهُمْ ذُرِّیَّتُهُمْ بِاٖیمَانٍ اَلْحَقْنَا بِهِمْ ذُرِّیَّتَهُمْ وَمَٓا اَلَتْنَاهُمْ مِنْ عَمَلِهِمْ مِنْ شَیْءٍؕ كُلُّ امْرِئٍ بِمَا كَسَبَ رَهٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33299,
            "SureId": 52,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "وَاَمْدَدْنَاهُمْ بِفَاكِهَةٍ وَلَحْمٍ مِمَّا یَشْتَهُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33306,
            "SureId": 52,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "یَتَنَازَعُونَ فٖیهَا كَاْسًا لَا لَغْوٌ فٖیهَا وَلَا تَاْثٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33313,
            "SureId": 52,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "وَیَطُوفُ عَلَیْهِمْ غِلْمَانٌ لَهُمْ كَاَنَّهُمْ لُؤْلُؤٌ𐻾 مَكْنُونٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33320,
            "SureId": 52,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "وَاَقْبَلَ بَعْضُهُمْ عَلٰى بَعْضٍ یَتَسَٓاءَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33327,
            "SureId": 52,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "قَالُٓوا اِنَّا كُنَّا قَبْلُ فٖٓی اَهْلِنَا مُشْفِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33334,
            "SureId": 52,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "فَمَنَّ اللّٰهُ عَلَیْنَا وَوَقٰینَا عَذَابَ السَّمُومِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33341,
            "SureId": 52,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "اِنَّا كُنَّا مِنْ قَبْلُ نَدْعُوهُؕ اِنَّهُ هُوَ الْبَرُّ الرَّحٖیمُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33348,
            "SureId": 52,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "فَذَكِّرْ فَمَٓا اَنْتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍ وَلَا مَجْنُونٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33355,
            "SureId": 52,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "اَمْ یَقُولُونَ شَاعِرٌ نَتَرَبَّصُ بِهٖ رَیْبَ الْمَنُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33362,
            "SureId": 52,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "قُلْ تَرَبَّصُوا فَاِنّٖی مَعَكُمْ مِنَ الْمُتَرَبِّصٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 33248,
            "SureId": 52,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "Peki bu bir sihir mi? Yoksa görmüyor musunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 52,
                "MealInfo": "Mekke döneminde inmiştir. 49 âyettir. Sûre, adını birinci âyette geçen <b>“etTûr”</b> kelimesinden almıştır. <b>Tûr, dağ demektir.</b> Burada <b>Hz. Mûsâ’</b>ya ilk vahyin geldiği, Sina Yarımadası’nın güneyindeki <b>Sina dağı</b> kastedilmektedir. Sûrede başlıca, <b>ahiret hâlleri, kâfirlerin karşılaşacakları ceza, mü’minlerin mükâfatları konu edilmekte ve müşriklerin Hz. Peygamber hakkındaki batıl iddiaları</b> reddedilmektedir.",
                "SureNameTurkish": "Tûr",
                "SureNameArabic": "الطُّورِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 76,
                "AyetCount": 49,
                "Cuz": 27,
                "FirstPage": 523,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33255,
            "SureId": 52,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "Girin oraya! Artık sabretmişsiniz etmemişsiniz, sizin için farketmez. Çünkü sadece yaptıklarınızın karşılığını görmektesiniz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33262,
            "SureId": 52,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17-18",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "Allah’a saygısızlıktan sakınanlar ise, rablerinin kendilerine verdiğiyle mutluluk bularak cennetlerde ve nimetler içinde olacaklardır. Rableri onları cehennem azabından da korumuş olacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33269,
            "SureId": 52,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": false,
            "Page": 524,
            "AyetText": "Allah’a saygısızlıktan sakınanlar ise, rablerinin kendilerine verdiğiyle mutluluk bularak cennetlerde ve nimetler içinde olacaklardır. Rableri onları cehennem azabından da korumuş olacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33276,
            "SureId": 52,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19-20",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "(Onlara denecek ki:) “Yaptıklarınızın karşılığı olarak, sıra sıra dizilmiş koltuklara yaslanarak âfiyetle yiyin için.” Ayrıca onları güzel gözlü eşlerle evlendireceğiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33283,
            "SureId": 52,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": false,
            "Page": 524,
            "AyetText": "",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33290,
            "SureId": 52,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "İman eden, soylarından gelenlerin de aynı iman ile kendilerini izledikleri kimselerin yanlarına bu zürriyetlerini katacağız; bununla birlikte kendi amellerinden de bir şey eksiltmeyeceğiz. Herkes kendi yapıp ettiğinin hesabından kendisi sorumlu olacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33297,
            "SureId": 52,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "Onlara canlarının istediği meyve ve etten bol bol veririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33304,
            "SureId": 52,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "Orada karşılıklı kadeh alıp verirler, ama o içecek ne saçmalamaya yol açar ne de günah işlemeye.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33311,
            "SureId": 52,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "Sedeflerinde saklı incilere benzeyen genç hizmetçileri etraflarında dönüp dururlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33318,
            "SureId": 52,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "(Cennettekiler) birbirlerine dönüp sorarlar:",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33325,
            "SureId": 52,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "“Doğrusu biz” derler, “Daha önce yakınlarımız arasındayken için için bir korku taşımaktaydık (değil mi?)",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33332,
            "SureId": 52,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "Şimdi ise Allah bize lütfuyla muamele etti de bizi kavurucu azaptan korudu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33339,
            "SureId": 52,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "Elbette biz bundan önce yalnız O’na yalvarıyorduk. Şüphesiz ihsanı bol ve çok merhametli olan da yalnız O’dur.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33346,
            "SureId": 52,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "Sen öğüt vermeye devam et; rabbinin lütfu sayesinde sen asla ne bir kâhinsin ne de bir mecnun.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33353,
            "SureId": 52,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "Demek onlar, “O bir şairdir; zamanın sillesini yiyeceği günü bekliyoruz” diyorlar öyle mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33360,
            "SureId": 52,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 524,
            "AyetText": "De ki: “Bekleyin bakalım, ben de sizinle birlikte beklemekteyim!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Tûr",
    "QuranSureLabel": "الطُّورِ",
    "EndPageSure": null
}