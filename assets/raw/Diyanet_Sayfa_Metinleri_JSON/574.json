            "AyetVisible": true,
            "Page": 574,
            "AyetText": "یَٓا اَیُّهَا الْمُزَّمِّلُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 73,
                "MealInfo": "Mekke döneminde inmiştir. 20 âyettir. Sûre, adını birinci âyette geçen “elMüzzemmil”kelimesinden almıştır. Müzzemmil, örtünüp bürünen demektir.Sûrede başlıca, Hz. Peygamberin ibadet ve taat hayatı konu edilmiştir.",
                "SureNameTurkish": "Müzzemmil",
                "SureNameArabic": "الْمُزَّمِّلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 3,
                "AyetCount": 20,
                "Cuz": 29,
                "FirstPage": 574,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 38339,
            "SureId": 73,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "قُمِ الَّیْلَ اِلَّا قَلٖیلًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38346,
            "SureId": 73,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "نِصْفَهُٓ اَوِ انْقُصْ مِنْهُ قَلٖیلًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38353,
            "SureId": 73,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "اَوْ زِدْ عَلَیْهِ وَرَتِّلِ الْقُرْاٰنَ تَرْتٖیلًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38360,
            "SureId": 73,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "اِنَّا سَنُلْقٖی عَلَیْكَ قَوْلًا ثَقٖیلًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38367,
            "SureId": 73,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "اِنَّ نَاشِئَةَ الَّیْلِ هِیَ اَشَدُّ وَطْـًٔا وَاَقْوَمُ قٖیلًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38374,
            "SureId": 73,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "اِنَّ لَكَ فِی النَّهَارِ سَبْحًا طَوٖیلًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38381,
            "SureId": 73,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "وَاذْكُرِ اسْمَ رَبِّكَ وَتَبَتَّلْ اِلَیْهِ تَبْتٖیلًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38388,
            "SureId": 73,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "رَبُّ الْمَشْرِقِ وَالْمَغْرِبِ لَٓا اِلٰهَ اِلَّا هُوَ فَاتَّخِذْهُ وَكٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38395,
            "SureId": 73,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "وَاصْبِرْ عَلٰى مَا یَقُولُونَ وَاهْجُرْهُمْ هَجْرًا جَمٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38402,
            "SureId": 73,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "وَذَرْنٖی وَالْمُكَذِّبٖینَ اُو𐻾لِی النَّعْمَةِ وَمَهِّلْهُمْ قَلٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38409,
            "SureId": 73,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "اِنَّ لَدَیْنَٓا اَنْكَالًا وَجَحٖیمًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38416,
            "SureId": 73,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "وَطَعَامًا ذَا غُصَّةٍ وَعَذَابًا اَلٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38423,
            "SureId": 73,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "یَوْمَ تَرْجُفُ الْاَرْضُ وَالْجِبَالُ وَكَانَتِ الْجِبَالُ كَثٖیبًا مَهٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38430,
            "SureId": 73,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "اِنَّٓا اَرْسَلْنَٓا اِلَیْكُمْ رَسُولًا شَاهِدًا عَلَیْكُمْ كَمَٓا اَرْسَلْنَٓا اِلٰى فِرْعَوْنَ رَسُولًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38437,
            "SureId": 73,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "فَعَصٰى فِرْعَوْنُ الرَّسُولَ فَاَخَذْنَاهُ اَخْذًا وَبٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38444,
            "SureId": 73,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "فَكَیْفَ تَتَّقُونَ اِنْ كَفَرْتُمْ یَوْمًا یَجْعَلُ الْوِلْدَانَ شٖیبًاࣗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38451,
            "SureId": 73,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "اَلسَّمَٓاءُ مُنْفَطِرٌ بِهٖؕ كَانَ وَعْدُهُ مَفْعُولًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 38458,
            "SureId": 73,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 574,
            "AyetText": "اِنَّ هٰذِهٖ تَذْكِرَةٌۚ فَمَنْ شَٓاءَ اتَّخَذَ اِلٰى رَبِّهٖ سَبٖیلًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
