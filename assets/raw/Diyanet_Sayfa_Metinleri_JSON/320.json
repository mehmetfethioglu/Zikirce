    "ArCuzNo": "۱٦",
    "ArPageNo": "۳۲۰",
    "QuranAyats": [
        {
            "Id": 17234,
            "SureId": 20,
            "AyetId": 114,
            "LanguageId": 7,
            "AyetNumber": "١١٤",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "فَتَعَالَى اللّٰهُ الْمَلِكُ الْحَقُّۚ وَلَا تَعْجَلْ بِالْقُرْاٰنِ مِنْ قَبْلِ اَنْ یُقْضٰٓى اِلَیْكَ وَحْیُهُؗ وَقُلْ رَبِّ زِدْنٖی عِلْمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17241,
            "SureId": 20,
            "AyetId": 115,
            "LanguageId": 7,
            "AyetNumber": "١١٥",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "وَلَقَدْ عَهِدْنَٓا اِلٰٓى اٰدَمَ مِنْ قَبْلُ فَنَسِیَ وَلَمْ نَجِدْ لَهُ عَزْمًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17248,
            "SureId": 20,
            "AyetId": 116,
            "LanguageId": 7,
            "AyetNumber": "١١٦",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "وَاِذْ قُلْنَا لِلْمَلٰٓئِكَةِ اسْجُدُوا لِاٰدَمَ فَسَجَدُٓوا اِلَّٓا اِبْلٖیسَؕ اَبٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17255,
            "SureId": 20,
            "AyetId": 117,
            "LanguageId": 7,
            "AyetNumber": "١١٧",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "فَقُلْنَا یَٓا اٰدَمُ اِنَّ هٰذَا عَدُوٌّ لَكَ وَلِزَوْجِكَ فَلَا یُخْرِجَنَّكُمَا مِنَ الْجَنَّةِ فَتَشْقٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17262,
            "SureId": 20,
            "AyetId": 118,
            "LanguageId": 7,
            "AyetNumber": "١١٨",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "اِنَّ لَكَ اَلَّا تَجُوعَ فٖیهَا وَلَا تَعْرٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17269,
            "SureId": 20,
            "AyetId": 119,
            "LanguageId": 7,
            "AyetNumber": "١١٩",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "وَاَنَّكَ لَا تَظْمَؤُ𐻾ا فٖیهَا وَلَا تَضْحٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17276,
            "SureId": 20,
            "AyetId": 120,
            "LanguageId": 7,
            "AyetNumber": "١٢٠",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "فَوَسْوَسَ اِلَیْهِ الشَّیْطَانُ قَالَ یَٓا اٰدَمُ هَلْ اَدُلُّكَ عَلٰى شَجَرَةِ الْخُلْدِ وَمُلْكٍ لَا یَبْلٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17283,
            "SureId": 20,
            "AyetId": 121,
            "LanguageId": 7,
            "AyetNumber": "١٢١",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "فَاَكَلَا مِنْهَا فَبَدَتْ لَهُمَا سَوْاٰتُهُمَا وَطَفِقَا یَخْصِفَانِ عَلَیْهِمَا مِنْ وَرَقِ الْجَنَّةِؗ وَعَصٰٓى اٰدَمُ رَبَّهُ فَغَوٰىࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17290,
            "SureId": 20,
            "AyetId": 122,
            "LanguageId": 7,
            "AyetNumber": "١٢٢",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "ثُمَّ اجْتَبٰیهُ رَبُّهُ فَتَابَ عَلَیْهِ وَهَدٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17297,
            "SureId": 20,
            "AyetId": 123,
            "LanguageId": 7,
            "AyetNumber": "١٢٣",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "قَالَ اهْبِطَا مِنْهَا جَمٖیعًا بَعْضُكُمْ لِبَعْضٍ عَدُوٌّۚ فَاِمَّا یَاْتِیَنَّكُمْ مِنّٖی هُدًى فَمَنِ اتَّبَعَ هُدَایَ فَلَا یَضِلُّ وَلَا یَشْقٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17304,
            "SureId": 20,
            "AyetId": 124,
            "LanguageId": 7,
            "AyetNumber": "١٢٤",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "وَمَنْ اَعْرَضَ عَنْ ذِكْرٖی فَاِنَّ لَهُ مَعٖیشَةً ضَنْكًا وَنَحْشُرُهُ یَوْمَ الْقِیٰمَةِ اَعْمٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17311,
            "SureId": 20,
            "AyetId": 125,
            "LanguageId": 7,
            "AyetNumber": "١٢٥",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "قَالَ رَبِّ لِمَ حَشَرْتَنٖٓی اَعْمٰى وَقَدْ كُنْتُ بَصٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 17232,
            "SureId": 20,
            "AyetId": 114,
            "LanguageId": 5,
            "AyetNumber": "114",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "Gerçekliğinde şüphe bulunmayan, her şeye hükümran olan Allah yüceler yücesidir. Sana vahyi tamamlanmadan Kur’an’ı okumada aceleci davranma ve “Rabbim! İlmimi arttır” de.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17239,
            "SureId": 20,
            "AyetId": 115,
            "LanguageId": 5,
            "AyetNumber": "115",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "Biz daha önce Âdem’den söz almıştık, fakat o unuttu; biz onda yeterli bir kararlılık görmedik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17246,
            "SureId": 20,
            "AyetId": 116,
            "LanguageId": 5,
            "AyetNumber": "116",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "Meleklere “Âdem’e secde edin” dedik, onlar da secde ettiler, sadece İblîs direndi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17253,
            "SureId": 20,
            "AyetId": 117,
            "LanguageId": 5,
            "AyetNumber": "117",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "Bunun üzerine “Ey Âdem!” dedik, “Bil ki bu senin de eşinin de düşmanıdır. Sakın sizi cennetten çıkarmasın, yoksa mutluluğunu yitirirsin!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17260,
            "SureId": 20,
            "AyetId": 118,
            "LanguageId": 5,
            "AyetNumber": "118",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "Burada sana acıkmak da çıplak kalmak da yok.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17267,
            "SureId": 20,
            "AyetId": 119,
            "LanguageId": 5,
            "AyetNumber": "119",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "Yine burada susuzluk çekmezsin ve sıcaktan bunalmazsın.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17274,
            "SureId": 20,
            "AyetId": 120,
            "LanguageId": 5,
            "AyetNumber": "120",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "Derken, şeytan şöyle diyerek onun kafasını karıştırdı: “Ey Âdem! Sana sonsuzluk ağacının ve son bulmayacak bir hükümranlığın yolunu göstereyim mi?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17281,
            "SureId": 20,
            "AyetId": 121,
            "LanguageId": 5,
            "AyetNumber": "121",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "Nihayet ikisi de o ağaçtan yediler. Bunun üzerine mahrem yerleri kendilerine göründü, üstlerini cennet yaprağıyla örtmeye çalıştılar. Böylece Âdem rabbine karşı gelmiş ve yolunu şaşırmıştı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17288,
            "SureId": 20,
            "AyetId": 122,
            "LanguageId": 5,
            "AyetNumber": "122",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "Sonra rabbi onu seçkin kıldı, tövbesini kabul etti ve doğru yola yöneltti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17295,
            "SureId": 20,
            "AyetId": 123,
            "LanguageId": 5,
            "AyetNumber": "123",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "Şöyle buyurdu: “İkiniz birden inin oradan, birbirinize düşman olarak. Size benden bir hidayet geldiğinde bilesiniz ki hidayetime uyan artık ne sapar ne de bedbaht olur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17302,
            "SureId": 20,
            "AyetId": 124,
            "LanguageId": 5,
            "AyetNumber": "124",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "Kim de beni anmaktan yüz çevirirse mutlaka sıkıntılı bir hayatı olacaktır ve onu kıyamet günü kör olarak haşrederiz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17309,
            "SureId": 20,
            "AyetId": 125,
            "LanguageId": 5,
            "AyetNumber": "125",
            "AyetVisible": true,
            "Page": 320,
            "AyetText": "O der ki: “Ey rabbim! Beni niçin kör olarak haşrettin? Halbuki daha önce gören biriydim.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Tâhâ",
    "QuranSureLabel": "طٰهٰ",
    "EndPageSure": null
}