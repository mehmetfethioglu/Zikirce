        {
            "Id": 29918,
            "SureId": 42,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "عٓسٓقٓࣞ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29925,
            "SureId": 42,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "كَذٰلِكَ یُوحٖٓی اِلَیْكَ وَاِلَى الَّذٖینَ مِنْ قَبْلِكَۙ اللّٰهُ الْعَزٖیزُ الْحَكٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29932,
            "SureId": 42,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "لَهُ مَا فِی السَّمٰوَاتِ وَمَا فِی الْاَرْضِؕ وَهُوَ الْعَلِیُّ الْعَظٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29939,
            "SureId": 42,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "تَكَادُ السَّمٰوَاتُ یَتَفَطَّرْنَ مِنْ فَوْقِهِنَّ وَالْمَلٰٓئِكَةُ یُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَیَسْتَغْفِرُونَ لِمَنْ فِی الْاَرْضِؕ اَلَٓا اِنَّ اللّٰهَ هُوَ الْغَفُورُ الرَّحٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29946,
            "SureId": 42,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "وَالَّذٖینَ اتَّخَذُوا مِنْ دُونِهٖٓ اَوْلِیَٓاءَ اللّٰهُ حَفٖیظٌ عَلَیْهِمْؗ وَمَٓا اَنْتَ عَلَیْهِمْ بِوَكٖیلٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29953,
            "SureId": 42,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "وَكَذٰلِكَ اَوْحَیْنَٓا اِلَیْكَ قُرْاٰنًا عَرَبِیًّا لِتُنْذِرَ اُمَّ الْقُرٰى وَمَنْ حَوْلَهَا وَتُنْذِرَ یَوْمَ الْجَمْعِ لَا رَیْبَ فٖیهِؕ فَرٖیقٌ فِی الْجَنَّةِ وَفَرٖیقٌ فِی السَّعٖیرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29960,
            "SureId": 42,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "وَلَوْ شَٓاءَ اللّٰهُ لَجَعَلَهُمْ اُمَّةً وَاحِدَةً وَلٰكِنْ یُدْخِلُ مَنْ یَشَٓاءُ فٖی رَحْمَتِهٖؕ وَالظَّالِمُونَ مَا لَهُمْ مِنْ وَلِیٍّ وَلَا نَصٖیرٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29967,
            "SureId": 42,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "اَمِ اتَّخَذُوا مِنْ دُونِهٖٓ اَوْلِیَٓاءَۚ فَاللّٰهُ هُوَ الْوَلِیُّ وَهُوَ یُحْيِ الْمَوْتٰىؗ وَهُوَ عَلٰى كُلِّ شَیْءٍ قَدٖیرٌࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29974,
            "SureId": 42,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "وَمَا اخْتَلَفْتُمْ فٖیهِ مِنْ شَیْءٍ فَحُكْمُهُٓ اِلَى اللّٰهِؕ ذٰلِكُمُ اللّٰهُ رَبّٖی عَلَیْهِ تَوَكَّلْتُࣗ وَاِلَیْهِ اُنٖیبُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 29909,
            "SureId": 42,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "Hâ-mîm.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 42,
                "MealInfo": "Mekke döneminde inmiştir. 53 âyettir. Sûre, adını 38. âyette geçen<b> “Şûrâ” </b>kelimesinden almıştır.<b> Şûrâ, danışma demektir.</b> Sûrede <b>başlıca müslümanların işlerini kendi aralarında danışma yoluyla yürüttükleri, ayrıca kâinatta Allah’ın birliğini gösteren deliller ve kıyamet gününün hâlleri konu </b>edilmektedir",
                "SureNameTurkish": "Şûrâ",
                "SureNameArabic": "الشُّورٰى",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 62,
                "AyetCount": 53,
                "Cuz": 25,
                "FirstPage": 483,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 29916,
            "SureId": 42,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "Ayn-sîn-kâf.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29923,
            "SureId": 42,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "Aziz ve derin hikmet sahibi olan Allah sana ve senden öncekilere işte böyle vahiy gönderiyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29930,
            "SureId": 42,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "Göklerde ve yerde ne varsa hep O’nundur. O çok yücedir, çok uludur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29937,
            "SureId": 42,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "Gökler (haşyetten) neredeyse üstlerinden çatlayacak. Melekler de rablerinin yüceliğini hamd ile dile getiriyorlar ve yerdekilerin bağışlanmasını diliyorlar. İyi biliniz ki bağışlaması ve merhameti sınırsız olan ancak Allah’tır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29944,
            "SureId": 42,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "Kendisinden başkasını dost ve koruyucu bilenleri Allah sürekli gözetlemektedir. Senin onlarla ilgili bir sorumluluğun yok.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29951,
            "SureId": 42,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "İşte sana, Ümmülkurâ (Mekke) ve çevresindekileri uyarman ve hakkında asla şüphe bulunmayan toplanma gününün dehşetini haber vermen için böyle Arapça bir Kur’an indirdik. Onların bir kısmı cennette, bir kısmı da cehennemde olacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29958,
            "SureId": 42,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "Allah dileseydi onları elbette (aynı inançta) tek bir ümmet yapardı, fakat O kimi dilerse onu rahmetine kavuşturur; zalimlerin ise ne bir velisi (arka çıkanı) ne de bir yardımcısı olacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29965,
            "SureId": 42,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "Onlar Allah’tan başka velîler edindiler öyle mi? Halbuki asıl dost ve koruyucu Allah’tır. Ölüleri de O diriltecektir ve O’nun gücü her şeye yeter.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29972,
            "SureId": 42,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 483,
            "AyetText": "Ayrılığa düştüğünüz bütün konularda (doğru) hüküm Allah’a aittir. İşte o Allah benim rabbimdir; yalnız O’na güvenip dayanmışımdır ve daima O’na yönelirim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
