    "ArCuzNo": "۲٦",
    "ArPageNo": "٥۰۹",
    "QuranAyats": [
        {
            "Id": 31955,
            "SureId": 47,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "وَیَقُولُ الَّذٖینَ اٰمَنُوا لَوْلَا نُزِّلَتْ سُورَةٌۚ فَاِذَٓا اُنْزِلَتْ سُورَةٌ مُحْكَمَةٌ وَذُكِرَ فٖیهَا الْقِتَالُۙ رَاَیْتَ الَّذٖینَ فٖی قُلُوبِهِمْ مَرَضٌ یَنْظُرُونَ اِلَیْكَ نَظَرَ الْمَغْشِیِّ عَلَیْهِ مِنَ الْمَوْتِؕ فَاَوْلٰى لَهُمْۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 47,
                "MealInfo": "Medine döneminde inmiştir. 38 âyettir. <b>Sûre, adını Peygamber Efendimizin,ikinci âyette geçen adından almıştır.</b> Sûre, ayrıca yirminci âyette geçen <b>“elKıtâl</b>” kelimesinden dolayı<b> “Kıtâl sûresi</b>”, diye de anılmaktadır. Sûrede temel konu cihad olmak üzere başlıca, savaş, esirler, ganimetler ve münafıkların durumu konu edilmektedir.",
                "SureNameTurkish": "Muhammed",
                "SureNameArabic": "مُحَمَّدٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 95,
                "AyetCount": 38,
                "Cuz": 26,
                "FirstPage": 507,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 31962,
            "SureId": 47,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "طَاعَةٌ وَقَوْلٌ مَعْرُوفٌࣞ فَاِذَا عَزَمَ الْاَمْرُࣞ فَلَوْ صَدَقُوا اللّٰهَ لَكَانَ خَیْرًا لَهُمْۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31969,
            "SureId": 47,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "فَهَلْ عَسَیْتُمْ اِنْ تَوَلَّیْتُمْ اَنْ تُفْسِدُوا فِی الْاَرْضِ وَتُقَطِّعُٓوا اَرْحَامَكُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31976,
            "SureId": 47,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "اُو𐻾لٰٓئِكَ الَّذٖینَ لَعَنَهُمُ اللّٰهُ فَاَصَمَّهُمْ وَاَعْمٰٓى اَبْصَارَهُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31983,
            "SureId": 47,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "اَفَلَا یَتَدَبَّرُونَ الْقُرْاٰنَ اَمْ عَلٰى قُلُوبٍ اَقْفَالُهَا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31990,
            "SureId": 47,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "اِنَّ الَّذٖینَ ارْتَدُّوا عَلٰٓى اَدْبَارِهِمْ مِنْ بَعْدِ مَا تَبَیَّنَ لَهُمُ الْهُدَىۙ الشَّیْطَانُ سَوَّلَ لَهُمْؕ وَاَمْلٰى لَهُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31997,
            "SureId": 47,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "ذٰلِكَ بِاَنَّهُمْ قَالُوا لِلَّذٖینَ كَرِهُوا مَا نَزَّلَ اللّٰهُ سَنُطٖیعُكُمْ فٖی بَعْضِ الْاَمْرِۚ وَاللّٰهُ یَعْلَمُ اِسْرَارَهُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32004,
            "SureId": 47,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "فَكَیْفَ اِذَا تَوَفَّتْهُمُ الْمَلٰٓئِكَةُ یَضْرِبُونَ وُجُوهَهُمْ وَاَدْبَارَهُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32011,
            "SureId": 47,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "ذٰلِكَ بِاَنَّهُمُ اتَّبَعُوا مَٓا اَسْخَطَ اللّٰهَ وَكَرِهُوا رِضْوَانَهُ فَاَحْبَطَ اَعْمَالَهُمْࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32018,
            "SureId": 47,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "اَمْ حَسِبَ الَّذٖینَ فٖی قُلُوبِهِمْ مَرَضٌ اَنْ لَنْ یُخْرِجَ اللّٰهُ اَضْغَانَهُمْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 31953,
            "SureId": 47,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "İman edenler “Keşke bir sûre indirilse!” derler. Açık ve kesin hükümlü bir sûre indirildiğinde ve içinde savaştan söz edildiğinde, kalplerinde çürüklük bulunanların sana, ölüm korkusundan baygınlık geçirmiş kimseler gibi baktığını görürsün; zaten o da başlarına geldi gelecek!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 47,
                "MealInfo": "Medine döneminde inmiştir. 38 âyettir. <b>Sûre, adını Peygamber Efendimizin,ikinci âyette geçen adından almıştır.</b> Sûre, ayrıca yirminci âyette geçen <b>“elKıtâl</b>” kelimesinden dolayı<b> “Kıtâl sûresi</b>”, diye de anılmaktadır. Sûrede temel konu cihad olmak üzere başlıca, savaş, esirler, ganimetler ve münafıkların durumu konu edilmektedir.",
                "SureNameTurkish": "Muhammed",
                "SureNameArabic": "مُحَمَّدٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 95,
                "AyetCount": 38,
                "Cuz": 26,
                "FirstPage": 507,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 31960,
            "SureId": 47,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "Güzel olan itaattir, dinen ve örfen makbul sözdür. Durum (savaş emri) kesinlik kazanınca Allah’a karşı sadâkat gösterselerdi onlar için hayırlı olacaktı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31967,
            "SureId": 47,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "Yönetimi üstlenseniz hemen yeryüzünde kötülük çıkaracak ve yakınlık bağlarını parça parça edecek değil misiniz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31974,
            "SureId": 47,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "İşte bunları Allah lânetlemiş, kulaklarını sağır, gözlerini kör etmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31981,
            "SureId": 47,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "Kur’an’ı okuyup düşünmezler mi? Yoksa kalpler üzerinde kilitleri mi var?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31988,
            "SureId": 47,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "Doğru yol kendileri için apaçık hale geldikten sonra sırt çevirip dönenlere şeytan bunu güzel göstermiş ve kendilerine yanlış yolda ilerleme cesareti vermiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 31995,
            "SureId": 47,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "Bu da onların, Allah’ın gönderdiği vahiyden hoşlanmayanlara, “Bazı hususlarda sizin dediklerinizi yapacağız” demeleri yüzünden olmuştur. Allah onların gizlediklerini bilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32002,
            "SureId": 47,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "Melekler yüzlerine ve arkalarına vurarak onların canlarını alırken durumları nasıl olacak bakalım!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32009,
            "SureId": 47,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "Bunun da sebebi, Allah’ı öfkelendiren şeylerin peşine düşmeleri ve O’nun hoşnut olacağı şeylerden nefret etmeleridir. Bu yüzden Allah da onların yaptıklarını boşa çıkarmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32016,
            "SureId": 47,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 509,
            "AyetText": "Yoksa kalplerinde çürüklük bulunanlar, içlerindeki kini Allah’ın asla açığa çıkarmayacağını mı hesapladılar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Muhammed",
    "QuranSureLabel": "مُحَمَّدٍ",
    "EndPageSure": null
}