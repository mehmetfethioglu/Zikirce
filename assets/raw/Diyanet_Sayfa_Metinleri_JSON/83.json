            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "وَاللّٰهُ یُرٖیدُ اَنْ یَتُوبَ عَلَیْكُمْ وَیُرٖیدُ الَّذٖینَ یَتَّبِعُونَ الشَّهَوَاتِ اَنْ تَمٖیلُوا مَیْلًا عَظٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 4,
                "MealInfo": "Medine döneminde inmiştir. 176 âyettir. Sûre, özellikle kadın haklarından,onların hukûkî ve sosyal konumlarından bahsettiği için bu adı almıştır. <b>“Nisâ” kadınlar demektir.</b>",
                "SureNameTurkish": "Nisâ",
                "SureNameArabic": "النِّسَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 92,
                "AyetCount": 176,
                "Cuz": 4,
                "FirstPage": 77,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 3647,
            "SureId": 4,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "یُرٖیدُ اللّٰهُ اَنْ یُخَفِّفَ عَنْكُمْۚ وَخُلِقَ الْاِنْسَانُ ضَعٖیفًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3654,
            "SureId": 4,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "یَٓا اَیُّهَا الَّذٖینَ اٰمَنُوا لَا تَاْكُلُٓوا اَمْوَالَكُمْ بَیْنَكُمْ بِالْبَاطِلِ اِلَّٓا اَنْ تَكُونَ تِجَارَةً عَنْ تَرَاضٍ مِنْكُمْ وَلَا تَقْتُلُٓوا اَنْفُسَكُمْؕ اِنَّ اللّٰهَ كَانَ بِكُمْ رَحٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3661,
            "SureId": 4,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "وَمَنْ یَفْعَلْ ذٰلِكَ عُدْوَانًا وَظُلْمًا فَسَوْفَ نُصْلٖیهِ نَارًاؕ وَكَانَ ذٰلِكَ عَلَى اللّٰهِ یَسٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3668,
            "SureId": 4,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "اِنْ تَجْتَنِبُوا كَبَٓائِرَ مَا تُنْهَوْنَ عَنْهُ نُكَفِّرْ عَنْكُمْ سَیِّـَٔاتِكُمْ وَنُدْخِلْكُمْ مُدْخَلًا كَرٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3675,
            "SureId": 4,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "وَلَا تَتَمَنَّوْا مَا فَضَّلَ اللّٰهُ بِهٖ بَعْضَكُمْ عَلٰى بَعْضٍؕ لِلرِّجَالِ نَصٖیبٌ مِمَّا اكْتَسَبُوا وَلِلنِّسَٓاءِ نَصٖیبٌ مِمَّا اكْتَسَبْنَؕ وَسْـَٔلُوا اللّٰهَ مِنْ فَضْلِهٖؕ اِنَّ اللّٰهَ كَانَ بِكُلِّ شَیْءٍ عَلٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3682,
            "SureId": 4,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "وَلِكُلٍّ جَعَلْنَا مَوَالِیَ مِمَّا تَرَكَ الْوَالِدَانِ وَالْاَقْرَبُونَؕ وَالَّذٖینَ عَقَدَتْ اَیْمَانُكُمْ فَاٰتُوهُمْ نَصٖیبَهُمْؕ اِنَّ اللّٰهَ كَانَ عَلٰى كُلِّ شَیْءٍ شَهٖیدًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 3638,
            "SureId": 4,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "Allah sizin tövbenizi kabul etmek ister; nefsânî arzularına uyanlar ise büsbütün yoldan çıkmanızı isterler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 4,
                "MealInfo": "Medine döneminde inmiştir. 176 âyettir. Sûre, özellikle kadın haklarından,onların hukûkî ve sosyal konumlarından bahsettiği için bu adı almıştır. <b>“Nisâ” kadınlar demektir.</b>",
                "SureNameTurkish": "Nisâ",
                "SureNameArabic": "النِّسَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 92,
                "AyetCount": 176,
                "Cuz": 4,
                "FirstPage": 77,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 3645,
            "SureId": 4,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "Allah yükünüzü hafifletmek ister; çünkü insan zayıf yaratılmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3652,
            "SureId": 4,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "Ey iman edenler! Mallarınızı aranızda haksızlıkla yemeyin; ancak karşılıklı rızânıza dayanan ticaret böyle değildir ve kendinizi öldürmeyin. Şüphesiz Allah size karşı çok merhametlidir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3659,
            "SureId": 4,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "Kim haddi aşarak ve haksızlığa saparak bunu yaparsa onu ateşe koyacağız ve bu Allah’a çok kolaydır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3666,
            "SureId": 4,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "Eğer size yasaklanan büyük günahlardan kaçınırsanız sizin küçük günahlarınızı örteriz ve sizi değerli bir yere koyarız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3673,
            "SureId": 4,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "Allah’ın sizi birbirinizden üstün kıldığı şeyleri iç çekerek arzu etmeyin. Erkeklerin de kazandıklarından nasipleri var, kadınların da kazandıklarından nasipleri var. Allah’ın lütfundan isteyin; şüphesiz Allah her şeyi bilmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3680,
            "SureId": 4,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 83,
            "AyetText": "Anne, baba ve akrabanın geride bıraktıklarından her biri için yakın vârisler belirledik. Antlaşma yoluyla yakınlık bağı kurduğunuz kimselere de paylarını verin. Bilin ki Allah her şeyi görmektedir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
