            "AyetVisible": true,
            "Page": 585,
            "AyetText": "عَبَسَ وَتَوَلّٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 80,
                "MealInfo": "Mekke döneminde inmiştir. 42 âyettir. Sûre, adını birinci âyetteki “abese” fiilindenalmıştır. “Abese”, “yüzünü ekşitti” demektir. Sûrede başlıca, itikat, peygamberlik,Allah’ın kudreti ve kıyamet hâlleri konu edilmektedir",
                "SureNameTurkish": "Abese",
                "SureNameArabic": "عَبَسَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 24,
                "AyetCount": 42,
                "Cuz": 30,
                "FirstPage": 585,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 40320,
            "SureId": 80,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "اَنْ جَٓاءَهُ الْاَعْمٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40327,
            "SureId": 80,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "وَمَا یُدْرٖیكَ لَعَلَّهُ یَزَّكّٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40334,
            "SureId": 80,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "اَوْ یَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40341,
            "SureId": 80,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "اَمَّا مَنِ اسْتَغْنٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40348,
            "SureId": 80,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "فَاَنْتَ لَهُ تَصَدّٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40355,
            "SureId": 80,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "وَمَا عَلَیْكَ اَلَّا یَزَّكّٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40362,
            "SureId": 80,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "وَاَمَّا مَنْ جَٓاءَكَ یَسْعٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40369,
            "SureId": 80,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "وَهُوَ یَخْشٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40376,
            "SureId": 80,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "فَاَنْتَ عَنْهُ تَلَهّٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40383,
            "SureId": 80,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "كَلَّٓا اِنَّهَا تَذْكِرَةٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40390,
            "SureId": 80,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "فَمَنْ شَٓاءَ ذَكَرَهُۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40397,
            "SureId": 80,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "فٖی صُحُفٍ مُكَرَّمَةٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40404,
            "SureId": 80,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "مَرْفُوعَةٍ مُطَهَّرَةٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40411,
            "SureId": 80,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "بِاَیْدٖی سَفَرَةٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40418,
            "SureId": 80,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "كِرَامٍ بَرَرَةٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40425,
            "SureId": 80,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "قُتِلَ الْاِنْسَانُ مَٓا اَكْفَرَهُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40432,
            "SureId": 80,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "مِنْ اَیِّ شَیْءٍ خَلَقَهُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40439,
            "SureId": 80,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "مِنْ نُطْفَةٍؕ خَلَقَهُ فَقَدَّرَهُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40446,
            "SureId": 80,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "ثُمَّ السَّبٖیلَ یَسَّرَهُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40453,
            "SureId": 80,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "ثُمَّ اَمَاتَهُ فَاَقْبَرَهُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40460,
            "SureId": 80,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "ثُمَّ اِذَا شَٓاءَ اَنْشَرَهُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40467,
            "SureId": 80,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "كَلَّا لَمَّا یَقْضِ مَٓا اَمَرَهُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40474,
            "SureId": 80,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "فَلْیَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِهٖۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40481,
            "SureId": 80,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "اَنَّا صَبَبْنَا الْمَٓاءَ صَبًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40488,
            "SureId": 80,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40495,
            "SureId": 80,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "فَاَنْبَتْنَا فٖیهَا حَبًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40502,
            "SureId": 80,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "وَعِنَبًا وَقَضْبًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40509,
            "SureId": 80,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "وَزَیْتُونًا وَنَخْلًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40516,
            "SureId": 80,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "وَحَدَٓائِقَ غُلْبًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40523,
            "SureId": 80,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "وَفَاكِهَةً وَاَبًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40530,
            "SureId": 80,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "مَتَاعًا لَكُمْ وَلِاَنْعَامِكُمْؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40537,
            "SureId": 80,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "فَاِذَا جَٓاءَتِ الصَّٓاخَّةُؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 40311,
            "SureId": 80,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Yüzünü ekşitip başını çevirdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 80,
                "MealInfo": "Mekke döneminde inmiştir. 42 âyettir. Sûre, adını birinci âyetteki “abese” fiilindenalmıştır. “Abese”, “yüzünü ekşitti” demektir. Sûrede başlıca, itikat, peygamberlik,Allah’ın kudreti ve kıyamet hâlleri konu edilmektedir",
                "SureNameTurkish": "Abese",
                "SureNameArabic": "عَبَسَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 24,
                "AyetCount": 42,
                "Cuz": 30,
                "FirstPage": 585,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 40318,
            "SureId": 80,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Görme engelli o kişi geldi diye.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40325,
            "SureId": 80,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Ama (ey Peygamber!) Sen nereden bileceksin, belki o kendini arındıracaktı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40332,
            "SureId": 80,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Yahut o bir öğüt alacak, bu öğüt kendisine fayda verecekti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40339,
            "SureId": 80,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5-6",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Sen ise kendini her bakımdan ihtiyaçsız görenle ilgileniyorsun.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40346,
            "SureId": 80,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": false,
            "Page": 585,
            "AyetText": "Sen ise kendini her şeye yeterli görenle ilgileniyorsun.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40353,
            "SureId": 80,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Onun arınmamasından sen sorumlu tutulmayacaksın ki!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40360,
            "SureId": 80,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8-10",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Gönlünde Allah korkusu taşıyarak koşup sana geleni umursamıyorsun!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40367,
            "SureId": 80,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": false,
            "Page": 585,
            "AyetText": "Ama gönlünde Allah korkusu taşıyarak koşup sana gelenle ilgilenmiyorsun!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40374,
            "SureId": 80,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": false,
            "Page": 585,
            "AyetText": "Ama gönlünde Allah korkusu taşıyarak koşup sana gelenle ilgilenmiyorsun!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40381,
            "SureId": 80,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Hayır! Şüphesiz bu âyetler birer öğüttür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40388,
            "SureId": 80,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Dileyen ondan öğüt alır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40395,
            "SureId": 80,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "O, mukaddes sayfalardadır;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40402,
            "SureId": 80,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Yüce makamlara kaldırılmış, tertemiz sayfalarda.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40409,
            "SureId": 80,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15-16",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Seçkin ve erdemli elçilerin ellerinde.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40416,
            "SureId": 80,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": false,
            "Page": 585,
            "AyetText": "Seçkin ve erdemli elçilerin ellerinde.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40423,
            "SureId": 80,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Kahrolası o insan! Ne kadar da inkârcı!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40430,
            "SureId": 80,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "(Bir düşünse) Allah onu neden yarattı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40437,
            "SureId": 80,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Bir spermden yarattı da ona şekil verdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40444,
            "SureId": 80,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Sonra ona yolu kolaylaştırdı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40451,
            "SureId": 80,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Nihayet onun canını aldı ve kabre koydu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40458,
            "SureId": 80,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Sonra dilediği bir vakitte onu yeniden diriltecek.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40465,
            "SureId": 80,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Hayır! İnsan, Allah’ın emrettiğini yapmadı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40472,
            "SureId": 80,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "İnsan yediğine bir bakıp düşünsün!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40479,
            "SureId": 80,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Biz bolca su indirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40486,
            "SureId": 80,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Sonra toprağı uygun şekilde yardık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40493,
            "SureId": 80,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Oradan ekinler bitirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40500,
            "SureId": 80,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Üzüm bağları, sebzeler;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40507,
            "SureId": 80,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Zeytin ve hurma ağaçları;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40514,
            "SureId": 80,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Gür ağaçlı bahçeler;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40521,
            "SureId": 80,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Meyveler ve çayırlar;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40528,
            "SureId": 80,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Sizin ve hayvanlarınızın yararlanması için.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40535,
            "SureId": 80,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 585,
            "AyetText": "Kulakları sağır eden o ses geldiğinde,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
