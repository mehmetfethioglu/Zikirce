    "ArCuzNo": "۱٥",
    "ArPageNo": "۲۹۰",
    "QuranAyats": [
        {
            "Id": 14735,
            "SureId": 17,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "وَاِنْ كَادُوا لَیَسْتَفِزُّونَكَ مِنَ الْاَرْضِ لِیُخْرِجُوكَ مِنْهَا وَاِذًا لَا یَلْبَثُونَ خِلَافَكَ اِلَّا قَلٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14742,
            "SureId": 17,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "سُنَّةَ مَنْ قَدْ اَرْسَلْنَا قَبْلَكَ مِنْ رُسُلِنَا وَلَا تَجِدُ لِسُنَّتِنَا تَحْوٖیلًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14749,
            "SureId": 17,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "اَقِمِ الصَّلٰوةَ لِدُلُوكِ الشَّمْسِ اِلٰى غَسَقِ الَّیْلِ وَقُرْاٰنَ الْفَجْرِؕ اِنَّ قُرْاٰنَ الْفَجْرِ كَانَ مَشْهُودًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14756,
            "SureId": 17,
            "AyetId": 79,
            "LanguageId": 7,
            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "وَمِنَ الَّیْلِ فَتَهَجَّدْ بِهٖ نَافِلَةً لَكَࣗ عَسٰٓى اَنْ یَبْعَثَكَ رَبُّكَ مَقَامًا مَحْمُودًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14763,
            "SureId": 17,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "وَقُلْ رَبِّ اَدْخِلْنٖی مُدْخَلَ صِدْقٍ وَاَخْرِجْنٖی مُخْرَجَ صِدْقٍ وَاجْعَلْ لٖی مِنْ لَدُنْكَ سُلْطَانًا نَصٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14770,
            "SureId": 17,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "وَقُلْ جَٓاءَ الْحَقُّ وَزَهَقَ الْبَاطِلُؕ اِنَّ الْبَاطِلَ كَانَ زَهُوقًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14777,
            "SureId": 17,
            "AyetId": 82,
            "LanguageId": 7,
            "AyetNumber": "٨٢",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "وَنُنَزِّلُ مِنَ الْقُرْاٰنِ مَا هُوَ شِفَٓاءٌ وَرَحْمَةٌ لِلْمُؤْمِنٖینَۙ وَلَا یَزٖیدُ الظَّالِمٖینَ اِلَّا خَسَارًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14784,
            "SureId": 17,
            "AyetId": 83,
            "LanguageId": 7,
            "AyetNumber": "٨٣",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "وَاِذَٓا اَنْعَمْنَا عَلَى الْاِنْسَانِ اَعْرَضَ وَنَاٰ بِجَانِبِهٖۚ وَاِذَا مَسَّهُ الشَّرُّ كَانَ یَؤُ𐻿سًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14791,
            "SureId": 17,
            "AyetId": 84,
            "LanguageId": 7,
            "AyetNumber": "٨٤",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "قُلْ كُلٌّ یَعْمَلُ عَلٰى شَاكِلَتِهٖؕ فَرَبُّكُمْ اَعْلَمُ بِمَنْ هُوَ اَهْدٰى سَبٖیلًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14798,
            "SureId": 17,
            "AyetId": 85,
            "LanguageId": 7,
            "AyetNumber": "٨٥",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "وَیَسْـَٔلُونَكَ عَنِ الرُّوحِؕ قُلِ الرُّوحُ مِنْ اَمْرِ رَبّٖی وَمَٓا اُو𐻿تٖیتُمْ مِنَ الْعِلْمِ اِلَّا قَلٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14805,
            "SureId": 17,
            "AyetId": 86,
            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "وَلَئِنْ شِئْنَا لَنَذْهَبَنَّ بِالَّذٖٓی اَوْحَیْنَٓا اِلَیْكَ ثُمَّ لَا تَجِدُ لَكَ بِهٖ عَلَیْنَا وَكٖیلًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 14733,
            "SureId": 17,
            "AyetId": 76,
            "LanguageId": 5,
            "AyetNumber": "76",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "Yine onlar, seni yurdundan çıkarmak için neredeyse sana dünyayı dar etmişlerdi. Ama senden sonra kendileri de fazla kalamayacaklar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14740,
            "SureId": 17,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "Senden önce gönderdiğimiz peygamberler hakkındaki kanun da budur. Bizim kanunumuzda hiçbir değişiklik bulamazsın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14747,
            "SureId": 17,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "Gündüzün güneşin gün ortasını aşmasından gecenin karanlığına kadar namazı kıl; bir de sabah namazını; çünkü sabah namazı şahitlidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14754,
            "SureId": 17,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "Gecenin bir vaktinde kalkıp kendine mahsus nâfile bir ibadet olarak da namaz kıl ki, rabbin seni övülmüş bir makama yükseltsin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14761,
            "SureId": 17,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "Ve şöyle niyaz et: “Rabbim! Girilecek yere doğrulukla girmemi, çıkılacak yerden de doğrulukla çıkmamı sağla, bana tarafından yardımcı bir güç ver!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14768,
            "SureId": 17,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "De ki: “Hak geldi bâtıl yıkılıp gitti! Zaten bâtıl yıkılmaya mahkûmdur.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14775,
            "SureId": 17,
            "AyetId": 82,
            "LanguageId": 5,
            "AyetNumber": "82",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "Biz Kur’an’dan öyle bir şey indiriyoruz ki, o müminler için bir şifa, bir rahmettir; zalimlerin ise sadece ziyanını arttırır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14782,
            "SureId": 17,
            "AyetId": 83,
            "LanguageId": 5,
            "AyetNumber": "83",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "İnsana nimet verdiğimiz zaman yüz çevirip yan çizer; başına bir kötülük gelince de hemen karamsarlığa düşer.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14789,
            "SureId": 17,
            "AyetId": 84,
            "LanguageId": 5,
            "AyetNumber": "84",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "De ki: “Herkes kendi mizaç ve karakterine göre iş yapar.” Rabbiniz kimin doğru bir yol tuttuğunu çok iyi bilmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14796,
            "SureId": 17,
            "AyetId": 85,
            "LanguageId": 5,
            "AyetNumber": "85",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "Sana ruh hakkında soru sorarlar. De ki: “Ruh rabbimin emrindendir ve size pek az bilgi verilmiştir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14803,
            "SureId": 17,
            "AyetId": 86,
            "LanguageId": 5,
            "AyetNumber": "86",
            "AyetVisible": true,
            "Page": 290,
            "AyetText": "Gerçek şu ki, biz dilersek sana vahyettiğimizi ortadan kaldırırız; bundan sonra da sen bize karşı güvenip dayanacağın birini bulamazsın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "İsrâ",
    "QuranSureLabel": "الْاِسْرَاۤءِ",
    "EndPageSure": null
}