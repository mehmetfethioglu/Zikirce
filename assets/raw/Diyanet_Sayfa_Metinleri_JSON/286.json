    "QuranAyats": [
        {
            "Id": 14476,
            "SureId": 17,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "ذٰلِكَ مِمَّٓا اَوْحٰٓى اِلَیْكَ رَبُّكَ مِنَ الْحِكْمَةِؕ وَلَا تَجْعَلْ مَعَ اللّٰهِ اِلٰهًا اٰخَرَ فَتُلْقٰى فٖی جَهَنَّمَ مَلُومًا مَدْحُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14483,
            "SureId": 17,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "اَفَاَصْفٰیكُمْ رَبُّكُمْ بِالْبَنٖینَ وَاتَّخَذَ مِنَ الْمَلٰٓئِكَةِ اِنَاثًاؕ اِنَّكُمْ لَتَقُولُونَ قَوْلًا عَظٖیمًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14490,
            "SureId": 17,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "وَلَقَدْ صَرَّفْنَا فٖی هٰذَا الْقُرْاٰنِ لِیَذَّكَّرُواؕ وَمَا یَزٖیدُهُمْ اِلَّا نُفُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14497,
            "SureId": 17,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "قُلْ لَوْ كَانَ مَعَهُٓ اٰلِهَةٌ كَمَا یَقُولُونَ اِذًا لَابْتَغَوْا اِلٰى ذِی الْعَرْشِ سَبٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14504,
            "SureId": 17,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "سُبْحَانَهُ وَتَعَالٰى عَمَّا یَقُولُونَ عُلُوًّا كَبٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14511,
            "SureId": 17,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "تُسَبِّحُ لَهُ السَّمٰوَاتُ السَّبْعُ وَالْاَرْضُ وَمَنْ فٖیهِنَّؕ وَاِنْ مِنْ شَیْءٍ اِلَّا یُسَبِّحُ بِحَمْدِهٖ وَلٰكِنْ لَا تَفْقَهُونَ تَسْبٖیحَهُمْؕ اِنَّهُ كَانَ حَلٖیمًا غَفُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14518,
            "SureId": 17,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "وَاِذَا قَرَاْتَ الْقُرْاٰنَ جَعَلْنَا بَیْنَكَ وَبَیْنَ الَّذٖینَ لَا یُؤْمِنُونَ بِالْاٰخِرَةِ حِجَابًا مَسْتُورًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14525,
            "SureId": 17,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "وَجَعَلْنَا عَلٰى قُلُوبِهِمْ اَكِنَّةً اَنْ یَفْقَهُوهُ وَفٖٓی اٰذَانِهِمْ وَقْرًاؕ وَاِذَا ذَكَرْتَ رَبَّكَ فِی الْقُرْاٰنِ وَحْدَهُ وَلَّوْا عَلٰٓى اَدْبَارِهِمْ نُفُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14532,
            "SureId": 17,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "نَحْنُ اَعْلَمُ بِمَا یَسْتَمِعُونَ بِهٖٓ اِذْ یَسْتَمِعُونَ اِلَیْكَ وَاِذْ هُمْ نَجْوٰٓى اِذْ یَقُولُ الظَّالِمُونَ اِنْ تَتَّبِعُونَ اِلَّا رَجُلًا مَسْحُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14539,
            "SureId": 17,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "اُنْظُرْ كَیْفَ ضَرَبُوا لَكَ الْاَمْثَالَ فَضَلُّوا فَلَا یَسْتَطٖیعُونَ سَبٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14546,
            "SureId": 17,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "وَقَالُٓوا ءَاِذَا كُنَّا عِظَامًا وَرُفَاتًا ءَاِنَّا لَمَبْعُوثُونَ خَلْقًا جَدٖیدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 14474,
            "SureId": 17,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "İşte bunlar, rabbinin sana vahyettiği hikmetlerdir. Allah’tan başka tanrı tanıma; sonra kınanmış ve kovulmuş olarak cehenneme atılırsın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14481,
            "SureId": 17,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "Rabbiniz erkek çocukları size verdi de kendisi meleklerden kız çocuklar mı edindi? Gerçekten siz çok ağır bir söz söylüyorsunuz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14488,
            "SureId": 17,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "İyice düşünmeleri için bu Kur’an’da ayrıntılı açıklamalar yaptık. Ama bu, sadece onların haktan uzaklaşmalarını arttırıyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14495,
            "SureId": 17,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "De ki: Eğer söyledikleri gibi Allah’tan başka ilâhlar olsaydı onlar da arşın sahibine yakınlaşmak için yollar ararlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14502,
            "SureId": 17,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "Allah onların söylediği şeylerden münezzehtir, çok çok yücedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14509,
            "SureId": 17,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "Yedi gök, yer ve bunlarda bulunanlar O’nu tesbih eder; O’nu hamd ile tesbih etmeyen hiçbir şey yoktur. Fakat siz onların tesbihini anlayamazsınız. O halîmdir, bağışlayıcıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14516,
            "SureId": 17,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "Kur’an okuduğun zaman seninle, âhirete inanmayanlar arasına gizli bir perde çekeriz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14523,
            "SureId": 17,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "Ayrıca onu anlamamaları için kalplerinin üzerine örtüler, kulaklarına da bir tıkaç koyarız. Sen rabbinin Kur’an’daki ismini tek başına andığında canları sıkılmış olarak arkalarını dönüp giderler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14530,
            "SureId": 17,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "Biz onların seni dinlerken neye kulak verdiklerini, kendi aralarında fısıldaşırken de o zalimlerin, “Siz, sadece büyülenmiş bir adama uyuyorsunuz!” dediklerini çok iyi biliyoruz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14537,
            "SureId": 17,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "Bak işte, senin hakkında ne türlü benzetmeler yapıyorlar! Böylece yoldan saptılar, bir daha da doğru yolu bulamıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14544,
            "SureId": 17,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 286,
            "AyetText": "Dediler ki: “Biz bir kemik yığını haline gelmiş, ufalanmışken yepyeni bir yaratmayla dirilecek mişiz, öyle mi?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "İsrâ",
