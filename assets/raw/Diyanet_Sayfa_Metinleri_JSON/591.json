            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 591,
            "AyetText": "Kuşku yok ki başta yaratan da sonra tekrar yaratacak olan da O’dur",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
