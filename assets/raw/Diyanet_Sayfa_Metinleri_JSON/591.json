            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41536,
            "SureId": 86,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 591,
            "AyetText": "Karanlığı delen yıldızdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41543,
            "SureId": 86,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 591,
            "AyetText": "Hiç kimse yoktur ki, başında bir gözetleyeni bulunmasın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41550,
            "SureId": 86,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 591,
            "AyetText": "İnsan neden yaratıldığına bir baksın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41557,
            "SureId": 86,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 591,
            "AyetText": "O, atılan bir sudan yaratıldı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41564,
            "SureId": 86,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 591,
            "AyetText": "O su, bel ve göğüs kafesi arasından çıkar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41571,
            "SureId": 86,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 591,
            "AyetText": "Şüphesiz Allah onu (öldükten sonra) tekrar yaratmaya elbette kādirdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41578,
            "SureId": 86,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9-10",
            "AyetVisible": true,
            "Page": 591,
            "AyetText": "O gün bütün sırlar ortaya dökülecek; artık insanın ne bir gücü vardır ne de yardımcısı.",
