            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14-16",
            "AyetVisible": true,
            "Page": 591,
            "AyetText": "Çok bağışlayan, sevgisi geniş, arşın sahibi, şanı yüce ve dilediğini yapan yalnız O’dur.",
            "Recitation": "",
            "AyetMeta": null,
