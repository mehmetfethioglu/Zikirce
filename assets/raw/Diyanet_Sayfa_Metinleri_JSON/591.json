            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 86,
                "MealInfo": "Mekke döneminde inmiştir. 17 âyettir. Sûre, adını birinci âyetteki “et-Târık”kelimesinden almıştır. Târık, şiddetle çarpan, vuran, gece gelen şey demektir.",
