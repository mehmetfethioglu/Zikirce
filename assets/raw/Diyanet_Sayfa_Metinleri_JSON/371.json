            "AyetNumber": "٨٤",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "وَاجْعَلْ لٖی لِسَانَ صِدْقٍ فِی الْاٰخِرٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 21119,
            "SureId": 26,
            "AyetId": 85,
            "LanguageId": 7,
            "AyetNumber": "٨٥",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "وَاجْعَلْنٖی مِنْ وَرَثَةِ جَنَّةِ النَّعٖیمِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21126,
            "SureId": 26,
            "AyetId": 86,
            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "وَاغْفِرْ لِاَبٖٓی اِنَّهُ كَانَ مِنَ الضَّٓالّٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21133,
            "SureId": 26,
            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "وَلَا تُخْزِنٖی یَوْمَ یُبْعَثُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21140,
            "SureId": 26,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "یَوْمَ لَا یَنْفَعُ مَالٌ وَلَا بَنُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21147,
            "SureId": 26,
            "AyetId": 89,
            "LanguageId": 7,
            "AyetNumber": "٨٩",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "اِلَّا مَنْ اَتَى اللّٰهَ بِقَلْبٍ سَلٖیمٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21154,
            "SureId": 26,
            "AyetId": 90,
            "LanguageId": 7,
            "AyetNumber": "٩٠",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "وَاُزْلِفَتِ الْجَنَّةُ لِلْمُتَّقٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21161,
            "SureId": 26,
            "AyetId": 91,
            "LanguageId": 7,
            "AyetNumber": "٩١",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "وَبُرِّزَتِ الْجَحٖیمُ لِلْغَاوٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21168,
            "SureId": 26,
            "AyetId": 92,
            "LanguageId": 7,
            "AyetNumber": "٩٢",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "وَقٖیلَ لَهُمْ اَیْنَ مَا كُنْتُمْ تَعْبُدُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21175,
            "SureId": 26,
            "AyetId": 93,
            "LanguageId": 7,
            "AyetNumber": "٩٣",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "مِنْ دُونِ اللّٰهِؕ هَلْ یَنْصُرُونَكُمْ اَوْ یَنْتَصِرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21182,
            "SureId": 26,
            "AyetId": 94,
            "LanguageId": 7,
            "AyetNumber": "٩٤",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "فَكُبْكِبُوا فٖیهَا هُمْ وَالْغَاوُ𐻿نَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21189,
            "SureId": 26,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "وَجُنُودُ اِبْلٖیسَ اَجْمَعُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21196,
            "SureId": 26,
            "AyetId": 96,
            "LanguageId": 7,
            "AyetNumber": "٩٦",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "قَالُوا وَهُمْ فٖیهَا یَخْتَصِمُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21203,
            "SureId": 26,
            "AyetId": 97,
            "LanguageId": 7,
            "AyetNumber": "٩٧",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "تَاللّٰهِ اِنْ كُنَّا لَفٖی ضَلَالٍ مُبٖینٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21210,
            "SureId": 26,
            "AyetId": 98,
            "LanguageId": 7,
            "AyetNumber": "٩٨",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "اِذْ نُسَوّٖیكُمْ بِرَبِّ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21217,
            "SureId": 26,
            "AyetId": 99,
            "LanguageId": 7,
            "AyetNumber": "٩٩",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "وَمَٓا اَضَلَّنَٓا اِلَّا الْمُجْرِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21224,
            "SureId": 26,
            "AyetId": 100,
            "LanguageId": 7,
            "AyetNumber": "١٠٠",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "فَمَا لَنَا مِنْ شَافِعٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21231,
            "SureId": 26,
            "AyetId": 101,
            "LanguageId": 7,
            "AyetNumber": "١٠١",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "وَلَا صَدٖیقٍ حَمٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21238,
            "SureId": 26,
            "AyetId": 102,
            "LanguageId": 7,
            "AyetNumber": "١٠٢",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "فَلَوْ اَنَّ لَنَا كَرَّةً فَنَكُونَ مِنَ الْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21245,
            "SureId": 26,
            "AyetId": 103,
            "LanguageId": 7,
            "AyetNumber": "١٠٣",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "اِنَّ فٖی ذٰلِكَ لَاٰیَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21252,
            "SureId": 26,
            "AyetId": 104,
            "LanguageId": 7,
            "AyetNumber": "١٠٤",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "وَاِنَّ رَبَّكَ لَهُوَ الْعَزٖیزُ الرَّحٖیمُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21259,
            "SureId": 26,
            "AyetId": 105,
            "LanguageId": 7,
            "AyetNumber": "١٠٥",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "كَذَّبَتْ قَوْمُ نُوحٍࣙ الْمُرْسَلٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21266,
            "SureId": 26,
            "AyetId": 106,
            "LanguageId": 7,
            "AyetNumber": "١٠٦",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "اِذْ قَالَ لَهُمْ اَخُوهُمْ نُوحٌ اَلَا تَتَّقُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21273,
            "SureId": 26,
            "AyetId": 107,
            "LanguageId": 7,
            "AyetNumber": "١٠٧",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "اِنّٖی لَكُمْ رَسُولٌ اَمٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21280,
            "SureId": 26,
            "AyetId": 108,
            "LanguageId": 7,
            "AyetNumber": "١٠٨",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "فَاتَّقُوا اللّٰهَ وَاَطٖیعُونِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21287,
            "SureId": 26,
            "AyetId": 109,
            "LanguageId": 7,
            "AyetNumber": "١٠٩",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "وَمَٓا اَسْـَٔلُكُمْ عَلَیْهِ مِنْ اَجْرٍۚ اِنْ اَجْرِیَ اِلَّا عَلٰى رَبِّ الْعَالَمٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21294,
            "SureId": 26,
            "AyetId": 110,
            "LanguageId": 7,
            "AyetNumber": "١١٠",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "فَاتَّقُوا اللّٰهَ وَاَطٖیعُونِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21301,
            "SureId": 26,
            "AyetId": 111,
            "LanguageId": 7,
            "AyetNumber": "١١١",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "قَالُٓوا اَنُؤْمِنُ لَكَ وَاتَّبَعَكَ الْاَرْذَلُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
