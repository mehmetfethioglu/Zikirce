            "AyetId": 85,
            "LanguageId": 5,
            "AyetNumber": "85",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "Beni, naîm cennetine girenlerden eyle!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21124,
            "SureId": 26,
            "AyetId": 86,
            "LanguageId": 5,
            "AyetNumber": "86",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "Babamı da bağışla; kuşkusuz o doğru yoldan sapanlardan oldu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21131,
            "SureId": 26,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87-89",
            "AyetVisible": true,
            "Page": 371,
            "AyetText": "İnsanların diriltileceği gün ve Allah’a temiz bir kalple gelenler dışında malın da çocukların da fayda vermeyeceği gün beni mahcup etme!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21138,
            "SureId": 26,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": false,
            "Page": 371,
            "AyetText": "İnsanların diriltileceği gün ve Allah’a temiz bir kalple gelenler dışında malın da çocukların da fayda vermeyeceği gün beni mahcup etme!\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
