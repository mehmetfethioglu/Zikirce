            "AyetId": 93,
            "LanguageId": 7,
            "AyetNumber": "٩٣",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "عَمَّا كَانُوا یَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13272,
            "SureId": 15,
            "AyetId": 94,
            "LanguageId": 7,
            "AyetNumber": "٩٤",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "فَاصْدَعْ بِمَا تُؤْمَرُ وَاَعْرِضْ عَنِ الْمُشْرِكٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13279,
            "SureId": 15,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "اِنَّا كَفَیْنَاكَ الْمُسْتَهْزِءٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13286,
            "SureId": 15,
            "AyetId": 96,
            "LanguageId": 7,
            "AyetNumber": "٩٦",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "اَلَّذٖینَ یَجْعَلُونَ مَعَ اللّٰهِ اِلٰهًا اٰخَرَۚ فَسَوْفَ یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13293,
            "SureId": 15,
            "AyetId": 97,
            "LanguageId": 7,
            "AyetNumber": "٩٧",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "وَلَقَدْ نَعْلَمُ اَنَّكَ یَضٖیقُ صَدْرُكَ بِمَا یَقُولُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13300,
            "SureId": 15,
            "AyetId": 98,
            "LanguageId": 7,
            "AyetNumber": "٩٨",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "فَسَبِّـحْ بِحَمْدِ رَبِّكَ وَكُنْ مِنَ السَّاجِدٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13307,
            "SureId": 15,
            "AyetId": 99,
            "LanguageId": 7,
            "AyetNumber": "٩٩",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "وَاعْبُدْ رَبَّكَ حَتّٰى یَاْتِیَكَ الْیَقٖینُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13314,
            "SureId": 16,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "اَتٰٓى اَمْرُ اللّٰهِ فَلَا تَسْتَعْجِلُوهُؕ سُبْحَانَهُ وَتَعَالٰى عَمَّا یُشْرِكُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
                "Cuz": 14,
                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 13321,
            "SureId": 16,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "یُنَزِّلُ الْمَلٰٓئِكَةَ بِالرُّوحِ مِنْ اَمْرِهٖ عَلٰى مَنْ یَشَٓاءُ مِنْ عِبَادِهٖٓ اَنْ اَنْذِرُٓوا اَنَّهُ لَٓا اِلٰهَ اِلَّٓا اَنَا𐻾 فَاتَّقُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13328,
            "SureId": 16,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "خَلَقَ السَّمٰوَاتِ وَالْاَرْضَ بِالْحَقِّؕ تَعَالٰى عَمَّا یُشْرِكُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13335,
            "SureId": 16,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "خَلَقَ الْاِنْسَانَ مِنْ نُطْفَةٍ فَاِذَا هُوَ خَصٖیمٌ مُبٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13342,
            "SureId": 16,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "وَالْاَنْعَامَ خَلَقَهَاۚ لَكُمْ فٖیهَا دِفْءٌ وَمَنَافِعُ وَمِنْهَا تَاْكُلُونَࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13349,
            "SureId": 16,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "وَلَكُمْ فٖیهَا جَمَالٌ حٖینَ تُرٖیحُونَ وَحٖینَ تَسْرَحُونَࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
