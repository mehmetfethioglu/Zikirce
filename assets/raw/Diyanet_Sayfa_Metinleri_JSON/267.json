            "SureId": 15,
            "AyetId": 95,
            "LanguageId": 5,
            "AyetNumber": "95-96",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "Allah’ın yanında başka bir tanrı daha edinen o alaycılara karşı biz senin yanındayız. Onlar ileride anlayacaklar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
