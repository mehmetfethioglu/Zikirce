            "AyetId": 92,
            "LanguageId": 7,
            "AyetNumber": "٩٢",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "فَوَرَبِّكَ لَنَسْـَٔلَنَّهُمْ اَجْمَعٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
