            "SureId": 15,
            "AyetId": 94,
            "LanguageId": 5,
            "AyetNumber": "94",
            "AyetVisible": true,
            "Page": 267,
            "AyetText": "Sen, sana buyurulanı açıkça duyur, müşriklere aldırış etme!",
