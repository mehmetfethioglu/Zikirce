    "QuranAyats": [
        {
            "Id": 29736,
            "SureId": 41,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "اِنَّ الَّذٖینَ قَالُوا رَبُّنَا اللّٰهُ ثُمَّ اسْتَقَامُوا تَتَنَزَّلُ عَلَیْهِمُ الْمَلٰٓئِكَةُ اَلَّا تَخَافُوا وَلَا تَحْزَنُوا وَاَبْشِرُوا بِالْجَنَّةِ الَّتٖی كُنْتُمْ تُوعَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 41,
                "MealInfo": "Mekke döneminde inmiştir. 54 âyettir. Sûre, adını üçüncü âyette geçen ve Kur’an âyetlerini niteleyen <b>“fussilet”</b> ifadesinden almıştır. <b>“Fussilet”, “genişçe açıkland</b>ı” demektir. Sûre, ayrıca<b> “Hâ Mîm es-Secde”</b> diye de anılır. Sûrede başlıca <b>hakka davet, batılda ısrar edenlerin uyarılması, vahyin insanlar üzerindeki ahlâkî ve manevî etkileri </b>konu edilmektedir.",
                "SureNameTurkish": "Fussilet",
                "SureNameArabic": "فُصِّلَتْ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 61,
                "AyetCount": 54,
                "Cuz": 24,
                "FirstPage": 477,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 29743,
            "SureId": 41,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "نَحْنُ اَوْلِیَٓاؤُ𐻾كُمْ فِی الْحَیٰوةِ الدُّنْیَا وَفِی الْاٰخِرَةِۚ وَلَكُمْ فٖیهَا مَا تَشْتَهٖٓی اَنْفُسُكُمْ وَلَكُمْ فٖیهَا مَا تَدَّعُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29750,
            "SureId": 41,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "نُزُلًا مِنْ غَفُورٍ رَحٖیمٍࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29757,
            "SureId": 41,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "وَمَنْ اَحْسَنُ قَوْلًا مِمَّنْ دَعَٓا اِلَى اللّٰهِ وَعَمِلَ صَالِحًا وَقَالَ اِنَّنٖی مِنَ الْمُسْلِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29764,
            "SureId": 41,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "وَلَا تَسْتَوِی الْحَسَنَةُ وَلَا السَّیِّئَةُؕ اِدْفَعْ بِالَّتٖی هِیَ اَحْسَنُ فَاِذَا الَّذٖی بَیْنَكَ وَبَیْنَهُ عَدَاوَةٌ كَاَنَّهُ وَلِیٌّ حَمٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29771,
            "SureId": 41,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "وَمَا یُلَقّٰیهَٓا اِلَّا الَّذٖینَ صَبَرُواۚ وَمَا یُلَقّٰیهَٓا اِلَّا ذُوحَظٍّ عَظٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29778,
            "SureId": 41,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "وَاِمَّا یَنْزَغَنَّكَ مِنَ الشَّیْطَانِ نَزْغٌ فَاسْتَعِذْ بِاللّٰهِؕ اِنَّهُ هُوَ السَّمٖیعُ الْعَلٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29785,
            "SureId": 41,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "وَمِنْ اٰیَاتِهِ الَّیْلُ وَالنَّهَارُ وَالشَّمْسُ وَالْقَمَرُؕ لَا تَسْجُدُوا لِلشَّمْسِ وَلَا لِلْقَمَرِ وَاسْجُدُوا لِلّٰهِ الَّذٖی خَلَقَهُنَّ اِنْ كُنْتُمْ اِیَّاهُ تَعْبُدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29792,
            "SureId": 41,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "فَاِنِ اسْتَكْبَرُوا فَالَّذٖینَ عِنْدَ رَبِّكَ یُسَبِّحُونَ لَهُ بِالَّیْلِ وَالنَّهَارِ وَهُمْ لَا یَسْـَٔمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 29734,
            "SureId": 41,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "“Rabbimiz Allah’tır” deyip de dosdoğru çizgide yaşayanlar, işte onların üzerine melekler şu müjdeyle inerler: “Korkmayın, kederlenmeyin, size vaad olunan cennetle sevinin!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 41,
                "MealInfo": "Mekke döneminde inmiştir. 54 âyettir. Sûre, adını üçüncü âyette geçen ve Kur’an âyetlerini niteleyen <b>“fussilet”</b> ifadesinden almıştır. <b>“Fussilet”, “genişçe açıkland</b>ı” demektir. Sûre, ayrıca<b> “Hâ Mîm es-Secde”</b> diye de anılır. Sûrede başlıca <b>hakka davet, batılda ısrar edenlerin uyarılması, vahyin insanlar üzerindeki ahlâkî ve manevî etkileri </b>konu edilmektedir.",
                "SureNameTurkish": "Fussilet",
                "SureNameArabic": "فُصِّلَتْ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 61,
                "AyetCount": 54,
                "Cuz": 24,
                "FirstPage": 477,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 29741,
            "SureId": 41,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31-32",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "Biz, dünya hayatında da âhirette de sizin dostunuzuz. Orada, çok bağışlayıcı, çok merhametli olan Allah’tan bir ikram olarak sizin için canınızın çektiği her şey bulunacak, yine orada umduğunuz her şeyi elde edeceksiniz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29748,
            "SureId": 41,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": false,
            "Page": 480,
            "AyetText": "Biz, dünya hayatında da âhirette de sizin dostunuzuz. Orada, çok bağışlayıcı, çok merhametli olan Allah’tan bir ikram olarak sizin için canınızın çektiği her şey bulunacak, yine orada umduğunuz her şeyi elde edeceksiniz.\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29755,
            "SureId": 41,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "Allah’a çağıran, dine ve dünyaya yararlı iş yapan ve “Ben müslümanlardanım” diyenden daha güzel sözlü kim vardır?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29762,
            "SureId": 41,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "İyilikle kötülük bir olmaz. Sen (kötülüğü) en güzel olan davranışla sav; o zaman bir de göreceksin ki seninle aranızda düşmanlık bulunan kimse kesinlikle sıcak bir dost oluvermiş!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29769,
            "SureId": 41,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "Bu sonuca ancak sabırlı olanlar ulaşabilir, yine buna ancak (erdemlerde) büyük pay sahibi olanlar ulaşabilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29776,
            "SureId": 41,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "Eğer şeytandan sana bir fitleme gelirse hemen Allah’a sığın! Allah işitendir, bilendir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29783,
            "SureId": 41,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "Gece ve gündüz, güneş ve ay O’nun işaretlerindendir. Eğer gerçekten Allah’a tapıyorsanız güneşe de aya da secde etmeyin, onları yaratan Allah’a secde edin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 29790,
            "SureId": 41,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 480,
            "AyetText": "Şayet kibirlerine yediremezlerse bilsinler ki rabbinin katında bulunanlar bıkıp usanmadan, gece gündüz O’nu tesbih etmektedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
