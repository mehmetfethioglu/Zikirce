{
    "PointerList": null,
    "CuzNo": 20,
    "PageNo": 383,
    "ArCuzNo": "۲۰",
    "ArPageNo": "۳۸۳",
    "QuranAyats": [
        {
            "Id": 22561,
            "SureId": 27,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "اَمَّنْ یَبْدَؤُا الْخَلْقَ ثُمَّ یُعٖیدُهُ وَمَنْ یَرْزُقُكُمْ مِنَ السَّمَٓاءِ وَالْاَرْضِؕ ءَاِلٰهٌ مَعَ اللّٰهِؕ قُلْ هَاتُوا بُرْهَانَكُمْ اِنْ كُنْتُمْ صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 27,
                "MealInfo": "Mekke döneminde inmiştir. 93 âyettir. Sûre, adını 18. âyette yer alan <b>“enNeml</b>” kelimesinden almaktadır. <b>Neml, karınca demektir. </b>Sûre de başlıca, <b>Süleyman peygamber ve Sebe’ melikesi, Belkıs kıssası ile Salih ve Lût peygamberler&nbsp;</b>konu edilmekte, ayrıca mü’minlerin kurtuluşa ereceği, İslâm karşıtlarının kötü akıbetleri, öldükten sonra dirilmek ve kıyamet dile getirilmektedir.",
                "SureNameTurkish": "Neml",
                "SureNameArabic": "النَّمْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 48,
                "AyetCount": 93,
                "Cuz": 19,
                "FirstPage": 377,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 22568,
            "SureId": 27,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "قُلْ لَا یَعْلَمُ مَنْ فِی السَّمٰوَاتِ وَالْاَرْضِ الْغَیْبَ اِلَّا اللّٰهُؕ وَمَا یَشْعُرُونَ اَیَّانَ یُبْعَثُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22575,
            "SureId": 27,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "بَلِ ادَّارَكَ عِلْمُهُمْ فِی الْاٰخِرَةِࣞ بَلْ هُمْ فٖی شَكٍّ مِنْهَاࣞ بَلْ هُمْ مِنْهَا عَمُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22582,
            "SureId": 27,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "وَقَالَ الَّذٖینَ كَفَرُٓوا ءَاِذَا كُنَّا تُرَابًا وَاٰبَٓاؤُ𐻾نَٓا اَئِنَّا لَمُخْرَجُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22589,
            "SureId": 27,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "لَقَدْ وُعِدْنَا هٰذَا نَحْنُ وَاٰبَٓاؤُ𐻾نَا مِنْ قَبْلُۙ اِنْ هٰذَٓا اِلَّٓا اَسَاطٖیرُ الْاَوَّلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22596,
            "SureId": 27,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "قُلْ سٖیرُوا فِی الْاَرْضِ فَانْظُرُوا كَیْفَ كَانَ عَاقِبَةُ الْمُجْرِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22603,
            "SureId": 27,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "وَلَا تَحْزَنْ عَلَیْهِمْ وَلَا تَكُنْ فٖی ضَیْقٍ مِمَّا یَمْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22610,
            "SureId": 27,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "وَیَقُولُونَ مَتٰى هٰذَا الْوَعْدُ اِنْ كُنْتُمْ صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22617,
            "SureId": 27,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "قُلْ عَسٰٓى اَنْ یَكُونَ رَدِفَ لَكُمْ بَعْضُ الَّذٖی تَسْتَعْجِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22624,
            "SureId": 27,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "وَاِنَّ رَبَّكَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلٰكِنَّ اَكْثَرَهُمْ لَا یَشْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22631,
            "SureId": 27,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "وَاِنَّ رَبَّكَ لَیَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا یُعْلِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22638,
            "SureId": 27,
            "AyetId": 75,
            "LanguageId": 7,
            "AyetNumber": "٧٥",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "وَمَا مِنْ غَٓائِبَةٍ فِی السَّمَٓاءِ وَالْاَرْضِ اِلَّا فٖی كِتَابٍ مُبٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22645,
            "SureId": 27,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "اِنَّ هٰذَا الْقُرْاٰنَ یَقُصُّ عَلٰى بَنٖٓی اِسْرَٓایٖٔلَ اَكْثَرَ الَّذٖی هُمْ فٖیهِ یَخْتَلِفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 22559,
            "SureId": 27,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "Peki ilk baştan yaratan, sonra yaratmayı (durmaksızın) tekrar eden kim? Size hem gökten hem yerden rızık veren kim? Allah’tan başka bir tanrı mı? De ki: “Eğer doğru söylüyorsanız kesin delilinizi getirin bakalım!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 27,
                "MealInfo": "Mekke döneminde inmiştir. 93 âyettir. Sûre, adını 18. âyette yer alan <b>“enNeml</b>” kelimesinden almaktadır. <b>Neml, karınca demektir. </b>Sûre de başlıca, <b>Süleyman peygamber ve Sebe’ melikesi, Belkıs kıssası ile Salih ve Lût peygamberler&nbsp;</b>konu edilmekte, ayrıca mü’minlerin kurtuluşa ereceği, İslâm karşıtlarının kötü akıbetleri, öldükten sonra dirilmek ve kıyamet dile getirilmektedir.",
                "SureNameTurkish": "Neml",
                "SureNameArabic": "النَّمْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 48,
                "AyetCount": 93,
                "Cuz": 19,
                "FirstPage": 377,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 22566,
            "SureId": 27,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "De ki: “Allah’tan başka göklerde olsun yerde olsun hiç kimse gaybı bilemez.” Onlar ne zaman diriltileceklerini de bilmezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22573,
            "SureId": 27,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "Hayır, onların âhiret hakkındaki bilgileri yetersiz kalmıştır; dahası, bu hususta şüphe içindedirler; bunun da ötesinde onlar âhiretten yana kördürler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22580,
            "SureId": 27,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "İnkârcılar dediler ki: “Sahi, biz ve atalarımız toprak olunca mı diriltilip (hayat alanına) çıkarılacak mışız?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22587,
            "SureId": 27,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "Doğrusu bu tehdit bize yapıldığı gibi daha önce atalarımıza da yapılmıştı. Ama bu, eskilerin masallarından başka bir şey değildir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22594,
            "SureId": 27,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "De ki: “Yeryüzünde dolaşın da günahkârların sonu nice oldu, görün!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22601,
            "SureId": 27,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "Sen de onların yüzünden üzülme, tuzak kurmalarından dolayı da canını sıkma.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22608,
            "SureId": 27,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "“Eğer doğru söylüyorsanız bu tehdit ne zaman gerçekleşecek?” diye soruyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22615,
            "SureId": 27,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "De ki: “Çabucak gelmesini istediğiniz azabın bir kısmı belki de tepenize inmek üzeredir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22622,
            "SureId": 27,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "Şüphesiz rabbin insanlara karşı lutuf sahibidir; fakat onların çoğu şükretmezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22629,
            "SureId": 27,
            "AyetId": 74,
            "LanguageId": 5,
            "AyetNumber": "74",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "Rabbin onların kalplerinde gizlediklerini de açığa vurduklarını da elbette bilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22636,
            "SureId": 27,
            "AyetId": 75,
            "LanguageId": 5,
            "AyetNumber": "75",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "Gökte ve yerde gözlerden gizli hiçbir şey yoktur ki apaçık bir kitapta yer almasın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22643,
            "SureId": 27,
            "AyetId": 76,
            "LanguageId": 5,
            "AyetNumber": "76",
            "AyetVisible": true,
            "Page": 383,
            "AyetText": "Doğrusu bu Kur’an, İsrâiloğulları’na, üzerinde anlaşamadıkları pek çok şeyi ­açıklamaktadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Neml",
