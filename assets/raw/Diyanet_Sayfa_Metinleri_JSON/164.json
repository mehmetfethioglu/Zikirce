    "QuranAyats": [
        {
            "Id": 7413,
            "SureId": 7,
            "AyetId": 105,
            "LanguageId": 7,
            "AyetNumber": "١٠٥",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "حَقٖیقٌ عَلٰٓى اَنْ لَٓا اَقُولَ عَلَى اللّٰهِ اِلَّا الْحَقَّؕ قَدْ جِئْتُكُمْ بِبَیِّنَةٍ مِنْ رَبِّكُمْ فَاَرْسِلْ مَعِیَ بَنٖٓی اِسْرَٓایٖٔلَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 7,
                "MealInfo": "Mekke döneminde inmiştir. 163-170. âyetlerin Medine döneminde indiğini söyleyen âlimler de vardır. 206 âyettir. Sûre, adını 46. ve 48. âyetlerde geçen<b>“el-A’râf ” </b>kelimesinden almıştır. <b>“el-A’râf ”, <i>yüksek yerler, yüksek mevkiler</i> demektir</b>. Sûrede temel konu olarak, ilâhî vahyin doğruluğu ve vahye duyulan ihtiyaç işlenmektedir.",
                "SureNameTurkish": "A'râf",
                "SureNameArabic": "الْاَعْرَافِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 39,
                "AyetCount": 206,
                "Cuz": 8,
                "FirstPage": 151,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 7420,
            "SureId": 7,
            "AyetId": 106,
            "LanguageId": 7,
            "AyetNumber": "١٠٦",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "قَالَ اِنْ كُنْتَ جِئْتَ بِاٰیَةٍ فَاْتِ بِهَٓا اِنْ كُنْتَ مِنَ الصَّادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7427,
            "SureId": 7,
            "AyetId": 107,
            "LanguageId": 7,
            "AyetNumber": "١٠٧",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "فَاَلْقٰى عَصَاهُ فَاِذَا هِیَ ثُعْبَانٌ مُبٖینٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7434,
            "SureId": 7,
            "AyetId": 108,
            "LanguageId": 7,
            "AyetNumber": "١٠٨",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "وَنَزَعَ یَدَهُ فَاِذَا هِیَ بَیْضَٓاءُ لِلنَّاظِرٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7441,
            "SureId": 7,
            "AyetId": 109,
            "LanguageId": 7,
            "AyetNumber": "١٠٩",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "قَالَ الْمَلَاُ مِنْ قَوْمِ فِرْعَوْنَ اِنَّ هٰذَا لَسَاحِرٌ عَلٖیمٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7448,
            "SureId": 7,
            "AyetId": 110,
            "LanguageId": 7,
            "AyetNumber": "١١٠",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "یُرٖیدُ اَنْ یُخْرِجَكُمْ مِنْ اَرْضِكُمْۚ فَمَاذَا تَاْمُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7455,
            "SureId": 7,
            "AyetId": 111,
            "LanguageId": 7,
            "AyetNumber": "١١١",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "قَالُٓوا اَرْجِهْ وَاَخَاهُ وَاَرْسِلْ فِی الْمَدَٓائِنِ حَاشِرٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7462,
            "SureId": 7,
            "AyetId": 112,
            "LanguageId": 7,
            "AyetNumber": "١١٢",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "یَاْتُوكَ بِكُلِّ سَاحِرٍ عَلٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7469,
            "SureId": 7,
            "AyetId": 113,
            "LanguageId": 7,
            "AyetNumber": "١١٣",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "وَجَٓاءَ السَّحَرَةُ فِرْعَوْنَ قَالُٓوا اِنَّ لَنَا لَاَجْرًا اِنْ كُنَّا نَحْنُ الْغَالِبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7476,
            "SureId": 7,
            "AyetId": 114,
            "LanguageId": 7,
            "AyetNumber": "١١٤",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "قَالَ نَعَمْ وَاِنَّكُمْ لَمِنَ الْمُقَرَّبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7483,
            "SureId": 7,
            "AyetId": 115,
            "LanguageId": 7,
            "AyetNumber": "١١٥",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "قَالُوا یَا مُوسٰٓى اِمَّٓا اَنْ تُلْقِیَ وَاِمَّٓا اَنْ نَكُونَ نَحْنُ الْمُلْقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7490,
            "SureId": 7,
            "AyetId": 116,
            "LanguageId": 7,
            "AyetNumber": "١١٦",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "قَالَ اَلْقُواۚ فَلَمَّٓا اَلْقَوْا سَحَرُٓوا اَعْیُنَ النَّاسِ وَاسْتَرْهَبُوهُمْ وَجَٓاؤُ𐻿 بِسِحْرٍ عَظٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7497,
            "SureId": 7,
            "AyetId": 117,
            "LanguageId": 7,
            "AyetNumber": "١١٧",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "وَاَوْحَیْنَٓا اِلٰى مُوسٰٓى اَنْ اَلْقِ عَصَاكَۚ فَاِذَا هِیَ تَلْقَفُ مَا یَاْفِكُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7504,
            "SureId": 7,
            "AyetId": 118,
            "LanguageId": 7,
            "AyetNumber": "١١٨",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "فَوَقَعَ الْحَقُّ وَبَطَلَ مَا كَانُوا یَعْمَلُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7511,
            "SureId": 7,
            "AyetId": 119,
            "LanguageId": 7,
            "AyetNumber": "١١٩",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "فَغُلِبُوا هُنَالِكَ وَانْقَلَبُوا صَاغِرٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7518,
            "SureId": 7,
            "AyetId": 120,
            "LanguageId": 7,
            "AyetNumber": "١٢٠",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "وَاُلْقِیَ السَّحَرَةُ سَاجِدٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 7411,
            "SureId": 7,
            "AyetId": 105,
            "LanguageId": 5,
            "AyetNumber": "105",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "“Allah hakkında gerçek olandan başkasını söylememek benim üzerime borçtur. Size rabbinizden açık bir delil getirdim. Artık İsrâiloğulları’nı benimle birlikte serbest bırak.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 7,
                "MealInfo": "Mekke döneminde inmiştir. 163-170. âyetlerin Medine döneminde indiğini söyleyen âlimler de vardır. 206 âyettir. Sûre, adını 46. ve 48. âyetlerde geçen<b>“el-A’râf ” </b>kelimesinden almıştır. <b>“el-A’râf ”, <i>yüksek yerler, yüksek mevkiler</i> demektir</b>. Sûrede temel konu olarak, ilâhî vahyin doğruluğu ve vahye duyulan ihtiyaç işlenmektedir.",
                "SureNameTurkish": "A'râf",
                "SureNameArabic": "الْاَعْرَافِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 39,
                "AyetCount": 206,
                "Cuz": 8,
                "FirstPage": 151,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 7418,
            "SureId": 7,
            "AyetId": 106,
            "LanguageId": 5,
            "AyetNumber": "106",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "Firavun şöyle dedi: “Eğer bir mûcize getirdiysen ve gerçekten doğru söylüyorsan onu göster bakalım.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7425,
            "SureId": 7,
            "AyetId": 107,
            "LanguageId": 5,
            "AyetNumber": "107",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "Bunun üzerine Mûsâ asâsını yere attı. Bir de baktılar ki apaçık bir yılan!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7432,
            "SureId": 7,
            "AyetId": 108,
            "LanguageId": 5,
            "AyetNumber": "108",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "Ve elini çıkardı. Bir de ne görsünler, o da seyredenlerin gözleri önünde bembeyaz oluvermiş!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7439,
            "SureId": 7,
            "AyetId": 109,
            "LanguageId": 5,
            "AyetNumber": "109",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "Firavun’un kavminden ileri gelenler dediler ki: “Bu gerçekten çok bilgili bir sihirbazdır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7446,
            "SureId": 7,
            "AyetId": 110,
            "LanguageId": 5,
            "AyetNumber": "110",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "“Sizi yurdunuzdan çıkarmak istiyor.” Firavun, “Peki ne buyurursunuz?” (dedi.)",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7453,
            "SureId": 7,
            "AyetId": 111,
            "LanguageId": 5,
            "AyetNumber": "111",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "Dediler ki: “Onu da kardeşini de beklet; şehirlere toplayıcılar (memurlar) yolla.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7460,
            "SureId": 7,
            "AyetId": 112,
            "LanguageId": 5,
            "AyetNumber": "112",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "“Bütün bilgili sihirbazları sana getirsinler.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7467,
            "SureId": 7,
            "AyetId": 113,
            "LanguageId": 5,
            "AyetNumber": "113",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "Sihirbazlar Firavun’a geldiler; “Eğer üstün gelen biz olursak bize muhakkak bir ödül olmalıdır” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7474,
            "SureId": 7,
            "AyetId": 114,
            "LanguageId": 5,
            "AyetNumber": "114",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "O da “Tamam; ayrıca sizler mutlaka yakınlarımdan olacaksınız” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7481,
            "SureId": 7,
            "AyetId": 115,
            "LanguageId": 5,
            "AyetNumber": "115",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "Sihirbazlar dediler ki: “Ey Mûsâ! Sen mi atacaksın (asânı), yoksa (ilk) atan biz mi olalım?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7488,
            "SureId": 7,
            "AyetId": 116,
            "LanguageId": 5,
            "AyetNumber": "116",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "“Siz atın” dedi. Onlar atınca insanların gözlerini büyülediler, içlerine korku saldılar ve böylece büyük bir büyü gösterisi yaptılar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7495,
            "SureId": 7,
            "AyetId": 117,
            "LanguageId": 5,
            "AyetNumber": "117",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "Biz de Mûsâ’ya “Asânı at!” diye vahyettik. Bir de baktılar ki bu, onların uydurduklarını yakalayıp yutuyor!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7502,
            "SureId": 7,
            "AyetId": 118,
            "LanguageId": 5,
            "AyetNumber": "118",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "Böylece gerçek ortaya çıktı ve onların yaptıklarının asılsız olduğu anlaşıldı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7509,
            "SureId": 7,
            "AyetId": 119,
            "LanguageId": 5,
            "AyetNumber": "119",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "İşte Firavun ve kavmi orada yenildiler ve küçük düşüp yarıştan çekildiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 7516,
            "SureId": 7,
            "AyetId": 120,
            "LanguageId": 5,
            "AyetNumber": "120",
            "AyetVisible": true,
            "Page": 164,
            "AyetText": "Sihirbazlar derhal secdeye kapandılar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "A'râf",
