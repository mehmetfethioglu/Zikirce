    "QuranAyats": [
        {
            "Id": 17696,
            "SureId": 21,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "قُلْ اِنَّمَٓا اُنْذِرُكُمْ بِالْوَحْیِؗ وَلَا یَسْمَعُ الصُّمُّ الدُّعَٓاءَ اِذَا مَا یُنْذَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17703,
            "SureId": 21,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "وَلَئِنْ مَسَّتْهُمْ نَفْحَةٌ مِنْ عَذَابِ رَبِّكَ لَیَقُولُنَّ یَا وَیْلَنَٓا اِنَّا كُنَّا ظَالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17710,
            "SureId": 21,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "وَنَضَعُ الْمَوَازٖینَ الْقِسْطَ لِیَوْمِ الْقِیٰمَةِ فَلَا تُظْلَمُ نَفْسٌ شَیْـًٔاؕ وَاِنْ كَانَ مِثْقَالَ حَبَّةٍ مِنْ خَرْدَلٍ اَتَیْنَا بِهَاؕ وَكَفٰى بِنَا حَاسِبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17717,
            "SureId": 21,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "وَلَقَدْ اٰتَیْنَا مُوسٰى وَهٰرُونَ الْفُرْقَانَ وَضِیَٓاءً وَذِكْرًا لِلْمُتَّقٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17724,
            "SureId": 21,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "اَلَّذٖینَ یَخْشَوْنَ رَبَّهُمْ بِالْغَیْبِ وَهُمْ مِنَ السَّاعَةِ مُشْفِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17731,
            "SureId": 21,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "وَهٰذَا ذِكْرٌ مُبَارَكٌ اَنْزَلْنَاهُؕ اَفَاَنْتُمْ لَهُ مُنْكِرُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17738,
            "SureId": 21,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "وَلَقَدْ اٰتَیْنَٓا اِبْرٰهٖیمَ رُشْدَهُ مِنْ قَبْلُ وَكُنَّا بِهٖ عَالِمٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17745,
            "SureId": 21,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "اِذْ قَالَ لِاَبٖیهِ وَقَوْمِهٖ مَا هٰذِهِ التَّمَاثٖیلُ الَّتٖٓی اَنْتُمْ لَهَا عَاكِفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17752,
            "SureId": 21,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "قَالُوا وَجَدْنَٓا اٰبَٓاءَنَا لَهَا عَابِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17759,
            "SureId": 21,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "قَالَ لَقَدْ كُنْتُمْ اَنْتُمْ وَاٰبَٓاؤُ𐻾كُمْ فٖی ضَلَالٍ مُبٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17766,
            "SureId": 21,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "قَالُٓوا اَجِئْتَنَا بِالْحَقِّ اَمْ اَنْتَ مِنَ اللَّاعِبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17773,
            "SureId": 21,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "قَالَ بَلْ رَبُّكُمْ رَبُّ السَّمٰوَاتِ وَالْاَرْضِ الَّذٖی فَطَرَهُنَّؗ وَاَنَا𐻾 عَلٰى ذٰلِكُمْ مِنَ الشَّاهِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17780,
            "SureId": 21,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "وَتَاللّٰهِ لَاَكٖیدَنَّ اَصْنَامَكُمْ بَعْدَ اَنْ تُوَلُّوا مُدْبِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 17694,
            "SureId": 21,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "De ki: “Ben sizi ancak vahiy ile uyarıyorum.” Fakat (vicdanı) sağır olanlar, uyarılsalar da bu çağrıyı duymazlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17701,
            "SureId": 21,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "Andolsun, onları rabbinin azabından bir esinti yoklasa muhakkak ki, “Vah bize! Hakikaten biz kendimize kötülük etmişiz!” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17708,
            "SureId": 21,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "Biz, kıyamet günü için adalet terazileri kurarız; artık kimseye hiçbir şekilde haksızlık edilmez. Yapılan, bir hardal tanesi kadar dahi olsa, onu getirir ortaya koyarız. Hesap görücü olarak biz yeteriz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17715,
            "SureId": 21,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48-49",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "Andolsun ki, Mûsâ ve Hârûn’a, günahtan sakınan, görmedikleri halde rablerinden korkan ve kıyametin kaygısını taşıyanlar için bir ayırma ölçütü, bir ışık, bir hatırlatıcı kaynak (kitap) verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17722,
            "SureId": 21,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": false,
            "Page": 326,
            "AyetText": "Andolsun ki, Mûsâ ve Hârûn’a, günahtan sakınan, görmedikleri halde rablerinden korkan ve kıyametin kaygısını taşıyanlar için bir ayırma ölçütü, bir ışık, bir hatırlatıcı kaynak (kitap) verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17729,
            "SureId": 21,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "İşte bu Kur’an da bizim indirdiğimiz bereketli bir hatırlatıcı bilgi kaynağıdır. Şimdi siz onu inkâr mı ediyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17736,
            "SureId": 21,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "Biz daha önce İbrâhim’e doğru düşünme yeteneği vermiştik. Biz onu biliyorduk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17743,
            "SureId": 21,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "O, babasına ve kavmine, “Şu kendilerine tapmakta olduğunuz heykeller de ne oluyor?” diye sormuştu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17750,
            "SureId": 21,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "Onlar da “Atalarımızı bunlara tapar bulduk” diye cevap vermişlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17757,
            "SureId": 21,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "İbrâhim, “Doğrusu siz de atalarınız da açık bir sapkınlık içindesiniz” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17764,
            "SureId": 21,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "Onlar da, “Bize gerçeği mi getirdin, yoksa bizimle oyun mu oynuyorsun?” diye sordular.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17771,
            "SureId": 21,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "İbrâhim şöyle cevap verdi: “Hayır, sizin rabbiniz, göklerin ve yerin rabbidir; onları O yaratmıştır; ben de bunu ikrar edenlerdenim.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17778,
            "SureId": 21,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 326,
            "AyetText": "Sonra (içinden şöyle geçirdi): “Allah’a yemin ederim ki siz ayrılıp gittikten sonra putlarınıza bir oyun oynayacağım!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
