    "QuranAyats": [
        {
            "Id": 22120,
            "SureId": 27,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "طٰسٓࣞ تِلْكَ اٰیَاتُ الْقُرْاٰنِ وَكِتَابٍ مُبٖینٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 27,
                "MealInfo": "Mekke döneminde inmiştir. 93 âyettir. Sûre, adını 18. âyette yer alan <b>“enNeml</b>” kelimesinden almaktadır. <b>Neml, karınca demektir. </b>Sûre de başlıca, <b>Süleyman peygamber ve Sebe’ melikesi, Belkıs kıssası ile Salih ve Lût peygamberler&nbsp;</b>konu edilmekte, ayrıca mü’minlerin kurtuluşa ereceği, İslâm karşıtlarının kötü akıbetleri, öldükten sonra dirilmek ve kıyamet dile getirilmektedir.",
                "SureNameTurkish": "Neml",
                "SureNameArabic": "النَّمْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 48,
                "AyetCount": 93,
                "Cuz": 19,
                "FirstPage": 377,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 22127,
            "SureId": 27,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "هُدًى وَبُشْرٰى لِلْمُؤْمِنٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22134,
            "SureId": 27,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "اَلَّذٖینَ یُقٖیمُونَ الصَّلٰوةَ وَیُؤْتُونَ الزَّكٰوةَ وَهُمْ بِالْاٰخِرَةِ هُمْ یُوقِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22141,
            "SureId": 27,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "اِنَّ الَّذٖینَ لَا یُؤْمِنُونَ بِالْاٰخِرَةِ زَیَّنَّا لَهُمْ اَعْمَالَهُمْ فَهُمْ یَعْمَهُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22148,
            "SureId": 27,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "اُو𐻾لٰٓئِكَ الَّذٖینَ لَهُمْ سُٓوءُ الْعَذَابِ وَهُمْ فِی الْاٰخِرَةِ هُمُ الْاَخْسَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22155,
            "SureId": 27,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "وَاِنَّكَ لَتُلَقَّى الْقُرْاٰنَ مِنْ لَدُنْ حَكٖیمٍ عَلٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22162,
            "SureId": 27,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "اِذْ قَالَ مُوسٰى لِاَهْلِهٖٓ اِنّٖٓی اٰنَسْتُ نَارًاؕ سَاٰتٖیكُمْ مِنْهَا بِخَبَرٍ اَوْ اٰتٖیكُمْ بِشِهَابٍ قَبَسٍ لَعَلَّكُمْ تَصْطَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22169,
            "SureId": 27,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "فَلَمَّا جَٓاءَهَا نُودِیَ اَنْ بُورِكَ مَنْ فِی النَّارِ وَمَنْ حَوْلَهَاؕ وَسُبْحَانَ اللّٰهِ رَبِّ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22176,
            "SureId": 27,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "یَا مُوسٰٓى اِنَّهُٓ اَنَا اللّٰهُ الْعَزٖیزُ الْحَكٖیمُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22183,
            "SureId": 27,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "وَاَلْقِ عَصَاكَؕ فَلَمَّا رَاٰهَا تَهْتَزُّ كَاَنَّهَا جَٓانٌّ وَلّٰى مُدْبِرًا وَلَمْ یُعَقِّبْؕ یَا مُوسٰى لَا تَخَفْ اِنّٖی لَا یَخَافُ لَدَیَّ الْمُرْسَلُونَࣗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22190,
            "SureId": 27,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "اِلَّا مَنْ ظَلَمَ ثُمَّ بَدَّلَ حُسْنًا بَعْدَ سُٓوءٍ فَاِنّٖی غَفُورٌ رَحٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22197,
            "SureId": 27,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "وَاَدْخِلْ یَدَكَ فٖی جَیْبِكَ تَخْرُجْ بَیْضَٓاءَ مِنْ غَیْرِ سُٓوءٍ فٖی تِسْعِ اٰیَاتٍ اِلٰى فِرْعَوْنَ وَقَوْمِهٖؕ اِنَّهُمْ كَانُوا قَوْمًا فَاسِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22204,
            "SureId": 27,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "فَلَمَّا جَٓاءَتْهُمْ اٰیَاتُنَا مُبْصِرَةً قَالُوا هٰذَا سِحْرٌ مُبٖینٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 22118,
            "SureId": 27,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "Tâ-sîn. Bunlar Kur’an’ın, gerçekleri açıklayan kitabın âyetleridir;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 27,
                "MealInfo": "Mekke döneminde inmiştir. 93 âyettir. Sûre, adını 18. âyette yer alan <b>“enNeml</b>” kelimesinden almaktadır. <b>Neml, karınca demektir. </b>Sûre de başlıca, <b>Süleyman peygamber ve Sebe’ melikesi, Belkıs kıssası ile Salih ve Lût peygamberler&nbsp;</b>konu edilmekte, ayrıca mü’minlerin kurtuluşa ereceği, İslâm karşıtlarının kötü akıbetleri, öldükten sonra dirilmek ve kıyamet dile getirilmektedir.",
                "SureNameTurkish": "Neml",
                "SureNameArabic": "النَّمْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 48,
                "AyetCount": 93,
                "Cuz": 19,
                "FirstPage": 377,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 22125,
            "SureId": 27,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2-3",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "Namazı kılan, zekâtı veren ve âhirete kesin bir şekilde iman eden müminler için bir hidayet rehberi ve bir müjdedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22132,
            "SureId": 27,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": false,
            "Page": 377,
            "AyetText": "Namazı kılan, zekâtı veren ve âhirete kesin bir şekilde iman eden müminler için bir hidayet rehberi ve bir müjdedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22139,
            "SureId": 27,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "Âhirete inanmayanların yapıp ettiklerini şüphesiz kendilerine güzel göstermiş olduk; bu yüzden şuursuzca eğlenip dururlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22146,
            "SureId": 27,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "İşte en ağır cezayı hak edenler bunlardır; âhirette en çok ziyana uğrayacak olanlar da yine bunlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22153,
            "SureId": 27,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "Şüphesiz ki bu Kur’an sana ilim ve hikmet sahibi Allah tarafından verilmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22160,
            "SureId": 27,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "Bir zamanlar Mûsâ, ailesine, “(Şu uzakta) bir ateş bulunduğunu farkettim. Size oradan bir haber ya da ısınmanız için ondan bir parça kor getireceğim” demişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22167,
            "SureId": 27,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "Oraya geldiğinde ona şöyle seslenildi: “Ateşin yanındaki ve çevresindekiler mübarek kılınmıştır! Âlemlerin rabbi olan Allah, her türlü noksanlıktan uzaktır!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22174,
            "SureId": 27,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "“Ey Mûsâ! Şüphesiz ben mutlak galip ve hikmet sahibi olan Allahım!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22181,
            "SureId": 27,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "Asânı yere at!” Mûsâ atıp da onu yılan gibi kımıldanır görünce arkasına bakmadan dönüp kaçtı. (Allah buyurdu ki:) “Ey Mûsâ! Korkma, benim huzurumda peygamberler korkmaz;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22188,
            "SureId": 27,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "Ancak haksızlığa sapan korkar; o da işlediği bir kötülük yerine bir iyilik ederse bilsin ki ben çok bağışlayıcıyım, çok merhametliyim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22195,
            "SureId": 27,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "Şimdi elini koynuna sok da kusursuz bembeyaz olarak çıksın. Dokuz mûcize ile Firavun ve kavmine git. Çünkü onlar yoldan çıkmış bir kavim oldular.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22202,
            "SureId": 27,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 377,
            "AyetText": "Mûcizelerimiz onların gözleri önüne serilince, “Bu, düpedüz bir sihirdir” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Neml",
