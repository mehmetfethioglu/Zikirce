    "CuzNo": 27,
    "PageNo": 522,
    "ArCuzNo": "۲۷",
    "ArPageNo": "٥۲۲",
    "QuranAyats": [
        {
            "Id": 32942,
            "SureId": 51,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "قَالَ فَمَا خَطْبُكُمْ اَیُّهَا الْمُرْسَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 51,
                "MealInfo": "Mekke döneminde inmiştir. 60 âyettir. Sûre, adını ilk âyette geçen <b>“ez-zâriyât” </b>kelimesinden almıştır.<b> Zâriyât, esip savuran rüzgârlar demektir.</b> Sûrede başlıca, <b>öldükten sonra hesap için toplanma, inkârcıların ahirette karşılaşacakları azap, mü’minlere verilecek mükâfatlar, Allah’ın varlığını ve birliğini gösteren kevni deliller</b> konu edilmektedir.",
                "SureNameTurkish": "Zâriyât",
                "SureNameArabic": "الذَّارِيَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 67,
                "AyetCount": 60,
                "Cuz": 26,
                "FirstPage": 520,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 32949,
            "SureId": 51,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "قَالُٓوا اِنَّٓا اُرْسِلْنَٓا اِلٰى قَوْمٍ مُجْرِمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32956,
            "SureId": 51,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "لِنُرْسِلَ عَلَیْهِمْ حِجَارَةً مِنْ طٖینٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32963,
            "SureId": 51,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "مُسَوَّمَةً عِنْدَ رَبِّكَ لِلْمُسْرِفٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32970,
            "SureId": 51,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "فَاَخْرَجْنَا مَنْ كَانَ فٖیهَا مِنَ الْمُؤْمِنٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32977,
            "SureId": 51,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "فَمَا وَجَدْنَا فٖیهَا غَیْرَ بَیْتٍ مِنَ الْمُسْلِمٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32984,
            "SureId": 51,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "وَتَرَكْنَا فٖیهَٓا اٰیَةً لِلَّذٖینَ یَخَافُونَ الْعَذَابَ الْاَلٖیمَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32991,
            "SureId": 51,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "وَفٖی مُوسٰٓى اِذْ اَرْسَلْنَاهُ اِلٰى فِرْعَوْنَ بِسُلْطَانٍ مُبٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32998,
            "SureId": 51,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "فَتَوَلّٰى بِرُكْنِهٖ وَقَالَ سَاحِرٌ اَوْ مَجْنُونٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33005,
            "SureId": 51,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "فَاَخَذْنَاهُ وَجُنُودَهُ فَنَبَذْنَاهُمْ فِی الْیَمِّ وَهُوَ مُلٖیمٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33012,
            "SureId": 51,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "وَفٖی عَادٍ اِذْ اَرْسَلْنَا عَلَیْهِمُ الرّٖیحَ الْعَقٖیمَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33019,
            "SureId": 51,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "مَا تَذَرُ مِنْ شَیْءٍ اَتَتْ عَلَیْهِ اِلَّا جَعَلَتْهُ كَالرَّمٖیمِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33026,
            "SureId": 51,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "وَفٖی ثَمُودَ اِذْ قٖیلَ لَهُمْ تَمَتَّعُوا حَتّٰى حٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33033,
            "SureId": 51,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "فَعَتَوْا عَنْ اَمْرِ رَبِّهِمْ فَاَخَذَتْهُمُ الصَّاعِقَةُ وَهُمْ یَنْظُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33040,
            "SureId": 51,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "فَمَا اسْتَطَاعُوا مِنْ قِیَامٍ وَمَا كَانُوا مُنْتَصِرٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33047,
            "SureId": 51,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "وَقَوْمَ نُوحٍ مِنْ قَبْلُؕ اِنَّهُمْ كَانُوا قَوْمًا فَاسِقٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33054,
            "SureId": 51,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "وَالسَّمَٓاءَ بَنَیْنَاهَا بِاَیْدٍ وَاِنَّا لَمُوسِعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33061,
            "SureId": 51,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "وَالْاَرْضَ فَرَشْنَاهَا فَنِعْمَ الْمَاهِدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33068,
            "SureId": 51,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "وَمِنْ كُلِّ شَیْءٍ خَلَقْنَا زَوْجَیْنِ لَعَلَّكُمْ تَذَكَّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33075,
            "SureId": 51,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "فَفِرُّٓوا اِلَى اللّٰهِؕ اِنّٖی لَكُمْ مِنْهُ نَذٖیرٌ مُبٖینٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33082,
            "SureId": 51,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "وَلَا تَجْعَلُوا مَعَ اللّٰهِ اِلٰهًا اٰخَرَؕ اِنّٖی لَكُمْ مِنْهُ نَذٖیرٌ مُبٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 32940,
            "SureId": 51,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "İbrâhim, “Peki ey elçiler! Sizin asıl göreviniz nedir?” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 51,
                "MealInfo": "Mekke döneminde inmiştir. 60 âyettir. Sûre, adını ilk âyette geçen <b>“ez-zâriyât” </b>kelimesinden almıştır.<b> Zâriyât, esip savuran rüzgârlar demektir.</b> Sûrede başlıca, <b>öldükten sonra hesap için toplanma, inkârcıların ahirette karşılaşacakları azap, mü’minlere verilecek mükâfatlar, Allah’ın varlığını ve birliğini gösteren kevni deliller</b> konu edilmektedir.",
                "SureNameTurkish": "Zâriyât",
                "SureNameArabic": "الذَّارِيَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 67,
                "AyetCount": 60,
                "Cuz": 26,
                "FirstPage": 520,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 32947,
            "SureId": 51,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "“Biz” dediler, “Günaha batmış bir topluluğa gönderildik;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32954,
            "SureId": 51,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33-34",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Haddi aşanlar için rabbinin nezdinde işaretlenmiş balçıktan taşları üzerlerine yağdırmak üzere.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32961,
            "SureId": 51,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": false,
            "Page": 522,
            "AyetText": "Haddi aşanlar için rabbinin nezdinde işaretlenmiş balçıktan taşları üzerlerine yağdırmak üzere.\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32968,
            "SureId": 51,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Derken, orada bulunan müminleri çıkardık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32975,
            "SureId": 51,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Zaten orada -bir hâne dışında- Allah’a teslim olmuş kimseler de bulamadık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32982,
            "SureId": 51,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Ve orada, acı veren azaptan korkanlar için bir işaret bırakmış olduk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32989,
            "SureId": 51,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Mûsâ’da da (ibretler var). Onu apaçık delillerle Firavun’a göndermiştik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32996,
            "SureId": 51,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Firavun saltanatı sebebiyle ona karşı çıkmış ve “O, ya bir sihirbaz veya bir mec­­­nundur” demişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33003,
            "SureId": 51,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Sonunda -(davranışlarıyla) kendini rezil etmiş olarak- onu ve askerlerini yakalayıp denize attık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33010,
            "SureId": 51,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Âd kavminde de (ibretler var). Onlara silip süpüren rüzgârı göndermiştik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33017,
            "SureId": 51,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Üzerinden geçtiği hiçbir şeyi bırakmıyor, kül edip savuruyordu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33024,
            "SureId": 51,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Semûd’da da (ibretler var). Onlara, “Bir süreye kadar faydalanın bakalım!” ­denmişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33031,
            "SureId": 51,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Rablerinin buyruğuna uymayı kendilerine yediremediler. Bu yüzden, bakıp dururlarken onları yıldırım yakalayıverdi!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33038,
            "SureId": 51,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Yerlerinden bile kalkamadılar ve kimseden yardım da alamadılar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33045,
            "SureId": 51,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Bunlardan önce yaşayan Nûh’un kavminde de (ibretler var). Çünkü onlar yoldan çıkmış bir topluluk idi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33052,
            "SureId": 51,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Göğü kudretimizle biz kurduk ve şüphesiz biz genişletmekteyiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33059,
            "SureId": 51,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Yeri de biz döşedik; güzel de yaptık!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33066,
            "SureId": 51,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Her şeyden çift çift yarattık, inceden inceye düşünesiniz diye.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33073,
            "SureId": 51,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "(Peygamber şöyle dedi:) “Şu halde Allah’a sığının. Şüphesiz ben sizin için O’nun tarafından apaçık bir uyarıcıyım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33080,
            "SureId": 51,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 522,
            "AyetText": "Allah’ın yanında başka tanrı edinmeyin. Şüphesiz ben sizin için O’nun tarafından apaçık bir uyarıcıyım.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Zâriyât",
    "QuranSureLabel": "الذَّارِيَاتِ",
    "EndPageSure": null
}