{
    "PointerList": null,
    "CuzNo": 16,
    "PageNo": 319,
    "ArCuzNo": "۱٦",
    "ArPageNo": "۳۱۹",
    "QuranAyats": [
        {
            "Id": 17129,
            "SureId": 20,
            "AyetId": 99,
            "LanguageId": 7,
            "AyetNumber": "٩٩",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "كَذٰلِكَ نَقُصُّ عَلَیْكَ مِنْ اَنْبَٓاءِ مَا قَدْ سَبَقَۚ وَقَدْ اٰتَیْنَاكَ مِنْ لَدُنَّا ذِكْرًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17136,
            "SureId": 20,
            "AyetId": 100,
            "LanguageId": 7,
            "AyetNumber": "١٠٠",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "مَنْ اَعْرَضَ عَنْهُ فَاِنَّهُ یَحْمِلُ یَوْمَ الْقِیٰمَةِ وِزْرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17143,
            "SureId": 20,
            "AyetId": 101,
            "LanguageId": 7,
            "AyetNumber": "١٠١",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "خَالِدٖینَ فٖیهِؕ وَسَٓاءَ لَهُمْ یَوْمَ الْقِیٰمَةِ حِمْلًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17150,
            "SureId": 20,
            "AyetId": 102,
            "LanguageId": 7,
            "AyetNumber": "١٠٢",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "یَوْمَ یُنْفَخُ فِی الصُّورِ وَنَحْشُرُ الْمُجْرِمٖینَ یَوْمَئِذٍ زُرْقًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17157,
            "SureId": 20,
            "AyetId": 103,
            "LanguageId": 7,
            "AyetNumber": "١٠٣",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "یَتَخَافَتُونَ بَیْنَهُمْ اِنْ لَبِثْتُمْ اِلَّا عَشْرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17164,
            "SureId": 20,
            "AyetId": 104,
            "LanguageId": 7,
            "AyetNumber": "١٠٤",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "نَحْنُ اَعْلَمُ بِمَا یَقُولُونَ اِذْ یَقُولُ اَمْثَلُهُمْ طَرٖیقَةً اِنْ لَبِثْتُمْ اِلَّا یَوْمًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17171,
            "SureId": 20,
            "AyetId": 105,
            "LanguageId": 7,
            "AyetNumber": "١٠٥",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "وَیَسْـَٔلُونَكَ عَنِ الْجِبَالِ فَقُلْ یَنْسِفُهَا رَبّٖی نَسْفًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17178,
            "SureId": 20,
            "AyetId": 106,
            "LanguageId": 7,
            "AyetNumber": "١٠٦",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "فَیَذَرُهَا قَاعًا صَفْصَفًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17185,
            "SureId": 20,
            "AyetId": 107,
            "LanguageId": 7,
            "AyetNumber": "١٠٧",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "لَا تَرٰى فٖیهَا عِوَجًا وَلَٓا اَمْتًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17192,
            "SureId": 20,
            "AyetId": 108,
            "LanguageId": 7,
            "AyetNumber": "١٠٨",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "یَوْمَئِذٍ یَتَّبِعُونَ الدَّاعِیَ لَا عِوَجَ لَهُۚ وَخَشَعَتِ الْاَصْوَاتُ لِلرَّحْمٰنِ فَلَا تَسْمَعُ اِلَّا هَمْسًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17199,
            "SureId": 20,
            "AyetId": 109,
            "LanguageId": 7,
            "AyetNumber": "١٠٩",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "یَوْمَئِذٍ لَا تَنْفَعُ الشَّفَاعَةُ اِلَّا مَنْ اَذِنَ لَهُ الرَّحْمٰنُ وَرَضِیَ لَهُ قَوْلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17206,
            "SureId": 20,
            "AyetId": 110,
            "LanguageId": 7,
            "AyetNumber": "١١٠",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "یَعْلَمُ مَا بَیْنَ اَیْدٖیهِمْ وَمَا خَلْفَهُمْ وَلَا یُحٖیطُونَ بِهٖ عِلْمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17213,
            "SureId": 20,
            "AyetId": 111,
            "LanguageId": 7,
            "AyetNumber": "١١١",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "وَعَنَتِ الْوُجُوهُ لِلْحَیِّ الْقَیُّومِؕ وَقَدْ خَابَ مَنْ حَمَلَ ظُلْمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17220,
            "SureId": 20,
            "AyetId": 112,
            "LanguageId": 7,
            "AyetNumber": "١١٢",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "وَمَنْ یَعْمَلْ مِنَ الصَّالِحَاتِ وَهُوَ مُؤْمِنٌ فَلَا یَخَافُ ظُلْمًا وَلَا هَضْمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17227,
            "SureId": 20,
            "AyetId": 113,
            "LanguageId": 7,
            "AyetNumber": "١١٣",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "وَكَذٰلِكَ اَنْزَلْنَاهُ قُرْاٰنًا عَرَبِیًّا وَصَرَّفْنَا فٖیهِ مِنَ الْوَعٖیدِ لَعَلَّهُمْ یَتَّقُونَ اَوْ یُحْدِثُ لَهُمْ ذِكْرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 17127,
            "SureId": 20,
            "AyetId": 99,
            "LanguageId": 5,
            "AyetNumber": "99",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "İşte böylece geçmiştekilerin haberlerinden bir kısmını sana anlatıyoruz. Kuşkusuz sana katımızdan bir zikir (Kur’an) verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17134,
            "SureId": 20,
            "AyetId": 100,
            "LanguageId": 5,
            "AyetNumber": "100",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "Kim ondan yüz çevirirse bilsin ki kıyamet günü ağır bir günah yüklenecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17141,
            "SureId": 20,
            "AyetId": 101,
            "LanguageId": 5,
            "AyetNumber": "101",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "Ebedî olarak o yükün altında kalacaklardır. Kıyamet günü bu onlar için ne kötü bir yüktür!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17148,
            "SureId": 20,
            "AyetId": 102,
            "LanguageId": 5,
            "AyetNumber": "102",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "O gün sûra üfürülür ve günahkârları o gün gözleri göğermiş olarak toplarız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17155,
            "SureId": 20,
            "AyetId": 103,
            "LanguageId": 5,
            "AyetNumber": "103",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "“On günden fazla kalmadınız” diyerek aralarında fısıldaşırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17162,
            "SureId": 20,
            "AyetId": 104,
            "LanguageId": 5,
            "AyetNumber": "104",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "İçlerinden en aklı başında olanı, “Hayır, ancak bir gün kaldınız” der. Halbuki söyledikleri şeyi en iyi biz biliriz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17169,
            "SureId": 20,
            "AyetId": 105,
            "LanguageId": 5,
            "AyetNumber": "105",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "Sana dağları soruyorlar. De ki: “Rabbim onları un ufak edip savuracak.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17176,
            "SureId": 20,
            "AyetId": 106,
            "LanguageId": 5,
            "AyetNumber": "106",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "Yerlerini dümdüz, bomboş bırakacak.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17183,
            "SureId": 20,
            "AyetId": 107,
            "LanguageId": 5,
            "AyetNumber": "107",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "Orada artık ne bir kıvrım ne de bir tümsek görürsün.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17190,
            "SureId": 20,
            "AyetId": 108,
            "LanguageId": 5,
            "AyetNumber": "108",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "O gün herkes çağırıcıya uyar; ondan kaçıp kurtulma imkânı yoktur. Rahmânın heybetinden sesler kısılmıştır; artık çok hafif sesler dışında bir şey işitemezsin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17197,
            "SureId": 20,
            "AyetId": 109,
            "LanguageId": 5,
            "AyetNumber": "109",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "O gün -rahmânın izin verdiği ve sözünden hoşnut olduğu kimseler müstesna- şefaatin bir yararı olmaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17204,
            "SureId": 20,
            "AyetId": 110,
            "LanguageId": 5,
            "AyetNumber": "110",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "Onların önlerinde ve arkalarında olanı O bilir. Onların bilgisi ise O’nu kuşatamaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17211,
            "SureId": 20,
            "AyetId": 111,
            "LanguageId": 5,
            "AyetNumber": "111",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "Diri ve her şeyin varlığı kendine bağlı olan Allah’ın huzurunda yüzler (başlar) hicapla eğilmiştir; zulmü yüklenmiş olan ise hüsrana uğramıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17218,
            "SureId": 20,
            "AyetId": 112,
            "LanguageId": 5,
            "AyetNumber": "112",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "Mümin olarak dünya ve âhiret için yararlı iyi işler yapan kimseye gelince, o ne büsbütün, hatta ne de kısmen haksızlığa uğramaktan korkar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17225,
            "SureId": 20,
            "AyetId": 113,
            "LanguageId": 5,
            "AyetNumber": "113",
            "AyetVisible": true,
            "Page": 319,
            "AyetText": "İşte, sakınsınlar yahut hatırlamalarını sağlasın diye onu Arapça bir Kur’an olarak indirdik ve onda uyarılarımıza tekrar tekrar yer verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Tâhâ",
    "QuranSureLabel": "طٰهٰ",
    "EndPageSure": null
}