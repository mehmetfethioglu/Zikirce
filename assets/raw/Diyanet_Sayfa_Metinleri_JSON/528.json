    "QuranAyats": [
        {
            "Id": 33803,
            "SureId": 53,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "وَاَنَّهُ خَلَقَ الزَّوْجَیْنِ الذَّكَرَ وَالْاُنْثٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 53,
                "MealInfo": "Mekke döneminde inmiştir. 62 âyettir. Sûre, adını ilk âyetin başındaki <b>“en-Necm” </b>kelimesinden almıştır.<b> Necm, yıldız demektir.</b> Sûrede başlıca, <b>Kur’an’ın vahiy eseri olduğu vurgulanmakta, herkesin yaptığının karşılığını göreceği, Allah’ın kudretinin delilleri</b> konu edilmektedir.",
                "SureNameTurkish": "Necm",
                "SureNameArabic": "النَّجْمِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 23,
                "AyetCount": 62,
                "Cuz": 27,
                "FirstPage": 526,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33810,
            "SureId": 53,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "مِنْ نُطْفَةٍ اِذَا تُمْنٰىࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33817,
            "SureId": 53,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "وَاَنَّ عَلَیْهِ النَّشْاَةَ الْاُخْرٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33824,
            "SureId": 53,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "وَاَنَّهُ هُوَ اَغْنٰى وَاَقْنٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33831,
            "SureId": 53,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "وَاَنَّهُ هُوَ رَبُّ الشِّعْرٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33838,
            "SureId": 53,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "وَاَنَّهُٓ اَهْلَكَ عَادًاࣙ الْاُو𐻿لٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33845,
            "SureId": 53,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "وَثَمُودَا𐻾 فَمَٓا اَبْقٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33852,
            "SureId": 53,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "وَقَوْمَ نُوحٍ مِنْ قَبْلُؕ اِنَّهُمْ كَانُوا هُمْ اَظْلَمَ وَاَطْغٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33859,
            "SureId": 53,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "وَالْمُؤْتَفِكَةَ اَهْوٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33866,
            "SureId": 53,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "فَغَشّٰیهَا مَا غَشّٰىۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33873,
            "SureId": 53,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "فَبِاَیِّ اٰلَٓاءِ رَبِّكَ تَتَمَارٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33880,
            "SureId": 53,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "هٰذَا نَذٖیرٌ مِنَ النُّذُرِ الْاُو𐻿لٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33887,
            "SureId": 53,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "اَزِفَتِ الْاٰزِفَةُۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33894,
            "SureId": 53,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "لَیْسَ لَهَا مِنْ دُونِ اللّٰهِ كَاشِفَةٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33901,
            "SureId": 53,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "اَفَمِنْ هٰذَا الْحَدٖیثِ تَعْجَبُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33908,
            "SureId": 53,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "وَتَضْحَكُونَ وَلَا تَبْكُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33915,
            "SureId": 53,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "وَاَنْتُمْ سَامِدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33922,
            "SureId": 53,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "فَاسْجُدُوا لِلّٰهِ وَاعْبُدُوا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33929,
            "SureId": 54,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "اِقْتَرَبَتِ السَّاعَةُ وَانْشَقَّ الْقَمَرُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 54,
                "MealInfo": "Mekke döneminde inmiştir. 55 âyettir. Sûre, adını ilk âyette geçen <b>“el-Kamer” </b>kelimesinden almıştır. <b>Kamer, ay demektir</b>. Sûre de ana fikir olarak, <b>Kur’an’ı yalanlayanlar, çeşitli azap ve helâk örnekleri</b> de verilerek uyarılmaktadır.",
                "SureNameTurkish": "Kamer",
                "SureNameArabic": "الْقَمَرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 37,
                "AyetCount": 55,
                "Cuz": 27,
                "FirstPage": 528,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33936,
            "SureId": 54,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "وَاِنْ یَرَوْا اٰیَةً یُعْرِضُوا وَیَقُولُوا سِحْرٌ مُسْتَمِرٌّ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33943,
            "SureId": 54,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "وَكَذَّبُوا وَاتَّبَعُٓوا اَهْوَٓاءَهُمْ وَكُلُّ اَمْرٍ مُسْتَقِرٌّ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33950,
            "SureId": 54,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "وَلَقَدْ جَٓاءَهُمْ مِنَ الْاَنْبَٓاءِ مَا فٖیهِ مُزْدَجَرٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33957,
            "SureId": 54,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "حِكْمَةٌ بَالِغَةٌ فَمَا تُغْنِ النُّذُرُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33964,
            "SureId": 54,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "فَتَوَلَّ عَنْهُمْۘ یَوْمَ یَدْعُ الدَّاعِ اِلٰى شَیْءٍ نُكُرٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 33801,
            "SureId": 53,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45-46",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Rahime atıldığı zaman nutfeden (embriyo) erkeğiyle dişisiyle iki cinsi yaratan da O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 53,
                "MealInfo": "Mekke döneminde inmiştir. 62 âyettir. Sûre, adını ilk âyetin başındaki <b>“en-Necm” </b>kelimesinden almıştır.<b> Necm, yıldız demektir.</b> Sûrede başlıca, <b>Kur’an’ın vahiy eseri olduğu vurgulanmakta, herkesin yaptığının karşılığını göreceği, Allah’ın kudretinin delilleri</b> konu edilmektedir.",
                "SureNameTurkish": "Necm",
                "SureNameArabic": "النَّجْمِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 23,
                "AyetCount": 62,
                "Cuz": 27,
                "FirstPage": 526,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33808,
            "SureId": 53,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": false,
            "Page": 528,
            "AyetText": "Rahime atıldığı zaman nutfeden (embriyo) erkeğiyle dişisiyle iki cinsi yaratan da O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33815,
            "SureId": 53,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Öteki yaratma da (öldükten sonra diriltme) O’na aittir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33822,
            "SureId": 53,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Çok veren de O’dur, az veren de.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33829,
            "SureId": 53,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Şi‘râ yıldızının rabbi de O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33836,
            "SureId": 53,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Eski Âd kavmini helâk eden de O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33843,
            "SureId": 53,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Semûd’u da öyle. Hem de geriye bir şey bırakmadan!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33850,
            "SureId": 53,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Bunlardan da önce Nûh kavmini. Çünkü onlar çok zalim ve çok azgın idiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33857,
            "SureId": 53,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Altı üstüne getirilmiş şehirleri de O helâk etti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33864,
            "SureId": 53,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Onları üzerilerine yağan felâketlere gömdü!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33871,
            "SureId": 53,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Artık rabbinin hangi nimetlerinden şüphe duyabilirsin?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33878,
            "SureId": 53,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Bu (Kur’an) da önceki uyarıcılar gibi bir uyarıcıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33885,
            "SureId": 53,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Artık yaklaştı o yaklaşmakta olan.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33892,
            "SureId": 53,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Onu Allah’tan başka ortaya çıkaracak yoktur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33899,
            "SureId": 53,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Yoksa bu haberi tuhaf mı buluyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33906,
            "SureId": 53,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Ağlayacağınıza gülüyorsunuz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33913,
            "SureId": 53,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Ve gaflet içinde oyalanıp duruyorsunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33920,
            "SureId": 53,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Haydi artık Allah için secdeye kapanıp kulluk ediniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33927,
            "SureId": 54,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Vakit yaklaştı ve ay yarıldı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 54,
                "MealInfo": "Mekke döneminde inmiştir. 55 âyettir. Sûre, adını ilk âyette geçen <b>“el-Kamer” </b>kelimesinden almıştır. <b>Kamer, ay demektir</b>. Sûre de ana fikir olarak, <b>Kur’an’ı yalanlayanlar, çeşitli azap ve helâk örnekleri</b> de verilerek uyarılmaktadır.",
                "SureNameTurkish": "Kamer",
                "SureNameArabic": "الْقَمَرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 37,
                "AyetCount": 55,
                "Cuz": 27,
                "FirstPage": 528,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33934,
            "SureId": 54,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Onlar bir mûcize görseler hemen yüz çevirip, “Bu öteden beri bilinen bir sihir!” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33941,
            "SureId": 54,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 528,
            "AyetText": "Hep yalan saydılar ve kişisel arzularına uydular; oysa her iş yerli yerindedir.",
