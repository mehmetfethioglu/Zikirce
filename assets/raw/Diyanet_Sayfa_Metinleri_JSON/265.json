    "QuranAyats": [
        {
            "Id": 12978,
            "SureId": 15,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "اِذْ دَخَلُوا عَلَیْهِ فَقَالُوا سَلَامًاؕ قَالَ اِنَّا مِنْكُمْ وَجِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 15,
                "MealInfo": "Mekke döneminde inmiştir. 99 âyettir. Sûre, adını 80. âyette geçen <b>“Hicr” </b>kelimesinden almıştır. Hicr, Medine’nin kuzeyinde vaktiyle Semûd kavminin yaşadığı bir yerin adıdır. Sûre de başlıca Allah’ın birliği, peygamberlik, öldükten sonra dirilme ve hesap konuları; peygamberlerin, çeşitli zamanlarda azgınlara ve inkârcılara karşı verdikleri mücadeleler çerçevesinde ele alınmaktadır. Bu sûre de ayrıca ilâhî kitapların kendisiyle kemale erdiği Kur’an’ın, her türlü tahriften korunacağı hükmü de yer almaktadır.",
                "SureNameTurkish": "Hicr",
                "SureNameArabic": "الْحِجْرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 54,
                "AyetCount": 99,
                "Cuz": 14,
                "FirstPage": 262,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12985,
            "SureId": 15,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "قَالُوا لَا تَوْجَلْ اِنَّا نُبَشِّرُكَ بِغُلَامٍ عَلٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12992,
            "SureId": 15,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "قَالَ اَبَشَّرْتُمُونٖی عَلٰٓى اَنْ مَسَّنِیَ الْكِبَرُ فَبِمَ تُبَشِّرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12999,
            "SureId": 15,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "قَالُوا بَشَّرْنَاكَ بِالْحَقِّ فَلَا تَكُنْ مِنَ الْقَانِطٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13006,
            "SureId": 15,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "قَالَ وَمَنْ یَقْنَطُ مِنْ رَحْمَةِ رَبِّهٖٓ اِلَّا الضَّٓالُّونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13013,
            "SureId": 15,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "قَالَ فَمَا خَطْبُكُمْ اَیُّهَا الْمُرْسَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13020,
            "SureId": 15,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "قَالُٓوا اِنَّٓا اُرْسِلْنَٓا اِلٰى قَوْمٍ مُجْرِمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13027,
            "SureId": 15,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "اِلَّٓا اٰلَ لُوطٍؕ اِنَّا لَمُنَجُّوهُمْ اَجْمَعٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13034,
            "SureId": 15,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "اِلَّا امْرَاَتَهُ قَدَّرْنَٓاۙ اِنَّهَا لَمِنَ الْغَابِرٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13041,
            "SureId": 15,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "فَلَمَّا جَٓاءَ اٰلَ لُوطٍࣙ الْمُرْسَلُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13048,
            "SureId": 15,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "قَالَ اِنَّكُمْ قَوْمٌ مُنْكَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13055,
            "SureId": 15,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "قَالُوا بَلْ جِئْنَاكَ بِمَا كَانُوا فٖیهِ یَمْتَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13062,
            "SureId": 15,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "وَاَتَیْنَاكَ بِالْحَقِّ وَاِنَّا لَصَادِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13069,
            "SureId": 15,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "فَاَسْرِ بِاَهْلِكَ بِقِطْعٍ مِنَ الَّیْلِ وَاتَّبِـعْ اَدْبَارَهُمْ وَلَا یَلْتَفِتْ مِنْكُمْ اَحَدٌ وَامْضُوا حَیْثُ تُؤْمَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13076,
            "SureId": 15,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "وَقَضَیْنَٓا اِلَیْهِ ذٰلِكَ الْاَمْرَ اَنَّ دَابِرَ هٰٓؤُ𐻾لَٓاءِ مَقْطُوعٌ مُصْبِحٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13083,
            "SureId": 15,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "وَجَٓاءَ اَهْلُ الْمَدٖینَةِ یَسْتَبْشِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13090,
            "SureId": 15,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "قَالَ اِنَّ هٰٓؤُ𐻾لَٓاءِ ضَیْفٖی فَلَا تَفْضَحُونِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13097,
            "SureId": 15,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "وَاتَّقُوا اللّٰهَ وَلَا تُخْزُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13104,
            "SureId": 15,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "قَالُٓوا اَوَلَمْ نَنْهَكَ عَنِ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 12976,
            "SureId": 15,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "Onun yanına girip selâm vermişler, o da, “Doğrusu biz sizden korkuyoruz” demişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 15,
                "MealInfo": "Mekke döneminde inmiştir. 99 âyettir. Sûre, adını 80. âyette geçen <b>“Hicr” </b>kelimesinden almıştır. Hicr, Medine’nin kuzeyinde vaktiyle Semûd kavminin yaşadığı bir yerin adıdır. Sûre de başlıca Allah’ın birliği, peygamberlik, öldükten sonra dirilme ve hesap konuları; peygamberlerin, çeşitli zamanlarda azgınlara ve inkârcılara karşı verdikleri mücadeleler çerçevesinde ele alınmaktadır. Bu sûre de ayrıca ilâhî kitapların kendisiyle kemale erdiği Kur’an’ın, her türlü tahriften korunacağı hükmü de yer almaktadır.",
                "SureNameTurkish": "Hicr",
                "SureNameArabic": "الْحِجْرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 54,
                "AyetCount": 99,
                "Cuz": 14,
                "FirstPage": 262,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12983,
            "SureId": 15,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "“Korkma” dediler, “Biz sana bilgili bir çocuk müjdeliyoruz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12990,
            "SureId": 15,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "İbrâhim, “Üzerime yaşlılık çökmüş olmasına rağmen bana böyle bir müjde getiriyorsunuz öyle mi? Peki (çocuğum olamayacağına göre) bana neyi müjdelemiş oluyorsunuz?” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12997,
            "SureId": 15,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "“Sana gerçeği müjdeledik. Sakın ümitsizliğe kapılanlardan olma!” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13004,
            "SureId": 15,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "“Haktan sapmış olanlardan başka kim rabbimin rahmetinden ümit keser!” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13011,
            "SureId": 15,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "“Ey elçiler! Göreviniz nedir?” diye sordu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13018,
            "SureId": 15,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "Dediler ki: “Aslında biz, suçlu bir kavme (ceza vermek için) gönderildik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13025,
            "SureId": 15,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "Yalnız Lût’un ailesine zarar gelmeyecek, onların hepsini kurtaracağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13032,
            "SureId": 15,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "Fakat karısı hariç! Biz onun da geride kalanlardan olmasını takdir ettik.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13039,
            "SureId": 15,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61-62",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "Elçiler Lût ailesine geldiklerinde Lût onlara, “Bilinmedik tanınmadık kimselersiniz” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13046,
            "SureId": 15,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": false,
            "Page": 265,
            "AyetText": "Elçiler Lût ailesine geldiklerinde Lût onlara, \"bilinmedik tanınmadık kimselersiniz\" dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13053,
            "SureId": 15,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "“Öyle ama, biz sana insanların, hakkında kuşkuya düştükleri şeyi getirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13060,
            "SureId": 15,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "Sana, gerçeği getirdik. Biz muhakkak doğru söylüyoruz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13067,
            "SureId": 15,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "“Hemen gecenin bir vaktinde ailenin hızla yola koyulmasını sağla! Sen de arkalarından git! Hiçbiriniz arkasına dönüp bakmasın! Size emredilen yere doğru gidin!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13074,
            "SureId": 15,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "Lût’a şu hükmü bildirdik: “Onlar, sabah vaktine girerken son ferdine kadar yok edilmiş olacaktır!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13081,
            "SureId": 15,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "Şehir halkı sevinerek geldiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13088,
            "SureId": 15,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "Lût, “Bunlar benim misafirlerim, sakın beni utandıracak bir şey yapmayın?” dedi;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13095,
            "SureId": 15,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "“Allah’tan korkun, beni rezil etmeyin!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 13102,
            "SureId": 15,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 265,
            "AyetText": "“Seni el âlemi korumaktan menetmedik mi?” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
