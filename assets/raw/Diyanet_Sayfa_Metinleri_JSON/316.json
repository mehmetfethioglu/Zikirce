    "QuranAyats": [
        {
            "Id": 16891,
            "SureId": 20,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "قَالُوا یَا مُوسٰٓى اِمَّٓا اَنْ تُلْقِیَ وَاِمَّٓا اَنْ نَكُونَ اَوَّلَ مَنْ اَلْقٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16898,
            "SureId": 20,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "قَالَ بَلْ اَلْقُواۚ فَاِذَا حِبَالُهُمْ وَعِصِیُّهُمْ یُخَیَّلُ اِلَیْهِ مِنْ سِحْرِهِمْ اَنَّهَا تَسْعٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16905,
            "SureId": 20,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "فَاَوْجَسَ فٖی نَفْسِهٖ خٖیفَةً مُوسٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16912,
            "SureId": 20,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "قُلْنَا لَا تَخَفْ اِنَّكَ اَنْتَ الْاَعْلٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16919,
            "SureId": 20,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "وَاَلْقِ مَا فٖی یَمٖینِكَ تَلْقَفْ مَا صَنَعُواؕ اِنَّمَا صَنَعُوا كَیْدُ سَاحِرٍؕ وَلَا یُفْلِحُ السَّاحِرُ حَیْثُ اَتٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16926,
            "SureId": 20,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "فَاُلْقِیَ السَّحَرَةُ سُجَّدًا قَالُٓوا اٰمَنَّا بِرَبِّ هٰرُونَ وَمُوسٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16933,
            "SureId": 20,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "قَالَ اٰمَنْتُمْ لَهُ قَبْلَ اَنْ اٰذَنَ لَكُمْؕ اِنَّهُ لَكَبٖیرُكُمُ الَّذٖی عَلَّمَكُمُ السِّحْرَۚ فَلَاُقَطِّعَنَّ اَیْدِیَكُمْ وَاَرْجُلَكُمْ مِنْ خِلَافٍ وَلَاُصَلِّبَنَّكُمْ فٖی جُذُوعِ النَّخْلِؗ وَلَتَعْلَمُنَّ اَیُّنَٓا اَشَدُّ عَذَابًا وَاَبْقٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16940,
            "SureId": 20,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "قَالُوا لَنْ نُؤْثِرَكَ عَلٰى مَا جَٓاءَنَا مِنَ الْبَیِّنَاتِ وَالَّذٖی فَطَرَنَا فَاقْضِ مَٓا اَنْتَ قَاضٍؕ اِنَّمَا تَقْضٖی هٰذِهِ الْحَیٰوةَ الدُّنْیَاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16947,
            "SureId": 20,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "اِنَّٓا اٰمَنَّا بِرَبِّنَا لِیَغْفِرَ لَنَا خَطَایَانَا وَمَٓا اَكْرَهْتَنَا عَلَیْهِ مِنَ السِّحْرِؕ وَاللّٰهُ خَیْرٌ وَاَبْقٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16954,
            "SureId": 20,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "اِنَّهُ مَنْ یَاْتِ رَبَّهُ مُجْرِمًا فَاِنَّ لَهُ جَهَنَّمَؕ لَا یَمُوتُ فٖیهَا وَلَا یَحْیٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16961,
            "SureId": 20,
            "AyetId": 75,
            "LanguageId": 7,
            "AyetNumber": "٧٥",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "وَمَنْ یَاْتِهٖ مُؤْمِنًا قَدْ عَمِلَ الصَّالِحَاتِ فَاُو𐻾لٰٓئِكَ لَهُمُ الدَّرَجَاتُ الْعُلٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16968,
            "SureId": 20,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "جَنَّاتُ عَدْنٍ تَجْرٖی مِنْ تَحْتِهَا الْاَنْهَارُ خَالِدٖینَ فٖیهَاؕ وَذٰلِكَ جَزٰٓؤُ𐻾ا مَنْ تَزَكّٰىࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 16889,
            "SureId": 20,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "Dediler ki: “Ey Mûsâ! Ya sen at, yahut ilk atan biz olalım.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16896,
            "SureId": 20,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "O “Hayır, siz atın” dedi. Bir de baktı ki, onların ipleri ve sopaları yaptıkları sihirden ötürü kendisine doğru akıp geliyor gibi görünüyor!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16903,
            "SureId": 20,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "Mûsâ birden içinde bir korku duydu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16910,
            "SureId": 20,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "“Korkma!” dedik, “Üstün gelecek olan kesinlikle sensin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16917,
            "SureId": 20,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "Sağ elindekini at da onların yaptıklarını yalayıp yutsun; onların yaptığı sihirbaz hilesinden ibaret. Sihirbaz ise amacı ne olursa olsun başarıya ulaşamaz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16924,
            "SureId": 20,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "Sonunda sihirbazlar secdeye kapandılar ve “Biz Mûsâ ile Hârûn’un rabbine iman ettik” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16931,
            "SureId": 20,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "Firavun şöyle çıkıştı: “Ben size izin vermeden ona inandınız öyle mi? Anlaşılıyor ki o size sihri öğreten büyüğünüzdür. Ama ahdim olsun ben de sizin ellerinizi ve ayaklarınızı çaprazlama keseceğim ve sizi hurma dallarına asacağım! Böylece hangimizin cezasının daha şiddetli ve kalıcı olduğunu anlayacaksınız!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16938,
            "SureId": 20,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "Onlar şu cevabı verdiler: “Bize gelen bunca apaçık kanıtlara ve bizi yaratana karşı asla seni tercih edemeyiz. Artık sen neye hükmedeceksen et; ama sen ancak bu dünya hayatında hükmünü geçirebilirsin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16945,
            "SureId": 20,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "Hatalarımızdan ve bize zorla yaptırdığın sihirden ötürü bizi bağışlaması için rabbimize kesin olarak iman ettik. Hayırlı ve sürekli olan Allah’tır.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16952,
            "SureId": 20,
            "AyetId": 74,
            "LanguageId": 5,
            "AyetNumber": "74",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "Kim rabbine günahkâr haliyle varırsa, bilsin ki cehennem onu beklemektedir; orada ne ölür ne de düzgün yaşar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16959,
            "SureId": 20,
            "AyetId": 75,
            "LanguageId": 5,
            "AyetNumber": "75",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "Dünya ve âhirete yararlı işler yapmış bir mümin olarak onun huzuruna çıkan kimseler için ise üstün dereceler vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16966,
            "SureId": 20,
            "AyetId": 76,
            "LanguageId": 5,
            "AyetNumber": "76",
            "AyetVisible": true,
            "Page": 316,
            "AyetText": "İçinde ebedî olarak kalacakları, altından ırmaklar akan adn cennetleri! İşte günahlardan arınanların ödülü budur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Tâhâ",
    "QuranSureLabel": "طٰهٰ",
    "EndPageSure": null
}