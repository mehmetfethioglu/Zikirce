    "QuranAyats": [
        {
            "Id": 12621,
            "SureId": 15,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "الٓـرٰࣞ تِلْكَ اٰیَاتُ الْكِتَابِ وَقُرْاٰنٍ مُبٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 15,
                "MealInfo": "Mekke döneminde inmiştir. 99 âyettir. Sûre, adını 80. âyette geçen <b>“Hicr” </b>kelimesinden almıştır. Hicr, Medine’nin kuzeyinde vaktiyle Semûd kavminin yaşadığı bir yerin adıdır. Sûre de başlıca Allah’ın birliği, peygamberlik, öldükten sonra dirilme ve hesap konuları; peygamberlerin, çeşitli zamanlarda azgınlara ve inkârcılara karşı verdikleri mücadeleler çerçevesinde ele alınmaktadır. Bu sûre de ayrıca ilâhî kitapların kendisiyle kemale erdiği Kur’an’ın, her türlü tahriften korunacağı hükmü de yer almaktadır.",
                "SureNameTurkish": "Hicr",
                "SureNameArabic": "الْحِجْرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 54,
                "AyetCount": 99,
                "Cuz": 14,
                "FirstPage": 262,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12628,
            "SureId": 15,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "رُبَمَا یَوَدُّ الَّذٖینَ كَفَرُوا لَوْ كَانُوا مُسْلِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12635,
            "SureId": 15,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "ذَرْهُمْ یَاْكُلُوا وَیَتَمَتَّعُوا وَیُلْهِهِمُ الْاَمَلُ فَسَوْفَ یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12642,
            "SureId": 15,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "وَمَٓا اَهْلَكْنَا مِنْ قَرْیَةٍ اِلَّا وَلَهَا كِتَابٌ مَعْلُومٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12649,
            "SureId": 15,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "مَا تَسْبِقُ مِنْ اُمَّةٍ اَجَلَهَا وَمَا یَسْتَاْخِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12656,
            "SureId": 15,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "وَقَالُوا یَٓا اَیُّهَا الَّذٖی نُزِّلَ عَلَیْهِ الذِّكْرُ اِنَّكَ لَمَجْنُونٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12663,
            "SureId": 15,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "لَوْ مَا تَاْتٖینَا بِالْمَلٰٓئِكَةِ اِنْ كُنْتَ مِنَ الصَّادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12670,
            "SureId": 15,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "مَا نُنَزِّلُ الْمَلٰٓئِكَةَ اِلَّا بِالْحَقِّ وَمَا كَانُٓوا اِذًا مُنْظَرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12677,
            "SureId": 15,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "اِنَّا نَحْنُ نَزَّلْنَا الذِّكْرَ وَاِنَّا لَهُ لَحَافِظُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12684,
            "SureId": 15,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "وَلَقَدْ اَرْسَلْنَا مِنْ قَبْلِكَ فٖی شِیَعِ الْاَوَّلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12691,
            "SureId": 15,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "وَمَا یَاْتٖیهِمْ مِنْ رَسُولٍ اِلَّا كَانُوا بِهٖ یَسْتَهْزِؤُ𐻿نَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12698,
            "SureId": 15,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "كَذٰلِكَ نَسْلُكُهُ فٖی قُلُوبِ الْمُجْرِمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12705,
            "SureId": 15,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "لَا یُؤْمِنُونَ بِهٖ وَقَدْ خَلَتْ سُنَّةُ الْاَوَّلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12712,
            "SureId": 15,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "وَلَوْ فَتَحْنَا عَلَیْهِمْ بَابًا مِنَ السَّمَٓاءِ فَظَلُّوا فٖیهِ یَعْرُجُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12719,
            "SureId": 15,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "لَقَالُٓوا اِنَّمَا سُكِّرَتْ اَبْصَارُنَا بَلْ نَحْنُ قَوْمٌ مَسْحُورُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 12619,
            "SureId": 15,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "Elif-lâm-râ. Bunlar kitabın, apaçık Kur’an’ın âyetleridir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 15,
                "MealInfo": "Mekke döneminde inmiştir. 99 âyettir. Sûre, adını 80. âyette geçen <b>“Hicr” </b>kelimesinden almıştır. Hicr, Medine’nin kuzeyinde vaktiyle Semûd kavminin yaşadığı bir yerin adıdır. Sûre de başlıca Allah’ın birliği, peygamberlik, öldükten sonra dirilme ve hesap konuları; peygamberlerin, çeşitli zamanlarda azgınlara ve inkârcılara karşı verdikleri mücadeleler çerçevesinde ele alınmaktadır. Bu sûre de ayrıca ilâhî kitapların kendisiyle kemale erdiği Kur’an’ın, her türlü tahriften korunacağı hükmü de yer almaktadır.",
                "SureNameTurkish": "Hicr",
                "SureNameArabic": "الْحِجْرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 54,
                "AyetCount": 99,
                "Cuz": 14,
                "FirstPage": 262,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12626,
            "SureId": 15,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "Zaman olacak, inkâr edenler, “Keşke müslüman olsaydık!” diye hayıflanacaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12633,
            "SureId": 15,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "Bırak onları; yesinler, yararlansınlar, boş ümit oyalasın onları; yakında bilecekler!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12640,
            "SureId": 15,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "Biz hiçbir toplumu, kendilerine gönderilmiş belli bir kitap olmadan helâk etmedik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12647,
            "SureId": 15,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "Hiçbir ümmet kendi ecelini ne öne alabilir ne de erteleyebilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12654,
            "SureId": 15,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "Dediler ki: “Ey kendisine vahiy gelen adam! Sen kesinlikle cinlere kapılmış birisin!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12661,
            "SureId": 15,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "“Doğru söyleyenlerden isen bize melekleri getirseydin ya!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12668,
            "SureId": 15,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "Biz melekleri ancak açık gerçekle indiririz, o zaman da onlara artık süre tanınmaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12675,
            "SureId": 15,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "Kesin olarak bilesiniz ki bu kitabı kuşkusuz biz indirdik ve onu mutlaka koruyan da yine biziz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12682,
            "SureId": 15,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "Andolsun senden önce de eski topluluklar arasından elçiler göndermiştik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12689,
            "SureId": 15,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "Onlara bir peygamber geldiğinde muhakkak onunla alay ederlerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12696,
            "SureId": 15,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12-13",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "İşte onu (Kur’an’ı) inkârcıların kalplerine, inanmadıkları halde böyle yerleştiririz. Nitekim daha öncekilere de bu ilâhî kanun uygulanmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12703,
            "SureId": 15,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": false,
            "Page": 262,
            "AyetText": "İşte onu (Kur’an’ı) inkârcıların kalplerine, inanmadıkları halde böyle yerleştiririz. Nitekim daha öncekilere de bu ilâhî kanun uygulanmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12710,
            "SureId": 15,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14-15",
            "AyetVisible": true,
            "Page": 262,
            "AyetText": "Onlara gökten bir kapı açsak da oradan yukarı çıksalar, yine de “Herhalde gözlerimiz perdelendi, hatta bize büyü yapılmış olmalı!” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
