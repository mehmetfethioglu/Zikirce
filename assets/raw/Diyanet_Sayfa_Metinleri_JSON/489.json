            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "وَكَذٰلِكَ اَوْحَیْنَٓا اِلَیْكَ رُوحًا مِنْ اَمْرِنَاؕ مَا كُنْتَ تَدْرٖی مَا الْكِتَابُ وَلَا الْاٖیمَانُ وَلٰكِنْ جَعَلْنَاهُ نُورًا نَهْدٖی بِهٖ مَنْ نَشَٓاءُ مِنْ عِبَادِنَاؕ وَاِنَّكَ لَتَهْدٖٓی اِلٰى صِرَاطٍ مُسْتَقٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 42,
                "MealInfo": "Mekke döneminde inmiştir. 53 âyettir. Sûre, adını 38. âyette geçen<b> “Şûrâ” </b>kelimesinden almıştır.<b> Şûrâ, danışma demektir.</b> Sûrede <b>başlıca müslümanların işlerini kendi aralarında danışma yoluyla yürüttükleri, ayrıca kâinatta Allah’ın birliğini gösteren deliller ve kıyamet gününün hâlleri konu </b>edilmektedir",
                "SureNameTurkish": "Şûrâ",
                "SureNameArabic": "الشُّورٰى",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 62,
                "AyetCount": 53,
                "Cuz": 25,
                "FirstPage": 483,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30275,
            "SureId": 42,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "صِرَاطِ اللّٰهِ الَّذٖی لَهُ مَا فِی السَّمٰوَاتِ وَمَا فِی الْاَرْضِؕ اَلَٓا اِلَى اللّٰهِ تَصٖیرُ الْاُمُورُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30282,
            "SureId": 43,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "حٰمٓؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 43,
                "MealInfo": "Mekke döneminde inmiştir. 89 âyettir. Sûre, adını 35. âyette geçen <b>“Zuhruf ” </b>kelimesinden almaktadır. <b>Zuhruf; yaldız, mücevher, dünya hayatının geçici menfaati anlamlarına gelir. </b>Sûrede başlıca tevhit, iman ve vahyin getirdiği hakikatler ile insanların bu hakikatlere ters düşecek şekilde sırf geçici dünya menfaatlerine bağlanarak sergiledikleri çelişki vurgulanmakta, batıla karşı çıkan ve hakkı tutan şahsiyetler olarak İbrahim, Mûsâ ve İsa Peygamberlerden söz edilmektedir.",
                "SureNameTurkish": "Zuhruf",
                "SureNameArabic": "الزُّخْرُفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 63,
                "AyetCount": 89,
                "Cuz": 25,
                "FirstPage": 489,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30289,
            "SureId": 43,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "وَالْكِتَابِ الْمُبٖینِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30296,
            "SureId": 43,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "اِنَّا جَعَلْنَاهُ قُرْءٰنًا عَرَبِیًّا لَعَلَّكُمْ تَعْقِلُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30303,
            "SureId": 43,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "وَاِنَّهُ فٖٓی اُمِّ الْكِتَابِ لَدَیْنَا لَعَلِیٌّ حَكٖیمٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30310,
            "SureId": 43,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "اَفَنَضْرِبُ عَنْكُمُ الذِّكْرَ صَفْحًا اَنْ كُنْتُمْ قَوْمًا مُسْرِفٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30317,
            "SureId": 43,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "وَكَمْ اَرْسَلْنَا مِنْ نَبِیٍّ فِی الْاَوَّلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30324,
            "SureId": 43,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "وَمَا یَاْتٖیهِمْ مِنْ نَبِیٍّ اِلَّا كَانُوا بِهٖ یَسْتَهْزِؤُ𐻿نَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30331,
            "SureId": 43,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "فَاَهْلَكْنَٓا اَشَدَّ مِنْهُمْ بَطْشًا وَمَضٰى مَثَلُ الْاَوَّلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30338,
            "SureId": 43,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "وَلَئِنْ سَاَلْتَهُمْ مَنْ خَلَقَ السَّمٰوَاتِ وَالْاَرْضَ لَیَقُولُنَّ خَلَقَهُنَّ الْعَزٖیزُ الْعَلٖیمُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30345,
            "SureId": 43,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "اَلَّذٖی جَعَلَ لَكُمُ الْاَرْضَ مَهْدًا وَجَعَلَ لَكُمْ فٖیهَا سُبُلًا لَعَلَّكُمْ تَهْتَدُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 30266,
            "SureId": 42,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52-53",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "İşte böylece sana da kendi buyruğumuzla bir ruh (Kur’an) vahyettik. Sen kitap nedir, iman nedir bilmiyordun; ama şimdi onu, dilediğimiz kullarımızı sayesinde doğruya eriştirdiğimiz bir ışık kıldık. Hiç şüphe yok ki sen doğru yolu, göklerin ve yerin yegâne sahibi olan Allah’ın yolunu göstermektesin. İyi bilinmeli ki bütün işler dönüp dolaşır Allah’a varır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 42,
                "MealInfo": "Mekke döneminde inmiştir. 53 âyettir. Sûre, adını 38. âyette geçen<b> “Şûrâ” </b>kelimesinden almıştır.<b> Şûrâ, danışma demektir.</b> Sûrede <b>başlıca müslümanların işlerini kendi aralarında danışma yoluyla yürüttükleri, ayrıca kâinatta Allah’ın birliğini gösteren deliller ve kıyamet gününün hâlleri konu </b>edilmektedir",
                "SureNameTurkish": "Şûrâ",
                "SureNameArabic": "الشُّورٰى",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 62,
                "AyetCount": 53,
                "Cuz": 25,
                "FirstPage": 483,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30273,
            "SureId": 42,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": false,
            "Page": 489,
            "AyetText": "Göklerin ve yerin yegâne sahibi olan Allah’ın yolunu. İyi bilinmeli ki bütün işler dönüp dolaşır Allah’a varır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30280,
            "SureId": 43,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "Hâ-mîm.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 43,
                "MealInfo": "Mekke döneminde inmiştir. 89 âyettir. Sûre, adını 35. âyette geçen <b>“Zuhruf ” </b>kelimesinden almaktadır. <b>Zuhruf; yaldız, mücevher, dünya hayatının geçici menfaati anlamlarına gelir. </b>Sûrede başlıca tevhit, iman ve vahyin getirdiği hakikatler ile insanların bu hakikatlere ters düşecek şekilde sırf geçici dünya menfaatlerine bağlanarak sergiledikleri çelişki vurgulanmakta, batıla karşı çıkan ve hakkı tutan şahsiyetler olarak İbrahim, Mûsâ ve İsa Peygamberlerden söz edilmektedir.",
                "SureNameTurkish": "Zuhruf",
                "SureNameArabic": "الزُّخْرُفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 63,
                "AyetCount": 89,
                "Cuz": 25,
                "FirstPage": 489,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 30287,
            "SureId": 43,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "Aydınlatan kitaba yemin olsun ki,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30294,
            "SureId": 43,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "Anlayıp düşünesiniz diye onu Arapça Kur’an olarak indirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30301,
            "SureId": 43,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "Kuşkusuz o, katımızdaki ana kitaptadır; çok yücedir, hikmetle doludur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30308,
            "SureId": 43,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "Siz kıymet bilmez bir topluluksunuz diye biz de sizi Kur’an ile uyarmaktan vaz mı geçelim?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30315,
            "SureId": 43,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "Sizden önce gelip geçenlere de nice peygamberler gönderdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30322,
            "SureId": 43,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "Kendilerine gelen her peygamber ile alay edip durdular.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30329,
            "SureId": 43,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "Bunlardan daha zorba olanları da silip süpürdük. Gelip geçenlerin örnek hikâyeleri (ilâhî kitaplarda) daha önce de anlatılmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30336,
            "SureId": 43,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "Kendilerine “Gökleri ve yeri kim yarattı?” diye sorsan tereddüt etmeden, “Onları sonsuz güç ve ilim sahibi yarattı” diyeceklerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 30343,
            "SureId": 43,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 489,
            "AyetText": "Yeri sizin için döşek kılan, gideceğiniz yere şaşmadan varasınız diye orada size yollar yaratan O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
