            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39739,
            "SureId": 78,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "ثُمَّ كَلَّا سَیَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39746,
            "SureId": 78,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "اَلَمْ نَجْعَلِ الْاَرْضَ مِهَادًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39753,
            "SureId": 78,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "وَالْجِبَالَ اَوْتَادًاࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39760,
            "SureId": 78,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "وَخَلَقْنَاكُمْ اَزْوَاجًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39767,
            "SureId": 78,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39774,
            "SureId": 78,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "وَجَعَلْنَا الَّیْلَ لِبَاسًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39781,
            "SureId": 78,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "وَجَعَلْنَا النَّهَارَ مَعَاشًاࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39788,
            "SureId": 78,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "وَبَنَیْنَا فَوْقَكُمْ سَبْعًا شِدَادًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39795,
            "SureId": 78,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "وَجَعَلْنَا سِرَاجًا وَهَّاجًاࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39802,
            "SureId": 78,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "وَاَنْزَلْنَا مِنَ الْمُعْصِرَاتِ مَٓاءً ثَجَّاجًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39809,
            "SureId": 78,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "لِنُخْرِجَ بِهٖ حَبًّا وَنَبَاتًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39816,
            "SureId": 78,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "وَجَنَّاتٍ اَلْفَافًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39823,
            "SureId": 78,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "اِنَّ یَوْمَ الْفَصْلِ كَانَ مٖیقَاتًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39830,
            "SureId": 78,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "یَوْمَ یُنْفَخُ فِی الصُّورِ فَتَاْتُونَ اَفْوَاجًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39837,
            "SureId": 78,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "وَفُتِحَتِ السَّمَٓاءُ فَكَانَتْ اَبْوَابًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39844,
            "SureId": 78,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "وَسُیِّرَتِ الْجِبَالُ فَكَانَتْ سَرَابًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39851,
            "SureId": 78,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "اِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39858,
            "SureId": 78,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "لِلطَّاغٖینَ مَاٰبًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39865,
            "SureId": 78,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "لَابِثٖینَ فٖیهَٓا اَحْقَابًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39872,
            "SureId": 78,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "لَا یَذُوقُونَ فٖیهَا بَرْدًا وَلَا شَرَابًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39879,
            "SureId": 78,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "اِلَّا حَمٖیمًا وَغَسَّاقًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39886,
            "SureId": 78,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "جَزَٓاءً وِفَاقًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39893,
            "SureId": 78,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "اِنَّهُمْ كَانُوا لَا یَرْجُونَ حِسَابًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39900,
            "SureId": 78,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "وَكَذَّبُوا بِاٰیَاتِنَا كِذَّابًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39907,
            "SureId": 78,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "وَكُلَّ شَیْءٍ اَحْصَیْنَاهُ كِتَابًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39914,
            "SureId": 78,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "فَذُوقُوا فَلَنْ نَزٖیدَكُمْ اِلَّا عَذَابًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
