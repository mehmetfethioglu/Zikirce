            "LanguageId": 5,
            "AyetNumber": "6-7",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "Biz, yeryüzünü bir döşek, dağları da (yeri dengede tutan) kazıklar yapmadık mı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39751,
            "SureId": 78,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": false,
            "Page": 582,
            "AyetText": "Biz, yeryüzünü bir döşek, dağları da (yeri tutan) kazıklar yapmadık mı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39758,
            "SureId": 78,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "Sizi çifter çifter yarattık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39765,
            "SureId": 78,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "Uykunuzu dinlenme vesilesi kıldık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39772,
            "SureId": 78,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "Geceyi (uyku için) örtü yaptık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39779,
            "SureId": 78,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "Gündüzü de çalışıp kazanma zamanı kıldık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39786,
            "SureId": 78,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "Üstünüzde yedi kat sağlam gök yaptık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39793,
            "SureId": 78,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "Orada ısı ve aydınlık saçan bir lamba yarattık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39800,
            "SureId": 78,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14-16",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "Size tohumlar, bitkiler, sarmaş dolaş olmuş bağlar bahçeler bitirmemiz için yoğun bulutlardan oluk gibi boşalan sular indirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39807,
            "SureId": 78,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": false,
            "Page": 582,
            "AyetText": "Size tohumlar, bitkiler, sarmaş dolaş olmuş bağlar bahçeler yetiştirmemiz için yoğun bulutlardan oluk gibi boşalan sular indirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39814,
            "SureId": 78,
            "AyetId": 16,
