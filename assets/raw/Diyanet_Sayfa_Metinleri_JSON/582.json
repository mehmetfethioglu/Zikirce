            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39828,
            "SureId": 78,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 582,
