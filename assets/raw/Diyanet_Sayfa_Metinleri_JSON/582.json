            "SureId": 78,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "Gökyüzü açılır da orada pek çok kapı oluşur.",
