        },
        {
            "Id": 39737,
            "SureId": 78,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 582,
            "AyetText": "Hayır hayır! Yakında görecekler!",
