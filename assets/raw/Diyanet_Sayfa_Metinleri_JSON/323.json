{
    "PointerList": null,
    "CuzNo": 17,
    "PageNo": 323,
    "ArCuzNo": "۱۷",
    "ArPageNo": "۳۲۳",
    "QuranAyats": [
        {
            "Id": 17458,
            "SureId": 21,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "وَكَمْ قَصَمْنَا مِنْ قَرْیَةٍ كَانَتْ ظَالِمَةً وَاَنْشَاْنَا بَعْدَهَا قَوْمًا اٰخَرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17465,
            "SureId": 21,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "فَلَمَّٓا اَحَسُّوا بَاْسَنَٓا اِذَا هُمْ مِنْهَا یَرْكُضُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17472,
            "SureId": 21,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "لَا تَرْكُضُوا وَارْجِعُٓوا اِلٰى مَٓا اُتْرِفْتُمْ فٖیهِ وَمَسَاكِنِكُمْ لَعَلَّكُمْ تُسْـَٔلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17479,
            "SureId": 21,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "قَالُوا یَا وَیْلَنَٓا اِنَّا كُنَّا ظَالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17486,
            "SureId": 21,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "فَمَا زَالَتْ تِلْكَ دَعْوٰیهُمْ حَتّٰى جَعَلْنَاهُمْ حَصٖیدًا خَامِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17493,
            "SureId": 21,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "وَمَا خَلَقْنَا السَّمَٓاءَ وَالْاَرْضَ وَمَا بَیْنَهُمَا لَاعِبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17500,
            "SureId": 21,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "لَوْ اَرَدْنَٓا اَنْ نَتَّخِذَ لَهْوًا لَاتَّخَذْنَاهُ مِنْ لَدُنَّاࣗ اِنْ كُنَّا فَاعِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17507,
            "SureId": 21,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "بَلْ نَقْذِفُ بِالْحَقِّ عَلَى الْبَاطِلِ فَیَدْمَغُهُ فَاِذَا هُوَ زَاهِقٌؕ وَلَكُمُ الْوَیْلُ مِمَّا تَصِفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17514,
            "SureId": 21,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "وَلَهُ مَنْ فِی السَّمٰوَاتِ وَالْاَرْضِؕ وَمَنْ عِنْدَهُ لَا یَسْتَكْبِرُونَ عَنْ عِبَادَتِهٖ وَلَا یَسْتَحْسِرُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17521,
            "SureId": 21,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "یُسَبِّحُونَ الَّیْلَ وَالنَّهَارَ لَا یَفْتُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17528,
            "SureId": 21,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "اَمِ اتَّخَذُٓوا اٰلِهَةً مِنَ الْاَرْضِ هُمْ یُنْشِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17535,
            "SureId": 21,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "لَوْ كَانَ فٖیهِمَٓا اٰلِهَةٌ اِلَّا اللّٰهُ لَفَسَدَتَاۚ فَسُبْحَانَ اللّٰهِ رَبِّ الْعَرْشِ عَمَّا یَصِفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17542,
            "SureId": 21,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "لَا یُسْـَٔلُ عَمَّا یَفْعَلُ وَهُمْ یُسْـَٔلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17549,
            "SureId": 21,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "اَمِ اتَّخَذُوا مِنْ دُونِهٖٓ اٰلِهَةًؕ قُلْ هَاتُوا بُرْهَانَكُمْۚ هٰذَا ذِكْرُ مَنْ مَعِیَ وَذِكْرُ مَنْ قَبْلٖیؕ بَلْ اَكْثَرُهُمْ لَا یَعْلَمُونَۙ الْحَقَّ فَهُمْ مُعْرِضُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 17456,
            "SureId": 21,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "Biz, halkı zulme sapmış nice ülkeyi yerle bir ettik, arkasından da başka topluluklar vücuda getirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17463,
            "SureId": 21,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "Azabımızı hissettiklerinde bakarsın ki yerlerinden kaçıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17470,
            "SureId": 21,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "“Kaçmayın! İçinde bulunduğunuz refaha ve yurtlarınıza dönün; herhalde sorgulanacaksınız!” (dendiğinde);",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17477,
            "SureId": 21,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "“Vay başımıza gelenlere! Gerçekten biz zalim insanlarmışız!” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17484,
            "SureId": 21,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "Biz kendilerini biçilmiş ekine, sönmüş ateşe çevirinceye kadar bu yakınmaları sürüp gider.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17491,
            "SureId": 21,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "Biz gökleri, yeri ve bunlar arasındakileri oyun olsun diye yaratmadık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17498,
            "SureId": 21,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "Eğer bir eğlence edinmek isteseydik, onu kendi katımızdan edinirdik, bunu asla yapmayız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17505,
            "SureId": 21,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "Bilâkis biz, hakkı bâtılın başına çarparız da onun işini bitirir; bir de bakarsınız ki bâtıl yok olup gitmiştir. (Allah’a) yakıştırdığınız sıfatlardan dolayı yazıklar olsun size!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17512,
            "SureId": 21,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "Göklerde ve yerde olanlar hep O’na aittir. O’nun huzurunda bulunanlar, O’na ibadet etme hususunda ne büyüklenirler ne de yorulurlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17519,
            "SureId": 21,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "Onlar, bıkıp usanmaksızın gece gündüz Allah’ı tenzih ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17526,
            "SureId": 21,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "Yoksa onlar, yeryüzünden birtakım tanrılar edindiler de ölüleri bunlar mı diriltecek?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17533,
            "SureId": 21,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "Eğer yerde ve gökte Allah’tan başka tanrılar bulunsaydı kesinlikle yerin göğün düzeni bozulurdu. Demek ki arşın rabbi olan Allah, onların yakıştırdıkları sıfatlardan münezzehtir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17540,
            "SureId": 21,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "Allah, yaptığından sorumlu tutulamaz; onlar ise sorguya çekileceklerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17547,
            "SureId": 21,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 323,
            "AyetText": "Yoksa O’ndan başka birtakım tanrılar mı edindiler? De ki: “Haydi delilinizi getirin! İşte benimle beraber olanların söylediği, işte benden öncekilerin söylediği!” Hayır, onların çoğu hakkı bilmezler; bunun için de inatla yüz çevirirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Enbiyâ",
    "QuranSureLabel": "الْاَنْبِيَاءِ",
    "EndPageSure": null
}