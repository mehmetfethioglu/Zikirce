{
    "PointerList": null,
    "CuzNo": 30,
    "PageNo": 583,
    "ArCuzNo": "۳۰",
    "ArPageNo": "٥۸۳",
    "QuranAyats": [
        {
            "Id": 39921,
            "SureId": 78,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "اِنَّ لِلْمُتَّقٖینَ مَفَازًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 78,
                "MealInfo": "Mekke döneminde inmiştir. 40 âyettir. Sûre, adını ikinci âyette geçen “enNebe’”kelimesinden almıştır. Nebe’, haber demektir. Sûrede, ölüm ötesi hayatınvarlığını ispat çerçevesinde, kıyamet, öldükten sonra dirilme ve hesap için toplanma konularına yer verilmektedir.",
                "SureNameTurkish": "Nebe",
                "SureNameArabic": "النَّبَأِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 80,
                "AyetCount": 40,
                "Cuz": 30,
                "FirstPage": 582,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 39928,
            "SureId": 78,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "حَدَٓائِقَ وَاَعْنَابًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39935,
            "SureId": 78,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "وَكَوَاعِبَ اَتْرَابًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39942,
            "SureId": 78,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "وَكَاْسًا دِهَاقًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39949,
            "SureId": 78,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "لَا یَسْمَعُونَ فٖیهَا لَغْوًا وَلَا كِذَّابًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39956,
            "SureId": 78,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "جَزَٓاءً مِنْ رَبِّكَ عَطَٓاءً حِسَابًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39963,
            "SureId": 78,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "رَبِّ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَیْنَهُمَاۙ الرَّحْمٰنِ لَا یَمْلِكُونَ مِنْهُ خِطَابًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39970,
            "SureId": 78,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "یَوْمَ یَقُومُ الرُّوحُ وَالْمَلٰٓئِكَةُ صَفًّاؕ لَا یَتَكَلَّمُونَ اِلَّا مَنْ اَذِنَ لَهُ الرَّحْمٰنُ وَقَالَ صَوَابًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39977,
            "SureId": 78,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "ذٰلِكَ الْیَوْمُ الْحَقُّۚ فَمَنْ شَٓاءَ اتَّخَذَ اِلٰى رَبِّهٖ مَاٰبًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39984,
            "SureId": 78,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "اِنَّٓا اَنْذَرْنَا‌كُمْ عَذَابًا قَرٖیبًاۚ یَوْمَ یَنْظُرُ الْمَرْءُ مَا قَدَّمَتْ یَدَاهُ وَیَقُولُ الْكَافِرُ یَا لَیْتَنٖی كُنْتُ تُرَابًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39991,
            "SureId": 79,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "وَالنَّازِعَاتِ غَرْقًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 79,
                "MealInfo": "Mekke döneminde inmiştir. 46 âyettir. Sûre, adını birinci âyetteki “en-Nâzi’ât”kelimesinden almıştır. Nâzi’ât burada, “ruhları çekip alan melekler” demektir.Sûrede başlıca, tevhit, peygamberlik, öldükten sonra dirilme ve hesap konuedilmektedir.",
                "SureNameTurkish": "Naziât",
                "SureNameArabic": "النَّازِعَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 81,
                "AyetCount": 46,
                "Cuz": 30,
                "FirstPage": 583,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 39998,
            "SureId": 79,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "وَالنَّاشِطَاتِ نَشْطًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40005,
            "SureId": 79,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "وَالسَّابِحَاتِ سَبْحًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40012,
            "SureId": 79,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "فَالسَّابِقَاتِ سَبْقًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40019,
            "SureId": 79,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "فَالْمُدَبِّرَاتِ اَمْرًاۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40026,
            "SureId": 79,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "یَوْمَ تَرْجُفُ الرَّاجِفَةُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40033,
            "SureId": 79,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "تَتْبَعُهَا الرَّادِفَةُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40040,
            "SureId": 79,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "قُلُوبٌ یَوْمَئِذٍ وَاجِفَةٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40047,
            "SureId": 79,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "اَبْصَارُهَا خَاشِعَةٌۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40054,
            "SureId": 79,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "یَقُولُونَ ءَاِنَّا لَمَرْدُودُونَ فِی الْحَافِرَةِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40061,
            "SureId": 79,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "ءَاِذَا كُنَّا عِظَامًا نَخِرَةًؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40068,
            "SureId": 79,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "قَالُوا تِلْكَ اِذًا كَرَّةٌ خَاسِرَةٌۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40075,
            "SureId": 79,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "فَاِنَّمَا هِیَ زَجْرَةٌ وَاحِدَةٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40082,
            "SureId": 79,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "فَاِذَا هُمْ بِالسَّاهِرَةِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 39919,
            "SureId": 78,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "İtaatsizlikten sakınmış olanlar için artık murada erme zamanıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 78,
                "MealInfo": "Mekke döneminde inmiştir. 40 âyettir. Sûre, adını ikinci âyette geçen “enNebe’”kelimesinden almıştır. Nebe’, haber demektir. Sûrede, ölüm ötesi hayatınvarlığını ispat çerçevesinde, kıyamet, öldükten sonra dirilme ve hesap için toplanma konularına yer verilmektedir.",
                "SureNameTurkish": "Nebe",
                "SureNameArabic": "النَّبَأِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 80,
                "AyetCount": 40,
                "Cuz": 30,
                "FirstPage": 582,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 39926,
            "SureId": 78,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "Bahçeler, üzüm bağları;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39933,
            "SureId": 78,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "Gencecik yaşıt kızlar;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39940,
            "SureId": 78,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "Dolu dolu kadehler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39947,
            "SureId": 78,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "Orada ne boş bir söz ne de yalan işitirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39954,
            "SureId": 78,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "Bunlar rabbinin bol bol lutfettiği karşılıktır, bağıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39961,
            "SureId": 78,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "O, göklerin, yerin ve ikisi arasında bulunanların rabbidir. O, Rahmân’dır. O’nun huzurunda kimse söz söyleyemez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39968,
            "SureId": 78,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "Ruh ve meleklerin saf saf olup durduğu o gün, ancak Rahmân’ın izin verdikleri konuşur ve konuşan da doğruyu söyler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39975,
            "SureId": 78,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "İşte bu, (geleceği) kesin olan gündür. O halde artık isteyen kendisini rabbine götürecek bir yol tutsun.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39982,
            "SureId": 78,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "Kuşkusuz biz insanın önceden yapıp ettiklerini karşısında göreceği ve inkârcının, “Keşke toprak olsaydım!” diyerek dövüneceği gün gerçekleşecek olan yakın bir azaba karşı sizi uyardık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 39989,
            "SureId": 79,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "Yemin olsun, batmak üzere yükselenlere;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 79,
                "MealInfo": "Mekke döneminde inmiştir. 46 âyettir. Sûre, adını birinci âyetteki “en-Nâzi’ât”kelimesinden almıştır. Nâzi’ât burada, “ruhları çekip alan melekler” demektir.Sûrede başlıca, tevhit, peygamberlik, öldükten sonra dirilme ve hesap konuedilmektedir.",
                "SureNameTurkish": "Naziât",
                "SureNameArabic": "النَّازِعَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 81,
                "AyetCount": 46,
                "Cuz": 30,
                "FirstPage": 583,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 39996,
            "SureId": 79,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "Sâkin ve düzenli hareket edenlere;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40003,
            "SureId": 79,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "Yüzdükçe yüzenlere;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40010,
            "SureId": 79,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "Yarıştıkça yarışanlara;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40017,
            "SureId": 79,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "Emri, uygun yol ve yöntemle yerine getirenlere!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40024,
            "SureId": 79,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "O gün sarsılan şiddetle sarsılır;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40031,
            "SureId": 79,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "Onu ikinci sarsıntı izler!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40038,
            "SureId": 79,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "İşte o gün korkudan yürekler ağza gelir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40045,
            "SureId": 79,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "(İnsanların) gözlerine korku çöker.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40052,
            "SureId": 79,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10-11",
            "AyetVisible": true,
            "Page": 583,
            "AyetText": "(İnkârcılar), “Biz ilk halimize mi döndürüleceğiz? Biz çürümüş kemikler olmuş iken mi?” diyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40059,
            "SureId": 79,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": false,
            "Page": 583,
