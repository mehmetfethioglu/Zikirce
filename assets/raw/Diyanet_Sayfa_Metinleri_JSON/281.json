    "QuranAyats": [
        {
            "Id": 14140,
            "SureId": 16,
            "AyetId": 119,
            "LanguageId": 7,
            "AyetNumber": "١١٩",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "ثُمَّ اِنَّ رَبَّكَ لِلَّذٖینَ عَمِلُوا السُّٓوءَ بِجَهَالَةٍ ثُمَّ تَابُوا مِنْ بَعْدِ ذٰلِكَ وَاَصْلَحُٓواۙ اِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحٖیمٌࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
                "Cuz": 14,
                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14147,
            "SureId": 16,
            "AyetId": 120,
            "LanguageId": 7,
            "AyetNumber": "١٢٠",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "اِنَّ اِبْرٰهٖیمَ كَانَ اُمَّةً قَانِتًا لِلّٰهِ حَنٖیفًاؕ وَلَمْ یَكُ مِنَ الْمُشْرِكٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14154,
            "SureId": 16,
            "AyetId": 121,
            "LanguageId": 7,
            "AyetNumber": "١٢١",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "شَاكِرًا لِاَنْعُمِهِؕ اِجْتَبٰیهُ وَهَدٰیهُ اِلٰى صِرَاطٍ مُسْتَقٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14161,
            "SureId": 16,
            "AyetId": 122,
            "LanguageId": 7,
            "AyetNumber": "١٢٢",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "وَاٰتَیْنَاهُ فِی الدُّنْیَا حَسَنَةًؕ وَاِنَّهُ فِی الْاٰخِرَةِ لَمِنَ الصَّالِحٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14168,
            "SureId": 16,
            "AyetId": 123,
            "LanguageId": 7,
            "AyetNumber": "١٢٣",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "ثُمَّ اَوْحَیْنَٓا اِلَیْكَ اَنِ اتَّبِـعْ مِلَّةَ اِبْرٰهٖیمَ حَنٖیفًاؕ وَمَا كَانَ مِنَ الْمُشْرِكٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14175,
            "SureId": 16,
            "AyetId": 124,
            "LanguageId": 7,
            "AyetNumber": "١٢٤",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "اِنَّمَا جُعِلَ السَّبْتُ عَلَى الَّذٖینَ اخْتَلَفُوا فٖیهِؕ وَاِنَّ رَبَّكَ لَیَحْكُمُ بَیْنَهُمْ یَوْمَ الْقِیٰمَةِ فٖیمَا كَانُوا فٖیهِ یَخْتَلِفُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14182,
            "SureId": 16,
            "AyetId": 125,
            "LanguageId": 7,
            "AyetNumber": "١٢٥",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "اُدْعُ اِلٰى سَبٖیلِ رَبِّكَ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ وَجَادِلْهُمْ بِالَّتٖی هِیَ اَحْسَنُؕ اِنَّ رَبَّكَ هُوَ اَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبٖیلِهٖ وَهُوَ اَعْلَمُ بِالْمُهْتَدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14189,
            "SureId": 16,
            "AyetId": 126,
            "LanguageId": 7,
            "AyetNumber": "١٢٦",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "وَاِنْ عَاقَبْتُمْ فَعَاقِبُوا بِمِثْلِ مَا عُوقِبْتُمْ بِهٖؕ وَلَئِنْ صَبَرْتُمْ لَهُوَ خَیْرٌ لِلصَّابِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14196,
            "SureId": 16,
            "AyetId": 127,
            "LanguageId": 7,
            "AyetNumber": "١٢٧",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "وَاصْبِرْ وَمَا صَبْرُكَ اِلَّا بِاللّٰهِ وَلَا تَحْزَنْ عَلَیْهِمْ وَلَا تَكُ فٖی ضَیْقٍ مِمَّا یَمْكُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14203,
            "SureId": 16,
            "AyetId": 128,
            "LanguageId": 7,
            "AyetNumber": "١٢٨",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "اِنَّ اللّٰهَ مَعَ الَّذٖینَ اتَّقَوْا وَالَّذٖینَ هُمْ مُحْسِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 14138,
            "SureId": 16,
            "AyetId": 119,
            "LanguageId": 5,
            "AyetNumber": "119",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "Sonuç olarak senin rabbin cahillikle kötülük işleyen, ama bunun ardından tövbe edip kendilerini düzeltenlerin yardımcısıdır; onların bu dönüşünden sonra, bilesin ki, artık rabbinin mağfiret ve rahmeti de çok geniştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 16,
                "MealInfo": "Mekke döneminde inmiştir. 128 âyettir. Sûre, adını 68. âyette geçen <b>“en-Nahl”&nbsp;</b>kelimesinden almıştır.<b> “en-Nahl</b>” bal arısı demektir. Sûrede başlıca, kâinatta Allah’ın varlığını ve birliğini gösteren deliller, vahiy, öldükten sonra dirilme gibi konular yer almaktadır",
                "SureNameTurkish": "Nahl",
                "SureNameArabic": "النَّحْلِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 70,
                "AyetCount": 128,
                "Cuz": 14,
                "FirstPage": 267,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14145,
            "SureId": 16,
            "AyetId": 120,
            "LanguageId": 5,
            "AyetNumber": "120",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "Kuşkusuz İbrâhim, bir tevhid önderi olarak Allah’a gönülden itaat eden iyilik rehberiydi, müşriklerden de değildi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14152,
            "SureId": 16,
            "AyetId": 121,
            "LanguageId": 5,
            "AyetNumber": "121",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "Allah’ın nimetlerine şükrederdi; Allah onu seçkin kılmış, doğru yola yöneltmişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14159,
            "SureId": 16,
            "AyetId": 122,
            "LanguageId": 5,
            "AyetNumber": "122",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "Biz İbrâhim’e bu dünyada iyilik verdik; kuşkusuz o, âhirette de sâlihlerden olacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14166,
            "SureId": 16,
            "AyetId": 123,
            "LanguageId": 5,
            "AyetNumber": "123",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "Sonra sana, “Tevhid önderi olan ve putperestler arasında yer almamış bulunan İbrâhim’in dinine uy” diye vahyettik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14173,
            "SureId": 16,
            "AyetId": 124,
            "LanguageId": 5,
            "AyetNumber": "124",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "Sebt gününün gözetilmesi sadece onun hakkında görüş ayrılığına düşenlere gerekli kılınmıştı. Rabbin kıyamet gününde, ayrılığa düştükleri meseleyle ilgili olarak onların arasında hükmünü verecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14180,
            "SureId": 16,
            "AyetId": 125,
            "LanguageId": 5,
            "AyetNumber": "125",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "Rabbinin yoluna hikmetle ve güzel öğütle davet et; onlarla en güzel yöntemle tartış. Kuşkusuz senin rabbin, yolundan sapanların kim olduğunu en iyi bilendir; O, doğru yolda bulunanları da çok iyi bilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14187,
            "SureId": 16,
            "AyetId": 126,
            "LanguageId": 5,
            "AyetNumber": "126",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "Cezalandırmak isterseniz size yapıldığı kadarıyla cezalandırın, fakat sabır gösterirseniz bilin ki sabırlı davrananlar için bu muhakkak daha hayırlıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14194,
            "SureId": 16,
            "AyetId": 127,
            "LanguageId": 5,
            "AyetNumber": "127",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "Sen sabret; sabır göstermen de Allah’ın ihsanı sayesinde olacaktır. Onlardan dolayı üzülme, kurdukları tuzaklardan kaygı duyma.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14201,
            "SureId": 16,
            "AyetId": 128,
            "LanguageId": 5,
            "AyetNumber": "128",
            "AyetVisible": true,
            "Page": 281,
            "AyetText": "Çünkü Allah takvâ ile hareket edip iyiliği seçenlerin yanındadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Nahl",
    "QuranSureLabel": "النَّحْلِ",
    "EndPageSure": null
}