    "QuranAyats": [
        {
            "Id": 12551,
            "SureId": 14,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "مُهْطِعٖینَ مُقْنِعٖی رُؤُ𐻿سِهِمْ لَا یَرْتَدُّ اِلَیْهِمْ طَرْفُهُمْۚ وَاَفْــِٔدَتُهُمْ هَوَٓاءٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 14,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. İçinde Hz. İbrahim’den ve ailesinden söz edildiği için bu adı almıştır. Sûre de başlıca imanın temel konuları olan Allah’a iman, peygamberlere iman, öldükten sonra dirilme ve hesap ele alınmaktadır.",
                "SureNameTurkish": "İbrâhîm",
                "SureNameArabic": "اِبْرٰه۪يمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 72,
                "AyetCount": 52,
                "Cuz": 13,
                "FirstPage": 255,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12558,
            "SureId": 14,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "وَاَنْذِرِ النَّاسَ یَوْمَ یَاْتٖیهِمُ الْعَذَابُ فَیَقُولُ الَّذٖینَ ظَلَمُوا رَبَّنَٓا اَخِّرْنَٓا اِلٰٓى اَجَلٍ قَرٖیبٍۙ نُجِبْ دَعْوَتَكَ وَنَتَّبِـعِ الرُّسُلَؕ اَوَلَمْ تَكُونُٓوا اَقْسَمْتُمْ مِنْ قَبْلُ مَا لَكُمْ مِنْ زَوَالٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12565,
            "SureId": 14,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "وَسَكَنْتُمْ فٖی مَسَاكِنِ الَّذٖینَ ظَلَمُٓوا اَنْفُسَهُمْ وَتَبَیَّنَ لَكُمْ كَیْفَ فَعَلْنَا بِهِمْ وَضَرَبْنَا لَكُمُ الْاَمْثَالَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12572,
            "SureId": 14,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "وَقَدْ مَكَرُوا مَكْرَهُمْ وَعِنْدَ اللّٰهِ مَكْرُهُمْؕ وَاِنْ كَانَ مَكْرُهُمْ لِتَزُولَ مِنْهُ الْجِبَالُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12579,
            "SureId": 14,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "فَلَا تَحْسَبَنَّ اللّٰهَ مُخْلِفَ وَعْدِهٖ رُسُلَهُؕ اِنَّ اللّٰهَ عَزٖیزٌ ذُوانْتِقَامٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12586,
            "SureId": 14,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "یَوْمَ تُبَدَّلُ الْاَرْضُ غَیْرَ الْاَرْضِ وَالسَّمٰوَاتُ وَبَرَزُوا لِلّٰهِ الْوَاحِدِ الْقَهَّارِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12593,
            "SureId": 14,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "وَتَرَى الْمُجْرِمٖینَ یَوْمَئِذٍ مُقَرَّنٖینَ فِی الْاَصْفَادِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12600,
            "SureId": 14,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "سَرَابٖیلُهُمْ مِنْ قَطِرَانٍ وَتَغْشٰى وُجُوهَهُمُ النَّارُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12607,
            "SureId": 14,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "لِیَجْزِیَ اللّٰهُ كُلَّ نَفْسٍ مَا كَسَبَتْؕ اِنَّ اللّٰهَ سَرٖیعُ الْحِسَابِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12614,
            "SureId": 14,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "هٰذَا بَلَاغٌ لِلنَّاسِ وَلِیُنْذَرُوا بِهٖ وَلِیَعْلَمُٓوا اَنَّمَا هُوَ اِلٰهٌ وَاحِدٌ وَلِیَذَّكَّرَ اُو𐻾لُوا الْاَلْبَابِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 12549,
            "SureId": 14,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "Başları yukarıya kalkık, bakışları bir noktaya sabitlenmiş, zihinleri bomboş kalmış olarak toplanma yerine koşarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 14,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. İçinde Hz. İbrahim’den ve ailesinden söz edildiği için bu adı almıştır. Sûre de başlıca imanın temel konuları olan Allah’a iman, peygamberlere iman, öldükten sonra dirilme ve hesap ele alınmaktadır.",
                "SureNameTurkish": "İbrâhîm",
                "SureNameArabic": "اِبْرٰه۪يمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 72,
                "AyetCount": 52,
                "Cuz": 13,
                "FirstPage": 255,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 12556,
            "SureId": 14,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "Kendilerine azabın geleceği, bu yüzden zalimlerin, “Rabbimiz! Bize kısa bir süre daha ver de senin davetine uyalım, peygamberlere tâbi olalım” diyecekleri ve onlara, “Sizin için bir yok oluş bulunmadığına daha önce yemin etmemiş miydiniz?” diye sorulacağı güne karşı insanları uyar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12563,
            "SureId": 14,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "Ve sizden önce (bâtılı seçerek) kendilerine kötülük edenlerin yurtlarına yerleşmiştiniz. Onlara ne yaptığımız sizin için açıkça belli oldu, size misaller de getirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12570,
            "SureId": 14,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "Tuzaklarını Allah bilip dururken onlar tuzaklarını kurmaya devam ettiler. Oysa onların tuzaklarıyla dağlar yıkılıp yok olacak değildi!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12577,
            "SureId": 14,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "O halde, sakın Allah’ın, peygamberlerine verdiği sözden cayacağını sanma! Allah güçlüdür, kimsenin yaptığını yanına bırakmaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12584,
            "SureId": 14,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "Bir gün gelecek, yer başka yere, gökler de başka göklere dönüştürülecek, insanlar gücüne karşı durulamaz olan bir tek Allah’ın huzuruna çıkacaklardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12591,
            "SureId": 14,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "O gün, suçluların -sıra halinde- zincirlere vurulmuş olduklarını göreceksin!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12598,
            "SureId": 14,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "Onların giysileri katrandandır; yüzlerini de ateş bürüyecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12605,
            "SureId": 14,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "Allah herkese hak ettiğini vermek için bunu yapacaktır; kuşkusuz Allah’ın hesabı çabuktur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 12612,
            "SureId": 14,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 261,
            "AyetText": "İşte bu, bütün insanlara, bununla hem uyarılsınlar hem Allah’ın ancak bir tek Tanrı olduğunu bilsinler hem de akıl sahipleri öğüt alsınlar diye yapılmış bir bildirimdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "İbrâhîm",
    "QuranSureLabel": "اِبْرٰه۪يمَ",
    "EndPageSure": null
}