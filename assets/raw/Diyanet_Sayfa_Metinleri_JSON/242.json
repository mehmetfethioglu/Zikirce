    "QuranAyats": [
        {
            "Id": 11543,
            "SureId": 12,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "وَمَٓا اُبَرِّئُ نَفْسٖیۚ اِنَّ النَّفْسَ لَاَمَّارَةٌ بِالسُّٓوءِ اِلَّا مَا رَحِمَ رَبّٖیؕ اِنَّ رَبّٖی غَفُورٌ رَحٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 12,
                "MealInfo": "Mekke döneminde inmiştir. 111 âyettir. Bu sûrede Yûsuf Peygamberin hayatta karşılaştığı sıkıntılar ve bunlara sabrederek nasıl başarıya ulaştığı anlatılmakta ve inananlar için faydalı öğütler, önemli mesajlar verilmektedir. Kur’an’da baştan sona kadar bir tek konuyu anlatan tek sûre budur.",
                "SureNameTurkish": "Yûsuf",
                "SureNameArabic": "يُوسُفَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 53,
                "AyetCount": 111,
                "Cuz": 12,
                "FirstPage": 235,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11550,
            "SureId": 12,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "وَقَالَ الْمَلِكُ ائْتُونٖی بِهٖٓ اَسْتَخْلِصْهُ لِنَفْسٖیۚ فَلَمَّا كَلَّمَهُ قَالَ اِنَّكَ الْیَوْمَ لَدَیْنَا مَكٖینٌ اَمٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11557,
            "SureId": 12,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "قَالَ اجْعَلْنٖی عَلٰى خَزَٓائِنِ الْاَرْضِۚ اِنّٖی حَفٖیظٌ عَلٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11564,
            "SureId": 12,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "وَكَذٰلِكَ مَكَّنَّا لِیُوسُفَ فِی الْاَرْضِۚ یَتَبَوَّاُ مِنْهَا حَیْثُ یَشَٓاءُؕ نُصٖیبُ بِرَحْمَتِنَا مَنْ نَشَٓاءُ وَلَا نُضٖیعُ اَجْرَ الْمُحْسِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11571,
            "SureId": 12,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "وَلَاَجْرُ الْاٰخِرَةِ خَیْرٌ لِلَّذٖینَ اٰمَنُوا وَكَانُوا یَتَّقُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11578,
            "SureId": 12,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "وَجَٓاءَ اِخْوَةُ یُوسُفَ فَدَخَلُوا عَلَیْهِ فَعَرَفَهُمْ وَهُمْ لَهُ مُنْكِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11585,
            "SureId": 12,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "وَلَمَّا جَهَّزَهُمْ بِجَهَازِهِمْ قَالَ ائْتُونٖی بِاَخٍ لَكُمْ مِنْ اَبٖیكُمْۚ اَلَا تَرَوْنَ اَنّٖٓی اُو𐻿فِی الْكَیْلَ وَاَنَا𐻾 خَیْرُ الْمُنْزِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11592,
            "SureId": 12,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "فَاِنْ لَمْ تَاْتُونٖی بِهٖ فَلَا كَیْلَ لَكُمْ عِنْدٖی وَلَا تَقْرَبُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11599,
            "SureId": 12,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "قَالُوا سَنُرَاوِدُ عَنْهُ اَبَاهُ وَاِنَّا لَفَاعِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11606,
            "SureId": 12,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "وَقَالَ لِفِتْیَانِهِ اجْعَلُوا بِضَاعَتَهُمْ فٖی رِحَالِهِمْ لَعَلَّهُمْ یَعْرِفُونَهَٓا اِذَا انْقَلَبُٓوا اِلٰٓى اَهْلِهِمْ لَعَلَّهُمْ یَرْجِعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11613,
            "SureId": 12,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "فَلَمَّا رَجَعُٓوا اِلٰٓى اَبٖیهِمْ قَالُوا یَٓا اَبَانَا مُنِـعَ مِنَّا الْكَیْلُ فَاَرْسِلْ مَعَنَٓا اَخَانَا نَكْتَلْ وَاِنَّا لَهُ لَحَافِظُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 11541,
            "SureId": 12,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "Yine de ben nefsimi temize çıkarmıyorum. Çünkü nefis, rabbimin acıyıp koruması dışında, daima kötülüğü emreder; şüphesiz rabbim çok bağışlayan, pek esirgeyendir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 12,
                "MealInfo": "Mekke döneminde inmiştir. 111 âyettir. Bu sûrede Yûsuf Peygamberin hayatta karşılaştığı sıkıntılar ve bunlara sabrederek nasıl başarıya ulaştığı anlatılmakta ve inananlar için faydalı öğütler, önemli mesajlar verilmektedir. Kur’an’da baştan sona kadar bir tek konuyu anlatan tek sûre budur.",
                "SureNameTurkish": "Yûsuf",
                "SureNameArabic": "يُوسُفَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 53,
                "AyetCount": 111,
                "Cuz": 12,
                "FirstPage": 235,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11548,
            "SureId": 12,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "Kral dedi ki: “Onu bana getirin, onu kendime özel danışman edineyim.” Onunla konuşunca, “Bugün sen katımızda yüksek yeri olan, güvenilir birisin” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11555,
            "SureId": 12,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "Yûsuf da, “Beni ülkenin hazinelerine tayin et! Çünkü ben çok iyi korurum ve bu işi bilirim” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11562,
            "SureId": 12,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "Böylece Yûsuf’a orada dilediği gibi hareket etmek üzere ülke içinde yetki verdik. Biz dilediğimiz kimseye rahmetimizi eriştiririz. Güzel davrananların mükâfatını zayi etmeyiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11569,
            "SureId": 12,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "İman edip de sakınanlar için âhiret mükâfatı daha hayırlıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11576,
            "SureId": 12,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "Yûsuf’un kardeşleri (tahıl almak üzere) gelip huzuruna girdiler. Kardeşleri onu tanımadıkları halde Yûsuf onları tanımıştı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11583,
            "SureId": 12,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "Yüklerini hazırlayınca, “Sizin baba-bir kardeşinizi de bana getirin” dedi, “Görüyorsunuz ki ben ölçeği tam dolduruyorum ve ben iyi bir ev sahibiyim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11590,
            "SureId": 12,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "Eğer onu bana getirmezseniz artık bende size verilecek tahıl yoktur; yanıma yaklaşmayın!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11597,
            "SureId": 12,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "Kardeşleri, “Onu babasından isteyeceğiz, kuşkusuz bunu yapacağız” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11604,
            "SureId": 12,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "Yûsuf, emrindeki gençlere dedi ki: “Ödedikleri bedeli yüklerinin içine koyun. Umarım ki ailelerine döndüklerinde bunun farkına varırlar ve umarım yine gelirler.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11611,
            "SureId": 12,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 242,
            "AyetText": "Babalarına döndüklerinde, “Ey babamız! Artık (kardeşimiz olmadan) bize erzak verilmeyecek (çünkü kardeşimizi istiyorlar). Kardeşimizi bizimle beraber gönder de erzak alalım. Biz onu mutlaka koruyacağız” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Yûsuf",
