            }
        },
        {
            "Id": 34979,
            "SureId": 56,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "بِاَكْوَابٍ وَاَبَارٖیقَ وَكَاْسٍ مِنْ مَعٖینٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34986,
            "SureId": 56,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "لَا یُصَدَّعُونَ عَنْهَا وَلَا یُنْزِفُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34993,
            "SureId": 56,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَفَاكِهَةٍ مِمَّا یَتَخَیَّرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35000,
            "SureId": 56,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَلَحْمِ طَیْرٍ مِمَّا یَشْتَهُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35007,
            "SureId": 56,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَحُورٌ عٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35014,
            "SureId": 56,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "كَاَمْثَالِ اللُّؤْلُؤِ𐻾 الْمَكْنُونِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35021,
            "SureId": 56,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "جَزَٓاءً بِمَا كَانُوا یَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35028,
            "SureId": 56,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "لَا یَسْمَعُونَ فٖیهَا لَغْوًا وَلَا تَاْثٖیمًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35035,
            "SureId": 56,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "اِلَّا قٖیلًا سَلَامًا سَلَامًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35042,
            "SureId": 56,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَاَصْحَابُ الْیَمٖینِ مَٓا اَصْحَابُ الْیَمٖینِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35049,
            "SureId": 56,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "فٖی سِدْرٍ مَخْضُودٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35056,
            "SureId": 56,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَطَلْحٍ مَنْضُودٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35063,
            "SureId": 56,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَظِلٍّ مَمْدُودٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35070,
            "SureId": 56,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَمَٓاءٍ مَسْكُوبٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35077,
            "SureId": 56,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَفَاكِهَةٍ كَثٖیرَةٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35084,
            "SureId": 56,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "لَا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35091,
            "SureId": 56,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَفُرُشٍ مَرْفُوعَةٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35098,
            "SureId": 56,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "اِنَّٓا اَنْشَاْنَاهُنَّ اِنْشَٓاءًۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35105,
            "SureId": 56,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "فَجَعَلْنَاهُنَّ اَبْكَارًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35112,
            "SureId": 56,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "عُرُبًا اَتْرَابًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35119,
            "SureId": 56,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "لِاَصْحَابِ الْیَمٖینِؕࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35126,
            "SureId": 56,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "ثُلَّةٌ مِنَ الْاَوَّلٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35133,
            "SureId": 56,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَثُلَّةٌ مِنَ الْاٰخِرٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35140,
            "SureId": 56,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَاَصْحَابُ الشِّمَالِۙ مَٓا اَصْحَابُ الشِّمَالِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35147,
            "SureId": 56,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "فٖی سَمُومٍ وَحَمٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35154,
            "SureId": 56,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَظِلٍّ مِنْ یَحْمُومٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35161,
            "SureId": 56,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "لَا بَارِدٍ وَلَا كَرٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35168,
            "SureId": 56,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "اِنَّهُمْ كَانُوا قَبْلَ ذٰلِكَ مُتْرَفٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35175,
            "SureId": 56,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَكَانُوا یُصِرُّونَ عَلَى الْحِنْثِ الْعَظٖیمِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35182,
            "SureId": 56,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "وَكَانُوا یَقُولُونَ اَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا ءَاِنَّا لَمَبْعُوثُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35189,
            "SureId": 56,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "اَوَاٰبَٓاؤُ𐻾نَا الْاَوَّلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35196,
            "SureId": 56,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "قُلْ اِنَّ الْاَوَّلٖینَ وَالْاٰخِرٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35203,
            "SureId": 56,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "لَمَجْمُوعُونَ اِلٰى مٖیقَاتِ یَوْمٍ مَعْلُومٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
