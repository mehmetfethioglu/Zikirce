            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": false,
            "Page": 535,
            "AyetText": "Çevrelerinde kaynaktan doldurulmuş testiler, ibrikler ve kadehlerle sonsuza dek hizmet sunacak gençler dolaşır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34984,
            "SureId": 56,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Bundan dolayı ne baş ağrısına tutulurlar ne de sarhoş olurlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34991,
            "SureId": 56,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Beğendikleri meyvelerle,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34998,
            "SureId": 56,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Ve canlarının çektiği kuş etleriyle.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35005,
            "SureId": 56,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Güzel gözlü hûriler;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35012,
            "SureId": 56,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Saklı inciler misali.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35019,
            "SureId": 56,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Yaptıklarının karşılığı olarak.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35026,
            "SureId": 56,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Orada ne boş bir söz işitirler ne de günaha sokacak bir şey.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35033,
            "SureId": 56,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Sadece şu söz: “Size esenlikler, size mutluluklar!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35040,
            "SureId": 56,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Amel defteri sağından verilenler; ne mutlu o sağından verilenlere!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35047,
            "SureId": 56,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28-29",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Onlar dalbastı kiraz ve meyve yüklü muz ağaçları arasında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35054,
            "SureId": 56,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": false,
            "Page": 535,
            "AyetText": "Onlar dalbastı kiraz ve meyve yüklü muz ağaçları arasında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
