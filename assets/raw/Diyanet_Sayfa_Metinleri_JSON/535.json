            "SureId": 56,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Kesintisiz gölgeler altında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35068,
            "SureId": 56,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Çağlayanların kenarında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35075,
            "SureId": 56,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32-33",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Bitip tükenmeyen ve yasaklanmayan bol meyveler arasında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35082,
            "SureId": 56,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": false,
            "Page": 535,
            "AyetText": "Bitip tükenmeyen ve yasaklanmayan bol meyveler arasında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35089,
            "SureId": 56,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Kabartılmış döşekler üzerinde (olacaklar).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35096,
            "SureId": 56,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Şüphesiz biz onları (eşlerini) yepyeni bir yaratılışla yaratmışızdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35103,
            "SureId": 56,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36-37",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Onları bâkire, eşlerine sevgiyle bağlı ve yaşıt kılmışızdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35110,
            "SureId": 56,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": false,
            "Page": 535,
            "AyetText": "Onları bâkire, eşlerine sevgiyle bağlı ve yaşıt kılmışızdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35117,
            "SureId": 56,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Bütün bunlar, hakkın ve erdemin yanında olanlar içindir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35124,
            "SureId": 56,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Onların bir kısmı öncekilerdendir;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35131,
            "SureId": 56,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Bir kısmı da sonrakilerdendir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35138,
            "SureId": 56,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Amel defteri solundan verilenler; ne bedbaht o solundan verilenler!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35145,
            "SureId": 56,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "İçlerine işleyen bir ateş ve kaynar su içindedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35152,
            "SureId": 56,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43-44",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Serin ve rahatlatıcı olmayan, kapkara bir duman gölgesindedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35159,
            "SureId": 56,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": false,
            "Page": 535,
            "AyetText": "Serin ve rahatlatıcı olmayan, kapkara bir duman gölgesindedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35166,
            "SureId": 56,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Çünkü daha önce onlar hazlarına tutsak olmuşlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35173,
            "SureId": 56,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "O büyük günah üzerinde ısrar ediyorlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35180,
            "SureId": 56,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Şöyle diyorlardı: “Sahi biz, ölüp de toprak ve kemik yığını haline gelmişken yeniden mi diriltilecekmişiz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35187,
            "SureId": 56,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Üstelik gelip geçmiş atalarımız da mı?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35194,
            "SureId": 56,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "De ki: “Hem öncekiler hem sonrakiler;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 35201,
            "SureId": 56,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 535,
            "AyetText": "Bilinen bir günün belirlenmiş bir vaktinde mutlaka bir araya getirilecekler!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
