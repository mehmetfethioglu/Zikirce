            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42385,
            "SureId": 91,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "اِذِ انْبَعَثَ اَشْقٰیهَاࣕۙ",
