            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42266,
            "SureId": 90,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "یَتٖیمًا ذَا مَقْرَبَةٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42273,
            "SureId": 90,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "اَوْ مِسْكٖینًا ذَا مَتْرَبَةٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42280,
            "SureId": 90,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "ثُمَّ كَانَ مِنَ الَّذٖینَ اٰمَنُوا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42287,
            "SureId": 90,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "اُو𐻾لٰٓئِكَ اَصْحَابُ الْمَیْمَنَةِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42294,
            "SureId": 90,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "وَالَّذٖینَ كَفَرُوا بِاٰیَاتِنَا هُمْ اَصْحَابُ الْمَشْـَٔمَةِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42301,
            "SureId": 90,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "عَلَیْهِمْ نَارٌ مُؤْصَدَةٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42308,
            "SureId": 91,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "وَالشَّمْسِ وَضُحٰیهَاࣕۙ",
