            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42245,
            "SureId": 90,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "وَمَٓا اَدْرٰیكَ مَا الْعَقَبَةُؕ",
