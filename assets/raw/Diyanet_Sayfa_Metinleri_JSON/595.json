                "SureNameTurkish": "Şems",
                "SureNameArabic": "الشَّمْسِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 26,
                "AyetCount": 15,
                "Cuz": 30,
                "FirstPage": 595,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42315,
            "SureId": 91,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "وَالْقَمَرِ اِذَا تَلٰیهَاࣕۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42322,
            "SureId": 91,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "وَالنَّهَارِ اِذَا جَلّٰیهَاࣕۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42329,
            "SureId": 91,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "وَالَّیْلِ اِذَا یَغْشٰیهَاࣕۙ",
