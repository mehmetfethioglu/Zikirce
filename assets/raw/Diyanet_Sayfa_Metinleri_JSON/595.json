            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42336,
            "SureId": 91,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "وَالسَّمَٓاءِ وَمَا بَنٰیهَاࣕۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42343,
            "SureId": 91,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "وَالْاَرْضِ وَمَا طَحٰیهَاࣕۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42350,
            "SureId": 91,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "وَنَفْسٍ وَمَا سَوّٰیهَاࣕۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42357,
            "SureId": 91,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "فَاَلْهَمَهَا فُجُورَهَا وَتَقْوٰیهَاࣕۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42364,
            "SureId": 91,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "قَدْ اَفْلَحَ مَنْ زَكّٰیهَاࣕۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42371,
            "SureId": 91,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "وَقَدْ خَابَ مَنْ دَسّٰیهَاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42378,
            "SureId": 91,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 595,
