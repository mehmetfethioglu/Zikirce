            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42392,
            "SureId": 91,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "فَقَالَ لَهُمْ رَسُولُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقْیٰیهَاࣞ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42399,
            "SureId": 91,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "فَكَذَّبُوهُ فَعَقَرُوهَاࣕۙ فَدَمْدَمَ عَلَیْهِمْ رَبُّهُمْ بِذَنْبِهِمْ فَسَوّٰیهَاࣕۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42406,
            "SureId": 91,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "وَلَا یَخَافُ عُقْبٰیهَا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
