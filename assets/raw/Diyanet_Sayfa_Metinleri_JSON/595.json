        },
        {
            "Id": 42355,
            "SureId": 91,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "Ona kötü ve iyi olma yeteneklerini yerleştirene ki,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42362,
            "SureId": 91,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "Nefsini arındıran elbette kurtuluşa ermiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42369,
            "SureId": 91,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "Onu kötülüklere boğan da ziyan etmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42376,
            "SureId": 91,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "Semûd kavmi, hak tanımazlığı yüzünden (peygamberini) yalanladı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42383,
            "SureId": 91,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "En azılısı cüretle ileri atıldığında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42390,
            "SureId": 91,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "Allah’ın elçisi onlara, “Allah’ın (mûcize olarak) verdiği deveye ve onun su hakkına dokunmayın” demişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42397,
            "SureId": 91,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "Fakat onlar ona inanmayıp deveyi kestiler. Bunun üzerine rableri, günahları sebebiyle onlara ardı arkası kesilmez felâketler göndererek hepsini helâk etti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42404,
            "SureId": 91,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "O, yaptığının sonucundan korkacak değildir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
