            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42252,
            "SureId": 90,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "فَكُّ رَقَبَةٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42259,
            "SureId": 90,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 595,
            "AyetText": "اَوْ اِطْعَامٌ فٖی یَوْمٍ ذٖی مَسْغَبَةٍۙ",
