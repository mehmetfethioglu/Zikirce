    "QuranAyats": [
        {
            "Id": 315,
            "SureId": 2,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "قُلْنَا اهْبِطُوا مِنْهَا جَمٖیعًاۚ فَاِمَّا یَاْتِیَنَّكُمْ مِنّٖی هُدًى فَمَنْ تَبِعَ هُدَایَ فَلَا خَوْفٌ عَلَیْهِمْ وَلَا هُمْ یَحْزَنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 2,
                "MealInfo": "Medine döneminde inmiştir. Kur’an-ı Kerim’in en uzun sûresi olup 286 âyettir. Adını, 67-73. âyetlerde yer alan <b>“bakara (<i>sığı</i>r)”</b> kelimesinden alır. Sûre, İslâm hukukunun ana konularıyla ilgili pek çok hüküm içermektedir.",
                "SureNameTurkish": "Bakara",
                "SureNameArabic": "الْبَقَرَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 87,
                "AyetCount": 286,
                "Cuz": 1,
                "FirstPage": 2,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 322,
            "SureId": 2,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "وَالَّذٖینَ كَفَرُوا وَكَذَّبُوا بِاٰیَاتِنَٓا اُو𐻾لٰٓئِكَ اَصْحَابُ النَّارِۚ هُمْ فٖیهَا خَالِدُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 329,
            "SureId": 2,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "یَا بَنٖٓی اِسْرَٓایٖٔلَ اذْكُرُوا نِعْمَتِیَ الَّتٖٓی اَنْعَمْتُ عَلَیْكُمْ وَاَوْفُوا بِعَهْدٖٓی اُو𐻿فِ بِعَهْدِكُمْ وَاِیَّایَ فَارْهَبُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 336,
            "SureId": 2,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "وَاٰمِنُوا بِمَٓا اَنْزَلْتُ مُصَدِّقًا لِمَا مَعَكُمْ وَلَا تَكُونُٓوا اَوَّلَ كَافِرٍ بِهٖࣕ وَلَا تَشْتَرُوا بِاٰیَاتٖی ثَمَنًا قَلٖیلًاؗ وَاِیَّایَ فَاتَّقُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 343,
            "SureId": 2,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "وَلَا تَلْبِسُوا الْحَقَّ بِالْبَاطِلِ وَتَكْتُمُوا الْحَقَّ وَاَنْتُمْ تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 350,
            "SureId": 2,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "وَاَقٖیمُوا الصَّلٰوةَ وَاٰتُوا الزَّكٰوةَ وَارْكَعُوا مَعَ الرَّاكِعٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 357,
            "SureId": 2,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "اَتَاْمُرُونَ النَّاسَ بِالْبِرِّ وَتَنْسَوْنَ اَنْفُسَكُمْ وَاَنْتُمْ تَتْلُونَ الْكِتَابَؕ اَفَلَا تَعْقِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 364,
            "SureId": 2,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "وَاسْتَعٖینُوا بِالصَّبْرِ وَالصَّلٰوةِؕ وَاِنَّهَا لَكَبٖیرَةٌ اِلَّا عَلَى الْخَاشِعٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 371,
            "SureId": 2,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "اَلَّذٖینَ یَظُنُّونَ اَنَّهُمْ مُلَاقُوا رَبِّهِمْ وَاَنَّهُمْ اِلَیْهِ رَاجِعُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 378,
            "SureId": 2,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "یَا بَنٖٓی اِسْرَٓایٖٔلَ اذْكُرُوا نِعْمَتِیَ الَّتٖٓی اَنْعَمْتُ عَلَیْكُمْ وَاَنّٖی فَضَّلْتُكُمْ عَلَى الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 385,
            "SureId": 2,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "وَاتَّقُوا یَوْمًا لَا تَجْزٖی نَفْسٌ عَنْ نَفْسٍ شَیْـًٔا وَلَا یُقْبَلُ مِنْهَا شَفَاعَةٌ وَلَا یُؤْخَذُ مِنْهَا عَدْلٌ وَلَا هُمْ یُنْصَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 313,
            "SureId": 2,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "Onlara şöyle dedik: “Oradan hepiniz inin! Benden size muhakkak bir rehber gelecektir.” Kim benim gönderdiğim rehbere uyarsa artık onlara ne korku vardır ne de üzüleceklerdir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 2,
                "MealInfo": "Medine döneminde inmiştir. Kur’an-ı Kerim’in en uzun sûresi olup 286 âyettir. Adını, 67-73. âyetlerde yer alan <b>“bakara (<i>sığı</i>r)”</b> kelimesinden alır. Sûre, İslâm hukukunun ana konularıyla ilgili pek çok hüküm içermektedir.",
                "SureNameTurkish": "Bakara",
                "SureNameArabic": "الْبَقَرَةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 87,
                "AyetCount": 286,
                "Cuz": 1,
                "FirstPage": 2,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 320,
            "SureId": 2,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "İnkâr eden ve âyetlerimizi yalan sayanlara gelince onlar cehennemliklerdir ve orada devamlı kalıcıdırlar.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 327,
            "SureId": 2,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "Ey İsrâiloğulları! Size verdiğim nimetimi hatırlayın, bana verdiğiniz sözü yerine getirin ki ben de size vaad ettiklerimi vereyim. Asıl bana itaatsizlikten sakının.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 334,
            "SureId": 2,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "Elinizdekini (Tevrat) tasdik edici olarak indirdiğime (Kur’an) iman edin; sakın onu inkâr edenlerin ilki olmayın! Âyetlerimi az bir karşılığa satmayın. Yalnız benden korkun.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 341,
            "SureId": 2,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "Bilerek hakkı bâtıl ile karıştırmayın, hakkı gizlemeyin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 348,
            "SureId": 2,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "Namazı kılın, zekâtı verin, rükû edenlerle beraber rükû edin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 355,
            "SureId": 2,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "Sizler kitabı okuduğunuz halde insanlara iyiliği emredip kendinizi unutuyor musunuz? Aklınızı kullanmıyor musunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 362,
            "SureId": 2,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "Sabır ve namazla Allah’tan yardım isteyin. Şüphesiz bunlar, Allah’a huşû ile boyun eğenlerden başkasına ağır gelir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 369,
            "SureId": 2,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "Onlar kesinlikle rablerine kavuşacaklarını ve O’na döneceklerini bilen kimselerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 376,
            "SureId": 2,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "Ey İsrâiloğulları! Size verdiğim nimetimi ve sizi diğer topluluklara üstün kıldığımı hatırlayın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 383,
            "SureId": 2,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 7,
            "AyetText": "Öyle bir günden korkun ki, o gün kimse başkası için bir şey ödeyemez; hiç kimseden şefaat kabul olunmaz, hiçbir kimsenin yerine başkası kabul edilmez; onlara asla yardım da yapılmaz.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
