    "QuranAyats": [
        {
            "Id": 18718,
            "SureId": 23,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "قَدْ اَفْلَحَ الْمُؤْمِنُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18725,
            "SureId": 23,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "اَلَّذٖینَ هُمْ فٖی صَلَاتِهِمْ خَاشِعُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18732,
            "SureId": 23,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "وَالَّذٖینَ هُمْ عَنِ اللَّغْوِ مُعْرِضُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18739,
            "SureId": 23,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "وَالَّذٖینَ هُمْ لِلزَّكٰوةِ فَاعِلُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18746,
            "SureId": 23,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "وَالَّذٖینَ هُمْ لِفُرُوجِهِمْ حَافِظُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18753,
            "SureId": 23,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "اِلَّا عَلٰٓى اَزْوَاجِهِمْ اَوْ مَا مَلَكَتْ اَیْمَانُهُمْ فَاِنَّهُمْ غَیْرُ مَلُومٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18760,
            "SureId": 23,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "فَمَنِ ابْتَغٰى وَرَٓاءَ ذٰلِكَ فَاُو𐻾لٰٓئِكَ هُمُ الْعَادُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18767,
            "SureId": 23,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "وَالَّذٖینَ هُمْ لِاَمَانَاتِهِمْ وَعَهْدِهِمْ رَاعُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18774,
            "SureId": 23,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "وَالَّذٖینَ هُمْ عَلٰى صَلَوَاتِهِمْ یُحَافِظُونَۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18781,
            "SureId": 23,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "اُو𐻾لٰٓئِكَ هُمُ الْوَارِثُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18788,
            "SureId": 23,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "اَلَّذٖینَ یَرِثُونَ الْفِرْدَوْسَؕ هُمْ فٖیهَا خَالِدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18795,
            "SureId": 23,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "وَلَقَدْ خَلَقْنَا الْاِنْسَانَ مِنْ سُلَالَةٍ مِنْ طٖینٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18802,
            "SureId": 23,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "ثُمَّ جَعَلْنَاهُ نُطْفَةً فٖی قَرَارٍ مَكٖینٍࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18809,
            "SureId": 23,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "ثُمَّ خَلَقْنَا النُّطْفَةَ عَلَقَةً فَخَلَقْنَا الْعَلَقَةَ مُضْغَةً فَخَلَقْنَا الْمُضْغَةَ عِظَامًا فَكَسَوْنَا الْعِظَامَ لَحْمًاࣗ ثُمَّ اَنْشَاْنَاهُ خَلْقًا اٰخَرَؕ فَتَبَارَكَ اللّٰهُ اَحْسَنُ الْخَالِقٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18816,
            "SureId": 23,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "ثُمَّ اِنَّكُمْ بَعْدَ ذٰلِكَ لَمَیِّتُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18823,
            "SureId": 23,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "ثُمَّ اِنَّكُمْ یَوْمَ الْقِیٰمَةِ تُبْعَثُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18830,
            "SureId": 23,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "وَلَقَدْ خَلَقْنَا فَوْقَكُمْ سَبْعَ طَرَٓائِقَࣗ وَمَا كُنَّا عَنِ الْخَلْقِ غَافِلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 18716,
            "SureId": 23,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Müminler kesinlikle kurtuluşa ermiştir;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 23,
                "MealInfo": "Mekke döneminde inmiştir. 118 âyettir. Sûre, adını birinci âyette geçen <b>“elMü’minûn” </b>kelimesinden almıştır. <b>“el-Mü’minûn”, mü’minler demektir</b>. Müşriklere son uyarı niteliğindeki bu sûrede, mü’minlerin zafere ulaşacakları, kötülerin cezaya çarptırılacağı konu edilmektedir.",
                "SureNameTurkish": "Mü'minûn",
                "SureNameArabic": "الْمُؤْمِنُونَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 74,
                "AyetCount": 118,
                "Cuz": 18,
                "FirstPage": 342,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 18723,
            "SureId": 23,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Ki onlar, namazlarında derin bir saygı hali yaşarlar;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18730,
            "SureId": 23,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Anlamsız, yararsız söz ve davranışlardan uzak dururlar;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18737,
            "SureId": 23,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Zekâtı verirler;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18744,
            "SureId": 23,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "İffetlerini korurlar;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18751,
            "SureId": 23,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Sadece eşleriyle veya ellerinin altında olanlarla (câriyelerle) yetinirler, bundan dolayı da kınanacak değillerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18758,
            "SureId": 23,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Ama her kim bunun ötesine geçmek isterse işte haddi aşanlar onlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18765,
            "SureId": 23,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Yine o müminler emanetlerine ve ahidlerine sadakat gösterirler;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18772,
            "SureId": 23,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Namazlarını titizlikle eda ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18779,
            "SureId": 23,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "İşte vâris olacaklar bunlardır;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18786,
            "SureId": 23,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Firdevs cennetine vâris olacaklar ve orada onlar ebedî kalacaklardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18793,
            "SureId": 23,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Gerçek şu ki biz insanı çamurdan alınmış bir özden yaratıyoruz;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18800,
            "SureId": 23,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Sonra onu sağlam bir korunakta nutfe haline getiriyoruz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18807,
            "SureId": 23,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Ardından nutfeyi (döllenmiş yumurta) alakaya (rahimde asılıp beslenen embriyo) çeviriyor, alakayı şekilsiz et (görünümünde) yapıyor, bu etten kemikler yaratıyor, daha sonra da kemiklere adale giydiriyoruz; nihayet onu bambaşka bir varlık halinde inşa ediyoruz. Yapıp yaratanların en güzeli olan Allah çok yücedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18814,
            "SureId": 23,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Sonra siz bunun ardından mutlaka öleceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18821,
            "SureId": 23,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Sonra da kıyamet gününde tekrar diriltileceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18828,
            "SureId": 23,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 342,
            "AyetText": "Andolsun biz üstünüzde yedi yol yarattık. Biz yaratılanlardan habersiz değiliz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Mü'minûn",
    "QuranSureLabel": "الْمُؤْمِنُونَ",
