            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 61,
            "AyetText": "كَیْفَ یَهْدِی اللّٰهُ قَوْمًا كَفَرُوا بَعْدَ اٖیمَانِهِمْ وَشَهِدُٓوا اَنَّ الرَّسُولَ حَقٌّ وَجَٓاءَهُمُ الْبَیِّنَاتُؕ وَاللّٰهُ لَا یَهْدِی الْقَوْمَ الظَّالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
