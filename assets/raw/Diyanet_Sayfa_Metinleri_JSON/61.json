            "LanguageId": 7,
            "AyetNumber": "٩٠",
            "AyetVisible": true,
            "Page": 61,
            "AyetText": "اِنَّ الَّذٖینَ كَفَرُوا بَعْدَ اٖیمَانِهِمْ ثُمَّ ازْدَادُوا كُفْرًا لَنْ تُقْبَلَ تَوْبَتُهُمْۚ وَاُو𐻾لٰٓئِكَ هُمُ الضَّٓالُّونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2688,
            "SureId": 3,
            "AyetId": 91,
            "LanguageId": 7,
            "AyetNumber": "٩١",
            "AyetVisible": true,
            "Page": 61,
            "AyetText": "اِنَّ الَّذٖینَ كَفَرُوا وَمَاتُوا وَهُمْ كُفَّارٌ فَلَنْ یُقْبَلَ مِنْ اَحَدِهِمْ مِلْءُ الْاَرْضِ ذَهَبًا وَلَوِ افْتَدٰى بِهٖؕ اُو𐻾لٰٓئِكَ لَهُمْ عَذَابٌ اَلٖیمٌ وَمَا لَهُمْ مِنْ نَاصِرٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 2637,
