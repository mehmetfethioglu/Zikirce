            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 61,
            "AyetText": "اُو𐻾لٰٓئِكَ جَزَٓاؤُ𐻾هُمْ اَنَّ عَلَیْهِمْ لَعْنَةَ اللّٰهِ وَالْمَلٰٓئِكَةِ وَالنَّاسِ اَجْمَعٖینَۙ",
