            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 61,
            "AyetText": "خَالِدٖینَ فٖیهَاۚ لَا یُخَفَّفُ عَنْهُمُ الْعَذَابُ وَلَا هُمْ یُنْظَرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
