            "SureId": 3,
            "AyetId": 89,
            "LanguageId": 7,
            "AyetNumber": "٨٩",
            "AyetVisible": true,
            "Page": 61,
            "AyetText": "اِلَّا الَّذٖینَ تَابُوا مِنْ بَعْدِ ذٰلِكَ وَاَصْلَحُوا فَاِنَّ اللّٰهَ غَفُورٌ رَحٖیمٌ",
            "Recitation": "",
            "AyetMeta": null,
