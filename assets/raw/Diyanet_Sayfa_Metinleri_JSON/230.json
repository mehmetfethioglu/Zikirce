    "QuranAyats": [
        {
            "Id": 10815,
            "SureId": 11,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "قَالَتْ یَا وَیْلَتٰٓى ءَاَلِدُ وَاَنَا𐻾 عَجُوزٌ وَهٰذَا بَعْلٖی شَیْخًاؕ اِنَّ هٰذَا لَشَیْءٌ عَجٖیبٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 11,
                "MealInfo": "Mekke döneminde inmiştir. 123 âyettir. Sûre, adını içinde söz konusu edilen Hûd peygamberden almıştır. Sûre de başlıca tevhit, peygamberlik, öldükten sonra dirilme ve ceza konuları ele alınmakta ve bunlar bazı peygamberlerin kıssalarıyla desteklenmektedir.",
                "SureNameTurkish": "Hûd",
                "SureNameArabic": "هُودٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 52,
                "AyetCount": 123,
                "Cuz": 11,
                "FirstPage": 221,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 10822,
            "SureId": 11,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "قَالُٓوا اَتَعْجَبٖینَ مِنْ اَمْرِ اللّٰهِ رَحْمَتُ اللّٰهِ وَبَرَكَاتُهُ عَلَیْكُمْ اَهْلَ الْبَیْتِؕ اِنَّهُ حَمٖیدٌ مَجٖیدٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10829,
            "SureId": 11,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "فَلَمَّا ذَهَبَ عَنْ اِبْرٰهٖیمَ الرَّوْعُ وَجَٓاءَتْهُ الْبُشْرٰى یُجَادِلُنَا فٖی قَوْمِ لُوطٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10836,
            "SureId": 11,
            "AyetId": 75,
            "LanguageId": 7,
            "AyetNumber": "٧٥",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "اِنَّ اِبْرٰهٖیمَ لَحَلٖیمٌ اَوَّاهٌ مُنٖیبٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10843,
            "SureId": 11,
            "AyetId": 76,
            "LanguageId": 7,
            "AyetNumber": "٧٦",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "یَٓا اِبْرٰهٖیمُ اَعْرِضْ عَنْ هٰذَاۚ اِنَّهُ قَدْ جَٓاءَ اَمْرُ رَبِّكَۚ وَاِنَّهُمْ اٰتٖیهِمْ عَذَابٌ غَیْرُ مَرْدُودٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10850,
            "SureId": 11,
            "AyetId": 77,
            "LanguageId": 7,
            "AyetNumber": "٧٧",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "وَلَمَّا جَٓاءَتْ رُسُلُنَا لُوطًا سٖٓیءَ بِهِمْ وَضَاقَ بِهِمْ ذَرْعًا وَقَالَ هٰذَا یَوْمٌ عَصٖیبٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10857,
            "SureId": 11,
            "AyetId": 78,
            "LanguageId": 7,
            "AyetNumber": "٧٨",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "وَجَٓاءَهُ قَوْمُهُ یُهْرَعُونَ اِلَیْهِ وَمِنْ قَبْلُ كَانُوا یَعْمَلُونَ السَّیِّــَٔاتِؕ قَالَ یَا قَوْمِ هٰٓؤُ𐻾لَٓاءِ بَنَاتٖی هُنَّ اَطْهَرُ لَكُمْ فَاتَّقُوا اللّٰهَ وَلَا تُخْزُونِ فٖی ضَیْفٖیؕ اَلَیْسَ مِنْكُمْ رَجُلٌ رَشٖیدٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10864,
            "SureId": 11,
            "AyetId": 79,
            "LanguageId": 7,
            "AyetNumber": "٧٩",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "قَالُوا لَقَدْ عَلِمْتَ مَا لَنَا فٖی بَنَاتِكَ مِنْ حَقٍّۚ وَاِنَّكَ لَتَعْلَمُ مَا نُرٖیدُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10871,
            "SureId": 11,
            "AyetId": 80,
            "LanguageId": 7,
            "AyetNumber": "٨٠",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "قَالَ لَوْ اَنَّ لٖی بِكُمْ قُوَّةً اَوْ اٰوٖٓی اِلٰى رُكْنٍ شَدٖیدٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10878,
            "SureId": 11,
            "AyetId": 81,
            "LanguageId": 7,
            "AyetNumber": "٨١",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "قَالُوا یَا لُوطُ اِنَّا رُسُلُ رَبِّكَ لَنْ یَصِلُٓوا اِلَیْكَ فَاَسْرِ بِاَهْلِكَ بِقِطْعٍ مِنَ الَّیْلِ وَلَا یَلْتَفِتْ مِنْكُمْ اَحَدٌ اِلَّا امْرَاَتَكَؕ اِنَّهُ مُصٖیبُهَا مَٓا اَصَابَهُمْؕ اِنَّ مَوْعِدَهُمُ الصُّبْحُؕ اَلَیْسَ الصُّبْحُ بِقَرٖیبٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 10813,
            "SureId": 11,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "“Aman yâ rabbi! Ben mi doğuracağım: Ben yaşlı bir kadın, şu da ihtiyar kocam! Doğrusu şaşılacak bir şey!” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 11,
                "MealInfo": "Mekke döneminde inmiştir. 123 âyettir. Sûre, adını içinde söz konusu edilen Hûd peygamberden almıştır. Sûre de başlıca tevhit, peygamberlik, öldükten sonra dirilme ve ceza konuları ele alınmakta ve bunlar bazı peygamberlerin kıssalarıyla desteklenmektedir.",
                "SureNameTurkish": "Hûd",
                "SureNameArabic": "هُودٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 52,
                "AyetCount": 123,
                "Cuz": 11,
                "FirstPage": 221,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 10820,
            "SureId": 11,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "Elçiler de “Allah’ın işine mi şaşıyorsun? Allah’ın rahmet ve bereketi üzerinizdedir, ey hâne halkı! Şüphesiz ki O, övülmeye lâyıktır, şanı yücedir” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10827,
            "SureId": 11,
            "AyetId": 74,
            "LanguageId": 5,
            "AyetNumber": "74",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "İbrâhim’in korkusu geçip kendisine müjde de gelince Lût kavmi hakkında bizimle tartışmaya başladı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10834,
            "SureId": 11,
            "AyetId": 75,
            "LanguageId": 5,
            "AyetNumber": "75",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "İbrâhim cidden ağır başlı, hassas ruhlu, kendini Allah’a vermiş biriydi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10841,
            "SureId": 11,
            "AyetId": 76,
            "LanguageId": 5,
            "AyetNumber": "76",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "“İbrâhim, bundan vazgeç; çünkü rabbinin emri gelmiştir. Onlara, geri çevrilmez bir azap mutlaka gelecektir” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10848,
            "SureId": 11,
            "AyetId": 77,
            "LanguageId": 5,
            "AyetNumber": "77",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "Elçilerimiz Lût’a geldiğinde, Lût onlardan dolayı huzursuz oldu, onlara karşı çaresizlik hissetti. “Zor bir gün!” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10855,
            "SureId": 11,
            "AyetId": 78,
            "LanguageId": 5,
            "AyetNumber": "78",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "Lût’un kavmi koşarak ona geldi. Daha önce de o çirkin işleri yapıyorlardı. Lût, “Ey kavmim! Şunlar kızlarım; sizin için en nezih olanı onlarla evlenmektir. Allah’tan korkun ve misafirlerimin önünde beni rezil etmeyin! İçinizde aklı başında bir adam yok mu!” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10862,
            "SureId": 11,
            "AyetId": 79,
            "LanguageId": 5,
            "AyetNumber": "79",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "“Sen de biliyorsun ki bizim senin kızlarında gözümüz yok. Bizim ne istediğimizi pekâlâ biliyorsun” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10869,
            "SureId": 11,
            "AyetId": 80,
            "LanguageId": 5,
            "AyetNumber": "80",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "Lût, “Keşke benim size karşı koyacak bir gücüm olsaydı veya güçlü bir desteğe dayanabilseydim!” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 10876,
            "SureId": 11,
            "AyetId": 81,
            "LanguageId": 5,
            "AyetNumber": "81",
            "AyetVisible": true,
            "Page": 230,
            "AyetText": "Elçiler “Ey Lût! Biz rabbinin elçileriyiz. Onlar sana asla dokunamayacaklar. Sen gecenin bir vaktinde ailenle birlikte yola çık. Eşin hariç, sizden hiç kimse geride kalmasın. Çünkü onların başına gelecek olan, şüphesiz onun başına da gelecektir. Onlar için belirlenen zaman, sabah vaktidir. Sabah da yakın, değil mi?” dediler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Hûd",
    "QuranSureLabel": "هُودٍ",
