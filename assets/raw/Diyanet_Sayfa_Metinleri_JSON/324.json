{
    "PointerList": null,
    "CuzNo": 17,
    "PageNo": 324,
    "ArCuzNo": "۱۷",
    "ArPageNo": "۳۲٤",
    "QuranAyats": [
        {
            "Id": 17556,
            "SureId": 21,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "وَمَٓا اَرْسَلْنَا مِنْ قَبْلِكَ مِنْ رَسُولٍ اِلَّا نُوحٖٓی اِلَیْهِ اَنَّهُ لَٓا اِلٰهَ اِلَّٓا اَنَا𐻾 فَاعْبُدُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17563,
            "SureId": 21,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "وَقَالُوا اتَّخَذَ الرَّحْمٰنُ وَلَدًا سُبْحَانَهُؕ بَلْ عِبَادٌ مُكْرَمُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17570,
            "SureId": 21,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "لَا یَسْبِقُونَهُ بِالْقَوْلِ وَهُمْ بِاَمْرِهٖ یَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17577,
            "SureId": 21,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "یَعْلَمُ مَا بَیْنَ اَیْدٖیهِمْ وَمَا خَلْفَهُمْ وَلَا یَشْفَعُونَۙ اِلَّا لِمَنِ ارْتَضٰى وَهُمْ مِنْ خَشْیَتِهٖ مُشْفِقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17584,
            "SureId": 21,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "وَمَنْ یَقُلْ مِنْهُمْ اِنّٖٓی اِلٰهٌ مِنْ دُونِهٖ فَذٰلِكَ نَجْزٖیهِ جَهَنَّمَؕ كَذٰلِكَ نَجْزِی الظَّالِمٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17591,
            "SureId": 21,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "اَوَلَمْ یَرَ الَّذٖینَ كَفَرُٓوا اَنَّ السَّمٰوَاتِ وَالْاَرْضَ كَانَتَا رَتْقًا فَفَتَقْنَاهُمَاؕ وَجَعَلْنَا مِنَ الْمَٓاءِ كُلَّ شَیْءٍ حَیٍّؕ اَفَلَا یُؤْمِنُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17598,
            "SureId": 21,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "وَجَعَلْنَا فِی الْاَرْضِ رَوَاسِیَ اَنْ تَمٖیدَ بِهِمْ وَجَعَلْنَا فٖیهَا فِجَاجًا سُبُلًا لَعَلَّهُمْ یَهْتَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17605,
            "SureId": 21,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "وَجَعَلْنَا السَّمَٓاءَ سَقْفًا مَحْفُوظًاۚ وَهُمْ عَنْ اٰیَاتِهَا مُعْرِضُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17612,
            "SureId": 21,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "وَهُوَ الَّذٖی خَلَقَ الَّیْلَ وَالنَّهَارَ وَالشَّمْسَ وَالْقَمَرَؕ كُلٌّ فٖی فَلَكٍ یَسْبَحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17619,
            "SureId": 21,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "وَمَا جَعَلْنَا لِبَشَرٍ مِنْ قَبْلِكَ الْخُلْدَؕ اَفَا𐻾ئِنْ مِتَّ فَهُمُ الْخَالِدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17626,
            "SureId": 21,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "كُلُّ نَفْسٍ ذَٓائِقَةُ الْمَوْتِؕ وَنَبْلُوكُمْ بِالشَّرِّ وَالْخَیْرِ فِتْنَةًؕ وَاِلَیْنَا تُرْجَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 17554,
            "SureId": 21,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "Senden önce hiçbir peygamber göndermedik ki ona, “Benden başka ilâh yoktur, şu halde bana kulluk edin” diye vahyetmiş olmayalım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17561,
            "SureId": 21,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "Böyle iken (bazıları) “Rahmân evlât edindi” dediler. Hâşâ! O bundan münezzehtir. Bilâkis o evlât dedikleri lutuf ve ihsana mazhar olmuş kullardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17568,
            "SureId": 21,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "O’nun sözünün önüne geçmezler, sadece O’nun emriyle hareket ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17575,
            "SureId": 21,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "Allah onların önlerindekini de arkalarındakini de (bildiklerini de bilmediklerini de) bilir. Onlar Allah’ın razı olduklarından başkasına şefaat edemezler ve Allah korkusundan titrerler!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17582,
            "SureId": 21,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "Onlardan biri, “Tanrı O değil, benim!” diyecek olsa (ki demez), biz onu da cehennemle cezalandırırız. Zalimleri böyle cezalandırırız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17589,
            "SureId": 21,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "İnkâr edenler, gökler ve yer bitişik iken onları ayırdığımızı ve her canlıyı sudan yarattığımızı görmezler mi? Hâlâ inanmayacaklar mı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17596,
            "SureId": 21,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "Yeryüzüne onları sarsmasın diye sağlam dağlar yerleştirdik; kolayca yollarını bulabilsinler diye orada vadiler, yollar açtık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17603,
            "SureId": 21,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "Gökyüzünü korunmuş bir tavan yaptık. Onlar ise, gökyüzünün işaretlerine sırt çevirmektedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17610,
            "SureId": 21,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "O, geceyi, gündüzü, güneşi, ayı yaratandır. Her biri bir yörüngede yüzmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17617,
            "SureId": 21,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "Senden önce de hiçbir insana ölümsüzlük vermedik. Şimdi sen ölürsen, onlar ebedî mi kalacaklar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17624,
            "SureId": 21,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 324,
            "AyetText": "Her can ölümü tadacaktır. Denemek için sizi kötü ve iyi durumlarla imtihan ederiz. Sonunda bize geleceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Enbiyâ",
    "QuranSureLabel": "الْاَنْبِيَاءِ",
    "EndPageSure": null
}