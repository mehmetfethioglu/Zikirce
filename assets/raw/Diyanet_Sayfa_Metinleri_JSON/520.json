    "QuranAyats": [
        {
            "Id": 32662,
            "SureId": 50,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "وَكَمْ اَهْلَكْنَا قَبْلَهُمْ مِنْ قَرْنٍ هُمْ اَشَدُّ مِنْهُمْ بَطْشًا فَنَقَّبُوا فِی الْبِلَادِؕ هَلْ مِنْ مَحٖیصٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 50,
                "MealInfo": "Mekke döneminde inmiştir. 45 âyettir. Sûre, adını başındaki <b>“Kâf ”</b> harfindenalmıştır. Sûrede başlıca <b>İslâm inancının temel esasları çerçevesinde, Allah’ın birliğinin delilleri, Peygamberlik, öldükten sonra dirilme ve geçmişteki inkârcı milletlerin başlarına gelen felaketler, uğradıkları azaplar konu</b> edilmektedir.",
                "SureNameTurkish": "Kâf",
                "SureNameArabic": "قۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 34,
                "AyetCount": 45,
                "Cuz": 26,
                "FirstPage": 518,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 32669,
            "SureId": 50,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "اِنَّ فٖی ذٰلِكَ لَذِكْرٰى لِمَنْ كَانَ لَهُ قَلْبٌ اَوْ اَلْقَى السَّمْعَ وَهُوَ شَهٖیدٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32676,
            "SureId": 50,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "وَلَقَدْ خَلَقْنَا السَّمٰوَاتِ وَالْاَرْضَ وَمَا بَیْنَهُمَا فٖی سِتَّةِ اَیَّامٍࣗ وَمَا مَسَّنَا مِنْ لُغُوبٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32683,
            "SureId": 50,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "فَاصْبِرْ عَلٰى مَا یَقُولُونَ وَسَبِّـحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ الْغُرُوبِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32690,
            "SureId": 50,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "وَمِنَ الَّیْلِ فَسَبِّحْهُ وَاَدْبَارَ السُّجُودِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32697,
            "SureId": 50,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "وَاسْتَمِـعْ یَوْمَ یُنَادِ الْمُنَادِ مِنْ مَكَانٍ قَرٖیبٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32704,
            "SureId": 50,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "یَوْمَ یَسْمَعُونَ الصَّیْحَةَ بِالْحَقِّؕ ذٰلِكَ یَوْمُ الْخُرُوجِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32711,
            "SureId": 50,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "اِنَّا نَحْنُ نُحْيٖ وَنُمٖیتُ وَاِلَیْنَا الْمَصٖیرُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32718,
            "SureId": 50,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "یَوْمَ تَشَقَّقُ الْاَرْضُ عَنْهُمْ سِرَاعًاؕ ذٰلِكَ حَشْرٌ عَلَیْنَا یَسٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32725,
            "SureId": 50,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "نَحْنُ اَعْلَمُ بِمَا یَقُولُونَ وَمَٓا اَنْتَ عَلَیْهِمْ بِجَبَّارٍ فَذَكِّرْ بِالْقُرْاٰنِ مَنْ یَخَافُ وَعٖیدِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32732,
            "SureId": 51,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "وَالذَّارِیَاتِ ذَرْوًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 51,
                "MealInfo": "Mekke döneminde inmiştir. 60 âyettir. Sûre, adını ilk âyette geçen <b>“ez-zâriyât” </b>kelimesinden almıştır.<b> Zâriyât, esip savuran rüzgârlar demektir.</b> Sûrede başlıca, <b>öldükten sonra hesap için toplanma, inkârcıların ahirette karşılaşacakları azap, mü’minlere verilecek mükâfatlar, Allah’ın varlığını ve birliğini gösteren kevni deliller</b> konu edilmektedir.",
                "SureNameTurkish": "Zâriyât",
                "SureNameArabic": "الذَّارِيَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 67,
                "AyetCount": 60,
                "Cuz": 26,
                "FirstPage": 520,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 32739,
            "SureId": 51,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "فَالْحَامِلَاتِ وِقْرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32746,
            "SureId": 51,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "فَالْجَارِیَاتِ یُسْرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32753,
            "SureId": 51,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "فَالْمُقَسِّمَاتِ اَمْرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32760,
            "SureId": 51,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "اِنَّمَا تُوعَدُونَ لَصَادِقٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32767,
            "SureId": 51,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "وَاِنَّ الدّٖینَ لَوَاقِـعٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 32660,
            "SureId": 50,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "Kendilerinden önce, onlardan daha güçlü olup yeryüzünde şehirler kurarak aralarında gidip gelen nice toplulukları yok ettik. Kurtuluş var mı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 50,
                "MealInfo": "Mekke döneminde inmiştir. 45 âyettir. Sûre, adını başındaki <b>“Kâf ”</b> harfindenalmıştır. Sûrede başlıca <b>İslâm inancının temel esasları çerçevesinde, Allah’ın birliğinin delilleri, Peygamberlik, öldükten sonra dirilme ve geçmişteki inkârcı milletlerin başlarına gelen felaketler, uğradıkları azaplar konu</b> edilmektedir.",
                "SureNameTurkish": "Kâf",
                "SureNameArabic": "قۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 34,
                "AyetCount": 45,
                "Cuz": 26,
                "FirstPage": 518,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 32667,
            "SureId": 50,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "Aklı olan veya şuurlu olarak söze kulak veren kimse için bunda büyük ibret vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32674,
            "SureId": 50,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "Gökleri, yeri ve ikisi arasında bulunanları altı günde yarattık. Bize bir yorgunluk da dokunmadı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32681,
            "SureId": 50,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "Resulüm! Sen onların söylediklerini sabırla karşıla; güneş doğmadan ve batmadan önce rabbini övgü ve tesbih ile an.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32688,
            "SureId": 50,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "Gecenin bir kısmında ve secdelerin ardından da O’nu yücelterek an.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32695,
            "SureId": 50,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "Seslenenin, yakın bir yerden seslendiği gün için dinlemede ol.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32702,
            "SureId": 50,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "O dirilten sesi gerçekten işittikleri gün, işte o (ebedî hayata) çıkış günüdür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32709,
            "SureId": 50,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "Biz, ancak biz hayat verir ve öldürürüz, dönüş de elbet bizedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32716,
            "SureId": 50,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "Yerküre kendilerinden ayrılıp paramparça olduğu gün göz açıp kapayıncaya kadar (o seslenene yöneleceklerdir); bu bizim için çok kolay bir toplamadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32723,
            "SureId": 50,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "Onların ne dediklerini biz daha iyi biliyoruz. Sen onları zorlamakla görevli değilsin, uyarımızı ciddiye alanlara Kur’an’ı durmadan oku!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 32730,
            "SureId": 51,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1-6",
            "AyetVisible": true,
            "Page": 520,
            "AyetText": "Savurdukça savuranlara, yükü taşıyanlara, kolaylıkla akıp gidenlere, işleri taksim edenlere andolsun ki size vaad edilen şey kesinlikle doğrudur ve son yargılama mutlaka gerçekleşecektir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
