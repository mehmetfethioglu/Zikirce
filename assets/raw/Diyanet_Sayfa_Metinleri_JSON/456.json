    ],
    "CuzNo": 23,
    "PageNo": 456,
    "ArCuzNo": "۲۳",
    "ArPageNo": "٤٥٦",
    "QuranAyats": [
        {
            "Id": 28091,
            "SureId": 38,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "وَوَهَبْنَا لَهُٓ اَهْلَهُ وَمِثْلَهُمْ مَعَهُمْ رَحْمَةً مِنَّا وَذِكْرٰى لِاُو𐻾لِی الْاَلْبَابِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 38,
                "MealInfo": "Mekke döneminde inmiştir. 88 âyettir. Sûre, adını birinci âyetteki <b>“Sâd”</b> harfinden almıştır. Sûrede başlıca, <b>Allah’ın birliği, müşriklerin inkârları ve sapıklıkları sebebiyle azabı hak etmiş oldukları, Davûd, Süleyman, Eyyüp, İbrahim, İshak, İsmail, el-Yesa’ ve Zülkifl Peygamberlerin kıssaları, Davûd Peygamberin hakemliği ve Hz. Peygamberin temel görevi konu </b>edilmektedir.",
                "SureNameTurkish": "Sâd",
                "SureNameArabic": "صۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 38,
                "AyetCount": 88,
                "Cuz": 23,
                "FirstPage": 453,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 28098,
            "SureId": 38,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "وَخُذْ بِیَدِكَ ضِغْثًا فَاضْرِبْ بِهٖ وَلَا تَحْنَثْؕ اِنَّا وَجَدْنَاهُ صَابِرًاؕ نِعْمَ الْعَبْدُؕ اِنَّهُٓ اَوَّابٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28105,
            "SureId": 38,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "وَاذْكُرْ عِبَادَنَٓا اِبْرٰهٖیمَ وَاِسْحٰقَ وَیَعْقُوبَ اُو𐻾لِی الْاَیْدٖی وَالْاَبْصَارِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28112,
            "SureId": 38,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "اِنَّٓا اَخْلَصْنَاهُمْ بِخَالِصَةٍ ذِكْرَى الدَّارِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28119,
            "SureId": 38,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "وَاِنَّهُمْ عِنْدَنَا لَمِنَ الْمُصْطَفَیْنَ الْاَخْیَارِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28126,
            "SureId": 38,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "وَاذْكُرْ اِسْمٰعٖیلَ وَالْیَسَعَ وَذَا الْكِفْلِؕ وَكُلٌّ مِنَ الْاَخْیَارِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28133,
            "SureId": 38,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "هٰذَا ذِكْرٌؕ وَاِنَّ لِلْمُتَّقٖینَ لَحُسْنَ مَاٰبٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28140,
            "SureId": 38,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "جَنَّاتِ عَدْنٍ مُفَتَّحَةً لَهُمُ الْاَبْوَابُۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28147,
            "SureId": 38,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "مُتَّكِــٖٔینَ فٖیهَا یَدْعُونَ فٖیهَا بِفَاكِهَةٍ كَثٖیرَةٍ وَشَرَابٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28154,
            "SureId": 38,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "وَعِنْدَهُمْ قَاصِرَاتُ الطَّرْفِ اَتْرَابٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28161,
            "SureId": 38,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "هٰذَا مَا تُوعَدُونَ لِیَوْمِ الْحِسَابِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28168,
            "SureId": 38,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "اِنَّ هٰذَا لَرِزْقُنَا مَا لَهُ مِنْ نَفَادٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28175,
            "SureId": 38,
            "AyetId": 55,
            "LanguageId": 7,
            "AyetNumber": "٥٥",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "هٰذَاؕ وَاِنَّ لِلطَّاغٖینَ لَشَرَّ مَاٰبٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28182,
            "SureId": 38,
            "AyetId": 56,
            "LanguageId": 7,
            "AyetNumber": "٥٦",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "جَهَنَّمَۚ یَصْلَوْنَهَاۚ فَبِئْسَ الْمِهَادُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28189,
            "SureId": 38,
            "AyetId": 57,
            "LanguageId": 7,
            "AyetNumber": "٥٧",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "هٰذَاۙ فَلْیَذُوقُوهُ حَمٖیمٌ وَغَسَّاقٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28196,
            "SureId": 38,
            "AyetId": 58,
            "LanguageId": 7,
            "AyetNumber": "٥٨",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "وَاٰخَرُ مِنْ شَكْلِهٖٓ اَزْوَاجٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28203,
            "SureId": 38,
            "AyetId": 59,
            "LanguageId": 7,
            "AyetNumber": "٥٩",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "هٰذَا فَوْجٌ مُقْتَحِمٌ مَعَكُمْۚ لَا مَرْحَبًا بِهِمْؕ اِنَّهُمْ صَالُوا النَّارِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28210,
            "SureId": 38,
            "AyetId": 60,
            "LanguageId": 7,
            "AyetNumber": "٦٠",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "قَالُوا بَلْ اَنْتُمْࣞ لَا مَرْحَبًا بِكُمْؕ اَنْتُمْ قَدَّمْتُمُوهُ لَنَاۚ فَبِئْسَ الْقَرَارُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28217,
            "SureId": 38,
            "AyetId": 61,
            "LanguageId": 7,
            "AyetNumber": "٦١",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "قَالُوا رَبَّنَا مَنْ قَدَّمَ لَنَا هٰذَا فَزِدْهُ عَذَابًا ضِعْفًا فِی النَّارِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 28089,
            "SureId": 38,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "Tarafımızdan bir rahmet ve akıl iz‘an sahipleri için de anılacak bir örnek olmak üzere ona aile efradını, ayrıca bunlarla birlikte bir mislini daha bağışladık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 38,
                "MealInfo": "Mekke döneminde inmiştir. 88 âyettir. Sûre, adını birinci âyetteki <b>“Sâd”</b> harfinden almıştır. Sûrede başlıca, <b>Allah’ın birliği, müşriklerin inkârları ve sapıklıkları sebebiyle azabı hak etmiş oldukları, Davûd, Süleyman, Eyyüp, İbrahim, İshak, İsmail, el-Yesa’ ve Zülkifl Peygamberlerin kıssaları, Davûd Peygamberin hakemliği ve Hz. Peygamberin temel görevi konu </b>edilmektedir.",
                "SureNameTurkish": "Sâd",
                "SureNameArabic": "صۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 38,
                "AyetCount": 88,
                "Cuz": 23,
                "FirstPage": 453,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 28096,
            "SureId": 38,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "(Bir yemini vardı.) “Eline bir demet bitki sapı alıp onunla vur ve böylece yeminini yerine getirmiş ol” (dedik). Gerçekten biz onu sıkıntılara dayanıklı bulduk. O ne güzel bir kuldu! Yönü hep Allah’a dönüktü.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28103,
            "SureId": 38,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "Güçlü ve basîretli kullarımız İbrâhim, İshak ve Ya‘kūb’u da an.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28110,
            "SureId": 38,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "Âhiret yurdunu hatırda tutmadaki samimiyetleri sayesinde onları günahlardan arındırdık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28117,
            "SureId": 38,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "Doğrusu onlar bizim katımızda gerçekten seçkin kılınmış, hayırlı kimseler ­arasındadırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28124,
            "SureId": 38,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "İsmâil’i, Elyesa‘ı ve Zülkifl’i de an. Hepsi de iyi kimselerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28131,
            "SureId": 38,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49-50",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "Bu bir hatırlatmadır. Kuşkusuz Allah’a itaatsizlikten sakınanlara çok güzel bir gelecek, kapıları kendilerine ardına kadar açılacak adn cennetleri vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28138,
            "SureId": 38,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": false,
            "Page": 456,
            "AyetText": "Bu bir hatırlatmadır. Kuşkusuz Allah’a itaatsizlikten sakınanlara çok güzel bir gelecek, kapıları kendilerine ardına kadar açılacak adn cennetleri vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28145,
            "SureId": 38,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "Orada yerlerine kurularak çeşit çeşit meyve ve içecek isteyebilecekler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28152,
            "SureId": 38,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "Yanlarında eşlerinden başkasına bakmayan yaşıt dilberler olacak.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28159,
            "SureId": 38,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "İşte bunlar, hesap günü için size vaad edilenlerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28166,
            "SureId": 38,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "Kuşkusuz bu, bitmek tükenmek bilmeyen nimetimizdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28173,
            "SureId": 38,
            "AyetId": 55,
            "LanguageId": 5,
            "AyetNumber": "55-56",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "Bu böyledir. Öte yandan azgınlara da çok kötü bir gelecek, cehennem vardır; orayı boylayacaklar. Ne kötü bir yer orası!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28180,
            "SureId": 38,
            "AyetId": 56,
            "LanguageId": 5,
            "AyetNumber": "56",
            "AyetVisible": false,
            "Page": 456,
            "AyetText": "Bu böyledir. Öte yandan azgınlara da çok kötü bir gelecek, cehennem vardır; orayı boylayacaklar. Ne kötü bir yer orası!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28187,
            "SureId": 38,
            "AyetId": 57,
            "LanguageId": 5,
            "AyetNumber": "57",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "Bu böyledir, çünkü, bir kaynar, bir de dondurucu su! Tatsınlar onu!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28194,
            "SureId": 38,
            "AyetId": 58,
            "LanguageId": 5,
            "AyetNumber": "58",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "Bunun benzeri daha başka nice azap türleri!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28201,
            "SureId": 38,
            "AyetId": 59,
            "LanguageId": 5,
            "AyetNumber": "59",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "(İnkârcı önderlere), “İşte şunlar da sizinle beraber cehenneme girecek olanlardır” (denince), “Rahat yüzü görmesin onlar! Onlar ateşe gireceklerdir” (derler).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28208,
            "SureId": 38,
            "AyetId": 60,
            "LanguageId": 5,
            "AyetNumber": "60",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "Diğerleri, “Hayır, asıl rahat yüzü görmemesi gereken sizlersiniz; bizi bu duruma siz sürüklediniz. Ne kötü bir yer burası!” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 28215,
            "SureId": 38,
            "AyetId": 61,
            "LanguageId": 5,
            "AyetNumber": "61",
            "AyetVisible": true,
            "Page": 456,
            "AyetText": "“Ey rabbimiz!” diyecekler, “Bizi bu duruma sürükleyenlerin ateşte çekecekleri azabı bir kat daha arttır!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Sâd",
