{
    "PointerList": null,
    "CuzNo": 30,
    "PageNo": 594,
    "ArCuzNo": "۳۰",
    "ArPageNo": "٥۹٤",
    "QuranAyats": [
        {
            "Id": 42056,
            "SureId": 89,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "فَاَمَّا الْاِنْسَانُ اِذَا مَا ابْتَلٰیهُ رَبُّهُ فَاَكْرَمَهُ وَنَعَّمَهُ فَیَقُولُ رَبّٖٓی اَكْرَمَنِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 89,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. Sûre, adını birinci âyetteki “el-Fecr”kelimesinden almıştır. Fecr, tan yerinin ağarması vakti demektir",
                "SureNameTurkish": "Fecr",
                "SureNameArabic": "الْفَجْرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 10,
                "AyetCount": 30,
                "Cuz": 30,
                "FirstPage": 593,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42063,
            "SureId": 89,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "وَاَمَّٓا اِذَا مَا ابْتَلٰیهُ فَقَدَرَ عَلَیْهِ رِزْقَهُ فَیَقُولُ رَبّٖٓی اَهَانَنِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42070,
            "SureId": 89,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "كَلَّا بَلْ لَا تُكْرِمُونَ الْیَتٖیمَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42077,
            "SureId": 89,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "وَلَا تَحَٓاضُّونَ عَلٰى طَعَامِ الْمِسْكٖینِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42084,
            "SureId": 89,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "وَتَاْكُلُونَ التُّرَاثَ اَكْلًا لَمًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42091,
            "SureId": 89,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "وَتُحِبُّونَ الْمَالَ حُبًّا جَمًّاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42098,
            "SureId": 89,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "كَلَّٓا اِذَا دُكَّتِ الْاَرْضُ دَكًّا دَكًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42105,
            "SureId": 89,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "وَجَٓاءَ رَبُّكَ وَالْمَلَكُ صَفًّا صَفًّاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42112,
            "SureId": 89,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "وَجٖٓیءَ یَوْمَئِذٍ بِجَهَنَّمَ یَوْمَئِذٍ یَتَذَكَّرُ الْاِنْسَانُ وَاَنّٰى لَهُ الذِّكْرٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42119,
            "SureId": 89,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "یَقُولُ یَا لَیْتَنٖی قَدَّمْتُ لِحَیَاتٖیۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42126,
            "SureId": 89,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "فَیَوْمَئِذٍ لَا یُعَذِّبُ عَذَابَهُٓ اَحَدٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42133,
            "SureId": 89,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "وَلَا یُوثِقُ وَثَاقَهُٓ اَحَدٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42140,
            "SureId": 89,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "یَٓا اَیَّتُهَا النَّفْسُ الْمُطْمَئِنَّةُࣗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42147,
            "SureId": 89,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "اِرْجِعٖٓی اِلٰى رَبِّكِ رَاضِیَةً مَرْضِیَّةًۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42154,
            "SureId": 89,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "فَادْخُلٖی فٖی عِبَادٖیۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42161,
            "SureId": 89,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "وَادْخُلٖی جَنَّتٖی",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42168,
            "SureId": 90,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "لَٓا اُقْسِمُ بِهٰذَا الْبَلَدِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 90,
                "MealInfo": "Mekke döneminde inmiştir. 20 âyettir. Sûre, adını ilk âyetteki “el-Beled” kelimesindenalmıştır. Beled, şehir, belde demektir",
                "SureNameTurkish": "Beled",
                "SureNameArabic": "الْبَلَدِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 35,
                "AyetCount": 20,
                "Cuz": 30,
                "FirstPage": 594,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42175,
            "SureId": 90,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "وَاَنْتَ حِلٌّ بِهٰذَا الْبَلَدِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42182,
            "SureId": 90,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "وَوَالِدٍ وَمَا وَلَدَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42189,
            "SureId": 90,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "لَقَدْ خَلَقْنَا الْاِنْسَانَ فٖی كَبَدٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42196,
            "SureId": 90,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "اَیَحْسَبُ اَنْ لَنْ یَقْدِرَ عَلَیْهِ اَحَدٌۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42203,
            "SureId": 90,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "یَقُولُ اَهْلَكْتُ مَالًا لُبَدًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42210,
            "SureId": 90,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "اَیَحْسَبُ اَنْ لَمْ یَرَهُٓ اَحَدٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 42054,
            "SureId": 89,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "İnsan var ya, rabbi ona imtihan için ikramda bulunduğunda ve onu nimetlere boğduğunda, “Rabbim bana ikram etti” der (mutlu olur).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 89,
                "MealInfo": "Mekke döneminde inmiştir. 30 âyettir. Sûre, adını birinci âyetteki “el-Fecr”kelimesinden almıştır. Fecr, tan yerinin ağarması vakti demektir",
                "SureNameTurkish": "Fecr",
                "SureNameArabic": "الْفَجْرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 10,
                "AyetCount": 30,
                "Cuz": 30,
                "FirstPage": 593,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42061,
            "SureId": 89,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Onu imtihan edip rızkını daralttığında ise “Rabbim beni önemsemedi” der (mutsuz olur).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42068,
            "SureId": 89,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Hayır hayır! Doğrusu siz yetime ikram etmiyorsunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42075,
            "SureId": 89,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Birbirinizi yoksulu yedirmeye teşvik etmiyorsunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42082,
            "SureId": 89,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Mirası hak hukuk demeden yiyorsunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42089,
            "SureId": 89,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Malı aşırı derecede seviyorsunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42096,
            "SureId": 89,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Hayır, bu böyle olmamalı! Yer dağılıp parça parça olduğunda;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42103,
            "SureId": 89,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Rabbin (emri) gelip melekler de saf saf dizildiğinde;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42110,
            "SureId": 89,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "O gün cehennem de getirildiğinde, insan işte o gün yaptıklarını birer birer hatırlayacaktır. Fakat bu hatırlamanın ona ne faydası var!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42117,
            "SureId": 89,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "İnsan, “Keşke (âhiret) hayatım için daha önce bir şeyler yapmış olsaydım!” der.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42124,
            "SureId": 89,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Artık o gün Allah’ın vereceği cezayı kimse veremez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42131,
            "SureId": 89,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "O’nun bağladığı gibi kimse bağlayamaz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42138,
            "SureId": 89,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Ey imanın huzuruna kavuşmuş insan!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42145,
            "SureId": 89,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Sen O’ndan hoşnut, O da senden hoşnut olarak rabbine dön.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42152,
            "SureId": 89,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Böylece has kullarımın arasına sen de katıl.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42159,
            "SureId": 89,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Cennetime gir!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42166,
            "SureId": 90,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Yemin ederim şu beldeye;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 90,
                "MealInfo": "Mekke döneminde inmiştir. 20 âyettir. Sûre, adını ilk âyetteki “el-Beled” kelimesindenalmıştır. Beled, şehir, belde demektir",
                "SureNameTurkish": "Beled",
                "SureNameArabic": "الْبَلَدِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 35,
                "AyetCount": 20,
                "Cuz": 30,
                "FirstPage": 594,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42173,
            "SureId": 90,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Senin de içinde oturmakta olduğun o kente;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42180,
            "SureId": 90,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Ana babaya ve bunlardan meydana gelen çocuklara!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42187,
            "SureId": 90,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Hiç kuşkusuz biz insanı zahmetli bir hayat için yarattık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42194,
            "SureId": 90,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "O, hiçbir kimsenin kendisine güç yetiremeyeceğini mi sanıyor?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42201,
            "SureId": 90,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "“Pek çok mal harcadım” diyor.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42208,
            "SureId": 90,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 594,
            "AyetText": "Onu kimsenin görmediğini mi sanıyor?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Fecr",
