{
    "PointerList": null,
    "CuzNo": 19,
    "PageNo": 368,
    "ArCuzNo": "۱۹",
    "ArPageNo": "۳٦۸",
    "QuranAyats": [
        {
            "Id": 20664,
            "SureId": 26,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "قَالَ فَعَلْتُهَٓا اِذًا وَاَنَا𐻾 مِنَ الضَّٓالّٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20671,
            "SureId": 26,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "فَفَرَرْتُ مِنْكُمْ لَمَّا خِفْتُكُمْ فَوَهَبَ لٖی رَبّٖی حُكْمًا وَجَعَلَنٖی مِنَ الْمُرْسَلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20678,
            "SureId": 26,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "وَتِلْكَ نِعْمَةٌ تَمُنُّهَا عَلَیَّ اَنْ عَبَّدْتَ بَنٖٓی اِسْرَٓایٖٔلَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20685,
            "SureId": 26,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "قَالَ فِرْعَوْنُ وَمَا رَبُّ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20692,
            "SureId": 26,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "قَالَ رَبُّ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَیْنَهُمَاؕ اِنْ كُنْتُمْ مُوقِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20699,
            "SureId": 26,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "قَالَ لِمَنْ حَوْلَهُٓ اَلَا تَسْتَمِعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20706,
            "SureId": 26,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "قَالَ رَبُّكُمْ وَرَبُّ اٰبَٓائِكُمُ الْاَوَّلٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20713,
            "SureId": 26,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "قَالَ اِنَّ رَسُولَكُمُ الَّذٖٓی اُرْسِلَ اِلَیْكُمْ لَمَجْنُونٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20720,
            "SureId": 26,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "قَالَ رَبُّ الْمَشْرِقِ وَالْمَغْرِبِ وَمَا بَیْنَهُمَاؕ اِنْ كُنْتُمْ تَعْقِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20727,
            "SureId": 26,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "قَالَ لَئِنِ اتَّخَذْتَ اِلٰهًا غَیْرٖی لَاَجْعَلَنَّكَ مِنَ الْمَسْجُونٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20734,
            "SureId": 26,
            "AyetId": 30,
            "LanguageId": 7,
            "AyetNumber": "٣٠",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "قَالَ اَوَلَوْ جِئْتُكَ بِشَیْءٍ مُبٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20741,
            "SureId": 26,
            "AyetId": 31,
            "LanguageId": 7,
            "AyetNumber": "٣١",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "قَالَ فَاْتِ بِهٖٓ اِنْ كُنْتَ مِنَ الصَّادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20748,
            "SureId": 26,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "فَاَلْقٰى عَصَاهُ فَاِذَا هِیَ ثُعْبَانٌ مُبٖینٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20755,
            "SureId": 26,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "وَنَزَعَ یَدَهُ فَاِذَا هِیَ بَیْضَٓاءُ لِلنَّاظِرٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20762,
            "SureId": 26,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "قَالَ لِلْمَلَاِ حَوْلَهُٓ اِنَّ هٰذَا لَسَاحِرٌ عَلٖیمٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20769,
            "SureId": 26,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "یُرٖیدُ اَنْ یُخْرِجَكُمْ مِنْ اَرْضِكُمْ بِسِحْرِهٖࣗ فَمَاذَا تَاْمُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20776,
            "SureId": 26,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "قَالُٓوا اَرْجِهْ وَاَخَاهُ وَابْعَثْ فِی الْمَدَٓائِنِ حَاشِرٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20783,
            "SureId": 26,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "یَاْتُوكَ بِكُلِّ سَحَّارٍ عَلٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20790,
            "SureId": 26,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "فَجُمِعَ السَّحَرَةُ لِمٖیقَاتِ یَوْمٍ مَعْلُومٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20797,
            "SureId": 26,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "وَقٖیلَ لِلنَّاسِ هَلْ اَنْتُمْ مُجْتَمِعُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 20662,
            "SureId": 26,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Mûsâ, “Ben” dedi, “O işi, (sonunun ölüme varacağını) bilmeden yaptım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 20669,
            "SureId": 26,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Sizden korkunca da hemen aranızdan kaçtım. Sonra rabbim bana doğru karar vermeyi öğretti ve beni peygamberlerden biri yaptı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20676,
            "SureId": 26,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "O nimet diye başıma kaktığın şeye gelince o da İsrâiloğulları’nı kendine kul köle etmenden ibarettir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20683,
            "SureId": 26,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Firavun, “Âlemlerin rabbi de kimdir?” diye sordu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20690,
            "SureId": 26,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Mûsâ, “Eğer gerçeğe inanmaya yatkınlığınız varsa bilin ki O, göklerin, yerin ve ikisi arasında bulunan her şeyin rabbidir” diye cevap verdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20697,
            "SureId": 26,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Firavun yanında bulunanlara, “Ne dediğini duydunuz değil mi?” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20704,
            "SureId": 26,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Mûsâ, “O, sizin de rabbiniz, geçmişteki atalarınızın da rabbidir” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20711,
            "SureId": 26,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Firavun, “Size gönderilen bu elçiniz mutlaka aklını yitirmiş” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20718,
            "SureId": 26,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Mûsâ devamla şunu söyledi: “Şayet aklınızı kullanırsanız anlarsınız ki O, doğunun, batının ve bu ikisi arasında bulunanların rabbidir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20725,
            "SureId": 26,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Firavun, “Benden başkasını tanrı edinirsen, yemin ederim ki seni zindanlarda süründürürüm!” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20732,
            "SureId": 26,
            "AyetId": 30,
            "LanguageId": 5,
            "AyetNumber": "30",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Mûsâ, “Sana apaçık bir şey getirmiş olsam da mı?” diye sordu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20739,
            "SureId": 26,
            "AyetId": 31,
            "LanguageId": 5,
            "AyetNumber": "31",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Firavun, “Doğru söyleyenlerden isen, haydi getir onu” diye karşılık verdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20746,
            "SureId": 26,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Bunun üzerine Mûsâ asâsını atıverdi; bir de ne görsünler, asâ düpedüz bir yılan oluvermiş!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20753,
            "SureId": 26,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Sonra elini çıkardı; o da bakanlara beyaz ışık saçan bir şey oluvermiş!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20760,
            "SureId": 26,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Firavun, çevresindeki seçkinlere şöyle dedi: “Doğrusu bu, çok bilgili bir sihirbaz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20767,
            "SureId": 26,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Yaptığı sihirle sizi yurdunuzdan çıkarmak istiyor. Buna karşı ne buyurursunuz?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20774,
            "SureId": 26,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Dediler ki: “Onu ve kardeşini bir süre alıkoy ve sihirbaz toplamak üzere şehirlere (adamlar) gönder;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20781,
            "SureId": 26,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Bütün bilgili sihirbazları sana getirsinler.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20788,
            "SureId": 26,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Böylece sihirbazlar belli bir günün ilân edilmiş vaktinde bir araya getirildi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 20795,
            "SureId": 26,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 368,
            "AyetText": "Halka, “Siz de toplantıya gelmiyor musunuz?” denildi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Şuarâ",
    "QuranSureLabel": "الشُّعَرَاءِ",
    "EndPageSure": null
}