            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "وَاِذَا رَاٰكَ الَّذٖینَ كَفَرُٓوا اِنْ یَتَّخِذُونَكَ اِلَّا هُزُوًاؕ اَهٰذَا الَّذٖی یَذْكُرُ اٰلِهَتَكُمْۚ وَهُمْ بِذِكْرِ الرَّحْمٰنِ هُمْ كَافِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17640,
            "SureId": 21,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "خُلِقَ الْاِنْسَانُ مِنْ عَجَلٍؕ سَاُرٖیكُمْ اٰیَاتٖی فَلَا تَسْتَعْجِلُونِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17647,
            "SureId": 21,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "وَیَقُولُونَ مَتٰى هٰذَا الْوَعْدُ اِنْ كُنْتُمْ صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17654,
            "SureId": 21,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "لَوْ یَعْلَمُ الَّذٖینَ كَفَرُوا حٖینَ لَا یَكُفُّونَ عَنْ وُجُوهِهِمُ النَّارَ وَلَا عَنْ ظُهُورِهِمْ وَلَا هُمْ یُنْصَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17661,
            "SureId": 21,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "بَلْ تَاْتٖیهِمْ بَغْتَةً فَتَبْهَتُهُمْ فَلَا یَسْتَطٖیعُونَ رَدَّهَا وَلَا هُمْ یُنْظَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17668,
            "SureId": 21,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "وَلَقَدِ اسْتُهْزِئَ بِرُسُلٍ مِنْ قَبْلِكَ فَحَاقَ بِالَّذٖینَ سَخِرُوا مِنْهُمْ مَا كَانُوا بِهٖ یَسْتَهْزِؤُ𐻿نَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17675,
            "SureId": 21,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "قُلْ مَنْ یَكْلَؤُ𐻾كُمْ بِالَّیْلِ وَالنَّهَارِ مِنَ الرَّحْمٰنِؕ بَلْ هُمْ عَنْ ذِكْرِ رَبِّهِمْ مُعْرِضُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17682,
            "SureId": 21,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "اَمْ لَهُمْ اٰلِهَةٌ تَمْنَعُهُمْ مِنْ دُونِنَاؕ لَا یَسْتَطٖیعُونَ نَصْرَ اَنْفُسِهِمْ وَلَا هُمْ مِنَّا یُصْحَبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17689,
            "SureId": 21,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "بَلْ مَتَّعْنَا هٰٓؤُ𐻾لَٓاءِ وَاٰبَٓاءَهُمْ حَتّٰى طَالَ عَلَیْهِمُ الْعُمُرُؕ اَفَلَا یَرَوْنَ اَنَّا نَاْتِی الْاَرْضَ نَنْقُصُهَا مِنْ اَطْرَافِهَاؕ اَفَهُمُ الْغَالِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 17631,
            "SureId": 21,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "İnkâr edenler seni gördükleri zaman, -Rahmân’ın kitabını inkâr edenlerin ta kendileri olarak- “İlâhlarınızı diline dolayan bu mu?” diye mutlaka seninle alay ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17638,
            "SureId": 21,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "İnsan, aceleci olarak yaratılmıştır. Size âyetlerimi göstereceğim; benden acele istemeyin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17645,
            "SureId": 21,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "“Eğer doğru söylüyorsanız, bu tehdit ne zaman gerçekleşecek?” diye soruyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17652,
            "SureId": 21,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "İnkâr edenler, yüzlerinden ve sırtlarından ateşi savamayacakları, kendilerine yardım da edilmeyeceği zamanı bilselerdi (böyle acele etmezlerdi)!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17659,
            "SureId": 21,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "Bilâkis onlara kıyamet ansızın gelecek ve onları şaşkına çevirecek. Artık ne onu geri çevirebilecekler ne de kendilerine süre verilecektir!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17666,
            "SureId": 21,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "Kuşkusuz, senden önceki peygamberlerle de alay edilmişti; ama sonunda o alay konusu ettikleri şey onlarla alay edenlerin tepelerine biniverdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17673,
            "SureId": 21,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "De ki: “Azap etmek istediğinde gece gündüz rahmâna karşı sizi kim koruyabilir?” Yine de onlar rablerini hatırlamaya yanaşmıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17680,
            "SureId": 21,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "Yoksa kendilerini bize karşı savunacak birtakım ilâhları mı var? Onlar ne kendilerini koruyabilirler ne de tarafımızdan destek görürler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17687,
            "SureId": 21,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 325,
            "AyetText": "Oysa biz onları da atalarını da nimetlerimizden faydalandırdık. Hatta bu, ömürleri boyunca sürüp gitti. Şimdi bizim yeryüzünü etrafından nasıl eksiltip durduğumuzu görmüyorlar mı? Şu halde üstün gelen onlar mı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
