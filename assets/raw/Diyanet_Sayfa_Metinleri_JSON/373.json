    "QuranAyats": [
        {
            "Id": 21483,
            "SureId": 26,
            "AyetId": 137,
            "LanguageId": 7,
            "AyetNumber": "١٣٧",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "اِنْ هٰذَٓا اِلَّا خُلُقُ الْاَوَّلٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 21490,
            "SureId": 26,
            "AyetId": 138,
            "LanguageId": 7,
            "AyetNumber": "١٣٨",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "وَمَا نَحْنُ بِمُعَذَّبٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21497,
            "SureId": 26,
            "AyetId": 139,
            "LanguageId": 7,
            "AyetNumber": "١٣٩",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "فَكَذَّبُوهُ فَاَهْلَكْنَاهُمْؕ اِنَّ فٖی ذٰلِكَ لَاٰیَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21504,
            "SureId": 26,
            "AyetId": 140,
            "LanguageId": 7,
            "AyetNumber": "١٤٠",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "وَاِنَّ رَبَّكَ لَهُوَ الْعَزٖیزُ الرَّحٖیمُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21511,
            "SureId": 26,
            "AyetId": 141,
            "LanguageId": 7,
            "AyetNumber": "١٤١",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "كَذَّبَتْ ثَمُودُ الْمُرْسَلٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21518,
            "SureId": 26,
            "AyetId": 142,
            "LanguageId": 7,
            "AyetNumber": "١٤٢",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "اِذْ قَالَ لَهُمْ اَخُوهُمْ صَالِحٌ اَلَا تَتَّقُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21525,
            "SureId": 26,
            "AyetId": 143,
            "LanguageId": 7,
            "AyetNumber": "١٤٣",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "اِنّٖی لَكُمْ رَسُولٌ اَمٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21532,
            "SureId": 26,
            "AyetId": 144,
            "LanguageId": 7,
            "AyetNumber": "١٤٤",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "فَاتَّقُوا اللّٰهَ وَاَطٖیعُونِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21539,
            "SureId": 26,
            "AyetId": 145,
            "LanguageId": 7,
            "AyetNumber": "١٤٥",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "وَمَٓا اَسْـَٔلُكُمْ عَلَیْهِ مِنْ اَجْرٍۚ اِنْ اَجْرِیَ اِلَّا عَلٰى رَبِّ الْعَالَمٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21546,
            "SureId": 26,
            "AyetId": 146,
            "LanguageId": 7,
            "AyetNumber": "١٤٦",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "اَتُتْرَكُونَ فٖی مَا هٰهُنَٓا اٰمِنٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21553,
            "SureId": 26,
            "AyetId": 147,
            "LanguageId": 7,
            "AyetNumber": "١٤٧",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "فٖی جَنَّاتٍ وَعُیُونٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21560,
            "SureId": 26,
            "AyetId": 148,
            "LanguageId": 7,
            "AyetNumber": "١٤٨",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "وَزُرُوعٍ وَنَخْلٍ طَلْعُهَا هَضٖیمٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21567,
            "SureId": 26,
            "AyetId": 149,
            "LanguageId": 7,
            "AyetNumber": "١٤٩",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "وَتَنْحِتُونَ مِنَ الْجِبَالِ بُیُوتًا فَارِهٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21574,
            "SureId": 26,
            "AyetId": 150,
            "LanguageId": 7,
            "AyetNumber": "١٥٠",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "فَاتَّقُوا اللّٰهَ وَاَطٖیعُونِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21581,
            "SureId": 26,
            "AyetId": 151,
            "LanguageId": 7,
            "AyetNumber": "١٥١",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "وَلَا تُطٖیعُٓوا اَمْرَ الْمُسْرِفٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21588,
            "SureId": 26,
            "AyetId": 152,
            "LanguageId": 7,
            "AyetNumber": "١٥٢",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "اَلَّذٖینَ یُفْسِدُونَ فِی الْاَرْضِ وَلَا یُصْلِحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21595,
            "SureId": 26,
            "AyetId": 153,
            "LanguageId": 7,
            "AyetNumber": "١٥٣",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "قَالُٓوا اِنَّمَٓا اَنْتَ مِنَ الْمُسَحَّرٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21602,
            "SureId": 26,
            "AyetId": 154,
            "LanguageId": 7,
            "AyetNumber": "١٥٤",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "مَٓا اَنْتَ اِلَّا بَشَرٌ مِثْلُنَاۚ فَاْتِ بِاٰیَةٍ اِنْ كُنْتَ مِنَ الصَّادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21609,
            "SureId": 26,
            "AyetId": 155,
            "LanguageId": 7,
            "AyetNumber": "١٥٥",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "قَالَ هٰذِهٖ نَاقَةٌ لَهَا شِرْبٌ وَلَكُمْ شِرْبُ یَوْمٍ مَعْلُومٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21616,
            "SureId": 26,
            "AyetId": 156,
            "LanguageId": 7,
            "AyetNumber": "١٥٦",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "وَلَا تَمَسُّوهَا بِسُٓوءٍ فَیَاْخُذَكُمْ عَذَابُ یَوْمٍ عَظٖیمٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21623,
            "SureId": 26,
            "AyetId": 157,
            "LanguageId": 7,
            "AyetNumber": "١٥٧",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "فَعَقَرُوهَا فَاَصْبَحُوا نَادِمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21630,
            "SureId": 26,
            "AyetId": 158,
            "LanguageId": 7,
            "AyetNumber": "١٥٨",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "فَاَخَذَهُمُ الْعَذَابُؕ اِنَّ فٖی ذٰلِكَ لَاٰیَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21637,
            "SureId": 26,
            "AyetId": 159,
            "LanguageId": 7,
            "AyetNumber": "١٥٩",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "وَاِنَّ رَبَّكَ لَهُوَ الْعَزٖیزُ الرَّحٖیمُࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 21481,
            "SureId": 26,
            "AyetId": 137,
            "LanguageId": 5,
            "AyetNumber": "137",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "“Bu, öncekilerin tuttuğu yoldan başkası değildir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 21488,
            "SureId": 26,
            "AyetId": 138,
            "LanguageId": 5,
            "AyetNumber": "138",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Bu yüzden azaba uğratılacak da değiliz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21495,
            "SureId": 26,
            "AyetId": 139,
            "LanguageId": 5,
            "AyetNumber": "139",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Böylece onu yalancılıkla suçladılar; biz de onları helâk ettik. Doğrusu bu anlatılanlarda büyük bir ibret vardır ama çokları inanmazlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21502,
            "SureId": 26,
            "AyetId": 140,
            "LanguageId": 5,
            "AyetNumber": "140",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Şüphesiz rabbin, işte O, mutlak güç ve engin merhamet sahibidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21509,
            "SureId": 26,
            "AyetId": 141,
            "LanguageId": 5,
            "AyetNumber": "141",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Semûd kavmi de peygamberleri yalancılıkla suçladı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21516,
            "SureId": 26,
            "AyetId": 142,
            "LanguageId": 5,
            "AyetNumber": "142",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Kardeşleri Sâlih onlara şöyle demişti: “Allah’a karşı gelmekten sakınmaz mısınız?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21523,
            "SureId": 26,
            "AyetId": 143,
            "LanguageId": 5,
            "AyetNumber": "143",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Bakınız, ben size gönderilmiş güvenilir bir elçiyim.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21530,
            "SureId": 26,
            "AyetId": 144,
            "LanguageId": 5,
            "AyetNumber": "144",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Artık Allah’a karşı gelmekten sakının ve bana itaat edin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21537,
            "SureId": 26,
            "AyetId": 145,
            "LanguageId": 5,
            "AyetNumber": "145",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Bunun için sizden bir karşılık beklemiyorum. Benim ecrimi vermek yalnız âlemlerin rabbine aittir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21544,
            "SureId": 26,
            "AyetId": 146,
            "LanguageId": 5,
            "AyetNumber": "146-149",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Siz burada, bahçelerin, pınarların içinde; ekinlerin, meyveleri uç vermiş hurma ağaçlarının arasında güven içinde bırakılacağınızı ve dağlardan ustaca evler oyup yapmaya devam edebileceğinizi mi sanıyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21551,
            "SureId": 26,
            "AyetId": 147,
            "LanguageId": 5,
            "AyetNumber": "147",
            "AyetVisible": false,
            "Page": 373,
            "AyetText": "Siz burada, bahçelerin, pınarların içinde; ekinlerin, meyveleri uç vermiş hurma ağaçlarının arasında güven içinde bırakılacağınızı ve dağlardan ustaca evler oyup yapmaya devam edebileceğinizi mi sanıyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21558,
            "SureId": 26,
            "AyetId": 148,
            "LanguageId": 5,
            "AyetNumber": "148",
            "AyetVisible": false,
            "Page": 373,
            "AyetText": "Siz burada, bahçelerin, pınarların içinde; ekinlerin, meyveleri uç vermiş hurma ağaçlarının arasında güven içinde bırakılacağınızı ve dağlardan ustaca evler oyup yapmaya devam edebileceğinizi mi sanıyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21565,
            "SureId": 26,
            "AyetId": 149,
            "LanguageId": 5,
            "AyetNumber": "149",
            "AyetVisible": false,
            "Page": 373,
            "AyetText": "Siz burada, bahçelerin, pınarların içinde; ekinlerin, meyveleri uç vermiş hurma ağaçlarının arasında güven içinde bırakılacağınızı ve dağlardan ustaca evler oyup yapmaya devam edebileceğinizi mi sanıyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21572,
            "SureId": 26,
            "AyetId": 150,
            "LanguageId": 5,
            "AyetNumber": "150",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Artık Allah’tan korkun ve bana itaat edin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21579,
            "SureId": 26,
            "AyetId": 151,
            "LanguageId": 5,
            "AyetNumber": "151-152",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Yeryüzünde düzeni bozan ama düzeltmeye yanaşmayan aşırıların istediklerini yapmayın.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21586,
            "SureId": 26,
            "AyetId": 152,
            "LanguageId": 5,
            "AyetNumber": "152",
            "AyetVisible": false,
            "Page": 373,
            "AyetText": "Yeryüzünde düzeni bozan ama düzeltmeye yanaşmayan aşırıların istediklerini yapmayın.\"",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21593,
            "SureId": 26,
            "AyetId": 153,
            "LanguageId": 5,
            "AyetNumber": "153",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Dediler ki: “Kuşkusuz sen, kendisine büyü yapılmış birisin!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21600,
            "SureId": 26,
            "AyetId": 154,
            "LanguageId": 5,
            "AyetNumber": "154",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Sen de yalnızca bizim gibi bir insansın. Eğer doğru sözlü isen, haydi bize bir mûcize getir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21607,
            "SureId": 26,
            "AyetId": 155,
            "LanguageId": 5,
            "AyetNumber": "155-156",
            "AyetVisible": true,
            "Page": 373,
            "AyetText": "Sâlih, “İşte (mûcize) bu dişi devedir; onun bir su içme hakkı vardır, belli bir günün içme hakkı da sizindir; sakın ona bir kötülük yapmayın, yoksa büyük bir günün azabı yakanıza yapışır” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
