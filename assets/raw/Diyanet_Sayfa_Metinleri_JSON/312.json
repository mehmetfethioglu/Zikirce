    "QuranAyats": [
        {
            "Id": 16422,
            "SureId": 19,
            "AyetId": 96,
            "LanguageId": 7,
            "AyetNumber": "٩٦",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "اِنَّ الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ سَیَجْعَلُ لَهُمُ الرَّحْمٰنُ وُدًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16429,
            "SureId": 19,
            "AyetId": 97,
            "LanguageId": 7,
            "AyetNumber": "٩٧",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "فَاِنَّمَا یَسَّرْنَاهُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ الْمُتَّقٖینَ وَتُنْذِرَ بِهٖ قَوْمًا لُدًّا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16436,
            "SureId": 19,
            "AyetId": 98,
            "LanguageId": 7,
            "AyetNumber": "٩٨",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "وَكَمْ اَهْلَكْنَا قَبْلَهُمْ مِنْ قَرْنٍؕ هَلْ تُحِسُّ مِنْهُمْ مِنْ اَحَدٍ اَوْ تَسْمَعُ لَهُمْ رِكْزًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16443,
            "SureId": 20,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "طٰهٰؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16450,
            "SureId": 20,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "مَٓا اَنْزَلْنَا عَلَیْكَ الْقُرْاٰنَ لِتَشْقٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16457,
            "SureId": 20,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "اِلَّا تَذْكِرَةً لِمَنْ یَخْشٰىۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16464,
            "SureId": 20,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "تَنْزٖیلًا مِمَّنْ خَلَقَ الْاَرْضَ وَالسَّمٰوَاتِ الْعُلٰىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16471,
            "SureId": 20,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "اَلرَّحْمٰنُ عَلَى الْعَرْشِ اسْتَوٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16478,
            "SureId": 20,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "لَهُ مَا فِی السَّمٰوَاتِ وَمَا فِی الْاَرْضِ وَمَا بَیْنَهُمَا وَمَا تَحْتَ الثَّرٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16485,
            "SureId": 20,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "وَاِنْ تَجْهَرْ بِالْقَوْلِ فَاِنَّهُ یَعْلَمُ السِّرَّ وَاَخْفٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16492,
            "SureId": 20,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "اَللّٰهُ لَٓا اِلٰهَ اِلَّا هُوَؕ لَهُ الْاَسْمَٓاءُ الْحُسْنٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16499,
            "SureId": 20,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "وَهَلْ اَتٰیكَ حَدٖیثُ مُوسٰىۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16506,
            "SureId": 20,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "اِذْ رَاٰ نَارًا فَقَالَ لِاَهْلِهِ امْكُثُٓوا اِنّٖٓی اٰنَسْتُ نَارًا لَعَلّٖٓی اٰتٖیكُمْ مِنْهَا بِقَبَسٍ اَوْ اَجِدُ عَلَى النَّارِ هُدًى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16513,
            "SureId": 20,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "فَلَمَّٓا اَتٰیهَا نُودِیَ یَا مُوسٰى",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16520,
            "SureId": 20,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "اِنّٖٓی اَنَا𐻾 رَبُّكَ فَاخْلَعْ نَعْلَیْكَۚ اِنَّكَ بِالْوَادِ الْمُقَدَّسِ طُوًىؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 16420,
            "SureId": 19,
            "AyetId": 96,
            "LanguageId": 5,
            "AyetNumber": "96",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "İman edip dünya ve âhiret için yararlı işler yapanlara gelince, rahmân onlar için (gönüllerde) bir sevgi yaratacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 19,
                "MealInfo": "Mekke döneminde inmiştir. 98 âyettir. Bazı tefsir bilginlerine göre 58 ve 71. âyetler Medine döneminde inmiştir. Sûre, Meryem’in, oğlu İsa’yı nasıl dünyaya getirdiğini anlattığı için bu adla anılmıştır. Sûre de başlıca, tevhit inancını yerleştirmek amacıyla bazı peygamberlerin kıssaları ve kıyamet sahneleri konu edilmektedir.",
                "SureNameTurkish": "Meryem",
                "SureNameArabic": "مَرْيَمَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 44,
                "AyetCount": 98,
                "Cuz": 16,
                "FirstPage": 305,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16427,
            "SureId": 19,
            "AyetId": 97,
            "LanguageId": 5,
            "AyetNumber": "97",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "Biz Kur’an’ı senin dilinle kolay anlaşılır kıldık ki günahtan sakınanları onunla müjdeleyesin ve inatla direnenleri de onunla uyarasın!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16434,
            "SureId": 19,
            "AyetId": 98,
            "LanguageId": 5,
            "AyetNumber": "98",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "Biz, onlardan önce nice nesilleri helâk ettik. Sen, onların herhangi birinden (bir varlık emâresi) hissediyor veya cılız da olsa bir ses işitiyor musun?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16441,
            "SureId": 20,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "Tâ-hâ.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 20,
                "MealInfo": "Mekke döneminde inmiştir. 135 âyettir. Sûre, adını birinci âyette yer alan harflerden almıştır. Sûrede, Allah’ın peygamberler aracılığıyla insanlara gösterdiği doğru yolun temel gerçeklerine işaret edilmekte, Hz.Peygamber teselli edilerek peygamberlik görevini mutlaka en güzel şekilde başaracağı müjdelenip kendisine karşı çıkanların uğrayacağı sonuçlar izah edilmektedir.",
                "SureNameTurkish": "Tâhâ",
                "SureNameArabic": "طٰهٰ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 45,
                "AyetCount": 135,
                "Cuz": 16,
                "FirstPage": 312,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 16448,
            "SureId": 20,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "Biz Kur’an’ı sana mutsuz olasın diye indirmedik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16455,
            "SureId": 20,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "Ancak Allah korkusu taşıyanlar için öğüt olsun diye indirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16462,
            "SureId": 20,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "O, yeri ve yüce gökleri yaratan Allah katından peyderpey gönderilmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16469,
            "SureId": 20,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "Rahmân olan Allah arşa istivâ etmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16476,
            "SureId": 20,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "Göklerde, yerde, ikisinin arasında ve toprağın altında ne varsa hepsi O’nundur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16483,
            "SureId": 20,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "Sen sözü ister açığa vur (ister gizle), O gizliyi de, gizlinin gizlisini de bilir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16490,
            "SureId": 20,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "Allah, O’ndan başka tanrı yoktur; en güzel isimler O’na aittir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16497,
            "SureId": 20,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "Mûsâ ile ilgili bilgi sana erişti mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16504,
            "SureId": 20,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "Hani o bir ateş görmüş ve ailesine şöyle demişti: “Siz bekleyin, (şu uzakta) bir ateş bulunduğunu farkettim; belki ondan size bir kor parçası getiririm veya ateşin başında bir kılavuz bulurum.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16511,
            "SureId": 20,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "Onun yanına geldiğinde kendisine “ey Mûsâ!” diye seslenildi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 16518,
            "SureId": 20,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 312,
            "AyetText": "“İyi bil ki ben, evet yalnız ben senin rabbinim; artık pabuçlarını çıkar, çünkü şu anda kutsal vadide, Tuvâ’dasın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
