    "QuranAyats": [
        {
            "Id": 41286,
            "SureId": 84,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "اِنَّهُ ظَنَّ اَنْ لَنْ یَحُورَۚۛ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 84,
                "MealInfo": "Mekke döneminde inmiştir. 25 âyettir. Sûre, adını birinci âyette geçen “inşakka” fiilinin mastarı olan “İnşikâk” kelimesinden almıştır. İnşikâk, yarılmakdemektir",
                "SureNameTurkish": "İnşikâk",
                "SureNameArabic": "الْاِنْشِقَاقِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 83,
                "AyetCount": 25,
                "Cuz": 30,
                "FirstPage": 589,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 41293,
            "SureId": 84,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "بَلٰىۚۛ اِنَّ رَبَّهُ كَانَ بِهٖ بَصٖیرًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41300,
            "SureId": 84,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "فَلَٓا اُقْسِمُ بِالشَّفَقِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41307,
            "SureId": 84,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "وَالَّیْلِ وَمَا وَسَقَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41314,
            "SureId": 84,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "وَالْقَمَرِ اِذَا اتَّسَقَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41321,
            "SureId": 84,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41328,
            "SureId": 84,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "فَمَا لَهُمْ لَا یُؤْمِنُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41335,
            "SureId": 84,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "وَاِذَا قُرِئَ عَلَیْهِمُ الْقُرْاٰنُ لَا یَسْجُدُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41342,
            "SureId": 84,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "بَلِ الَّذٖینَ كَفَرُوا یُكَذِّبُونَؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41349,
            "SureId": 84,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "وَاللّٰهُ اَعْلَمُ بِمَا یُوعُونَؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41356,
            "SureId": 84,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "فَبَشِّرْهُمْ بِعَذَابٍ اَلٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41363,
            "SureId": 84,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "اِلَّا الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ اَجْرٌ غَیْرُ مَمْنُونٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41370,
            "SureId": 85,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "وَالسَّمَٓاءِ ذَاتِ الْبُرُوجِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 85,
                "MealInfo": "Mekke döneminde inmiştir. 22 âyettir. Sûre, adını birinci âyetteki “el-Bürûc”kelimesinden almıştır. Bürûc, burçlar demektir.",
                "SureNameTurkish": "Burûc",
                "SureNameArabic": "الْبُرُوجِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 27,
                "AyetCount": 22,
                "Cuz": 30,
                "FirstPage": 590,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 41377,
            "SureId": 85,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "وَالْیَوْمِ الْمَوْعُودِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41384,
            "SureId": 85,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "وَشَاهِدٍ وَمَشْهُودٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41391,
            "SureId": 85,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "قُتِلَ اَصْحَابُ الْاُخْدُودِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41398,
            "SureId": 85,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "اَلنَّارِ ذَاتِ الْوَقُودِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41405,
            "SureId": 85,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "اِذْ هُمْ عَلَیْهَا قُعُودٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41412,
            "SureId": 85,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "وَهُمْ عَلٰى مَا یَفْعَلُونَ بِالْمُؤْمِنٖینَ شُهُودٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41419,
            "SureId": 85,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "وَمَا نَقَمُوا مِنْهُمْ اِلَّٓا اَنْ یُؤْمِنُوا بِاللّٰهِ الْعَزٖیزِ الْحَمٖیدِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41426,
            "SureId": 85,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "اَلَّذٖی لَهُ مُلْكُ السَّمٰوَاتِ وَالْاَرْضِؕ وَاللّٰهُ عَلٰى كُلِّ شَیْءٍ شَهٖیدٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41433,
            "SureId": 85,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "اِنَّ الَّذٖینَ فَتَنُوا الْمُؤْمِنٖینَ وَالْمُؤْمِنَاتِ ثُمَّ لَمْ یَتُوبُوا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَرٖیقِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41440,
            "SureId": 85,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "اِنَّ الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ جَنَّاتٌ تَجْرٖی مِنْ تَحْتِهَا الْاَنْهَارُؕ ذٰلِكَ الْفَوْزُ الْكَبٖیرُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 41284,
            "SureId": 84,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Zira o, hiçbir zaman rabbine dönmeyeceğini sanırdı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 84,
                "MealInfo": "Mekke döneminde inmiştir. 25 âyettir. Sûre, adını birinci âyette geçen “inşakka” fiilinin mastarı olan “İnşikâk” kelimesinden almıştır. İnşikâk, yarılmakdemektir",
                "SureNameTurkish": "İnşikâk",
                "SureNameArabic": "الْاِنْشِقَاقِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 83,
                "AyetCount": 25,
                "Cuz": 30,
                "FirstPage": 589,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 41291,
            "SureId": 84,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Hayır, tam tersi! Rabbi onu şüphesiz görmekteydi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41298,
            "SureId": 84,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Hayır hayır! Yemin ederim o şafağa,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41305,
            "SureId": 84,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Geceye ve onun topladığı şeylere,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41312,
            "SureId": 84,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Ve dolunay şeklini aldığı zaman aya ki,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41319,
            "SureId": 84,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Siz halden hale geçeceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41326,
            "SureId": 84,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Durum bu iken onlara ne oluyor da iman etmiyorlar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41333,
            "SureId": 84,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Kendilerine Kur’an okunduğu zaman saygıyla yere kapanmıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41340,
            "SureId": 84,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "İnkârcılar -tam aksine- gerçeği yalanlıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41347,
            "SureId": 84,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Oysa içlerinde gizlediklerini Allah çok iyi bilmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41354,
            "SureId": 84,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Onlara şiddetli bir cezaya çarptırılacaklarını bildir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41361,
            "SureId": 84,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "İman edip dünya ve âhiret için yararlı işler yapanlar başkadır; onlar için kesintisiz bir ödül vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41368,
            "SureId": 85,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Andolsun burçlarla dolu göğe,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 85,
                "MealInfo": "Mekke döneminde inmiştir. 22 âyettir. Sûre, adını birinci âyetteki “el-Bürûc”kelimesinden almıştır. Bürûc, burçlar demektir.",
                "SureNameTurkish": "Burûc",
                "SureNameArabic": "الْبُرُوجِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 27,
                "AyetCount": 22,
                "Cuz": 30,
                "FirstPage": 590,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 41375,
            "SureId": 85,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Vaad edilmiş güne,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41382,
            "SureId": 85,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Tanıklık edene ve edilene ki,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41389,
            "SureId": 85,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4-5",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "O çukurları, alev alev yanan ateş çukurlarını hazırlayanlar mahvolmuşlardır!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41396,
            "SureId": 85,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": false,
            "Page": 590,
            "AyetText": "O çukurları, alev alev yanan ateş çukurlarını hazırlayanlar mahvolmuşlardır!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41403,
            "SureId": 85,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6-7",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Hani o sırada ateşin başında oturmuşlar, inananlara yaptıklarını seyrediyorlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41410,
            "SureId": 85,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": false,
            "Page": 590,
            "AyetText": "Hani o sırada ateşin başında oturmuşlar, inananlara yaptıklarını seyrediyorlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41417,
            "SureId": 85,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8-9",
            "AyetVisible": true,
            "Page": 590,
            "AyetText": "Aziz, övgüye lâyık, göklerin ve yerin mâliki olan Allah’a inandıkları için, sırf bu sebeple onlara ağır işkence uyguladılar. Ama Allah her şeye şahittir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41424,
            "SureId": 85,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": false,
            "Page": 590,
            "AyetText": "Aziz, övgüye lâyık, göklerin ve yerin mâliki olan Allah’a inandıkları için, yalnızca bunun için müminlerden öç aldılar. Allah her şeye şahittir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 41431,
            "SureId": 85,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 590,
