    "QuranAyats": [
        {
            "Id": 14259,
            "SureId": 17,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "عَسٰى رَبُّكُمْ اَنْ یَرْحَمَكُمْۚ وَاِنْ عُدْتُمْ عُدْنَاۘ وَجَعَلْنَا جَهَنَّمَ لِلْكَافِرٖینَ حَصٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14266,
            "SureId": 17,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "اِنَّ هٰذَا الْقُرْاٰنَ یَهْدٖی لِلَّتٖی هِیَ اَقْوَمُ وَیُبَشِّرُ الْمُؤْمِنٖینَ الَّذٖینَ یَعْمَلُونَ الصَّالِحَاتِ اَنَّ لَهُمْ اَجْرًا كَبٖیرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14273,
            "SureId": 17,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "وَاَنَّ الَّذٖینَ لَا یُؤْمِنُونَ بِالْاٰخِرَةِ اَعْتَدْنَا لَهُمْ عَذَابًا اَلٖیمًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14280,
            "SureId": 17,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "وَیَدْعُ الْاِنْسَانُ بِالشَّرِّ دُعَٓاءَهُ بِالْخَیْرِؕ وَكَانَ الْاِنْسَانُ عَجُولًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14287,
            "SureId": 17,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "وَجَعَلْنَا الَّیْلَ وَالنَّهَارَ اٰیَتَیْنِ فَمَحَوْنَٓا اٰیَةَ الَّیْلِ وَجَعَلْنَٓا اٰیَةَ النَّهَارِ مُبْصِرَةً لِتَبْتَغُوا فَضْلًا مِنْ رَبِّكُمْ وَلِتَعْلَمُوا عَدَدَ السِّنٖینَ وَالْحِسَابَؕ وَكُلَّ شَیْءٍ فَصَّلْنَاهُ تَفْصٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14294,
            "SureId": 17,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "وَكُلَّ اِنْسَانٍ اَلْزَمْنَاهُ طَٓائِرَهُ فٖی عُنُقِهٖؕ وَنُخْرِجُ لَهُ یَوْمَ الْقِیٰمَةِ كِتَابًا یَلْقٰیهُ مَنْشُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14301,
            "SureId": 17,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "اِقْرَاْ كِتَابَكَؕ كَفٰى بِنَفْسِكَ الْیَوْمَ عَلَیْكَ حَسٖیبًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14308,
            "SureId": 17,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "مَنِ اهْتَدٰى فَاِنَّمَا یَهْتَدٖی لِنَفْسِهٖۚ وَمَنْ ضَلَّ فَاِنَّمَا یَضِلُّ عَلَیْهَاؕ وَلَا تَزِرُ وَازِرَةٌ وِزْرَ اُخْرٰىؕ وَمَا كُنَّا مُعَذِّبٖینَ حَتّٰى نَبْعَثَ رَسُولًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14315,
            "SureId": 17,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "وَاِذَٓا اَرَدْنَٓا اَنْ نُهْلِكَ قَرْیَةً اَمَرْنَا مُتْرَفٖیهَا فَفَسَقُوا فٖیهَا فَحَقَّ عَلَیْهَا الْقَوْلُ فَدَمَّرْنَاهَا تَدْمٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14322,
            "SureId": 17,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "وَكَمْ اَهْلَكْنَا مِنَ الْقُرُونِ مِنْ بَعْدِ نُوحٍؕ وَكَفٰى بِرَبِّكَ بِذُنُوبِ عِبَادِهٖ خَبٖیرًا بَصٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 14257,
            "SureId": 17,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "Umulur ki rabbiniz size acır. Ama eğer yine fesatçılığa dönerseniz biz de cezayı tekrarlarız. Biz cehennemi kâfirler için ebedî bir ceza yeri yaptık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14264,
            "SureId": 17,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "Kuşkusuz bu Kur’an en doğru olana iletir; dünya ve âhiret için yararlı işler yapan müminlere, kendileri için büyük bir mükâfat olduğunu müjdeler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14271,
            "SureId": 17,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "Âhirete inanmayanlara gelince, onlar için de ağır bir azap hazırladık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14278,
            "SureId": 17,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "İnsan, şerri de hayrı istediği gibi ister. İnsan pek acelecidir!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14285,
            "SureId": 17,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "Biz geceyi ve gündüzü birer nişan olarak yarattık. Nitekim rabbinizin nimetlerini arayasınız, ayrıca yılların sayısını ve hesabını bilesiniz diye gecenin nişanını siler, aydınlatıcı olarak gündüzün nişanını getiririz. İşte biz her şeyi açık açık anlattık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14292,
            "SureId": 17,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "Her insanın sorumluluğunu omuzuna yükledik. Kıyamet gününde insana, açılmış vaziyette önüne konulacak olan bir kitap çıkaracağız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14299,
            "SureId": 17,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "“Oku şimdi kitabını! Bugün kendini yargılamak üzere kendi nefsin yeter!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14306,
            "SureId": 17,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "Kim doğru yolu seçerse kendi iyiliği için seçmiştir, kim de saparsa kendi zararına sapmış olur. Hiç kimse başkasının günah yükünü üstüne almaz. Biz bir resul göndermedikçe azap da etmeyiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14313,
            "SureId": 17,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "Bir ülkeyi helâk etmek istediğimizde oranın şımarmış yöneticilerine (iyiye yönlendirici) emirler veririz; onlar ise orada günah işlemeye devam ederler, sonuçta o ülke helâke müstahak olur, biz de oranın altını üstüne getiririz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14320,
            "SureId": 17,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 283,
            "AyetText": "Nûh’tan sonraki nesillerden nicelerini helâk ettik. Kullarının günahlarını bilip görmede rabbin yeterlidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "İsrâ",
    "QuranSureLabel": "الْاِسْرَاۤءِ",
    "EndPageSure": null
}