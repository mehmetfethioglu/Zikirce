    "QuranAyats": [
        {
            "Id": 37506,
            "SureId": 69,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "فَلَیْسَ لَهُ الْیَوْمَ هٰهُنَا حَمٖیمٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 69,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. Sûre, adını birinci âyeti oluşturan“el-Hâkka” kelimesinden almıştır. Hâkka, mutlaka gerçekleşecek olan kıyametdemektir. Sûrede başlıca, Kıyameti inkâr edenlerin görecekleri cezalarve mü’minler ile kâfirlerin dehşetli Kıyamet günündeki hâlleri konu edilmektedir.",
                "SureNameTurkish": "Hâkka",
                "SureNameArabic": "الْحَاقَّةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 78,
                "AyetCount": 52,
                "Cuz": 29,
                "FirstPage": 566,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37513,
            "SureId": 69,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "وَلَا طَعَامٌ اِلَّا مِنْ غِسْلٖینٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37520,
            "SureId": 69,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "لَا یَاْكُلُهُٓ اِلَّا الْخَاطِؤُ𐻿نَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37527,
            "SureId": 69,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "فَلَٓا اُقْسِمُ بِمَا تُبْصِرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37534,
            "SureId": 69,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "وَمَا لَا تُبْصِرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37541,
            "SureId": 69,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "اِنَّهُ لَقَوْلُ رَسُولٍ كَرٖیمٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37548,
            "SureId": 69,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "وَمَا هُوَ بِقَوْلِ شَاعِرٍؕ قَلٖیلًا مَا تُؤْمِنُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37555,
            "SureId": 69,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "وَلَا بِقَوْلِ كَاهِنٍؕ قَلٖیلًا مَا تَذَكَّرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37562,
            "SureId": 69,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "تَنْزٖیلٌ مِنْ رَبِّ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37569,
            "SureId": 69,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "وَلَوْ تَقَوَّلَ عَلَیْنَا بَعْضَ الْاَقَاوٖیلِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37576,
            "SureId": 69,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "لَاَخَذْنَا مِنْهُ بِالْیَمٖینِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37583,
            "SureId": 69,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "ثُمَّ لَقَطَعْنَا مِنْهُ الْوَتٖینَؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37590,
            "SureId": 69,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "فَمَا مِنْكُمْ مِنْ اَحَدٍ عَنْهُ حَاجِزٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37597,
            "SureId": 69,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "وَاِنَّهُ لَتَذْكِرَةٌ لِلْمُتَّقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37604,
            "SureId": 69,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "وَاِنَّا لَنَعْلَمُ اَنَّ مِنْكُمْ مُكَذِّبٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37611,
            "SureId": 69,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "وَاِنَّهُ لَحَسْرَةٌ عَلَى الْكَافِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37618,
            "SureId": 69,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "وَاِنَّهُ لَحَقُّ الْیَقٖینِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37625,
            "SureId": 69,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37632,
            "SureId": 70,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "سَاَلَ سَٓائِلٌ بِعَذَابٍ وَاقِعٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 70,
                "MealInfo": "Mekke döneminde inmiştir. 44 âyettir. Sûre, adını üçüncü âyetteki “elMe’âric”kelimesinden almıştır. Me’âric, yükselme yolları demektir. Sûredebaşlıca, Mekke müşriklerinin inkâr, inat ve azgınlıkları, insan tabiatının bazıyönleri, ölüm ötesi hayatın gerçekliği konu edilmektedir",
                "SureNameTurkish": "Meâric",
                "SureNameArabic": "الْمَعَارِجِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 79,
                "AyetCount": 44,
                "Cuz": 29,
                "FirstPage": 568,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37639,
            "SureId": 70,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "لِلْكَافِرٖینَ لَیْسَ لَهُ دَافِعٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37646,
            "SureId": 70,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "مِنَ اللّٰهِ ذِی الْمَعَارِجِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37653,
            "SureId": 70,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "تَعْرُجُ الْمَلٰٓئِكَةُ وَالرُّوحُ اِلَیْهِ فٖی یَوْمٍ كَانَ مِقْدَارُهُ خَمْسٖینَ اَلْفَ سَنَةٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37660,
            "SureId": 70,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "فَاصْبِرْ صَبْرًا جَمٖیلًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37667,
            "SureId": 70,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "اِنَّهُمْ یَرَوْنَهُ بَعٖیدًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37674,
            "SureId": 70,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "وَنَرٰیهُ قَرٖیبًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37681,
            "SureId": 70,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "یَوْمَ تَكُونُ السَّمَٓاءُ كَالْمُهْلِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37688,
            "SureId": 70,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "وَتَكُونُ الْجِبَالُ كَالْعِهْنِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37695,
            "SureId": 70,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "وَلَا یَسْـَٔلُ حَمٖیمٌ حَمٖیمًاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 37504,
            "SureId": 69,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "Bu sebeple bugün burada onun candan bir dostu yoktur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 69,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. Sûre, adını birinci âyeti oluşturan“el-Hâkka” kelimesinden almıştır. Hâkka, mutlaka gerçekleşecek olan kıyametdemektir. Sûrede başlıca, Kıyameti inkâr edenlerin görecekleri cezalarve mü’minler ile kâfirlerin dehşetli Kıyamet günündeki hâlleri konu edilmektedir.",
                "SureNameTurkish": "Hâkka",
                "SureNameArabic": "الْحَاقَّةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 78,
                "AyetCount": 52,
                "Cuz": 29,
                "FirstPage": 566,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37511,
            "SureId": 69,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "Yananların akıntısından başka yiyeceği de yoktur!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37518,
            "SureId": 69,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "Onu da günahkârlardan başkası yemez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37525,
            "SureId": 69,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38-39",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "Görebildikleriniz ve göremedikleriniz üzerine yemin ederim ki,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37532,
            "SureId": 69,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": false,
            "Page": 568,
            "AyetText": "Görebildikleriniz ve göremedikleriniz üzerine yemin ederim ki,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37539,
            "SureId": 69,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "Kur’an elbette değerli bir elçinin sözüdür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37546,
            "SureId": 69,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "O bir şair sözü değildir. Ne de az inanıyorsunuz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37553,
            "SureId": 69,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "O bir kâhin sözü de değildir. Ne de az düşünüyorsunuz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37560,
            "SureId": 69,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "O, âlemlerin rabbi tarafından indirilmiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37567,
            "SureId": 69,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "Eğer peygamber bize atfen bazı sözler uydurmuş olsaydı,",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37574,
            "SureId": 69,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "Elbette onu kıskıvrak yakalardık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37581,
            "SureId": 69,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "Sonra onun can damarını koparırdık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37588,
            "SureId": 69,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "Hiçbiriniz buna mâni olamazdınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37595,
            "SureId": 69,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "Doğrusu Kur’an, takvâ sahipleri için bir öğüttür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37602,
            "SureId": 69,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "İçinizde onu yalan sayanlar bulunduğunu şüphesiz bilmekteyiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37609,
            "SureId": 69,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "Muhakkak o, kâfirler için de derin bir pişmanlık sebebidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37616,
            "SureId": 69,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "O, gerçekten kesin bilginin kendisidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37623,
            "SureId": 69,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 568,
            "AyetText": "Şu halde ulu rabbinin adını noksanlıklardan tenzih et!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37630,
            "SureId": 70,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1-3",
            "AyetVisible": true,
            "Page": 568,
