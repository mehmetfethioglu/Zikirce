    "ArPageNo": "٥۸۷",
    "QuranAyats": [
        {
            "Id": 40747,
            "SureId": 81,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "مُطَاعٍ ثَمَّ اَمٖینٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 81,
                "MealInfo": "Mekke döneminde inmiştir. 29 âyettir. Sûre, adını birinci âyette geçen “küvviret”fiilinin mastarından almıştır. Tekvîr, dürmek demektir. Sûrede başlıca, kıyamet, vahiy ve peygamberlik konuları ele alınmaktadır.",
                "SureNameTurkish": "Tekvîr",
                "SureNameArabic": "التَّكْو۪يرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 7,
                "AyetCount": 29,
                "Cuz": 30,
                "FirstPage": 586,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 40754,
            "SureId": 81,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "وَمَا صَاحِبُكُمْ بِمَجْنُونٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40761,
            "SureId": 81,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "وَلَقَدْ رَاٰهُ بِالْاُفُقِ الْمُبٖینِۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40768,
            "SureId": 81,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "وَمَا هُوَ عَلَى الْغَیْبِ بِضَنٖینٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40775,
            "SureId": 81,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "وَمَا هُوَ بِقَوْلِ شَیْطَانٍ رَجٖیمٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40782,
            "SureId": 81,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "فَاَیْنَ تَذْهَبُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40789,
            "SureId": 81,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "اِنْ هُوَ اِلَّا ذِكْرٌ لِلْعَالَمٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40796,
            "SureId": 81,
            "AyetId": 28,
            "LanguageId": 7,
            "AyetNumber": "٢٨",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "لِمَنْ شَٓاءَ مِنْكُمْ اَنْ یَسْتَقٖیمَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40803,
            "SureId": 81,
            "AyetId": 29,
            "LanguageId": 7,
            "AyetNumber": "٢٩",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "وَمَا تَشَٓاؤُ𐻿نَ اِلَّٓا اَنْ یَشَٓاءَ اللّٰهُ رَبُّ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40810,
            "SureId": 82,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "اِذَا السَّمَٓاءُ انْفَطَرَتْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 82,
                "MealInfo": "Mekke döneminde inmiştir. 19 âyettir. Sûre, adını birinci âyetteki “infetarat”fiilinin mastarından almıştır. İnfitâr, yarılmak demektir.",
                "SureNameTurkish": "İnfitâr",
                "SureNameArabic": "الْاِنْفِطَارِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 82,
                "AyetCount": 19,
                "Cuz": 30,
                "FirstPage": 587,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 40817,
            "SureId": 82,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "وَاِذَا الْكَوَاكِبُ انْتَثَرَتْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40824,
            "SureId": 82,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "وَاِذَا الْبِحَارُ فُجِّرَتْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40831,
            "SureId": 82,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "وَاِذَا الْقُبُورُ بُعْثِرَتْۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40838,
            "SureId": 82,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "عَلِمَتْ نَفْسٌ مَا قَدَّمَتْ وَاَخَّرَتْؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40845,
            "SureId": 82,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "یَٓا اَیُّهَا الْاِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرٖیمِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40852,
            "SureId": 82,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "اَلَّذٖی خَلَقَكَ فَسَوّٰیكَ فَعَدَلَكَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40859,
            "SureId": 82,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "فٖٓی اَیِّ صُورَةٍ مَا شَٓاءَ رَكَّبَكَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40866,
            "SureId": 82,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "كَلَّا بَلْ تُكَذِّبُونَ بِالدّٖینِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40873,
            "SureId": 82,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "وَاِنَّ عَلَیْكُمْ لَحَافِظٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40880,
            "SureId": 82,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "كِرَامًا كَاتِبٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40887,
            "SureId": 82,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "یَعْلَمُونَ مَا تَفْعَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40894,
            "SureId": 82,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "اِنَّ الْاَبْرَارَ لَفٖی نَعٖیمٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40901,
            "SureId": 82,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "وَاِنَّ الْفُجَّارَ لَفٖی جَحٖیمٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40908,
            "SureId": 82,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "یَصْلَوْنَهَا یَوْمَ الدّٖینِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40915,
            "SureId": 82,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "وَمَا هُمْ عَنْهَا بِغَٓائِبٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40922,
            "SureId": 82,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "وَمَٓا اَدْرٰیكَ مَا یَوْمُ الدّٖینِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40929,
            "SureId": 82,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "ثُمَّ مَٓا اَدْرٰیكَ مَا یَوْمُ الدّٖینِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40936,
            "SureId": 82,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "یَوْمَ لَا تَمْلِكُ نَفْسٌ لِنَفْسٍ شَیْـًٔاؕ وَالْاَمْرُ یَوْمَئِذٍ لِلّٰهِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 40745,
            "SureId": 81,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "(Elçi) orada saygın ve güvenilirdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 81,
                "MealInfo": "Mekke döneminde inmiştir. 29 âyettir. Sûre, adını birinci âyette geçen “küvviret”fiilinin mastarından almıştır. Tekvîr, dürmek demektir. Sûrede başlıca, kıyamet, vahiy ve peygamberlik konuları ele alınmaktadır.",
                "SureNameTurkish": "Tekvîr",
                "SureNameArabic": "التَّكْو۪يرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 7,
                "AyetCount": 29,
                "Cuz": 30,
                "FirstPage": 586,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 40752,
            "SureId": 81,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Bu kadar beraber yaşadığınız kişi kesinlikle mecnun değildir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40759,
            "SureId": 81,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Andolsun ki onu (vahiy meleğini) apaçık ufukta görmüştür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40766,
            "SureId": 81,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "O, gayba ait bilgileri sizden esirgemez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40773,
            "SureId": 81,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "O, lânetlenmiş şeytanın sözü değildir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40780,
            "SureId": 81,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Öyleyse nereye gidiyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40787,
            "SureId": 81,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "O herkes için bir öğüttür;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40794,
            "SureId": 81,
            "AyetId": 28,
            "LanguageId": 5,
            "AyetNumber": "28",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Özellikle sizden doğru yolda gitmek isteyenler için.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40801,
            "SureId": 81,
            "AyetId": 29,
            "LanguageId": 5,
            "AyetNumber": "29",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Fakat âlemlerin rabbi Allah dilemedikçe siz (hiçbir şey) dileyemezsiniz!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40808,
            "SureId": 82,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Gökyüzü yarıldığında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 82,
                "MealInfo": "Mekke döneminde inmiştir. 19 âyettir. Sûre, adını birinci âyetteki “infetarat”fiilinin mastarından almıştır. İnfitâr, yarılmak demektir.",
                "SureNameTurkish": "İnfitâr",
                "SureNameArabic": "الْاِنْفِطَارِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 82,
                "AyetCount": 19,
                "Cuz": 30,
                "FirstPage": 587,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 40815,
            "SureId": 82,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Yıldızlar dağılıp saçıldığında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40822,
            "SureId": 82,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Denizler taştığında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40829,
            "SureId": 82,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Kabirlerin altı üstüne getirildiğinde;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40836,
            "SureId": 82,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Her insan dünyada neleri yaptığını, neleri de yapmadığını anlayacaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40843,
            "SureId": 82,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Ey insan! Yüce rabbin hakkında seni yanıltıp aldatan ne oldu?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40850,
            "SureId": 82,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "O rabbin ki seni yarattı, seni insan olarak şekillendirdi ve seni dengeledi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40857,
            "SureId": 82,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Terkibini de dilediği gibi yaptı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40864,
            "SureId": 82,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Hayır! İnanacak yerde siz hâlâ dini yalan sayıyorsunuz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40871,
            "SureId": 82,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10-11",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Oysa sizi gözetleyen muhafızlar, değerli yazıcılar var.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40878,
            "SureId": 82,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": false,
            "Page": 587,
            "AyetText": "Oysa sizi gözetleyen muhafızlar, değerli yazıcılar var.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40885,
            "SureId": 82,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Onlar yaptığınız her şeyi biliyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40892,
            "SureId": 82,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Buna göre kuşkusuz erdemliler cennette olacaklar;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40899,
            "SureId": 82,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Kötüler ise kesinlikle cehenneme gireceklerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40906,
            "SureId": 82,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Ceza gününde oraya girerler;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40913,
            "SureId": 82,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Ve oradan bir daha da ayrılamazlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40920,
            "SureId": 82,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Ceza günü nedir bilir misin?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40927,
            "SureId": 82,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "Evet, ceza günü nedir bilir misin?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 40934,
            "SureId": 82,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 587,
            "AyetText": "O gün hiç kimsenin başkası için bir şey yapması elinden gelmez. O gün hüküm yalnız Allah’ındır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
