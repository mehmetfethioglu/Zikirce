{
    "PointerList": null,
    "CuzNo": 23,
    "PageNo": 443,
    "ArCuzNo": "۲۳",
    "ArPageNo": "٤٤۳",
    "QuranAyats": [
        {
            "Id": 26222,
            "SureId": 36,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "وَاٰیَةٌ لَهُمْ اَنَّا حَمَلْنَا ذُرِّیَّتَهُمْ فِی الْفُلْكِ الْمَشْحُونِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 36,
                "MealInfo": "Mekke döneminde inmiştir. 83 âyettir. Sûre, adını ilk âyeti oluşturan <b>“Yâ-S</b>în” harflerinden almıştır. Sûrede başlıca i<b>nsanın ahlâkî sorumlulukları, vahiy, Hz. Peygamber’i yalanlayan Kureyş kabilesi, Antakya halkına gönderilen peygamberler, Allah’ın birliğini ve kudretini gösteren deliller, öldükten sonra dirilme,hesap ve ceza konu </b>edilmektedir.",
                "SureNameTurkish": "Yâsîn",
                "SureNameArabic": "يٰسۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 41,
                "AyetCount": 83,
                "Cuz": 22,
                "FirstPage": 440,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26229,
            "SureId": 36,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "وَخَلَقْنَا لَهُمْ مِنْ مِثْلِهٖ مَا یَرْكَبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26236,
            "SureId": 36,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "وَاِنْ نَشَاْ نُغْرِقْهُمْ فَلَا صَرٖیخَ لَهُمْ وَلَا هُمْ یُنْقَذُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26243,
            "SureId": 36,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "اِلَّا رَحْمَةً مِنَّا وَمَتَاعًا اِلٰى حٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26250,
            "SureId": 36,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "وَاِذَا قٖیلَ لَهُمُ اتَّقُوا مَا بَیْنَ اَیْدٖیكُمْ وَمَا خَلْفَكُمْ لَعَلَّكُمْ تُرْحَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26257,
            "SureId": 36,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "وَمَا تَاْتٖیهِمْ مِنْ اٰیَةٍ مِنْ اٰیَاتِ رَبِّهِمْ اِلَّا كَانُوا عَنْهَا مُعْرِضٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26264,
            "SureId": 36,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "وَاِذَا قٖیلَ لَهُمْ اَنْفِقُوا مِمَّا رَزَقَكُمُ اللّٰهُۙ قَالَ الَّذٖینَ كَفَرُوا لِلَّذٖینَ اٰمَنُٓوا اَنُطْعِمُ مَنْ لَوْ یَشَٓاءُ اللّٰهُ اَطْعَمَهُࣗ اِنْ اَنْتُمْ اِلَّا فٖی ضَلَالٍ مُبٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26271,
            "SureId": 36,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "وَیَقُولُونَ مَتٰى هٰذَا الْوَعْدُ اِنْ كُنْتُمْ صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26278,
            "SureId": 36,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "مَا یَنْظُرُونَ اِلَّا صَیْحَةً وَاحِدَةً تَاْخُذُهُمْ وَهُمْ یَخِصِّمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26285,
            "SureId": 36,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "فَلَا یَسْتَطٖیعُونَ تَوْصِیَةً وَلَٓا اِلٰٓى اَهْلِهِمْ یَرْجِعُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26292,
            "SureId": 36,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "وَنُفِـخَ فِی الصُّورِ فَاِذَا هُمْ مِنَ الْاَجْدَاثِ اِلٰى رَبِّهِمْ یَنْسِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26299,
            "SureId": 36,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "قَالُوا یَا وَیْلَنَا مَنْ بَعَثَنَا مِنْ مَرْقَدِنَا𐻽ۘ هٰذَا مَا وَعَدَ الرَّحْمٰنُ وَصَدَقَ الْمُرْسَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26306,
            "SureId": 36,
            "AyetId": 53,
            "LanguageId": 7,
            "AyetNumber": "٥٣",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "اِنْ كَانَتْ اِلَّا صَیْحَةً وَاحِدَةً فَاِذَا هُمْ جَمٖیعٌ لَدَیْنَا مُحْضَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26313,
            "SureId": 36,
            "AyetId": 54,
            "LanguageId": 7,
            "AyetNumber": "٥٤",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "فَالْیَوْمَ لَا تُظْلَمُ نَفْسٌ شَیْـًٔا وَلَا تُجْزَوْنَ اِلَّا مَا كُنْتُمْ تَعْمَلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 26220,
            "SureId": 36,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41-42",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "Onları ve nesillerini yüklü gemide taşımamız ve binecekleri benzer araçlar yaratmamız da kendileri için açık bir kanıttır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 36,
                "MealInfo": "Mekke döneminde inmiştir. 83 âyettir. Sûre, adını ilk âyeti oluşturan <b>“Yâ-S</b>în” harflerinden almıştır. Sûrede başlıca i<b>nsanın ahlâkî sorumlulukları, vahiy, Hz. Peygamber’i yalanlayan Kureyş kabilesi, Antakya halkına gönderilen peygamberler, Allah’ın birliğini ve kudretini gösteren deliller, öldükten sonra dirilme,hesap ve ceza konu </b>edilmektedir.",
                "SureNameTurkish": "Yâsîn",
                "SureNameArabic": "يٰسۤ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 41,
                "AyetCount": 83,
                "Cuz": 22,
                "FirstPage": 440,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26227,
            "SureId": 36,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": false,
            "Page": 443,
            "AyetText": "Onları ve nesillerini yüklü gemide taşımamız ve binecekleri benzer araçlar yaratmamız da kendileri için açık bir kanıttır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26234,
            "SureId": 36,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "Dilesek onları suda boğarız, kimse de onların yardımına koşamaz ve artık ­kurtarılamazlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26241,
            "SureId": 36,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "Ama tarafımızdan bir rahmet ve belli zamana kadar faydalanma fırsatı vermemiz başkadır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26248,
            "SureId": 36,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "Onlara “Önünüzdekinden ve arkanızdakinden sakının ki rahmet göresiniz” dendiğinde (aldırış etmezler).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26255,
            "SureId": 36,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "Onlara rablerinin âyetlerinden bir âyet gelmeyedursun, illâ da ondan yüz çevirirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26262,
            "SureId": 36,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "Onlara, “Allah’ın size verdiği rızıktan başkaları için de harcayın” dendiğinde, inkârcılar müminlere derler ki: “Dilese Allah’ın doyuracağı kimseleri biz mi besleyeceğiz! Doğrusu siz açık bir yanılgı içindesiniz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26269,
            "SureId": 36,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "Ve şöyle derler: “Şayet gerçekten doğru söylüyorsanız, bu tehdit hani ne zaman gerçekleşecek?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26276,
            "SureId": 36,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "Onlar, besbelli ki, birbirleriyle uğraşırken kendilerini ansızın yakalayacak korkunç bir sesi bekliyorlar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26283,
            "SureId": 36,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "İşte o anda onlar ne bir vasiyette bulunabilecekler ne de ailelerine dönebilecekler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26290,
            "SureId": 36,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "Sûra üflenmiştir. Artık onlar kabirlerinden kalkıp rablerine doğru koşmaktadırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26297,
            "SureId": 36,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "Derler ki: “Vay başımıza gelenler! Bizi yattığımız yerden kim diriltip kaldırdı? Rahmânın vaad ettiği işte bu! Peygamberler gerçekten doğru söylemişler!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26304,
            "SureId": 36,
            "AyetId": 53,
            "LanguageId": 5,
            "AyetNumber": "53",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "Olup biten yalnızca bir ses! Ama ardından onların tamamı, birden toplanmış olarak işte huzurumuzdalar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26311,
            "SureId": 36,
            "AyetId": 54,
            "LanguageId": 5,
            "AyetNumber": "54",
            "AyetVisible": true,
            "Page": 443,
            "AyetText": "Bugün hiç kimse en küçük bir haksızlığa uğratılmaz. Sadece yapıp ettiklerinizin karşılığını görürsünüz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Yâsîn",
    "QuranSureLabel": "يٰسۤ",
    "EndPageSure": null
}