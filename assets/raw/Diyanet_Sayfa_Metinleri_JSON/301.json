    "QuranAyats": [
        {
            "Id": 15414,
            "SureId": 18,
            "AyetId": 62,
            "LanguageId": 7,
            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 301,
            "AyetText": "فَلَمَّا جَاوَزَا قَالَ لِفَتٰیهُ اٰتِنَا غَدَٓاءَنَاؗ لَقَدْ لَقٖینَا مِنْ سَفَرِنَا هٰذَا نَصَبًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 18,
                "MealInfo": "Mekke döneminde inmiştir. 28. âyetin Medine döneminde indiği de rivayet edilmiştir. 110 âyettir. Sûre, adını; ilk defa dokuzuncu âyette olmak üzere,birkaç yerde geçen <b>“kehf ”</b> kelimesinden almıştır.<b> Kehf, mağara demektir</b>. Sûre de temel konu olarak, inançları sebebiyle öldürülmekten kurtulmak için bir mağaraya sığınan gençlerin mucizevî hâlleri, ayrıca <b>Hz. Mûsâ</b> ile <b>Zülkarneyn&nbsp;</b>konu edilmektedir.",
                "SureNameTurkish": "Kehf",
                "SureNameArabic": "الْكَهْفِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 69,
                "AyetCount": 110,
                "Cuz": 15,
                "FirstPage": 293,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 15421,
            "SureId": 18,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 301,
            "AyetText": "قَالَ اَرَاَیْتَ اِذْ اَوَیْنَٓا اِلَى الصَّخْرَةِ فَاِنّٖی نَسٖیتُ الْحُوتَؗ وَمَٓا اَنْسَانٖیهُ اِلَّا الشَّیْطَانُ اَنْ اَذْكُرَهُۚ وَاتَّخَذَ سَبٖیلَهُ فِی الْبَحْرِࣗ عَجَبًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15428,
            "SureId": 18,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 301,
            "AyetText": "قَالَ ذٰلِكَ مَا كُنَّا نَبْغِࣗ فَارْتَدَّا عَلٰٓى اٰثَارِهِمَا قَصَصًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15435,
            "SureId": 18,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 301,
            "AyetText": "فَوَجَدَا عَبْدًا مِنْ عِبَادِنَٓا اٰتَیْنَاهُ رَحْمَةً مِنْ عِنْدِنَا وَعَلَّمْنَاهُ مِنْ لَدُنَّا عِلْمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15442,
            "SureId": 18,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 301,
            "AyetText": "قَالَ لَهُ مُوسٰى هَلْ اَتَّبِعُكَ عَلٰٓى اَنْ تُعَلِّمَنِ مِمَّا عُلِّمْتَ رُشْدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15449,
            "SureId": 18,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 301,
            "AyetText": "قَالَ اِنَّكَ لَنْ تَسْتَطٖیعَ مَعِیَ صَبْرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15456,
            "SureId": 18,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 301,
            "AyetText": "وَكَیْفَ تَصْبِرُ عَلٰى مَا لَمْ تُحِطْ بِهٖ خُبْرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15463,
            "SureId": 18,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 301,
            "AyetText": "قَالَ سَتَجِدُنٖٓی اِنْ شَٓاءَ اللّٰهُ صَابِرًا وَلَٓا اَعْصٖی لَكَ اَمْرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15470,
            "SureId": 18,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 301,
            "AyetText": "قَالَ فَاِنِ اتَّبَعْتَنٖی فَلَا تَسْـَٔلْنٖی عَنْ شَیْءٍ حَتّٰٓى اُحْدِثَ لَكَ مِنْهُ ذِكْرًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15477,
            "SureId": 18,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 301,
            "AyetText": "فَانْطَلَقَاࣞ حَتّٰٓى اِذَا رَكِبَا فِی السَّفٖینَةِ خَرَقَهَاؕ قَالَ اَخَرَقْتَهَا لِتُغْرِقَ اَهْلَهَاۚ لَقَدْ جِئْتَ شَیْـًٔا اِمْرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15484,
            "SureId": 18,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 301,
            "AyetText": "قَالَ اَلَمْ اَقُلْ اِنَّكَ لَنْ تَسْتَطٖیعَ مَعِیَ صَبْرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15491,
            "SureId": 18,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 301,
            "AyetText": "قَالَ لَا تُؤَاخِذْنٖی بِمَا نَسٖیتُ وَلَا تُرْهِقْنٖی مِنْ اَمْرٖی عُسْرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 15498,
            "SureId": 18,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 301,
            "AyetText": "فَانْطَلَقَاࣞ حَتّٰٓى اِذَا لَقِیَا غُلَامًا فَقَتَلَهُۙ قَالَ اَقَتَلْتَ نَفْسًا زَكِیَّةً بِغَیْرِ نَفْسٍؕ لَقَدْ جِئْتَ شَیْـًٔا نُكْرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
