{
    "PointerList": null,
    "CuzNo": 23,
    "PageNo": 452,
    "ArCuzNo": "۲۳",
    "ArPageNo": "٤٥۲",
    "QuranAyats": [
        {
            "Id": 27594,
            "SureId": 37,
            "AyetId": 154,
            "LanguageId": 7,
            "AyetNumber": "١٥٤",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "مَا لَكُمْࣞ كَیْفَ تَحْكُمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 37,
                "MealInfo": "Mekke döneminde inmiştir. 182 âyettir. Sûre, adını ilk âyette geçen <b>“es-Sâffât” </b>kelimesinden almıştır.<b> Sâffât, sıra sıra dizilenler, saf saf duranlar demektir</b>. Sûrede başlıca, <b>meleklerden, cinlerden, kıyamet ve ahiret olaylarından söz edilmekte; Nûh, İbrahim, İsmail, İshak, Mûsâ, Hârun, İlyas, Lût ve Yûnus Peygamberlerin kıssaları</b>na yer verilmektedir.",
                "SureNameTurkish": "Sâffât",
                "SureNameArabic": "الصَّاۤفَّاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 56,
                "AyetCount": 182,
                "Cuz": 23,
                "FirstPage": 446,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 27601,
            "SureId": 37,
            "AyetId": 155,
            "LanguageId": 7,
            "AyetNumber": "١٥٥",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "اَفَلَا تَذَكَّرُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27608,
            "SureId": 37,
            "AyetId": 156,
            "LanguageId": 7,
            "AyetNumber": "١٥٦",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "اَمْ لَكُمْ سُلْطَانٌ مُبٖینٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27615,
            "SureId": 37,
            "AyetId": 157,
            "LanguageId": 7,
            "AyetNumber": "١٥٧",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "فَاْتُوا بِكِتَابِكُمْ اِنْ كُنْتُمْ صَادِقٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27622,
            "SureId": 37,
            "AyetId": 158,
            "LanguageId": 7,
            "AyetNumber": "١٥٨",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "وَجَعَلُوا بَیْنَهُ وَبَیْنَ الْجِنَّةِ نَسَبًاؕ وَلَقَدْ عَلِمَتِ الْجِنَّةُ اِنَّهُمْ لَمُحْضَرُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27629,
            "SureId": 37,
            "AyetId": 159,
            "LanguageId": 7,
            "AyetNumber": "١٥٩",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "سُبْحَانَ اللّٰهِ عَمَّا یَصِفُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27636,
            "SureId": 37,
            "AyetId": 160,
            "LanguageId": 7,
            "AyetNumber": "١٦٠",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "اِلَّا عِبَادَ اللّٰهِ الْمُخْلَصٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27643,
            "SureId": 37,
            "AyetId": 161,
            "LanguageId": 7,
            "AyetNumber": "١٦١",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "فَاِنَّكُمْ وَمَا تَعْبُدُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27650,
            "SureId": 37,
            "AyetId": 162,
            "LanguageId": 7,
            "AyetNumber": "١٦٢",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "مَٓا اَنْتُمْ عَلَیْهِ بِفَاتِنٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27657,
            "SureId": 37,
            "AyetId": 163,
            "LanguageId": 7,
            "AyetNumber": "١٦٣",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "اِلَّا مَنْ هُوَ صَالِ الْجَحٖیمِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27664,
            "SureId": 37,
            "AyetId": 164,
            "LanguageId": 7,
            "AyetNumber": "١٦٤",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "وَمَا مِنَّٓا اِلَّا لَهُ مَقَامٌ مَعْلُومٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27671,
            "SureId": 37,
            "AyetId": 165,
            "LanguageId": 7,
            "AyetNumber": "١٦٥",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "وَاِنَّا لَنَحْنُ الصَّٓافُّونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27678,
            "SureId": 37,
            "AyetId": 166,
            "LanguageId": 7,
            "AyetNumber": "١٦٦",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "وَاِنَّا لَنَحْنُ الْمُسَبِّحُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27685,
            "SureId": 37,
            "AyetId": 167,
            "LanguageId": 7,
            "AyetNumber": "١٦٧",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "وَاِنْ كَانُوا لَیَقُولُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27692,
            "SureId": 37,
            "AyetId": 168,
            "LanguageId": 7,
            "AyetNumber": "١٦٨",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "لَوْ اَنَّ عِنْدَنَا ذِكْرًا مِنَ الْاَوَّلٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27699,
            "SureId": 37,
            "AyetId": 169,
            "LanguageId": 7,
            "AyetNumber": "١٦٩",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "لَكُنَّا عِبَادَ اللّٰهِ الْمُخْلَصٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27706,
            "SureId": 37,
            "AyetId": 170,
            "LanguageId": 7,
            "AyetNumber": "١٧٠",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "فَكَفَرُوا بِهٖۚ فَسَوْفَ یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27713,
            "SureId": 37,
            "AyetId": 171,
            "LanguageId": 7,
            "AyetNumber": "١٧١",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا الْمُرْسَلٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27720,
            "SureId": 37,
            "AyetId": 172,
            "LanguageId": 7,
            "AyetNumber": "١٧٢",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "اِنَّهُمْ لَهُمُ الْمَنْصُورُونَࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27727,
            "SureId": 37,
            "AyetId": 173,
            "LanguageId": 7,
            "AyetNumber": "١٧٣",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "وَاِنَّ جُنْدَنَا لَهُمُ الْغَالِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27734,
            "SureId": 37,
            "AyetId": 174,
            "LanguageId": 7,
            "AyetNumber": "١٧٤",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "فَتَوَلَّ عَنْهُمْ حَتّٰى حٖینٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27741,
            "SureId": 37,
            "AyetId": 175,
            "LanguageId": 7,
            "AyetNumber": "١٧٥",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "وَاَبْصِرْهُمْ فَسَوْفَ یُبْصِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27748,
            "SureId": 37,
            "AyetId": 176,
            "LanguageId": 7,
            "AyetNumber": "١٧٦",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "اَفَبِعَذَابِنَا یَسْتَعْجِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27755,
            "SureId": 37,
            "AyetId": 177,
            "LanguageId": 7,
            "AyetNumber": "١٧٧",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "فَاِذَا نَزَلَ بِسَاحَتِهِمْ فَسَٓاءَ صَبَاحُ الْمُنْذَرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27762,
            "SureId": 37,
            "AyetId": 178,
            "LanguageId": 7,
            "AyetNumber": "١٧٨",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "وَتَوَلَّ عَنْهُمْ حَتّٰى حٖینٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27769,
            "SureId": 37,
            "AyetId": 179,
            "LanguageId": 7,
            "AyetNumber": "١٧٩",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "وَاَبْصِرْ فَسَوْفَ یُبْصِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27776,
            "SureId": 37,
            "AyetId": 180,
            "LanguageId": 7,
            "AyetNumber": "١٨٠",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا یَصِفُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27783,
            "SureId": 37,
            "AyetId": 181,
            "LanguageId": 7,
            "AyetNumber": "١٨١",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "وَسَلَامٌ عَلَى الْمُرْسَلٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27790,
            "SureId": 37,
            "AyetId": 182,
            "LanguageId": 7,
            "AyetNumber": "١٨٢",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "وَالْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 27592,
            "SureId": 37,
            "AyetId": 154,
            "LanguageId": 5,
            "AyetNumber": "154",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Ne oluyor size? Nasıl yargıda bulunuyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 37,
                "MealInfo": "Mekke döneminde inmiştir. 182 âyettir. Sûre, adını ilk âyette geçen <b>“es-Sâffât” </b>kelimesinden almıştır.<b> Sâffât, sıra sıra dizilenler, saf saf duranlar demektir</b>. Sûrede başlıca, <b>meleklerden, cinlerden, kıyamet ve ahiret olaylarından söz edilmekte; Nûh, İbrahim, İsmail, İshak, Mûsâ, Hârun, İlyas, Lût ve Yûnus Peygamberlerin kıssaları</b>na yer verilmektedir.",
                "SureNameTurkish": "Sâffât",
                "SureNameArabic": "الصَّاۤفَّاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 56,
                "AyetCount": 182,
                "Cuz": 23,
                "FirstPage": 446,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 27599,
            "SureId": 37,
            "AyetId": 155,
            "LanguageId": 5,
            "AyetNumber": "155",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Hiç düşünmüyor musunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27606,
            "SureId": 37,
            "AyetId": 156,
            "LanguageId": 5,
            "AyetNumber": "156",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Yoksa açık bir kanıtınız mı var?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27613,
            "SureId": 37,
            "AyetId": 157,
            "LanguageId": 5,
            "AyetNumber": "157",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Eğer gerçekten doğru sözlü iseniz belgenizi getirin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27620,
            "SureId": 37,
            "AyetId": 158,
            "LanguageId": 5,
            "AyetNumber": "158",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Onlar Allah ile görülmez varlık türleri arasında da bir soy birliği yakıştırdılar. Oysa bu varlıklar iyi biliyorlar ki kendileri de mutlaka hesap yerine götürüleceklerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27627,
            "SureId": 37,
            "AyetId": 159,
            "LanguageId": 5,
            "AyetNumber": "159",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Allah, onların isnat ettikleri niteliklerden uzaktır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27634,
            "SureId": 37,
            "AyetId": 160,
            "LanguageId": 5,
            "AyetNumber": "160",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Allah’ın samimi kulları başkadır (onlar gibi davranmazlar).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27641,
            "SureId": 37,
            "AyetId": 161,
            "LanguageId": 5,
            "AyetNumber": "161-162",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Siz ve taptıklarınız; hiçbiriniz onu (samimi kulu) Allah’a inancı hususunda saptıramazsınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27648,
            "SureId": 37,
            "AyetId": 162,
            "LanguageId": 5,
            "AyetNumber": "162",
            "AyetVisible": false,
            "Page": 452,
            "AyetText": "Siz ve taptıklarınız; hiçbiriniz onu (samimi kulu) Allah’a inancı hususunda saptıramazsınız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27655,
            "SureId": 37,
            "AyetId": 163,
            "LanguageId": 5,
            "AyetNumber": "163",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Ancak cehennemi boylayacak olan başka.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27662,
            "SureId": 37,
            "AyetId": 164,
            "LanguageId": 5,
            "AyetNumber": "164",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "(Putperestlerce Allah’ın kızları sayılan melekler şöyle derler:) “Bizim her birimizin mutlaka belli bir yeri vardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27669,
            "SureId": 37,
            "AyetId": 165,
            "LanguageId": 5,
            "AyetNumber": "165",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Biz mutlaka (o yerlerde) saf tutarız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27676,
            "SureId": 37,
            "AyetId": 166,
            "LanguageId": 5,
            "AyetNumber": "166",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Ve biz, kuşkusuz Allah’ı tesbih ederiz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27683,
            "SureId": 37,
            "AyetId": 167,
            "LanguageId": 5,
            "AyetNumber": "167",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "O putperestler hep şöyle derlerdi:",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27690,
            "SureId": 37,
            "AyetId": 168,
            "LanguageId": 5,
            "AyetNumber": "168",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "“Elimizde öncekilerden gelmiş bir kitap bulunsaydı;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27697,
            "SureId": 37,
            "AyetId": 169,
            "LanguageId": 5,
            "AyetNumber": "169",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Elbet biz de Allah’ın hâlis kulları olurduk.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27704,
            "SureId": 37,
            "AyetId": 170,
            "LanguageId": 5,
            "AyetNumber": "170",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Ama şimdi bu kitabı (Kur’an) inkâr ediyorlar! Yakında her şeyi öğrenecekler!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27711,
            "SureId": 37,
            "AyetId": 171,
            "LanguageId": 5,
            "AyetNumber": "171",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Andolsun ki elçi olarak gönderdiğimiz kullarımıza geçmişte söz vermiştik:",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27718,
            "SureId": 37,
            "AyetId": 172,
            "LanguageId": 5,
            "AyetNumber": "172",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Zafere mutlaka onlar ulaşacaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27725,
            "SureId": 37,
            "AyetId": 173,
            "LanguageId": 5,
            "AyetNumber": "173",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Galip gelenler kesinlikle bizim ordumuz olacak.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27732,
            "SureId": 37,
            "AyetId": 174,
            "LanguageId": 5,
            "AyetNumber": "174",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "(Ey resulüm!) Şimdi sen bir süre için o inkârcıları kendi hallerine bırak.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27739,
            "SureId": 37,
            "AyetId": 175,
            "LanguageId": 5,
            "AyetNumber": "175",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Hallerini gör onların; ileride kendileri de görecekler!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27746,
            "SureId": 37,
            "AyetId": 176,
            "LanguageId": 5,
            "AyetNumber": "176",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Azabımızın çabuklaştırılmasını mı istiyorlar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27753,
            "SureId": 37,
            "AyetId": 177,
            "LanguageId": 5,
            "AyetNumber": "177",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "İstedikleri başlarına geldiğinde (önceden) uyarılmış olanların sabahı çok kötü olacaktır!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27760,
            "SureId": 37,
            "AyetId": 178,
            "LanguageId": 5,
            "AyetNumber": "178",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Evet, sen bir süre için onları kendi hallerine bırak.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27767,
            "SureId": 37,
            "AyetId": 179,
            "LanguageId": 5,
            "AyetNumber": "179",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Ve hallerini gör; ileride kendileri de görecekler!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27774,
            "SureId": 37,
            "AyetId": 180,
            "LanguageId": 5,
            "AyetNumber": "180",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Mutlak izzet sahibi olan rabbin, onların yakıştırdığı nitelemelerden münezzehtir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27781,
            "SureId": 37,
            "AyetId": 181,
            "LanguageId": 5,
            "AyetNumber": "181",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Bütün peygamberlere selâm olsun!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 27788,
            "SureId": 37,
            "AyetId": 182,
            "LanguageId": 5,
            "AyetNumber": "182",
            "AyetVisible": true,
            "Page": 452,
            "AyetText": "Ve âlemlerin rabbi olan Allah’a hamdolsun.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
