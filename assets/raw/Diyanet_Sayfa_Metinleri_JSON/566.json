    "QuranAyats": [
        {
            "Id": 37198,
            "SureId": 68,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "خَاشِعَةً اَبْصَارُهُمْ تَرْهَقُهُمْ ذِلَّةٌؕ وَقَدْ كَانُوا یُدْعَوْنَ اِلَى السُّجُودِ وَهُمْ سَالِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 68,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. Sûre, adını birinci âyette geçen “elKalem”kelimesinden almıştır. “Nûn” sûresi diye de anılır. Sûrede başlıca, Hz.Muhammed’in peygamberliğinin ispatı ve mü’minler ile kâfirlerin akıbetlerikonu edilmiştir.",
                "SureNameTurkish": "Kalem",
                "SureNameArabic": "الْقَلَمِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 2,
                "AyetCount": 52,
                "Cuz": 29,
                "FirstPage": 564,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37205,
            "SureId": 68,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "فَذَرْنٖی وَمَنْ یُكَذِّبُ بِهٰذَا الْحَدٖیثِؕ سَنَسْتَدْرِجُهُمْ مِنْ حَیْثُ لَا یَعْلَمُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37212,
            "SureId": 68,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "وَاُمْلٖی لَهُمْؕ اِنَّ كَیْدٖی مَتٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37219,
            "SureId": 68,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "اَمْ تَسْـَٔلُهُمْ اَجْرًا فَهُمْ مِنْ مَغْرَمٍ مُثْقَلُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37226,
            "SureId": 68,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "اَمْ عِنْدَهُمُ الْغَیْبُ فَهُمْ یَكْتُبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37233,
            "SureId": 68,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُنْ كَصَاحِبِ الْحُوتِۘ اِذْ نَادٰى وَهُوَ مَكْظُومٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37240,
            "SureId": 68,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "لَوْلَٓا اَنْ تَدَارَكَهُ نِعْمَةٌ مِنْ رَبِّهٖ لَنُبِذَ بِالْعَرَٓاءِ وَهُوَ مَذْمُومٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37247,
            "SureId": 68,
            "AyetId": 50,
            "LanguageId": 7,
            "AyetNumber": "٥٠",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "فَاجْتَبٰیهُ رَبُّهُ فَجَعَلَهُ مِنَ الصَّالِحٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37254,
            "SureId": 68,
            "AyetId": 51,
            "LanguageId": 7,
            "AyetNumber": "٥١",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "وَاِنْ یَكَادُ الَّذٖینَ كَفَرُوا لَیُزْلِقُونَكَ بِاَبْصَارِهِمْ لَمَّا سَمِعُوا الذِّكْرَ وَیَقُولُونَ اِنَّهُ لَمَجْنُونٌۘ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37261,
            "SureId": 68,
            "AyetId": 52,
            "LanguageId": 7,
            "AyetNumber": "٥٢",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "وَمَا هُوَ اِلَّا ذِكْرٌ لِلْعَالَمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37268,
            "SureId": 69,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "اَلْحَٓاقَّةُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 69,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. Sûre, adını birinci âyeti oluşturan“el-Hâkka” kelimesinden almıştır. Hâkka, mutlaka gerçekleşecek olan kıyametdemektir. Sûrede başlıca, Kıyameti inkâr edenlerin görecekleri cezalarve mü’minler ile kâfirlerin dehşetli Kıyamet günündeki hâlleri konu edilmektedir.",
                "SureNameTurkish": "Hâkka",
                "SureNameArabic": "الْحَاقَّةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 78,
                "AyetCount": 52,
                "Cuz": 29,
                "FirstPage": 566,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37275,
            "SureId": 69,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "مَا الْحَٓاقَّةُۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37282,
            "SureId": 69,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "وَمَٓا اَدْرٰیكَ مَا الْحَٓاقَّةُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37289,
            "SureId": 69,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "كَذَّبَتْ ثَمُودُ وَعَادٌ بِالْقَارِعَةِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37296,
            "SureId": 69,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "فَاَمَّا ثَمُودُ فَاُهْلِكُوا بِالطَّاغِیَةِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37303,
            "SureId": 69,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "وَاَمَّا عَادٌ فَاُهْلِكُوا بِرٖیحٍ صَرْصَرٍ عَاتِیَةٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37310,
            "SureId": 69,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "سَخَّرَهَا عَلَیْهِمْ سَبْعَ لَیَالٍ وَثَمَانِیَةَ اَیَّامٍۙ حُسُومًا فَتَرَى الْقَوْمَ فٖیهَا صَرْعٰىۙ كَاَنَّهُمْ اَعْجَازُ نَخْلٍ خَاوِیَةٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37317,
            "SureId": 69,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "فَهَلْ تَرٰى لَهُمْ مِنْ بَاقِیَةٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 37196,
            "SureId": 68,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "O sırada gözlerine korku çökmüş, perişan olmuşlardır. Halbuki onlar, yapabilecek durumda iken de secdeye çağrılmışlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 68,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. Sûre, adını birinci âyette geçen “elKalem”kelimesinden almıştır. “Nûn” sûresi diye de anılır. Sûrede başlıca, Hz.Muhammed’in peygamberliğinin ispatı ve mü’minler ile kâfirlerin akıbetlerikonu edilmiştir.",
                "SureNameTurkish": "Kalem",
                "SureNameArabic": "الْقَلَمِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 2,
                "AyetCount": 52,
                "Cuz": 29,
                "FirstPage": 564,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37203,
            "SureId": 68,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Sen bu sözü yalan sayanı bana bırak! Biz onları, bilemeyecekleri bir şekilde yavaş yavaş azaba doğru çekeceğiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37210,
            "SureId": 68,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Onlara mühlet veriyorum; ama benim planım çok sağlamdır!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37217,
            "SureId": 68,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Yoksa, sanki sen onlardan bir ücret istiyorsun da bunun ağırlığı altında kalmaktan mı çekiniyorlar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37224,
            "SureId": 68,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Yahut gayb bilgisine sahipler de oradan mı alıp yazıyorlar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37231,
            "SureId": 68,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Sen rabbinin hükmüne sabret; balığın yuttuğu (Yunus) gibi olma. Hani o, öfkeli bir halde bağırıp çağırmıştı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37238,
            "SureId": 68,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Rabbinin lutfu imdadına yetişmeseydi o mutlaka kınanmayı hak etmiş olarak ıssız bir sahaya atılacaktı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37245,
            "SureId": 68,
            "AyetId": 50,
            "LanguageId": 5,
            "AyetNumber": "50",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Fakat rabbi onu seçip sâlihlerden eyledi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37252,
            "SureId": 68,
            "AyetId": 51,
            "LanguageId": 5,
            "AyetNumber": "51",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "O inkârcılar Kur’an’ı işittikleri zaman, seni gözleriyle devireceklermiş gibi bakar, “Şüphe yok o bir delidir” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37259,
            "SureId": 68,
            "AyetId": 52,
            "LanguageId": 5,
            "AyetNumber": "52",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Oysa Kur’an, âlemler için öğütten başka bir şey değildir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37266,
            "SureId": 69,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "O gerçekleşecek büyük olay (kıyamet)!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 69,
                "MealInfo": "Mekke döneminde inmiştir. 52 âyettir. Sûre, adını birinci âyeti oluşturan“el-Hâkka” kelimesinden almıştır. Hâkka, mutlaka gerçekleşecek olan kıyametdemektir. Sûrede başlıca, Kıyameti inkâr edenlerin görecekleri cezalarve mü’minler ile kâfirlerin dehşetli Kıyamet günündeki hâlleri konu edilmektedir.",
                "SureNameTurkish": "Hâkka",
                "SureNameArabic": "الْحَاقَّةِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 78,
                "AyetCount": 52,
                "Cuz": 29,
                "FirstPage": 566,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 37273,
            "SureId": 69,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Nedir o büyük olay?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37280,
            "SureId": 69,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "O büyük olayın ne olduğunu sen nereden bileceksin!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37287,
            "SureId": 69,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Semûd ve Âd, kapılarını çalacak felâketi asılsız saymışlardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37294,
            "SureId": 69,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Semûd kavmi çok şiddetli bir depremle helâk edildi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37301,
            "SureId": 69,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Âd halkı ise dehşetli bir kasırga ile yok ediliverdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37308,
            "SureId": 69,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Allah o kasırgayı ardarda yedi gece, sekiz gün onların üzerine gönderdi. Öyle ki (orada bulunsaydın), o kavmi devrilmiş hurma kütükleri gibi oracıkta yere serilmiş halde görürdün.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 37315,
            "SureId": 69,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 566,
            "AyetText": "Şimdi onlardan geriye kalan bir şey görüyor musun?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
