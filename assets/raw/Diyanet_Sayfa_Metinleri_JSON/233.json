{
    "PointerList": null,
    "CuzNo": 12,
    "PageNo": 233,
    "ArCuzNo": "۱۲",
    "ArPageNo": "۲۳۳",
    "QuranAyats": [
        {
            "Id": 10997,
            "SureId": 11,
            "AyetId": 98,
            "LanguageId": 7,
            "AyetNumber": "٩٨",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "یَقْدُمُ قَوْمَهُ یَوْمَ الْقِیٰمَةِ فَاَوْرَدَهُمُ النَّارَؕ وَبِئْسَ الْوِرْدُ الْمَوْرُودُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 11,
                "MealInfo": "Mekke döneminde inmiştir. 123 âyettir. Sûre, adını içinde söz konusu edilen Hûd peygamberden almıştır. Sûre de başlıca tevhit, peygamberlik, öldükten sonra dirilme ve ceza konuları ele alınmakta ve bunlar bazı peygamberlerin kıssalarıyla desteklenmektedir.",
                "SureNameTurkish": "Hûd",
                "SureNameArabic": "هُودٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 52,
                "AyetCount": 123,
                "Cuz": 11,
                "FirstPage": 221,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11004,
            "SureId": 11,
            "AyetId": 99,
            "LanguageId": 7,
            "AyetNumber": "٩٩",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "وَاُتْبِعُوا فٖی هٰذِهٖ لَعْنَةً وَیَوْمَ الْقِیٰمَةِؕ بِئْسَ الرِّفْدُ الْمَرْفُودُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11011,
            "SureId": 11,
            "AyetId": 100,
            "LanguageId": 7,
            "AyetNumber": "١٠٠",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "ذٰلِكَ مِنْ اَنْبَٓاءِ الْقُرٰى نَقُصُّهُ عَلَیْكَ مِنْهَا قَٓائِمٌ وَحَصٖیدٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11018,
            "SureId": 11,
            "AyetId": 101,
            "LanguageId": 7,
            "AyetNumber": "١٠١",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "وَمَا ظَلَمْنَاهُمْ وَلٰكِنْ ظَلَمُٓوا اَنْفُسَهُمْ فَمَٓا اَغْنَتْ عَنْهُمْ اٰلِهَتُهُمُ الَّتٖی یَدْعُونَ مِنْ دُونِ اللّٰهِ مِنْ شَیْءٍ لَمَّا جَٓاءَ اَمْرُ رَبِّكَؕ وَمَا زَادُوهُمْ غَیْرَ تَتْبٖیبٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11025,
            "SureId": 11,
            "AyetId": 102,
            "LanguageId": 7,
            "AyetNumber": "١٠٢",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "وَكَذٰلِكَ اَخْذُ رَبِّكَ اِذَٓا اَخَذَ الْقُرٰى وَهِیَ ظَالِمَةٌؕ اِنَّ اَخْذَهُٓ اَلٖیمٌ شَدٖیدٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11032,
            "SureId": 11,
            "AyetId": 103,
            "LanguageId": 7,
            "AyetNumber": "١٠٣",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "اِنَّ فٖی ذٰلِكَ لَاٰیَةً لِمَنْ خَافَ عَذَابَ الْاٰخِرَةِؕ ذٰلِكَ یَوْمٌ مَجْمُوعٌۙ لَهُ النَّاسُ وَذٰلِكَ یَوْمٌ مَشْهُودٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11039,
            "SureId": 11,
            "AyetId": 104,
            "LanguageId": 7,
            "AyetNumber": "١٠٤",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "وَمَا نُؤَخِّرُهُٓ اِلَّا لِاَجَلٍ مَعْدُودٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11046,
            "SureId": 11,
            "AyetId": 105,
            "LanguageId": 7,
            "AyetNumber": "١٠٥",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "یَوْمَ یَاْتِ لَا تَكَلَّمُ نَفْسٌ اِلَّا بِاِذْنِهٖۚ فَمِنْهُمْ شَقِیٌّ وَسَعٖیدٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11053,
            "SureId": 11,
            "AyetId": 106,
            "LanguageId": 7,
            "AyetNumber": "١٠٦",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "فَاَمَّا الَّذٖینَ شَقُوا فَفِی النَّارِ لَهُمْ فٖیهَا زَفٖیرٌ وَشَهٖیقٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11060,
            "SureId": 11,
            "AyetId": 107,
            "LanguageId": 7,
            "AyetNumber": "١٠٧",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "خَالِدٖینَ فٖیهَا مَا دَامَتِ السَّمٰوَاتُ وَالْاَرْضُ اِلَّا مَا شَٓاءَ رَبُّكَؕ اِنَّ رَبَّكَ فَعَّالٌ لِمَا یُرٖیدُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11067,
            "SureId": 11,
            "AyetId": 108,
            "LanguageId": 7,
            "AyetNumber": "١٠٨",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "وَاَمَّا الَّذٖینَ سُعِدُوا فَفِی الْجَنَّةِ خَالِدٖینَ فٖیهَا مَا دَامَتِ السَّمٰوَاتُ وَالْاَرْضُ اِلَّا مَا شَٓاءَ رَبُّكَؕ عَطَٓاءً غَیْرَ مَجْذُوذٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 10995,
            "SureId": 11,
            "AyetId": 98,
            "LanguageId": 5,
            "AyetNumber": "98",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "Firavun, kıyamet gününde kavminin önüne düşecek ve onları ateşe götürecektir. Gidilen o yer ne kötü!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 11,
                "MealInfo": "Mekke döneminde inmiştir. 123 âyettir. Sûre, adını içinde söz konusu edilen Hûd peygamberden almıştır. Sûre de başlıca tevhit, peygamberlik, öldükten sonra dirilme ve ceza konuları ele alınmakta ve bunlar bazı peygamberlerin kıssalarıyla desteklenmektedir.",
                "SureNameTurkish": "Hûd",
                "SureNameArabic": "هُودٍ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 52,
                "AyetCount": 123,
                "Cuz": 11,
                "FirstPage": 221,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 11002,
            "SureId": 11,
            "AyetId": 99,
            "LanguageId": 5,
            "AyetNumber": "99",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "Onların burada da kıyamet gününde de lânet peşlerini bırakmadı; verilen “ödül” ne kötü!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11009,
            "SureId": 11,
            "AyetId": 100,
            "LanguageId": 5,
            "AyetNumber": "100",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "İşte sana anlatmakta olduğumuz eski beldelerin haberleri böyle. Kiminin izleri hâlâ ayakta, kimi de biçilip yere serilmiş.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11016,
            "SureId": 11,
            "AyetId": 101,
            "LanguageId": 5,
            "AyetNumber": "101",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "Onlara biz zulmetmedik; onlar kendi kendilerine zulmettiler. Rabbinin hükmü geldiğinde Allah’ı bırakıp da taptıkları tanrıları onlara hiçbir şey sağlamadı; ziyanlarını artırmaktan başka bir işe yaramadı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11023,
            "SureId": 11,
            "AyetId": 102,
            "LanguageId": 5,
            "AyetNumber": "102",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "Rabbin, zulme sapan toplulukları yakaladığında işte böyle yakalar! Şüphesiz onun cezalandırması pek elem vericidir, pek çetindir!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11030,
            "SureId": 11,
            "AyetId": 103,
            "LanguageId": 5,
            "AyetNumber": "103",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "İşte bunda, âhiret azabından korkanlar için elbette bir ibret vardır. O gün bütün insanların bir araya toplandığı gündür ve o gün olup bitenin gözle görüldüğü bir gündür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11037,
            "SureId": 11,
            "AyetId": 104,
            "LanguageId": 5,
            "AyetNumber": "104",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "Biz o günü sadece belli bir süreye kadar erteleriz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11044,
            "SureId": 11,
            "AyetId": 105,
            "LanguageId": 5,
            "AyetNumber": "105",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "O gün geldiğinde Allah’ın izni olmadan hiç kimse konuşamaz. Onlardan kimi bedbahttır, kimi mutlu!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11051,
            "SureId": 11,
            "AyetId": 106,
            "LanguageId": 5,
            "AyetNumber": "106",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "Bedbaht olanlar ateştedirler, orada onlar her nefeste acıdan inleyip feryat ederler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11058,
            "SureId": 11,
            "AyetId": 107,
            "LanguageId": 5,
            "AyetNumber": "107",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "Rabbinin dilediği hariç, onlar gökler ve yer durdukça o ateşte ebedî kalacaklardır. Rabbin gerçekten istediğini yapar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 11065,
            "SureId": 11,
            "AyetId": 108,
            "LanguageId": 5,
            "AyetNumber": "108",
            "AyetVisible": true,
            "Page": 233,
            "AyetText": "Mutlu olanlara gelince onlar da cennettedirler. Rabbinin dilediği hariç, gökler ve yer durdukça onlar da orada kesintisiz bir lutuf olarak ebedî kalacaklardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Hûd",
    "QuranSureLabel": "هُودٍ",
    "EndPageSure": null
}