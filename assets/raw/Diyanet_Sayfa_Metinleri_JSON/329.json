            "AyetNumber": "٨٢",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "وَمِنَ الشَّیَاطٖینِ مَنْ یَغُوصُونَ لَهُ وَیَعْمَلُونَ عَمَلًا دُونَ ذٰلِكَۚ وَكُنَّا لَهُمْ حَافِظٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17962,
            "SureId": 21,
            "AyetId": 83,
            "LanguageId": 7,
            "AyetNumber": "٨٣",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "وَاَیُّوبَ اِذْ نَادٰى رَبَّهُٓ اَنّٖی مَسَّنِیَ الضُّرُّ وَاَنْتَ اَرْحَمُ الرَّاحِمٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17969,
            "SureId": 21,
            "AyetId": 84,
            "LanguageId": 7,
            "AyetNumber": "٨٤",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "فَاسْتَجَبْنَا لَهُ فَكَشَفْنَا مَا بِهٖ مِنْ ضُرٍّ وَاٰتَیْنَاهُ اَهْلَهُ وَمِثْلَهُمْ مَعَهُمْ رَحْمَةً مِنْ عِنْدِنَا وَذِكْرٰى لِلْعَابِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17976,
            "SureId": 21,
            "AyetId": 85,
            "LanguageId": 7,
            "AyetNumber": "٨٥",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "وَاِسْمٰعٖیلَ وَاِدْرٖیسَ وَذَا الْكِفْلِؕ كُلٌّ مِنَ الصَّابِرٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17983,
            "SureId": 21,
            "AyetId": 86,
            "LanguageId": 7,
            "AyetNumber": "٨٦",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "وَاَدْخَلْنَاهُمْ فٖی رَحْمَتِنَاؕ اِنَّهُمْ مِنَ الصَّالِحٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17990,
            "SureId": 21,
            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "وَذَا النُّونِ اِذْ ذَهَبَ مُغَاضِبًا فَظَنَّ اَنْ لَنْ نَقْدِرَ عَلَیْهِ فَنَادٰى فِی الظُّلُمَاتِ اَنْ لَٓا اِلٰهَ اِلَّٓا اَنْتَ سُبْحَانَكَࣗ اِنّٖی كُنْتُ مِنَ الظَّالِمٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17997,
            "SureId": 21,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "فَاسْتَجَبْنَا لَهُۙ وَنَجَّیْنَاهُ مِنَ الْغَمِّؕ وَكَذٰلِكَ نُنْجِی الْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18004,
            "SureId": 21,
            "AyetId": 89,
            "LanguageId": 7,
            "AyetNumber": "٨٩",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "وَزَكَرِیَّٓا اِذْ نَادٰى رَبَّهُ رَبِّ لَا تَذَرْنٖی فَرْدًا وَاَنْتَ خَیْرُ الْوَارِثٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18011,
            "SureId": 21,
            "AyetId": 90,
            "LanguageId": 7,
            "AyetNumber": "٩٠",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "فَاسْتَجَبْنَا لَهُؗ وَوَهَبْنَا لَهُ یَحْیٰى وَاَصْلَحْنَا لَهُ زَوْجَهُؕ اِنَّهُمْ كَانُوا یُسَارِعُونَ فِی الْخَیْرَاتِ وَیَدْعُونَنَا رَغَبًا وَرَهَبًاؕ وَكَانُوا لَنَا خَاشِعٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 17953,
            "SureId": 21,
            "AyetId": 82,
            "LanguageId": 5,
            "AyetNumber": "82",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "Şeytanlar (cinler) arasından da onun için dalgıçlık ve daha başka işler yapanlar vardı. Biz onları gözetim altında tutuyorduk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 21,
                "MealInfo": "Mekke döneminde inmiştir. 112 âyettir. <b>“Enbiyâ”</b>, peygamberler demektir.Sûre, temel konu olarak peygamberlerden, onların tevhit davası uğrunda verdikleri mücadelelerden bahsettiği için bu adı almıştır",
                "SureNameTurkish": "Enbiyâ",
                "SureNameArabic": "الْاَنْبِيَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 73,
                "AyetCount": 112,
                "Cuz": 17,
                "FirstPage": 322,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 17960,
            "SureId": 21,
            "AyetId": 83,
            "LanguageId": 5,
            "AyetNumber": "83",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "Eyyûb’u da an! Hani rabbine, “Başıma bu dert geldi. Ama sen merhametlilerin en üstünüsün” diye niyaz etmişti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17967,
            "SureId": 21,
            "AyetId": 84,
            "LanguageId": 5,
            "AyetNumber": "84",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "Bunun üzerine biz, tarafımızdan bir rahmet ve kulluk edenler için anılacak bir örnek olmak üzere onun duasını kabul ettik; kendisinde dert ve sıkıntı olarak ne varsa giderdik; ona aile efradını, ayrıca bunlarla birlikte bir mislini daha verdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17974,
            "SureId": 21,
            "AyetId": 85,
            "LanguageId": 5,
            "AyetNumber": "85",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "İsmâil’i, İdrîs’i ve Zülkifl’i de yâdet. Hepsi de sabreden kimselerdendi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17981,
            "SureId": 21,
            "AyetId": 86,
            "LanguageId": 5,
            "AyetNumber": "86",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "Onları rahmetimize kabul ettik. Onlar hakikaten iyi kimselerdi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17988,
            "SureId": 21,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "Zünnûn’u da (Yûnus) zikret! Hani öfkeli bir halde geçip gitmiş, kendisini asla sıkıştırmayacağımızı sanmıştı. Sonunda karanlıklar içinde, “Senden başka hiçbir tanrı yoktur. Seni tenzih ederim. Gerçekten ben kötü işler yapmışım!” diyerek yalvardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 17995,
            "SureId": 21,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "Bunun üzerine duasını kabul ettik ve onu sıkıntıdan kurtardık. İşte biz iman etmiş olanları böyle kurtarırız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18002,
            "SureId": 21,
            "AyetId": 89,
            "LanguageId": 5,
            "AyetNumber": "89",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "Zekeriyyâ’yı da an! Hani o, rabbine şöyle niyaz etmişti: “Rabbim! Geride kalanların en hayırlısı sensin, yine de sen beni yalnız (çocuksuz) bırakma!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 18009,
            "SureId": 21,
            "AyetId": 90,
            "LanguageId": 5,
            "AyetNumber": "90",
            "AyetVisible": true,
            "Page": 329,
            "AyetText": "Biz onun da duasını kabul ettik ve ona Yahyâ’yı verdik; eşini de bunun için elverişli kıldık. Onlar, hayır işlerinde koşuşurlar, umarak ve korkarak bize yalvarırlardı; onlar, bize karşı derin saygı içindeydiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
