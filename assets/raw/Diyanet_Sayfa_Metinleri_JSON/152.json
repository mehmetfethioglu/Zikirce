    "QuranAyats": [
        {
            "Id": 6762,
            "SureId": 7,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "قَالَ مَا مَنَعَكَ اَلَّا تَسْجُدَ اِذْ اَمَرْتُكَؕ قَالَ اَنَا𐻾 خَیْرٌ مِنْهُۚ خَلَقْتَنٖی مِنْ نَارٍ وَخَلَقْتَهُ مِنْ طٖینٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 7,
                "MealInfo": "Mekke döneminde inmiştir. 163-170. âyetlerin Medine döneminde indiğini söyleyen âlimler de vardır. 206 âyettir. Sûre, adını 46. ve 48. âyetlerde geçen<b>“el-A’râf ” </b>kelimesinden almıştır. <b>“el-A’râf ”, <i>yüksek yerler, yüksek mevkiler</i> demektir</b>. Sûrede temel konu olarak, ilâhî vahyin doğruluğu ve vahye duyulan ihtiyaç işlenmektedir.",
                "SureNameTurkish": "A'râf",
                "SureNameArabic": "الْاَعْرَافِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 39,
                "AyetCount": 206,
                "Cuz": 8,
                "FirstPage": 151,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 6769,
            "SureId": 7,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "قَالَ فَاهْبِطْ مِنْهَا فَمَا یَكُونُ لَكَ اَنْ تَتَكَبَّرَ فٖیهَا فَاخْرُجْ اِنَّكَ مِنَ الصَّاغِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6776,
            "SureId": 7,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "قَالَ اَنْظِرْنٖٓی اِلٰى یَوْمِ یُبْعَثُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6783,
            "SureId": 7,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "قَالَ اِنَّكَ مِنَ الْمُنْظَرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6790,
            "SureId": 7,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "قَالَ فَبِمَٓا اَغْوَیْتَنٖی لَاَقْعُدَنَّ لَهُمْ صِرَاطَكَ الْمُسْتَقٖیمَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6797,
            "SureId": 7,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "ثُمَّ لَاٰتِیَنَّهُمْ مِنْ بَیْنِ اَیْدٖیهِمْ وَمِنْ خَلْفِهِمْ وَعَنْ اَیْمَانِهِمْ وَعَنْ شَمَٓائِلِهِمْؕ وَلَا تَجِدُ اَكْثَرَهُمْ شَاكِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6804,
            "SureId": 7,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "قَالَ اخْرُجْ مِنْهَا مَذْؤُ𐻿مًا مَدْحُورًاؕ لَمَنْ تَبِعَكَ مِنْهُمْ لَاَمْلَــَٔنَّ جَهَنَّمَ مِنْكُمْ اَجْمَعٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6811,
            "SureId": 7,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "وَیَٓا اٰدَمُ اسْكُنْ اَنْتَ وَزَوْجُكَ الْجَنَّةَ فَكُلَا مِنْ حَیْثُ شِئْتُمَا وَلَا تَقْرَبَا هٰذِهِ الشَّجَرَةَ فَتَكُونَا مِنَ الظَّالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6818,
            "SureId": 7,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "فَوَسْوَسَ لَهُمَا الشَّیْطَانُ لِیُبْدِیَ لَهُمَا مَا وُ𐻿رِیَ عَنْهُمَا مِنْ سَوْاٰتِهِمَا وَقَالَ مَا نَهٰیكُمَا رَبُّكُمَا عَنْ هٰذِهِ الشَّجَرَةِ اِلَّٓا اَنْ تَكُونَا مَلَكَیْنِ اَوْ تَكُونَا مِنَ الْخَالِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6825,
            "SureId": 7,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "وَقَاسَمَهُمَٓا اِنّٖی لَكُمَا لَمِنَ النَّاصِحٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6832,
            "SureId": 7,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "فَدَلّٰیهُمَا بِغُرُورٍۚ فَلَمَّا ذَاقَا الشَّجَرَةَ بَدَتْ لَهُمَا سَوْاٰتُهُمَا وَطَفِقَا یَخْصِفَانِ عَلَیْهِمَا مِنْ وَرَقِ الْجَنَّةِؕ وَنَادٰیهُمَا رَبُّهُمَٓا اَلَمْ اَنْهَكُمَا عَنْ تِلْكُمَا الشَّجَرَةِ وَاَقُلْ لَكُمَٓا اِنَّ الشَّیْطَانَ لَكُمَا عَدُوٌّ مُبٖینٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 6760,
            "SureId": 7,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "Allah buyurdu: “Ben sana emretmişken seni secde etmekten alıkoyan nedir?” (İblîs), “Ben ondan daha üstünüm; çünkü beni ateşten yarattın, onu çamurdan yarattın” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 7,
                "MealInfo": "Mekke döneminde inmiştir. 163-170. âyetlerin Medine döneminde indiğini söyleyen âlimler de vardır. 206 âyettir. Sûre, adını 46. ve 48. âyetlerde geçen<b>“el-A’râf ” </b>kelimesinden almıştır. <b>“el-A’râf ”, <i>yüksek yerler, yüksek mevkiler</i> demektir</b>. Sûrede temel konu olarak, ilâhî vahyin doğruluğu ve vahye duyulan ihtiyaç işlenmektedir.",
                "SureNameTurkish": "A'râf",
                "SureNameArabic": "الْاَعْرَافِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 39,
                "AyetCount": 206,
                "Cuz": 8,
                "FirstPage": 151,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 6767,
            "SureId": 7,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "Allah, “Öyle ise in oradan! Orada büyüklük taslamak senin haddin değildir. Çık! Artık sen aşağılıklardansın!” buyurdu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6774,
            "SureId": 7,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "İblîs, “Bana insanların yeniden diriltilecekleri güne kadar mühlet ver” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6781,
            "SureId": 7,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "Allah, “Haydi, sen mühlet verilenlerdensin” buyurdu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6788,
            "SureId": 7,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "İblîs dedi ki: “Bundan böyle benim sapmama izin vermene karşılık, ant içerim ki, ben de onları saptırmak için senin doğru yolunun üstüne oturacağım.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6795,
            "SureId": 7,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "Sonra elbette onlara önlerinden, arkalarından, sağlarından, sollarından sokulacağım ve sen onların çoklarını şükredenlerden bulmayacaksın.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6802,
            "SureId": 7,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "Allah buyurdu: “Haydi, yerilmiş ve kovulmuş olarak oradan çık! Andolsun ki, onlardan kim sana uyarsa, sizin hepinizi cehenneme dolduracağım!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6809,
            "SureId": 7,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "(Buyuruldu ki:) “Ey Âdem! Sen ve eşin cennette yerleşip dilediklerinizden yiyin. Ancak şu ağaca yaklaşmayın! Sonra zalimlerden olursunuz.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6816,
            "SureId": 7,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "Derken şeytan, kapalı olan avret yerlerini birbirine göstermek için onlara fısıldayıp kafalarını karıştırdı ve “Rabbiniz size bu ağacı sırf melek olursunuz veya ebedî yaşayanlardan olursunuz diye yasakladı” dedi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6823,
            "SureId": 7,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "Onlara, “Ben gerçekten sizin iyiliğinizi isteyenlerdenim” diye de yemin etti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 6830,
            "SureId": 7,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 152,
            "AyetText": "Böylece ikisini de ayartmış oldu. Ağacın meyvesini tattıklarında ayıp yerleri kendilerine göründü. Ve cennet yapraklarından üzerlerini örtmeye başladılar. Rableri onlara, “Ben size o ağacı yasaklamadım mı ve şeytanın size apaçık bir düşman olduğunu söylemedim mi?” diye seslendi.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
