            "AyetNumber": "٦٢",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "اِنَّ هٰذَا لَهُوَ الْقَصَصُ الْحَقُّۚ وَمَا مِنْ اِلٰهٍ اِلَّا اللّٰهُؕ وَاِنَّ اللّٰهَ لَهُوَ الْعَزٖیزُ الْحَكٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
