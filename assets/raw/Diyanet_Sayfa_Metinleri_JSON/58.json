                "ExcludeMenu": false
            }
        },
        {
            "Id": 2492,
            "SureId": 3,
            "AyetId": 63,
            "LanguageId": 7,
            "AyetNumber": "٦٣",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "فَاِنْ تَوَلَّوْا فَاِنَّ اللّٰهَ عَلٖیمٌ بِالْمُفْسِدٖینَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2499,
            "SureId": 3,
            "AyetId": 64,
            "LanguageId": 7,
            "AyetNumber": "٦٤",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "قُلْ یَٓا اَهْلَ الْكِتَابِ تَعَالَوْا اِلٰى كَلِمَةٍ سَوَٓاءٍ بَیْنَنَا وَبَیْنَكُمْ اَلَّا نَعْبُدَ اِلَّا اللّٰهَ وَلَا نُشْرِكَ بِهٖ شَیْـًٔا وَلَا یَتَّخِذَ بَعْضُنَا بَعْضًا اَرْبَابًا مِنْ دُونِ اللّٰهِؕ فَاِنْ تَوَلَّوْا فَقُولُوا اشْهَدُوا بِاَنَّا مُسْلِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2506,
            "SureId": 3,
            "AyetId": 65,
            "LanguageId": 7,
            "AyetNumber": "٦٥",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "یَٓا اَهْلَ الْكِتَابِ لِمَ تُحَٓاجُّونَ فٖٓی اِبْرٰهٖیمَ وَمَٓا اُنْزِلَتِ التَّوْرٰیةُ وَالْاِنْجٖیلُ اِلَّا مِنْ بَعْدِهٖؕ اَفَلَا تَعْقِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2513,
            "SureId": 3,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "هَٓا اَنْتُمْ هٰٓؤُ𐻾لَٓاءِ حَاجَجْتُمْ فٖیمَا لَكُمْ بِهٖ عِلْمٌ فَلِمَ تُحَٓاجُّونَ فٖیمَا لَیْسَ لَكُمْ بِهٖ عِلْمٌؕ وَاللّٰهُ یَعْلَمُ وَاَنْتُمْ لَا تَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2520,
            "SureId": 3,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "مَا كَانَ اِبْرٰهٖیمُ یَهُودِیًّا وَلَا نَصْرَانِیًّا وَلٰكِنْ كَانَ حَنٖیفًا مُسْلِمًاؕ وَمَا كَانَ مِنَ الْمُشْرِكٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2527,
            "SureId": 3,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "اِنَّ اَوْلَى النَّاسِ بِاِبْرٰهٖیمَ لَلَّذٖینَ اتَّبَعُوهُ وَهٰذَا النَّبِیُّ وَالَّذٖینَ اٰمَنُواؕ وَاللّٰهُ وَلِیُّ الْمُؤْمِنٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2534,
            "SureId": 3,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "وَدَّتْ طَٓائِفَةٌ مِنْ اَهْلِ الْكِتَابِ لَوْ یُضِلُّونَكُمْؕ وَمَا یُضِلُّونَ اِلَّٓا اَنْفُسَهُمْ وَمَا یَشْعُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2541,
            "SureId": 3,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "یَٓا اَهْلَ الْكِتَابِ لِمَ تَكْفُرُونَ بِاٰیَاتِ اللّٰهِ وَاَنْتُمْ تَشْهَدُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 2483,
            "SureId": 3,
            "AyetId": 62,
            "LanguageId": 5,
            "AyetNumber": "62",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "İşte bunlar gerçek haberlerdir. Allah’tan başka hiçbir ilâh yoktur. Muhakkak ki Allah, evet O, mutlak güç ve hikmet sahibidir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 3,
                "MealInfo": "Medine döneminde inmiştir. 200 âyettir. Sûre, adını 33. âyette geçen<b> “Âl-i İmrân”</b> tamlamasından almıştır. Âl-i İmrân, İmran ailesi demektir.",
                "SureNameTurkish": "Âl-i İmrân",
                "SureNameArabic": "اٰلِ عِمْرٰنَ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 89,
                "AyetCount": 200,
                "Cuz": 3,
                "FirstPage": 50,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 2490,
            "SureId": 3,
            "AyetId": 63,
            "LanguageId": 5,
            "AyetNumber": "63",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "Eğer yine yüz çevirirlerse, kuşkusuz Allah bozguncuları çok iyi bilmektedir.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2497,
            "SureId": 3,
            "AyetId": 64,
            "LanguageId": 5,
            "AyetNumber": "64",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "De ki: “Ey Ehl-i kitap! Sizinle bizim aramızda müşterek olan bir söze gelin: Yalnız Allah’a tapalım, O’na hiçbir şeyi ortak koşmayalım ve Allah’ı bırakıp da içimizden bazıları diğer bazılarını rab edinmesin.” Eğer yine yüz çevirirlerse, “Şahit olun ki biz Müslümanlarız” deyin.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2504,
            "SureId": 3,
            "AyetId": 65,
            "LanguageId": 5,
            "AyetNumber": "65",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "Ey Ehl-i kitap! İbrâhim hakkında niçin tartışırsınız? Oysa Tevrat da İncil de kesinlikle ondan sonra indirildi. Hiç düşünmüyor musunuz?",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2511,
            "SureId": 3,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "İşte siz böylesiniz; hadi hakkında bilginiz olan konuda tartıştınız, fakat hiç bilgi sahibi olmadığınız bir konuda niçin tartışıyorsunuz! Oysa Allah bilir, siz bilmezsiniz.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2518,
            "SureId": 3,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "İbrâhim ne yahudi ne hıristiyan idi; bilâkis o, tek Allah’a inanıp boyun eğmiş birisiydi, müşriklerden de değildi.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2525,
            "SureId": 3,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "Doğrusu insanların İbrâhim’e en yakın olanı, ona tâbi olanlar, şu Peygamber (Hz. Muhammed) ve iman edenlerdir. Allah da müminlerin dostudur.",
            "Recitation": null,
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2532,
            "SureId": 3,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "Ehl-i kitap’tan bir kısmı istediler ki sizi saptırsınlar. Oysa onlar ancak kendilerini saptırıyorlar da farkına varmıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 2539,
            "SureId": 3,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 58,
            "AyetText": "Ey Ehl-i kitap! (Gerçeği) görüp durduğunuz halde niçin Allah’ın âyetlerini inkâr ediyorsunuz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
