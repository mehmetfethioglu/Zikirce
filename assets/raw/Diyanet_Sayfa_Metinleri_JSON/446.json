    "QuranAyats": [
        {
            "Id": 26523,
            "SureId": 37,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "وَالصَّٓافَّاتِ صَفًّاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 37,
                "MealInfo": "Mekke döneminde inmiştir. 182 âyettir. Sûre, adını ilk âyette geçen <b>“es-Sâffât” </b>kelimesinden almıştır.<b> Sâffât, sıra sıra dizilenler, saf saf duranlar demektir</b>. Sûrede başlıca, <b>meleklerden, cinlerden, kıyamet ve ahiret olaylarından söz edilmekte; Nûh, İbrahim, İsmail, İshak, Mûsâ, Hârun, İlyas, Lût ve Yûnus Peygamberlerin kıssaları</b>na yer verilmektedir.",
                "SureNameTurkish": "Sâffât",
                "SureNameArabic": "الصَّاۤفَّاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 56,
                "AyetCount": 182,
                "Cuz": 23,
                "FirstPage": 446,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26530,
            "SureId": 37,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "فَالزَّاجِرَاتِ زَجْرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26537,
            "SureId": 37,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "فَالتَّالِیَاتِ ذِكْرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26544,
            "SureId": 37,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "اِنَّ اِلٰهَكُمْ لَوَاحِدٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26551,
            "SureId": 37,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "رَبُّ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَیْنَهُمَا وَرَبُّ الْمَشَارِقِؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26558,
            "SureId": 37,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "اِنَّا زَیَّنَّا السَّمَٓاءَ الدُّنْیَا بِزٖینَةٍࣙ الْكَوَاكِبِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26565,
            "SureId": 37,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "وَحِفْظًا مِنْ كُلِّ شَیْطَانٍ مَارِدٍۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26572,
            "SureId": 37,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "لَا یَسَّمَّعُونَ اِلَى الْمَلَاِ الْاَعْلٰى وَیُقْذَفُونَ مِنْ كُلِّ جَانِبٍࣗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26579,
            "SureId": 37,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "دُحُورًا وَلَهُمْ عَذَابٌ وَاصِبٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26586,
            "SureId": 37,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "اِلَّا مَنْ خَطِفَ الْخَطْفَةَ فَاَتْبَعَهُ شِهَابٌ ثَاقِبٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26593,
            "SureId": 37,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "فَاسْتَفْتِهِمْ اَهُمْ اَشَدُّ خَلْقًا اَمْ مَنْ خَلَقْنَاؕ اِنَّا خَلَقْنَاهُمْ مِنْ طٖینٍ لَازِبٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26600,
            "SureId": 37,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "بَلْ عَجِبْتَ وَیَسْخَرُونَࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26607,
            "SureId": 37,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "وَاِذَا ذُكِّرُوا لَا یَذْكُرُونَࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26614,
            "SureId": 37,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "وَاِذَا رَاَوْا اٰیَةً یَسْتَسْخِرُونَࣕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26621,
            "SureId": 37,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "وَقَالُٓوا اِنْ هٰذَٓا اِلَّا سِحْرٌ مُبٖینٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26628,
            "SureId": 37,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "ءَاِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا ءَاِنَّا لَمَبْعُوثُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26635,
            "SureId": 37,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "اَوَاٰبَٓاؤُ𐻾نَا الْاَوَّلُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26642,
            "SureId": 37,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "قُلْ نَعَمْ وَاَنْتُمْ دَاخِرُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26649,
            "SureId": 37,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "فَاِنَّمَا هِیَ زَجْرَةٌ وَاحِدَةٌ فَاِذَا هُمْ یَنْظُرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26656,
            "SureId": 37,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "وَقَالُوا یَا وَیْلَنَا هٰذَا یَوْمُ الدّٖینِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26663,
            "SureId": 37,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "هٰذَا یَوْمُ الْفَصْلِ الَّذٖی كُنْتُمْ بِهٖ تُكَذِّبُونَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26670,
            "SureId": 37,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "اُحْشُرُوا الَّذٖینَ ظَلَمُوا وَاَزْوَاجَهُمْ وَمَا كَانُوا یَعْبُدُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26677,
            "SureId": 37,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "مِنْ دُونِ اللّٰهِ فَاهْدُوهُمْ اِلٰى صِرَاطِ الْجَحٖیمِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26684,
            "SureId": 37,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "وَقِفُوهُمْ اِنَّهُمْ مَسْؤُ𐻿لُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 26521,
            "SureId": 37,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1-4",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "Sıra sıra dizilmiş olanlara, (yanlışları) engellemeye çalışanlara ve anmak için okuyanlara andolsun ki kuşkusuz tanrınız bir tekdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 37,
                "MealInfo": "Mekke döneminde inmiştir. 182 âyettir. Sûre, adını ilk âyette geçen <b>“es-Sâffât” </b>kelimesinden almıştır.<b> Sâffât, sıra sıra dizilenler, saf saf duranlar demektir</b>. Sûrede başlıca, <b>meleklerden, cinlerden, kıyamet ve ahiret olaylarından söz edilmekte; Nûh, İbrahim, İsmail, İshak, Mûsâ, Hârun, İlyas, Lût ve Yûnus Peygamberlerin kıssaları</b>na yer verilmektedir.",
                "SureNameTurkish": "Sâffât",
                "SureNameArabic": "الصَّاۤفَّاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 56,
                "AyetCount": 182,
                "Cuz": 23,
                "FirstPage": 446,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 26528,
            "SureId": 37,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": false,
            "Page": 446,
            "AyetText": "Sıra sıra dizilmiş olanlara, (yanlışları) engellemeye çalışanlara ve anmak için okuyanlara andolsun ki kuşkusuz tanrınız birtekdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26535,
            "SureId": 37,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": false,
            "Page": 446,
            "AyetText": "Sıra sıra dizilmiş olanlara, (yanlışları) engellemeye çalışanlara ve anmak için okuyanlara andolsun ki kuşkusuz tanrınız birtekdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26542,
            "SureId": 37,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": false,
            "Page": 446,
            "AyetText": "Sıra sıra dizilmiş olanlara, (yanlışları) engellemeye çalışanlara ve anmak için okuyanlara andolsun ki kuşkusuz tanrınız birtekdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26549,
            "SureId": 37,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "O, göklerin, yerin, bunlar arasındakilerin rabbi ve doğuların rabbidir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26556,
            "SureId": 37,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "Biz yakın semayı yıldızların güzelliğiyle bezedik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26563,
            "SureId": 37,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "Ve (onu) her türlü isyankâr şeytanî güce karşı koruduk.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26570,
            "SureId": 37,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8-9",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "Onlar artık o yüce topluluğu dinleyemezler, (bölgeden) uzaklaştırmak için üzerlerine her yönden atış yapılır; ayrıca onlar (âhirette de) bitmez bir azaba ­çarptırılacaklardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26577,
            "SureId": 37,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": false,
            "Page": 446,
            "AyetText": "Onlar artık o yüce topluluğu dinleyemezler, (bölgeden) uzaklaştırmak için üzerlerine her yönden atış yapılır; ayrıca onlar (âhirette de) bitmez bir azaba çarptırılacaklardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26584,
            "SureId": 37,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "Ancak, (o yüce topluluktan) bir bilgi kırıntısı kapan olursa onu da delip geçen bir ışık topu kovalar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26591,
            "SureId": 37,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "Şimdi o inkârcılardan şu sorunun cevabını iste: Kendilerini yaratmak mı daha zor, yoksa başka yarattıklarımızı mı? Biz onları yapışkan bir çamurdan yarattık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26598,
            "SureId": 37,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "Doğrusu sen hayranlık duydun, onlarsa alay etmektedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26605,
            "SureId": 37,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "Kendilerine öğüt verildiğinde gerekli öğüdü almıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26612,
            "SureId": 37,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "İlâhî bir işaret gördüklerinde alaya alıyorlar;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26619,
            "SureId": 37,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "Ve “Bu” diyorlar, “Apaçık sihirden başka bir şey değil.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26626,
            "SureId": 37,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "Sahi biz, ölüp de toprak ve kemik yığını haline gelmişken yeniden mi ­diriltilecekmişiz?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26633,
            "SureId": 37,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "Geçmişteki atalarımız da mı?”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26640,
            "SureId": 37,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "De ki: “Evet, hem de burnunuz yere sürtülerek!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26647,
            "SureId": 37,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 446,
            "AyetText": "Kuşkusuz o, bir tek korkunç sesten ibarettir; bunun ardından onlar şaşkınlıkla etrafa bakıyor olacaklar!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 26654,
            "SureId": 37,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 446,
