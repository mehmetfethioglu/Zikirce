    "QuranAyats": [
        {
            "Id": 14812,
            "SureId": 17,
            "AyetId": 87,
            "LanguageId": 7,
            "AyetNumber": "٨٧",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "اِلَّا رَحْمَةً مِنْ رَبِّكَؕ اِنَّ فَضْلَهُ كَانَ عَلَیْكَ كَبٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14819,
            "SureId": 17,
            "AyetId": 88,
            "LanguageId": 7,
            "AyetNumber": "٨٨",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "قُلْ لَئِنِ اجْتَمَعَتِ الْاِنْسُ وَالْجِنُّ عَلٰٓى اَنْ یَاْتُوا بِمِثْلِ هٰذَا الْقُرْاٰنِ لَا یَاْتُونَ بِمِثْلِهٖ وَلَوْ كَانَ بَعْضُهُمْ لِبَعْضٍ ظَهٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14826,
            "SureId": 17,
            "AyetId": 89,
            "LanguageId": 7,
            "AyetNumber": "٨٩",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "وَلَقَدْ صَرَّفْنَا لِلنَّاسِ فٖی هٰذَا الْقُرْاٰنِ مِنْ كُلِّ مَثَلٍؗ فَاَبٰٓى اَكْثَرُ النَّاسِ اِلَّا كُفُورًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14833,
            "SureId": 17,
            "AyetId": 90,
            "LanguageId": 7,
            "AyetNumber": "٩٠",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "وَقَالُوا لَنْ نُؤْمِنَ لَكَ حَتّٰى تَفْجُرَ لَنَا مِنَ الْاَرْضِ یَنْبُوعًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14840,
            "SureId": 17,
            "AyetId": 91,
            "LanguageId": 7,
            "AyetNumber": "٩١",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "اَوْ تَكُونَ لَكَ جَنَّةٌ مِنْ نَخٖیلٍ وَعِنَبٍ فَتُفَجِّرَ الْاَنْهَارَ خِلَالَهَا تَفْجٖیرًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14847,
            "SureId": 17,
            "AyetId": 92,
            "LanguageId": 7,
            "AyetNumber": "٩٢",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "اَوْ تُسْقِطَ السَّمَٓاءَ كَمَا زَعَمْتَ عَلَیْنَا كِسَفًا اَوْ تَاْتِیَ بِاللّٰهِ وَالْمَلٰٓئِكَةِ قَبٖیلًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14854,
            "SureId": 17,
            "AyetId": 93,
            "LanguageId": 7,
            "AyetNumber": "٩٣",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "اَوْ یَكُونَ لَكَ بَیْتٌ مِنْ زُخْرُفٍ اَوْ تَرْقٰى فِی السَّمَٓاءِؕ وَلَنْ نُؤْمِنَ لِرُقِیِّكَ حَتّٰى تُنَزِّلَ عَلَیْنَا كِتَابًا نَقْرَؤُ𐻾هُؕ قُلْ سُبْحَانَ رَبّٖی هَلْ كُنْتُ اِلَّا بَشَرًا رَسُولًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14861,
            "SureId": 17,
            "AyetId": 94,
            "LanguageId": 7,
            "AyetNumber": "٩٤",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "وَمَا مَنَعَ النَّاسَ اَنْ یُؤْمِنُٓوا اِذْ جَٓاءَهُمُ الْهُدٰٓى اِلَّٓا اَنْ قَالُٓوا اَبَعَثَ اللّٰهُ بَشَرًا رَسُولًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14868,
            "SureId": 17,
            "AyetId": 95,
            "LanguageId": 7,
            "AyetNumber": "٩٥",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "قُلْ لَوْ كَانَ فِی الْاَرْضِ مَلٰٓئِكَةٌ یَمْشُونَ مُطْمَئِنّٖینَ لَنَزَّلْنَا عَلَیْهِمْ مِنَ السَّمَٓاءِ مَلَكًا رَسُولًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14875,
            "SureId": 17,
            "AyetId": 96,
            "LanguageId": 7,
            "AyetNumber": "٩٦",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "قُلْ كَفٰى بِاللّٰهِ شَهٖیدًا بَیْنٖی وَبَیْنَكُمْؕ اِنَّهُ كَانَ بِعِبَادِهٖ خَبٖیرًا بَصٖیرًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 14810,
            "SureId": 17,
            "AyetId": 87,
            "LanguageId": 5,
            "AyetNumber": "87",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "Rabbinden bir rahmet gelmiş o başka. Onun sana ihsanı çok büyük olmuştur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 17,
                "MealInfo": "26,32,33 ve 57. âyetler ile 73-80. âyetler Medine döneminde, diğerleri Mekke döneminde inmiştir. 111 âyettir. Sûre, adını ilk âyetin konusu olan <b>“İsrâ”&nbsp;</b>olayından almıştır. <b>“Geceleyin yürütmek”</b> anlamına gelen <b>“İsrâ”</b>, Mîrac yolculuğunda, Hz. Peygamberin bir gece, Mekke’den Kudüs’e götürülmesini ifade eder. Sûrenin diğer bir adı da <b>“Benî İsrâil Sûresi”</b>dir.",
                "SureNameTurkish": "İsrâ",
                "SureNameArabic": "الْاِسْرَاۤءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 50,
                "AyetCount": 111,
                "Cuz": 15,
                "FirstPage": 282,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 14817,
            "SureId": 17,
            "AyetId": 88,
            "LanguageId": 5,
            "AyetNumber": "88",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "De ki: “Yemin ederim, bu Kur’an’ın bir benzerini ortaya koymak için insanlar ve cinler bir araya gelip birbirine destek olsa dahi onun benzerini ortaya koyamazlar.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14824,
            "SureId": 17,
            "AyetId": 89,
            "LanguageId": 5,
            "AyetNumber": "89",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "Muhakkak ki biz bu Kur’an’da insanlara (gerçekleri anlatmak için) her türlü misali denedik. Yine de insanların çoğu inkârcılıkta direndikçe direndiler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14831,
            "SureId": 17,
            "AyetId": 90,
            "LanguageId": 5,
            "AyetNumber": "90",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "Dediler ki: “Sen bizim için yerden bir kaynak fışkırtmadıkça sana asla inanmayacağız.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14838,
            "SureId": 17,
            "AyetId": 91,
            "LanguageId": 5,
            "AyetNumber": "91",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "“Veya senin bir hurma bahçen ve üzüm bağın olmalı; içlerinden de çağıl çağıl nehirler akıtmalısın.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14845,
            "SureId": 17,
            "AyetId": 92,
            "LanguageId": 5,
            "AyetNumber": "92",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "“Yahut -iddia ettiğin gibi- göğü üzerimize parça parça düşürmelisin veya Allah’ı ve melekleri karşımıza getirmelisin.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14852,
            "SureId": 17,
            "AyetId": 93,
            "LanguageId": 5,
            "AyetNumber": "93",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "“Veya altından bir evin olmalı; ya da göğe çıkmalısın. Bize okuyacağımız bir kitap indirmediğin sürece oraya çıktığına da asla inanmayacağız.” De ki: “Rabbimi tenzih ederim! Ben sadece bir beşer-peygamberim.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14859,
            "SureId": 17,
            "AyetId": 94,
            "LanguageId": 5,
            "AyetNumber": "94",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "Kendilerine kurtuluş rehberi (vahiy) geldiğinde insanların inanmalarını, ancak “Allah, peygamber olarak bir beşeri mi gönderdi?” şeklindeki itirazları engellemiştir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14866,
            "SureId": 17,
            "AyetId": 95,
            "LanguageId": 5,
            "AyetNumber": "95",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "De ki: “Yeryüzünde yerleşip dolaşan melekler bulunsaydı elbette onlara da peygamber olarak gökten bir melek gönderirdik.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 14873,
            "SureId": 17,
            "AyetId": 96,
            "LanguageId": 5,
            "AyetNumber": "96",
            "AyetVisible": true,
            "Page": 291,
            "AyetText": "Yine de ki: “Benimle sizin aranızda gerçek şahit olarak Allah kâfidir. O, kullarını çok iyi bilip görmektedir.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
