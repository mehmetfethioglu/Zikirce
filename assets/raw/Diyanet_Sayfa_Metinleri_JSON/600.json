            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "اِذَا زُلْزِلَتِ الْاَرْضُ زِلْزَالَهَاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 99,
                "MealInfo": "Medine döneminde inmiştir. 8 âyettir. Zilzâl, sarsıntı, deprem demektir.",
                "SureNameTurkish": "Zilzâl",
                "SureNameArabic": "الزِّلْزَالِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 93,
                "AyetCount": 8,
                "Cuz": 30,
                "FirstPage": 600,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42980,
            "SureId": 99,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "وَاَخْرَجَتِ الْاَرْضُ اَثْقَالَهَاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42987,
            "SureId": 99,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "وَقَالَ الْاِنْسَانُ مَا لَهَاۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42994,
            "SureId": 99,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "یَوْمَئِذٍ تُحَدِّثُ اَخْبَارَهَاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43001,
            "SureId": 99,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "بِاَنَّ رَبَّكَ اَوْحٰى لَهَاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43008,
            "SureId": 99,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "یَوْمَئِذٍ یَصْدُرُ النَّاسُ اَشْتَاتًا لِیُرَوْا اَعْمَالَهُمْؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43015,
            "SureId": 99,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "فَمَنْ یَعْمَلْ مِثْقَالَ ذَرَّةٍ خَیْرًا یَرَهُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43022,
            "SureId": 99,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "وَمَنْ یَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا یَرَهُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43029,
            "SureId": 100,
            "AyetId": 1,
            "LanguageId": 7,
            "AyetNumber": "١",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "وَالْعَادِیَاتِ ضَبْحًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 100,
                "MealInfo": "Mekke döneminde inmiştir. 11 âyettir. Âdiyât, hızlı koşan atlar demektir.",
                "SureNameTurkish": "Âdiyât",
                "SureNameArabic": "الْعَادِيَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 14,
                "AyetCount": 11,
                "Cuz": 30,
                "FirstPage": 600,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 43036,
            "SureId": 100,
            "AyetId": 2,
            "LanguageId": 7,
            "AyetNumber": "٢",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "فَالْمُورِیَاتِ قَدْحًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43043,
            "SureId": 100,
            "AyetId": 3,
            "LanguageId": 7,
            "AyetNumber": "٣",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "فَالْمُغٖیرَاتِ صُبْحًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43050,
            "SureId": 100,
            "AyetId": 4,
            "LanguageId": 7,
            "AyetNumber": "٤",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "فَاَثَرْنَ بِهٖ نَقْعًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43057,
            "SureId": 100,
            "AyetId": 5,
            "LanguageId": 7,
            "AyetNumber": "٥",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "فَوَسَطْنَ بِهٖ جَمْعًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43064,
            "SureId": 100,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "اِنَّ الْاِنْسَانَ لِرَبِّهٖ لَكَنُودٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43071,
            "SureId": 100,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "وَاِنَّهُ عَلٰى ذٰلِكَ لَشَهٖیدٌۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43078,
            "SureId": 100,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "وَاِنَّهُ لِحُبِّ الْخَیْرِ لَشَدٖیدٌؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43085,
            "SureId": 100,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "اَفَلَا یَعْلَمُ اِذَا بُعْثِرَ مَا فِی الْقُبُورِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43092,
            "SureId": 100,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "وَحُصِّلَ مَا فِی الصُّدُورِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43099,
            "SureId": 100,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "اِنَّ رَبَّهُمْ بِهِمْ یَوْمَئِذٍ لَخَبٖیرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 42971,
            "SureId": 99,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "Yer o dehşetli sarsıntısıyla sarsıldığında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 99,
                "MealInfo": "Medine döneminde inmiştir. 8 âyettir. Zilzâl, sarsıntı, deprem demektir.",
                "SureNameTurkish": "Zilzâl",
                "SureNameArabic": "الزِّلْزَالِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 93,
                "AyetCount": 8,
                "Cuz": 30,
                "FirstPage": 600,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 42978,
            "SureId": 99,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "Ve yer ağırlıklarını dışarı attığında;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42985,
            "SureId": 99,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "Ve insan, “Ne oluyor buna!” dediğinde;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42992,
            "SureId": 99,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4-5",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "O gün yer, bütün haberlerini rabbinin ona vahyettiği şekilde anlatır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 42999,
            "SureId": 99,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": false,
            "Page": 600,
            "AyetText": "O gün yer, bütün haberlerini rabbinin ona vahyettiği şekilde anlatır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43006,
            "SureId": 99,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "İşte o gün insanlar yaptıkları kendilerine gösterilsin diye (bulundukları yerden) farklı gruplar halinde çıkarlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43013,
            "SureId": 99,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "Kim zerre miktarı hayır yapmışsa onu (karşılığını) görür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43020,
            "SureId": 99,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "Kim de zerre miktarı şer işlemişse onu (karşılığını) görür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43027,
            "SureId": 100,
            "AyetId": 1,
            "LanguageId": 5,
            "AyetNumber": "1",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "Yemin olsun nefes nefese koşanlara;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 100,
                "MealInfo": "Mekke döneminde inmiştir. 11 âyettir. Âdiyât, hızlı koşan atlar demektir.",
                "SureNameTurkish": "Âdiyât",
                "SureNameArabic": "الْعَادِيَاتِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 14,
                "AyetCount": 11,
                "Cuz": 30,
                "FirstPage": 600,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 43034,
            "SureId": 100,
            "AyetId": 2,
            "LanguageId": 5,
            "AyetNumber": "2",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "Sonra çakarak kıvılcım saçanlara;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43041,
            "SureId": 100,
            "AyetId": 3,
            "LanguageId": 5,
            "AyetNumber": "3",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "Sabahleyin ansızın baskın yapanlara;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43048,
            "SureId": 100,
            "AyetId": 4,
            "LanguageId": 5,
            "AyetNumber": "4",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "Derken o sırada tozu dumana katanlara;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43055,
            "SureId": 100,
            "AyetId": 5,
            "LanguageId": 5,
            "AyetNumber": "5",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "Peşinden orada bir topluluğun ta ortasına dalanlara ki!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43062,
            "SureId": 100,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "İnsan, rabbine karşı pek nankördür.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43069,
            "SureId": 100,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "Şüphesiz buna kendisi de şahittir;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43076,
            "SureId": 100,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "O, aşırı derecede mal sevgisine kapılmıştır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43083,
            "SureId": 100,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "O bilmez mi ki kabirlerde bulunanlar diriltilip dışarı atıldığı zaman;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43090,
            "SureId": 100,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "Ve kalplerde gizlenenler ortaya konduğu zaman;",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 43097,
            "SureId": 100,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 600,
            "AyetText": "İşte o gün (anlayacaklar ki), rableri onlardan tam mânasıyla haberdardır!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
