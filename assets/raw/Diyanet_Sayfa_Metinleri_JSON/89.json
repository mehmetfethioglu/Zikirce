    "QuranAyats": [
        {
            "Id": 3913,
            "SureId": 4,
            "AyetId": 66,
            "LanguageId": 7,
            "AyetNumber": "٦٦",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "وَلَوْ اَنَّا كَتَبْنَا عَلَیْهِمْ اَنِ اقْتُلُٓوا اَنْفُسَكُمْ اَوِ اخْرُجُوا مِنْ دِیَارِكُمْ مَا فَعَلُوهُ اِلَّا قَلٖیلٌ مِنْهُمْؕ وَلَوْ اَنَّهُمْ فَعَلُوا مَا یُوعَظُونَ بِهٖ لَكَانَ خَیْرًا لَهُمْ وَاَشَدَّ تَثْبٖیتًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 4,
                "MealInfo": "Medine döneminde inmiştir. 176 âyettir. Sûre, özellikle kadın haklarından,onların hukûkî ve sosyal konumlarından bahsettiği için bu adı almıştır. <b>“Nisâ” kadınlar demektir.</b>",
                "SureNameTurkish": "Nisâ",
                "SureNameArabic": "النِّسَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 92,
                "AyetCount": 176,
                "Cuz": 4,
                "FirstPage": 77,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 3920,
            "SureId": 4,
            "AyetId": 67,
            "LanguageId": 7,
            "AyetNumber": "٦٧",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "وَاِذًا لَاٰتَیْنَاهُمْ مِنْ لَدُنَّٓا اَجْرًا عَظٖیمًاۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3927,
            "SureId": 4,
            "AyetId": 68,
            "LanguageId": 7,
            "AyetNumber": "٦٨",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "وَلَهَدَیْنَاهُمْ صِرَاطًا مُسْتَقٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3934,
            "SureId": 4,
            "AyetId": 69,
            "LanguageId": 7,
            "AyetNumber": "٦٩",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "وَمَنْ یُطِـعِ اللّٰهَ وَالرَّسُولَ فَاُو𐻾لٰٓئِكَ مَعَ الَّذٖینَ اَنْعَمَ اللّٰهُ عَلَیْهِمْ مِنَ النَّبِیّٖنَ وَالصِّدّٖیقٖینَ وَالشُّهَدَٓاءِ وَالصَّالِحٖینَۚ وَحَسُنَ اُو𐻾لٰٓئِكَ رَفٖیقًاؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3941,
            "SureId": 4,
            "AyetId": 70,
            "LanguageId": 7,
            "AyetNumber": "٧٠",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "ذٰلِكَ الْفَضْلُ مِنَ اللّٰهِؕ وَكَفٰى بِاللّٰهِ عَلٖیمًاࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3948,
            "SureId": 4,
            "AyetId": 71,
            "LanguageId": 7,
            "AyetNumber": "٧١",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "یَٓا اَیُّهَا الَّذٖینَ اٰمَنُوا خُذُوا حِذْرَكُمْ فَانْفِرُوا ثُبَاتٍ اَوِ انْفِرُوا جَمٖیعًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3955,
            "SureId": 4,
            "AyetId": 72,
            "LanguageId": 7,
            "AyetNumber": "٧٢",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "وَاِنَّ مِنْكُمْ لَمَنْ لَیُبَطِّئَنَّۚ فَاِنْ اَصَابَتْكُمْ مُصٖیبَةٌ قَالَ قَدْ اَنْعَمَ اللّٰهُ عَلَیَّ اِذْ لَمْ اَكُنْ مَعَهُمْ شَهٖیدًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3962,
            "SureId": 4,
            "AyetId": 73,
            "LanguageId": 7,
            "AyetNumber": "٧٣",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "وَلَئِنْ اَصَابَكُمْ فَضْلٌ مِنَ اللّٰهِ لَیَقُولَنَّ كَاَنْ لَمْ تَكُنْ بَیْنَكُمْ وَبَیْنَهُ مَوَدَّةٌ یَا لَیْتَنٖی كُنْتُ مَعَهُمْ فَاَفُوزَ فَوْزًا عَظٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3969,
            "SureId": 4,
            "AyetId": 74,
            "LanguageId": 7,
            "AyetNumber": "٧٤",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "فَلْیُقَاتِلْ فٖی سَبٖیلِ اللّٰهِ الَّذٖینَ یَشْرُونَ الْحَیٰوةَ الدُّنْیَا بِالْاٰخِرَةِؕ وَمَنْ یُقَاتِلْ فٖی سَبٖیلِ اللّٰهِ فَیُقْتَلْ اَوْ یَغْلِبْ فَسَوْفَ نُؤْتٖیهِ اَجْرًا عَظٖیمًا",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 3911,
            "SureId": 4,
            "AyetId": 66,
            "LanguageId": 5,
            "AyetNumber": "66",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "Eğer onlara kendinizi öldürün yahut yurtlarınızdan çıkın diye emretmiş olsaydık, pek azı müstesna bunu yapmazlardı. Eğer kendilerine verilen öğüdü yerine getirselerdi, bu onlar için hem daha hayırlı hem de (imanları için) daha sağlamlaştırıcı olurdu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 4,
                "MealInfo": "Medine döneminde inmiştir. 176 âyettir. Sûre, özellikle kadın haklarından,onların hukûkî ve sosyal konumlarından bahsettiği için bu adı almıştır. <b>“Nisâ” kadınlar demektir.</b>",
                "SureNameTurkish": "Nisâ",
                "SureNameArabic": "النِّسَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 92,
                "AyetCount": 176,
                "Cuz": 4,
                "FirstPage": 77,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 3918,
            "SureId": 4,
            "AyetId": 67,
            "LanguageId": 5,
            "AyetNumber": "67",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "O zaman elbette kendilerine nezdimizden büyük mükâfat verirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3925,
            "SureId": 4,
            "AyetId": 68,
            "LanguageId": 5,
            "AyetNumber": "68",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "Ve onları dosdoğru bir yola iletirdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3932,
            "SureId": 4,
            "AyetId": 69,
            "LanguageId": 5,
            "AyetNumber": "69",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "Kim Allah’a ve peygambere itaat ederse işte onlar, Allah’ın kendilerine lütuflarda bulunduğu peygamberler, sıddıklar, şehidler ve sâlih kişilerle beraberdirler; bunlar ne güzel arkadaşlardır!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3939,
            "SureId": 4,
            "AyetId": 70,
            "LanguageId": 5,
            "AyetNumber": "70",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "Bu lütuf Allah’tandır; bilen olarak Allah yeter.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3946,
            "SureId": 4,
            "AyetId": 71,
            "LanguageId": 5,
            "AyetNumber": "71",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "Ey iman edenler! Tedbirinizi alın da savaşa ya ayrı bölükler halinde çıkın veya hep birlikte çıkın.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3953,
            "SureId": 4,
            "AyetId": 72,
            "LanguageId": 5,
            "AyetNumber": "72",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "İçinizden bazıları vardır ki, pek ağırdan alır. Eğer başınıza bir felâket gelirse, “Allah yüzüme baktı da onlarla beraber bulunmadım” der.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3960,
            "SureId": 4,
            "AyetId": 73,
            "LanguageId": 5,
            "AyetNumber": "73",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "Eğer Allah’tan size bir lütuf erişirse, sanki sizinle onun arasında bir yakınlık olmamış gibi, “Keşke onlarla beraber olup ben de büyük bir kazanç elde etseydim” der.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 3967,
            "SureId": 4,
            "AyetId": 74,
            "LanguageId": 5,
            "AyetNumber": "74",
            "AyetVisible": true,
            "Page": 89,
            "AyetText": "O halde, dünya hayatını verip âhireti almak isteyenler Allah yolunda savaşsınlar. Kim Allah yolunda savaşır da öldürülür veya galip gelirse biz ona yakında büyük bir mükâfat vereceğiz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Nisâ",
    "QuranSureLabel": "النِّسَاءِ",
    "EndPageSure": null
}