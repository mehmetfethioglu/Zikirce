    "ArCuzNo": "۲۱",
    "ArPageNo": "٤۰٥",
    "QuranAyats": [
        {
            "Id": 23905,
            "SureId": 30,
            "AyetId": 6,
            "LanguageId": 7,
            "AyetNumber": "٦",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "وَعْدَ اللّٰهِؕ لَا یُخْلِفُ اللّٰهُ وَعْدَهُ وَلٰكِنَّ اَكْثَرَ النَّاسِ لَا یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 30,
                "MealInfo": "Mekke döneminde inmiştir. 60 âyettir. Sûre, adını ikinci âyette geçen <b>“erRûm”</b> kelimesinden almıştır. Sûre de başlıca <b>kıyametin hâllerinden, Allah’ın kudretine ve birliğine delalet eden kevnî meseleler ile Kureyş kabilesinin İslâm’a karşı olumsuz tutumu</b> konu edilmiştir.",
                "SureNameTurkish": "Rûm",
                "SureNameArabic": "الرُّومِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 84,
                "AyetCount": 60,
                "Cuz": 21,
                "FirstPage": 404,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 23912,
            "SureId": 30,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "یَعْلَمُونَ ظَاهِرًا مِنَ الْحَیٰوةِ الدُّنْیَاۚ وَهُمْ عَنِ الْاٰخِرَةِ هُمْ غَافِلُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23919,
            "SureId": 30,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "اَوَلَمْ یَتَفَكَّرُوا فٖٓی اَنْفُسِهِمْࣞ مَا خَلَقَ اللّٰهُ السَّمٰوَاتِ وَالْاَرْضَ وَمَا بَیْنَهُمَٓا اِلَّا بِالْحَقِّ وَاَجَلٍ مُسَمًّىؕ وَاِنَّ كَثٖیرًا مِنَ النَّاسِ بِلِقَٓائِ𐻾 رَبِّهِمْ لَكَافِرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23926,
            "SureId": 30,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "اَوَلَمْ یَسٖیرُوا فِی الْاَرْضِ فَیَنْظُرُوا كَیْفَ كَانَ عَاقِبَةُ الَّذٖینَ مِنْ قَبْلِهِمْؕ كَانُٓوا اَشَدَّ مِنْهُمْ قُوَّةً وَاَثَارُوا الْاَرْضَ وَعَمَرُوهَٓا اَكْثَرَ مِمَّا عَمَرُوهَا وَجَٓاءَتْهُمْ رُسُلُهُمْ بِالْبَیِّنَاتِؕ فَمَا كَانَ اللّٰهُ لِیَظْلِمَهُمْ وَلٰكِنْ كَانُٓوا اَنْفُسَهُمْ یَظْلِمُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23933,
            "SureId": 30,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "ثُمَّ كَانَ عَاقِبَةَ الَّذٖینَ اَسَٓاؤُا السُّٓوآٰى اَنْ كَذَّبُوا بِاٰیَاتِ اللّٰهِ وَكَانُوا بِهَا یَسْتَهْزِؤُ𐻿نَࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23940,
            "SureId": 30,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "اَللّٰهُ یَبْدَؤُا الْخَلْقَ ثُمَّ یُعٖیدُهُ ثُمَّ اِلَیْهِ تُرْجَعُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23947,
            "SureId": 30,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "وَیَوْمَ تَقُومُ السَّاعَةُ یُبْلِسُ الْمُجْرِمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23954,
            "SureId": 30,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "وَلَمْ یَكُنْ لَهُمْ مِنْ شُرَكَٓائِهِمْ شُفَعٰٓؤُ𐻾ا وَكَانُوا بِشُرَكَٓائِهِمْ كَافِرٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23961,
            "SureId": 30,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "وَیَوْمَ تَقُومُ السَّاعَةُ یَوْمَئِذٍ یَتَفَرَّقُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23968,
            "SureId": 30,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "فَاَمَّا الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَهُمْ فٖی رَوْضَةٍ یُحْبَرُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 23903,
            "SureId": 30,
            "AyetId": 6,
            "LanguageId": 5,
            "AyetNumber": "6",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "Bu Allah’ın vaadidir. Allah vaadinden caymaz; ama insanların çoğu bunu bilmezler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 30,
                "MealInfo": "Mekke döneminde inmiştir. 60 âyettir. Sûre, adını ikinci âyette geçen <b>“erRûm”</b> kelimesinden almıştır. Sûre de başlıca <b>kıyametin hâllerinden, Allah’ın kudretine ve birliğine delalet eden kevnî meseleler ile Kureyş kabilesinin İslâm’a karşı olumsuz tutumu</b> konu edilmiştir.",
                "SureNameTurkish": "Rûm",
                "SureNameArabic": "الرُّومِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 84,
                "AyetCount": 60,
                "Cuz": 21,
                "FirstPage": 404,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 23910,
            "SureId": 30,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "Onlar dünya hayatının sadece görünen yüzünü kısmen bilirler; âhiret hakkında ise tamamen gaflet içindedirler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23917,
            "SureId": 30,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "Kendi kendilerine bir düşünmezler mi? Allah gökleri, yeri ve bunlar arasında bulunanları ancak hikmet temelinde, belli bir süreye kadar kalmak üzere yaratmıştır. Fakat şu bir gerçek ki insanların birçoğu rablerine kavuşmayı hâlâ inkâr etmektedir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23924,
            "SureId": 30,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "Yeryüzünde gezip de kendilerinden öncekilerin sonu ne olmuş görmezler mi? Onlar kendilerinden çok daha kudretliydiler; toprağı iyice işlemişler, yeryüzünü bunların imar ettiğinden daha fazla imar etmişlerdi. Onlara da peygamberleri nice açık kanıtlar getirmişti. Şu halde Allah onlara asla zulmetmiş değildir, asıl onlar kendilerine zulmetmişlerdir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23931,
            "SureId": 30,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "Sonunda, Allah’ın âyetlerini yalan saymak ve onları alaya almak suretiyle kötülükte ileri gidenlerin âkıbeti pek fena oldu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23938,
            "SureId": 30,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "Allah, varlığı ilkin yaratır, sonra bunu tekrar eder. Sonunda da O’na döndürüleceksiniz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23945,
            "SureId": 30,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "Kıyamet koptuğu gün, günahkârlar ümitsiz ve şaşkın kalıverecekler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23952,
            "SureId": 30,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "Allah’a ortak koştukları arasında hiç şefaatçileri olmayacak, zaten kendileri de ortak koştuklarının tanrılığını reddedecekler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23959,
            "SureId": 30,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "Yine kıyamet koptuğunda, işte o gün insanlar birbirinden ayrılacaklar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 23966,
            "SureId": 30,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 405,
            "AyetText": "İman edip dünya ve âhirete yararlı işler yapanlar güzel bir bahçede (cennette) ağırlanırlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Rûm",
    "QuranSureLabel": "الرُّومِ",
    "EndPageSure": null
}