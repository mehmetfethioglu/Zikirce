    "QuranAyats": [
        {
            "Id": 33971,
            "SureId": 54,
            "AyetId": 7,
            "LanguageId": 7,
            "AyetNumber": "٧",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "خُشَّعًا اَبْصَارُهُمْ یَخْرُجُونَ مِنَ الْاَجْدَاثِ كَاَنَّهُمْ جَرَادٌ مُنْتَشِرٌۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 54,
                "MealInfo": "Mekke döneminde inmiştir. 55 âyettir. Sûre, adını ilk âyette geçen <b>“el-Kamer” </b>kelimesinden almıştır. <b>Kamer, ay demektir</b>. Sûre de ana fikir olarak, <b>Kur’an’ı yalanlayanlar, çeşitli azap ve helâk örnekleri</b> de verilerek uyarılmaktadır.",
                "SureNameTurkish": "Kamer",
                "SureNameArabic": "الْقَمَرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 37,
                "AyetCount": 55,
                "Cuz": 27,
                "FirstPage": 528,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33978,
            "SureId": 54,
            "AyetId": 8,
            "LanguageId": 7,
            "AyetNumber": "٨",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "مُهْطِعٖینَ اِلَى الدَّاعِؕ یَقُولُ الْكَافِرُونَ هٰذَا یَوْمٌ عَسِرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33985,
            "SureId": 54,
            "AyetId": 9,
            "LanguageId": 7,
            "AyetNumber": "٩",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ فَكَذَّبُوا عَبْدَنَا وَقَالُوا مَجْنُونٌ وَازْدُجِرَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33992,
            "SureId": 54,
            "AyetId": 10,
            "LanguageId": 7,
            "AyetNumber": "١٠",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "فَدَعَا رَبَّهُٓ اَنّٖی مَغْلُوبٌ فَانْتَصِرْ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33999,
            "SureId": 54,
            "AyetId": 11,
            "LanguageId": 7,
            "AyetNumber": "١١",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "فَفَتَحْنَٓا اَبْوَابَ السَّمَٓاءِ بِمَٓاءٍ مُنْهَمِرٍؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34006,
            "SureId": 54,
            "AyetId": 12,
            "LanguageId": 7,
            "AyetNumber": "١٢",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "وَفَجَّرْنَا الْاَرْضَ عُیُونًا فَالْتَقَى الْمَٓاءُ عَلٰٓى اَمْرٍ قَدْ قُدِرَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34013,
            "SureId": 54,
            "AyetId": 13,
            "LanguageId": 7,
            "AyetNumber": "١٣",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "وَحَمَلْنَاهُ عَلٰى ذَاتِ اَلْوَاحٍ وَدُسُرٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34020,
            "SureId": 54,
            "AyetId": 14,
            "LanguageId": 7,
            "AyetNumber": "١٤",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "تَجْرٖی بِاَعْیُنِنَاۚ جَزَٓاءً لِمَنْ كَانَ كُفِرَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34027,
            "SureId": 54,
            "AyetId": 15,
            "LanguageId": 7,
            "AyetNumber": "١٥",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "وَلَقَدْ تَرَكْنَاهَٓا اٰیَةً فَهَلْ مِنْ مُدَّكِرٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34034,
            "SureId": 54,
            "AyetId": 16,
            "LanguageId": 7,
            "AyetNumber": "١٦",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "فَكَیْفَ كَانَ عَذَابٖی وَنُذُرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34041,
            "SureId": 54,
            "AyetId": 17,
            "LanguageId": 7,
            "AyetNumber": "١٧",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "وَلَقَدْ یَسَّرْنَا الْقُرْاٰنَ لِلذِّكْرِ فَهَلْ مِنْ مُدَّكِرٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34048,
            "SureId": 54,
            "AyetId": 18,
            "LanguageId": 7,
            "AyetNumber": "١٨",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "كَذَّبَتْ عَادٌ فَكَیْفَ كَانَ عَذَابٖی وَنُذُرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34055,
            "SureId": 54,
            "AyetId": 19,
            "LanguageId": 7,
            "AyetNumber": "١٩",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "اِنَّٓا اَرْسَلْنَا عَلَیْهِمْ رٖیحًا صَرْصَرًا فٖی یَوْمِ نَحْسٍ مُسْتَمِرٍّۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34062,
            "SureId": 54,
            "AyetId": 20,
            "LanguageId": 7,
            "AyetNumber": "٢٠",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "تَنْزِعُ النَّاسَۙ كَاَنَّهُمْ اَعْجَازُ نَخْلٍ مُنْقَعِرٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34069,
            "SureId": 54,
            "AyetId": 21,
            "LanguageId": 7,
            "AyetNumber": "٢١",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "فَكَیْفَ كَانَ عَذَابٖی وَنُذُرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34076,
            "SureId": 54,
            "AyetId": 22,
            "LanguageId": 7,
            "AyetNumber": "٢٢",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "وَلَقَدْ یَسَّرْنَا الْقُرْاٰنَ لِلذِّكْرِ فَهَلْ مِنْ مُدَّكِرٍࣖ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34083,
            "SureId": 54,
            "AyetId": 23,
            "LanguageId": 7,
            "AyetNumber": "٢٣",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "كَذَّبَتْ ثَمُودُ بِالنُّذُرِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34090,
            "SureId": 54,
            "AyetId": 24,
            "LanguageId": 7,
            "AyetNumber": "٢٤",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "فَقَالُٓوا اَبَشَرًا مِنَّا وَاحِدًا نَتَّبِعُهُٓۙ اِنَّٓا اِذًا لَفٖی ضَلَالٍ وَسُعُرٍ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34097,
            "SureId": 54,
            "AyetId": 25,
            "LanguageId": 7,
            "AyetNumber": "٢٥",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "ءَاُلْقِیَ الذِّكْرُ عَلَیْهِ مِنْ بَیْنِنَا بَلْ هُوَ كَذَّابٌ اَشِرٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34104,
            "SureId": 54,
            "AyetId": 26,
            "LanguageId": 7,
            "AyetNumber": "٢٦",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "سَیَعْلَمُونَ غَدًا مَنِ الْكَذَّابُ الْاَشِرُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34111,
            "SureId": 54,
            "AyetId": 27,
            "LanguageId": 7,
            "AyetNumber": "٢٧",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "اِنَّا مُرْسِلُوا النَّاقَةِ فِتْنَةً لَهُمْ فَارْتَقِبْهُمْ وَاصْطَبِرْؗ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 33969,
            "SureId": 54,
            "AyetId": 7,
            "LanguageId": 5,
            "AyetNumber": "7-8",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Gözlerini korku bürümüş halde kabirlerinden çıkıp etrafa yayılmış çekirgeler gibi o çağrıcıya doğru koşarlar. İnkârcılar, “Bu, gerçekten zor bir gün!” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 54,
                "MealInfo": "Mekke döneminde inmiştir. 55 âyettir. Sûre, adını ilk âyette geçen <b>“el-Kamer” </b>kelimesinden almıştır. <b>Kamer, ay demektir</b>. Sûre de ana fikir olarak, <b>Kur’an’ı yalanlayanlar, çeşitli azap ve helâk örnekleri</b> de verilerek uyarılmaktadır.",
                "SureNameTurkish": "Kamer",
                "SureNameArabic": "الْقَمَرِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 37,
                "AyetCount": 55,
                "Cuz": 27,
                "FirstPage": 528,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33976,
            "SureId": 54,
            "AyetId": 8,
            "LanguageId": 5,
            "AyetNumber": "8",
            "AyetVisible": false,
            "Page": 529,
            "AyetText": "Gözlerini korku bürümüş halde kabirlerinden çıkıp etrafa yayılmış çekirgeler gibi o çağrıcıya doğru koşarlar. İnkârcılar, \"Bu, gerçekten zor bir gün!\" derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33983,
            "SureId": 54,
            "AyetId": 9,
            "LanguageId": 5,
            "AyetNumber": "9",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Bunlardan önce Nûh’un kavmi de (peygamberlerini) yalancılıkla itham etmişti. O kulumuzu yalancı saydılar, “Delinin biri!” dediler ve o görevinden alıkondu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33990,
            "SureId": 54,
            "AyetId": 10,
            "LanguageId": 5,
            "AyetNumber": "10",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Bunun üzerine Nûh, “Artık yenik düştüm; yardımını esirgeme!” diye rabbine yalvardı.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33997,
            "SureId": 54,
            "AyetId": 11,
            "LanguageId": 5,
            "AyetNumber": "11",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Hemen göğün kapılarını bardaktan boşanırcasına inen bir yağmura açtık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34004,
            "SureId": 54,
            "AyetId": 12,
            "LanguageId": 5,
            "AyetNumber": "12",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Yerden de sular fışkırttık; derken sular önceden belirlenmiş bir iş için birleşti.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34011,
            "SureId": 54,
            "AyetId": 13,
            "LanguageId": 5,
            "AyetNumber": "13",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Onu tahtalar ve mıhlarla yapılmış gemide taşıdık.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34018,
            "SureId": 54,
            "AyetId": 14,
            "LanguageId": 5,
            "AyetNumber": "14",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Gözetim ve korumamız altında akıp gidiyordu, kendisine inanılmamış olan o kulumuza bir mükâfat olmak üzere.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34025,
            "SureId": 54,
            "AyetId": 15,
            "LanguageId": 5,
            "AyetNumber": "15",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Andolsun, bunu bir ibret levhası olarak bıraktık; ibret alacak yok mu?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34032,
            "SureId": 54,
            "AyetId": 16,
            "LanguageId": 5,
            "AyetNumber": "16",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Azabım ve uyarılarım nasılmış görün!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34039,
            "SureId": 54,
            "AyetId": 17,
            "LanguageId": 5,
            "AyetNumber": "17",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Andolsun ki Kur’an’ı düşünülsün diye kolaylaştırdık. Düşünecek yok mu?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34046,
            "SureId": 54,
            "AyetId": 18,
            "LanguageId": 5,
            "AyetNumber": "18",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Âd kavmi de (peygamberlerini) yalancılıkla itham etti. Azabım ve uyarılarım nasılmış bir bakın!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34053,
            "SureId": 54,
            "AyetId": 19,
            "LanguageId": 5,
            "AyetNumber": "19",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Onların üzerine bitmek bilmeyen o kara günde şiddetli bir kasırga gönderdik.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34060,
            "SureId": 54,
            "AyetId": 20,
            "LanguageId": 5,
            "AyetNumber": "20",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "İnsanları sökülmüş hurma kütükleri gibi çekip alıyordu.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34067,
            "SureId": 54,
            "AyetId": 21,
            "LanguageId": 5,
            "AyetNumber": "21",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Azabım ve uyarılarım nasılmış bir bakın!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34074,
            "SureId": 54,
            "AyetId": 22,
            "LanguageId": 5,
            "AyetNumber": "22",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Andolsun ki Kur’an’ı düşünülsün diye kolaylaştırdık. Düşünecek yok mu?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34081,
            "SureId": 54,
            "AyetId": 23,
            "LanguageId": 5,
            "AyetNumber": "23",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Semûd kavmi de uyarıları ciddiye almadılar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34088,
            "SureId": 54,
            "AyetId": 24,
            "LanguageId": 5,
            "AyetNumber": "24",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Dediler ki: “İçimizden tek başına bir beşere mi uyacağız? O takdirde doğru yoldan sapmış olur, yanarız.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34095,
            "SureId": 54,
            "AyetId": 25,
            "LanguageId": 5,
            "AyetNumber": "25",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "İlâhî mesaj içimizden ona mı gönderilmiş? Hayır o, yalancının, küstahın biri!”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34102,
            "SureId": 54,
            "AyetId": 26,
            "LanguageId": 5,
            "AyetNumber": "26",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "Yarın onlar asıl yalancı, küstah kimmiş görecekler!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 34109,
            "SureId": 54,
            "AyetId": 27,
            "LanguageId": 5,
            "AyetNumber": "27",
            "AyetVisible": true,
            "Page": 529,
            "AyetText": "(Allah Sâlih peygambere şöyle buyurdu:) “Şüphesiz biz (mucizevi özelliği olan o deveyi) onları sınamak için göndermiş bulunuyoruz. Şimdi sen onların ne yapacağını izle ve sabret.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
