{
    "PointerList": null,
    "CuzNo": 27,
    "PageNo": 525,
    "ArCuzNo": "۲۷",
    "ArPageNo": "٥۲٥",
    "QuranAyats": [
        {
            "Id": 33369,
            "SureId": 52,
            "AyetId": 32,
            "LanguageId": 7,
            "AyetNumber": "٣٢",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "اَمْ تَاْمُرُهُمْ اَحْلَامُهُمْ بِهٰذَٓا اَمْ هُمْ قَوْمٌ طَاغُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 52,
                "MealInfo": "Mekke döneminde inmiştir. 49 âyettir. Sûre, adını birinci âyette geçen <b>“etTûr”</b> kelimesinden almıştır. <b>Tûr, dağ demektir.</b> Burada <b>Hz. Mûsâ’</b>ya ilk vahyin geldiği, Sina Yarımadası’nın güneyindeki <b>Sina dağı</b> kastedilmektedir. Sûrede başlıca, <b>ahiret hâlleri, kâfirlerin karşılaşacakları ceza, mü’minlerin mükâfatları konu edilmekte ve müşriklerin Hz. Peygamber hakkındaki batıl iddiaları</b> reddedilmektedir.",
                "SureNameTurkish": "Tûr",
                "SureNameArabic": "الطُّورِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 76,
                "AyetCount": 49,
                "Cuz": 27,
                "FirstPage": 523,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33376,
            "SureId": 52,
            "AyetId": 33,
            "LanguageId": 7,
            "AyetNumber": "٣٣",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "اَمْ یَقُولُونَ تَقَوَّلَهُۚ بَلْ لَا یُؤْمِنُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33383,
            "SureId": 52,
            "AyetId": 34,
            "LanguageId": 7,
            "AyetNumber": "٣٤",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "فَلْیَاْتُوا بِحَدٖیثٍ مِثْلِهٖٓ اِنْ كَانُوا صَادِقٖینَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33390,
            "SureId": 52,
            "AyetId": 35,
            "LanguageId": 7,
            "AyetNumber": "٣٥",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "اَمْ خُلِقُوا مِنْ غَیْرِ شَیْءٍ اَمْ هُمُ الْخَالِقُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33397,
            "SureId": 52,
            "AyetId": 36,
            "LanguageId": 7,
            "AyetNumber": "٣٦",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "اَمْ خَلَقُوا السَّمٰوَاتِ وَالْاَرْضَۚ بَلْ لَا یُوقِنُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33404,
            "SureId": 52,
            "AyetId": 37,
            "LanguageId": 7,
            "AyetNumber": "٣٧",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "اَمْ عِنْدَهُمْ خَزَٓائِنُ رَبِّكَ اَمْ هُمُ الْمُصَیْطِرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33411,
            "SureId": 52,
            "AyetId": 38,
            "LanguageId": 7,
            "AyetNumber": "٣٨",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "اَمْ لَهُمْ سُلَّمٌ یَسْتَمِعُونَ فٖیهِۚ فَلْیَاْتِ مُسْتَمِعُهُمْ بِسُلْطَانٍ مُبٖینٍؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33418,
            "SureId": 52,
            "AyetId": 39,
            "LanguageId": 7,
            "AyetNumber": "٣٩",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "اَمْ لَهُ الْبَنَاتُ وَلَكُمُ الْبَنُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33425,
            "SureId": 52,
            "AyetId": 40,
            "LanguageId": 7,
            "AyetNumber": "٤٠",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "اَمْ تَسْـَٔلُهُمْ اَجْرًا فَهُمْ مِنْ مَغْرَمٍ مُثْقَلُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33432,
            "SureId": 52,
            "AyetId": 41,
            "LanguageId": 7,
            "AyetNumber": "٤١",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "اَمْ عِنْدَهُمُ الْغَیْبُ فَهُمْ یَكْتُبُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33439,
            "SureId": 52,
            "AyetId": 42,
            "LanguageId": 7,
            "AyetNumber": "٤٢",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "اَمْ یُرٖیدُونَ كَیْدًاؕ فَالَّذٖینَ كَفَرُوا هُمُ الْمَكٖیدُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33446,
            "SureId": 52,
            "AyetId": 43,
            "LanguageId": 7,
            "AyetNumber": "٤٣",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "اَمْ لَهُمْ اِلٰهٌ غَیْرُ اللّٰهِؕ سُبْحَانَ اللّٰهِ عَمَّا یُشْرِكُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33453,
            "SureId": 52,
            "AyetId": 44,
            "LanguageId": 7,
            "AyetNumber": "٤٤",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "وَاِنْ یَرَوْا كِسْفًا مِنَ السَّمَٓاءِ سَاقِطًا یَقُولُوا سَحَابٌ مَرْكُومٌ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33460,
            "SureId": 52,
            "AyetId": 45,
            "LanguageId": 7,
            "AyetNumber": "٤٥",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "فَذَرْهُمْ حَتّٰى یُلَاقُوا یَوْمَهُمُ الَّذٖی فٖیهِ یُصْعَقُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33467,
            "SureId": 52,
            "AyetId": 46,
            "LanguageId": 7,
            "AyetNumber": "٤٦",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "یَوْمَ لَا یُغْنٖی عَنْهُمْ كَیْدُهُمْ شَیْـًٔا وَلَا هُمْ یُنْصَرُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33474,
            "SureId": 52,
            "AyetId": 47,
            "LanguageId": 7,
            "AyetNumber": "٤٧",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "وَاِنَّ لِلَّذٖینَ ظَلَمُوا عَذَابًا دُونَ ذٰلِكَ وَلٰكِنَّ اَكْثَرَهُمْ لَا یَعْلَمُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33481,
            "SureId": 52,
            "AyetId": 48,
            "LanguageId": 7,
            "AyetNumber": "٤٨",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "وَاصْبِرْ لِحُكْمِ رَبِّكَ فَاِنَّكَ بِاَعْیُنِنَا وَسَبِّـحْ بِحَمْدِ رَبِّكَ حٖینَ تَقُومُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33488,
            "SureId": 52,
            "AyetId": 49,
            "LanguageId": 7,
            "AyetNumber": "٤٩",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "وَمِنَ الَّیْلِ فَسَبِّحْهُ وَاِدْبَارَ النُّجُومِ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 33367,
            "SureId": 52,
            "AyetId": 32,
            "LanguageId": 5,
            "AyetNumber": "32",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Bunu onlara akılları mı emrediyor yoksa onlar azmış bir topluluk mu?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 52,
                "MealInfo": "Mekke döneminde inmiştir. 49 âyettir. Sûre, adını birinci âyette geçen <b>“etTûr”</b> kelimesinden almıştır. <b>Tûr, dağ demektir.</b> Burada <b>Hz. Mûsâ’</b>ya ilk vahyin geldiği, Sina Yarımadası’nın güneyindeki <b>Sina dağı</b> kastedilmektedir. Sûrede başlıca, <b>ahiret hâlleri, kâfirlerin karşılaşacakları ceza, mü’minlerin mükâfatları konu edilmekte ve müşriklerin Hz. Peygamber hakkındaki batıl iddiaları</b> reddedilmektedir.",
                "SureNameTurkish": "Tûr",
                "SureNameArabic": "الطُّورِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": false,
                "InisOrder": 76,
                "AyetCount": 49,
                "Cuz": 27,
                "FirstPage": 523,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 33374,
            "SureId": 52,
            "AyetId": 33,
            "LanguageId": 5,
            "AyetNumber": "33",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "“Onu kendisi uydurmuştur” diyorlar öyle mi? Hayır hayır; inanmıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33381,
            "SureId": 52,
            "AyetId": 34,
            "LanguageId": 5,
            "AyetNumber": "34",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Eğer doğru sözlü iseler onun benzeri bir söz getirsinler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33388,
            "SureId": 52,
            "AyetId": 35,
            "LanguageId": 5,
            "AyetNumber": "35",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Acaba onlar bir yaratıcı bulunmadan mı yaratıldılar, yoksa yaratıcı kendileri midir?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33395,
            "SureId": 52,
            "AyetId": 36,
            "LanguageId": 5,
            "AyetNumber": "36",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Yoksa gökleri ve yeri onlar mı yaratmışlar? Hayır hayır! Onlar bir türlü idrak edip inanmıyorlar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33402,
            "SureId": 52,
            "AyetId": 37,
            "LanguageId": 5,
            "AyetNumber": "37",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Yoksa rabbinin hazineleri onların yanında mıdır? Yoksa her şeye egemen olan onlar mı?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33409,
            "SureId": 52,
            "AyetId": 38,
            "LanguageId": 5,
            "AyetNumber": "38",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Yoksa onların, üstüne çıkıp gizli şeyleri dinleyecekleri bir merdivenleri mi var? Eğer öyleyse, içlerinden dinleyen biri açık bir kanıt getirsin.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33416,
            "SureId": 52,
            "AyetId": 39,
            "LanguageId": 5,
            "AyetNumber": "39",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Kızlar O’na, erkek çocuklar da size öyle mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33423,
            "SureId": 52,
            "AyetId": 40,
            "LanguageId": 5,
            "AyetNumber": "40",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "(Resulüm!) Yoksa sen onlardan bir ücret istiyorsun da, onlar bunun ağırlığı altında mı eziliyorlar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33430,
            "SureId": 52,
            "AyetId": 41,
            "LanguageId": 5,
            "AyetNumber": "41",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Ya da gayb bilgisi kendilerinin yanında da onlar (buradan alıp) mı yazıyorlar?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33437,
            "SureId": 52,
            "AyetId": 42,
            "LanguageId": 5,
            "AyetNumber": "42",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Yoksa bir tuzak mı kurmak istiyorlar? Ama asıl tuzağa düşecek olanlar inkârcıların kendileridir!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33444,
            "SureId": 52,
            "AyetId": 43,
            "LanguageId": 5,
            "AyetNumber": "43",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Yoksa onların Allah’tan başka bir tanrıları mı var? Allah onların yakıştırdıkları ortaklardan tamamıyla münezzehtir.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33451,
            "SureId": 52,
            "AyetId": 44,
            "LanguageId": 5,
            "AyetNumber": "44",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Gökten bir kütlenin düşmekte olduğunu görseler, yine de “Bunlar üst üste yığılmış bulutlar” derler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33458,
            "SureId": 52,
            "AyetId": 45,
            "LanguageId": 5,
            "AyetNumber": "45",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Artık dehşete kapılacakları gün ile yüzyüze gelinceye kadar onları kendi halleriyle baş başa bırak.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33465,
            "SureId": 52,
            "AyetId": 46,
            "LanguageId": 5,
            "AyetNumber": "46",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Kurdukları planlar o gün kendilerine hiçbir yarar sağlamayacak ve kendilerine yardım eden de olmayacak!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33472,
            "SureId": 52,
            "AyetId": 47,
            "LanguageId": 5,
            "AyetNumber": "47",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Şüphesiz o zulmedenlere bundan başka (dünyada başlarına gelecek) bir azap daha var; fakat çoğu bunu bilmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33479,
            "SureId": 52,
            "AyetId": 48,
            "LanguageId": 5,
            "AyetNumber": "48",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Sen rabbinin hükmünü sabırla bekle, kuşkusuz sen bizim gözetim ve korumamız altındasın. Her kalktığında rabbini hamd ile tesbih et.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 33486,
            "SureId": 52,
            "AyetId": 49,
            "LanguageId": 5,
            "AyetNumber": "49",
            "AyetVisible": true,
            "Page": 525,
            "AyetText": "Gecenin bir kısmında ve yıldızlar çekildiğinde de O’nu tesbih et.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "TefsirList": null,
    "MealSureLabel": "Tûr",
    "QuranSureLabel": "الطُّورِ",
