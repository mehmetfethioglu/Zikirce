            }
        },
        {
            "Id": 21978,
            "SureId": 26,
            "AyetId": 208,
            "LanguageId": 5,
            "AyetNumber": "208-209",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Kaldı ki biz, öğüt vermek üzere uyarıcılar göndermeden hiçbir ülke halkını yok etmemişizdir. Biz zalim değiliz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21985,
            "SureId": 26,
            "AyetId": 209,
            "LanguageId": 5,
            "AyetNumber": "209",
            "AyetVisible": false,
            "Page": 376,
            "AyetText": "Kaldı ki biz, öğüt vermek üzere uyarıcılar göndermeden hiçbir ülke halkını yok etmemişizdir. Biz zalim değiliz.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21992,
            "SureId": 26,
            "AyetId": 210,
            "LanguageId": 5,
            "AyetNumber": "210-211",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Onu (ilâhî öğüdü) şeytanlar indirmedi. Bu onların yapacağı iş değildir, zaten buna güçleri de yetmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21999,
            "SureId": 26,
            "AyetId": 211,
            "LanguageId": 5,
            "AyetNumber": "211",
            "AyetVisible": false,
            "Page": 376,
            "AyetText": "Onu (ilâhî öğüdü) şeytanlar indirmedi. Bu onların yapacağı iş değildir, zaten buna güçleri de yetmez.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22006,
            "SureId": 26,
            "AyetId": 212,
            "LanguageId": 5,
            "AyetNumber": "212",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Şüphesiz onlar, vahyi işitmekten kesinlikle uzak tutulmuşlardır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22013,
            "SureId": 26,
            "AyetId": 213,
            "LanguageId": 5,
            "AyetNumber": "213",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "O halde sakın Allah ile birlikte başka tanrıya kulluk edip yalvarma, sonra cezaya çarptırılanlardan olursun!",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22020,
            "SureId": 26,
            "AyetId": 214,
            "LanguageId": 5,
            "AyetNumber": "214",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Yakın akrabanı da uyar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22027,
            "SureId": 26,
            "AyetId": 215,
            "LanguageId": 5,
            "AyetNumber": "215",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Sana uyan müminlere kol kanat ger.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22034,
            "SureId": 26,
            "AyetId": 216,
            "LanguageId": 5,
            "AyetNumber": "216",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Şayet sana karşı gelirlerse de ki: “Ben sizin yaptıklarınızdan kesinlikle uzağım.”",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22041,
            "SureId": 26,
            "AyetId": 217,
            "LanguageId": 5,
            "AyetNumber": "217-219",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Sen, O, mutlak güçlü ve engin merhamet sahibi olan, huzurunda durduğun ve secde edenler içinde halden hale girdiğin zaman seni gören Allah’a güvenip dayan.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22048,
            "SureId": 26,
            "AyetId": 218,
            "LanguageId": 5,
            "AyetNumber": "218",
            "AyetVisible": false,
            "Page": 376,
            "AyetText": "Sen, O, mutlak güçlü ve engin merhamet sahibi olan, huzurunda durduğun ve secde edenler içinde halden hale girdiğin zaman seni gören Allah’a güvenip dayan.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22055,
            "SureId": 26,
            "AyetId": 219,
            "LanguageId": 5,
            "AyetNumber": "219",
            "AyetVisible": false,
            "Page": 376,
            "AyetText": "Sen, O, mutlak güçlü ve engin merhamet sahibi olan, huzurunda durduğun ve secde edenler içinde halden hale girdiğin zaman seni gören Allah’a güvenip dayan.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22062,
            "SureId": 26,
            "AyetId": 220,
            "LanguageId": 5,
            "AyetNumber": "220",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Her şeyi işiten, bilen O’dur.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22069,
            "SureId": 26,
            "AyetId": 221,
            "LanguageId": 5,
            "AyetNumber": "221",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Şeytanların kime ineceğini size haber vereyim mi?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22076,
            "SureId": 26,
            "AyetId": 222,
            "LanguageId": 5,
            "AyetNumber": "222",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Onlar günaha, iftiraya düşkün olan herkese inerler (onlara kötülüğü telkin ederler).",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22083,
            "SureId": 26,
            "AyetId": 223,
            "LanguageId": 5,
            "AyetNumber": "223",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Bunlar, (şeytanlara) kulak verirler, çoğu da yalancıdır.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22090,
            "SureId": 26,
            "AyetId": 224,
            "LanguageId": 5,
            "AyetNumber": "224",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Şairlere gelince, onlara da yoldan sapanlar uyar.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22097,
            "SureId": 26,
            "AyetId": 225,
            "LanguageId": 5,
            "AyetNumber": "225-226",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Onların her vadide şaşkın şaşkın dolaştıklarını ve gerçekte yapmadıkları şeyleri söylediklerini görmez misin?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22104,
            "SureId": 26,
            "AyetId": 226,
            "LanguageId": 5,
            "AyetNumber": "226",
            "AyetVisible": false,
            "Page": 376,
            "AyetText": "Onların her vadide şaşkın şaşkın dolaştıklarını ve gerçekte yapmadıkları şeyleri söylediklerini görmez misin?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22111,
            "SureId": 26,
            "AyetId": 227,
            "LanguageId": 5,
            "AyetNumber": "227",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Ancak iman edip dünya ve âhiret için yararlı işler yapanlar, Allah’ı çokça ananlar ve haksızlığa uğratıldıktan sonra kendilerini savunanlar başkadır. Haksızlık edenler, neye nasıl dönüşeceklerini (başlarına nelerin geleceğini) yakında görecekler.",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
