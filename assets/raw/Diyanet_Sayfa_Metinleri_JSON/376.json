    "QuranAyats": [
        {
            "Id": 21973,
            "SureId": 26,
            "AyetId": 207,
            "LanguageId": 7,
            "AyetNumber": "٢٠٧",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "مَٓا اَغْنٰى عَنْهُمْ مَا كَانُوا یُمَتَّعُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
                "SureId": 26,
                "MealInfo": "Mekke döneminde inmiştir. 227 âyettir. Sûre, adını 224. âyette geçen <b>“eş-Şu’arâ”</b> kelimesinden almıştır. <b>“Şu’arâ” şairler demektir</b>. Sûre de başlıca <b>Mûsâ, İbrahim, Nûh, Hûd,Salih ve Şu’ayb peygamberler</b>in kıssaları dile getirilmekte; müşriklerin, Kur’an’ın vahiy dışı bir kaynağa dayalı olduğu iddialarına karşılık, onun bir vahiy eseri olduğu vurgulanmakta, söz konusu kaynakların Kur’an üzerinde hiçbir etkisinin bulunamayacağı ifade edilmektedir.",
                "SureNameTurkish": "Şuarâ",
                "SureNameArabic": "الشُّعَرَاءِ",
                "BesmeleVisible": true,
                "HeaderOnBackPage": true,
                "InisOrder": 47,
                "AyetCount": 227,
                "Cuz": 19,
                "FirstPage": 367,
                "ExcludeMenu": false
            }
        },
        {
            "Id": 21980,
            "SureId": 26,
            "AyetId": 208,
            "LanguageId": 7,
            "AyetNumber": "٢٠٨",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "وَمَٓا اَهْلَكْنَا مِنْ قَرْیَةٍ اِلَّا لَهَا مُنْذِرُونَࣗۛ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21987,
            "SureId": 26,
            "AyetId": 209,
            "LanguageId": 7,
            "AyetNumber": "٢٠٩",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "ذِكْرٰىࣞۛ وَمَا كُنَّا ظَالِمٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 21994,
            "SureId": 26,
            "AyetId": 210,
            "LanguageId": 7,
            "AyetNumber": "٢١٠",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "وَمَا تَنَزَّلَتْ بِهِ الشَّیَاطٖینُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22001,
            "SureId": 26,
            "AyetId": 211,
            "LanguageId": 7,
            "AyetNumber": "٢١١",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "وَمَا یَنْبَغٖی لَهُمْ وَمَا یَسْتَطٖیعُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22008,
            "SureId": 26,
            "AyetId": 212,
            "LanguageId": 7,
            "AyetNumber": "٢١٢",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "اِنَّهُمْ عَنِ السَّمْعِ لَمَعْزُولُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22015,
            "SureId": 26,
            "AyetId": 213,
            "LanguageId": 7,
            "AyetNumber": "٢١٣",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "فَلَا تَدْعُ مَعَ اللّٰهِ اِلٰهًا اٰخَرَ فَتَكُونَ مِنَ الْمُعَذَّبٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22022,
            "SureId": 26,
            "AyetId": 214,
            "LanguageId": 7,
            "AyetNumber": "٢١٤",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "وَاَنْذِرْ عَشٖیرَتَكَ الْاَقْرَبٖینَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22029,
            "SureId": 26,
            "AyetId": 215,
            "LanguageId": 7,
            "AyetNumber": "٢١٥",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "وَاخْفِضْ جَنَاحَكَ لِمَنِ اتَّبَعَكَ مِنَ الْمُؤْمِنٖینَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22036,
            "SureId": 26,
            "AyetId": 216,
            "LanguageId": 7,
            "AyetNumber": "٢١٦",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "فَاِنْ عَصَوْكَ فَقُلْ اِنّٖی بَرٖٓیءٌ مِمَّا تَعْمَلُونَۚ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22043,
            "SureId": 26,
            "AyetId": 217,
            "LanguageId": 7,
            "AyetNumber": "٢١٧",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "وَتَوَكَّلْ عَلَى الْعَزٖیزِ الرَّحٖیمِۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22050,
            "SureId": 26,
            "AyetId": 218,
            "LanguageId": 7,
            "AyetNumber": "٢١٨",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "اَلَّذٖی یَرٰیكَ حٖینَ تَقُومُۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22057,
            "SureId": 26,
            "AyetId": 219,
            "LanguageId": 7,
            "AyetNumber": "٢١٩",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "وَتَقَلُّبَكَ فِی السَّاجِدٖینَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22064,
            "SureId": 26,
            "AyetId": 220,
            "LanguageId": 7,
            "AyetNumber": "٢٢٠",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "اِنَّهُ هُوَ السَّمٖیعُ الْعَلٖیمُ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22071,
            "SureId": 26,
            "AyetId": 221,
            "LanguageId": 7,
            "AyetNumber": "٢٢١",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "هَلْ اُنَبِّئُكُمْ عَلٰى مَنْ تَنَزَّلُ الشَّیَاطٖینُؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22078,
            "SureId": 26,
            "AyetId": 222,
            "LanguageId": 7,
            "AyetNumber": "٢٢٢",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "تَنَزَّلُ عَلٰى كُلِّ اَفَّاكٍ اَثٖیمٍۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22085,
            "SureId": 26,
            "AyetId": 223,
            "LanguageId": 7,
            "AyetNumber": "٢٢٣",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "یُلْقُونَ السَّمْعَ وَاَكْثَرُهُمْ كَاذِبُونَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22092,
            "SureId": 26,
            "AyetId": 224,
            "LanguageId": 7,
            "AyetNumber": "٢٢٤",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "وَالشُّعَرَٓاءُ یَتَّبِعُهُمُ الْغَاوُ𐻿نَؕ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22099,
            "SureId": 26,
            "AyetId": 225,
            "LanguageId": 7,
            "AyetNumber": "٢٢٥",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "اَلَمْ تَرَ اَنَّهُمْ فٖی كُلِّ وَادٍ یَهٖیمُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22106,
            "SureId": 26,
            "AyetId": 226,
            "LanguageId": 7,
            "AyetNumber": "٢٢٦",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "وَاَنَّهُمْ یَقُولُونَ مَا لَا یَفْعَلُونَۙ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        },
        {
            "Id": 22113,
            "SureId": 26,
            "AyetId": 227,
            "LanguageId": 7,
            "AyetNumber": "٢٢٧",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "اِلَّا الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَذَكَرُوا اللّٰهَ كَثٖیرًا وَانْتَصَرُوا مِنْ بَعْدِ مَا ظُلِمُواؕ وَسَیَعْلَمُ الَّذٖینَ ظَلَمُٓوا اَیَّ مُنْقَلَبٍ یَنْقَلِبُونَ",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": null
        }
    ],
    "QuranAyatsText": null,
    "MealAyats": [
        {
            "Id": 21971,
            "SureId": 26,
            "AyetId": 207,
            "LanguageId": 5,
            "AyetNumber": "207",
            "AyetVisible": true,
            "Page": 376,
            "AyetText": "Senelerce yararlandırıldıkları nimetler onlara ne fayda sağlamıştır?",
            "Recitation": "",
            "AyetMeta": null,
            "RegionList": null,
            "Sure": {
