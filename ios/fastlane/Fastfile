default_platform(:ios)

platform :ios do
  desc "Build and upload to Apple TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    keychain_name = "ci_keychain"
    keychain_password = "temporary_ci_password_123"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    # In macOS Sonoma (14.x), Apple stores keychains with a -db suffix
    raw_path = File.expand_path("~/Library/Keychains/#{keychain_name}")
    keychain_path = File.exist?("#{raw_path}-db") ? "#{raw_path}-db" : raw_path

    # Apple WWDR Intermediate CA yüklemesi (güven zinciri doğrulaması için)
    wwdr_path = File.expand_path("~/AppleWWDRCAG3.cer")
    sh("curl -f -s -S -o '#{wwdr_path}' https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer") rescue nil
    if File.exist?(wwdr_path)
      import_certificate(
        certificate_path: wwdr_path,
        keychain_name: keychain_name,
        keychain_path: keychain_path,
        keychain_password: keychain_password,
        log_output: false
      )
      File.delete(wwdr_path) rescue nil
    end

    if ENV["BUILD_CERTIFICATE_BASE64"] && !ENV["BUILD_CERTIFICATE_BASE64"].strip.empty?
      UI.message("📦 Fiziki Mac'ten aktarılan P12 sertifikası GitHub Secrets üzerinden içe aktarılıyor...")
      require "base64"
      p12_path = File.expand_path("~/build_cert.p12")
      File.binwrite(p12_path, Base64.decode64(ENV["BUILD_CERTIFICATE_BASE64"].strip))

      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV["P12_PASSWORD"] || "",
        keychain_name: keychain_name,
        keychain_path: keychain_path,
        keychain_password: keychain_password,
        log_output: true
      )
      File.delete(p12_path) rescue nil
    else
      UI.message("⚠️ BUILD_CERTIFICATE_BASE64 bulunamadı; get_certificates ile Apple Portal'dan sorgulanıyor...")
      get_certificates(
        api_key: api_key,
        keychain_path: keychain_path,
        keychain_password: keychain_password
      )
    end

    # Allow codesign and Xcode tools to access private keys in the keychain without GUI prompts
    [keychain_path, raw_path, "#{raw_path}-db"].uniq.each do |kpath|
      next unless File.exist?(kpath)
      sh("security set-key-partition-list -S apple-tool:,apple:,codesign:,productbuild:,xcodebuild: -s -k '#{keychain_password}' '#{kpath}'") rescue nil
      sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '#{keychain_password}' '#{kpath}'") rescue nil
    end
    sh("security list-keychains -d user -s '#{keychain_path}' $(security list-keychains -d user | tr -d '\"')") rescue nil
    UI.message("=== Anahtarlıkta Yüklü İmzalama Kimlikleri ===")
    sh("security find-identity -v -p codesigning '#{keychain_path}'") rescue nil

    # 1. Main App Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.akarworks.zikirce",
      force: true
    )

    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    profile_data = sh("security cms -D -i '#{profile_path}'")
    team_id = profile_data[/<key>TeamIdentifier<\/key>\s*<array>\s*<string>([^<]+)<\/string>/m, 1]
    UI.message("Extracted Apple Development Team ID: #{team_id}")

    runner_profile_name = lane_context[SharedValues::SIGH_NAME]

    update_project_team(
      path: "Runner.xcodeproj",
      teamid: team_id
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      team_id: team_id,
      bundle_identifier: "com.akarworks.zikirce",
      profile_name: runner_profile_name,
      code_sign_identity: "Apple Distribution"
    )

    # 2. Register & Fetch Widget Extension Profile
    widget_profile_name = nil
    begin
      produce(
        api_key: api_key,
        app_name: "Zikirce Widgets",
        app_identifier: "com.akarworks.zikirce.ZikirceWidgets",
        skip_itc: true
      )
    rescue => ex
      UI.message("Produce note: #{ex.message}")
    end

    begin
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: "com.akarworks.zikirce.ZikirceWidgets",
        force: true
      )
      widget_profile_name = lane_context[SharedValues::SIGH_NAME]
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Runner.xcodeproj",
        targets: ["ZikirceWidgetsExtension"],
        team_id: team_id,
        bundle_identifier: "com.akarworks.zikirce.ZikirceWidgets",
        profile_name: widget_profile_name,
        code_sign_identity: "Apple Distribution"
      )
    rescue => ex
      UI.user_error!("Widget Extension sağlama profili oluşturulamadı. Lütfen Apple Developer Portal'da 'group.com.akarworks.zikirce' App Group'unu oluşturup her iki App ID'ye (com.akarworks.zikirce ve com.akarworks.zikirce.ZikirceWidgets) bağlayın: #{ex.message}")
    end

    prov_profiles = {
      "com.akarworks.zikirce" => runner_profile_name
    }
    prov_profiles["com.akarworks.zikirce.ZikirceWidgets"] = widget_profile_name if widget_profile_name

    ENV["VERBOSE_SCRIPT_LOGGING"] = "1"

    begin
      build_app(
        workspace: "Runner.xcworkspace",
        scheme: "Runner",
        clean: false,
        export_method: "app-store",
        output_directory: "../build/ios/ipa",
        output_name: "Zikirce.ipa",
        codesigning_identity: "Apple Distribution",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: prov_profiles
        }
      )
    rescue => ex
      log_path = File.expand_path("~/Library/Logs/gym/Runner-Runner.log")
      if File.exist?(log_path)
        UI.error("=== DETAILED GYM LOG OUTPUT ===")
        File.readlines(log_path).last(150).each do |line|
          UI.error(line.chomp)
        end
      end
      raise ex
    end

    changelog_text = <<~CHANGELOG
      Zikirce v2.1.5 Yenilikleri:
      • iOS WidgetKit Selçuklu Analog Saati & Kilit Ekranı: iOS Ana Ekran ve Kilit Ekranı için 8 köşeli Selçuklu motifli estetik analog namaz saati, kilit ekranı aksesuarları ve zenginleştirilmiş vakit takip widget'ları eklendi.
      • Canlı Vakit Dilimli Selçuklu Kadranı: Uygulama içi vakit kartlarına dinamik akrep-yelkovan ve namaz vakit dilimlerini canlı gösteren zarif saat kadranı entegre edildi.
      • Kusursuz Açılış & Native Splash: Açılış logosu ve splash katmanı yenilenerek açık/koyu temalarla sıfır titremeli geçiş sağlandı.
      • WidgetKit Arka Plan Senkronizasyonu: App Group veri köprüsü güçlendirildi, anlık veri aktarımı ve bellek verimliliği artırıldı.

      What's New in v2.1.5:
      • iOS WidgetKit Seljuk Analog Clock & Lock Screen: Exquisite 8-pointed Seljuk star analog prayer clock and enriched prayer accessories for iOS Home Screen & Lock Screen.
      • Live Prayer-Sector Clock Dial: Integrated real-time hands and dynamic prayer time sector highlights in daily prayer cards.
      • Refined Native Splash Experience: Brand-new splash architecture for seamless, flicker-free light and dark mode launch transitions.
      • WidgetKit Background Sync & Robustness: Reinforced App Group bridge for instantaneous prayer time and streak sync with optimized energy efficiency.
    CHANGELOG

    upload_to_testflight(
      api_key: api_key,
      ipa: "../build/ios/ipa/Zikirce.ipa",
      skip_waiting_for_build_processing: true,
      changelog: changelog_text
    )
  end
end
