default_platform(:ios)

platform :ios do
  desc "Build and upload Tahrir to Apple TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    keychain_name = "ci_keychain"
    keychain_password = "temporary_ci_password_123"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    raw_path = File.expand_path("~/Library/Keychains/#{keychain_name}")
    keychain_path = File.exist?("#{raw_path}-db") ? "#{raw_path}-db" : raw_path

    wwdr_path = File.expand_path("~/AppleWWDRCAG3.cer")
    sh("curl -f -s -S -o '#{wwdr_path}' https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer") rescue nil
    if File.exist?(wwdr_path)
      import_certificate(
        certificate_path: wwdr_path,
        keychain_path: keychain_path,
        keychain_password: keychain_password,
        log_output: false
      )
      File.delete(wwdr_path) rescue nil
    end

    if ENV["BUILD_CERTIFICATE_BASE64"] && !ENV["BUILD_CERTIFICATE_BASE64"].strip.empty?
      UI.message("Importing P12 distribution certificate from GitHub Secrets...")
      require "base64"
      p12_path = File.expand_path("~/build_cert.p12")
      File.binwrite(p12_path, Base64.decode64(ENV["BUILD_CERTIFICATE_BASE64"].strip))

      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV["P12_PASSWORD"] || "",
        keychain_path: keychain_path,
        keychain_password: keychain_password,
        log_output: true
      )
      File.delete(p12_path) rescue nil
    else
      UI.message("BUILD_CERTIFICATE_BASE64 not set; querying Apple Portal via get_certificates...")
      get_certificates(
        api_key: api_key,
        keychain_path: keychain_path,
        keychain_password: keychain_password
      )
    end

    [keychain_path, raw_path, "#{raw_path}-db"].uniq.each do |kpath|
      next unless File.exist?(kpath)
      sh("security set-key-partition-list -S apple-tool:,apple:,codesign:,productbuild:,xcodebuild: -s -k '#{keychain_password}' '#{kpath}'") rescue nil
      sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '#{keychain_password}' '#{kpath}'") rescue nil
    end
    sh("security list-keychains -d user -s '#{keychain_path}' $(security list-keychains -d user | tr -d '\"')") rescue nil
    UI.message("=== Installed Code Signing Identities ===")
    sh("security find-identity -v -p codesigning '#{keychain_path}'") rescue nil

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.akarworks.tahrir",
      force: true
    )

    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    profile_data = sh("security cms -D -i '#{profile_path}'")
    team_id = profile_data[/<key>TeamIdentifier<\/key>\s*<array>\s*<string>([^<]+)<\/string>/m, 1] || "9LZTZ73KP5"
    UI.message("Extracted Apple Development Team ID: #{team_id}")

    runner_profile_name = lane_context[SharedValues::SIGH_NAME]

    update_project_team(
      path: "Runner.xcodeproj",
      teamid: team_id
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      team_id: team_id,
      bundle_identifier: "com.akarworks.tahrir",
      profile_name: runner_profile_name,
      code_sign_identity: "Apple Distribution"
    )

    ENV["VERBOSE_SCRIPT_LOGGING"] = "1"

    begin
      build_app(
        workspace: "Runner.xcworkspace",
        scheme: "Runner",
        clean: false,
        export_method: "app-store",
        output_directory: "../build/ios/ipa",
        output_name: "Tahrir.ipa",
        codesigning_identity: "Apple Distribution",
        xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{team_id}",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: {
            "com.akarworks.tahrir" => runner_profile_name
          }
        }
      )
    rescue => ex
      log_path = File.expand_path("~/Library/Logs/gym/Runner-Runner.log")
      if File.exist?(log_path)
        UI.error("=== DETAILED GYM LOG OUTPUT ===")
        File.readlines(log_path).last(150).each do |line|
          UI.error(line.chomp)
        end
      end
      raise ex
    end

    changelog_text = <<~CHANGELOG
      Tahrir v1.15.0 (Build 21) TestFlight Sürümü:
      • Çift Modlu Eski PDF Restorasyonu (Akış / Baskı / PDF): C++ Sauvola, ±5° Deskew, şeffaf Baskı Akışı ve 300 DPI uzun-basma Büyüteç.
      • Cihaz İçi Hibrit OCR: iOS Apple Vision (TR/AR/EN) ve Zemberek ile yüksek doğruluklu satır & Arapça çözümlemesi.
      • Tahrir Pro & Banner'sız Esnek Erişim: Kurulumda 24 saat Pro denemesi, kapatılabilir karşılama, ücretsiz PDF + Günlük Seri ve 3 ödüllü reklamla 24 saat Pro.

      Tahrir v1.15.0 (Build 21) TestFlight:
      • Dual-Mode Old PDF Restoration (Flow / Print / PDF): C++ Sauvola, ±5° Deskew, theme-tinted Optical Reflow, and 300 DPI long-press peek.
      • On-Device Hybrid OCR: iOS Apple Vision (TR/AR/EN) + Zemberek for high-accuracy Turkish & Arabic line recovery.
      • Tahrir Pro & Banner-Free Access: 24h Pro trial on install, dismissible prompt, free PDF + Streak basics, and 3 rewarded ads for 24h Pro.
    CHANGELOG

    if ENV["APP_EXISTS"].to_s.strip == "false"
      UI.important("================================================================================")
      UI.important("Tahrir.ipa built and signed with Apple Distribution certificate!")
      UI.important("Skipping TestFlight upload because App Store Connect record 'com.akarworks.tahrir' does not exist yet.")
      UI.important("Create the app once at https://appstoreconnect.apple.com/apps -> (+) New App:")
      UI.important("  Platform: iOS | Name: Tahrir | Primary Language: Turkish | Bundle ID: com.akarworks.tahrir | SKU: tahrir-ios-001")
      UI.important("Then re-run GitHub Actions with upload_only_run_id set to this run's ID.")
      UI.important("================================================================================")
    else
      begin
        upload_to_testflight(
          api_key: api_key,
          ipa: "../build/ios/ipa/Tahrir.ipa",
          skip_waiting_for_build_processing: true,
          changelog: changelog_text
        )
      rescue => ex
        if ex.message.to_s.include?("No suitable application records")
          UI.important("================================================================================")
          UI.important("Tahrir.ipa built and signed, awaiting App Store Connect New App record for 'com.akarworks.tahrir'.")
          UI.important("================================================================================")
        end
        raise ex
      end
    end
  end
end
