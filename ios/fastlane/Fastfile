default_platform(:ios)

platform :ios do
  desc "Build and upload to Apple TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    keychain_name = "ci_keychain"
    keychain_password = "temporary_ci_password_123"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    # In macOS Sonoma (14.x), Apple stores keychains with a -db suffix
    raw_path = File.expand_path("~/Library/Keychains/#{keychain_name}")
    keychain_path = File.exist?("#{raw_path}-db") ? "#{raw_path}-db" : raw_path

    # Apple WWDR Intermediate CA yüklemesi (güven zinciri doğrulaması için)
    wwdr_path = File.expand_path("~/AppleWWDRCAG3.cer")
    sh("curl -f -s -S -o '#{wwdr_path}' https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer") rescue nil
    if File.exist?(wwdr_path)
      import_certificate(
        certificate_path: wwdr_path,
        keychain_name: keychain_name,
        keychain_path: keychain_path,
        keychain_password: keychain_password,
        log_output: false
      )
      File.delete(wwdr_path) rescue nil
    end

    if ENV["BUILD_CERTIFICATE_BASE64"] && !ENV["BUILD_CERTIFICATE_BASE64"].strip.empty?
      UI.message("📦 Fiziki Mac'ten aktarılan P12 sertifikası GitHub Secrets üzerinden içe aktarılıyor...")
      require "base64"
      p12_path = File.expand_path("~/build_cert.p12")
      File.binwrite(p12_path, Base64.decode64(ENV["BUILD_CERTIFICATE_BASE64"].strip))

      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV["P12_PASSWORD"] || "",
        keychain_name: keychain_name,
        keychain_path: keychain_path,
        keychain_password: keychain_password,
        log_output: true
      )
      File.delete(p12_path) rescue nil
    else
      UI.message("⚠️ BUILD_CERTIFICATE_BASE64 bulunamadı; get_certificates ile Apple Portal'dan sorgulanıyor...")
      get_certificates(
        api_key: api_key,
        keychain_path: keychain_path,
        keychain_password: keychain_password
      )
    end

    # Allow codesign and Xcode tools to access private keys in the keychain without GUI prompts
    [keychain_path, raw_path, "#{raw_path}-db"].uniq.each do |kpath|
      next unless File.exist?(kpath)
      sh("security set-key-partition-list -S apple-tool:,apple:,codesign:,productbuild:,xcodebuild: -s -k '#{keychain_password}' '#{kpath}'") rescue nil
      sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '#{keychain_password}' '#{kpath}'") rescue nil
    end
    sh("security list-keychains -d user -s '#{keychain_path}' $(security list-keychains -d user | tr -d '\"')") rescue nil
    UI.message("=== Anahtarlıkta Yüklü İmzalama Kimlikleri ===")
    sh("security find-identity -v -p codesigning '#{keychain_path}'") rescue nil

    # 1. Main App Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.akarworks.zikirce",
      force: true
    )

    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    profile_data = sh("security cms -D -i '#{profile_path}'")
    team_id = profile_data[/<key>TeamIdentifier<\/key>\s*<array>\s*<string>([^<]+)<\/string>/m, 1]
    UI.message("Extracted Apple Development Team ID: #{team_id}")

    runner_profile_name = lane_context[SharedValues::SIGH_NAME]

    update_project_team(
      path: "Runner.xcodeproj",
      teamid: team_id
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      team_id: team_id,
      bundle_identifier: "com.akarworks.zikirce",
      profile_name: runner_profile_name,
      code_sign_identity: "Apple Distribution"
    )

    # 2. Register & Fetch Widget Extension Profile
    widget_profile_name = nil
    begin
      produce(
        api_key: api_key,
        app_name: "Zikirce Widgets",
        app_identifier: "com.akarworks.zikirce.ZikirceWidgets",
        skip_itc: true
      )
    rescue => ex
      UI.message("Produce note: #{ex.message}")
    end

    begin
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: "com.akarworks.zikirce.ZikirceWidgets",
        force: true
      )
      widget_profile_name = lane_context[SharedValues::SIGH_NAME]
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Runner.xcodeproj",
        targets: ["ZikirceWidgetsExtension"],
        team_id: team_id,
        bundle_identifier: "com.akarworks.zikirce.ZikirceWidgets",
        profile_name: widget_profile_name,
        code_sign_identity: "Apple Distribution"
      )
    rescue => ex
      UI.user_error!("Widget Extension sağlama profili oluşturulamadı. Lütfen Apple Developer Portal'da 'group.com.akarworks.zikirce' App Group'unu oluşturup her iki App ID'ye (com.akarworks.zikirce ve com.akarworks.zikirce.ZikirceWidgets) bağlayın: #{ex.message}")
    end

    prov_profiles = {
      "com.akarworks.zikirce" => runner_profile_name
    }
    prov_profiles["com.akarworks.zikirce.ZikirceWidgets"] = widget_profile_name if widget_profile_name

    ENV["VERBOSE_SCRIPT_LOGGING"] = "1"

    begin
      build_app(
        workspace: "Runner.xcworkspace",
        scheme: "Runner",
        clean: false,
        export_method: "app-store",
        output_directory: "../build/ios/ipa",
        output_name: "Zikirce.ipa",
        codesigning_identity: "Apple Distribution",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: prov_profiles
        }
      )
    rescue => ex
      log_path = File.expand_path("~/Library/Logs/gym/Runner-Runner.log")
      if File.exist?(log_path)
        UI.error("=== DETAILED GYM LOG OUTPUT ===")
        File.readlines(log_path).last(150).each do |line|
          UI.error(line.chomp)
        end
      end
      raise ex
    end

    changelog_text = <<~CHANGELOG
      Zikirce v2.1.10 Yenilikleri:
      • iOS Paylaşım Kartı & Görsel Paylaşım Düzeltmesi: iPhone ve iPad cihazlarda zikir, seri, namaz ve ibadet karnesi kartlarını paylaşırken oluşan sistem paylaşım penceresi (sharePositionOrigin) hatası kalıcı olarak giderildi.
      • Bulut Senkronizasyonu & Yedek Paylaşım Kararlılığı: Google Drive senkronizasyon geri dönüşü ve yedek dışa aktarım adımları güçlendirildi.

      What's New in v2.1.10:
      • iOS Share Card & Image Sharing Fix: Fixed the iOS share sheet origin issue (sharePositionOrigin) when sharing dhikr, streak, prayer, and worship summary cards on iPhone and iPad.
      • Cloud Sync & Backup Export Reliability: Improved Google Drive sync fallback and local backup sharing stability.

      Zikirce v2.1.9 Yenilikleri:
      • Matbû Kur'ân-ı Kerîm Hatim Duası: Mushafların sonunda yer alan tam metin Hatim ve Bağışlama Duası (Duâü Hatmi'l-Kur'âni'l-Azîm), varsayılan Matbû Arapça sahife görünümü, Diyanet Mushaf hattı, Lafzatullah vurgusu ve Selçuklu durak gülleriyle eklendi.
      • 4 Modlu Kur'ân Okuma, 7 Meâl & 5 Klasik Tefsir: Mushaf, Âyet+Meâl, Akıcı Kitap Meâli ve Sayfa İçi Tefsir modları; 7 Türkçe meâl kıyaslaması ve Kur'ân Yolu, Beyzâvî, Mâtürîdî, Keşşâf ve Râzî tam metin tefsir kütüphanesi sunuldu.
      • 23 Eserlik İslami Külliyat & Ok ile Kelime Takibi: Kütüb-i Sitte, Riyâzü's-Sâlihîn ve Risale-i Nur Külliyatı eklendi; sesli tilâvette "Ok ile Takip" işaretçisi ve 6.236 âyet akustik senkronizasyonu tamamlandı.
      • İnteraktif Kullanım Kılavuzu & Sahih Hadis Kaynakları: Ayarlar'a kapsamlı Kullanım Kılavuzu eklendi; 99 Esmâü'l-Hüsnâ ve 146 zikir Kütüb-i Sitte sahih hadis kaynaklarıyla zenginleştirildi.

      What's New in v2.1.9:
      • Printed Mushaf Khatm Prayer: Complete traditional Khatm al-Quran Prayer with default Printed Mushaf Arabic page layout, authentic Diyanet calligraphy, Divine Name highlighting, and Seljuk rosette stop markers.
      • 4-Mode Quran Reader, 7 Translations & 5 Classical Tafseers: Mushaf, Verse+Translation, Flowing Book, and In-Page Tafseer modes with 7 Turkish translations and 5 full-text classical Tafseer works.
      • 23-Volume Islamic Library & Arrow Word Tracking: Added Kutub al-Sittah, Riyad as-Salihin, and Risale-i Nur library, plus the new "Arrow Pointer" word-tracking mode with acoustic sync across all 6,236 verses.
      • Interactive User Guide & Authentic Hadith Citations: Added a searchable User Guide in Settings and enriched all 146 dhikrs and 99 Names of Allah with authentic Hadith references.

      Zikirce v2.1.8 Yenilikleri:
      • Manevi Paylaşım Stüdyosu & Ayet-Hadis Kartları: Zikir, seri ve istatistik kartlarına ayet-hadis entegrasyonu, Cuma ve Kandil özel gün tebrikleri ile Selçuklu hat sanatı detayları eklendi.
      • Hedef Tamamlama & Paylaşım Bildirimi: Namaz, Kur'an, zikir ve ezber hedeflerine ulaşıldığında doğrudan paylaşım kartı oluşturma ve tebrik desteği sunuldu.
      • iOS Kilit Ekranı (Lock Screen) Araçları: Namaz vakitleri, canlı geri sayım, günlük zikir sayacı, zikir zinciri ve hicri takvim kilit ekranı araçları optimize edildi.

      What's New in v2.1.8:
      • Spiritual Sharing Studio & Verse-Hadith Cards: Dynamic Quran verses, Hadiths, Islamic special day/Friday greetings, and refined Seljuk geometric frames for dhikr and streak cards.
      • Goal Completion & Sharing Triggers: Instant sharing cards and celebration prompts upon completing daily prayer, Quran, dhikr, and memorization goals.
      • iOS Lock Screen Widgets: Enhanced circular, rectangular, and inline Lock Screen widgets for Prayer Times, Live Countdown, Dhikr Counter, Streak, and Hijri Calendar.

      Zikirce v2.1.7 Yenilikleri:
      • iOS Kilit Ekranı (Lock Screen) Araçları: Namaz vakitleri, canlı geri sayım, günlük zikir sayacı, zikir zinciri ve hicri takvim için dairesel, dikdörtgen ve satır içi kilit ekranı araçları eklendi.

      What's New in v2.1.7:
      • iOS Lock Screen Widgets: Added circular, rectangular, and inline Lock Screen widget support for Prayer Times, Live Countdown, Dhikr Counter, Streak Tracker, and Hijri Calendar.

      Zikirce v2.1.6 Yenilikleri:
      • iOS Arka Planda Kesintisiz Kur'an & Talim Dinleme: Kelime Takipli Dinleme Talimi, Mukabele ve Mushaf ekranlarında uygulama arka plana alındığında veya ekran kilitlendiğinde ayetler arası kesintisiz geçiş sağlandı.
      • iOS Kilit Ekranı & Dynamic Island Medya Kontrolleri: Okunan sûre/âyet bilgisi ve oynat/duraklat/ileri/geri kontrolleri iOS Kilit Ekranı ve Denetim Merkezi'ne eklendi.
      • App Store Gizlilik & Performans Uyumluluğu: Native AVAudioSession yönetimi, PrivacyInfo.xcprivacy manifestosu ve arka plan yetki tanımları güncellendi.

      What's New in v2.1.6:
      • Seamless iOS Background Quran & Talim Playback: Gapless verse-to-verse recitation in Word-by-Word Listening (Talim), Mukabele, and Mushaf when the app is backgrounded or the device screen is locked.
      • iOS Lock Screen, Control Center & Dynamic Island Controls: Active Surah/Ayah metadata and remote playback controls (play, pause, next/previous ayah).
      • App Store Privacy & Compliance Enhancements: Added native PrivacyInfo.xcprivacy manifest and refined UIBackgroundModes configuration.
    CHANGELOG

    upload_to_testflight(
      api_key: api_key,
      ipa: "../build/ios/ipa/Zikirce.ipa",
      skip_waiting_for_build_processing: true,
      changelog: changelog_text
    )
  end
end
