default_platform(:ios)

platform :ios do
  desc "Build and upload to Apple TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    keychain_name = "ci_keychain"
    keychain_password = "temporary_ci_password_123"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    # In macOS Sonoma (14.x), Apple stores keychains with a -db suffix
    raw_path = File.expand_path("~/Library/Keychains/#{keychain_name}")
    keychain_path = File.exist?("#{raw_path}-db") ? "#{raw_path}-db" : raw_path

    # Apple WWDR Intermediate CA yüklemesi (güven zinciri doğrulaması için)
    wwdr_path = File.expand_path("~/AppleWWDRCAG3.cer")
    sh("curl -f -s -S -o '#{wwdr_path}' https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer") rescue nil
    if File.exist?(wwdr_path)
      import_certificate(
        certificate_path: wwdr_path,
        keychain_name: keychain_name,
        keychain_path: keychain_path,
        keychain_password: keychain_password,
        log_output: false
      )
      File.delete(wwdr_path) rescue nil
    end

    if ENV["BUILD_CERTIFICATE_BASE64"] && !ENV["BUILD_CERTIFICATE_BASE64"].strip.empty?
      UI.message("📦 Fiziki Mac'ten aktarılan P12 sertifikası GitHub Secrets üzerinden içe aktarılıyor...")
      require "base64"
      p12_path = File.expand_path("~/build_cert.p12")
      File.binwrite(p12_path, Base64.decode64(ENV["BUILD_CERTIFICATE_BASE64"].strip))

      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV["P12_PASSWORD"] || "",
        keychain_name: keychain_name,
        keychain_path: keychain_path,
        keychain_password: keychain_password,
        log_output: true
      )
      File.delete(p12_path) rescue nil
    else
      UI.message("⚠️ BUILD_CERTIFICATE_BASE64 bulunamadı; get_certificates ile Apple Portal'dan sorgulanıyor...")
      get_certificates(
        api_key: api_key,
        keychain_path: keychain_path,
        keychain_password: keychain_password
      )
    end

    # Allow codesign and Xcode tools to access private keys in the keychain without GUI prompts
    [keychain_path, raw_path, "#{raw_path}-db"].uniq.each do |kpath|
      next unless File.exist?(kpath)
      sh("security set-key-partition-list -S apple-tool:,apple:,codesign:,productbuild:,xcodebuild: -s -k '#{keychain_password}' '#{kpath}'") rescue nil
      sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '#{keychain_password}' '#{kpath}'") rescue nil
    end
    sh("security list-keychains -d user -s '#{keychain_path}' $(security list-keychains -d user | tr -d '\"')") rescue nil
    UI.message("=== Anahtarlıkta Yüklü İmzalama Kimlikleri ===")
    sh("security find-identity -v -p codesigning '#{keychain_path}'") rescue nil

    # 1. Main App Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.akarworks.zikirce",
      force: true
    )

    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    profile_data = sh("security cms -D -i '#{profile_path}'")
    team_id = profile_data[/<key>TeamIdentifier<\/key>\s*<array>\s*<string>([^<]+)<\/string>/m, 1]
    UI.message("Extracted Apple Development Team ID: #{team_id}")

    runner_profile_name = lane_context[SharedValues::SIGH_NAME]

    update_project_team(
      path: "Runner.xcodeproj",
      teamid: team_id
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      team_id: team_id,
      bundle_identifier: "com.akarworks.zikirce",
      profile_name: runner_profile_name,
      code_sign_identity: "Apple Distribution"
    )

    # 2. Register & Fetch Widget Extension Profile
    widget_profile_name = nil
    begin
      produce(
        api_key: api_key,
        app_name: "Zikirce Widgets",
        app_identifier: "com.akarworks.zikirce.ZikirceWidgets",
        skip_itc: true
      )
    rescue => ex
      UI.message("Produce note: #{ex.message}")
    end

    begin
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: "com.akarworks.zikirce.ZikirceWidgets",
        force: true
      )
      widget_profile_name = lane_context[SharedValues::SIGH_NAME]
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Runner.xcodeproj",
        targets: ["ZikirceWidgetsExtension"],
        team_id: team_id,
        bundle_identifier: "com.akarworks.zikirce.ZikirceWidgets",
        profile_name: widget_profile_name,
        code_sign_identity: "Apple Distribution"
      )
    rescue => ex
      UI.user_error!("Widget Extension sağlama profili oluşturulamadı. Lütfen Apple Developer Portal'da 'group.com.akarworks.zikirce' App Group'unu oluşturup her iki App ID'ye (com.akarworks.zikirce ve com.akarworks.zikirce.ZikirceWidgets) bağlayın: #{ex.message}")
    end

    prov_profiles = {
      "com.akarworks.zikirce" => runner_profile_name
    }
    prov_profiles["com.akarworks.zikirce.ZikirceWidgets"] = widget_profile_name if widget_profile_name

    ENV["VERBOSE_SCRIPT_LOGGING"] = "1"

    begin
      build_app(
        workspace: "Runner.xcworkspace",
        scheme: "Runner",
        clean: false,
        export_method: "app-store",
        output_directory: "../build/ios/ipa",
        output_name: "Zikirce.ipa",
        codesigning_identity: "Apple Distribution",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: prov_profiles
        }
      )
    rescue => ex
      log_path = File.expand_path("~/Library/Logs/gym/Runner-Runner.log")
      if File.exist?(log_path)
        UI.error("=== DETAILED GYM LOG OUTPUT ===")
        File.readlines(log_path).last(150).each do |line|
          UI.error(line.chomp)
        end
      end
      raise ex
    end

    changelog_text = <<~CHANGELOG
      Zikirce v2.3.0 Yenilikleri:
      • İrfan Meydanı & 32 Farz Kütüphanesi: Alt menüye eklenen yeni İrfan sekmesiyle Günün 5 İrfan Sorusu, 228+ sahih kaynaklı sorudan oluşan İlim Halkaları (Kur'ân-ı Kerîm, Siyer-i Nebî, 32 Farz & İlmihal, Esmâ & Dua, Külliyat), SM-2 Aralıklı Hafıza Tekrarı, Külliyat okuma tavsiyeleri, doğrudan ilgili zikri çekme bağlantıları ve 5 yeni İrfan rozeti sunuldu.
      • Zikir Vakur Kart Karuseli & Hızlı Seçim Çekmecesi: Zikirmatik ekranından tek dokunuşla açılan yeni Vakur Kart Karuseli, özel zikir oluşturma, fiziksel tesbih/yüzük sayacı adedi içe aktarma ve Feraciye Duası tashihi tamamlandı.
      • Mushaf Sahife Düzeni, Mukabele Hatim & Zikirce TV Hub: Geniş ekran çift sayfa Mushaf görünümü, Mukabele Hatim akışı ve Zikirce TV Hub arayüz ve performans iyileştirmeleri yapıldı.

      What's New in v2.3.0:
      • Arena of Wisdom & 32 Farz Library: New Wisdom tab with Daily 5 Wisdom Quiz, Circles of Knowledge with 228+ authentic questions across Quran, Seerah, 32 Farz & Catechism, Asma & Dua, and Islamic Library, SM-2 Spaced Review, reading recommendations, one-tap linked dhikr practice, and 5 new Wisdom badges.
      • Dhikr Vakur Card Carousel & Selection Sheet: Redesigned one-tap Dhikr Selection Sheet with Vakur Cards, custom litany creation, physical counter import, and Feraciye Prayer refinements.
      • Mushaf Page Spread, Mukabele Khatm & Zikirce TV Hub: Enhanced dual-page Mushaf layout, Mukabele Khatm flow, and Zikirce TV Hub visual and performance polish.

      Zikirce v2.2.0 Yenilikleri:
      • 40 Eserlik Külliyat, 16 Cep Risalesi & 84.141 Maddelik Risale-i Nur Lügati: Külliyat kitaplığına 16 müstakil Risale-i Nur Küçük Eseri ve 84.141 maddelik Risale-i Nur Büyük Lügati eklendi. Osmanlıca kelime ve kalıp tamlamalar tema uyumlu kehribar/bakır kök renklendirmesiyle gösterilir; üzerine dokunulduğunda anında lügat mânâsı açılır ve Arapça metinler Kur'ân hattıyla (Allah ve Rab lafızları kırmızı) sunulur.
      • Diyanet Birebir Ses-Kelime Senkronizasyonu, Sağdan Sola Kayan Kırmızı "Ok Takibi" & Besmele: Mukabele, Kelime Takipli Dinleme Talimi ve Mushaf ses oynatıcısında tekil âyet kaynak mimarisi ve resmi Diyanet zaman damgalarıyla 6.236 âyette sıfır gecikmeli ses-kelime uyumu, sağdan sola kayan kırmızı Ok Takibi ve Besmele-i Şerîf ile başlama özelliği eklendi.
      • Külliyat Ana Ekran / Kilit Ekranı Widget'ı & Dinamik Âyet/Hadis Paylaşım Stüdyosu: iOS Ana Ekran ve Kilit Ekranı Külliyat Widget'ı, paylaşım kartlarında 60+ âyet/hadis seçici, sayfa içi Tilâvet Secdesi rozetleri ve vakti girmeyen namaz koruması eklendi.

      What's New in v2.2.0:
      • 40-Volume Islamic Library, 16 Pocket Risales & 84,141-Entry Risale-i Nur Dictionary: Added 16 standalone Pocket Risales and the 84,141-entry Risale-i Nur Ottoman-Turkish Dictionary with theme-adaptive root coloring, instant tap-to-view definitions, and Quranic calligraphy with ruby-red Divine Name highlights.
      • Exact Diyanet Audio-to-Word Sync, Sliding Red Arrow Tracking & Basmala Start: Zero-drift synchronization across all 6,236 verses with single-track per-verse playback, smooth right-to-left sliding red Arrow Pointer tracking matching the Diyanet Quran Platform, and Basmala recitation at session start.
      • Külliyat Home & Lock Screen Widgets & Dynamic Verse/Hadith Sharing Studio: Added iOS Home and Lock Screen Library Widgets, a 60+ Verse & Hadith picker for share cards, in-page Sajdah al-Tilawah badges, and a prayer time guard.
    CHANGELOG

    upload_to_testflight(
      api_key: api_key,
      ipa: "../build/ios/ipa/Zikirce.ipa",
      skip_waiting_for_build_processing: true,
      changelog: changelog_text
    )
  end
end
