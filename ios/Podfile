platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # Xcode 26 / iOS 26 UIPopoverPresentationController fix for share_plus 10.x on iPhone & iPad
  share_plugin_files = Dir.glob(File.join(File.dirname(__FILE__), '.symlinks', 'plugins', 'share_plus', '**', 'FPPSharePlusPlugin.m')) +
                       Dir.glob(File.join(installer.sandbox.root.to_s, '**', 'FPPSharePlusPlugin.m'))
  share_plugin_files.uniq.each do |plugin_file|
    next unless File.exist?(plugin_file)
    begin
      content = File.read(plugin_file)
      if content.include?('sharePositionOrigin: argument must be set')
        File.chmod(0644, plugin_file) rescue nil
        patched = content.gsub(
          /if\s*\(hasPopoverPresentationController\s*&&\s*\(!isCoordinateSpaceOfSourceView\s*\|\|\s*CGRectIsEmpty\(origin\)\)\)\s*\{[^}]*result\(\[FlutterError[^\]]*\]\);\s*return;\s*\}/m,
          "if (hasPopoverPresentationController && (!isCoordinateSpaceOfSourceView || CGRectIsEmpty(origin))) {\n    CGRect bounds = controller.view.bounds;\n    origin = CGRectMake(CGRectGetMidX(bounds) - 1.0, CGRectGetMidY(bounds) - 1.0, 2.0, 2.0);\n  }"
        )
        File.write(plugin_file, patched) if patched != content
      end
    rescue => e
      Pod::UI.puts "share_plus patch note: #{e.message}"
    end
  end
end
